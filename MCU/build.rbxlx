		end
		local function reapply()
			if not gui.Enabled then
				return
			end
			if playerGui:FindFirstChild("DeathScreen") then
				return
			end
			if menuCamActive then
				enterMenuCamera()
			elseif selectPageCamActive then
				enterSelectPageCamera()
			end
