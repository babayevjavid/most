      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">InteractableHelper</string>
          <string name="Source"><![CDATA[--!strict
--[[ Interactable props: Attribute "Interactable" or a child named "Interactable". ]]

local InteractableHelper = {}

local function hasMark(inst: Instance): boolean
	if inst:GetAttribute("Interactable") then
		return true
	end
	return inst:FindFirstChild("Interactable") ~= nil
end

function InteractableHelper.hasMark(inst: Instance): boolean
	return hasMark(inst)
end

function InteractableHelper.resolveFromPart(part: BasePart, exclude: Model?): Instance?
	if exclude and part:IsDescendantOf(exclude) then
		return nil
	end
	local model = part:FindFirstAncestorOfClass("Model")
	if model and model ~= exclude then
		local hum = model:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			return nil
		end
		if hasMark(model) then
			return model
		end
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and hasMark(d) then
				return model
			end
		end
	end
	if hasMark(part) then
		return part
	end
	return nil
end

function InteractableHelper.raycast(
	origin: Vector3,
	direction: Vector3,
	range: number,
	exclude: Model?
): Instance?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = if exclude then { exclude } else {}
	local result = workspace:Raycast(origin, direction.Unit * range, params)
	if not result then
		return nil
	end
	return InteractableHelper.resolveFromPart(result.Instance, exclude)
end

return InteractableHelper
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">MorphAnimationHelper</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(script.Parent.GameConstants)

local MorphAnimationHelper = {}

local MALE_MORPH_NAMES: { [string]: boolean } = {
	SpiderMan = true,
	Cyclops = true,
	BlueMarvel = true,
	HumanTorchClassic = true,
	HumanTorchModern = true,
	Loki = true,
	Iceman = true,
}

local function assetId(id: string): string
	if string.sub(id, 1, 13) == "rbxassetid://" then
		return id
	end
	return "rbxassetid://" .. id
end

local function setAnimationId(inst: Instance, id: string)
	local full = assetId(id)
	if inst:IsA("Animation") then
		inst.AnimationId = full
	elseif inst:IsA("StringValue") then
		if inst.Value == "" or string.find(inst.Value, "asset", 1, true) or string.find(inst.Value, "%d") then
			inst.Value = full
		end
	end
end

local function categoryKind(name: string): "idle" | "walk" | "run" | nil
	local lower = string.lower(name)
	if lower == "idle" then
		return "idle"
	end
	if lower == "walk" or lower == "walkanim" then
		return "walk"
	end
	if lower == "run" or lower == "runanim" then
		return "run"
	end
	return nil
end

local function applyToAnimate(animate: Instance, idleId: string, walkId: string, runId: string)
	local function applyNode(node: Instance, kind: "idle" | "walk" | "run")
		local id = idleId
		if kind == "walk" then
			id = walkId
		elseif kind == "run" then
			id = runId
		end
		setAnimationId(node, id)
		for _, child in node:GetChildren() do
			if child:IsA("Animation") or child:IsA("StringValue") then
				setAnimationId(child, id)
			end
			for _, nested in child:GetChildren() do
				if nested:IsA("Animation") then
					setAnimationId(nested, id)
				end
			end
		end
	end

	for _, child in animate:GetChildren() do
		local kind = categoryKind(child.Name)
		if kind then
			applyNode(child, kind)
		end
	end
end

function MorphAnimationHelper.idleIdForMorphName(morphName: string): string
	if string.find(morphName, "JeanGrey", 1, true) then
		return GameConstants.JEAN_IDLE_ANIM
	end
	if string.find(morphName, "InvisibleWoman", 1, true) then
		return GameConstants.IW_IDLE_ANIM
	end
	if MALE_MORPH_NAMES[morphName] then
		return GameConstants.MALE_IDLE_ANIM
	end
	return GameConstants.BASIC_IDLE_ANIM
end

function MorphAnimationHelper.applyToModel(model: Instance, idleId: string?)
	local animate = model:FindFirstChild("Animate")
	if not animate then
		return
	end
	local idle = idleId or MorphAnimationHelper.idleIdForMorphName(model.Name)
	applyToAnimate(animate, idle, GameConstants.LOCOMOTION_ANIM, GameConstants.LOCOMOTION_ANIM)
end

function MorphAnimationHelper.patchAssets()
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		return
	end
	local starter = assets:FindFirstChild("StarterCharacter")
	if starter then
		MorphAnimationHelper.applyToModel(starter, GameConstants.BASIC_IDLE_ANIM)
	end
	local morphs = assets:FindFirstChild("Morphs")
	if morphs then
		for _, child in morphs:GetChildren() do
			MorphAnimationHelper.applyToModel(child, MorphAnimationHelper.idleIdForMorphName(child.Name))
		end
	end
	local iw = assets:FindFirstChild("InvisibleWoman")
	if iw then
		local invisMorph = iw:FindFirstChild("InvisibilityMorph")
		if invisMorph then
			MorphAnimationHelper.applyToModel(invisMorph, GameConstants.IW_IDLE_ANIM)
		end
	end
end

return MorphAnimationHelper
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">MorphVfxTint</string>
          <string name="Source"><![CDATA[--!strict
--[[ Skin-specific particle / beam / trail recolors for morphs. ]]

local MorphVfxTint = {}

local JEAN_97_BLUE = Color3.fromRGB(65, 81, 253)
local MARVEL_GIRL_PINK = Color3.fromRGB(255, 90, 185)

function MorphVfxTint.paintFx(root: Instance, color: Color3)
	local seq = ColorSequence.new(color)
	local function paint(inst: Instance)
		if inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") then
			inst.Color = seq
		elseif inst:IsA("PointLight") or inst:IsA("SpotLight") then
			inst.Color = color
		elseif inst:IsA("Highlight") then
			inst.FillColor = color
			inst.OutlineColor = color
		end
	end
	paint(root)
	for _, desc in root:GetDescendants() do
		paint(desc)
	end
end

--[[ X-Men '97 = blue. Marvel Girl = pink. Phoenix: leave authored. ]]
function MorphVfxTint.applyForSkin(model: Model, heroId: string?, skinId: string?, morphName: string?)
	if not model then
		return
	end
	if morphName == "JeanGreyPhoenix" or skinId == "phoenix" then
		return
	end
	if morphName == "JeanGreyMarvelGirl" or skinId == "marvel_girl" then
		MorphVfxTint.paintFx(model, MARVEL_GIRL_PINK)
		return
	end
	if heroId == "jean_grey" or morphName == "JeanGrey" then
		MorphVfxTint.paintFx(model, JEAN_97_BLUE)
	end
end

function MorphVfxTint.applyToTemplateName(model: Model, morphName: string?)
	if morphName == "JeanGreyMarvelGirl" then
		MorphVfxTint.paintFx(model, MARVEL_GIRL_PINK)
		return
	end
	if morphName == "JeanGrey" then
		MorphVfxTint.paintFx(model, JEAN_97_BLUE)
	end
end

return MorphVfxTint
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">ProjectileHelper</string>
          <string name="Source"><![CDATA[--!strict

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local PushHelper = require(ReplicatedStorage.Shared.PushHelper)
local RagdollStatus = require(ReplicatedStorage.Shared.RagdollStatus)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)

local ProjectileHelper = {}

export type ProjectileOptions = {
	speed: number,
	damage: number,
	radius: number,
	maxDistance: number,
	color: Color3?,
	owner: Model,
	accel: number?,
	maxSpeed: number?,
	homeDir: Vector3?,
	homePoint: Vector3?, -- steer toward this world point (aim / body)
	homeTarget: Model?, -- keep updating homePoint from this character
	-- If set, each frame read owner:GetAttribute(name) as Vector3 for live aim (e.g. mouse)
	liveHomeAimAttribute: string?,
	homeAfter: number?,
	homeTurnScale: number?,
	-- If true: deal damage on touch but keep flying until near the target body
	seekUntilClose: boolean?,
	seekCloseDistance: number?,
	ragdollOnHit: number?,
	pushOnHit: boolean?,
	pushSpeed: number?,
	pushUp: number?,
	impactAoeRadius: number?,
	impactAoeDamage: number?,
	impactFx: string?, -- "blast" (default) | "photon_explosion" | "dagger_light" | "psionic" | "none"
	boltFolder: string?, -- Assets subfolder (default ScarletWitch)
	boltAsset: string?, -- template name (default HexBolt)
	customVisual: Instance?, -- existing Part/Model to fly as the bolt (e.g. debris)
	facingOffset: CFrame?, -- extra rotation so mesh faces travel direction
	lockWorldRotation: CFrame?, -- keep this world rotation instead of facing travel (debris rocks)
	-- Seconds to keep visual after particles disable (default short fade)
	deleteAfterFx: number?,
	shouldHeal: ((Model, Model) -> boolean)?, -- (owner, victim) → heal instead of damage
	healAmount: number?,
	ricochetMax: number?, -- max bounces (targets + surfaces)
	ricochetSearchRadius: number?, -- range to find next target after a hit
	onHit: ((Model, Vector3) -> ())?,
	onImpact: ((Vector3, boolean?) -> ())?,
	recolorVisual: boolean?, -- tint cloned bolt particles/beams/trails to options.color
	keepVisual: boolean?, -- leave custom visual in the world after impact (caller owns cleanup)
	impactOnCharacter: boolean?, -- stop at first body contact instead of seeking into the torso
}

type ProjectileState = {
	owner: Model,
	velocity: Vector3,
	speed: number,
	accel: number,
	maxSpeed: number,
	homeDir: Vector3?,
	homePoint: Vector3?,
	homeTarget: Model?,
	liveHomeAimAttribute: string?,
	homeAfter: number,
	homeTurnScale: number,
	seekUntilClose: boolean,
	seekCloseDistance: number,
	age: number,
	damage: number,
	radius: number,
	traveled: number,
	maxDistance: number,
	spawnOrigin: Vector3,
	ragdollOnHit: number?,
	pushOnHit: boolean?,
	pushSpeed: number?,
	pushUp: number?,
	impactAoeRadius: number?,
	impactAoeDamage: number?,
	impactFx: string?,
	shouldHeal: ((Model, Model) -> boolean)?,
	healAmount: number?,
	ricochetsLeft: number,
	ricochetSearchRadius: number,
	hit: { [Model]: boolean },
	onHit: ((Model, Vector3) -> ())?,
	onImpact: ((Vector3, boolean?) -> ())?,
	color: Color3,
	visual: Instance,
	facingOffset: CFrame,
	lockWorldRotation: CFrame?,
	deleteAfterFx: number?,
	recolorVisual: boolean?,
	keepVisual: boolean?,
	impactOnCharacter: boolean,
	hitCharacter: boolean,
}

local active: { [BasePart]: ProjectileState } = {}

local function getBoltTemplate(folderName: string?, assetName: string?): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		return nil
	end
	local name = assetName or "HexBolt"
	if folderName == nil or folderName == "ScarletWitch" or folderName == "ScarletWitchClassic" then
		local classic = assets:FindFirstChild("ScarletWitchClassic")
		local hexBolt = classic and classic:FindFirstChild("HexBolt")
		if hexBolt then
			local nested = hexBolt:FindFirstChild(if name == "HexBolt" then "Bolt" else name)
				or hexBolt:FindFirstChild("Bolt")
			if nested then
				return nested
			end
			if hexBolt:IsA("BasePart") or hexBolt:IsA("Attachment") or hexBolt:IsA("Model") then
				return hexBolt
			end
		end
	end
	local folder = assets:FindFirstChild(folderName or "ScarletWitch")
	if not folder then
		return nil
	end
	local direct = folder:FindFirstChild(name)
	if direct then
		return direct
	end
	if folderName == "JeanGrey" or folderName == "MarvelGirl" then
		local boltFolder = folder:FindFirstChild("PsionicBolt")
		if boltFolder then
			local nested = boltFolder:FindFirstChild(name)
			if nested then
				return nested
			end
			if name == "PsychicBlast" or name == "PsychicBolt" then
				return boltFolder:FindFirstChild("PsychicBolt")
			end
		end
	end
	return nil
end

--[[ Explicit: ReplicatedStorage.Assets.Dagger.RadiantBomb (Attachment). ]]
local function getRadiantBombAttachment(): Attachment?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local dagger = assets and assets:FindFirstChild("Dagger")
	local inst = dagger and dagger:FindFirstChild("RadiantBomb")
	if inst and inst:IsA("Attachment") then
		return inst
	end
	-- Nested attachment under a folder/part
	if inst then
		if inst:IsA("Attachment") then
			return inst
		end
		local nested = inst:FindFirstChildWhichIsA("Attachment", true)
		if nested then
			return nested
		end
	end
	return nil
end

local function emitBoltParticlesNow(root: Instance, count: number?)
	-- Immediate Emit on every ParticleEmitter (plus keep Enabled for flight Rate)
	for _, desc in root:GetDescendants() do
		if desc:IsA("ParticleEmitter") or desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("PointLight") or desc:IsA("SpotLight") then
			(desc :: any).Enabled = true
		end
	end
	if root:IsA("ParticleEmitter") or root:IsA("Beam") or root:IsA("Trail") then
		(root :: any).Enabled = true
	end
	VfxHelper.emitAllParticles(root, count or 16)
end

local function applyAreaForcefieldHit(hitInst: Instance, damage: number): boolean
	local node: Instance? = hitInst
	while node and node ~= workspace do
		if node:GetAttribute("IwAreaShield") == true then
			local root = node
			local parent = root.Parent
			while parent and parent ~= workspace and parent:GetAttribute("IwAreaShield") == true do
				root = parent
				parent = root.Parent
			end
			if root:GetAttribute("IwAreaBroken") == true then
				return true
			end
			local hp = root:GetAttribute("IwAreaHp")
			if type(hp) ~= "number" then
				hp = GameConstants.IW_AREA_HP
			end
			hp -= damage
			root:SetAttribute("IwAreaHp", hp)
			if hp <= 0 then
				root:SetAttribute("IwAreaBroken", true)
				root:SetAttribute("IwAreaHp", 0)
			end
			return true
		end
		node = node.Parent
	end
	return false
end

local function prepareBoltPart(part: BasePart)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
end

local function disableBoltEffects(root: Instance)
	local stack: { Instance } = { root }
	while #stack > 0 do
		local inst = table.remove(stack) :: Instance
		if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") then
			inst.Enabled = false
		elseif inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
			inst.Enabled = false
		elseif inst:IsA("Light") then
			inst.Enabled = false
		end
		for _, child in inst:GetChildren() do
			table.insert(stack, child)
		end
	end
end

-- Stop simulating, fade all parts smoothly, kill FX, then delete.
local function retireVisual(visual: Instance, root: BasePart, deleteAfterFx: number?)
	task.spawn(function()
		local fadeTime = 0.35
		local targets: { Instance } = {}
		local source = if visual.Parent then visual else root
		if source.Parent then
			if source:IsA("BasePart") then
				table.insert(targets, source)
			end
			for _, desc in source:GetDescendants() do
				if desc:IsA("BasePart") or desc:IsA("Decal") or desc:IsA("Texture") then
					table.insert(targets, desc)
				end
			end
			for _, inst in targets do
				if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture") then
					TweenService:Create(inst, TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Transparency = 1,
					}):Play()
				end
			end
		end
		task.wait(GameConstants.HEX_BOLT_FX_DISABLE_DELAY)
		if visual.Parent then
			disableBoltEffects(visual)
		elseif root.Parent then
			disableBoltEffects(root)
		end
		local waitDelete = deleteAfterFx
			or math.max(fadeTime, GameConstants.HEX_BOLT_DELETE_DELAY * 0.25)
		task.wait(waitDelete)
		if visual.Parent then
			visual:Destroy()
		elseif root.Parent then
			root:Destroy()
		end
	end)
end

local function lookCFrame(pos: Vector3, dir: Vector3): CFrame
	local d = if dir.Magnitude > 0.01 then dir.Unit else Vector3.new(0, 0, -1)
	local up = Vector3.yAxis
	if math.abs(d:Dot(up)) > 0.95 then
		up = Vector3.xAxis
	end
	return CFrame.lookAt(pos, pos + d, up)
end

local function setVisualCFrame(visual: Instance, root: BasePart, cf: CFrame)
	if visual:IsA("Model") then
		visual:PivotTo(cf)
	else
		root.CFrame = cf
	end
end

local function visualTravelCFrame(state: ProjectileState, pos: Vector3, look: Vector3): CFrame
	if state.lockWorldRotation then
		local rot = state.lockWorldRotation - state.lockWorldRotation.Position
		return CFrame.new(pos) * rot
	end
	return lookCFrame(pos, look) * state.facingOffset
end

local function createFallbackBolt(origin: Vector3, dir: Vector3, color: Color3): (BasePart, Instance)
	local ball = Instance.new("Part")
	ball.Name = "HexProjectile"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(1.2, 1.2, 1.2)
	ball.CFrame = CFrame.lookAt(origin, origin + dir)
	ball.Material = Enum.Material.SmoothPlastic
	ball.Color = color
	ball.Transparency = 0.25
	prepareBoltPart(ball)
	ball.Parent = workspace

	local shell = Instance.new("Part")
	shell.Name = "HexShell"
	shell.Shape = Enum.PartType.Ball
	shell.Size = Vector3.new(1.85, 1.85, 1.85)
	shell.CFrame = ball.CFrame
	shell.Material = Enum.Material.ForceField
	shell.Color = color
	shell.Transparency = 0.65
	prepareBoltPart(shell)
	shell.Parent = ball

	VfxHelper.attachProjectileTrail(ball, color)
	return ball, ball
end

local function createHexBoltVisual(
	origin: Vector3,
	dir: Vector3,
	color: Color3,
	folderName: string?,
	assetName: string?
): (BasePart, Instance)
	local cf = CFrame.lookAt(origin, origin + dir)

	-- Radiant Bomb: always use ReplicatedStorage.Assets.Dagger.RadiantBomb attachment
	if folderName == "Dagger" and assetName == "RadiantBomb" then
		local template = getRadiantBombAttachment()
		if not template then
			warn("[ProjectileHelper] Missing ReplicatedStorage.Assets.Dagger.RadiantBomb (Attachment)")
			return createFallbackBolt(origin, dir, color)
		end
		local host = Instance.new("Part")
		host.Name = "RadiantBombProjectile"
		host.Shape = Enum.PartType.Ball
		host.Size = Vector3.new(1.6, 1.6, 1.6)
		host.CFrame = cf
		host.Transparency = 1
		host.Material = Enum.Material.SmoothPlastic
		host.CastShadow = false
		prepareBoltPart(host)
		-- Parent host first so emitters are in World when Emitting
		host.Parent = workspace
		local att = template:Clone()
		att.Name = "RadiantBomb"
		att.Position = Vector3.zero
		att.Orientation = Vector3.zero
		att.Parent = host
		VfxHelper.tintParticles(att, color)
		emitBoltParticlesNow(att, 24)
		-- Second Emit next frame in case template Rate/lifetime needs a live step
		task.defer(function()
			if att.Parent then
				emitBoltParticlesNow(att, 24)
			end
		end)
		return host, host
	end

	local template = getBoltTemplate(folderName, assetName)
	if not template then
		return createFallbackBolt(origin, dir, color)
	end

	local clone = template:Clone()
	clone.Name = "HexProjectile"

	-- Attachment-only assets: host on invisible part
	if clone:IsA("Attachment") then
		local host = Instance.new("Part")
		host.Name = "HexProjectile"
		host.Shape = Enum.PartType.Ball
		host.Size = Vector3.new(1.4, 1.4, 1.4)
		host.CFrame = cf
		host.Transparency = 1
		host.Material = Enum.Material.SmoothPlastic
		prepareBoltPart(host)
		clone.Parent = host
		if folderName == "Dagger" then
			VfxHelper.tintParticles(host, color)
		end
		host.Parent = workspace
		emitBoltParticlesNow(host, 12)
		-- PsychicBolt already includes trails — don't stack a generic trail
		if not ((folderName == "JeanGrey" or folderName == "MarvelGirl") and (assetName == "PsychicBolt" or assetName == "PsychicBlast")) then
			VfxHelper.attachProjectileTrail(host, color)
		end
		return host, host
	end

	if clone:IsA("BasePart") then
		prepareBoltPart(clone)
		local impact = clone:FindFirstChild("DaggerImpact", true) or clone:FindFirstChild("ImpactParticle", true)
		if impact then
			impact:Destroy()
		end
		if folderName == "Dagger" then
			VfxHelper.tintParticles(clone, color)
		end
		clone.CFrame = cf
		clone.Parent = workspace
		emitBoltParticlesNow(clone, 10)
		return clone, clone
	end

	if clone:IsA("Model") then
		local primary = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
		if not primary then
			clone:Destroy()
			return createFallbackBolt(origin, dir, color)
		end
		for _, desc in clone:GetDescendants() do
			if desc:IsA("BasePart") then
				prepareBoltPart(desc)
			end
			-- Never carry impact FX on the flying bolt
			if desc.Name == "DaggerImpact" or desc.Name == "ImpactParticle" then
				desc:Destroy()
			end
		end
		if folderName == "Dagger" then
			VfxHelper.tintParticles(clone, color)
		end
		if not clone.PrimaryPart then
			clone.PrimaryPart = primary
		end
		clone:PivotTo(cf)
		clone.Parent = workspace
		emitBoltParticlesNow(clone, 10)
		return primary, clone
	end

	-- Folder / other: prefer first BasePart, parent whole clone under a Model
	local firstPart = clone:FindFirstChildWhichIsA("BasePart", true)
	if not firstPart then
		-- Attachment / particle-only folder (PsychicBolt internals)
		local host = Instance.new("Part")
		host.Name = "HexProjectile"
		host.Shape = Enum.PartType.Ball
		host.Size = Vector3.new(1.4, 1.4, 1.4)
		host.CFrame = cf
		host.Transparency = 1
		host.Material = Enum.Material.SmoothPlastic
		prepareBoltPart(host)
		clone.Parent = host
		host.Parent = workspace
		emitBoltParticlesNow(host, 12)
		if not ((folderName == "JeanGrey" or folderName == "MarvelGirl") and (assetName == "PsychicBolt" or assetName == "PsychicBlast")) then
			VfxHelper.attachProjectileTrail(host, color)
		end
		return host, host
	end
	local wrapper = Instance.new("Model")
	wrapper.Name = "HexProjectile"
	clone.Parent = wrapper
	for _, desc in wrapper:GetDescendants() do
		if desc:IsA("BasePart") then
			prepareBoltPart(desc)
		end
	end
	wrapper.PrimaryPart = firstPart
	wrapper:PivotTo(cf)
	wrapper.Parent = workspace
	emitBoltParticlesNow(wrapper, 10)
	return firstPart, wrapper
end

local function getBoltEndPosition(visual: Instance, root: BasePart, look: Vector3): Vector3
	local dir = if look.Magnitude > 0.01 then look.Unit else root.CFrame.LookVector
	if visual:IsA("Model") then
		local cf, size = visual:GetBoundingBox()
		return cf.Position + dir * (size.Z * 0.5)
	end
	return root.Position + dir * (math.max(root.Size.Z, root.Size.X) * 0.5)
end

local function contactOnCharacter(from: Vector3, delta: Vector3, victim: Model, fallback: Vector3): Vector3
	local parts: { Instance } = {}
	for _, desc in victim:GetDescendants() do
		if desc:IsA("BasePart") then
			table.insert(parts, desc)
		end
	end
	if #parts == 0 then
		return fallback
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = parts
	local travel = if delta.Magnitude > 0.01 then delta else Vector3.new(0, -1, 0)
	local hit = workspace:Raycast(from, travel.Unit * (travel.Magnitude + 6), params)
	if hit then
		return hit.Position
	end
	return fallback
end

local function showImpactAoe(pos: Vector3, radius: number, color: Color3, impactFx: string?)
	local fx = impactFx or "blast"
	if fx == "photon_explosion" then
		VfxHelper.spawnPhotonExplosionImpact(pos, radius)
	elseif fx == "photon_blast" then
		VfxHelper.spawnPhotonBlastImpact(pos, radius)
	elseif fx == "dagger_light" then
		VfxHelper.spawnDaggerLightImpact(pos, radius)
	elseif fx ~= "none" then
		VfxHelper.spawnBlastImpact(pos, radius)
	end
	-- No procedural PulseRing — Assets particles only
end

local function applyProjectileHit(state: ProjectileState, victim: Model, hitFrom: Vector3?)
	if state.shouldHeal and state.shouldHeal(state.owner, victim) then
		CombatHelper.heal(victim, state.healAmount or state.damage)
		return
	end
	CombatHelper.dealDamage(state.owner, victim, state.damage, hitFrom, "projectile")
	if state.ragdollOnHit and state.ragdollOnHit > 0 then
		RagdollStatus.applyTimed(victim, state.ragdollOnHit)
	end
	if state.pushOnHit then
		local away = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
		local pushDir = if away and hitFrom then (away.Position - hitFrom) else state.velocity
		if pushDir.Magnitude < 0.05 then
			pushDir = state.velocity
		end
		if pushDir.Magnitude < 0.01 then
			pushDir = Vector3.new(0, 0, -1)
		end
		PushHelper.applyToCharacter(victim, pushDir, {
			speed = state.pushSpeed or GameConstants.HEX_BLAST_BARRAGE_PUSH_SPEED,
			upBoost = state.pushUp or GameConstants.HEX_BLAST_BARRAGE_PUSH_UP,
		})
	end
end

local function findRicochetTarget(
	fromPos: Vector3,
	owner: Model,
	alreadyHit: { [Model]: boolean },
	searchRadius: number
): Model?
	local best: Model? = nil
	local bestDist = searchRadius
	for _, victim in CombatHelper.overlapCharacters(fromPos, searchRadius, owner) do
		if alreadyHit[victim] then
			continue
		end
		if victim:GetAttribute("LokiUltClone") == true or victim:GetAttribute("LokiDecoy") == true then
			continue
		end
		if victim:GetAttribute("FearVisual") == true or victim.Name == "FearClone" then
			continue
		end
		local root = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			continue
		end
		local dist = (root.Position - fromPos).Magnitude
		if dist < bestDist then
			bestDist = dist
			best = victim
		end
	end
	return best
end

local function redirectToward(state: ProjectileState, part: BasePart, targetPos: Vector3)
	local to = targetPos - part.Position
	if to.Magnitude < 0.05 then
		return
	end
	local dir = to.Unit
	state.velocity = dir * state.speed
	state.homeDir = dir
	state.homePoint = targetPos
	state.homeTarget = nil
	state.seekUntilClose = false
end

--[[ Wanda shield: bounce bolt back at whoever fired it (or radial if unknown). ]]
local function redirectOffShield(
	state: ProjectileState,
	part: BasePart,
	shieldCharacter: Model,
	previousOwner: Model?,
	sparkPos: Vector3
)
	state.speed = GameConstants.SHIELD_DEFLECT_SPEED
	state.accel = 0
	state.traveled = 0
	state.owner = shieldCharacter
	-- Clear old seek so it doesn't steer back into the shield
	state.homePoint = nil
	state.homeTarget = nil
	state.seekUntilClose = false

	local aimModel: Model? = nil
	if previousOwner and previousOwner.Parent and previousOwner ~= shieldCharacter then
		aimModel = previousOwner
	end
	local aimRoot = aimModel and (aimModel:FindFirstChild("HumanoidRootPart") :: BasePart?)
	if aimRoot then
		redirectToward(state, part, aimRoot.Position)
		state.homeTarget = aimModel
		state.homePoint = aimRoot.Position
		state.seekUntilClose = true
	else
		local shieldRoot = shieldCharacter:FindFirstChild("HumanoidRootPart") :: BasePart?
		local away = if shieldRoot then (part.Position - shieldRoot.Position) else state.velocity
		if away.Magnitude < 0.05 then
			away = if shieldRoot then shieldRoot.CFrame.LookVector else Vector3.new(0, 0, -1)
		end
		state.velocity = away.Unit * state.speed
		state.homeDir = away.Unit
	end
	VfxHelper.spawnBurstSparks(sparkPos, VfxHelper.chaosSoft(), 4)
end

local function reflectVelocity(state: ProjectileState, normal: Vector3)
	local vel = state.velocity
	if vel.Magnitude < 0.01 then
		return
	end
	local n = if normal.Magnitude > 0.01 then normal.Unit else Vector3.yAxis
	local reflected = vel - 2 * vel:Dot(n) * n
	if reflected.Magnitude < 0.01 then
		reflected = n * state.speed
	else
		reflected = reflected.Unit * state.speed
	end
	state.velocity = reflected
	state.homeDir = reflected.Unit
	state.homePoint = nil
	state.homeTarget = nil
	state.seekUntilClose = false
end

local function applyImpactAoe(state: ProjectileState, pos: Vector3)
	local aoeR = state.impactAoeRadius
	if not aoeR or aoeR <= 0 then
		return
	end
	showImpactAoe(pos, aoeR, state.color, state.impactFx)
	for _, victim in CombatHelper.overlapCharacters(pos, aoeR, state.owner) do
		if state.hit[victim] then
			continue
		end
		if victim:GetAttribute("LokiUltClone") == true or victim:GetAttribute("LokiDecoy") == true then
			continue
		end
		state.hit[victim] = true
		if CombatHelper.isShielded(victim) then
			-- Shields still block; only damage path (no heal through shield)
			if not (state.shouldHeal and state.shouldHeal(state.owner, victim)) then
				CombatHelper.dealDamage(state.owner, victim, state.impactAoeDamage or state.damage, state.spawnOrigin, "projectile")
			end
			continue
		end
		local prevDamage = state.damage
		state.damage = state.impactAoeDamage or state.damage
		applyProjectileHit(state, victim, pos)
		state.damage = prevDamage
		if state.onHit then
			state.onHit(victim, pos)
		end
	end
end

local function impactAt(state: ProjectileState, pos: Vector3)
	if state.impactAoeRadius and state.impactAoeRadius > 0 then
		applyImpactAoe(state, pos)
	else
		local r = math.clamp(state.radius * 0.4, 1.5, GameConstants.HEX_BLAST_IMPACT_VISUAL)
		if state.impactFx == "photon_blast" then
			VfxHelper.spawnPhotonBlastImpact(pos, r)
		elseif state.impactFx == "photon_explosion" then
			VfxHelper.spawnPhotonExplosionImpact(pos, r)
		elseif state.impactFx == "loki" then
			VfxHelper.spawnLokiBlastImpact(pos, r)
		elseif state.impactFx == "dagger_light" then
			VfxHelper.spawnDaggerLightImpact(pos, r)
		elseif state.impactFx == "psionic" then
			VfxHelper.spawnMarvelGirlPsionicImpact(pos, r, if state.recolorVisual then state.color else nil)
		elseif state.impactFx ~= "none" then
			VfxHelper.spawnBlastImpact(pos, r)
		end
	end
	if state.onImpact then
		state.onImpact(pos, state.hitCharacter)
	end
end

function ProjectileHelper.spawn(origin: Vector3, direction: Vector3, options: ProjectileOptions): BasePart
	local dir = if direction.Magnitude > 0.01 then direction.Unit else Vector3.new(0, 0, -1)
	local color = options.color or VfxHelper.chaosColor()

	local root: BasePart
	local visual: Instance
	local custom = options.customVisual
	if custom and custom:IsA("BasePart") then
		root = custom
		visual = custom
		prepareBoltPart(root)
		root.Name = "HexProjectile"
		if not root.Parent then
			root.Parent = workspace
		end
	elseif custom and custom:IsA("Model") then
		local primary = custom.PrimaryPart or custom:FindFirstChildWhichIsA("BasePart", true)
		if primary and primary:IsA("BasePart") then
			root = primary
			visual = custom
			for _, desc in custom:GetDescendants() do
				if desc:IsA("BasePart") then
					prepareBoltPart(desc)
				end
			end
			if not custom.Parent then
				custom.Parent = workspace
			end
		else
			root, visual = createHexBoltVisual(origin, dir, color, options.boltFolder, options.boltAsset)
		end
	else
		root, visual = createHexBoltVisual(origin, dir, color, options.boltFolder, options.boltAsset)
	end

	local facingOffset = options.facingOffset or CFrame.identity
	-- Asset can declare ProjectileYaw/Pitch/Roll (degrees) for mesh tip alignment
	if typeof(visual:GetAttribute("ProjectileYaw")) == "number"
		or typeof(visual:GetAttribute("ProjectilePitch")) == "number"
		or typeof(visual:GetAttribute("ProjectileRoll")) == "number"
	then
		local yaw = (visual:GetAttribute("ProjectileYaw") :: number?) or 0
		local pitch = (visual:GetAttribute("ProjectilePitch") :: number?) or 0
		local roll = (visual:GetAttribute("ProjectileRoll") :: number?) or 0
		facingOffset = CFrame.Angles(math.rad(pitch), math.rad(yaw), math.rad(roll))
	end
	local baseLook = lookCFrame(origin, dir)
	local tipPart: BasePart? = if visual:IsA("Model") then visual.PrimaryPart elseif visual:IsA("BasePart") then visual else nil
	local tip = visual:FindFirstChild("Tip", true) or visual:FindFirstChild("Forward", true)
	if tip and tip:IsA("Attachment") and tipPart then
		setVisualCFrame(visual, root, baseLook)
		local tipLook = tip.WorldCFrame.LookVector
		if tipLook.Magnitude > 0.01 then
			local from = tipLook.Unit
			local to = dir.Unit
			local axis = from:Cross(to)
			local dot = math.clamp(from:Dot(to), -1, 1)
			local align = CFrame.identity
			if axis.Magnitude > 0.001 then
				align = CFrame.fromAxisAngle(axis.Unit, math.acos(dot))
			elseif dot < 0 then
				local ortho = if math.abs(from:Dot(Vector3.yAxis)) < 0.9 then Vector3.yAxis else Vector3.xAxis
				align = CFrame.fromAxisAngle(from:Cross(ortho).Unit, math.pi)
			end
			local finalCf = CFrame.new(origin) * align * (baseLook - baseLook.Position)
			facingOffset = baseLook:Inverse() * finalCf
		end
	elseif
		(options.boltAsset == "Dagger" or options.boltAsset == "LightDagger" or options.boltAsset == "IceShard")
		and options.facingOffset == nil
		and tipPart
	then
		-- No Tip: aim longest mesh axis along travel
		local size = tipPart.Size
		if size.X >= size.Y and size.X >= size.Z then
			facingOffset = CFrame.Angles(0, math.rad(-90), 0)
		elseif size.Y >= size.X and size.Y >= size.Z then
			facingOffset = CFrame.Angles(math.rad(-90), 0, 0)
		else
			facingOffset = CFrame.Angles(0, math.pi, 0)
		end
	end
	setVisualCFrame(visual, root, lookCFrame(origin, dir) * facingOffset)
	if options.lockWorldRotation then
		local rot = options.lockWorldRotation - options.lockWorldRotation.Position
		setVisualCFrame(visual, root, CFrame.new(origin) * rot)
	end

	if options.recolorVisual == true then
		VfxHelper.tintParticles(visual, color)
	end

	local startSpeed = options.speed
	active[root] = {
		owner = options.owner,
		velocity = dir * startSpeed,
		speed = startSpeed,
		accel = options.accel or 0,
		maxSpeed = options.maxSpeed or startSpeed,
		homeDir = if options.homeDir and options.homeDir.Magnitude > 0.01 then options.homeDir.Unit else nil,
		homePoint = options.homePoint,
		homeTarget = options.homeTarget,
		liveHomeAimAttribute = options.liveHomeAimAttribute,
		homeAfter = options.homeAfter or 0,
		homeTurnScale = options.homeTurnScale or 1,
		seekUntilClose = options.seekUntilClose == true,
		seekCloseDistance = options.seekCloseDistance or 2.2,
		age = 0,
		damage = options.damage,
		radius = options.radius,
		traveled = 0,
		maxDistance = options.maxDistance,
		spawnOrigin = origin,
		ragdollOnHit = options.ragdollOnHit,
		pushOnHit = options.pushOnHit,
		pushSpeed = options.pushSpeed,
		pushUp = options.pushUp,
		impactAoeRadius = options.impactAoeRadius,
		impactAoeDamage = options.impactAoeDamage,
		impactFx = options.impactFx,
		shouldHeal = options.shouldHeal,
		healAmount = options.healAmount,
		ricochetsLeft = math.max(0, options.ricochetMax or 0),
		ricochetSearchRadius = options.ricochetSearchRadius or 35,
		hit = {},
		onHit = options.onHit,
		onImpact = options.onImpact,
		color = color,
		visual = visual,
		facingOffset = facingOffset,
		lockWorldRotation = options.lockWorldRotation,
		deleteAfterFx = options.deleteAfterFx,
		recolorVisual = options.recolorVisual == true,
		keepVisual = options.keepVisual == true,
		impactOnCharacter = options.impactOnCharacter == true,
		hitCharacter = false,
	}

	-- Failsafe only; normal lifetime ends via retireVisual (FX off, then delete)
	if options.keepVisual ~= true then
		local deleteFx = options.deleteAfterFx or GameConstants.HEX_BOLT_DELETE_DELAY
		Debris:AddItem(visual, options.maxDistance / math.max(startSpeed, 1) + GameConstants.HEX_BOLT_FX_DISABLE_DELAY + deleteFx + 4)
	end
	return root
end

function ProjectileHelper.update(dt: number)
	local dtClamped = math.clamp(dt, 0.001, 0.1)
	for part, state in active do
		if not part.Parent or not state.visual.Parent then
			active[part] = nil
			continue
		end

		state.age += dtClamped

		-- Keep seeking a live character body if assigned
		if state.homeTarget and state.homeTarget.Parent then
			local targetRoot = state.homeTarget:FindFirstChild("HumanoidRootPart") :: BasePart?
			if targetRoot then
				state.homePoint = targetRoot.Position
			end
		elseif state.homeTarget then
			state.homeTarget = nil
		end

		-- Live mouse / aim attribute on owner (Lumen Barrage)
		if state.liveHomeAimAttribute then
			local live = state.owner:GetAttribute(state.liveHomeAimAttribute)
			if typeof(live) == "Vector3" then
				state.homePoint = live
				local toLive = live - part.Position
				if toLive.Magnitude > 0.05 then
					state.homeDir = toLive.Unit
				end
			end
		end

		local canHome = state.age >= state.homeAfter
			and (state.homeDir ~= nil or state.homePoint ~= nil)

		if state.accel > 0 then
			if canHome then
				state.speed = math.min(state.maxSpeed, state.speed + state.accel * dtClamped)
			else
				-- Balloon expand: stay relatively slow while fanning out
				state.speed = math.min(state.maxSpeed * 0.28, state.speed + state.accel * 0.12 * dtClamped)
			end
		end

		local dir = if state.velocity.Magnitude > 0.01 then state.velocity.Unit else Vector3.new(0, 0, -1)
		if canHome then
			local desired = state.homeDir
			if state.homePoint then
				local toPoint = state.homePoint - part.Position
				if toPoint.Magnitude > 0.05 then
					desired = toPoint.Unit
				end
			end
			if desired then
				local dist = 24
				if state.homePoint then
					dist = (state.homePoint - part.Position).Magnitude
				end
				local farT = math.clamp((dist - 6) / 58, 0, 1)
				local scale = math.clamp(state.homeTurnScale, 0.2, 1.6)
				local rate = (1.45 * scale) * (1 - 0.8 * farT)
				if state.accel > 0 then
					local blend = math.clamp((state.age - state.homeAfter) / 0.55, 0, 1)
					rate *= 0.35 + blend * 0.65
				end
				local turn = 1 - math.exp(-rate * dtClamped)
				dir = dir:Lerp(desired, math.clamp(turn, 0, 1))
				if dir.Magnitude > 0.01 then
					dir = dir.Unit
				end
			end
		end
		state.velocity = dir * state.speed

		local step = state.velocity * dtClamped
		local nextPos = part.Position + step
		state.traveled += step.Magnitude

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { state.owner, state.visual }
		local hit = workspace:Raycast(part.Position, step, params)
		if hit then
			-- Ignore character parts for wall ricochet — character hits use overlap
			local hitChar = CombatHelper.getCharacterFromPart(hit.Instance)
			if hitChar then
				hit = nil
			else
				nextPos = hit.Position - state.velocity.Unit * 0.15
			end
		end
		local look = if state.velocity.Magnitude > 0.01 then state.velocity.Unit else Vector3.new(0, 0, -1)
		setVisualCFrame(state.visual, part, visualTravelCFrame(state, nextPos, look))
		local shell = part:FindFirstChild("HexShell")
		if shell and shell:IsA("BasePart") then
			shell.CFrame = part.CFrame
		end

		-- Impact / callbacks use bolt tip, or exact raycast contact if we hit geometry
		local endPos = if hit then hit.Position else getBoltEndPosition(state.visual, part, look)

		local victims = CombatHelper.overlapCharacters(nextPos, state.radius, state.owner)
		local hitSomeone = false
		local ricocheted = false
		for _, victim in victims do
			if state.hit[victim] then
				continue
			end
			-- Loki ult/decoy clones: never damage each other or friendly clones
			if
				victim:GetAttribute("LokiUltClone") == true
				or victim:GetAttribute("LokiDecoy") == true
			then
				continue
			end
			if CombatHelper.isShielded(victim) then
				if not state.hit[victim] then
					state.hit[victim] = true
					if not (state.shouldHeal and state.shouldHeal(state.owner, victim)) then
						CombatHelper.dealDamage(state.owner, victim, state.damage, endPos, "projectile")
					end
				end
				-- Marvel Girl barrier absorbs (damage only); Wanda still reflects
				if victim:GetAttribute(GameConstants.MG_BARRIER_ATTRIBUTE) == true then
					hitSomeone = true
					break
				end
				local previousOwner = state.owner
				redirectOffShield(state, part, victim, previousOwner, endPos)
				continue
			end
			state.hit[victim] = true
			local contact = contactOnCharacter(part.Position, step, victim, nextPos)
			endPos = contact
			applyProjectileHit(state, victim, state.spawnOrigin)
			if state.onHit then
				state.onHit(victim, contact)
			end

			if state.impactOnCharacter then
				state.hitCharacter = true
				hitSomeone = true
				break
			end

			if state.ricochetsLeft > 0 then
				state.ricochetsLeft -= 1
				local nextTarget = findRicochetTarget(nextPos, state.owner, state.hit, state.ricochetSearchRadius)
				if nextTarget then
					local tRoot = nextTarget:FindFirstChild("HumanoidRootPart") :: BasePart?
					if tRoot then
						redirectToward(state, part, tRoot.Position)
						state.homeTarget = nextTarget
						state.homePoint = tRoot.Position
						ricocheted = true
						VfxHelper.spawnBurstSparks(nextPos, state.color, 5)
						break
					end
				end
				-- No next target: stop after this hit
				hitSomeone = true
				break
			elseif state.seekUntilClose then
				-- Keep flying into the body / aim so the bolt visually connects
				state.homeTarget = victim
				local vRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
				if vRoot then
					state.homePoint = vRoot.Position
				end
			else
				hitSomeone = true
				break
			end
		end

		if ricocheted then
			-- Keep flying after redirect
			continue
		end

		-- Seek bolts finish when close to the body / aim point
		if state.seekUntilClose and state.homePoint then
			local distToHome = (nextPos - state.homePoint).Magnitude
			if distToHome <= state.seekCloseDistance then
				local focus = state.homeTarget
				if focus and focus.Parent and not state.hit[focus] and not CombatHelper.isShielded(focus) then
					state.hit[focus] = true
					applyProjectileHit(state, focus, state.spawnOrigin)
					if state.onHit then
						state.onHit(focus, state.homePoint)
					end
				end
				hitSomeone = true
				endPos = state.homePoint
			end
		end

		if hitSomeone then
			impactAt(state, endPos)
			if state.keepVisual then
				active[part] = nil
			else
				retireVisual(state.visual, part, state.deleteAfterFx)
				active[part] = nil
			end
			continue
		end

		if state.traveled >= state.maxDistance then
			impactAt(state, endPos)
			if state.keepVisual then
				active[part] = nil
			else
				retireVisual(state.visual, part, state.deleteAfterFx)
				active[part] = nil
			end
		elseif hit then
			-- Surface hit: ricochet off walls if charges remain
			if state.ricochetsLeft > 0 then
				state.ricochetsLeft -= 1
				reflectVelocity(state, hit.Normal)
				setVisualCFrame(
					state.visual,
					part,
					visualTravelCFrame(state, nextPos, state.velocity.Unit)
				)
				VfxHelper.spawnBurstSparks(hit.Position, state.color, 4)
			else
				applyAreaForcefieldHit(hit.Instance, state.damage)
				impactAt(state, endPos)
				if state.keepVisual then
					active[part] = nil
				else
					retireVisual(state.visual, part, state.deleteAfterFx)
					active[part] = nil
				end
			end
		end
	end
end

function ProjectileHelper.deflectNearShield(shieldCharacter: Model, radius: number)
	local root = shieldCharacter:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	for part, state in active do
		if not part.Parent then
			continue
		end
		if (part.Position - root.Position).Magnitude > radius then
			continue
		end
		if state.owner == shieldCharacter then
			continue
		end

		-- First contact: apply shield damage + partial shield VFX immediately
		local previousOwner = state.owner
		if not state.hit[shieldCharacter] then
			state.hit[shieldCharacter] = true
			CombatHelper.dealDamage(previousOwner, shieldCharacter, state.damage, part.Position, "projectile")
		end

		redirectOffShield(state, part, shieldCharacter, previousOwner, part.Position)
	end
end

return ProjectileHelper
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">PushHelper</string>
          <string name="Source"><![CDATA[--!strict

local PushHelper = {}

export type PushOptions = {
	speed: number,
	upBoost: number?,
	impulseMult: number?,
}

function PushHelper.applyToPart(part: BasePart, direction: Vector3, options: PushOptions)
	if part.Anchored then
		return
	end
	local pushDir = if direction.Magnitude > 0.01 then direction.Unit else Vector3.new(0, 0, -1)
	local up = options.upBoost or 0
	part.AssemblyLinearVelocity = pushDir * options.speed + Vector3.new(0, up, 0)
	pcall(function()
		part:ApplyImpulse(pushDir * part.AssemblyMass * options.speed * 0.5)
	end)
end

-- Aim from current HRP toward cursor. If the cursor is too close, use caster look.
function PushHelper.launchTowardCursor(fromPos: Vector3, aimPoint: Vector3?, fallbackLook: Vector3): Vector3
	local look = Vector3.new(fallbackLook.X, 0, fallbackLook.Z)
	if look.Magnitude < 0.05 then
		look = Vector3.new(0, 0, -1)
	else
		look = look.Unit
	end
	local cursor = aimPoint
	if typeof(cursor) ~= "Vector3" then
		cursor = fromPos + look * 90
	end
	local launchVec = cursor - fromPos
	local launch: Vector3
	if launchVec.Magnitude < 10 then
		launch = look * 0.88 + Vector3.yAxis * 0.22
	else
		launch = launchVec.Unit
	end
	if launch.Magnitude > 0.01 then
		return launch.Unit
	end
	return look
end

function PushHelper.telekineticFling(character: Model, root: BasePart, launch: Vector3, speed: number, upBoost: number)
	local function shove()
		if not character.Parent or not root.Parent then
			return
		end
		PushHelper.applyToCharacter(character, launch, {
			speed = speed,
			upBoost = upBoost,
			impulseMult = 0.94,
		})
		root.AssemblyLinearVelocity = launch * speed + Vector3.new(0, math.max(22, upBoost * 0.85), 0)
	end
	shove()
	task.defer(shove)
	task.delay(0.06, shove)
end

function PushHelper.applyToCharacter(character: Model, direction: Vector3, options: PushOptions)
	local pushDir = if direction.Magnitude > 0.01 then direction.Unit else Vector3.new(0, 0, -1)
	local up = options.upBoost or 0
	local velocity = pushDir * options.speed + Vector3.new(0, up, 0)
	local impulseMult = options.impulseMult or 0.85

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root and not root.Anchored then
		root.AssemblyLinearVelocity = velocity
		pcall(function()
			root:ApplyImpulse(pushDir * root.AssemblyMass * options.speed * impulseMult)
		end)
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end
end

return PushHelper
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">RagdollStatus</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Shared ragdoll status API. On the server, RagdollService.bindServer hooks these
	into constraint ragdoll physics. Attribute-only fallback for clients / before bind.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local RagdollStatus = {}

local clearTokenByModel: { [Model]: number } = {}

type ServerHandlers = {
	apply: (Model) -> (),
	clear: (Model) -> (),
	applyTimed: (Model, number) -> (),
	clearAfter: (Model, number) -> (),
}

local server: ServerHandlers? = nil

local function nextToken(model: Model): number
	local token = (clearTokenByModel[model] or 0) + 1
	clearTokenByModel[model] = token
	return token
end

function RagdollStatus.bindServer(handlers: ServerHandlers)
	server = handlers
end

function RagdollStatus.isRagdolled(character: Model): boolean
	return character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true
end

function RagdollStatus.apply(character: Model)
	if server then
		server.apply(character)
		return
	end
	character:SetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.RAGDOLL_END_ATTRIBUTE, nil)
	nextToken(character)
end

function RagdollStatus.clear(character: Model)
	if server then
		server.clear(character)
		return
	end
	nextToken(character)
	character:SetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.RAGDOLL_END_ATTRIBUTE, nil)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Parent then
		humanoid.PlatformStand = false
	end
end

function RagdollStatus.applyTimed(character: Model, duration: number)
	if character:GetAttribute("TelekinesisHeld") == true then
		RagdollStatus.apply(character)
		return
	end
	if server then
		server.applyTimed(character, duration)
		return
	end

	local endTime = AbilityCooldownHelper.getNow() + duration
	local currentEnd = character:GetAttribute(GameConstants.RAGDOLL_END_ATTRIBUTE)
	if type(currentEnd) == "number" and currentEnd > endTime then
		character:SetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE, true)
		return
	end

	character:SetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.RAGDOLL_END_ATTRIBUTE, endTime)
	local token = nextToken(character)
	task.delay(duration, function()
		if not character.Parent then
			return
		end
		if clearTokenByModel[character] ~= token then
			return
		end
		if character:GetAttribute("TelekinesisHeld") == true then
			return
		end
		local scheduled = character:GetAttribute(GameConstants.RAGDOLL_END_ATTRIBUTE)
		if type(scheduled) == "number" and AbilityCooldownHelper.getNow() + 0.05 < scheduled then
			return
		end
		RagdollStatus.clear(character)
	end)
end

function RagdollStatus.clearAfter(character: Model, delaySec: number)
	if server then
		server.clearAfter(character, delaySec)
		return
	end
	local token = nextToken(character)
	local endTime = AbilityCooldownHelper.getNow() + delaySec
	character:SetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.RAGDOLL_END_ATTRIBUTE, endTime)
	task.delay(delaySec, function()
		if not character.Parent then
			return
		end
		if clearTokenByModel[character] ~= token then
			return
		end
		if character:GetAttribute("TelekinesisHeld") == true then
			return
		end
		RagdollStatus.clear(character)
	end)
end

return RagdollStatus
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
--[[ Remotes: server creates under ReplicatedStorage.Remotes; clients wait for them. ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local folder: Folder? = nil
local isServer = RunService:IsServer()

local function getFolder(): Folder
	if folder then
		return folder
	end
	if isServer then
		local existing = ReplicatedStorage:FindFirstChild("Remotes")
		if existing and existing:IsA("Folder") then
			folder = existing
			return existing
		end
		local created = Instance.new("Folder")
		created.Name = "Remotes"
		created.Parent = ReplicatedStorage
		folder = created
		return created
	end

	local waited = ReplicatedStorage:WaitForChild("Remotes", 30)
	if waited and waited:IsA("Folder") then
		folder = waited
		return waited
	end
	-- Fallback if server hasn't created yet (Studio edge case)
	local created = Instance.new("Folder")
	created.Name = "Remotes"
	created.Parent = ReplicatedStorage
	folder = created
	return created
end

function Remotes.getEvent(name: string): RemoteEvent
	local parent = getFolder()
	if isServer then
		local existing = parent:FindFirstChild(name)
		if existing and existing:IsA("RemoteEvent") then
			return existing
		end
		if existing then
			existing:Destroy()
		end
		local event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = parent
		return event
	end

	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local waited = parent:WaitForChild(name, 30)
	if waited and waited:IsA("RemoteEvent") then
		return waited
	end
	error(`[Remotes] RemoteEvent "{name}" not found`)
end

function Remotes.getUnreliableEvent(name: string): UnreliableRemoteEvent
	local parent = getFolder()
	if isServer then
		local existing = parent:FindFirstChild(name)
		if existing and existing:IsA("UnreliableRemoteEvent") then
			return existing
		end
		if existing then
			existing:Destroy()
		end
		local event = Instance.new("UnreliableRemoteEvent")
		event.Name = name
		event.Parent = parent
		return event
	end

	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("UnreliableRemoteEvent") then
		return existing
	end
	local waited = parent:WaitForChild(name, 30)
	if waited and waited:IsA("UnreliableRemoteEvent") then
		return waited
	end
	error(`[Remotes] UnreliableRemoteEvent "{name}" not found`)
end

-- Call once from server so clients can WaitForChild immediately
function Remotes.init()
	if not isServer then
		return
	end
	Remotes.getEvent("SelectHero")
	Remotes.getEvent("UseAbility")
	Remotes.getEvent("FlightInput")
	Remotes.getEvent("SprintInput")
	Remotes.getEvent("CameraShake")
	Remotes.getEvent("BeamClash")
	Remotes.getEvent("MindLink")
	Remotes.getEvent("HexDisplacementCam")
	Remotes.getEvent("ProbabilityHexResult")
	Remotes.getEvent("PhoenixRevive")
	Remotes.getEvent("PlayerDataSync")
	Remotes.getEvent("PurchaseShopItem")
	Remotes.getEvent("ShopPurchaseResult")
	Remotes.getEvent("RefreshPlayerData")
	Remotes.getUnreliableEvent("ShieldPartialHit")
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ScreenFeelHelper</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Victim / caster screen feel: CameraShake pulses plus held tint / speed-FOV attributes.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConstants = require(script.Parent.GameConstants)
local Remotes = require(script.Parent.Remotes)

local ScreenFeelHelper = {}

export type PulseOpts = {
	intensity: number?,
	duration: number?,
	fovScale: number?,
	vignetteScale: number?,
	tint: Color3?,
	tintDuration: number?,
}

function ScreenFeelHelper.pulsePlayer(player: Player, opts: PulseOpts)
	Remotes.getEvent("CameraShake"):FireClient(player, {
		intensity = opts.intensity or 0.45,
		duration = opts.duration or 0.35,
		fovScale = opts.fovScale,
		vignetteScale = opts.vignetteScale,
		tint = opts.tint,
		tintDuration = opts.tintDuration,
	})
end

function ScreenFeelHelper.pulseCharacter(character: Model, opts: PulseOpts)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		ScreenFeelHelper.pulsePlayer(player, opts)
	end
end

function ScreenFeelHelper.setTint(character: Model, color: Color3?, duration: number?)
	if not character.Parent then
		return
	end
	if color then
		character:SetAttribute(GameConstants.SCREEN_TINT_ATTRIBUTE, color)
		if type(duration) == "number" and duration > 0 then
			character:SetAttribute(GameConstants.SCREEN_TINT_UNTIL_ATTRIBUTE, Workspace:GetServerTimeNow() + duration)
		else
			character:SetAttribute(GameConstants.SCREEN_TINT_UNTIL_ATTRIBUTE, nil)
		end
	else
		character:SetAttribute(GameConstants.SCREEN_TINT_ATTRIBUTE, nil)
		character:SetAttribute(GameConstants.SCREEN_TINT_UNTIL_ATTRIBUTE, nil)
	end
end

function ScreenFeelHelper.setSpeedFov(character: Model, on: boolean)
	if not character.Parent then
		return
	end
	character:SetAttribute(GameConstants.SCREEN_SPEED_FOV_ATTRIBUTE, if on then true else nil)
end

function ScreenFeelHelper.setShakeHold(character: Model, on: boolean)
	if not character.Parent then
		return
	end
	character:SetAttribute(GameConstants.SCREEN_SHAKE_HOLD_ATTRIBUTE, if on then true else nil)
end

function ScreenFeelHelper.clear(character: Model)
	if not character.Parent then
		return
	end
	character:SetAttribute(GameConstants.SCREEN_TINT_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.SCREEN_TINT_UNTIL_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.SCREEN_SPEED_FOV_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.SCREEN_SHAKE_HOLD_ATTRIBUTE, nil)
end

return ScreenFeelHelper
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">ShopCatalog</string>
          <string name="Source"><![CDATA[--!strict
--[[ Shop catalog: coin unlocks, Robux products, gamepass, and combat buffs. ]]

export type ShopCurrency = "coins" | "robux"
export type ShopItemKind = "character" | "skin" | "bundle" | "gamepass" | "devproduct"

export type ShopItem = {
	id: string,
	name: string,
	description: string,
	kind: ShopItemKind,
	currency: ShopCurrency,
	price: number,
	productId: number?,
	gamepassId: number?,
	grantCharacter: string?,
	grantSkins: { { heroId: string, skinId: string } }?,
	grantBundle: string?,
	buffLabel: string?,
}

export type CoinPack = {
	id: string,
	label: string,
	amount: number,
	productId: number,
	robuxPrice: number?,
}

local ShopCatalog = {}

-- TEMP playtest unlock: set to false to restore character/skin shop locks.
ShopCatalog.UNLOCK_ALL = true

-- Creator Dashboard gamepass IDs
ShopCatalog.ELITE_GAMEPASS_ID = 1951310371
ShopCatalog.PHOENIX_GAMEPASS_ID = 1951017728
ShopCatalog.ROGUE_GAMEPASS_ID = 1948287768

ShopCatalog.KILL_COIN_REWARD = 100
ShopCatalog.ELITE_COIN_MULT = 2

-- Creator Dashboard developer product IDs for coin packs (set each productId after publishing).
ShopCatalog.COIN_PACKS = {
	{ id = "coins_1k", label = "+1,000", amount = 1000, productId = 0, robuxPrice = 49 },
	{ id = "coins_5k", label = "+5,000", amount = 5000, productId = 0, robuxPrice = 199 },
	{ id = "coins_10k", label = "+10,000", amount = 10000, productId = 0, robuxPrice = 349 },
	{ id = "coins_50k", label = "+50,000", amount = 50000, productId = 0, robuxPrice = 1499 },
}

ShopCatalog.MARVEL_GIRL_BUFF = 1.10
ShopCatalog.MODERN_COSTUME_BUFF = 1.25

ShopCatalog.FREE_CHARACTERS = {
	"jean_grey",
	"spider_man",
	"crystal",
	"cyclops",
	"human_torch",
	"invisible_woman",
}

ShopCatalog.DEFAULT_OWNED_SKINS = {
	jean_grey = { "base" },
	human_torch = { "base" },
	invisible_woman = { "base" },
}

ShopCatalog.MODERN_BUNDLE_ID = "modern_costumes"
ShopCatalog.MODERN_BUNDLE_SKINS = {
	{ heroId = "human_torch", skinId = "modern" },
	{ heroId = "invisible_woman", skinId = "modern" },
}

local ITEMS: { ShopItem } = {
	{
		id = "marvel_girl",
		name = "Marvel Girl",
		description = "Jean Grey Marvel Girl costume. +10% outgoing damage.",
		kind = "skin",
		currency = "coins",
		price = 10000,
		grantSkins = { { heroId = "jean_grey", skinId = "marvel_girl" } },
		buffLabel = "+10% damage",
	},
	{
		id = "blue_marvel",
		name = "Blue Marvel",
		description = "Unlock Adam Brashear — anti-matter powerhouse.",
		kind = "character",
		currency = "coins",
		price = 10000,
		grantCharacter = "blue_marvel",
	},
	{
		id = "modern_costumes",
		name = "Modern Costumes Pack",
		description = "Modern skins for Human Torch and Invisible Woman. +25% outgoing damage while wearing them.",
		kind = "bundle",
		currency = "coins",
		price = 23500,
		grantBundle = ShopCatalog.MODERN_BUNDLE_ID,
		grantSkins = ShopCatalog.MODERN_BUNDLE_SKINS,
		buffLabel = "+25% damage",
	},
	{
		id = "scarlet_witch",
		name = "Scarlet Witch",
		description = "Unlock Wanda Maximoff and her full hex kit.",
		kind = "character",
		currency = "coins",
		price = 30000,
		grantCharacter = "scarlet_witch_classic",
	},
	{
		id = "storm",
		name = "Storm",
		description = "Unlock Ororo Munroe — weather manipulation.",
		kind = "character",
		currency = "coins",
		price = 25000,
		grantCharacter = "storm",
	},
	{
		id = "phoenix_force",
		name = "Phoenix Force",
		description = "Jean Grey Phoenix Force skin with revive.",
		kind = "gamepass",
		currency = "robux",
		price = 800,
		gamepassId = ShopCatalog.PHOENIX_GAMEPASS_ID,
		grantSkins = { { heroId = "jean_grey", skinId = "phoenix" } },
	},
	{
		id = "rogue",
		name = "Rogue",
		description = "Unlock Anna Marie — power absorption brawler.",
		kind = "gamepass",
		currency = "robux",
		price = 600,
		gamepassId = ShopCatalog.ROGUE_GAMEPASS_ID,
		grantCharacter = "rogue",
	},
	{
		id = "elite_gamepass",
		name = "Elite Gamepass",
		description = "2x coin rewards on kills (200 per kill) and Elite title on your nameplate.",
		kind = "gamepass",
		currency = "robux",
		price = 500,
		gamepassId = ShopCatalog.ELITE_GAMEPASS_ID,
	},
}

function ShopCatalog.getPreviewMorph(itemId: string): (string?, string?)
	if itemId == "marvel_girl" then
		return "jean_grey", "marvel_girl"
	elseif itemId == "blue_marvel" then
		return "blue_marvel", "base"
	elseif itemId == "modern_costumes" then
		return "invisible_woman", "modern"
	elseif itemId == "scarlet_witch" then
		return "scarlet_witch_classic", "base"
	elseif itemId == "storm" then
		return "storm", "base"
	elseif itemId == "phoenix_force" then
		return "jean_grey", "phoenix"
	elseif itemId == "rogue" then
		return "rogue", "base"
	elseif itemId == "elite_gamepass" then
		return "jean_grey", "phoenix"
	end
	local item = ShopCatalog.getItem(itemId)
	if not item then
		return nil, nil
	end
	if item.grantCharacter then
		return item.grantCharacter, "base"
	end
	if item.grantSkins and item.grantSkins[1] then
		local pair = item.grantSkins[1]
		return pair.heroId, pair.skinId
	end
	return nil, nil
end

function ShopCatalog.getItems(): { ShopItem }
	return ITEMS
end

function ShopCatalog.getItem(id: string): ShopItem?
	for _, item in ITEMS do
		if item.id == id then
			return item
		end
	end
	return nil
end

function ShopCatalog.getCoinPacks(): { CoinPack }
	return ShopCatalog.COIN_PACKS
end

function ShopCatalog.getCoinPackByProductId(productId: number): CoinPack?
	for _, pack in ShopCatalog.COIN_PACKS do
		if pack.productId == productId then
			return pack
		end
	end
	return nil
end

function ShopCatalog.isFreeCharacter(heroId: string): boolean
	for _, id in ShopCatalog.FREE_CHARACTERS do
		if id == heroId then
			return true
		end
	end
	return false
end

function ShopCatalog.getDefaultProfile(): { [string]: any }
	local ownedCharacters: { string } = {}
	for _, id in ShopCatalog.FREE_CHARACTERS do
		table.insert(ownedCharacters, id)
	end
	local ownedSkins: { [string]: { string } } = {}
	for heroId, skins in ShopCatalog.DEFAULT_OWNED_SKINS do
		ownedSkins[heroId] = table.clone(skins)
	end
	return {
		coins = 0,
		kills = 0,
		ownedCharacters = ownedCharacters,
		ownedSkins = ownedSkins,
		ownedBundles = {},
		hasEliteGamepass = false,
		redeemedCodes = {},
	}
end

function ShopCatalog.ownsCharacter(profile: { [string]: any }, heroId: string): boolean
	if ShopCatalog.UNLOCK_ALL then
		return true
	end
	if ShopCatalog.isFreeCharacter(heroId) then
		return true
	end
	local owned = profile.ownedCharacters
	if type(owned) ~= "table" then
		return false
	end
	for _, id in owned do
		if id == heroId then
			return true
		end
	end
	return false
end

function ShopCatalog.ownsBundle(profile: { [string]: any }, bundleId: string): boolean
	local owned = profile.ownedBundles
	if type(owned) ~= "table" then
		return false
	end
	for _, id in owned do
		if id == bundleId then
			return true
		end
	end
	return false
end

function ShopCatalog.ownsSkin(profile: { [string]: any }, heroId: string, skinId: string): boolean
	if ShopCatalog.UNLOCK_ALL then
		return true
	end
	if skinId == "base" then
		return ShopCatalog.ownsCharacter(profile, heroId)
	end
	local ownedSkins = profile.ownedSkins
	if type(ownedSkins) == "table" then
		local list = ownedSkins[heroId]
		if type(list) == "table" then
			for _, id in list do
				if id == skinId then
					return true
				end
			end
		end
	end
	if ShopCatalog.ownsBundle(profile, ShopCatalog.MODERN_BUNDLE_ID) then
		for _, pair in ShopCatalog.MODERN_BUNDLE_SKINS do
			if pair.heroId == heroId and pair.skinId == skinId then
				return true
			end
		end
	end
	return false
end

function ShopCatalog.canDeploy(profile: { [string]: any }, heroId: string, skinId: string): boolean
	if not ShopCatalog.ownsCharacter(profile, heroId) then
		return false
	end
	return ShopCatalog.ownsSkin(profile, heroId, skinId)
end

function ShopCatalog.getDamageBuffMultiplier(profile: { [string]: any }, heroId: string, skinId: string): number
	local mult = 1
	if heroId == "jean_grey" and skinId == "marvel_girl" and ShopCatalog.ownsSkin(profile, heroId, skinId) then
		mult *= ShopCatalog.MARVEL_GIRL_BUFF
	end
	if skinId == "modern" and ShopCatalog.ownsSkin(profile, heroId, skinId) then
		if heroId == "human_torch" or heroId == "invisible_woman" then
			mult *= ShopCatalog.MODERN_COSTUME_BUFF
		end
	end
	return mult
end

return ShopCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">SmartBonePatch</string>
          <string name="Source"><![CDATA[--!strict
--[[ Patches SmartBone Utilities.WaitForChildOfClass (os.clock vs os.clock()). ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SmartBonePatch = {}

local function patchUtilities(utilities: ModuleScript): boolean
	local ok, mod = pcall(require, utilities)
	if not ok or type(mod) ~= "table" or type(mod.WaitForChildOfClass) ~= "function" then
		return false
	end

	mod.WaitForChildOfClass = function(parent: Instance, className: string, timeOut: number?)
		local start = os.clock()
		timeOut = timeOut or 10
		repeat
			task.wait()
		until parent:FindFirstChildOfClass(className) or os.clock() - start > timeOut
		return parent:FindFirstChildOfClass(className)
	end

	return true
end

function SmartBonePatch.apply()
	local smartBone = ReplicatedStorage:FindFirstChild("SmartBone")
	if not smartBone then
		return false
	end
	local deps = smartBone:FindFirstChild("Dependencies")
	if not deps then
		return false
	end
	local utilities = deps:FindFirstChild("Utilities")
	if utilities and utilities:IsA("ModuleScript") then
		return patchUtilities(utilities)
	end
	return false
end

function SmartBonePatch.install()
	if SmartBonePatch.apply() then
		return
	end

	local conn: RBXScriptConnection? = nil
	conn = ReplicatedStorage.ChildAdded:Connect(function(child)
		if child.Name ~= "SmartBone" then
			return
		end
		task.defer(function()
			if SmartBonePatch.apply() and conn then
				conn:Disconnect()
				conn = nil
			end
		end)
	end)
end

return SmartBonePatch
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">VfxHelper</string>
          <string name="Source"><![CDATA[--!strict

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GameConstants = require(script.Parent.GameConstants)

local VfxHelper = {}

-- Brighter scarlet / chaos red
local CHAOS = Color3.fromRGB(210, 45, 55)
local CHAOS_SOFT = Color3.fromRGB(235, 80, 90)
local PHOTON = Color3.fromRGB(255, 210, 70)
local PHOTON_SOFT = Color3.fromRGB(255, 235, 140)

function VfxHelper.chaosColor(): Color3
	return CHAOS
end

function VfxHelper.chaosSoft(): Color3
	return CHAOS_SOFT
end

function VfxHelper.photonColor(): Color3
	return PHOTON
end

function VfxHelper.photonSoft(): Color3
	return PHOTON_SOFT
end

local BLOCKED_SOUND_IDS: { [string]: boolean } = {
	["390417313"] = true,
	["4458980745"] = true,
	["4282172813"] = true,
	["5608513766"] = true,
}

local function soundIdKey(soundId: string): string
	local id = string.gsub(soundId, "^rbxassetid://", "")
	id = string.gsub(id, "^https?://www%.roblox%.com/asset/%?id=", "")
	return id
end

local scarletSoundsSanitized = false
local allSoundsSanitized = false

local function muteBlockedSound(sound: Sound)
	if BLOCKED_SOUND_IDS[soundIdKey(sound.SoundId)] then
		sound:Stop()
		sound.SoundId = ""
		sound.Volume = 0
		sound.Playing = false
	end
end

local function stripBlockedSounds(root: Instance)
	local function scrub(inst: Instance)
		if inst:IsA("Sound") then
			muteBlockedSound(inst)
		end
	end
	scrub(root)
	for _, desc in root:GetDescendants() do
		scrub(desc)
	end
end

local function sanitizeAllAssetSounds()
	if allSoundsSanitized then
		return
	end
	allSoundsSanitized = true
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		return
	end
	stripBlockedSounds(assets)
	assets.DescendantAdded:Connect(function(desc)
		if desc:IsA("Sound") then
			muteBlockedSound(desc)
		end
	end)
end

local function sanitizeScarletSoundTemplates()
	if scarletSoundsSanitized then
		return
	end
	scarletSoundsSanitized = true
	sanitizeAllAssetSounds()
end

task.defer(function()
	local assets = ReplicatedStorage:WaitForChild("Assets", 60)
	if assets then
		sanitizeAllAssetSounds()
	end
end)

do
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if assets then
		sanitizeAllAssetSounds()
	end
end

	do
		stripBlockedSounds(game)
		game.DescendantAdded:Connect(function(desc)
			if desc:IsA("Sound") then
				muteBlockedSound(desc)
			end
		end)
	end

local function getLokiAsset(name: string): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Loki")
	return folder and folder:FindFirstChild(name)
end

local function getScarletAsset(...: string): Instance?
	sanitizeScarletSoundTemplates()
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		return nil
	end
	for _, folderName in { "ScarletWitchClassic", "ScarletWitch" } do
		local current: Instance? = assets:FindFirstChild(folderName)
		local ok = current ~= nil
		for _, name in { ... } do
			if not current then
				ok = false
				break
			end
			current = current:FindFirstChild(name)
		end
		if ok and current then
			return current
		end
	end
	return nil
end

local function getCaptainMarvelAsset(name: string): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("CaptainMarvel")
	return folder and folder:FindFirstChild(name)
end

local function getDaggerAsset(name: string): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Dagger")
	return folder and folder:FindFirstChild(name)
end

function VfxHelper.daggerColor(): Color3
	return GameConstants.DAGGER_LIGHT
end

function VfxHelper.daggerSoft(): Color3
	return GameConstants.DAGGER_LIGHT_SOFT
end

function VfxHelper.tintParticles(root: Instance, color: Color3)
	local seq = ColorSequence.new(color)
	local function tint(inst: Instance)
		if inst:IsA("ParticleEmitter") then
			inst.Color = seq
		elseif inst:IsA("Beam") then
			inst.Color = seq
		elseif inst:IsA("Trail") then
			inst.Color = seq
		elseif inst:IsA("PointLight") or inst:IsA("SpotLight") then
			inst.Color = color
		end
	end
	tint(root)
	for _, desc in root:GetDescendants() do
		tint(desc)
	end
end

function VfxHelper.getMarvelGirlAsset(...: string): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local current: Instance? = assets and (assets:FindFirstChild("JeanGrey") or assets:FindFirstChild("MarvelGirl"))
	for _, name in { ... } do
		if not current then
			return nil
		end
		current = current:FindFirstChild(name)
	end
	return current
end

function VfxHelper.getInvisibleWomanAsset(...: string): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local current: Instance? = assets and assets:FindFirstChild("InvisibleWoman")
	for _, name in { ... } do
		if not current then
			return nil
		end
		current = current:FindFirstChild(name)
	end
	return current
end
local function collectBeams(root: Instance): { Beam }
	local list: { Beam } = {}
	if root:IsA("Beam") then
		table.insert(list, root)
	end
	for _, desc in root:GetDescendants() do
		if desc:IsA("Beam") then
			table.insert(list, desc)
		end
	end
	return list
end

local function collectTrails(root: Instance): { Trail }
	local list: { Trail } = {}
	if root:IsA("Trail") then
		table.insert(list, root)
	end
	for _, desc in root:GetDescendants() do
		if desc:IsA("Trail") then
			table.insert(list, desc)
		end
	end
	return list
end

local function collectParticleEmitters(root: Instance): { ParticleEmitter }
	local list: { ParticleEmitter } = {}
	for _, desc in root:GetDescendants() do
		if desc:IsA("ParticleEmitter") then
			table.insert(list, desc)
		end
	end
	if root:IsA("ParticleEmitter") then
		table.insert(list, root)
	end
	return list
end

--[[ Enable + Emit immediately (do not wait on Rate). Uses EmitCount attr when set. ]]
local function emitAllParticles(root: Instance, count: number?)
	for _, em in collectParticleEmitters(root) do
		em.Enabled = true
		local attr = em:GetAttribute("EmitCount")
		local n: number
		if type(attr) == "number" and attr > 0 then
			n = math.floor(attr)
		elseif count then
			n = count
		else
			n = math.clamp(math.floor(em.Rate * 0.25 + 0.5), 8, 80)
		end
		em:Emit(n)
	end
end

local function setParticlesEnabled(root: Instance, enabled: boolean)
	for _, em in collectParticleEmitters(root) do
		em.Enabled = enabled
	end
	for _, beam in collectBeams(root) do
		beam.Enabled = enabled
	end
	for _, trail in collectTrails(root) do
		trail.Enabled = enabled
	end
end

--[[ BlastImpact attachment on an invisible damage-zone part at the hit/end position. ]]
function VfxHelper.spawnBlastImpact(origin: Vector3, radius: number?, heroFolder: string?)
	local r = math.clamp(radius or 3, 1.5, 8)
	local template = if heroFolder == "CaptainMarvel"
		then getCaptainMarvelAsset("BlastImpact")
		else getScarletAsset("BlastImpact")
	if not template and heroFolder == "CaptainMarvel" then
		template = getScarletAsset("BlastImpact")
	end

	local zone = Instance.new("Part")
	zone.Name = if heroFolder == "CaptainMarvel" then "PhotonBlastImpactZone" else "HexBlastImpactZone"
	zone.Shape = Enum.PartType.Ball
	zone.Size = Vector3.new(r * 2, r * 2, r * 2)
	zone.CFrame = CFrame.new(origin)
	zone.Anchored = true
	zone.CanCollide = false
	zone.CanQuery = false
	zone.CanTouch = false
	zone.Transparency = 1
	zone.Parent = workspace

	if template then
		local att = template:Clone()
		att.Name = "BlastImpact"
		att.Parent = zone
		emitAllParticles(att, 14)
		setParticlesEnabled(att, true)
		task.delay(0.15, function()
			if att.Parent then
				setParticlesEnabled(att, false)
			end
		end)
	else
		-- Fallback if asset missing
		local color = if heroFolder == "CaptainMarvel" then PHOTON else CHAOS
		VfxHelper.spawnPulseRing(origin, r * 0.7, color, 0.28)
		VfxHelper.spawnBurstSparks(origin, color, 10)
	end

	Debris:AddItem(zone, 2.2)
	return zone
end

function VfxHelper.spawnPhotonBlastImpact(origin: Vector3, radius: number?)
	return VfxHelper.spawnBlastImpact(origin, radius, "CaptainMarvel")
end

