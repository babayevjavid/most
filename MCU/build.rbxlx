          <string name="Source"><![CDATA[--!strict
--[[ Playable roster for Heroes Assemble: Reborn. Abilities filled in as kits are scripted. ]]

export type AbilityDef = {
	id: string,
	name: string,
	description: string,
	key: string,
	cooldown: number,
	energyCost: number,
	hold: boolean?,
	modes: { string }?,
	sideBar: boolean?,
	passive: boolean?,
	icon: string?,
	modeIcons: { [string]: string }?,
	astralOnly: boolean?,
	requiresTarget: boolean?,
}

export type SkinDef = {
	id: string,
	name: string,
	morphName: string,
	blocked: boolean?,
}

export type CharacterEntry = {
	id: string,
	displayName: string,
	alias: string,
	powers: string,
	biography: string,
	tagline: string,
	price: number,
	health: number,
	maxEnergy: number,
	morphName: string,
	skins: { SkinDef },
	abilities: { AbilityDef },
}

