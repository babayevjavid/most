            <Item class="ModuleScript" referent="51">
              <Properties>
                <string name="Name">AbilityButton</string>
                <string name="Source"><![CDATA[--!strict

local Theme = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("HUDTheme"))

export type AbilityButtonHandle = {
	Frame: Frame,
	AbilityId: string,
	SetCooldown: (self: AbilityButtonHandle, remaining: number, total: number) -> (),
	SetReady: (self: AbilityButtonHandle) -> (),
	SetAccent: (self: AbilityButtonHandle, color: Color3) -> (),
}

local AbilityButton = {}

function AbilityButton.create(parent: Instance, abilityId: string, displayName: string, keybind: string): AbilityButtonHandle
	local button = Instance.new("ImageButton")
	button.Name = abilityId
	button.AutoButtonColor = false
	button.Active = false
	button.Selectable = false
	button.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
	button.BackgroundTransparency = 0.08
	button.BorderSizePixel = 0
	button.Size = UDim2.new(Theme.AbilityButtonWidthScale, 0, Theme.AbilityButtonHeightScale, 0)
	button.ClipsDescendants = true
	button.Parent = parent

	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 1
	aspect.DominantAxis = Enum.DominantAxis.Height
	aspect.Parent = button

	local corner = Instance.new("UICorner")
	corner.CornerRadius = Theme.CornerAbility
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Name = "Stroke"
	stroke.Color = Color3.fromRGB(52, 58, 68)
	stroke.Thickness = 1
	stroke.Transparency = 0.15
	stroke.Parent = button

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Name"
	nameLabel.BackgroundTransparency = 1
	nameLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	nameLabel.Position = UDim2.fromScale(0.5, 0.52)
	nameLabel.Size = UDim2.new(0.88, 0, 0.72, 0)
	nameLabel.Font = Theme.FontLabel
	nameLabel.TextColor3 = Theme.TextPrimary
	nameLabel.Text = displayName
	nameLabel.TextWrapped = true
	nameLabel.TextScaled = true
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.TextYAlignment = Enum.TextYAlignment.Center
	nameLabel.ZIndex = 1
	nameLabel.Parent = button

	local nameConstraint = Instance.new("UITextSizeConstraint")
	nameConstraint.MaxTextSize = 13
	nameConstraint.MinTextSize = 8
	nameConstraint.Parent = nameLabel

	if keybind ~= "" and keybind ~= "LMB" then
		local keyLabel = Instance.new("TextLabel")
		keyLabel.Name = "Keybind"
		keyLabel.BackgroundColor3 = Color3.fromRGB(8, 10, 14)
		keyLabel.BackgroundTransparency = 0.2
		keyLabel.AnchorPoint = Vector2.new(1, 0)
		keyLabel.Position = UDim2.new(0.96, 0, 0.06, 0)
		keyLabel.Size = UDim2.new(0.34, 0, 0.22, 0)
		keyLabel.Font = Theme.FontLabel
		keyLabel.TextScaled = true
		keyLabel.TextColor3 = Theme.TextMuted
		keyLabel.Text = keybind
		keyLabel.ZIndex = 2
		keyLabel.Parent = button

		local keyConstraint = Instance.new("UITextSizeConstraint")
		keyConstraint.MaxTextSize = 10
		keyConstraint.MinTextSize = 7
		keyConstraint.Parent = keyLabel

		local keyCorner = Instance.new("UICorner")
		keyCorner.CornerRadius = Theme.CornerSmall
		keyCorner.Parent = keyLabel
	end

	local overlay = Instance.new("Frame")
	overlay.Name = "CooldownOverlay"
	overlay.BackgroundTransparency = 1
	overlay.ClipsDescendants = true
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.Visible = false
	overlay.ZIndex = 4
	overlay.Parent = button

	local overlayCorner = Instance.new("UICorner")
	overlayCorner.CornerRadius = Theme.CornerAbility
	overlayCorner.Parent = overlay

	local fill = Instance.new("Frame")
	fill.Name = "CooldownFill"
	fill.BackgroundColor3 = Theme.CooldownOverlay
	fill.BackgroundTransparency = Theme.CooldownOverlayTransparency
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(1, 0)
	fill.ZIndex = 1
	fill.Parent = overlay

	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.12),
		NumberSequenceKeypoint.new(1, 0.8),
	})
	gradient.Parent = fill

	local handle: AbilityButtonHandle = {
		Frame = button,
		AbilityId = abilityId,
		SetCooldown = function(self, remaining: number, total: number)
			if total <= 0 or remaining <= 0 then
				self:SetReady()
				return
			end
			local ratio = math.clamp(remaining / total, 0, 1)
			overlay.Visible = true
			fill.Size = UDim2.fromScale(1, ratio)
		end,
		SetReady = function(self)
			overlay.Visible = false
			fill.Size = UDim2.fromScale(1, 0)
		end,
		SetAccent = function(self, color: Color3)
			stroke.Color = color
			stroke.Transparency = 0.05
		end,
	}

	return handle
end

return AbilityButton
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="52">
              <Properties>
                <string name="Name">AvatarViewport</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local Theme = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("HUDTheme"))

export type AvatarViewportHandle = {
	Frame: Frame,
	Refresh: (self: AvatarViewportHandle, player: Player) -> (),
}

local AvatarViewport = {}

local function stripScripts(model: Model)
	for _, desc in model:GetDescendants() do
		if desc:IsA("Script") or desc:IsA("LocalScript") then
			desc:Destroy()
		elseif desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
		end
	end
end

local function buildDisplayModel(player: Player): Model?
	local character = player.Character
	if character then
		local wasArchivable = character.Archivable
		character.Archivable = true
		local clone = character:Clone()
		character.Archivable = wasArchivable
		if clone then
			return clone
		end
	end

	local ok, model = pcall(Players.CreateHumanoidModelFromUserId, Players, player.UserId)
	if ok and model and model:IsA("Model") then
		return model
	end

	return nil
end

local function frameModel(camera: Camera, model: Model)
	local cf, size = model:GetBoundingBox()
	local focus = cf.Position + Vector3.new(0, size.Y * 0.12, 0)

	local distance = math.max(size.X, size.Y) * 0.72
	local sideOffset = size.X * 0.38
	local heightOffset = size.Y * 0.18
	local cameraPos = focus + Vector3.new(sideOffset, heightOffset, distance)

	camera.CFrame = CFrame.new(cameraPos, focus)
end

function AvatarViewport.create(parent: Instance): AvatarViewportHandle
	local container = Instance.new("Frame")
	container.Name = "AvatarViewport"
	container.BackgroundColor3 = Theme.PanelBg
	container.BackgroundTransparency = Theme.PanelBgTransparency
	container.BorderSizePixel = 0
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.Position = UDim2.fromScale(0.5, 0.5)
	container.Size = UDim2.fromScale(0.94, 0.94)
	container.ClipsDescendants = true
	container.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = container

	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Stroke
	stroke.Transparency = Theme.StrokeTransparency
	stroke.Thickness = 2
	stroke.Parent = container

	local viewport = Instance.new("ViewportFrame")
	viewport.Name = "Viewport"
	viewport.BackgroundColor3 = Color3.fromRGB(14, 16, 22)
	viewport.BackgroundTransparency = 0.2
	viewport.BorderSizePixel = 0
	viewport.Size = UDim2.fromScale(1, 1)
	viewport.Parent = container

	local viewportCorner = Instance.new("UICorner")
	viewportCorner.CornerRadius = UDim.new(1, 0)
	viewportCorner.Parent = viewport

	local viewportStroke = Instance.new("UIStroke")
	viewportStroke.Color = Color3.fromRGB(28, 32, 40)
	viewportStroke.Transparency = 0.35
	viewportStroke.Thickness = 1
	viewportStroke.Parent = viewport

	local camera = Instance.new("Camera")
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = viewport

	local ambient = Instance.new("Part")
	ambient.Name = "ViewportLight"
	ambient.Anchored = true
	ambient.CanCollide = false
	ambient.Transparency = 1
	ambient.Size = Vector3.new(1, 1, 1)
	ambient.CFrame = CFrame.new(2, 4, 4)
	ambient.Parent = worldModel

	local light = Instance.new("PointLight")
	light.Brightness = 2
	light.Range = 20
	light.Parent = ambient

	local currentClone: Model? = nil

	local handle: AvatarViewportHandle = {
		Frame = container,
		Refresh = function(_self, player: Player)
			if currentClone then
				currentClone:Destroy()
				currentClone = nil
			end

			local clone = buildDisplayModel(player)
			if not clone then
				return
			end

			currentClone = clone
			stripScripts(clone)

			local hrp = clone:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				clone:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.pi, 0))
			else
				clone:MoveTo(Vector3.zero)
			end

			clone.Parent = worldModel
			frameModel(camera, clone)
		end,
	}

	return handle
end

return AvatarViewport
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="53">
              <Properties>
                <string name="Name">CurrencyRow</string>
                <string name="Source"><![CDATA[--!strict

local Theme = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("HUDTheme"))

export type CurrencyRowHandle = {
	Frame: Frame,
	SetAmount: (self: CurrencyRowHandle, amount: number) -> (),
}

local CurrencyRow = {}

function CurrencyRow.create(parent: Instance, _label: string, accent: Color3): CurrencyRowHandle
	local row = Instance.new("Frame")
	row.Name = _label .. "Currency"
	row.BackgroundColor3 = Theme.PanelBg
	row.BackgroundTransparency = Theme.PanelBgTransparency
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0.48, 0)
	row.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = Theme.CornerSmall
	corner.Parent = row

	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Stroke
	stroke.Transparency = Theme.StrokeTransparency
	stroke.Thickness = 1
	stroke.Parent = row

	local icon = Instance.new("Frame")
	icon.Name = "Icon"
	icon.BackgroundColor3 = accent
	icon.BorderSizePixel = 0
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.Position = UDim2.new(0.04, 0, 0.5, 0)
	icon.Size = UDim2.new(0.08, 0, 0.55, 0)
	icon.Parent = row

	local iconCorner = Instance.new("UICorner")
	iconCorner.CornerRadius = UDim.new(1, 0)
	iconCorner.Parent = icon

	local iconAspect = Instance.new("UIAspectRatioConstraint")
	iconAspect.AspectRatio = 1
	iconAspect.Parent = icon

	local amountLabel = Instance.new("TextLabel")
	amountLabel.Name = "Amount"
	amountLabel.BackgroundTransparency = 1
	amountLabel.Position = UDim2.new(0.16, 0, 0, 0)
	amountLabel.Size = UDim2.new(0.8, 0, 1, 0)
	amountLabel.Font = Theme.FontBody
	amountLabel.TextScaled = true
	amountLabel.TextXAlignment = Enum.TextXAlignment.Left
	amountLabel.TextColor3 = Theme.TextPrimary
	amountLabel.Text = "0"
	amountLabel.Parent = row

	local textConstraint = Instance.new("UITextSizeConstraint")
	textConstraint.MaxTextSize = 14
	textConstraint.MinTextSize = 10
	textConstraint.Parent = amountLabel

	local handle: CurrencyRowHandle = {
		Frame = row,
		SetAmount = function(_self, amount: number)
			amountLabel.Text = tostring(math.floor(amount))
		end,
	}

	return handle
end

return CurrencyRow
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="54">
              <Properties>
                <string name="Name">PassiveButton</string>
                <string name="Source"><![CDATA[--!strict

local Theme = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("HUDTheme"))

export type PassiveButtonHandle = {
	Frame: Frame,
	SetAccent: (self: PassiveButtonHandle, color: Color3) -> (),
}

local PassiveButton = {}

function PassiveButton.create(parent: Instance, passiveId: string, displayName: string): PassiveButtonHandle
	local button = Instance.new("Frame")
	button.Name = passiveId
	button.BackgroundColor3 = Theme.PanelBg
	button.BackgroundTransparency = 0.1
	button.BorderSizePixel = 0
	button.Size = UDim2.fromScale(1, 1)
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = Theme.CornerMedium
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Name = "Stroke"
	stroke.Color = Theme.Stroke
	stroke.Thickness = 1
	stroke.Transparency = 0.45
	stroke.Parent = button

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Theme.FontLabel
	label.TextScaled = true
	label.TextColor3 = Theme.TextMuted
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Text = string.upper(string.sub(displayName, 1, 8))
	label.Parent = button

	local textConstraint = Instance.new("UITextSizeConstraint")
	textConstraint.MaxTextSize = 9
	textConstraint.MinTextSize = 6
	textConstraint.Parent = label

	local handle: PassiveButtonHandle = {
		Frame = button,
		SetAccent = function(self, color: Color3)
			stroke.Color = color
		end,
	}

	return handle
end

return PassiveButton
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="55">
              <Properties>
                <string name="Name">StatBar</string>
                <string name="Source"><![CDATA[--!strict

local Theme = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("HUDTheme"))

export type StatBarHandle = {
	Frame: Frame,
	SetValue: (self: StatBarHandle, current: number, max: number) -> (),
}

local StatBar = {}

function StatBar.create(parent: Instance, label: string, fillColor: Color3, fillDark: Color3): StatBarHandle
	local container = Instance.new("Frame")
	container.Name = label .. "Bar"
	container.BackgroundTransparency = 1
	container.Size = Theme.StatBarSize
	container.Parent = parent

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.BackgroundTransparency = 1
	header.Size = UDim2.fromScale(1, 0.34)
	header.Parent = container

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Label"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.fromScale(0.55, 1)
	nameLabel.Font = Theme.FontLabel
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextYAlignment = Enum.TextYAlignment.Bottom
	nameLabel.TextColor3 = Theme.TextMuted
	nameLabel.TextScaled = true
	nameLabel.Text = string.upper(label)
	nameLabel.Parent = header

	local nameConstraint = Instance.new("UITextSizeConstraint")
	nameConstraint.MaxTextSize = 10
	nameConstraint.MinTextSize = 7
	nameConstraint.Parent = nameLabel

	local valueLabel = Instance.new("TextLabel")
	valueLabel.Name = "Value"
	valueLabel.BackgroundTransparency = 1
	valueLabel.AnchorPoint = Vector2.new(1, 0)
	valueLabel.Position = UDim2.fromScale(1, 0)
	valueLabel.Size = UDim2.fromScale(0.45, 1)
	valueLabel.Font = Theme.FontBody
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.TextYAlignment = Enum.TextYAlignment.Bottom
	valueLabel.TextColor3 = Theme.TextPrimary
	valueLabel.TextScaled = true
	valueLabel.Text = "0 / 0"
	valueLabel.Parent = header

	local valueConstraint = Instance.new("UITextSizeConstraint")
	valueConstraint.MaxTextSize = 11
	valueConstraint.MinTextSize = 8
	valueConstraint.Parent = valueLabel

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.AnchorPoint = Vector2.new(0, 1)
	track.BackgroundColor3 = Theme.BarTrack
	track.BorderSizePixel = 0
	track.Position = UDim2.fromScale(0, 1)
	track.Size = UDim2.fromScale(1, 0.58)
	track.ClipsDescendants = true
	track.Parent = container

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = Theme.CornerSmall
	trackCorner.Parent = track

	local trackStroke = Instance.new("UIStroke")
	trackStroke.Color = Theme.BarTrackStroke
	trackStroke.Transparency = 0.15
	trackStroke.Thickness = 1
	trackStroke.Parent = track

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = fillColor
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(1, 1)
	fill.ZIndex = 1
	fill.Parent = track

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = Theme.CornerSmall
	fillCorner.Parent = fill

	local fillGradient = Instance.new("UIGradient")
	fillGradient.Rotation = 90
	fillGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, fillColor),
		ColorSequenceKeypoint.new(0.55, fillColor),
		ColorSequenceKeypoint.new(1, fillDark),
	})
	fillGradient.Parent = fill

	local edgeHighlight = Instance.new("Frame")
	edgeHighlight.Name = "EdgeHighlight"
	edgeHighlight.BackgroundColor3 = Color3.new(1, 1, 1)
	edgeHighlight.BackgroundTransparency = 0.92
	edgeHighlight.BorderSizePixel = 0
	edgeHighlight.Size = UDim2.new(1, 0, 0, 1)
	edgeHighlight.ZIndex = 2
	edgeHighlight.Parent = track

	local handle: StatBarHandle = {
		Frame = container,
		SetValue = function(_self, current: number, max: number)
			local ratio = if max > 0 then math.clamp(current / max, 0, 1) else 0
			fill.Size = UDim2.fromScale(ratio, 1)
			local currentInt = math.floor(current + 0.5)
			local maxInt = math.floor(max + 0.5)
			valueLabel.Text = `{currentInt} / {maxInt}`
		end,
	}

	return handle
end

return StatBar
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">MainHUD</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HUDTheme"))

local AbilityButton = require(script.Parent.Components.AbilityButton)
local AvatarViewport = require(script.Parent.Components.AvatarViewport)
local CurrencyRow = require(script.Parent.Components.CurrencyRow)
local PassiveButton = require(script.Parent.Components.PassiveButton)
local StatBar = require(script.Parent.Components.StatBar)

export type MainHUDController = {
	Gui: ScreenGui,
	AbilityButtons: { [string]: AbilityButton.AbilityButtonHandle },
	Show: (self: MainHUDController, heroId: string, layout: any) -> (),
	Hide: (self: MainHUDController) -> (),
	UpdateStats: (self: MainHUDController, payload: { [string]: any }) -> (),
	UpdateCooldown: (self: MainHUDController, abilityId: string, duration: number) -> (),
	RefreshAvatar: (self: MainHUDController, player: Player) -> (),
	TickCooldowns: (self: MainHUDController) -> (),
}

local MainHUD = {}

function MainHUD.create(): MainHUDController
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "MainHUD"
	screenGui.ResetOnSpawn = false
	screenGui.Enabled = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = playerGui

	local topRight = Instance.new("Frame")
	topRight.Name = "TopRightCurrencies"
	topRight.AnchorPoint = Vector2.new(1, 0)
	topRight.BackgroundTransparency = 1
	topRight.Position = UDim2.new(0.985, 0, 0.018, 0)
	topRight.Size = UDim2.new(0.11, 0, 0.065, 0)
	topRight.Parent = screenGui

	local currencyLayout = Instance.new("UIListLayout")
	currencyLayout.FillDirection = Enum.FillDirection.Vertical
	currencyLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	currencyLayout.Padding = UDim.new(0.08, 0)
	currencyLayout.SortOrder = Enum.SortOrder.LayoutOrder
	currencyLayout.Parent = topRight

	local blueCurrency = CurrencyRow.create(topRight, "Blue", Theme.CurrencyBlue)
	blueCurrency.Frame.LayoutOrder = 1

	local yellowCurrency = CurrencyRow.create(topRight, "Yellow", Theme.CurrencyYellow)
	yellowCurrency.Frame.LayoutOrder = 2

	local topLeft = Instance.new("Frame")
	topLeft.Name = "TopLeftCluster"
	topLeft.BackgroundTransparency = 1
	topLeft.AnchorPoint = Vector2.new(0, 0)
	topLeft.Position = UDim2.fromScale(0, 0)
	topLeft.Size = UDim2.fromScale(1, 1)
	topLeft.Parent = screenGui

	local viewportSlot = Instance.new("Frame")
	viewportSlot.Name = "ViewportSlot"
	viewportSlot.BackgroundTransparency = 1
	viewportSlot.AnchorPoint = Vector2.new(0, 0)
	viewportSlot.Position = Theme.ViewportPosition
	viewportSlot.Size = Theme.ViewportSize
	viewportSlot.Parent = topLeft

	local viewportAspect = Instance.new("UIAspectRatioConstraint")
	viewportAspect.AspectRatio = 1
	viewportAspect.DominantAxis = Enum.DominantAxis.Height
	viewportAspect.Parent = viewportSlot

	local viewportSizeConstraint = Instance.new("UISizeConstraint")
	viewportSizeConstraint.MinSize = Vector2.new(0, 0)
	viewportSizeConstraint.Parent = viewportSlot

	local viewport = AvatarViewport.create(viewportSlot)

	local barsContainer = Instance.new("Frame")
	barsContainer.Name = "Bars"
	barsContainer.BackgroundTransparency = 1
	barsContainer.AnchorPoint = Vector2.new(0, 0)
	barsContainer.Position = Theme.BarsPosition
	barsContainer.Size = Theme.BarsSize
	barsContainer.Parent = topLeft

	local barsSizeConstraint = Instance.new("UISizeConstraint")
	barsSizeConstraint.MinSize = Vector2.new(0, 0)
	barsSizeConstraint.Parent = barsContainer

	local barsLayout = Instance.new("UIListLayout")
	barsLayout.Padding = UDim.new(Theme.StatBarGapScale, 0)
	barsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	barsLayout.VerticalAlignment = Enum.VerticalAlignment.Top
	barsLayout.Parent = barsContainer

	local healthBar = StatBar.create(barsContainer, "Health", Theme.Health, Theme.HealthDark)
	healthBar.Frame.LayoutOrder = 1
	local staminaBar = StatBar.create(barsContainer, "Stamina", Theme.Stamina, Theme.StaminaDark)
	staminaBar.Frame.LayoutOrder = 2
	local energyBar = StatBar.create(barsContainer, "Energy", Theme.Energy, Theme.EnergyDark)
	energyBar.Frame.LayoutOrder = 3

	local bottomBar = Instance.new("Frame")
	bottomBar.Name = "AbilityBarContainer"
	bottomBar.AnchorPoint = Vector2.new(0.5, 1)
	bottomBar.BackgroundTransparency = 1
	bottomBar.Position = UDim2.new(0.5, 0, 0.985, 0)
	bottomBar.Size = UDim2.new(Theme.AbilityBarWidthScale, 0, Theme.AbilityBarHeightScale, 0)
	bottomBar.Parent = screenGui

	local abilityRow = Instance.new("Frame")
	abilityRow.Name = "AbilityRow"
	abilityRow.AnchorPoint = Vector2.new(0.5, 0.5)
	abilityRow.BackgroundTransparency = 1
	abilityRow.Position = UDim2.fromScale(0.5, 0.5)
	abilityRow.Size = UDim2.new(0.88, 0, 0.92, 0)
	abilityRow.Parent = bottomBar

	local abilityLayout = Instance.new("UIListLayout")
	abilityLayout.FillDirection = Enum.FillDirection.Horizontal
	abilityLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	abilityLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	abilityLayout.Padding = UDim.new(0.012, 0)
	abilityLayout.SortOrder = Enum.SortOrder.LayoutOrder
	abilityLayout.Parent = abilityRow

	local passiveSlot = Instance.new("Frame")
	passiveSlot.Name = "PassiveSlot"
	passiveSlot.AnchorPoint = Vector2.new(0, 0.5)
	passiveSlot.BackgroundTransparency = 1
	passiveSlot.Position = UDim2.new(1, 0, 0.5, 0)
	passiveSlot.Size = UDim2.new(0.13, 0, Theme.AbilityButtonHeightScale, 0)
	passiveSlot.Parent = abilityRow

	local passiveAspect = Instance.new("UIAspectRatioConstraint")
	passiveAspect.AspectRatio = 1
	passiveAspect.DominantAxis = Enum.DominantAxis.Height
	passiveAspect.Parent = passiveSlot

	local abilityButtons: { [string]: AbilityButton.AbilityButtonHandle } = {}
	local cooldownEnds: { [string]: { endTime: number, duration: number } } = {}
	local passiveHandle: PassiveButton.PassiveButtonHandle? = nil
	local currentAccent = Theme.Stroke

	local controller: MainHUDController = {
		Gui = screenGui,
		AbilityButtons = abilityButtons,
		Show = function(self, heroId: string, layout: any)
			currentAccent = Theme.HeroAccents[heroId] or Theme.Stroke

			for _, child in abilityRow:GetChildren() do
				if child:IsA("GuiObject") and child.Name ~= "PassiveSlot" and not child:IsA("UIListLayout") and not child:IsA("UIAspectRatioConstraint") then
					child:Destroy()
				end
			end
			if passiveHandle then
				passiveHandle.Frame:Destroy()
				passiveHandle = nil
			end
			table.clear(abilityButtons)
			table.clear(cooldownEnds)

			for index, abilityDef in layout.abilities do
				local btn = AbilityButton.create(abilityRow, abilityDef.Id, abilityDef.DisplayName, abilityDef.Keybind)
				btn.Frame.LayoutOrder = index
				btn:SetAccent(currentAccent)
				abilityButtons[abilityDef.Id] = btn
			end

			local moveDef = layout.movement
			local moveBtn = AbilityButton.create(abilityRow, moveDef.Id, moveDef.DisplayName, moveDef.Keybind)
			moveBtn.Frame.LayoutOrder = 6
			moveBtn:SetAccent(currentAccent)
			abilityButtons[moveDef.Id] = moveBtn

			passiveHandle = PassiveButton.create(passiveSlot, layout.passive.Id, layout.passive.DisplayName)
			passiveHandle:SetAccent(currentAccent)

			screenGui.Enabled = true
			self:RefreshAvatar(player)
		end,
		Hide = function(_self)
			screenGui.Enabled = false
		end,
		UpdateStats = function(_self, payload: { [string]: any })
			healthBar:SetValue(payload.Health or 0, payload.MaxHealth or 100)
			staminaBar:SetValue(payload.Stamina or 0, payload.MaxStamina or 100)
			energyBar:SetValue(payload.Energy or 0, payload.MaxEnergy or 100)
			blueCurrency:SetAmount(payload.Blue or 0)
			yellowCurrency:SetAmount(payload.Yellow or 0)
		end,
		UpdateCooldown = function(_self, abilityId: string, duration: number)
			cooldownEnds[abilityId] = { endTime = os.clock() + duration, duration = duration }
		end,
		RefreshAvatar = function(_self, localPlayer: Player)
			viewport:Refresh(localPlayer)
		end,
		TickCooldowns = function(_self)
			local now = os.clock()
			for abilityId, data in cooldownEnds do
				local remaining = data.endTime - now
				local btn = abilityButtons[abilityId]
				if btn then
					if remaining > 0 then
						btn:SetCooldown(remaining, data.duration)
					else
						btn:SetReady()
						cooldownEnds[abilityId] = nil
					end
				end
			end
		end,
	}

	return controller
end

return MainHUD
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="57">
