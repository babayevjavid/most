      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">RagdollHandler</string>
          <string name="Source"><![CDATA[local PhysicsService = game:GetService("PhysicsService")

local module = {}
local RAGDOLL_COLLISION_GROUP = "RagdollCharacter"
local ORIGINAL_COLLISION_GROUP_ATTR = "RagdollOriginalCollisionGroup"
local ORIGINAL_CAN_COLLIDE_ATTR = "RagdollOrigCanCollide"

local function ensureRagdollCollisionGroup()
	local hasGroup = false
	local ok, result = pcall(function()
		return PhysicsService:IsCollisionGroupRegistered(RAGDOLL_COLLISION_GROUP)
	end)
	if ok then
		hasGroup = result == true
	end
	if not hasGroup then
		pcall(function()
			PhysicsService:RegisterCollisionGroup(RAGDOLL_COLLISION_GROUP)
		end)
	end
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(RAGDOLL_COLLISION_GROUP, RAGDOLL_COLLISION_GROUP, false)
	end)
end

local function clampAssemblyVelocity(part: BasePart)
	local linear = part.AssemblyLinearVelocity
	local linearMagnitude = linear.Magnitude
	if linearMagnitude > 90 then
		part.AssemblyLinearVelocity = linear.Unit * 90
	end

	local angular = part.AssemblyAngularVelocity
	local angularMagnitude = angular.Magnitude
	if angularMagnitude > 35 then
		part.AssemblyAngularVelocity = angular.Unit * 35
	end
end

local function saveOriginalCanCollide(part: BasePart)
	if part:GetAttribute(ORIGINAL_CAN_COLLIDE_ATTR) == nil then
		part:SetAttribute(ORIGINAL_CAN_COLLIDE_ATTR, part.CanCollide)
	end
end

local function restoreOriginalCanCollide(part: BasePart)
	local orig = part:GetAttribute(ORIGINAL_CAN_COLLIDE_ATTR)
	if typeof(orig) == "boolean" then
		part.CanCollide = orig
		part:SetAttribute(ORIGINAL_CAN_COLLIDE_ATTR, nil)
	end
end

type RagdollEnableOpts = {
	skipVelocityClamp: boolean?,
}

local function ensureBodyUnanchored(character: Model)
	for _, inst in ipairs(character:GetDescendants()) do
		if inst:IsA("BasePart") then
			local isAccessoryHandle = inst.Parent and inst.Parent:IsA("Accessory")
			if not isAccessoryHandle and inst.Anchored then
				inst.Anchored = false
			end
		end
	end
end

local function setRagdollEnabled(humanoid: Humanoid, isEnabled: boolean, opts: RagdollEnableOpts?)
	local character = humanoid.Parent
	if not character then
		return
	end

	local skipClamp = opts and opts.skipVelocityClamp == true
	local rootPart = character:FindFirstChild("HumanoidRootPart")

	-- Collision: only override while ragdoll is active. When disabling, restore saved values.
	-- (Previously HRP was always CanCollide=false and "off" zeroed all limbs — NPCs lost floor collision.)
	if isEnabled then
		ensureBodyUnanchored(character)
		if rootPart and rootPart:IsA("BasePart") then
			saveOriginalCanCollide(rootPart)
			rootPart.CanCollide = false
		end
		for _, inst in ipairs(character:GetDescendants()) do
			if inst:IsA("BasePart") and inst.Name ~= "HumanoidRootPart" then
				local isAccessoryHandle = inst.Parent and inst.Parent:IsA("Accessory")
				if isAccessoryHandle then
					saveOriginalCanCollide(inst)
					inst.CanCollide = false
				else
					saveOriginalCanCollide(inst)
					inst.CanCollide = true
					if inst:GetAttribute(ORIGINAL_COLLISION_GROUP_ATTR) == nil then
						inst:SetAttribute(ORIGINAL_COLLISION_GROUP_ATTR, inst.CollisionGroup)
					end
					inst.CollisionGroup = RAGDOLL_COLLISION_GROUP
					if not skipClamp then
						clampAssemblyVelocity(inst)
					end
				end
			end
		end
	else
		if rootPart and rootPart:IsA("BasePart") then
			restoreOriginalCanCollide(rootPart)
		end
		for _, inst in ipairs(character:GetDescendants()) do
			if inst:IsA("BasePart") and inst.Name ~= "HumanoidRootPart" then
				local isAccessoryHandle = inst.Parent and inst.Parent:IsA("Accessory")
				if isAccessoryHandle then
					restoreOriginalCanCollide(inst)
				else
					restoreOriginalCanCollide(inst)
					local original = inst:GetAttribute(ORIGINAL_COLLISION_GROUP_ATTR)
					if typeof(original) == "string" and original ~= "" then
						inst.CollisionGroup = original
						inst:SetAttribute(ORIGINAL_COLLISION_GROUP_ATTR, nil)
					end
				end
			end
		end
	end

	local ragdollConstraints = character:FindFirstChild("RagdollConstraints")
	if ragdollConstraints then
		for _, constraint in pairs(ragdollConstraints:GetChildren()) do
			if constraint:IsA("Constraint") then
				local rigidPointer = constraint:FindFirstChild("RigidJoint")
				local rigidJoint = rigidPointer and rigidPointer:IsA("ObjectValue") and rigidPointer.Value
				if rigidJoint and rigidJoint:IsA("Motor6D") then
					local expected = (not isEnabled) and constraint.Attachment1 and constraint.Attachment1.Parent or nil
					if rigidJoint.Part1 ~= expected then
						rigidJoint.Part1 = expected
					end
				end
			end
		end
	elseif isEnabled then
		-- Last-resort limp if constraints never built (still reconnectable via Motor6D name map on client)
		for _, inst in ipairs(character:GetDescendants()) do
			if inst:IsA("Motor6D") and inst.Name ~= "Root" and inst.Name ~= "RootJoint" and inst.Part1 ~= nil then
				inst.Part1 = nil
			end
		end
	end
end

local function keepRagdollActiveLightweight(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end
	local ragdollConstraints = character:FindFirstChild("RagdollConstraints")
	local any = false
	if ragdollConstraints then
		for _, constraint in pairs(ragdollConstraints:GetChildren()) do
			if constraint:IsA("Constraint") then
				local rigidPointer = constraint:FindFirstChild("RigidJoint")
				local rigidJoint = rigidPointer and rigidPointer:IsA("ObjectValue") and rigidPointer.Value
				if rigidJoint and rigidJoint:IsA("Motor6D") then
					any = true
					if rigidJoint.Part1 ~= nil then
						rigidJoint.Part1 = nil
					end
				end
			end
		end
	end
	if not any then
		for _, inst in ipairs(character:GetDescendants()) do
			if inst:IsA("Motor6D") and inst.Name ~= "Root" and inst.Name ~= "RootJoint" and inst.Part1 ~= nil then
				inst.Part1 = nil
			end
		end
	end
end

--[[ True if any ragdoll Motor6D is still welded (embedded AI/scripts reconnected Part1 after physics). ]]
function module:AnyRagdollMotorWelded(humanoid: Humanoid): boolean
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return false
	end
	local ragdollConstraints = character:FindFirstChild("RagdollConstraints")
	if not ragdollConstraints then
		return false
	end
	for _, constraint in pairs(ragdollConstraints:GetChildren()) do
		if constraint:IsA("Constraint") then
			local rigidPointer = constraint:FindFirstChild("RigidJoint")
			local rigidJoint = rigidPointer and rigidPointer:IsA("ObjectValue") and rigidPointer.Value
			if rigidJoint and rigidJoint:IsA("Motor6D") and rigidJoint.Part1 ~= nil then
				return true
			end
		end
	end
	return false
end

--[[ After physics: only disconnect constraint motors + keep Humanoid in Physics (no full descendant scan). ]]
function module:MaintainNpcRagdollAfterPhysics(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end
	if character:GetAttribute("Ragdolled") ~= true or humanoid.Health <= 0 then
		return
	end
	local st = humanoid:GetState()
	if st ~= Enum.HumanoidStateType.Physics and st ~= Enum.HumanoidStateType.Dead then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end
	humanoid.PlatformStand = false
	humanoid.RequiresNeck = false
	ensureBodyUnanchored(character)
	keepRagdollActiveLightweight(humanoid)
end

function module:ManualRagdoll(humanoid: Humanoid, isEnabled: boolean)
	if isEnabled then
		-- Prevent instant death when neck Motor6D is temporarily disconnected.
		humanoid.RequiresNeck = false
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	else
		humanoid.RequiresNeck = true
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	setRagdollEnabled(humanoid, isEnabled, nil)
end

--[[
	While Ragdolled status is active, collisions/state can still kick the Humanoid out of Physics.
	Call from Heartbeat — skips velocity clamp so we don't damp the ragdoll every frame.
]]
function module:MaintainStatusRagdoll(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end
	if character:GetAttribute("Ragdolled") ~= true or humanoid.Health <= 0 then
		return
	end
	local st = humanoid:GetState()
	if st ~= Enum.HumanoidStateType.Physics and st ~= Enum.HumanoidStateType.Dead then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end
	humanoid.PlatformStand = false
	humanoid.RequiresNeck = false
	ensureBodyUnanchored(character)
	keepRagdollActiveLightweight(humanoid)
end

--[[
	NPCs: embedded server Scripts / Animator can re-weld Motor6Ds after physics. Re-apply full ragdoll
	collision + joint disconnect (skip velocity clamp). Call after physics / deferred.
]]
function module:MaintainNpcRagdollHard(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end
	if character:GetAttribute("Ragdolled") ~= true or humanoid.Health <= 0 then
		return
	end
	local st = humanoid:GetState()
	if st ~= Enum.HumanoidStateType.Physics and st ~= Enum.HumanoidStateType.Dead then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end
	humanoid.PlatformStand = false
	humanoid.RequiresNeck = false
	setRagdollEnabled(humanoid, true, { skipVelocityClamp = true })
end

function module:ragdollAdded(humanoid: Humanoid)
	if not humanoid then
		return
	end
	ensureRagdollCollisionGroup()
	-- Do NOT use Humanoid.StateChanged to drive ragdoll on/off: contact/state churn calls it with
	-- non-Physics states and was disabling constraint ragdoll while Ragdolled stayed true.
end

function module:ragdollRemoved(humanoid: Humanoid)
	-- kept for API symmetry
end

return module

]]></string>
        </Properties>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">buildCollisionFilters</string>
            <string name="Source"><![CDATA[return function(attachmentMap, characterRoot: BasePart?)
	local folder = Instance.new("Folder")
	folder.Name = "NoCollisionConstraints"
	if not characterRoot then
		return folder
	end

	local seen = {}
	local function pairKey(a: BasePart, b: BasePart): string
		local aPath = a:GetFullName()
		local bPath = b:GetFullName()
		if aPath < bPath then
			return aPath .. "|" .. bPath
		end
		return bPath .. "|" .. aPath
	end
	for _, jointData in pairs(attachmentMap) do
		local p0 = jointData.Attachment0 and jointData.Attachment0.Parent
		local p1 = jointData.Attachment1 and jointData.Attachment1.Parent
		if p0 and p1 and p0:IsA("BasePart") and p1:IsA("BasePart") and p0 ~= p1 then
			local key = pairKey(p0, p1)
			if not seen[key] then
				seen[key] = true
				local ncc = Instance.new("NoCollisionConstraint")
				ncc.Name = p0.Name .. "<->" .. p1.Name
				ncc.Part0 = p0
				ncc.Part1 = p1
				ncc.Parent = folder
			end
		end
	end

	return folder
end

]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">buildConstraints</string>
            <string name="Source"><![CDATA[local getLastWordFromPascalCase = require(script.Parent:WaitForChild("getLastWordFromPascalCase"))

local function makeHinge(lower: number, upper: number, restitution: number): HingeConstraint
	local h = Instance.new("HingeConstraint")
	h.LimitsEnabled = true
	h.LowerAngle = lower
	h.UpperAngle = upper
	h.Restitution = restitution
	h.Radius = 0.15
	return h
end

local function makeBall(upper: number, twistLower: number, twistUpper: number): BallSocketConstraint
	local b = Instance.new("BallSocketConstraint")
	b.LimitsEnabled = true
	b.TwistLimitsEnabled = true
	b.UpperAngle = upper
	b.TwistLowerAngle = twistLower
	b.TwistUpperAngle = twistUpper
	return b
end

local function constraintTemplateForJoint(jointName: string): Constraint
	local jointType = getLastWordFromPascalCase(jointName)
	if jointType == "Ankle" then
		return makeHinge(-45, 0, 0)
	elseif jointType == "Elbow" then
		return makeHinge(0, 135, 0)
	elseif jointType == "Knee" then
		return makeHinge(-135, -10, 0)
	elseif jointType == "Wrist" then
		return makeHinge(-20, 20, 0)
	elseif jointType == "Hip" then
		return makeBall(40, -3, 3)
	elseif jointType == "Neck" then
		return makeBall(0, -45, 45)
	elseif jointType == "Shoulder" then
		return makeBall(30, -30, 30)
	elseif jointType == "Waist" then
		return makeBall(15, -1, 1)
	end
	return makeBall(20, -15, 15)
end

local function createConstraint(jointData)
	local joint = jointData.Joint
	local constraint = constraintTemplateForJoint(joint.Name)
	constraint.Attachment0 = jointData.Attachment0
	constraint.Attachment1 = jointData.Attachment1
	constraint.Name = getLastWordFromPascalCase(joint.Name) .. "RagdollConstraint"

	local rigidPointer = Instance.new("ObjectValue")
	rigidPointer.Name = "RigidJoint"
	rigidPointer.Value = joint
	rigidPointer.Parent = constraint
	return constraint
end

return function(attachmentMap)
	local ragdollConstraints = Instance.new("Folder")
	ragdollConstraints.Name = "RagdollConstraints"

	for _, jointData in pairs(attachmentMap) do
		-- R15 uses "Root"; classic R6 uses "RootJoint". Keep HRP welded so TK can lift the body.
		local jointName = jointData.Joint.Name
		if jointName ~= "Root" and jointName ~= "RootJoint" then
			createConstraint(jointData).Parent = ragdollConstraints
		end
	end
	return ragdollConstraints
end

]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">buildRagdoll</string>
            <string name="Source"><![CDATA[local buildConstraints = require(script.Parent:WaitForChild("buildConstraints"))
local buildCollisionFilters = require(script.Parent:WaitForChild("buildCollisionFilters"))
local AUTO_ATTACHMENT_PREFIX = "__RagdollAutoAttachment_"

local function clearAutoAttachments(character: Model)
	for _, inst in ipairs(character:GetDescendants()) do
		if inst:IsA("Attachment") and string.sub(inst.Name, 1, #AUTO_ATTACHMENT_PREFIX) == AUTO_ATTACHMENT_PREFIX then
			inst:Destroy()
		end
	end
end

local function findMotor6DByName(character: Model, jointName: string): Motor6D?
	for _, inst in ipairs(character:GetDescendants()) do
		if inst:IsA("Motor6D") and inst.Name == jointName and inst.Part0 and inst.Part1 then
			return inst
		end
	end
	return nil
end

local function buildAttachmentMap(character: Model)
	local attachmentMap = {}
	local handledJoints: { [Motor6D]: boolean } = {}

	-- R15 / blocky R15: pair *RigAttachment names to Motor6Ds anywhere in the character
	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			for _, attachment in pairs(part:GetChildren()) do
				if attachment:IsA("Attachment") then
					local jointName = attachment.Name:match("^(.+)RigAttachment$")
					if jointName then
						local joint = findMotor6DByName(character, jointName)
							or (attachment.Parent and attachment.Parent:FindFirstChild(jointName))
						if joint and joint:IsA("Motor6D") and joint.Part0 and joint.Part1 then
							local a0 = joint.Part0:FindFirstChild(attachment.Name)
							local a1 = joint.Part1:FindFirstChild(attachment.Name)
							if a0 and a1 and a0:IsA("Attachment") and a1:IsA("Attachment") then
								attachmentMap[attachment.Name] = {
									Joint = joint,
									Attachment0 = a0,
									Attachment1 = a1,
								}
								handledJoints[joint] = true
							end
						end
					end
				end
			end
		end
	end

	-- Fallback: synthesize attachments from every remaining Motor6D (R6 / incomplete packages)
	for _, inst in ipairs(character:GetDescendants()) do
		if inst:IsA("Motor6D") and inst.Part0 and inst.Part1 and not handledJoints[inst] then
			local key = AUTO_ATTACHMENT_PREFIX .. inst:GetFullName()
			local a0Name = AUTO_ATTACHMENT_PREFIX .. inst.Name
			local a1Name = AUTO_ATTACHMENT_PREFIX .. inst.Name

			local a0 = inst.Part0:FindFirstChild(a0Name)
			if not (a0 and a0:IsA("Attachment")) then
				a0 = Instance.new("Attachment")
				a0.Name = a0Name
				a0.Parent = inst.Part0
			end
			a0.CFrame = inst.C0

			local a1 = inst.Part1:FindFirstChild(a1Name)
			if not (a1 and a1:IsA("Attachment")) then
				a1 = Instance.new("Attachment")
				a1.Name = a1Name
				a1.Parent = inst.Part1
			end
			a1.CFrame = inst.C1

			attachmentMap[key] = {
				Joint = inst,
				Attachment0 = a0,
				Attachment1 = a1,
			}
			handledJoints[inst] = true
		end
	end
	return attachmentMap
end

return function(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end

	humanoid.BreakJointsOnDeath = false

	local old = character:FindFirstChild("RagdollConstraints")
	if old then
		old:Destroy()
	end
	clearAutoAttachments(character)

	local attachmentMap = buildAttachmentMap(character)
	local ragdollConstraints = buildConstraints(attachmentMap)
	local collisionFilters = buildCollisionFilters(attachmentMap, character.PrimaryPart)
	collisionFilters.Parent = ragdollConstraints
	ragdollConstraints.Parent = character
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">getLastWordFromPascalCase</string>
            <string name="Source"><![CDATA[local function getLastWordFromPascalCase(value: string): string
	local words = {}
	for word in string.gmatch(value, "%u[%l%d]*") do
		table.insert(words, word)
	end
	if #words == 0 then
		return value
	end
	return words[#words]
end

return getLastWordFromPascalCase

]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">RagdollService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Living "Ragdolled" status drives constraint ragdoll.
	Adapted from NewMarvelProject RagdollService.server — same physics path.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RagdollHandlerFolder = script.Parent:WaitForChild("RagdollHandler")
local BuildRagdoll = require(RagdollHandlerFolder:WaitForChild("buildRagdoll"))
local RagdollHandler = require(RagdollHandlerFolder)
local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)

local GET_UP_TOKEN_ATTR = "GetUpToken"

type TkLandWatch = {
	armed: boolean,
	startedAt: number,
}

local tkLandWatch: { [Model]: TkLandWatch } = {}

local function playGetUpAnim(character: Model): AnimationTrack?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = GameConstants.GET_UP_ANIM
	local ok, track = pcall(function()
		return (animator :: Animator):LoadAnimation(anim)
	end)
	anim:Destroy()
	if not ok or not track then
		return nil
	end
	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = false
	track:Play(0.12, 1, 1)
	return track
end

local function finishGetUp(character: Model, token: number)
	if not character.Parent then
		return
	end
	if character:GetAttribute(GET_UP_TOKEN_ATTR) ~= token then
		return
	end
	if character:GetAttribute(GameConstants.GETTING_UP_ATTRIBUTE) ~= true then
		return
	end
	character:SetAttribute(GameConstants.GETTING_UP_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.WalkSpeed = GameConstants.DEFAULT_WALK_SPEED
		humanoid.JumpPower = 50
		pcall(function()
			humanoid.JumpHeight = 7.2
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end)
	end
end

local function stampGetUp(character: Model): number?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	local token = ((character:GetAttribute(GET_UP_TOKEN_ATTR) :: number?) or 0) + 1
	character:SetAttribute(GET_UP_TOKEN_ATTR, token)
	character:SetAttribute(GameConstants.GETTING_UP_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	local now = AbilityCooldownHelper.getNow()
	local existing = character:GetAttribute(GameConstants.PROTECTED_UNTIL_ATTRIBUTE)
	local untilTime = now + GameConstants.GET_UP_IFRAME
	if type(existing) == "number" then
		untilTime = math.max(untilTime, existing)
	end
	character:SetAttribute(GameConstants.PROTECTED_UNTIL_ATTRIBUTE, untilTime)
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	pcall(function()
		humanoid.JumpHeight = 0
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	end)
	return token
end

local function startGetUpAnim(character: Model, token: number)
	local track = playGetUpAnim(character)
	local duration = 1.8
	if track and track.Length > 0.05 then
		duration = track.Length / math.max(track.Speed, 0.01)
	end
	task.delay(duration + 0.05, function()
		finishGetUp(character, token)
	end)
end

local function cancelGetUp(character: Model)
	local token = ((character:GetAttribute(GET_UP_TOKEN_ATTR) :: number?) or 0) + 1
	character:SetAttribute(GET_UP_TOKEN_ATTR, token)
	if character:GetAttribute(GameConstants.GETTING_UP_ATTRIBUTE) == true then
		character:SetAttribute(GameConstants.GETTING_UP_ATTRIBUTE, nil)
		character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
	end
end

local RagdollService = {}

local ragdollVisualLast: { [Model]: boolean? } = {}
local ragdollAttrConns: { [Model]: RBXScriptConnection } = {}
local ragdollImpactConns: { [Model]: RBXScriptConnection } = {}
local ragdollImpactPlayed: { [Model]: boolean } = {}
local npcDescendantScriptConns: { [Model]: RBXScriptConnection } = {}
local npcLastAnimatorStop: { [Model]: number } = {}
local abilityInterruptListeners: { (Player, Model) -> () } = {}

local function notifyAbilityInterrupt(character: Model)
	if character:GetAttribute("BeamClashActive") == true then
		return
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return
	end
	for _, fn in abilityInterruptListeners do
		task.spawn(fn, player, character)
	end
end

local function bindRagdollImpactSound(character: Model)
	local old = ragdollImpactConns[character]
	if old then
		old:Disconnect()
		ragdollImpactConns[character] = nil
	end
	local torso = character:FindFirstChild("UpperTorso")
	if not torso or not torso:IsA("BasePart") then
		return
	end
	ragdollImpactConns[character] = torso.Touched:Connect(function(otherPart)
		if character:GetAttribute("Ragdolled") ~= true or ragdollImpactPlayed[character] then
			return
		end
		if not otherPart.CanCollide or otherPart:IsDescendantOf(character) then
			return
		end
		-- A downward surface check prevents walls/characters from counting as ground impact.
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		local distance = torso.Size.Y * 0.5 + 1.75
		local hit = Workspace:Raycast(torso.Position, Vector3.new(0, -distance, 0), params)
		if not hit or hit.Normal.Y < 0.45 then
			return
		end
		ragdollImpactPlayed[character] = true
		local sounds = GameConstants.RAGDOLL_SOUNDS
		if type(sounds) == "table" and #sounds > 0 then
			VfxHelper.playWorldSound(sounds[math.random(1, #sounds)], torso.Position, 0.95)
		end
	end)
end

function RagdollService.onAbilityInterrupt(listener: (Player, Model) -> ())
	table.insert(abilityInterruptListeners, listener)
end

local SCRIPT_WAS_ENABLED_ATTR = "RagdollNpcScriptWasEnabled"
local NPC_ANIMATOR_STOP_INTERVAL = 0.4

local function isCharacterBodyPart(part: BasePart): boolean
	local parent = part.Parent
	if parent and parent:IsA("Accessory") then
		return false
	end
	return true
end

local function ensureBodyUnanchored(character: Model)
	for _, desc in character:GetDescendants() do
		if desc:IsA("BasePart") and isCharacterBodyPart(desc) and desc.Anchored then
			desc.Anchored = false
		end
	end
end

local function stopNpcAnimatorTracks(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	for _, track in animator:GetPlayingAnimationTracks() do
		pcall(function()
			track:Stop(0)
		end)
	end
end

local function suspendNpcServerScripts(character: Model)
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Script") and d:GetAttribute("RagdollNeverSuspend") ~= true then
			if d:GetAttribute(SCRIPT_WAS_ENABLED_ATTR) == nil then
				d:SetAttribute(SCRIPT_WAS_ENABLED_ATTR, d.Enabled)
				d.Enabled = false
			end
		end
	end
end

local function resumeNpcServerScripts(character: Model)
	if not character.Parent then
		return
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Script") then
			local was = d:GetAttribute(SCRIPT_WAS_ENABLED_ATTR)
			if typeof(was) == "boolean" then
				d.Enabled = was
				d:SetAttribute(SCRIPT_WAS_ENABLED_ATTR, nil)
			end
		end
	end
end

local function suspendOneNpcScriptIfNeeded(scriptInst: Script)
	if scriptInst:GetAttribute("RagdollNeverSuspend") == true then
		return
	end
	if scriptInst:GetAttribute(SCRIPT_WAS_ENABLED_ATTR) ~= nil then
		return
	end
	scriptInst:SetAttribute(SCRIPT_WAS_ENABLED_ATTR, scriptInst.Enabled)
	scriptInst.Enabled = false
end

local function startNpcScriptDescendantWatcher(character: Model)
	if npcDescendantScriptConns[character] then
		return
	end
	npcDescendantScriptConns[character] = character.DescendantAdded:Connect(function(inst)
		if character:GetAttribute("Ragdolled") ~= true then
			return
		end
		if inst:IsA("Script") then
			suspendOneNpcScriptIfNeeded(inst)
		end
	end)
end

local function stopNpcScriptDescendantWatcher(character: Model)
	local c = npcDescendantScriptConns[character]
	if c then
		c:Disconnect()
		npcDescendantScriptConns[character] = nil
	end
end

local function setServerOwnership(character: Model, owner: Player?)
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function()
				d:SetNetworkOwner(owner)
			end)
		end
	end
end

local function countMotor6Ds(character: Model): number
	local n = 0
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Motor6D") then
			n += 1
		end
	end
	return n
end

local function countValidRagdollConstraints(folder: Instance): number
	local n = 0
	for _, child in folder:GetChildren() do
		if child:IsA("Constraint") then
			local rigid = child:FindFirstChild("RigidJoint")
			if rigid and rigid:IsA("ObjectValue") and rigid.Value and rigid.Value:IsA("Motor6D") then
				n += 1
			end
		end
	end
	return n
end

local function waitForCharacterRig(character: Model): boolean
	character:WaitForChild("HumanoidRootPart", 8)
	local plr = Players:GetPlayerFromCharacter(character)
	if plr then
		-- Don't hang if appearance already loaded
		pcall(function()
			if not plr:HasAppearanceLoaded() then
				plr.CharacterAppearanceLoaded:Wait()
			end
		end)
	end
	local t0 = os.clock()
	while os.clock() - t0 < 6 do
		-- R6 ~5-6 motors, R15 ~14-16 (blocky packages stream in late)
		if countMotor6Ds(character) >= 5 then
			task.wait(0.15)
			return true
		end
		task.wait(0.05)
	end
	return character:FindFirstChildWhichIsA("Motor6D", true) ~= nil
end

local function ensureRagdollBuilt(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end
	local folder = character:FindFirstChild("RagdollConstraints")
	local motors = countMotor6Ds(character)
	local valid = 0
	if folder then
		valid = countValidRagdollConstraints(folder)
	end
	-- Empty / premature builds (CharacterAdded before package Motor6Ds) must be rebuilt.
	-- Expect roughly one constraint per non-root motor.
	local needRebuild = (not folder) or valid < 3 or (motors >= 5 and valid < math.max(3, motors - 3))
	if not needRebuild then
		return
	end
	if folder then
		folder:Destroy()
	end
	BuildRagdoll(humanoid)
	RagdollHandler:ragdollAdded(humanoid)
end

local function disconnectRagdoll(character: Model)
	stopNpcScriptDescendantWatcher(character)
	resumeNpcServerScripts(character)
	npcLastAnimatorStop[character] = nil
	local conn = ragdollAttrConns[character]
	if conn then
		conn:Disconnect()
		ragdollAttrConns[character] = nil
	end
	local impactConn = ragdollImpactConns[character]
	if impactConn then
		impactConn:Disconnect()
		ragdollImpactConns[character] = nil
	end
	ragdollImpactPlayed[character] = nil
	ragdollVisualLast[character] = nil
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and Players:GetPlayerFromCharacter(character) == nil then
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
		end)
	end
	if humanoid then
		RagdollHandler:ragdollRemoved(humanoid)
	end
end

local function syncPhysicsRagdollFromRagdolledAttribute(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local want = character:GetAttribute("Ragdolled") == true

	if humanoid.Health <= 0 and not want then
		return
	end
	if ragdollVisualLast[character] == want then
		return
	end
	ragdollVisualLast[character] = want

	ensureRagdollBuilt(humanoid)

	if want then
		ensureBodyUnanchored(character)
		local plr = Players:GetPlayerFromCharacter(character)
		if plr then
			setServerOwnership(character, nil)
		else
			suspendNpcServerScripts(character)
			startNpcScriptDescendantWatcher(character)
			stopNpcAnimatorTracks(humanoid)
			npcLastAnimatorStop[character] = nil
			pcall(function()
				humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
			end)
		end
		RagdollHandler:ManualRagdoll(humanoid, true)
	else
		RagdollHandler:ManualRagdoll(humanoid, false)
		local plr = Players:GetPlayerFromCharacter(character)
		if plr then
			setServerOwnership(character, plr)
		else
			stopNpcScriptDescendantWatcher(character)
			resumeNpcServerScripts(character)
			npcLastAnimatorStop[character] = nil
			pcall(function()
				humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			end)
		end
	end
end

local function bindRagdolledAttributeSync(character: Model)
	if ragdollAttrConns[character] then
		ragdollAttrConns[character]:Disconnect()
		ragdollAttrConns[character] = nil
	end
	ragdollAttrConns[character] = character:GetAttributeChangedSignal("Ragdolled"):Connect(function()
		local nowRagdolled = character:GetAttribute("Ragdolled") == true
		if nowRagdolled then
			ragdollImpactPlayed[character] = false
		else
			ragdollImpactPlayed[character] = nil
		end
		syncPhysicsRagdollFromRagdolledAttribute(character)
		if nowRagdolled then
			notifyAbilityInterrupt(character)
		end
	end)
	syncPhysicsRagdollFromRagdolledAttribute(character)
end

local function setupRagdoll(character: Model)
	if ragdollAttrConns[character] then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end

	-- Defer until Motor6Ds / blocky package parts exist (avoids empty RagdollConstraints forever)
	task.spawn(function()
		if not character.Parent then
			return
		end
		waitForCharacterRig(character)
		if not character.Parent or not humanoid.Parent then
			return
		end
		if ragdollAttrConns[character] then
			-- Already bound (e.g. apply raced ahead); just rebuild if needed
			ensureRagdollBuilt(humanoid)
			syncPhysicsRagdollFromRagdolledAttribute(character)
			return
		end
		BuildRagdoll(humanoid)
		RagdollHandler:ragdollAdded(humanoid)
		ensureRagdollBuilt(humanoid)
		bindRagdollImpactSound(character)
		bindRagdolledAttributeSync(character)
		character.Destroying:Once(function()
			disconnectRagdoll(character)
		end)
	end)
end

local function bindPlayerRagdoll(player: Player)
	player.CharacterAdded:Connect(function(character)
		setupRagdoll(character)
	end)
	player.CharacterRemoving:Connect(function(character)
		disconnectRagdoll(character)
	end)
	if player.Character then
		setupRagdoll(player.Character)
	end
end

local function trySetupWorkspaceCharacter(model: Model)
	if Players:GetPlayerFromCharacter(model) then
		return
	end
	setupRagdoll(model)
end

function RagdollService.maintain(character: Model)
	if not character or not character.Parent then
		return
	end
	if character:GetAttribute("Ragdolled") ~= true then
		RagdollService.apply(character)
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	ensureRagdollBuilt(humanoid)
	RagdollHandler:MaintainStatusRagdoll(humanoid)
end

function RagdollService.apply(character: Model)
	if not character or not character.Parent then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and countMotor6Ds(character) < 5 then
		waitForCharacterRig(character)
	end
	if not ragdollAttrConns[character] then
		setupRagdoll(character)
	end
	if humanoid then
		ensureRagdollBuilt(humanoid)
	end
	local was = character:GetAttribute("Ragdolled") == true
	cancelGetUp(character)
	ragdollVisualLast[character] = nil
	character:SetAttribute("Ragdolled", true)
	syncPhysicsRagdollFromRagdolledAttribute(character)
	if not was then
		notifyAbilityInterrupt(character)
	end
end

function RagdollService.applyTimed(character: Model, duration: number)
	if not character or not character.Parent then
		return
	end
	RagdollService.apply(character)
	character:SetAttribute("RagdollEndTime", Workspace:GetServerTimeNow() + duration)
	local token = (character:GetAttribute("RagdollClearToken") :: number?) or 0
	token += 1
	character:SetAttribute("RagdollClearToken", token)
	task.delay(duration, function()
		if not character.Parent then
			return
		end
		if character:GetAttribute("RagdollClearToken") ~= token then
			return
		end
		if character:GetAttribute("TelekinesisHeld") == true then
			return
		end
		if character:GetAttribute("MgSlamHeld") == true then
			return
		end
		RagdollService.clear(character)
	end)
end

function RagdollService.clear(character: Model)
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local getUpToken: number? = nil
	if humanoid and humanoid.Health > 0 and character.Parent then
		getUpToken = stampGetUp(character)
	end
	character:SetAttribute("Ragdolled", nil)
	character:SetAttribute("RagdollEndTime", nil)
	ragdollVisualLast[character] = nil
	syncPhysicsRagdollFromRagdolledAttribute(character)
	if humanoid and humanoid.Parent and character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) ~= true then
		humanoid.AutoRotate = true
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		for _, name in { "TKCasterFaceAlign", "TKCasterFaceAttachment", "MgFaceAlign", "MgFaceAtt", "IwCastFaceAlign", "IwCastFaceAtt" } do
			local inst = root:FindFirstChild(name)
			if inst then
				inst:Destroy()
			end
		end
	end
	if getUpToken then
		startGetUpAnim(character, getUpToken)
	end
end

local function torsoHeightAboveGround(character: Model): number
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not (torso and torso:IsA("BasePart")) then
		local root = character:FindFirstChild("HumanoidRootPart")
		torso = if root and root:IsA("BasePart") then root else nil
	end
	if not torso then
		return 80
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local hit = Workspace:Raycast(torso.Position, Vector3.new(0, -80, 0), params)
	if hit then
		return math.max(0, torso.Position.Y - hit.Position.Y)
	end
	return 80
end

function RagdollService.markTelekineticLand(character: Model)
	if not character or not character.Parent then
		return
	end
	tkLandWatch[character] = {
		armed = torsoHeightAboveGround(character) > 3,
		startedAt = os.clock(),
	}
end

local function updateTkLandWatch()
	for character, watch in tkLandWatch do
		if not character.Parent then
			tkLandWatch[character] = nil
			continue
		end
		if os.clock() - watch.startedAt > 8 then
			tkLandWatch[character] = nil
			continue
		end
		local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			tkLandWatch[character] = nil
			continue
		end
		local height = torsoHeightAboveGround(character)
		local velY = root.AssemblyLinearVelocity.Y
		if torso and torso:IsA("BasePart") then
			velY = torso.AssemblyLinearVelocity.Y
		end
		if not watch.armed then
			if height > 3 or velY > 14 then
				watch.armed = true
			end
			continue
		end
		if height <= 1.05 and velY <= 12 then
			local at = if torso and torso:IsA("BasePart") then torso.Position else root.Position
			VfxHelper.playWorldSound(GameConstants.TK_LAND_SOUND, at, 1.05)
			tkLandWatch[character] = nil
		end
	end
end

function RagdollService.clearAfter(character: Model, delaySec: number)
	if not character or not character.Parent then
		return
	end
	RagdollService.apply(character)
	local token = (character:GetAttribute("RagdollClearToken") :: number?) or 0
	token += 1
	character:SetAttribute("RagdollClearToken", token)
	character:SetAttribute("RagdollEndTime", Workspace:GetServerTimeNow() + delaySec)
	task.delay(delaySec, function()
		if not character.Parent then
			return
		end
		if character:GetAttribute("RagdollClearToken") ~= token then
			return
		end
		if character:GetAttribute("TelekinesisHeld") == true then
			return
		end
		if character:GetAttribute("MgSlamHeld") == true then
			return
		end
		RagdollService.clear(character)
	end)
end

function RagdollService.init()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	require(ReplicatedStorage.Shared.RagdollStatus).bindServer({
		apply = function(character: Model)
			RagdollService.apply(character)
		end,
		clear = function(character: Model)
			RagdollService.clear(character)
		end,
		applyTimed = function(character: Model, duration: number)
			RagdollService.applyTimed(character, duration)
		end,
		clearAfter = function(character: Model, delaySec: number)
			RagdollService.clearAfter(character, delaySec)
		end,
	})

	Players.PlayerAdded:Connect(bindPlayerRagdoll)
	for _, player in ipairs(Players:GetPlayers()) do
		bindPlayerRagdoll(player)
	end

	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("Humanoid") then
			local parent = inst.Parent
			if parent and parent:IsA("Model") then
				trySetupWorkspaceCharacter(parent)
			end
		end
	end

	Workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("Humanoid") then
			local parent = inst.Parent
			if parent and parent:IsA("Model") then
				trySetupWorkspaceCharacter(parent)
			end
		end
	end)

	for _, character in ipairs(CollectionService:GetTagged("TestCharacter")) do
		if character:IsA("Model") then
			setupRagdoll(character)
		end
	end

	CollectionService:GetInstanceAddedSignal("TestCharacter"):Connect(function(character)
		if character:IsA("Model") then
			setupRagdoll(character)
		end
	end)

	local postSimOk, postSimEvent = pcall(function()
		return (RunService :: any).PostSimulation
	end)

	RunService.Heartbeat:Connect(function()
		updateTkLandWatch()
		for character, _ in pairs(ragdollAttrConns) do
			if not character.Parent then
				continue
			end
			if character:GetAttribute("Ragdolled") ~= true then
				continue
			end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not humanoid or not humanoid.Parent or humanoid.Health <= 0 then
				continue
			end
			if postSimOk and postSimEvent and Players:GetPlayerFromCharacter(character) == nil then
				continue
			end
			RagdollHandler:MaintainStatusRagdoll(humanoid)
		end
	end)

	if postSimOk and postSimEvent then
		postSimEvent:Connect(function()
			local now = tick()
			for character, _ in pairs(ragdollAttrConns) do
				if not character.Parent then
					continue
				end
				if Players:GetPlayerFromCharacter(character) ~= nil then
					continue
				end
				if character:GetAttribute("Ragdolled") ~= true then
					continue
				end
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if not humanoid or not humanoid.Parent or humanoid.Health <= 0 then
					continue
				end
				RagdollHandler:MaintainNpcRagdollAfterPhysics(humanoid)

				local lastAnim = npcLastAnimatorStop[character]
				if lastAnim == nil or now - lastAnim >= NPC_ANIMATOR_STOP_INTERVAL then
					npcLastAnimatorStop[character] = now
					stopNpcAnimatorTracks(humanoid)
				end
			end
		end)
	end
end

return RagdollService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">ScarletWitchService</string>
          <string name="Source"><![CDATA[--!strict

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local InteractableHelper = require(ReplicatedStorage.Shared.InteractableHelper)
local ProjectileHelper = require(ReplicatedStorage.Shared.ProjectileHelper)
local PushHelper = require(ReplicatedStorage.Shared.PushHelper)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local RagdollStatus = require(ReplicatedStorage.Shared.RagdollStatus)
local ScreenFeelHelper = require(ReplicatedStorage.Shared.ScreenFeelHelper)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)
local CharacterService = require(script.Parent.CharacterService)
local HandParticleHelper = require(script.Parent.HandParticleHelper)
local HexFlightService = require(script.Parent.HexFlightService)
local NameplateService = require(script.Parent.NameplateService)
local TelekinesisService = require(script.Parent.TelekinesisService)
local LokiService = require(script.Parent.LokiService)
local BeamClashService = require(script.Parent.BeamClashService)

local ScarletWitchService = {}

type BeamState = {
	character: Model,
	startHost: BasePart,
	handWeld: Weld?,
	tipHost: BasePart,
	startAtt: Attachment,
	endAtt: Attachment,
	beam: Beam?,
	victim: Model,
	victimRoot: BasePart,
	startedAt: number,
	smoothedTip: Vector3,
	lastHit: number,
	launched: boolean,
	reached: boolean,
	abilityStartedAt: number?,
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	casterAutoRotate: boolean,
	victimWalk: number,
	victimJump: number?,
	victimAutoRotate: boolean,
	casterFace: AlignOrientation?,
	casterFaceAtt: Attachment?,
	victimFace: AlignOrientation?,
	victimFaceAtt: Attachment?,
	animTrack: AnimationTrack?,
	victimAnimTrack: AnimationTrack?,
}

type ShieldState = {
	character: Model,
	root: BasePart,
	visual: Instance?,
	activePartials: { BasePart },
	partialToken: number,
	hp: number,
	maxHp: number,
	billboard: BillboardGui,
	hpLabel: TextLabel,
	hpFill: Frame,
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	autoRotate: boolean,
	animTrack: AnimationTrack?,
}

type RegenState = {
	character: Model,
	particles: { Instance },
}

type AbsorbBeamFx = {
	startAtt: Attachment,
	endAtt: Attachment,
	beam: Beam?,
	travelHost: BasePart?,
	destPart: BasePart,
	startWorld: Vector3,
	curve0Max: number,
	curve1Max: number,
	curve0Sign: number,
	curve1Sign: number,
	freq0: number,
	freq1: number,
	phase0: number,
	phase1: number,
	wander0: number,
	wander1: number,
	riseDelay: number,
	riseSpan: number,
}

type AbsorbState = {
	character: Model,
	target: Model,
	targetHum: Humanoid,
	casterHum: Humanoid,
	casterRoot: BasePart,
	targetRoot: BasePart,
	beams: { AbsorbBeamFx },
	startHealth: number,
	startedAt: number,
	reachTime: number,
	beamsReached: boolean,
	drainStartedAt: number?,
	duration: number,
	liftAlign: AlignPosition?,
	liftAtt: Attachment?,
	liftStartY: number,
	liftBaseX: number,
	liftBaseZ: number,
	casterFace: AlignOrientation?,
	targetFace: AlignOrientation?,
	casterFaceAtt: Attachment?,
	targetFaceAtt: Attachment?,
	prevTargetWalk: number,
	prevTargetJump: number,
	prevTargetAutoRotate: boolean,
	prevCasterAutoRotate: boolean,
}

type RuneKind = "fire" | "lightning" | "water"

type RuneVictimState = {
	model: Model,
	kind: RuneKind,
	fx: { Instance },
	bubble: Instance?,
	liftAlign: AlignPosition?,
	liftAtt: Attachment?,
	spinAlign: AlignOrientation?,
	walk: number,
	jump: number?,
	tickAcc: number,
	nextLightning: number,
	nextWander: number,
	spinRates: Vector3?,
	spinGoal: Vector3?,
	nextSpinShift: number?,
	spinCFrame: CFrame?,
	wanderGoal: Vector3?,
	bubblePos: Vector3?,
	animTrack: AnimationTrack?,
	autoRotate: boolean?,
	swirlSign: number?,
	transparencySnaps: { any }?,
}

type RuneFieldState = {
	character: Model,
	zone: Instance?,
	victims: { RuneVictimState },
	endsAt: number,
	dest: Vector3,
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	casterAutoRotate: boolean,
	faceAlign: AlignOrientation?,
	faceAtt: Attachment?,
}

type ProbBeamState = {
	character: Model,
	victim: Model,
	hand: BasePart,
	casterRoot: BasePart,
	startHost: BasePart,
	tipHost: BasePart,
	startAtt: Attachment,
	endAtt: Attachment,
	beam: Beam?,
	beams: { Beam },
	startPos: Vector3,
	endPos: Vector3,
	startedAt: number,
	launched: boolean,
	channelStartedAt: number?,
	reached: boolean,
	finishing: boolean,
	damageAcc: number,
	casterAutoRotate: boolean,
	victimAutoRotate: boolean,
	victimWalk: number,
	victimJumpPower: number,
	victimJumpHeight: number,
	victimUseJumpPower: boolean,
	handWeld: Weld?,
	torsoWeld: Weld?,
	aimPart: BasePart?,
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	useJumpPower: boolean,
	victimAlive: boolean,
	lastEndPos: Vector3?,
}

type ProbObjectState = {
	victim: Model,
	prop: Instance,
	snaps: any,
	look: Vector3,
	endsAt: number,
	displayType: Enum.HumanoidDisplayDistanceType?,
	walk: number?,
	jumpPower: number?,
	jumpHeight: number?,
	useJumpPower: boolean?,
	autoRotate: boolean?,
	jumpingEnabled: boolean?,
}

local beamByPlayer: { [Player]: BeamState } = {}
local shieldByPlayer: { [Player]: ShieldState } = {}
local regenByPlayer: { [Player]: RegenState } = {}
local absorbByPlayer: { [Player]: AbsorbState } = {}
local runeFieldByPlayer: { [Player]: RuneFieldState } = {}
local probBeamByPlayer: { [Player]: ProbBeamState } = {}
local objectHexByVictim: { [Model]: ProbObjectState } = {}

type ChaosFallState = {
	airborne: boolean,
	peakHeightAboveGround: number,
	wasFlying: boolean,
	impacted: boolean,
	landAnimPlayed: boolean,
}

local chaosFallByPlayer: { [Player]: ChaosFallState } = {}
local hexDashUntil: { [Player]: number } = {}
local hexDashCdUntil: { [Player]: number } = {}

local function getChaosFallState(player: Player): ChaosFallState
	local state = chaosFallByPlayer[player]
	if not state then
		state = {
			airborne = false,
			peakHeightAboveGround = 0,
			wasFlying = false,
			impacted = false,
			landAnimPlayed = false,
		}
		chaosFallByPlayer[player] = state
	end
	return state
end

local function playCharacterAnim(character: Model, assetId: string, priority: Enum.AnimationPriority?): AnimationTrack?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = assetId
	local ok, track = pcall(function()
		return (animator :: Animator):LoadAnimation(anim)
	end)
	if not ok or not track then
		return nil
	end
	track.Priority = priority or Enum.AnimationPriority.Action
	track:Play(0.08, 1, 1)
	return track
end

local function clearChaosFall(player: Player)
	chaosFallByPlayer[player] = nil
end

local function heightAboveGround(root: BasePart, character: Model): (number, Vector3?)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local origin = root.Position
	local hit = workspace:Raycast(origin, Vector3.new(0, -500, 0), params)
	if hit then
		return math.max(0, origin.Y - hit.Position.Y), hit.Position
	end
	return 500, nil
end

local function triggerChaosImpact(character: Model, landPos: Vector3)
	local radius = GameConstants.CHAOS_IMPACT_RADIUS
	VfxHelper.spawnScarletLandingImpact(landPos, radius)

	for _, victim in CombatHelper.overlapCharacters(landPos, radius, character) do
		if victim == character then
			continue
		end
		if victim:GetAttribute("LokiUltClone") == true or victim:GetAttribute("LokiDecoy") == true then
			continue
		end
		CombatHelper.dealDamage(character, victim, GameConstants.CHAOS_IMPACT_DAMAGE, landPos, "projectile")
		RagdollStatus.applyTimed(victim, GameConstants.CHAOS_IMPACT_RAGDOLL)
		local vRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
		local away = if vRoot then (vRoot.Position - landPos) else Vector3.new(0, 0, -1)
		if away.Magnitude < 0.05 then
			away = Vector3.new(0, 0, -1)
		end
		PushHelper.applyToCharacter(victim, away, {
			speed = GameConstants.CHAOS_IMPACT_PUSH_SPEED,
			upBoost = GameConstants.CHAOS_IMPACT_PUSH_UP,
		})
	end
end

local function updateChaosImpact(player: Player, character: Model, dt: number)
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "scarlet_witch" then
		clearChaosFall(player)
		return
	end
	if character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
		clearChaosFall(player)
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		clearChaosFall(player)
		return
	end

	local state = getChaosFallState(player)
	local flying = character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
	local height, groundPos = heightAboveGround(root, character)
	local vel = root.AssemblyLinearVelocity
	local falling = vel.Y < -2
	local humState = humanoid:GetState()
	local inAirState = humState == Enum.HumanoidStateType.Freefall
		or humState == Enum.HumanoidStateType.Jumping
		or humState == Enum.HumanoidStateType.FallingDown
	-- True land only (not "near ground while still falling")
	local trulyLanded = humState == Enum.HumanoidStateType.Landed
		or (
			height < 2.8
			and vel.Y > -18
			and (
				humanoid.FloorMaterial ~= Enum.Material.Air
				or humState == Enum.HumanoidStateType.Running
				or humState == Enum.HumanoidStateType.RunningNoPhysics
				or humState == Enum.HumanoidStateType.GettingUp
			)
		)
		or (state.airborne and height <= 2.2 and vel.Y > -16)

	if flying then
		state.wasFlying = true
		state.airborne = true
		state.impacted = false
		state.landAnimPlayed = false
		state.peakHeightAboveGround = math.max(state.peakHeightAboveGround, height)
		return
	end

	if state.wasFlying then
		state.wasFlying = false
		state.airborne = true
		state.impacted = false
		state.landAnimPlayed = false
		state.peakHeightAboveGround = math.max(state.peakHeightAboveGround, height)
	end

	if inAirState or (falling and height > 3) then
		-- Allow a new slam only after leaving the ground again
		if state.impacted and height > 5 then
			state.impacted = false
			state.landAnimPlayed = false
		end
		state.airborne = true
		state.peakHeightAboveGround = math.max(state.peakHeightAboveGround, height)
	end

	-- Pre-land pose: play while still airborne, very close to ground (qualifying fall only)
	if
		state.airborne
		and not state.impacted
		and not state.landAnimPlayed
		and falling
		and height <= GameConstants.CHAOS_IMPACT_LAND_ANIM_HEIGHT
		and state.peakHeightAboveGround >= GameConstants.CHAOS_IMPACT_MIN_FALL
		and not AbilityCooldownHelper.isOnCooldown(character, "chaos_impact")
	then
		state.landAnimPlayed = true
		playCharacterAnim(character, GameConstants.CHAOS_IMPACT_LAND_ANIM, Enum.AnimationPriority.Action4)
	end

	-- Landed after qualifying fall — hero pose only (no AoE slam damage).
	if state.airborne and not state.impacted and trulyLanded then
		state.impacted = true
		state.airborne = false
		state.peakHeightAboveGround = 0
		return
	end

	if trulyLanded and not falling then
		state.airborne = false
		state.peakHeightAboveGround = 0
		-- Keep impacted=true while grounded so Landedâ†’Running doesn't double-fire
		return
	end

	-- Strong, visible deceleration in the last ~30 studs (air only â€” never trigger impact here)
	if
		state.airborne
		and falling
		and height <= GameConstants.CHAOS_IMPACT_DECEL_HEIGHT
		and state.peakHeightAboveGround >= GameConstants.CHAOS_IMPACT_MIN_FALL
	then
		local t = math.clamp(height / GameConstants.CHAOS_IMPACT_DECEL_HEIGHT, 0, 1)
		local ease = t * t
		local maxDown = GameConstants.CHAOS_IMPACT_MAX_DOWN_NEAR_GROUND
			+ (GameConstants.CHAOS_IMPACT_MAX_DOWN_AT_START - GameConstants.CHAOS_IMPACT_MAX_DOWN_NEAR_GROUND) * ease
		local softTarget = -maxDown * (0.5 + 0.5 * t)
		local brakeSpeed = 10 + 22 * (1 - t)
		local blend = math.clamp(dt * brakeSpeed, 0, 1)
		local newY = vel.Y + (softTarget - vel.Y) * blend
		if newY < -maxDown then
			newY = -maxDown
		end
		if newY > vel.Y then
			root.AssemblyLinearVelocity = Vector3.new(vel.X, newY, vel.Z)
		elseif vel.Y < -maxDown then
			root.AssemblyLinearVelocity = Vector3.new(vel.X, -maxDown, vel.Z)
		end
	end
end

local function finishAbility(character: Model, abilityId: string, cooldown: number)
	AbilityCooldownHelper.setActive(character, abilityId, false)
	AbilityCooldownHelper.applyAfterUse(character, abilityId, cooldown)
end

local function trySpendEnergy(character: Model, amount: number): boolean
	return CharacterService.spendEnergy(character, amount)
end

local function refundEnergy(character: Model, amount: number)
	local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
	if type(energy) == "number" then
		character:SetAttribute(
			GameConstants.ENERGY_ATTRIBUTE,
			math.min((character:GetAttribute(GameConstants.MAX_ENERGY_ATTRIBUTE) :: number?) or 100, energy + amount)
		)
	end
end

local SW_CONTROL_ACTIVE_IDS = {
	"hex_beam",
	"hex_shield",
	"hex_flight",
	"probability_hex",
	"hex_displacement",
	"rune_entrapment",
}

local function enterControlLock(player: Player, character: Model)
	if character:GetAttribute(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE) == true then
		return
	end
	local untilTime = AbilityCooldownHelper.getNow() + GameConstants.SW_CONTROL_LOCK_TIME
	character:SetAttribute(GameConstants.SW_CONTROL_ATTRIBUTE, GameConstants.SW_CONTROL_MAX)
	character:SetAttribute(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.SW_CONTROL_LOCK_UNTIL_ATTRIBUTE, untilTime)
end

local function spendControl(player: Player, character: Model, amount: number)
	if character:GetAttribute(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE) == true then
		return
	end
	local current = character:GetAttribute(GameConstants.SW_CONTROL_ATTRIBUTE)
	if type(current) ~= "number" then
		current = 0
	end
	current = math.min(GameConstants.SW_CONTROL_MAX, current + amount)
	character:SetAttribute(GameConstants.SW_CONTROL_ATTRIBUTE, current)
	if current >= GameConstants.SW_CONTROL_MAX then
		enterControlLock(player, character)
	end
end

local function updateControl(player: Player, character: Model, dt: number)
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "scarlet_witch" then
		return
	end
	local maxC = character:GetAttribute(GameConstants.SW_CONTROL_MAX_ATTRIBUTE)
	if type(maxC) ~= "number" or maxC <= 0 then
		maxC = GameConstants.SW_CONTROL_MAX
	end
	local current = character:GetAttribute(GameConstants.SW_CONTROL_ATTRIBUTE)
	if type(current) ~= "number" then
		current = 0
	end
	if character:GetAttribute(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE) == true then
		current -= GameConstants.SW_CONTROL_OVERLOAD_DECAY_PER_SEC * dt
		current = math.clamp(current, 0, maxC)
		character:SetAttribute(GameConstants.SW_CONTROL_ATTRIBUTE, current)
		local untilTime = character:GetAttribute(GameConstants.SW_CONTROL_LOCK_UNTIL_ATTRIBUTE)
		local now = AbilityCooldownHelper.getNow()
		if type(untilTime) ~= "number" or now >= untilTime then
			character:SetAttribute(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE, nil)
			character:SetAttribute(GameConstants.SW_CONTROL_LOCK_UNTIL_ATTRIBUTE, nil)
		end
		return
	end
	local flying = character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
	local using = AbilityCooldownHelper.isAnyActive(character, SW_CONTROL_ACTIVE_IDS)
	if flying then
		current += GameConstants.SW_CONTROL_ACTIVE_PER_SEC * dt
	end
	if using then
		current += GameConstants.SW_CONTROL_ACTIVE_PER_SEC * dt
	end
	if not flying and not using then
		current -= GameConstants.SW_CONTROL_REGEN_PER_SEC * dt
	end
	current = math.clamp(current, 0, maxC)
	character:SetAttribute(GameConstants.SW_CONTROL_ATTRIBUTE, current)
	if current >= maxC then
		enterControlLock(player, character)
	end
end

local function canUse(character: Model, abilityId: string, energyCost: number): boolean
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "scarlet_witch" then
		return false
	end
	if CombatHelper.arePowersDisabled(character) then
		return false
	end
	if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
		and abilityId ~= "hex_bolt"
		and abilityId ~= "hex_flight"
	then
		return false
	end
	if character:GetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE) == true and abilityId ~= "hex_shield" then
		return false
	end
	if AbilityCooldownHelper.isActive(character, "regeneration") and abilityId ~= "regeneration" then
		return false
	end
	if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return false
	end
	if character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true and abilityId ~= "telekinesis" then
		return false
	end
	if AbilityCooldownHelper.isOnCooldown(character, abilityId) then
		return false
	end
	if AbilityCooldownHelper.isActive(character, abilityId) then
		return false
	end
	if AbilityCooldownHelper.hasBlockingActive(character, abilityId) then
		return false
	end
	if not trySpendEnergy(character, energyCost) then
		return false
	end
	local owner = Players:GetPlayerFromCharacter(character)
	local freeControlCast = abilityId == "telekinesis" or abilityId == "hex_bolt"
	if owner and not freeControlCast then
		spendControl(owner, character, GameConstants.SW_CONTROL_CAST_COST)
	end
	return true
end

local function fireCameraShake(player: Player, intensity: number?, duration: number?, fovScale: number?, vignetteScale: number?)
	Remotes.getEvent("CameraShake"):FireClient(player, {
		intensity = intensity or 0.4,
		duration = duration or 0.32,
		fovScale = fovScale,
		vignetteScale = vignetteScale,
	})
end

local function castTemplate(player: Player, abilityId: string)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", abilityId)
	if not entry or not canUse(character, entry.id, entry.energyCost) then
		return
	end
	AbilityCooldownHelper.setActive(character, entry.id, true)
	HandParticleHelper.pulse(character, 0.45)
	fireCameraShake(player, 0.4, 0.32, 0.28, 0.45)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		VfxHelper.castHandFlash(root.Position, VfxHelper.chaosColor())
	end
	task.delay(0.4, function()
		if character.Parent then
			finishAbility(character, entry.id, entry.cooldown)
		end
	end)
end

local function getRootPart(model: Model): BasePart?
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	local torso = model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	return nil
end

--[[ Aim point for Probability Hex beam tip (chest / upper torso, not HRP). ]]
local function getProbHexAimPart(model: Model): BasePart?
	local upper = model:FindFirstChild("UpperTorso")
	if upper and upper:IsA("BasePart") then
		return upper
	end
	local torso = model:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	return getRootPart(model)
end

local function setWorldPosKeepRot(inst: Instance, pos: Vector3)
	if inst:IsA("Model") then
		local model = inst :: Model
		model:PivotTo(CFrame.new(pos) * model:GetPivot().Rotation)
	elseif inst:IsA("BasePart") then
		local part = inst :: BasePart
		part.CFrame = CFrame.new(pos) * part.CFrame.Rotation
	end
end

local function attachRuneHeadFx(victim: Model, assetName: string): Instance?
	local head = victim:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		return nil
	end
	local template = VfxHelper.getScarletAsset("RuneDisplacement", assetName)
	if not template then
		return nil
	end
	local clone = VfxHelper.attachFxToBodyPart(template, head, "SwRuneHeadFx_")
	if not clone then
		return nil
	end
	VfxHelper.muteSounds(clone)
	VfxHelper.setParticlesEnabled(clone, true)
	VfxHelper.emitAllParticles(clone, 10)
	return clone
end

local function placeBubbleAtHrp(victim: Model): Instance?
	local hrp = getRootPart(victim)
	local template = VfxHelper.getScarletAsset("RuneDisplacement", "BubblePart")
	if not hrp or not template then
		return nil
	end
	local clone = VfxHelper.attachFxToBodyPart(template, hrp, "SwRuneBubble_")
	if not clone then
		return nil
	end
	VfxHelper.muteSounds(clone)
	VfxHelper.setParticlesEnabled(clone, true)
	VfxHelper.emitAllParticles(clone, 8)
	return clone
end

local function clearRuneVictim(victim: RuneVictimState)
	local hum = CombatHelper.getHumanoid(victim.model)
	if hum and hum.Parent then
		hum.WalkSpeed = victim.walk
		if victim.jump ~= nil then
			hum.JumpPower = victim.jump
		end
		if victim.autoRotate ~= nil then
			hum.AutoRotate = victim.autoRotate
		end
	end
	if victim.animTrack then
		victim.animTrack:Stop(0.2)
		victim.animTrack:Destroy()
		victim.animTrack = nil
	end
	if victim.liftAlign then
		victim.liftAlign:Destroy()
	end
	if victim.spinAlign then
		victim.spinAlign:Destroy()
	end
	if victim.liftAtt then
		victim.liftAtt:Destroy()
	end
	for _, fx in victim.fx do
		if fx.Parent then
			VfxHelper.retireFxSmooth(fx, 0.4, 2.2)
		end
	end
	if victim.bubble and victim.bubble.Parent then
		VfxHelper.retireFxSmooth(victim.bubble, 0.45, 2.4)
	end
	VfxHelper.restorePartTransparencies(victim.transparencySnaps)
	ScreenFeelHelper.clear(victim.model)
	if victim.kind == "fire" or victim.kind == "lightning" then
		RagdollStatus.clear(victim.model)
	end
	local root = getRootPart(victim.model)
	if root and root.Parent then
		local plr = Players:GetPlayerFromCharacter(victim.model)
		pcall(function()
			if plr then
				root:SetNetworkOwner(plr)
			else
				root:SetNetworkOwnershipAuto()
			end
		end)
	end
end

local function clearRuneCasterFace(state: RuneFieldState)
	if state.faceAlign then
		state.faceAlign:Destroy()
		state.faceAlign = nil
	end
	if state.faceAtt then
		state.faceAtt:Destroy()
		state.faceAtt = nil
	end
end

local function updateRuneCasterFace(state: RuneFieldState)
	if not state.faceAlign or not state.faceAlign.Parent then
		return
	end
	local root = state.character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local flat = Vector3.new(state.dest.X - root.Position.X, 0, state.dest.Z - root.Position.Z)
	if flat.Magnitude < 0.05 then
		return
	end
	state.faceAlign.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
end

local function stopRuneDisplacement(player: Player, applyCooldown: boolean?)
	local state = runeFieldByPlayer[player]
	if not state then
		return
	end
	runeFieldByPlayer[player] = nil
	if state.zone and state.zone.Parent then
		VfxHelper.retireFxSmooth(state.zone, 0.5, GameConstants.SW_RUNE_DURATION)
	end
	for _, victim in state.victims do
		clearRuneVictim(victim)
	end
	clearRuneCasterFace(state)
	local char = state.character
	if char.Parent then
		local hum = CombatHelper.getHumanoid(char)
		if hum and hum.Parent then
			hum.WalkSpeed = state.walk
			if state.jumpPower ~= nil then
				hum.JumpPower = state.jumpPower
			end
			if state.jumpHeight ~= nil then
				hum.JumpHeight = state.jumpHeight
			end
			hum.AutoRotate = state.casterAutoRotate
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
			end)
		end
		if char:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
			char:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
		end
		AbilityCooldownHelper.setActive(char, "rune_entrapment", false)
		if applyCooldown then
			local entry = CharacterRegistry.getAbilityById("scarlet_witch", "rune_entrapment")
			if entry then
				AbilityCooldownHelper.applyAfterUse(char, entry.id, entry.cooldown)
			end
		end
	end
	if char then
		HandParticleHelper.endUse(char)
	end
end

local function pickRuneKind(): RuneKind
	local roll = math.random(1, 3)
	if roll == 1 then
		return "fire"
	elseif roll == 2 then
		return "lightning"
	end
	return "water"
end

local function randomWaterFloatPos(center: Vector3): Vector3
	local angle = math.random() * math.pi * 2
	local radius = math.sqrt(math.random()) * GameConstants.SW_RUNE_RADIUS
	return Vector3.new(
		center.X + math.cos(angle) * radius,
		center.Y + GameConstants.SW_RUNE_WATER_LIFT,
		center.Z + math.sin(angle) * radius
	)
end

local function waterWanderDelay(): number
	return GameConstants.SW_RUNE_WATER_WANDER_MIN
		+ math.random() * (GameConstants.SW_RUNE_WATER_WANDER_MAX - GameConstants.SW_RUNE_WATER_WANDER_MIN)
end

local function waterSpinShiftDelay(): number
	return GameConstants.SW_RUNE_WATER_SPIN_SHIFT_MIN
		+ math.random() * (GameConstants.SW_RUNE_WATER_SPIN_SHIFT_MAX - GameConstants.SW_RUNE_WATER_SPIN_SHIFT_MIN)
end

--[[ Tumble rates for every axis so bubbled victims flip and turn, not just yaw. ]]
local function randomWaterSpinRates(): Vector3
	local base = GameConstants.SW_RUNE_WATER_SPIN_SPEED
	local function rate(): number
		local sign = if math.random(1, 2) == 1 then 1 else -1
		return sign * base * (0.45 + math.random() * 0.95)
	end
	return Vector3.new(rate(), rate(), rate())
end

local function applyRuneToVictim(attacker: Model, victim: Model, kind: RuneKind, dest: Vector3): RuneVictimState?
	local hum = CombatHelper.getHumanoid(victim)
	local root = getRootPart(victim)
	if not hum or not root or hum.Health <= 0 then
		return nil
	end
	local fx: { Instance } = {}
	local bubble: Instance? = nil
	local liftAlign: AlignPosition? = nil
	local liftAtt: Attachment? = nil
	local walk = hum.WalkSpeed
	local jump: number? = if hum.UseJumpPower then hum.JumpPower else nil
	local autoRotate = hum.AutoRotate
	local transparencySnaps = VfxHelper.capturePartTransparencies(victim)
	ScreenFeelHelper.setTint(victim, VfxHelper.chaosColor(), GameConstants.SW_RUNE_DURATION)
	ScreenFeelHelper.pulseCharacter(victim, {
		intensity = 0.22,
		duration = 0.4,
		fovScale = 0.18,
		vignetteScale = 0.45,
		tint = VfxHelper.chaosColor(),
		tintDuration = 0.5,
	})

	if kind == "fire" then
		local morph = VfxHelper.getScarletAsset("RuneDisplacement", "FireMorph")
		if morph then
			for _, inst in VfxHelper.attachRuneMorphFx(victim, morph) do
				VfxHelper.muteSounds(inst)
				table.insert(fx, inst)
			end
		end
		local headFx = attachRuneHeadFx(victim, "RuneFireAttachment")
		if headFx then
			table.insert(fx, headFx)
		end
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.UseJumpPower = true
		hum:Move(Vector3.zero, false)
		RagdollStatus.apply(victim)
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
		return {
			model = victim,
			kind = kind,
			fx = fx,
			bubble = nil,
			liftAlign = nil,
			liftAtt = nil,
			walk = walk,
			jump = jump,
			autoRotate = autoRotate,
			tickAcc = 0,
			nextLightning = 0,
			nextWander = 0,
			swirlSign = if math.random(1, 2) == 1 then 1 else -1,
			transparencySnaps = transparencySnaps,
		}
	elseif kind == "lightning" then
		local morph = VfxHelper.getScarletAsset("RuneDisplacement", "LightningMorph")
		if morph then
			for _, inst in VfxHelper.attachRuneMorphFx(victim, morph) do
				VfxHelper.muteSounds(inst)
				table.insert(fx, inst)
			end
		end
		local headFx = attachRuneHeadFx(victim, "RunesLightningAttachment")
		if headFx then
			table.insert(fx, headFx)
		end
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.UseJumpPower = true
		hum:Move(Vector3.zero, false)
		RagdollStatus.apply(victim)
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
		return {
			model = victim,
			kind = kind,
			fx = fx,
			bubble = nil,
			liftAlign = nil,
			liftAtt = nil,
			walk = walk,
			jump = jump,
			autoRotate = autoRotate,
			tickAcc = 0,
			nextLightning = 0,
			nextWander = 0,
			swirlSign = if math.random(1, 2) == 1 then 1 else -1,
			transparencySnaps = transparencySnaps,
		}
	else
		local headFx = attachRuneHeadFx(victim, "RuneWaterAttachment")
		if headFx then
			table.insert(fx, headFx)
		end
		bubble = placeBubbleAtHrp(victim)
		liftAtt = Instance.new("Attachment")
		liftAtt.Name = "SwRuneLiftAtt"
		liftAtt.Parent = root
		liftAlign = Instance.new("AlignPosition")
		liftAlign.Name = "SwRuneLift"
		liftAlign.Mode = Enum.PositionAlignmentMode.OneAttachment
		liftAlign.Attachment0 = liftAtt
		liftAlign.ApplyAtCenterOfMass = true
		liftAlign.RigidityEnabled = false
		liftAlign.Responsiveness = GameConstants.SW_RUNE_WATER_ALIGN_RESPONSIVENESS
		liftAlign.MaxForce = 1e6
		liftAlign.MaxVelocity = GameConstants.SW_RUNE_WATER_ALIGN_MAX_VELOCITY
		local startFloat = Vector3.new(root.Position.X, dest.Y + GameConstants.SW_RUNE_WATER_LIFT, root.Position.Z)
		liftAlign.Position = startFloat
		liftAlign.Parent = root
		local spinAlign = Instance.new("AlignOrientation")
		spinAlign.Name = "SwRuneTumble"
		spinAlign.Mode = Enum.OrientationAlignmentMode.OneAttachment
		spinAlign.Attachment0 = liftAtt
		spinAlign.RigidityEnabled = false
		spinAlign.Responsiveness = 5
		spinAlign.MaxTorque = 1e7
		spinAlign.MaxAngularVelocity = 3
		spinAlign.CFrame = root.CFrame.Rotation
		spinAlign.Parent = root
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.UseJumpPower = true
		local autoRotate = hum.AutoRotate
		hum.AutoRotate = false
		hum:Move(Vector3.zero, false)
		local spinRates = randomWaterSpinRates()
		local animTrack = playCharacterAnim(victim, GameConstants.SW_RUNE_WATER_ANIM, Enum.AnimationPriority.Action4)
		if animTrack then
			animTrack.Looped = true
		end
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
		return {
			model = victim,
			kind = kind,
			fx = fx,
			bubble = bubble,
			liftAlign = liftAlign,
			liftAtt = liftAtt,
			spinAlign = spinAlign,
			walk = walk,
			jump = jump,
			tickAcc = 0,
			nextLightning = 0,
			nextWander = waterWanderDelay(),
			spinRates = spinRates,
			spinGoal = randomWaterSpinRates(),
			nextSpinShift = waterSpinShiftDelay(),
			spinCFrame = root.CFrame.Rotation,
			wanderGoal = randomWaterFloatPos(dest),
			bubblePos = root.Position,
			animTrack = animTrack,
			autoRotate = autoRotate,
			transparencySnaps = transparencySnaps,
		}
	end

	return {
		model = victim,
		kind = kind,
		fx = fx,
		bubble = bubble,
		liftAlign = liftAlign,
		liftAtt = liftAtt,
		walk = walk,
		jump = jump,
		tickAcc = 0,
		nextLightning = 0,
		nextWander = waterWanderDelay(),
		transparencySnaps = transparencySnaps,
	}
end

local function castRuneDisplacement(player: Player, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	if runeFieldByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "rune_entrapment")
	if not entry or not canUse(character, entry.id, entry.energyCost) then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local dest = aimPoint or (root.Position + root.CFrame.LookVector * 22)
	dest = VfxHelper.snapToFloor(dest, { character })
	AbilityCooldownHelper.setActive(character, entry.id, true)
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	local castTrack = playCharacterAnim(character, GameConstants.SW_RUNE_CAST_ANIM, Enum.AnimationPriority.Action4)
	if castTrack then
		castTrack.Looped = false
	end
	local hum = CombatHelper.getHumanoid(character)
	local walk = GameConstants.DEFAULT_WALK_SPEED
	local jumpPower: number? = nil
	local jumpHeight: number? = nil
	local casterAutoRotate = true
	if hum then
		walk = hum.WalkSpeed
		casterAutoRotate = hum.AutoRotate
		if hum.UseJumpPower then
			jumpPower = hum.JumpPower
		else
			jumpHeight = hum.JumpHeight
		end
		hum.WalkSpeed = 0
		hum.AutoRotate = false
		hum.JumpPower = 0
		hum.UseJumpPower = true
		pcall(function()
			hum.JumpHeight = 0
		end)
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		end)
		hum:Move(Vector3.zero, false)
	end

	local faceAlign: AlignOrientation? = nil
	local faceAtt: Attachment? = nil
	if root then
		faceAtt = Instance.new("Attachment")
		faceAtt.Name = "SwRuneCasterFaceAtt"
		faceAtt.Parent = root
		faceAlign = Instance.new("AlignOrientation")
		faceAlign.Name = "SwRuneCasterFace"
		faceAlign.Mode = Enum.OrientationAlignmentMode.OneAttachment
		faceAlign.Attachment0 = faceAtt
		faceAlign.MaxTorque = math.huge
		faceAlign.Responsiveness = 18
		faceAlign.RigidityEnabled = false
		faceAlign.Parent = root
		local flat = Vector3.new(dest.X - root.Position.X, 0, dest.Z - root.Position.Z)
		if flat.Magnitude > 0.05 then
			faceAlign.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
		else
			faceAlign.CFrame = root.CFrame
		end
	end

	HandParticleHelper.beginUse(character)
	fireCameraShake(player, 0.42, 0.4, 0.34, 0.5)
	local zoneTemplate = VfxHelper.getScarletAsset("RuneDisplacement", "RuneDisplacement")
	local zone: Instance? = nil
	if zoneTemplate then
		zone = zoneTemplate:Clone()
		VfxHelper.muteSounds(zone)
		if zone:IsA("BasePart") then
			zone.Anchored = true
			zone.CanCollide = false
			zone.Parent = workspace
			setWorldPosKeepRot(zone, dest)
		elseif zone:IsA("Model") then
			zone.Parent = workspace
			setWorldPosKeepRot(zone, dest)
		elseif zone:IsA("Attachment") then
			local host = Instance.new("Part")
			host.Name = "SwRuneZoneHost"
			host.Size = Vector3.new(0.2, 0.2, 0.2)
			host.Transparency = 1
			host.Anchored = true
			host.CanCollide = false
			host.CFrame = CFrame.new(dest)
			host.Parent = workspace
			zone.Parent = host
			zone = host
		else
			zone.Parent = workspace
		end
		VfxHelper.setParticlesEnabled(zone, true)
		VfxHelper.emitAllParticles(zone, 16)
	end
	VfxHelper.playWorldSound(GameConstants.SW_RUNE_ENTRAPMENT_SOUND, dest, 1.05)

	local victims: { RuneVictimState } = {}
	for _, model in CombatHelper.overlapCharacters(dest, GameConstants.SW_RUNE_RADIUS, character) do
		if model:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "scarlet_witch" then
			continue
		end
		local applied = applyRuneToVictim(character, model, pickRuneKind(), dest)
		if applied then
			table.insert(victims, applied)
		end
	end

	local fieldState: RuneFieldState = {
		character = character,
		zone = zone,
		victims = victims,
		endsAt = os.clock() + GameConstants.SW_RUNE_DURATION,
		dest = dest,
		walk = walk,
		jumpPower = jumpPower,
		jumpHeight = jumpHeight,
		casterAutoRotate = casterAutoRotate,
		faceAlign = faceAlign,
		faceAtt = faceAtt,
	}
	runeFieldByPlayer[player] = fieldState
	if castTrack then
		castTrack.Ended:Once(function()
			if runeFieldByPlayer[player] == fieldState then
				stopRuneDisplacement(player, true)
			end
			castTrack:Destroy()
		end)
	end
	-- Safety fallback in case the animation cannot load or never reports completion.
	task.delay(GameConstants.SW_RUNE_DURATION, function()
		if runeFieldByPlayer[player] == fieldState then
			stopRuneDisplacement(player, true)
		end
	end)
end

local function updateRuneDisplacement(player: Player, dt: number)
	local state = runeFieldByPlayer[player]
	if not state then
		return
	end
	if os.clock() >= state.endsAt or not state.character.Parent then
		stopRuneDisplacement(player, true)
		return
	end
	local casterHum = CombatHelper.getHumanoid(state.character)
	if casterHum and casterHum.Parent then
		casterHum.WalkSpeed = 0
		casterHum.JumpPower = 0
	end
	updateRuneCasterFace(state)
	--[[ Pull fire/lightning victims into the rune center while swirling on the ground plane (X/Z). ]]
	local function swirlPullToRuneCenter(root: BasePart, swirlSign: number)
		local pos = root.Position
		local offset = Vector3.new(pos.X - state.dest.X, 0, pos.Z - state.dest.Z)
		local dist = offset.Magnitude
		local inward = Vector3.zero
		local tangent = Vector3.zero
		if dist > 0.2 then
			local radial = offset.Unit
			inward = -radial * GameConstants.SW_RUNE_PULL_SPEED
			tangent = Vector3.new(-radial.Z, 0, radial.X) * (swirlSign * GameConstants.SW_RUNE_SWIRL_SPEED)
			-- Keep a tight swirl near the center instead of locking still.
			if dist < 3 then
				inward *= dist / 3
				tangent = tangent.Unit * (GameConstants.SW_RUNE_SWIRL_SPEED * (0.55 + dist / 3))
			end
		else
			tangent = Vector3.new(swirlSign * GameConstants.SW_RUNE_SWIRL_SPEED, 0, 0)
		end
		local vel = inward + tangent
		root.AssemblyLinearVelocity = Vector3.new(vel.X, math.min(root.AssemblyLinearVelocity.Y, 2), vel.Z)
		root.AssemblyAngularVelocity = Vector3.new(
			swirlSign * 2.2,
			swirlSign * 4.5,
			swirlSign * 1.6
		)
	end
	local affected: { [Model]: boolean } = {}
	for _, victim in state.victims do
		affected[victim.model] = true
	end
	for _, model in CombatHelper.overlapCharacters(state.dest, GameConstants.SW_RUNE_RADIUS, state.character) do
		if not affected[model] and model:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "scarlet_witch" then
			local applied = applyRuneToVictim(state.character, model, pickRuneKind(), state.dest)
			if applied then
				table.insert(state.victims, applied)
				affected[model] = true
			end
		end
	end
	for _, victim in state.victims do
		local model = victim.model
		local hum = CombatHelper.getHumanoid(model)
		local vRoot = getRootPart(model)
		if not model.Parent or not hum or hum.Health <= 0 or not vRoot then
			continue
		end
		if victim.kind == "fire" then
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum:Move(Vector3.zero, false)
			if model:GetAttribute("Ragdolled") ~= true then
				RagdollStatus.apply(model)
			end
			swirlPullToRuneCenter(vRoot, victim.swirlSign or 1)
			victim.tickAcc += dt
			if victim.tickAcc >= 0.25 then
				local slice = victim.tickAcc
				victim.tickAcc = 0
				CombatHelper.dealDamage(state.character, model, GameConstants.SW_RUNE_FIRE_DPS * slice, vRoot.Position, "hex")
			end
		elseif victim.kind == "lightning" then
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum:Move(Vector3.zero, false)
			if model:GetAttribute("Ragdolled") ~= true then
				RagdollStatus.apply(model)
			end
			swirlPullToRuneCenter(vRoot, victim.swirlSign or 1)
			victim.nextLightning += dt
			if victim.nextLightning >= GameConstants.SW_RUNE_LIGHTNING_INTERVAL then
				victim.nextLightning = 0
				CombatHelper.dealDamage(state.character, model, GameConstants.SW_RUNE_LIGHTNING_DAMAGE, vRoot.Position, "hex")
			end
		elseif victim.kind == "water" then
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum.AutoRotate = false
			hum:Move(Vector3.zero, false)
			victim.nextWander -= dt
			if victim.nextWander <= 0 then
				victim.wanderGoal = randomWaterFloatPos(state.dest)
				victim.nextWander = waterWanderDelay()
			end
			-- Ease the align target toward the next float spot so the bubble glides instead of jumping.
			if victim.liftAlign and victim.liftAlign.Parent then
				local goal = victim.wanderGoal or victim.liftAlign.Position
				local blend = math.clamp(dt * GameConstants.SW_RUNE_WATER_DRIFT_RESPONSE, 0, 1)
				victim.liftAlign.Position = victim.liftAlign.Position:Lerp(goal, blend)
			end
			victim.nextSpinShift = (victim.nextSpinShift or waterSpinShiftDelay()) - dt
			if victim.nextSpinShift <= 0 then
				victim.spinGoal = randomWaterSpinRates()
				victim.nextSpinShift = waterSpinShiftDelay()
			end
			local rates = victim.spinRates or randomWaterSpinRates()
			local goalRates = victim.spinGoal or rates
			rates = rates:Lerp(goalRates, math.clamp(dt * GameConstants.SW_RUNE_WATER_SPIN_BLEND, 0, 1))
			victim.spinRates = rates
			local spinCFrame = victim.spinCFrame or vRoot.CFrame.Rotation
			spinCFrame *= CFrame.fromEulerAnglesXYZ(rates.X * dt, rates.Y * dt, rates.Z * dt)
			victim.spinCFrame = spinCFrame
			if victim.spinAlign and victim.spinAlign.Parent then
				victim.spinAlign.CFrame = spinCFrame
			end
		end
	end
end

local function getBlastMode(character: Model): string
	local mode = character:GetAttribute(GameConstants.HEX_BLAST_MODE_ATTRIBUTE)
	if mode == "Barrage" then
		return "Barrage"
	end
	return "Single"
end

local function getLeftHand(character: Model): BasePart?
	return (character:FindFirstChild("LeftHand")
		or character:FindFirstChild("Left Arm")
		or character:FindFirstChild("LeftLowerArm")) :: BasePart?
end

local function getRightHand(character: Model): BasePart?
	return (character:FindFirstChild("RightHand")
		or character:FindFirstChild("Right Arm")
		or character:FindFirstChild("RightLowerArm")) :: BasePart?
end

local function playCharacterAnim(character: Model, assetId: string, priority: Enum.AnimationPriority?): AnimationTrack?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = assetId
	local ok, track = pcall(function()
		return (animator :: Animator):LoadAnimation(anim)
	end)
	anim:Destroy()
	if not ok or not track then
		return nil
	end
	track.Priority = priority or Enum.AnimationPriority.Action
	track.Looped = false
	track:Play(0.1, 1, 1)
	return track
end

local function getOrigin(character: Model): Vector3
	local hand = getRightHand(character)
	if hand then
		return hand.Position
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if root then root.Position + Vector3.new(0, 1.5, 0) else Vector3.zero
end

local function flashBothHands(character: Model)
	local color = VfxHelper.chaosColor()
	local left = getLeftHand(character)
	local right = getRightHand(character)
	if left then
		VfxHelper.castHandFlash(left.Position, color)
	end
	if right then
		VfxHelper.castHandFlash(right.Position, color)
	end
	if not left and not right then
		VfxHelper.castHandFlash(getOrigin(character), color)
	end
end

local function fireHexBolt(player: Player, direction: Vector3, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "hex_bolt")
	if not entry or not canUse(character, entry.id, entry.energyCost) then
		return
	end
	local useRight = character:GetAttribute("SwBoltUseRight") ~= false
	character:SetAttribute("SwBoltUseRight", not useRight)
	local hand = if useRight then getRightHand(character) else getLeftHand(character)
	local origin = if hand then hand.Position else getOrigin(character)
	local dir = if direction.Magnitude > 0.01 then direction.Unit else character:GetPivot().LookVector
	if aimPoint then
		local toAim = aimPoint - origin
		if toAim.Magnitude > 0.05 then
			dir = toAim.Unit
		end
	end
	AbilityCooldownHelper.setActive(character, entry.id, true)
	HandParticleHelper.pulse(character, 0.4)
	playCharacterAnim(
		character,
		if useRight then GameConstants.IW_DISC_RIGHT_ANIM else GameConstants.IW_DISC_LEFT_ANIM,
		Enum.AnimationPriority.Action
	)
	fireCameraShake(player, 0.34, 0.22, 0.22, 0.35)
	task.delay(0.1, function()
		if not character.Parent or player.Character ~= character then
			AbilityCooldownHelper.setActive(character, entry.id, false)
			return
		end
		local liveHand = if useRight then getRightHand(character) else getLeftHand(character)
		local fireOrigin = if liveHand then liveHand.Position else getOrigin(character)
		local fireDir = dir
		if aimPoint then
			local toAim = aimPoint - fireOrigin
			if toAim.Magnitude > 0.05 then
				fireDir = toAim.Unit
			end
		end
		VfxHelper.playWorldSound(GameConstants.HEX_BOLT_SOUND, fireOrigin, 0.95)
		VfxHelper.castHandFlash(fireOrigin, VfxHelper.chaosColor())
		ProjectileHelper.spawn(fireOrigin, fireDir, {
			speed = GameConstants.HEX_BLAST_SPEED,
			damage = GameConstants.HEX_BOLT_DAMAGE,
			radius = GameConstants.HEX_BLAST_HIT_RADIUS,
			maxDistance = GameConstants.HEX_BLAST_RANGE,
			owner = character,
			color = VfxHelper.chaosColor(),
			homeDir = fireDir,
			homePoint = aimPoint or (fireOrigin + fireDir * math.min(70, GameConstants.HEX_BLAST_RANGE * 0.75)),
			homeAfter = 0.04,
			boltFolder = "ScarletWitchClassic",
			boltAsset = "Bolt",
			impactOnCharacter = true,
		})
		finishAbility(character, entry.id, entry.cooldown)
	end)
end

local function resolveTarget(
	character: Model,
	targetModel: Model?,
	direction: Vector3,
	range: number,
	lockOn: boolean?
): Model?
	-- Players and NPCs (any Model with a living Humanoid)
	if targetModel and targetModel.Parent and targetModel ~= character then
		local hum = targetModel:FindFirstChildOfClass("Humanoid")
		local root = getRootPart(targetModel)
		local casterRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hum and hum.Health > 0 and root and casterRoot then
			if (root.Position - casterRoot.Position).Magnitude <= range then
				return targetModel
			end
		end
	end
	if lockOn ~= true then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local dir = if direction.Magnitude > 0.01 then direction.Unit else root.CFrame.LookVector
	return CombatHelper.raycastCharacter(root.Position, dir, range, character)
end

-- Hex Blast

local function fireHexBlast(player: Player, direction: Vector3, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "hex_blast")
	if not entry or not canUse(character, entry.id, entry.energyCost) then
		return
	end

	local origin = getOrigin(character)
	local dir = if direction.Magnitude > 0.01 then direction.Unit else character:GetPivot().LookVector
	local homeDir = dir
	if aimPoint then
		local toAim = aimPoint - origin
		if toAim.Magnitude > 0.05 then
			homeDir = toAim.Unit
		end
	end
	local mode = getBlastMode(character)

	AbilityCooldownHelper.setActive(character, entry.id, true)
	HandParticleHelper.beginUse(character)
	flashBothHands(character)
	fireCameraShake(player, 0.36, 0.38, 0.22, 0.4)

	VfxHelper.castHandFlash(origin, VfxHelper.chaosColor())

	local cd = if mode == "Barrage"
		then GameConstants.HEX_BLAST_BARRAGE_COOLDOWN
		else GameConstants.HEX_BLAST_SINGLE_COOLDOWN

	if mode == "Single" then
		local isFlying = character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
		if isFlying then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				local animator = humanoid:FindFirstChildOfClass("Animator")
				if not animator then
					animator = Instance.new("Animator")
					animator.Parent = humanoid
				end
				-- Alternate flight cast anims (left/right hand) each shot
				local useAlt = character:GetAttribute("HexBlastFlightAnimAlt") == true
				character:SetAttribute("HexBlastFlightAnimAlt", not useAlt)
				local animId = if useAlt
					then GameConstants.HEX_BLAST_FLIGHT_ANIM_ALT
					else GameConstants.HEX_BLAST_FLIGHT_ANIM
				local anim = Instance.new("Animation")
				anim.AnimationId = animId
				local ok, track = pcall(function()
					return (animator :: Animator):LoadAnimation(anim)
				end)
				anim:Destroy()
				if ok and track then
					track.Priority = Enum.AnimationPriority.Action4
					track.Looped = false
					track:Play(0.08)
				end
			end
		end
		-- Wait briefly after cast anim so the bolt syncs with the hand motion
		task.delay(0.1, function()
			if not character.Parent or player.Character ~= character then
				AbilityCooldownHelper.setActive(character, entry.id, false)
				HandParticleHelper.endUse(character)
				return
			end
			local fireOrigin = getOrigin(character)
			VfxHelper.playWorldSound(GameConstants.HEX_BOLT_SOUND, fireOrigin, 0.95)
			ProjectileHelper.spawn(fireOrigin, homeDir, {
				speed = GameConstants.HEX_BLAST_SPEED,
				damage = GameConstants.HEX_BLAST_DAMAGE,
				radius = GameConstants.HEX_BLAST_HIT_RADIUS,
				maxDistance = GameConstants.HEX_BLAST_RANGE,
				owner = character,
				color = VfxHelper.chaosColor(),
				homeDir = homeDir,
				homePoint = aimPoint or (fireOrigin + homeDir * math.min(60, GameConstants.HEX_BLAST_RANGE * 0.7)),
				homeAfter = 0,
				seekUntilClose = true,
				seekCloseDistance = 2.2,
			})
			VfxHelper.spawnBeamLine(fireOrigin, fireOrigin + homeDir * 8, VfxHelper.chaosSoft(), 0.35, 0.16)
			finishAbility(character, entry.id, cd)
			task.delay(0.4, function()
				if character.Parent then
					HandParticleHelper.endUse(character)
				end
			end)
		end)
		return
	end

	-- Barrage: while flying play cast anim + 360 yaw spin; on ground just fire
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local isFlying = character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true

	local function releaseBarrageBolts()
		if not character.Parent then
			return
		end
		local fireOrigin = getOrigin(character)
		local count = GameConstants.HEX_BLAST_MULTI_COUNT
		local basis = CFrame.lookAt(Vector3.zero, homeDir)
		local right = basis.RightVector
		local up = basis.UpVector

		-- Spread/random scale from cursor distance (closer = tighter, farther = wider)
		local aimDist = if aimPoint then (aimPoint - fireOrigin).Magnitude else GameConstants.HEX_BLAST_BARRAGE_DIST_FAR * 0.65
		local distT = math.clamp(
			(aimDist - GameConstants.HEX_BLAST_BARRAGE_DIST_CLOSE)
				/ math.max(1, GameConstants.HEX_BLAST_BARRAGE_DIST_FAR - GameConstants.HEX_BLAST_BARRAGE_DIST_CLOSE),
			0,
			1
		)
		local outwardBase = GameConstants.HEX_BLAST_BARRAGE_OUTWARD_CLOSE
			+ (GameConstants.HEX_BLAST_BARRAGE_OUTWARD_FAR - GameConstants.HEX_BLAST_BARRAGE_OUTWARD_CLOSE) * distT
		local outwardJitter = GameConstants.HEX_BLAST_BARRAGE_OUTWARD_JITTER_CLOSE
			+ (GameConstants.HEX_BLAST_BARRAGE_OUTWARD_JITTER_FAR - GameConstants.HEX_BLAST_BARRAGE_OUTWARD_JITTER_CLOSE) * distT
		local angleJitter = math.rad(
			GameConstants.HEX_BLAST_BARRAGE_ANGLE_JITTER_CLOSE
				+ (GameConstants.HEX_BLAST_BARRAGE_ANGLE_JITTER_FAR - GameConstants.HEX_BLAST_BARRAGE_ANGLE_JITTER_CLOSE) * distT
		)
		local homeJitterDeg = GameConstants.HEX_BLAST_BARRAGE_HOME_JITTER_CLOSE
			+ (GameConstants.HEX_BLAST_BARRAGE_HOME_JITTER_FAR - GameConstants.HEX_BLAST_BARRAGE_HOME_JITTER_CLOSE) * distT
		local curveJitter = GameConstants.HEX_BLAST_BARRAGE_CURVE_JITTER_CLOSE
			+ (GameConstants.HEX_BLAST_BARRAGE_CURVE_JITTER_FAR - GameConstants.HEX_BLAST_BARRAGE_CURVE_JITTER_CLOSE) * distT

		local aimHome = aimPoint or (fireOrigin + homeDir * 60)
		-- Scatter end positions around the aim (not one shared lock point)
		local endScatter = 5 + distT * 12

		for i = 1, count do
			local baseAngle = ((i - 1) / count) * math.pi * 2
			local angle = baseAngle + (math.random() - 0.5) * angleJitter * 2
			local radial = (right * math.cos(angle) + up * math.sin(angle))
			if radial.Magnitude < 0.01 then
				radial = right
			else
				radial = radial.Unit
			end
			local outward = math.clamp(
				outwardBase + (math.random() - 0.5) * outwardJitter * 2,
				0.55,
				0.995
			)
			local spreadDir = (radial * outward + homeDir * (1 - outward))
			if spreadDir.Magnitude < 0.01 then
				spreadDir = radial
			else
				spreadDir = spreadDir.Unit
			end

			local homeJitter = CFrame.Angles(
				math.rad((math.random() - 0.5) * homeJitterDeg * 2),
				math.rad((math.random() - 0.5) * homeJitterDeg * 2),
				0
			)
			local boltHome = (CFrame.lookAt(Vector3.zero, homeDir) * homeJitter).LookVector
			local turnScale = 0.9 + math.random() * curveJitter

			-- Random end position near aim (sphere scatter), independent per bolt
			local scatterOffset = Vector3.new(
				(math.random() - 0.5) * 2,
				(math.random() - 0.5) * 1.4,
				(math.random() - 0.5) * 2
			)
			if scatterOffset.Magnitude < 0.05 then
				scatterOffset = right
			end
			local boltHomePoint = aimHome + scatterOffset.Unit * (math.random() * endScatter)

			task.delay((i - 1) * 0.02 + math.random() * 0.03, function()
				if not character.Parent then
					return
				end
				VfxHelper.playWorldSound(GameConstants.HEX_BOLT_SOUND, fireOrigin, 0.85)
				ProjectileHelper.spawn(fireOrigin, spreadDir, {
					speed = GameConstants.HEX_BLAST_BARRAGE_START_SPEED * (0.9 + math.random() * 0.2),
					damage = GameConstants.HEX_BLAST_BARRAGE_DAMAGE,
					radius = GameConstants.HEX_BLAST_BARRAGE_HIT_RADIUS,
					maxDistance = GameConstants.HEX_BLAST_BARRAGE_RANGE,
					owner = character,
					color = VfxHelper.chaosColor(),
					accel = GameConstants.HEX_BLAST_BARRAGE_ACCEL,
					maxSpeed = GameConstants.HEX_BLAST_BARRAGE_MAX_SPEED,
					homeDir = boltHome,
					homePoint = boltHomePoint,
					homeAfter = GameConstants.HEX_BLAST_BARRAGE_HOME_AFTER * (0.9 + math.random() * 0.2),
					homeTurnScale = turnScale,
					seekUntilClose = true,
					seekCloseDistance = 2.2,
					ragdollOnHit = GameConstants.RAGDOLL_BARRAGE_HIT_DURATION,
					pushOnHit = true,
					pushSpeed = GameConstants.HEX_BLAST_BARRAGE_PUSH_SPEED,
					pushUp = GameConstants.HEX_BLAST_BARRAGE_PUSH_UP,
				})
			end)
		end
		VfxHelper.spawnPulseRing(fireOrigin, 2.5, VfxHelper.chaosColor(), 0.28)
	end

	local function playBarrageCastAnim(): AnimationTrack?
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return nil
		end
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end
		local anim = Instance.new("Animation")
		anim.AnimationId = GameConstants.HEX_BLAST_BARRAGE_ANIM
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		anim:Destroy()
		if not ok or not track then
			return nil
		end
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = false
		track:Play(0.1)
		return track
	end

	if not isFlying or not root then
		releaseBarrageBolts()
		finishAbility(character, entry.id, cd)
		task.delay(0.4, function()
			if character.Parent then
				HandParticleHelper.endUse(character)
			end
		end)
		return
	end

	task.spawn(function()
		local track = playBarrageCastAnim()
		-- Capture full start pose (includes flight pitch/bank); spin in local yaw so pitch axis stays consistent
		local startCf = root.CFrame
		local startRot = startCf - startCf.Position
		local spinSign = if math.random() > 0.5 then 1 else -1
		local yawJitter = spinSign * math.rad((math.random() - 0.5) * 24)
		local totalDelta = spinSign * math.pi * 2 + yawJitter

		local spinTime = GameConstants.HEX_BLAST_BARRAGE_SPIN_TIME
		local releaseAt = GameConstants.HEX_BLAST_BARRAGE_RELEASE_AT
		local released = false
		local t0 = os.clock()

		character:SetAttribute("BarrageSpinActive", true)
		character:SetAttribute("BarrageSpinYaw", 0)

		local function applySpin(yaw: number)
			-- Local-Y spin on the flight pose: respects pitch/bank instead of tumbling around world Y
			local spun = CFrame.new(root.Position) * (startRot * CFrame.Angles(0, yaw, 0))
			local align = root:FindFirstChild("HeroAlignOrientation")
			if align and align:IsA("AlignOrientation") then
				align.CFrame = spun
			else
				root.CFrame = spun
			end
		end

		while character.Parent and root.Parent and (os.clock() - t0) < spinTime do
			local alpha = math.clamp((os.clock() - t0) / spinTime, 0, 1)
			local yaw = totalDelta * alpha
			character:SetAttribute("BarrageSpinYaw", yaw)
			applySpin(yaw)

			if not released and alpha >= releaseAt then
				released = true
				releaseBarrageBolts()
			end
			task.wait()
		end

		if character.Parent and root.Parent then
			character:SetAttribute("BarrageSpinYaw", totalDelta)
			applySpin(totalDelta)
			task.wait()
		end

		if character.Parent then
			character:SetAttribute("BarrageSpinActive", nil)
			character:SetAttribute("BarrageSpinYaw", nil)
		end
		if not released then
			releaseBarrageBolts()
		end
		if track then
			pcall(function()
				track:Stop(0.15)
				track:Destroy()
			end)
		end
		if character.Parent then
			finishAbility(character, entry.id, cd)
			task.delay(0.35, function()
				if character.Parent then
					HandParticleHelper.endUse(character)
				end
			end)
		end
	end)
end

-- Hex Beam (HexBeam at the hand, HexBeamEnd at the locked target)

local BEAM_FX_FADE = 2.0

local function cloneScarletInstance(...: string): Instance?
	local template = VfxHelper.getScarletAsset(...)
	if not template then
		return nil
	end
	return template:Clone()
end

local function firstAttachment(root: Instance): Attachment?
	if root:IsA("Attachment") then
		return root
	end
	return root:FindFirstChildWhichIsA("Attachment", true)
end

local function firstBeam(root: Instance): Beam?
	if root:IsA("Beam") then
		return root
	end
	return root:FindFirstChildWhichIsA("Beam", true)
end

local function collectBeams(root: Instance): { Beam }
	local list: { Beam } = {}
	if root:IsA("Beam") then
		table.insert(list, root)
	end
	for _, desc in root:GetDescendants() do
		if desc:IsA("Beam") then
			table.insert(list, desc)
		end
	end
	return list
end

local function prepFxPart(part: BasePart)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
end

local function fadeOutBeamFx(startHost: BasePart, tipHost: BasePart, startAtt: Attachment, endAtt: Attachment, beam: Beam?)
	VfxHelper.smoothDisableParticles(startHost, 0.4)
	VfxHelper.smoothDisableParticles(tipHost, 0.4)
	VfxHelper.smoothDisableParticles(startAtt, 0.4)
	VfxHelper.smoothDisableParticles(endAtt, 0.4)
	for _, b in collectBeams(startHost) do
		b.Enabled = false
	end
	for _, b in collectBeams(tipHost) do
		b.Enabled = false
	end
	if beam then
		beam.Enabled = false
	end
	task.delay(BEAM_FX_FADE, function()
		if startHost.Parent then
			startHost:Destroy()
		end
		if tipHost.Parent then
			tipHost:Destroy()
		end
	end)
end

local function destroyBeamFaceAligns(state: BeamState)
	if state.casterFace then
		state.casterFace:Destroy()
	end
	if state.casterFaceAtt then
		state.casterFaceAtt:Destroy()
	end
	if state.victimFace then
		state.victimFace:Destroy()
	end
	if state.victimFaceAtt then
		state.victimFaceAtt:Destroy()
	end
	state.casterFace = nil
	state.casterFaceAtt = nil
	state.victimFace = nil
	state.victimFaceAtt = nil
end

local function restoreVictimAfterBeam(state: BeamState)
	local victim = state.victim
	local vRoot = state.victimRoot
	if state.victimAnimTrack then
		state.victimAnimTrack:Stop(0.15)
		state.victimAnimTrack:Destroy()
		state.victimAnimTrack = nil
	end
	local vHum = CombatHelper.getHumanoid(victim)
	if vHum and vHum.Parent then
		vHum.WalkSpeed = state.victimWalk
		if state.victimJump ~= nil then
			vHum.JumpPower = state.victimJump
		end
		vHum.AutoRotate = state.victimAutoRotate
	end
	if vRoot and vRoot.Parent then
		local plr = Players:GetPlayerFromCharacter(victim)
		pcall(function()
			if plr then
				vRoot:SetNetworkOwner(plr)
			else
				vRoot:SetNetworkOwnershipAuto()
			end
		end)
	end
end

local function restoreBeamMovement(state: BeamState)
	local hum = CombatHelper.getHumanoid(state.character)
	if not hum then
		return
	end
	hum.WalkSpeed = state.walk
	if state.jumpPower ~= nil then
		hum.JumpPower = state.jumpPower
	end
	if state.jumpHeight ~= nil then
		hum.JumpHeight = state.jumpHeight
	end
	hum.AutoRotate = state.casterAutoRotate
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	end)
end

local function applyBeamMovement(state: BeamState)
	local hum = CombatHelper.getHumanoid(state.character)
	if not hum then
		return
	end
	hum.WalkSpeed = GameConstants.HEX_BEAM_WALK_SPEED
	hum.JumpPower = 0
	hum.UseJumpPower = true
	pcall(function()
		hum.JumpHeight = 0
	end)
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	end)
	hum.AutoRotate = false
end

local function knockBeamVictim(state: BeamState)
	local victim = state.victim
	local vRoot = state.victimRoot
	if not victim.Parent or not vRoot.Parent then
		return
	end
	local hum = CombatHelper.getHumanoid(victim)
	if not hum or hum.Health <= 0 then
		return
	end
	local casterRoot = state.character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local away = vRoot.Position - (if casterRoot then casterRoot.Position else vRoot.Position)
	local dir = if away.Magnitude > 0.05 then away.Unit else Vector3.new(0, 0, -1)
	RagdollStatus.applyTimed(victim, GameConstants.HEX_BEAM_END_RAGDOLL)
	pcall(function()
		vRoot:SetNetworkOwner(nil)
	end)
	local function shove()
		if not victim.Parent or not vRoot.Parent then
			return
		end
		PushHelper.applyToCharacter(victim, dir, {
			speed = GameConstants.HEX_BEAM_END_PUSH_SPEED,
			upBoost = GameConstants.HEX_BEAM_END_PUSH_UP,
			impulseMult = 1.25,
		})
		vRoot.AssemblyLinearVelocity = dir * GameConstants.HEX_BEAM_END_PUSH_SPEED
			+ Vector3.new(0, GameConstants.HEX_BEAM_END_PUSH_UP, 0)
	end
	shove()
	task.defer(shove)
end

local function finishHexBeamFx(state: BeamState, applyCooldown: boolean?)
	destroyBeamFaceAligns(state)
	knockBeamVictim(state)
	restoreBeamMovement(state)
	if state.victim.Parent then
		local vHum = CombatHelper.getHumanoid(state.victim)
		if vHum and vHum.Parent then
			vHum.WalkSpeed = state.victimWalk
			if state.victimJump ~= nil then
				vHum.JumpPower = state.victimJump
			end
		end
	end
	fadeOutBeamFx(state.startHost, state.tipHost, state.startAtt, state.endAtt, state.beam)
	if state.victimAnimTrack then
		state.victimAnimTrack:Stop(0.15)
		state.victimAnimTrack:Destroy()
		state.victimAnimTrack = nil
	end
	if state.animTrack then
		state.animTrack:Stop(0.15)
		state.animTrack:Destroy()
		state.animTrack = nil
	end
	local char = state.character
	if char.Parent then
		AbilityCooldownHelper.setActive(char, "hex_beam", false)
		if char:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
			char:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
		end
		HandParticleHelper.endUse(char, "Right")
		if applyCooldown then
			local entry = CharacterRegistry.getAbilityById("scarlet_witch", "hex_beam")
			if entry then
				AbilityCooldownHelper.applyAfterUse(char, entry.id, entry.cooldown)
			end
		end
	end
end

local function stopHexBeam(player: Player, applyCooldown: boolean?)
	local state = beamByPlayer[player]
	if not state then
		return
	end
	-- Stay locked in beam during clash (key release ignored)
	if state.character:GetAttribute(GameConstants.BEAM_CLASH_ATTRIBUTE) == true
		or BeamClashService.shouldKeepBeamAlive(state.character)
	then
		return
	end
	beamByPlayer[player] = nil
	finishHexBeamFx(state, applyCooldown)
end

function ScarletWitchService.forceStopBeam(player: Player, applyCooldown: boolean?)
	local state = beamByPlayer[player]
	if not state then
		return
	end
	beamByPlayer[player] = nil
	finishHexBeamFx(state, applyCooldown)
end

local function hexBeamTipInFront(origin: Vector3, victimPos: Vector3): Vector3
	local toVictim = victimPos - origin
	local dist = toVictim.Magnitude
	if dist < 0.15 then
		return victimPos
	end
	-- Sit 1 stud in front of the target (Wanda's side).
	return origin + toVictim.Unit * math.max(dist - GameConstants.HEX_BEAM_TIP_FRONT, 0.05)
end

local function makeBeamFaceAlign(root: BasePart, name: string): (AlignOrientation, Attachment)
	local att = Instance.new("Attachment")
	att.Name = name .. "Att"
	att.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Name = name
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.MaxTorque = math.huge
	align.Responsiveness = 18
	align.CFrame = root.CFrame
	align.Parent = root
	return align, att
end

local function beginHexBeamOnTarget(state: BeamState)
	local vHum = CombatHelper.getHumanoid(state.victim)
	local vRoot = state.victimRoot
	if vHum and vHum.Parent then
		vHum.WalkSpeed = 0
		vHum.JumpPower = 0
		vHum.UseJumpPower = true
		vHum.AutoRotate = false
	end
	if vRoot and vRoot.Parent then
		pcall(function()
			vRoot:SetNetworkOwner(nil)
		end)
	end
	if not state.casterFace then
		local casterRoot = state.character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if casterRoot then
			state.casterFace, state.casterFaceAtt = makeBeamFaceAlign(casterRoot, "HexBeamCasterFace")
		end
	end
	if not state.victimFace then
		state.victimFace, state.victimFaceAtt = makeBeamFaceAlign(vRoot, "HexBeamVictimFace")
	end
	if not state.victimAnimTrack and state.victim.Parent then
		local victimTrack = playCharacterAnim(
			state.victim,
			GameConstants.HEX_BEAM_TARGET_ANIM,
			Enum.AnimationPriority.Action4
		)
		if victimTrack then
			victimTrack.Looped = true
		end
		state.victimAnimTrack = victimTrack
	end
end

local function startHexBeam(player: Player, targetModel: Model?, direction: Vector3, lockOn: boolean?)
	local character = player.Character
	if not character or beamByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "hex_beam")
	if not entry then
		return
	end
	local hand = getRightHand(character)
	if not hand then
		return
	end

	local victim = resolveTarget(character, targetModel, direction, GameConstants.HEX_BEAM_RANGE, lockOn == true)
	if not victim then
		return
	end
	local victimRoot = getRootPart(victim)
	local victimHum = CombatHelper.getHumanoid(victim)
	local casterRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not victimRoot or not victimHum or victimHum.Health <= 0 or not casterRoot then
		return
	end
	if (victimRoot.Position - casterRoot.Position).Magnitude >= GameConstants.HEX_BEAM_BREAK_DISTANCE then
		return
	end
	if not canUse(character, entry.id, entry.energyCost) then
		return
	end

	local startClone = cloneScarletInstance("HexBeam", "HexBeam")
	local endClone = cloneScarletInstance("HexBeam", "HexBeamEnd")
	if not (startClone and startClone:IsA("BasePart") and endClone and endClone:IsA("BasePart")) then
		refundEnergy(character, entry.energyCost)
		warn("[ScarletWitch] Missing HexBeam.HexBeam / HexBeam.HexBeamEnd BaseParts")
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	HandParticleHelper.beginUse(character, "Right")
	local animTrack = playCharacterAnim(character, GameConstants.HEX_BEAM_ANIM, Enum.AnimationPriority.Action4)
	if animTrack then
		animTrack.Looped = false
	end

	local startHost = startClone :: BasePart
	prepFxPart(startHost)
	startHost.Name = "HexBeam"
	startHost.Anchored = false
	startHost.Massless = true
	startHost.CFrame = CFrame.lookAt(hand.Position, victimRoot.Position)
	startHost.Parent = hand
	local handWeld = Instance.new("Weld")
	handWeld.Name = "HexBeamHandWeld"
	handWeld.Part0 = hand
	handWeld.Part1 = startHost
	handWeld.C0 = hand.CFrame:ToObjectSpace(startHost.CFrame)
	handWeld.Parent = startHost

	local startAtt = firstAttachment(startHost)
	if not startAtt then
		startAtt = Instance.new("Attachment")
		startAtt.Name = "HexBeamAttachment"
		startAtt.Parent = startHost
	end

	local tipHost = endClone :: BasePart
	prepFxPart(tipHost)
	tipHost.Name = "HexBeamEnd"
	local initialTip = hand.Position
	tipHost.CFrame = CFrame.lookAt(initialTip, victimRoot.Position)
	tipHost.Parent = workspace

	local endAtt = firstAttachment(tipHost)
	if not endAtt then
		endAtt = Instance.new("Attachment")
		endAtt.Name = "HexBeamEndAtt"
		endAtt.Parent = tipHost
	end

	local beams = collectBeams(startHost)
	for _, extra in collectBeams(tipHost) do
		local seen = false
		for _, b in beams do
			if b == extra then
				seen = true
				break
			end
		end
		if not seen then
			table.insert(beams, extra)
		end
	end
	if #beams == 0 then
		local created = Instance.new("Beam")
		created.Name = "HexBeam"
		created.Width0 = 1.4
		created.Width1 = 1.1
		created.FaceCamera = true
		created.LightEmission = 0.7
		created.Color = ColorSequence.new(VfxHelper.chaosColor())
		created.Attachment0 = startAtt
		created.Parent = startHost
		table.insert(beams, created)
	end
	for _, liveBeam in beams do
		liveBeam.Attachment0 = startAtt
		liveBeam.Attachment1 = endAtt
		liveBeam.Enabled = false
	end
	local beam = beams[1]

	VfxHelper.setParticlesEnabled(startHost, false)
	VfxHelper.setParticlesEnabled(tipHost, false)

	local hum = CombatHelper.getHumanoid(character)
	local walk = GameConstants.DEFAULT_WALK_SPEED
	local jumpPower: number? = nil
	local jumpHeight: number? = nil
	local casterAuto = true
	if hum then
		walk = hum.WalkSpeed
		casterAuto = hum.AutoRotate
		if hum.UseJumpPower then
			jumpPower = hum.JumpPower
		else
			jumpHeight = hum.JumpHeight
		end
	end

	local victimWalk = victimHum.WalkSpeed
	local victimJump: number? = if victimHum.UseJumpPower then victimHum.JumpPower else nil
	local victimAuto = victimHum.AutoRotate

	local casterFace: AlignOrientation? = nil
	local casterFaceAtt: Attachment? = nil
	local victimFace: AlignOrientation? = nil
	local victimFaceAtt: Attachment? = nil

	beamByPlayer[player] = {
		character = character,
		startHost = startHost,
		handWeld = handWeld,
		tipHost = tipHost,
		startAtt = startAtt,
		endAtt = endAtt,
		beam = beam,
		victim = victim,
		victimRoot = victimRoot,
		startedAt = os.clock(),
		smoothedTip = initialTip,
		lastHit = 0,
		launched = false,
		reached = false,
		abilityStartedAt = nil,
		walk = walk,
		jumpPower = jumpPower,
		jumpHeight = jumpHeight,
		casterAutoRotate = casterAuto,
		victimWalk = victimWalk,
		victimJump = victimJump,
		victimAutoRotate = victimAuto,
		casterFace = casterFace,
		casterFaceAtt = casterFaceAtt,
		victimFace = victimFace,
		victimFaceAtt = victimFaceAtt,
		animTrack = animTrack,
		victimAnimTrack = nil,
	}
	applyBeamMovement(beamByPlayer[player] :: BeamState)
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	fireCameraShake(player, 0.32, 0.45, 0.2, 0.42)
end

local function moveToward(from: Vector3, to: Vector3, step: number): Vector3
	local delta = to - from
	if delta.Magnitude <= step then
		return to
	end
	return from + delta.Unit * step
end

local function lookFlat(root: BasePart): Vector3
	local pitch, yaw = root.CFrame:ToEulerAnglesYXZ()
	return CFrame.fromEulerAnglesYXZ(pitch, yaw, 0).LookVector
end

local function setBeamPartCFrame(part: BasePart, pos: Vector3, toward: Vector3)
	local delta = toward - pos
	if delta.Magnitude < 0.05 then
		part.CFrame = CFrame.new(pos) * part.CFrame.Rotation
		return
	end
	part.CFrame = CFrame.lookAt(pos, pos + delta.Unit)
end

local function endObjectHex(victim: Model)
	local state = objectHexByVictim[victim]
	if not state then
		return
	end
	objectHexByVictim[victim] = nil
	victim:SetAttribute(GameConstants.PROB_HEX_OBJECT_ATTRIBUTE, nil)
	victim:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, nil)
	if state.prop and state.prop.Parent then
		state.prop:Destroy()
	end
	VfxHelper.restoreCapturedParts(state.snaps, 0.25)
	NameplateService.setHidden(victim, false, 0.15)
	local hum = CombatHelper.getHumanoid(victim)
	if hum and hum.Parent then
		if state.displayType then
			hum.DisplayDistanceType = state.displayType
		end
		if state.walk ~= nil then
			hum.WalkSpeed = state.walk
		end
		if state.useJumpPower ~= nil then
			hum.UseJumpPower = state.useJumpPower
		end
		if state.jumpPower ~= nil then
			hum.JumpPower = state.jumpPower
		end
		if state.jumpHeight ~= nil then
			hum.JumpHeight = state.jumpHeight
		end
		if state.autoRotate ~= nil then
			hum.AutoRotate = state.autoRotate
		end
		if state.jumpingEnabled ~= nil then
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, state.jumpingEnabled)
			end)
		end
	end
	local root = getRootPart(victim)
	if root and root.Parent then
		root.AssemblyAngularVelocity = Vector3.zero
		local plr = Players:GetPlayerFromCharacter(victim)
		pcall(function()
			if plr then
				root:SetNetworkOwner(plr)
			else
				root:SetNetworkOwnershipAuto()
			end
		end)
	end
end

local function collectProbHexObjectTemplates(folder: Instance): { Instance }
	local templates: { Instance } = {}
	local function take(inst: Instance)
		if inst:IsA("Folder") then
			for _, child in inst:GetChildren() do
				take(child)
			end
		elseif inst:IsA("BasePart") or inst:IsA("Model") or inst:FindFirstChildWhichIsA("BasePart", true) then
			table.insert(templates, inst)
		end
	end
	for _, child in folder:GetChildren() do
		take(child)
	end
	return templates
end

local function applyObjectHex(victim: Model)
	endObjectHex(victim)
	local vRoot = getRootPart(victim)
	local folder = VfxHelper.getScarletAsset("ProbabilityHex", "Objects")
	if not vRoot or not folder then
		return false
	end
	local kids = collectProbHexObjectTemplates(folder)
	if #kids == 0 then
		return false
	end
	local template = kids[math.random(1, #kids)]
	local cloned = template:Clone()
	local prop: Instance = cloned
	if not cloned:IsA("BasePart") and not cloned:IsA("Model") then
		local wrapper = Instance.new("Model")
		wrapper.Name = "SwProbabilityObject"
		cloned.Parent = wrapper
		prop = wrapper
	end
	prop.Name = "SwProbabilityObject"
	-- Keep object upright; match only the victim's yaw facing.
	local _, yaw = vRoot.CFrame:ToEulerAnglesYXZ()
	local function harden(inst: Instance)
		if inst:IsA("BasePart") then
			inst.Anchored = false
			inst.CanCollide = false
			inst.CanQuery = false
			inst.CanTouch = false
			inst.Massless = true
		end
	end
	harden(prop)
	for _, desc in prop:GetDescendants() do
		harden(desc)
	end
	local primary: BasePart? = nil
	if prop:IsA("BasePart") then
		primary = prop
	elseif prop:IsA("Model") then
		local model = prop :: Model
		if model.PrimaryPart and model.PrimaryPart:IsA("BasePart") then
			primary = model.PrimaryPart
		else
			primary = model:FindFirstChildWhichIsA("BasePart", true)
			if primary then
				model.PrimaryPart = primary
			end
		end
	end
	if not primary then
		prop:Destroy()
		return false
	end
	for _, desc in prop:GetDescendants() do
		if desc:IsA("BasePart") and desc ~= primary then
			local join = Instance.new("WeldConstraint")
			join.Name = "SwProbabilityObjectWeld"
			join.Part0 = primary
			join.Part1 = desc
			join.Parent = desc
		end
	end
	local at = CFrame.new(vRoot.Position) * CFrame.Angles(0, yaw, 0)
	if prop:IsA("Model") then
		(prop :: Model):PivotTo(at)
	else
		primary.CFrame = at
	end
	prop.Parent = workspace
	local weld = Instance.new("WeldConstraint")
	weld.Name = "SwProbabilityWeld"
	weld.Part0 = vRoot
	weld.Part1 = primary
	weld.Parent = primary
	local hum = CombatHelper.getHumanoid(victim)
	local displayType: Enum.HumanoidDisplayDistanceType? = if hum then hum.DisplayDistanceType else nil
	local walk: number? = if hum then hum.WalkSpeed else nil
	local jumpPower: number? = if hum then hum.JumpPower else nil
	local jumpHeight: number? = if hum then hum.JumpHeight else nil
	local useJumpPower: boolean? = if hum then hum.UseJumpPower else nil
	local autoRotate: boolean? = if hum then hum.AutoRotate else nil
	local jumpingEnabled: boolean? = nil
	if hum then
		jumpingEnabled = hum:GetStateEnabled(Enum.HumanoidStateType.Jumping)
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.JumpHeight = 0
		hum.AutoRotate = false
		hum:Move(Vector3.zero, false)
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		end)
	end
	vRoot.AssemblyLinearVelocity = Vector3.zero
	vRoot.AssemblyAngularVelocity = Vector3.zero
	pcall(function()
		vRoot:SetNetworkOwner(nil)
	end)
	victim:SetAttribute(GameConstants.PROB_HEX_OBJECT_ATTRIBUTE, true)
	NameplateService.setHidden(victim, true, 0.08)
	local snaps = VfxHelper.captureVisibleParts(victim)
	VfxHelper.hideCapturedParts(snaps)
	objectHexByVictim[victim] = {
		victim = victim,
		prop = prop,
		snaps = snaps,
		look = Vector3.new(math.sin(-yaw), 0, -math.cos(-yaw)),
		endsAt = os.clock() + GameConstants.PROB_HEX_EFFECT_TIME,
		displayType = displayType,
		walk = walk,
		jumpPower = jumpPower,
		jumpHeight = jumpHeight,
		useJumpPower = useJumpPower,
		autoRotate = autoRotate,
		jumpingEnabled = jumpingEnabled,
	}
	return true
end

local function spawnProbHexExplosion(victim: Model)
	local host = (victim:FindFirstChild("UpperTorso") or victim:FindFirstChild("Torso") or getRootPart(victim)) :: BasePart?
	local template = VfxHelper.getScarletAsset("ProbabilityHex", "ExplosionAttachment")
	if not host or not template then
		return
	end
	local fx = template:Clone()
	fx.Name = "SwProbabilityExplosion"
	VfxHelper.muteSounds(fx)
	if fx:IsA("Attachment") then
		fx.Parent = host
	else
		fx.Parent = host
	end
	VfxHelper.setParticlesEnabled(fx, true)
	VfxHelper.emitAllParticles(fx, 18)
	VfxHelper.retireFxSmooth(fx, 0.45, 2.8)
end

local function applyProbabilityHit(player: Player, attacker: Model, victim: Model): string?
	if not victim.Parent then
		return nil
	end
	spawnProbHexExplosion(victim)
	-- Exclusive outcomes: object OR power strip, never both.
	endObjectHex(victim)
	local wantsObject = math.random() < 0.5
	if wantsObject then
		if applyObjectHex(victim) then
			victim:SetAttribute(
				GameConstants.POWERS_DISABLED_UNTIL,
				AbilityCooldownHelper.getNow() + GameConstants.PROB_HEX_EFFECT_TIME
			)
			return "object"
		end
		-- Never silently replace the randomly selected object result with power stripping.
		warn("[ScarletWitch] Probability Hex selected object, but ProbabilityHex.Objects has no usable object")
		return nil
	end
	victim:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, AbilityCooldownHelper.getNow() + GameConstants.PROB_HEX_EFFECT_TIME)
	local victimRoot = getRootPart(victim)
	local attackerRoot = getRootPart(attacker)
	if victimRoot then
		local away = victimRoot.Position - (if attackerRoot then attackerRoot.Position else victimRoot.Position)
		local dir = if away.Magnitude > 0.05 then away.Unit else Vector3.new(0, 0, -1)
		RagdollStatus.applyTimed(victim, GameConstants.PROB_HEX_STRIP_RAGDOLL)
		PushHelper.applyToCharacter(victim, dir, {
			speed = GameConstants.PROB_HEX_STRIP_PUSH_SPEED,
			upBoost = GameConstants.PROB_HEX_STRIP_PUSH_UP,
		})
	end
	return "powers_stripped"
end

local function detachProbHexWelds(state: ProbBeamState)
	if state.handWeld and state.handWeld.Parent then
		state.handWeld:Destroy()
	end
	state.handWeld = nil
	if state.torsoWeld and state.torsoWeld.Parent then
		state.torsoWeld:Destroy()
	end
	state.torsoWeld = nil
	if state.startHost.Parent and state.startHost.Parent ~= workspace then
		local worldCf = state.startHost.CFrame
		state.startHost.Anchored = true
		state.startHost.Parent = workspace
		state.startHost.CFrame = worldCf
	end
	if state.tipHost.Parent and state.tipHost.Parent ~= workspace then
		local worldCf = state.tipHost.CFrame
		state.tipHost.Anchored = true
		state.tipHost.Parent = workspace
		state.tipHost.CFrame = worldCf
	end
end

local function weldProbTipToTorso(state: ProbBeamState, aimPart: BasePart)
	if state.torsoWeld and state.torsoWeld.Parent then
		return
	end
	state.tipHost.Anchored = false
	state.tipHost.CFrame = CFrame.lookAt(aimPart.Position, state.hand.Position)
	state.tipHost.Parent = aimPart
	local torsoWeld = Instance.new("Weld")
	torsoWeld.Name = "ProbHexTorsoWeld"
	torsoWeld.Part0 = aimPart
	torsoWeld.Part1 = state.tipHost
	torsoWeld.C0 = aimPart.CFrame:ToObjectSpace(state.tipHost.CFrame)
	torsoWeld.Parent = state.tipHost
	state.torsoWeld = torsoWeld
	state.aimPart = aimPart
end

local function lockProbHexCaster(hum: Humanoid)
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.UseJumpPower = true
	pcall(function()
		hum.JumpHeight = 0
	end)
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	end)
	hum:Move(Vector3.zero, false)
end

local function restoreProbHexCaster(state: ProbBeamState)
	local hum = CombatHelper.getHumanoid(state.character)
	if not hum or not hum.Parent then
		return
	end
	hum.WalkSpeed = state.walk
	hum.UseJumpPower = state.useJumpPower
	hum.JumpPower = state.jumpPower
	if state.jumpHeight ~= nil then
		hum.JumpHeight = state.jumpHeight
	end
	hum.AutoRotate = state.casterAutoRotate
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	end)
	if state.character.Parent then
		state.character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
	end
	HandParticleHelper.endUse(state.character, "Left")
end

local function stopProbabilityHex(player: Player, applyCooldown: boolean?, hitVictim: Model?)
	local state = probBeamByPlayer[player]
	if not state then
		return
	end
	probBeamByPlayer[player] = nil
	detachProbHexWelds(state)
	fadeOutBeamFx(state.startHost, state.tipHost, state.startAtt, state.endAtt, state.beam)
	restoreProbHexCaster(state)
	local victimHum = CombatHelper.getHumanoid(state.victim)
	if victimHum and victimHum.Parent then
		victimHum.AutoRotate = state.victimAutoRotate
		victimHum.WalkSpeed = state.victimWalk
		victimHum.UseJumpPower = state.victimUseJumpPower
		victimHum.JumpPower = state.victimJumpPower
		victimHum.JumpHeight = state.victimJumpHeight
	end
	local victimRoot = getRootPart(state.victim)
	if victimRoot and victimRoot.Parent then
		local victimPlayer = Players:GetPlayerFromCharacter(state.victim)
		pcall(function()
			if victimPlayer then
				victimRoot:SetNetworkOwner(victimPlayer)
			else
				victimRoot:SetNetworkOwnershipAuto()
			end
		end)
	end
	local outcome: string? = nil
	if hitVictim then
		outcome = applyProbabilityHit(player, state.character, hitVictim)
		if outcome then
			Remotes.getEvent("ProbabilityHexResult"):FireClient(player, {
				outcome = outcome,
				targetName = hitVictim.Name,
				duration = GameConstants.PROB_HEX_EFFECT_TIME,
			})
		end
	end
	local char = state.character
	if char.Parent then
		AbilityCooldownHelper.setActive(char, "probability_hex", false)
		if applyCooldown then
			local cooldownSeconds = GameConstants.PROB_HEX_COOLDOWN_OBJECT
			if outcome == "powers_stripped" then
				cooldownSeconds = GameConstants.PROB_HEX_COOLDOWN_STRIP
			end
			AbilityCooldownHelper.applyAfterUse(char, "probability_hex", cooldownSeconds)
		end
	end
end

local function smoothlyFace(root: BasePart, targetPosition: Vector3, dt: number)
	local flatTarget = Vector3.new(targetPosition.X, root.Position.Y, targetPosition.Z)
	if (flatTarget - root.Position).Magnitude < 0.05 then
		return
	end
	local goal = CFrame.lookAt(root.Position, flatTarget)
	root.CFrame = root.CFrame:Lerp(goal, math.clamp(dt * 7, 0, 1))
end

local function updateObjectHexes()
	local now = os.clock()
	local dying: { Model } = {}
	for victim, state in objectHexByVictim do
		local hum = CombatHelper.getHumanoid(victim)
		if now >= state.endsAt or not victim.Parent or not hum or hum.Health <= 0 then
			table.insert(dying, victim)
		else
			VfxHelper.hideCapturedParts(state.snaps)
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum.JumpHeight = 0
			hum.AutoRotate = false
			hum:Move(Vector3.zero, false)
			local root = getRootPart(victim)
			if root then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
	for _, victim in dying do
		endObjectHex(victim)
	end
end

local function updateProbabilityHex(player: Player, dt: number)
	local state = probBeamByPlayer[player]
	if not state then
		return
	end
	local casterRoot = state.casterRoot
	if not state.character.Parent or not casterRoot.Parent or not state.hand.Parent then
		stopProbabilityHex(player, true, nil)
		return
	end
	local casterHum = CombatHelper.getHumanoid(state.character)
	if casterHum then
		lockProbHexCaster(casterHum)
	end

	local victim = state.victim
	local vRoot = getRootPart(victim)
	local vHum = CombatHelper.getHumanoid(victim)
	local victimOk = state.victimAlive
		and victim.Parent
		and vRoot ~= nil
		and vHum ~= nil
		and vHum.Health > 0

	if not victimOk and state.victimAlive then
		state.victimAlive = false
		if vRoot then
			state.lastEndPos = vRoot.Position
		end
		if state.torsoWeld and state.torsoWeld.Parent then
			state.lastEndPos = state.tipHost.Position
		end
		if state.launched and not state.reached and state.lastEndPos then
			state.reached = true
			state.channelStartedAt = os.clock()
			state.endPos = state.lastEndPos
		end
	end

	local now = os.clock()
	local aimPart = if victimOk then (getProbHexAimPart(victim) or vRoot) else nil
	local aimPos = if aimPart then aimPart.Position else (state.lastEndPos or state.endPos)

	if victimOk and aimPart then
		smoothlyFace(casterRoot, aimPart.Position, dt)
	elseif state.lastEndPos then
		smoothlyFace(casterRoot, state.lastEndPos, dt)
	end

	if state.handWeld and state.handWeld.Parent and not state.finishing then
		local lookTarget = aimPos
		local origin = state.hand.Position
		local look = if (lookTarget - origin).Magnitude > 0.08
			then CFrame.lookAt(origin, lookTarget)
			else CFrame.new(origin)
		state.handWeld.C0 = state.hand.CFrame:ToObjectSpace(look)
	end

	if not state.launched then
		state.startPos = state.hand.Position
		state.endPos = state.startPos
		if not state.finishing then
			setBeamPartCFrame(state.startHost, state.startPos, aimPos)
			setBeamPartCFrame(state.tipHost, state.endPos, aimPos)
		end
		if now - state.startedAt < GameConstants.PROB_HEX_START_DELAY then
			return
		end
		state.launched = true
		for _, liveBeam in state.beams do
			liveBeam.Enabled = true
		end
		VfxHelper.setParticlesEnabled(state.startHost, true)
		VfxHelper.setParticlesEnabled(state.tipHost, true)
		VfxHelper.emitAllParticles(state.startHost, 10)
		VfxHelper.emitAllParticles(state.tipHost, 10)
	end

	if not state.finishing then
		state.endPos = moveToward(state.endPos, aimPos, GameConstants.PROB_HEX_BEAM_SPEED * dt)
		state.lastEndPos = state.endPos
		if victimOk and aimPart and not state.reached and (state.endPos - aimPos).Magnitude <= GameConstants.PROB_HEX_REACH then
			state.reached = true
			state.channelStartedAt = now
			weldProbTipToTorso(state, aimPart)
			vHum.AutoRotate = false
			vHum.WalkSpeed = 0
			vHum.JumpPower = 0
			vHum.JumpHeight = 0
			vHum:Move(Vector3.zero, false)
			pcall(function()
				vRoot:SetNetworkOwner(nil)
			end)
			playCharacterAnim(victim, GameConstants.PROB_HEX_TARGET_ANIM, Enum.AnimationPriority.Action4)
		end
	end

	if not state.reached then
		if not state.finishing then
			setBeamPartCFrame(state.tipHost, state.endPos, state.hand.Position)
		end
		if now - state.startedAt >= 6 then
			stopProbabilityHex(player, true, nil)
		end
		return
	end

	if victimOk and vRoot and vHum then
		smoothlyFace(vRoot, casterRoot.Position, dt)
	end

	local elapsed = now - (state.channelStartedAt or now)
	if victimOk and vHum and vRoot and not state.finishing then
		local away = vRoot.Position - casterRoot.Position
		local flatAway = Vector3.new(away.X, 0, away.Z)
		if flatAway.Magnitude > 0.05 then
			local currentY = vRoot.AssemblyLinearVelocity.Y
			vRoot.AssemblyLinearVelocity =
				flatAway.Unit * GameConstants.PROB_HEX_PUSH_SPEED + Vector3.new(0, currentY, 0)
		end
		vHum.WalkSpeed = 0
		vHum.JumpPower = 0
		vHum.JumpHeight = 0
		vHum:Move(Vector3.zero, false)

		if elapsed < GameConstants.PROB_HEX_CHANNEL_TIME then
			state.damageAcc += dt
			if state.damageAcc >= 0.25 then
				local slice = state.damageAcc
				state.damageAcc = 0
				CombatHelper.dealDamage(
					state.character,
					victim,
					GameConstants.PROB_HEX_DAMAGE_PER_SEC * slice,
					vRoot.Position,
					"hex"
				)
			end
		end
	end

	if elapsed >= GameConstants.PROB_HEX_CHANNEL_TIME and not state.finishing then
		state.finishing = true
		if victimOk and vRoot then
			vRoot.AssemblyLinearVelocity = Vector3.new(0, vRoot.AssemblyLinearVelocity.Y, 0)
		end
		state.endPos = if state.torsoWeld and state.tipHost.Parent then state.tipHost.Position else (state.lastEndPos or state.endPos)
		state.startPos = state.startHost.Position
		detachProbHexWelds(state)
	end

	if state.finishing then
		state.startPos = moveToward(state.startPos, state.endPos, GameConstants.PROB_HEX_BEAM_SPEED * dt)
		setBeamPartCFrame(state.startHost, state.startPos, state.endPos)
		setBeamPartCFrame(state.tipHost, state.endPos, state.startPos)
		if (state.startPos - state.endPos).Magnitude <= GameConstants.PROB_HEX_REACH then
			stopProbabilityHex(player, true, if victimOk then victim else nil)
		end
	end
end

local function castProbabilityHex(player: Player, targetModel: Model?, direction: Vector3)
	local character = player.Character
	if not character or probBeamByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "probability_hex")
	if not entry then
		return
	end
	local victim = resolveTarget(character, targetModel, direction, GameConstants.PROB_HEX_RANGE, true)
	if not victim then
		return
	end
	local vRoot = getRootPart(victim)
	local hand = getLeftHand(character) or getRightHand(character)
	local casterRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local casterHum = CombatHelper.getHumanoid(character)
	local victimHum = CombatHelper.getHumanoid(victim)
	if not vRoot or not hand or not casterRoot or not casterHum or not victimHum then
		return
	end
	if not canUse(character, entry.id, entry.energyCost) then
		return
	end
	local startClone = cloneScarletInstance("HexBeam", "HexBeam")
	local endClone = cloneScarletInstance("HexBeam", "HexBeamEnd")
	if not (startClone and startClone:IsA("BasePart") and endClone and endClone:IsA("BasePart")) then
		refundEnergy(character, entry.energyCost)
		warn("[ScarletWitch] Missing HexBeam.HexBeam / HexBeam.HexBeamEnd for Probability Hex")
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	HandParticleHelper.beginUse(character, "Left")
	playCharacterAnim(character, GameConstants.PROB_HEX_CASTER_ANIM, Enum.AnimationPriority.Action4)
	fireCameraShake(player, 0.36, 0.4, 0.36, 0.45)
	local casterAutoRotate = casterHum.AutoRotate
	local casterWalk = casterHum.WalkSpeed
	local casterJumpPower = casterHum.JumpPower
	local casterJumpHeight = casterHum.JumpHeight
	local casterUseJumpPower = casterHum.UseJumpPower
	local victimAutoRotate = victimHum.AutoRotate
	local victimWalk = victimHum.WalkSpeed
	local victimJumpPower = victimHum.JumpPower
	local victimJumpHeight = victimHum.JumpHeight
	local victimUseJumpPower = victimHum.UseJumpPower
	casterHum.AutoRotate = false
	lockProbHexCaster(casterHum)

	local origin = hand.Position
	local aimPart = getProbHexAimPart(victim) or vRoot
	local startHost = startClone :: BasePart
	prepFxPart(startHost)
	startHost.Name = "ProbHexBeam"
	startHost.Anchored = false
	startHost.CFrame = CFrame.lookAt(origin, aimPart.Position)
	startHost.Parent = hand
	local handWeld = Instance.new("Weld")
	handWeld.Name = "ProbHexHandWeld"
	handWeld.Part0 = hand
	handWeld.Part1 = startHost
	handWeld.C0 = hand.CFrame:ToObjectSpace(startHost.CFrame)
	handWeld.Parent = startHost

	local startAtt = firstAttachment(startHost)
	if not startAtt then
		startAtt = Instance.new("Attachment")
		startAtt.Name = "ProbHexStartAtt"
		startAtt.Parent = startHost
	end

	local tipHost = endClone :: BasePart
	prepFxPart(tipHost)
	tipHost.Name = "ProbHexBeamEnd"
	tipHost.CFrame = CFrame.lookAt(origin, aimPart.Position)
	tipHost.Parent = workspace

	local endAtt = firstAttachment(tipHost)
	if not endAtt then
		endAtt = Instance.new("Attachment")
		endAtt.Name = "ProbHexEndAtt"
		endAtt.Parent = tipHost
	end

	local beams = collectBeams(startHost)
	for _, extra in collectBeams(tipHost) do
		local seen = false
		for _, b in beams do
			if b == extra then
				seen = true
				break
			end
		end
		if not seen then
			table.insert(beams, extra)
		end
	end
	if #beams == 0 then
		local created = Instance.new("Beam")
		created.Name = "ProbHexBeam"
		created.Width0 = 1.4
		created.Width1 = 1.1
		created.FaceCamera = true
		created.LightEmission = 0.7
		created.Color = ColorSequence.new(VfxHelper.chaosColor())
		created.Attachment0 = startAtt
		created.Parent = startHost
		table.insert(beams, created)
	end
	for _, liveBeam in beams do
		liveBeam.Attachment0 = startAtt
		liveBeam.Attachment1 = endAtt
		liveBeam.Enabled = false
	end
	VfxHelper.setParticlesEnabled(startHost, false)
	VfxHelper.setParticlesEnabled(tipHost, false)

	probBeamByPlayer[player] = {
		character = character,
		victim = victim,
		hand = hand,
		casterRoot = casterRoot,
		startHost = startHost,
		tipHost = tipHost,
		startAtt = startAtt,
		endAtt = endAtt,
		beam = beams[1],
		beams = beams,
		startPos = origin,
		endPos = origin,
		startedAt = os.clock(),
		launched = false,
		channelStartedAt = nil,
		reached = false,
		finishing = false,
		damageAcc = 0,
		casterAutoRotate = casterAutoRotate,
		victimAutoRotate = victimAutoRotate,
		victimWalk = victimWalk,
		victimJumpPower = victimJumpPower,
		victimJumpHeight = victimJumpHeight,
		victimUseJumpPower = victimUseJumpPower,
		handWeld = handWeld,
		torsoWeld = nil,
		aimPart = aimPart,
		walk = casterWalk,
		jumpPower = casterJumpPower,
		jumpHeight = casterJumpHeight,
		useJumpPower = casterUseJumpPower,
		victimAlive = true,
		lastEndPos = aimPart.Position,
	}
end

-- Shield: PartialShieldAttachment bursts toward hits (no visible bubble / no runes)

local function updateShieldHpUi(state: ShieldState)
	local ratio = if state.maxHp > 0 then math.clamp(state.hp / state.maxHp, 0, 1) else 0
	state.hpLabel.Text = string.format("%d/%d", math.ceil(state.hp), state.maxHp)
	state.hpFill.Size = UDim2.new(ratio, 0, 1, 0)
	if state.character.Parent then
		state.character:SetAttribute(GameConstants.SHIELD_HP_ATTRIBUTE, state.hp)
	end
end

local function createShieldHpBillboard(character: Model): (BillboardGui, TextLabel, Frame)
	local head = character:FindFirstChild("Head")
	local gui = Instance.new("BillboardGui")
	gui.Name = "ShieldHealthGui"
	gui.Size = GameConstants.SHIELD_UI_SIZE
	gui.StudsOffset = GameConstants.SHIELD_UI_OFFSET
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = GameConstants.NAMEPLATE_MAX_DISTANCE
	if head and head:IsA("BasePart") then
		gui.Adornee = head
	end
	gui.Parent = character

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Size = UDim2.fromScale(1, 1)
	track.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
	track.BorderSizePixel = 0
	track.Parent = gui

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(0.2, 0)
	trackCorner.Parent = track

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(190, 55, 90)
	fill.BorderSizePixel = 0
	fill.Parent = track

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.2, 0)
	fillCorner.Parent = fill

	local hpLabel = Instance.new("TextLabel")
	hpLabel.Name = "HpLabel"
	hpLabel.Size = UDim2.fromScale(1, 1)
	hpLabel.BackgroundTransparency = 1
	hpLabel.Font = Enum.Font.Bangers
	hpLabel.Text = "0/0"
	hpLabel.TextColor3 = Color3.fromRGB(245, 245, 248)
	hpLabel.TextScaled = true
	hpLabel.TextStrokeTransparency = 0.35
	hpLabel.ZIndex = 2
	hpLabel.Parent = track

	local textConstraint = Instance.new("UITextSizeConstraint")
	textConstraint.MaxTextSize = 18
	textConstraint.MinTextSize = 8
	textConstraint.Parent = hpLabel

	return gui, hpLabel, fill
end

local function disablePartialEmitters(shell: BasePart)
	VfxHelper.setParticlesEnabled(shell, false)
end

local function retirePartialShield(shell: BasePart)
	if not shell.Parent then
		return
	end
	disablePartialEmitters(shell)
	task.delay(GameConstants.SHIELD_PARTIAL_DELETE_DELAY, function()
		if shell.Parent then
			shell:Destroy()
		end
	end)
end

local function clearAllPartialShields(state: ShieldState)
	for _, shell in state.activePartials do
		if shell.Parent then
			retirePartialShield(shell)
		end
	end
	table.clear(state.activePartials)
end

local function spawnPartialShieldBurst(state: ShieldState, hitFrom: Vector3)
	local root = state.root
	if not root.Parent then
		return
	end

	local shell = VfxHelper.spawnPartialShieldShell(root, hitFrom, 10)
	if not shell then
		return
	end

	task.defer(function()
		if shell.Parent then
			VfxHelper.emitAllParticles(shell, 10)
		end
	end)

	table.insert(state.activePartials, shell)

	local char = state.character
	if char.Parent then
		Remotes.getUnreliableEvent("ShieldPartialHit"):FireAllClients(char, hitFrom)
	end

	state.partialToken += 1
	local token = state.partialToken
	local shellRef = shell

	task.delay(GameConstants.SHIELD_PARTIAL_EMIT_TIME, function()
		if not shellRef.Parent then
			return
		end
		disablePartialEmitters(shellRef)
		task.delay(GameConstants.SHIELD_PARTIAL_DELETE_DELAY, function()
			if shellRef.Parent then
				shellRef:Destroy()
			end
			for i = #state.activePartials, 1, -1 do
				if state.activePartials[i] == shellRef then
					table.remove(state.activePartials, i)
					break
				end
			end
		end)
		_ = token
	end)
end

local function stopShield(player: Player, applyCooldown: boolean?)
	local state = shieldByPlayer[player]
	if not state then
		return
	end
	shieldByPlayer[player] = nil

	if state.animTrack then
		state.animTrack:Stop(0.2)
		state.animTrack:Destroy()
		state.animTrack = nil
	end

	local char = state.character
	if char.Parent then
		char:SetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE, nil)
		char:SetAttribute(GameConstants.SHIELD_HP_ATTRIBUTE, nil)
		char:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
		AbilityCooldownHelper.setActive(char, "hex_shield", false)
		HandParticleHelper.endUse(char)
		local hum = CombatHelper.getHumanoid(char)
		if hum then
			hum.WalkSpeed = state.walk
			hum.AutoRotate = state.autoRotate
			if state.jumpPower ~= nil then
				hum.JumpPower = state.jumpPower
			end
			if state.jumpHeight ~= nil then
				pcall(function()
					hum.JumpHeight = state.jumpHeight :: number
				end)
			end
		end
		if applyCooldown then
			local entry = CharacterRegistry.getAbilityById("scarlet_witch", "hex_shield")
			if entry then
				AbilityCooldownHelper.applyAfterUse(char, entry.id, entry.cooldown)
			end
		end
	end

	if state.billboard.Parent then
		state.billboard:Destroy()
	end
	if state.visual and state.visual.Parent then
		VfxHelper.retireFxSmooth(state.visual, 0.45, 2.4)
	end
	clearAllPartialShields(state)
end

local function startShield(player: Player)
	local character = player.Character
	if not character or shieldByPlayer[player] then
		return
	end
	if TelekinesisService.isActive(player) then
		return
	end
	if regenByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "hex_shield")
	if not entry then
		return
	end
	if CombatHelper.arePowersDisabled(character) then
		return
	end
	if AbilityCooldownHelper.isOnCooldown(character, entry.id) then
		return
	end
	if not trySpendEnergy(character, entry.energyCost) then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	HandParticleHelper.beginUse(character)
	character:SetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE, true)
	fireCameraShake(player, 0.28, 0.4, 0.16, 0.38)

	local maxHp = GameConstants.SHIELD_MAX_HP
	character:SetAttribute(GameConstants.SHIELD_HP_ATTRIBUTE, maxHp)

	local visual: Instance? = nil
	local template = VfxHelper.getScarletAsset("HexShield", "Shield") or VfxHelper.getScarletAsset("Shield")
	if template then
		visual = template:Clone()
		visual.Name = "HexShield"
		local function prep(part: BasePart)
			part.Anchored = false
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
		end
		local shieldPart: BasePart? = nil
		if visual:IsA("BasePart") then
			prep(visual)
			shieldPart = visual
			visual.Parent = character
		else
			visual.Parent = character
			if visual:IsA("Model") then
				visual:PivotTo(root.CFrame)
			end
			local primary = if visual:IsA("Model")
				then (visual.PrimaryPart or visual:FindFirstChildWhichIsA("BasePart", true))
				else visual:FindFirstChildWhichIsA("BasePart", true)
			if primary and primary:IsA("BasePart") then
				for _, desc in visual:GetDescendants() do
					if desc:IsA("BasePart") then
						prep(desc)
					end
				end
				prep(primary)
				shieldPart = primary
			end
		end
		if shieldPart then
			local weld = Instance.new("Weld")
			weld.Name = "HexShieldWeld"
			weld.Part0 = root
			weld.Part1 = shieldPart
			-- Centered on the character. Mesh is authored flat / +Y; stand it up, then yaw 180.
			weld.C0 = CFrame.Angles(0, math.rad(180), 0) * CFrame.Angles(math.rad(-90), 0, 0)
			weld.Parent = shieldPart
		end
		VfxHelper.setParticlesEnabled(visual, true)
		VfxHelper.emitAllParticles(visual, 12)
	else
		warn("[ScarletWitch] Missing Assets.ScarletWitchClassic.HexShield.Shield")
	end

	local billboard, hpLabel, hpFill = createShieldHpBillboard(character)

	local hum = CombatHelper.getHumanoid(character)
	local walk = GameConstants.DEFAULT_WALK_SPEED
	local jumpPower: number? = nil
	local jumpHeight: number? = nil
	local autoRotate = true
	if hum then
		walk = hum.WalkSpeed
		autoRotate = hum.AutoRotate
		jumpPower = hum.JumpPower
		pcall(function()
			jumpHeight = hum.JumpHeight
		end)
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.UseJumpPower = true
		pcall(function()
			hum.JumpHeight = 0
		end)
		hum:Move(Vector3.zero, false)
	end
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)

	local animTrack = playCharacterAnim(character, GameConstants.SHIELD_ANIM, Enum.AnimationPriority.Action4)
	if animTrack then
		animTrack.Looped = true
	end

	local state: ShieldState = {
		character = character,
		root = root,
		visual = visual,
		activePartials = {},
		partialToken = 0,
		hp = maxHp,
		maxHp = maxHp,
		billboard = billboard,
		hpLabel = hpLabel,
		hpFill = hpFill,
		walk = walk,
		jumpPower = jumpPower,
		jumpHeight = jumpHeight,
		autoRotate = autoRotate,
		animTrack = animTrack,
	}
	updateShieldHpUi(state)
	shieldByPlayer[player] = state
end

function ScarletWitchService.damageShield(player: Player, amount: number, hitFrom: Vector3?): boolean
	local state = shieldByPlayer[player]
	if not state then
		return false
	end
	state.hp = math.max(0, state.hp - amount)
	updateShieldHpUi(state)
	if state.hp <= 0 then
		stopShield(player, true)
	end
	return true
end

function ScarletWitchService.damageShieldForCharacter(character: Model, amount: number, hitFrom: Vector3?): boolean
	local plr = Players:GetPlayerFromCharacter(character)
	if not plr then
		return false
	end
	return ScarletWitchService.damageShield(plr, amount, hitFrom)
end

local function applyHexTeleportExplosion(attacker: Model, origin: Vector3)
	local near = CombatHelper.overlapCharacters(origin, GameConstants.HEX_TELEPORT_EXPLOSION_RADIUS, attacker)
	if #near == 0 then
		return
	end
	local blastTime = GameConstants.HEX_TELEPORT_BLAST_TIME
	local tickSec = 0.12
	local slices = math.max(1, math.floor(blastTime / tickSec + 0.5))
	local damageSlice = GameConstants.HEX_TELEPORT_EXPLOSION_DAMAGE / slices
	task.spawn(function()
		local t0 = os.clock()
		local lastTick = t0
		local ticksLeft = slices
		while os.clock() - t0 < blastTime do
			for _, victim in near do
				if not victim.Parent then
					continue
				end
				local victimRoot = getRootPart(victim)
				if not victimRoot then
					continue
				end
				local push = victimRoot.Position - origin
				local away = Vector3.new(push.X, 0, push.Z)
				if away.Magnitude < 0.05 then
					away = Vector3.new(0, 0, -1)
				else
					away = away.Unit
				end
				PushHelper.applyToCharacter(victim, away, {
					speed = GameConstants.HEX_BEAM_PUSH_SPEED,
					upBoost = GameConstants.HEX_BEAM_PUSH_UP,
					impulseMult = 0.28,
				})
				local vel = victimRoot.AssemblyLinearVelocity
				victimRoot.AssemblyLinearVelocity = Vector3.new(
					away.X * GameConstants.HEX_BEAM_PUSH_SPEED,
					math.max(vel.Y, GameConstants.HEX_BEAM_PUSH_UP),
					away.Z * GameConstants.HEX_BEAM_PUSH_SPEED
				)
			end
			if os.clock() - lastTick >= tickSec and ticksLeft > 1 then
				lastTick = os.clock()
				ticksLeft -= 1
				for _, victim in near do
					if victim.Parent then
						CombatHelper.dealDamage(attacker, victim, damageSlice, origin, "explosion")
					end
				end
			end
			task.wait()
		end
		for _, victim in near do
			if not victim.Parent then
				continue
			end
			if ticksLeft > 0 then
				CombatHelper.dealDamage(attacker, victim, damageSlice * ticksLeft, origin, "explosion")
			end
			RagdollStatus.applyTimed(victim, GameConstants.HEX_TELEPORT_EXPLOSION_RAGDOLL)
			local victimRoot = getRootPart(victim)
			if victimRoot then
				local push = victimRoot.Position - origin
				if push.Magnitude < 0.05 then
					push = Vector3.new(0, 0, -1)
				end
				PushHelper.applyToCharacter(victim, push.Unit, {
					speed = GameConstants.HEX_TELEPORT_EXPLOSION_PUSH_SPEED,
					upBoost = GameConstants.HEX_TELEPORT_EXPLOSION_PUSH_UP,
				})
			end
		end
	end)
end

-- Teleportation (aim → click confirm)

local function clearWandaTeleportAim(character: Model?)
	if not character or not character.Parent then
		return
	end
	character:SetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE, nil)
	AbilityCooldownHelper.setActive(character, "hex_displacement", false)
end

local function beginWandaTeleportAim(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "hex_displacement")
	if not entry then
		return
	end
	if AbilityCooldownHelper.isOnCooldown(character, entry.id) then
		return
	end
	if CombatHelper.arePowersDisabled(character) or character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return
	end
	if character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true then
		return
	end
	if character:GetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE) == true then
		return
	end
	if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
		return
	end
	if character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true then
		clearWandaTeleportAim(character)
		return
	end
	character:SetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE, true)
	AbilityCooldownHelper.setActive(character, entry.id, true)
end

local function castTeleport(player: Player, direction: Vector3, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "hex_displacement")
	if not entry then
		return
	end

	local wasAiming = character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true
	if not wasAiming then
		return
	end

	if AbilityCooldownHelper.isOnCooldown(character, entry.id) then
		clearWandaTeleportAim(character)
		return
	end
	if CombatHelper.arePowersDisabled(character) then
		clearWandaTeleportAim(character)
		return
	end
	if not CharacterService.spendEnergy(character, entry.energyCost) then
		clearWandaTeleportAim(character)
		return
	end
	local owner = Players:GetPlayerFromCharacter(character)
	if owner then
		spendControl(owner, character, GameConstants.SW_CONTROL_CAST_COST)
	end

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		clearWandaTeleportAim(character)
		return
	end

	local fromPos = root.Position
	local dest: Vector3
	if aimPoint then
		local offset = aimPoint - fromPos
		if offset.Magnitude > GameConstants.TELEPORT_RANGE then
			offset = offset.Unit * GameConstants.TELEPORT_RANGE
		end
		dest = fromPos + offset
	else
		local dir = if direction.Magnitude > 0.01 then direction.Unit else root.CFrame.LookVector
		dest = fromPos + dir * math.min(GameConstants.TELEPORT_RANGE, 40)
	end
	local fromFx = VfxHelper.snapToFloor(fromPos, { character })
	local destFx = VfxHelper.snapToFloor(dest, { character })

	character:SetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE, nil)
	AbilityCooldownHelper.setActive(character, entry.id, true)
	HandParticleHelper.beginUse(character)
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)

	local hum = CombatHelper.getHumanoid(character)
	local savedWalk = if hum then hum.WalkSpeed else GameConstants.DEFAULT_WALK_SPEED
	local savedJump = if hum then hum.JumpPower else 50
	if hum then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum:Move(Vector3.zero, false)
	end

	local fromMark = VfxHelper.spawnHexTeleportMark(fromFx)
	local destMark = VfxHelper.spawnHexTeleportMark(destFx)
	VfxHelper.playWorldSound(GameConstants.HEX_TELEPORT_SOUND, fromFx, 1.05)
	fireCameraShake(player, 0.38, 0.55, 0.24, 0.5)
	local camEvent = Remotes.getEvent("HexDisplacementCam")
	local camRide: BasePart? = nil

	local function clearCam()
		camEvent:FireClient(player, nil)
		if camRide then
			local ride = camRide
			camRide = nil
			if ride.Parent then
				ride:Destroy()
			end
		end
	end

	local function finishMove(captured: any)
		if not character.Parent or not root.Parent then
			clearCam()
			HandParticleHelper.endUse(character)
			return
		end
		root.CFrame = CFrame.new(dest) * (root.CFrame - root.CFrame.Position)
		if hum and hum.Parent then
			hum.WalkSpeed = savedWalk
			hum.JumpPower = savedJump
		end
		applyHexTeleportExplosion(character, destFx)
		fireCameraShake(player, 0.48, 0.42, 0.3, 0.55)
		-- Restore camera only after the character is at the destination.
		clearCam()
		VfxHelper.restoreCapturedParts(captured, GameConstants.TELEPORT_FADE * 0.55, function()
			if character.Parent then
				character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
				finishAbility(character, entry.id, entry.cooldown)
				HandParticleHelper.endUse(character)
			end
		end)
		VfxHelper.retireFxSmooth(fromMark, 0.5, GameConstants.HEX_TELEPORT_FX_LIFE)
		VfxHelper.retireFxSmooth(destMark, 0.5, GameConstants.HEX_TELEPORT_FX_LIFE)
	end

	task.delay(0.18, function()
		if not character.Parent or not root.Parent then
			clearCam()
			return
		end
		local captured = VfxHelper.captureVisibleParts(character)
		VfxHelper.hideCapturedParts(captured)
		local _mover, ride = VfxHelper.playHexTeleportTravel(fromFx, destFx, function()
			finishMove(captured)
		end)
		camRide = ride
		if ride then
			camEvent:FireClient(player, ride, destFx)
		end
	end)
end

-- Regeneration (hold)

local function stopRegen(player: Player, applyCooldown: boolean?)
	local state = regenByPlayer[player]
	if not state then
		return
	end
	regenByPlayer[player] = nil

	local char = state.character
	VfxHelper.fadeOutAndDestroyParticles(state.particles, GameConstants.REGEN_PARTICLE_FADE, 3)

	if char.Parent then
		AbilityCooldownHelper.setActive(char, "regeneration", false)
		HandParticleHelper.endUse(char)
		if applyCooldown then
			local entry = CharacterRegistry.getAbilityById("scarlet_witch", "regeneration")
			if entry then
				AbilityCooldownHelper.applyAfterUse(char, entry.id, entry.cooldown)
			end
		end
	end
end

local function startRegen(player: Player)
	local character = player.Character
	if not character or regenByPlayer[player] then
		return
	end
	if HexFlightService.isFlying(player) or TelekinesisService.isActive(player) or shieldByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "regeneration")
	if not entry then
		return
	end
	if CombatHelper.arePowersDisabled(character) then
		return
	end
	if AbilityCooldownHelper.isOnCooldown(character, entry.id) then
		return
	end
	if AbilityCooldownHelper.isActive(character, entry.id) then
		return
	end

	local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
	if type(energy) ~= "number" or energy < 5 then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	HandParticleHelper.beginUse(character)
	CharacterService.markAbilityUse(character)
	fireCameraShake(player, 0.26, 0.5, 0.14, 0.36)

	local particles = VfxHelper.attachTelekinesisParticles(character)
	regenByPlayer[player] = {
		character = character,
		particles = particles,
	}
end

-- Disintegration: living targets under 10% HP, or Interactable props

local function dissolveInteractable(target: Instance, onDone: () -> ())
	if target:IsA("Model") then
		local pivot = target:GetPivot().Position
		VfxHelper.spawnImpact(pivot, VfxHelper.chaosColor(), 4)
		VfxHelper.fadePartsByHeight(target, 1, GameConstants.DISINTEGRATE_DURATION, true, function()
			if target.Parent then
				target:Destroy()
			end
			onDone()
		end)
	elseif target:IsA("BasePart") then
		VfxHelper.spawnImpact(target.Position, VfxHelper.chaosColor(), 4)
		TweenService:Create(
			target,
			TweenInfo.new(GameConstants.DISINTEGRATE_DURATION, Enum.EasingStyle.Sine),
			{ Transparency = 1, Size = target.Size * 0.2 }
		):Play()
		task.delay(GameConstants.DISINTEGRATE_DURATION, function()
			if target.Parent then
				target:Destroy()
			end
			onDone()
		end)
	else
		onDone()
	end
end

local function getUltimateMode(character: Model): string
	local mode = character:GetAttribute(GameConstants.ULTIMATE_MODE_ATTRIBUTE)
	if mode == "Absorption" then
		return "Absorption"
	end
	return "Disintegration"
end

local function cleanupAbsorbBeams(beams: { AbsorbBeamFx })
	for _, fx in beams do
		if fx.beam then
			fx.beam.Enabled = false
		end
		-- Smoothly fade particle rates, then keep disabled until delayed delete
		VfxHelper.smoothDisableParticles(fx.startAtt, GameConstants.ABSORB_PARTICLE_FADE)
		VfxHelper.smoothDisableParticles(fx.endAtt, GameConstants.ABSORB_PARTICLE_FADE)
		task.delay(GameConstants.ABSORB_PARTICLE_FADE, function()
			for _, desc in fx.startAtt:GetDescendants() do
				if desc:IsA("ParticleEmitter") then
					desc.Enabled = false
				end
			end
			for _, desc in fx.endAtt:GetDescendants() do
				if desc:IsA("ParticleEmitter") then
					desc.Enabled = false
				end
			end
		end)
		task.delay(GameConstants.ABSORB_PARTICLE_DELETE_DELAY, function()
			if fx.startAtt.Parent then
				fx.startAtt:Destroy()
			end
			if fx.endAtt.Parent then
				fx.endAtt:Destroy()
			end
			if fx.travelHost and fx.travelHost.Parent then
				fx.travelHost:Destroy()
			end
		end)
	end
end

local function destroyAbsorbConstraints(state: AbsorbState)
	if state.liftAlign and state.liftAlign.Parent then
		state.liftAlign:Destroy()
	end
	if state.liftAtt and state.liftAtt.Parent then
		state.liftAtt:Destroy()
	end
	if state.casterFace and state.casterFace.Parent then
		state.casterFace:Destroy()
	end
	if state.targetFace and state.targetFace.Parent then
		state.targetFace:Destroy()
	end
	if state.casterFaceAtt and state.casterFaceAtt.Parent then
		state.casterFaceAtt:Destroy()
	end
	if state.targetFaceAtt and state.targetFaceAtt.Parent then
		state.targetFaceAtt:Destroy()
	end
	state.liftAlign = nil
	state.liftAtt = nil
	state.casterFace = nil
	state.targetFace = nil
	state.casterFaceAtt = nil
	state.targetFaceAtt = nil
end

local function createAbsorbFaceAlign(root: BasePart, name: string): (AlignOrientation, Attachment)
	local att = Instance.new("Attachment")
	att.Name = name .. "Att"
	att.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Name = name
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.MaxTorque = math.huge
	align.Responsiveness = 16
	align.CFrame = root.CFrame
	align.Parent = root
	return align, att
end

local function createAbsorbLift(root: BasePart, pos: Vector3): (AlignPosition, Attachment)
	local att = Instance.new("Attachment")
	att.Name = "AbsorbLiftAtt"
	att.Parent = root
	local align = Instance.new("AlignPosition")
	align.Name = "AbsorbLiftAlign"
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.ApplyAtCenterOfMass = true
	align.RigidityEnabled = false
	align.Responsiveness = 8 -- smoother lift
	align.MaxForce = 1e6
	align.MaxVelocity = 18
	align.Position = pos
	align.Parent = root
	return align, att
end

local function stopPowerAbsorb(player: Player, applyCooldown: boolean?)
	local state = absorbByPlayer[player]
	if not state then
		return
	end
	absorbByPlayer[player] = nil
	cleanupAbsorbBeams(state.beams)
	destroyAbsorbConstraints(state)

	if state.targetHum.Parent then
		state.targetHum.WalkSpeed = state.prevTargetWalk
		state.targetHum.JumpPower = state.prevTargetJump
		state.targetHum.AutoRotate = state.prevTargetAutoRotate
	end
	if state.casterHum.Parent then
		state.casterHum.AutoRotate = state.prevCasterAutoRotate
	end

	local char = state.character
	if char.Parent then
		char:SetAttribute("AbsorbActive", nil)
		AbilityCooldownHelper.setActive(char, "ultimate", false)
		HandParticleHelper.endUse(char)
		if applyCooldown then
			local entry = CharacterRegistry.getAbilityById("scarlet_witch", "ultimate")
			if entry then
				AbilityCooldownHelper.applyAfterUse(char, entry.id, entry.cooldown)
			end
		end
	end
end

local function castPowerAbsorption(player: Player, direction: Vector3, targetModel: Model?)
	local character = player.Character
	if not character then
		return
	end
	if absorbByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "ultimate")
	if not entry or not canUse(character, entry.id, entry.energyCost) then
		return
	end
	if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
		refundEnergy(character, entry.energyCost)
		return
	end

	local casterRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local casterHum = CombatHelper.getHumanoid(character)
	if not casterRoot or not casterHum then
		refundEnergy(character, entry.energyCost)
		return
	end

	local dir = if direction.Magnitude > 0.01 then direction.Unit else character:GetPivot().LookVector
	local target = resolveTarget(character, targetModel, dir, GameConstants.DISINTEGRATE_RANGE)
	if not target or CombatHelper.isShielded(target) then
		refundEnergy(character, entry.energyCost)
		return
	end

	local targetHum = CombatHelper.getHumanoid(target)
	local targetRoot = getRootPart(target)
	if not targetHum or not targetRoot or targetHum.MaxHealth <= 0 then
		refundEnergy(character, entry.energyCost)
		return
	end
	if (targetHum.Health / targetHum.MaxHealth) > GameConstants.DISINTEGRATE_HP_THRESHOLD then
		refundEnergy(character, entry.energyCost)
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	HandParticleHelper.beginUse(character)
	CharacterService.markAbilityUse(character)
	character:SetAttribute("AbsorbActive", true)

	local prevTargetWalk = targetHum.WalkSpeed
	local prevTargetJump = targetHum.JumpPower
	local prevTargetAuto = targetHum.AutoRotate
	local prevCasterAuto = casterHum.AutoRotate

	targetHum.WalkSpeed = 0
	targetHum.JumpPower = 0
	targetHum.AutoRotate = false
	casterHum.AutoRotate = false

	local liftStart = targetRoot.Position
	local liftAlign, liftAtt = createAbsorbLift(targetRoot, liftStart)
	local casterFace, casterFaceAtt = createAbsorbFaceAlign(casterRoot, "AbsorbCasterFace")
	local targetFace, targetFaceAtt = createAbsorbFaceAlign(targetRoot, "AbsorbTargetFace")

	local startHealth = targetHum.Health
	local beams: { AbsorbBeamFx } = {}

	local rightHand = getRightHand(character)
	local leftHand = getLeftHand(character)
	local endParts: { BasePart } = {
		rightHand or casterRoot,
		casterRoot,
		leftHand or casterRoot,
	}

	local function pickTargetPart(index: number): BasePart
		local namesByIndex = {
			{ "Head", "UpperTorso", "Torso" },
			{ "UpperTorso", "Torso", "HumanoidRootPart" },
			{ "LeftHand", "Left Arm", "LeftLowerArm", "LowerTorso", "Torso" },
		}
		local names = namesByIndex[index] or namesByIndex[1]
		for _, name in names do
			local part = target:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				return part
			end
		end
		return targetRoot
	end

	local startJitter = {
		Vector3.new(0.35, 0.2, 0.1),
		Vector3.new(-0.25, 0.15, -0.2),
		Vector3.new(0.1, -0.2, 0.25),
	}

	for i = 1, GameConstants.ABSORB_BEAM_COUNT do
		local startAtt = cloneScarletAttachment("BeamStartAttachment")
		local endAtt = cloneScarletAttachment("BeamEndAttachment")
		if not startAtt or not endAtt then
			warn("[ScarletWitch] Missing BeamStartAttachment / BeamEndAttachment for Power Absorption")
			break
		end

		local startPart = pickTargetPart(i)
		startAtt.Name = "AbsorbBeamStart" .. tostring(i)
		startAtt.Position = startJitter[i] or Vector3.zero
		startAtt.Parent = startPart

		local startWorld = startPart.CFrame:PointToWorldSpace(startAtt.Position)
		local travelHost = Instance.new("Part")
		travelHost.Name = "AbsorbBeamTravel" .. tostring(i)
		travelHost.Anchored = true
		travelHost.CanCollide = false
		travelHost.CanQuery = false
		travelHost.CanTouch = false
		travelHost.Transparency = 1
		travelHost.Size = Vector3.new(0.2, 0.2, 0.2)
		travelHost.CFrame = CFrame.new(startWorld)
		travelHost.Parent = workspace

		local endPart = endParts[i] or casterRoot
		endAtt.Name = "AbsorbBeamEnd" .. tostring(i)
		endAtt.Position = Vector3.zero
		endAtt.Parent = travelHost

		local beam = startAtt:FindFirstChildWhichIsA("Beam", true)
		if beam then
			beam.Attachment0 = startAtt
			beam.Attachment1 = endAtt
			beam.CurveSize0 = 0
			beam.CurveSize1 = 0
			beam.Enabled = true
		end

		-- Disable "In" particle on beam start during absorption
		local inFx = startAtt:FindFirstChild("In", true)
		if inFx and inFx:IsA("ParticleEmitter") then
			inFx.Enabled = false
		end

		VfxHelper.setParticlesEnabled(startAtt, true)
		VfxHelper.setParticlesEnabled(endAtt, false)
		if inFx and inFx:IsA("ParticleEmitter") then
			inFx.Enabled = false
		end
		for _, desc in startAtt:GetDescendants() do
			if desc:IsA("ParticleEmitter") and desc.Name == "In" then
				desc.Enabled = false
			elseif desc:IsA("ParticleEmitter") then
				pcall(function()
					desc:Emit(4)
				end)
			end
		end

		table.insert(beams, {
			startAtt = startAtt,
			endAtt = endAtt,
			beam = beam,
			travelHost = travelHost,
			destPart = endPart,
			startWorld = startWorld,
			curve0Max = 2.5 + math.random() * (GameConstants.ABSORB_CURVE_MAX - 2.5),
			curve1Max = 2.5 + math.random() * (GameConstants.ABSORB_CURVE_MAX - 2.5),
			curve0Sign = if math.random() > 0.5 then 1 else -1,
			curve1Sign = if math.random() > 0.5 then 1 else -1,
			freq0 = 0.7 + math.random() * 2.8,
			freq1 = 0.6 + math.random() * 3.0,
			phase0 = math.random() * math.pi * 2,
			phase1 = math.random() * math.pi * 2,
			wander0 = 0.8 + math.random() * 2.6,
			wander1 = 0.8 + math.random() * 2.6,
			riseDelay = 0,
			riseSpan = GameConstants.ABSORB_BEAM_REACH_TIME,
		})
	end

	if #beams == 0 then
		refundEnergy(character, entry.energyCost)
		AbilityCooldownHelper.setActive(character, entry.id, false)
		HandParticleHelper.endUse(character)
		liftAlign:Destroy()
		liftAtt:Destroy()
		casterFace:Destroy()
		targetFace:Destroy()
		casterFaceAtt:Destroy()
		targetFaceAtt:Destroy()
		targetHum.WalkSpeed = prevTargetWalk
		targetHum.JumpPower = prevTargetJump
		targetHum.AutoRotate = prevTargetAuto
		casterHum.AutoRotate = prevCasterAuto
		return
	end

	absorbByPlayer[player] = {
		character = character,
		target = target,
		targetHum = targetHum,
		casterHum = casterHum,
		casterRoot = casterRoot,
		targetRoot = targetRoot,
		beams = beams,
		startHealth = startHealth,
		startedAt = os.clock(),
		reachTime = GameConstants.ABSORB_BEAM_REACH_TIME,
		beamsReached = false,
		drainStartedAt = nil,
		duration = GameConstants.ABSORB_DURATION,
		liftAlign = liftAlign,
		liftAtt = liftAtt,
		liftStartY = liftStart.Y,
		liftBaseX = liftStart.X,
		liftBaseZ = liftStart.Z,
		casterFace = casterFace,
		targetFace = targetFace,
		casterFaceAtt = casterFaceAtt,
		targetFaceAtt = targetFaceAtt,
		prevTargetWalk = prevTargetWalk,
		prevTargetJump = prevTargetJump,
		prevTargetAutoRotate = prevTargetAuto,
		prevCasterAutoRotate = prevCasterAuto,
	}
end

local function castDisintegration(
	player: Player,
	direction: Vector3,
	targetModel: Model?,
	aimPoint: Vector3?,
	interactable: Instance?
)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "ultimate")
	if not entry or not canUse(character, entry.id, entry.energyCost) then
		return
	end

	local origin = getOrigin(character)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local dir = if direction.Magnitude > 0.01 then direction.Unit else character:GetPivot().LookVector
	if aimPoint then
		local toAim = aimPoint - origin
		if toAim.Magnitude > 0.05 then
			dir = toAim.Unit
		end
	end

	-- Prefer living target under 10% HP â€” only the chosen victim dies
	local living = resolveTarget(character, targetModel, dir, GameConstants.DISINTEGRATE_RANGE)
	if living and not CombatHelper.isShielded(living) then
		if LokiService.tryReflect(character, living, "disintegrate") then
			refundEnergy(character, entry.energyCost)
			return
		end
		local hum = CombatHelper.getHumanoid(living)
		if hum and hum.MaxHealth > 0 and (hum.Health / hum.MaxHealth) <= GameConstants.DISINTEGRATE_HP_THRESHOLD then
			local tRoot = getRootPart(living)
			if tRoot then
				dir = (tRoot.Position - origin)
				if dir.Magnitude > 0.05 then
					dir = dir.Unit
				end
			end
			AbilityCooldownHelper.setActive(character, entry.id, true)
			character:SetAttribute(GameConstants.DISINTEGRATE_ACTIVE_ATTRIBUTE, true)
			HandParticleHelper.beginUse(character)
			local finished = false
			local function clearDisintegrate()
				if character.Parent then
					character:SetAttribute(GameConstants.DISINTEGRATE_ACTIVE_ATTRIBUTE, nil)
				end
			end
			local function dissolveLiving(victim: Model)
				if finished then
					return
				end
				if victim ~= living then
					return
				end
				finished = true
				local vRoot = getRootPart(victim)
				if vRoot then
					VfxHelper.spawnImpact(vRoot.Position, VfxHelper.chaosColor(), 5)
					VfxHelper.spawnBeamLine(origin, vRoot.Position, VfxHelper.chaosSoft(), 0.4, 0.2)
				end
				local humanoid = CombatHelper.getHumanoid(victim)
				if humanoid then
					humanoid.WalkSpeed = 0
					humanoid.JumpPower = 0
					humanoid.AutoRotate = false
				end
				VfxHelper.fadePartsByHeight(victim, 1, GameConstants.DISINTEGRATE_DURATION, true, function()
					if humanoid and humanoid.Parent then
						humanoid.Health = 0
					end
					clearDisintegrate()
					if character.Parent then
						finishAbility(character, entry.id, entry.cooldown)
						HandParticleHelper.endUse(character)
					end
				end)
			end
			ProjectileHelper.spawn(origin, dir, {
				speed = 120,
				damage = 0,
				radius = 1.25,
				maxDistance = GameConstants.DISINTEGRATE_RANGE,
				owner = character,
				color = VfxHelper.chaosColor(),
				onHit = function(victim: Model, _hitPos: Vector3)
					dissolveLiving(victim)
				end,
			})
			task.delay(0.45, function()
				if not finished and living.Parent then
					dissolveLiving(living)
				elseif not finished and character.Parent then
					clearDisintegrate()
					finishAbility(character, entry.id, entry.cooldown)
					HandParticleHelper.endUse(character)
				end
			end)
			return
		end
	end

	-- Interactable objects (no HP gate)
	local prop = interactable
	if not prop and root then
		prop = InteractableHelper.raycast(root.Position, dir, GameConstants.DISINTEGRATE_RANGE, character)
	end
	if prop then
		AbilityCooldownHelper.setActive(character, entry.id, true)
		character:SetAttribute(GameConstants.DISINTEGRATE_ACTIVE_ATTRIBUTE, true)
		HandParticleHelper.beginUse(character)
		dissolveInteractable(prop, function()
			if character.Parent then
				character:SetAttribute(GameConstants.DISINTEGRATE_ACTIVE_ATTRIBUTE, nil)
				finishAbility(character, entry.id, entry.cooldown)
				HandParticleHelper.endUse(character)
			end
		end)
		return
	end

	refundEnergy(character, entry.energyCost)
end

local function castUltimate(
	player: Player,
	direction: Vector3,
	targetModel: Model?,
	aimPoint: Vector3?,
	interactable: Instance?
)
	local character = player.Character
	if not character then
		return
	end
	if getUltimateMode(character) == "Absorption" then
		castPowerAbsorption(player, direction, targetModel)
	else
		castDisintegration(player, direction, targetModel, aimPoint, interactable)
	end
end

-- Fear Inducement: copy appears behind target while sliding right, returns while fading out

local function tweenCloneTransparency(clone: Model, toTransparency: number, duration: number)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	for _, desc in clone:GetDescendants() do
		if desc:IsA("BasePart") then
			if desc.Name == "HumanoidRootPart" then
				desc.Transparency = 1
			else
				TweenService:Create(desc, info, { Transparency = toTransparency }):Play()
			end
		elseif desc:IsA("Decal") or desc:IsA("Texture") then
			TweenService:Create(desc, info, { Transparency = toTransparency }):Play()
		elseif desc:IsA("Highlight") then
			TweenService:Create(desc, info, {
				FillTransparency = if toTransparency >= 1 then 1 else 0.55,
				OutlineTransparency = if toTransparency >= 1 then 1 else 0.2,
			}):Play()
		end
	end
end

local function castFear(player: Player, direction: Vector3, targetModel: Model?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("scarlet_witch", "fear_inducement")
	if not entry or not canUse(character, entry.id, entry.energyCost) then
		return
	end

	local target = resolveTarget(character, targetModel, direction, GameConstants.FEAR_RANGE)
	if not target or CombatHelper.isShielded(target) then
		refundEnergy(character, entry.energyCost)
		return
	end
	if LokiService.tryReflect(character, target, "fear") then
		refundEnergy(character, entry.energyCost)
		return
	end

	local tRoot = getRootPart(target)
	if not tRoot then
		refundEnergy(character, entry.energyCost)
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	HandParticleHelper.beginUse(character)

	-- Powers locked for FEAR_POWER_LOCK seconds (continues after movement unlock)
	target:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, AbilityCooldownHelper.getNow() + GameConstants.FEAR_POWER_LOCK)

	local targetHum = CombatHelper.getHumanoid(target)
	local savedWalk = if targetHum then targetHum.WalkSpeed else 16
	local savedJump = if targetHum then targetHum.JumpPower else 50
	local savedJumpHeight = if targetHum then targetHum.JumpHeight else 7.2
	local savedAutoRotate = if targetHum then targetHum.AutoRotate else true
	if targetHum then
		targetHum.WalkSpeed = 0
		targetHum.JumpPower = 0
		targetHum.JumpHeight = 0
		targetHum.AutoRotate = false
	end

	local function unlockTargetMove()
		if targetHum and targetHum.Parent then
			targetHum.WalkSpeed = savedWalk
			targetHum.JumpPower = savedJump
			targetHum.JumpHeight = savedJumpHeight
			targetHum.AutoRotate = savedAutoRotate
		end
	end

	local function finishFear()
		unlockTargetMove()
		if character.Parent then
			finishAbility(character, entry.id, entry.cooldown)
			HandParticleHelper.endUse(character)
		end
	end

	local ok, clone = pcall(function()
		local wasArchivable = character.Archivable
		character.Archivable = true
		local cloned = character:Clone()
		character.Archivable = wasArchivable
		return cloned
	end)
	if not ok or not clone or not clone:IsA("Model") then
		finishFear()
		return
	end

	-- Pure visual: exact look (no recolor), no humanoid/collision, strip VFX + nameplates
	for _, desc in clone:GetDescendants() do
		if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ModuleScript") or desc:IsA("Sound") then
			desc:Destroy()
		elseif desc:IsA("Humanoid") or desc:IsA("Animator") or desc:IsA("ControllerManager") then
			desc:Destroy()
		elseif desc.Name == "HandParticle"
			or desc.Name == "MCU_Nameplate"
			or desc.Name == "ShieldHealthGui"
			or desc:IsA("BillboardGui")
			or desc:IsA("ParticleEmitter")
			or desc:IsA("Trail")
			or desc:IsA("Beam")
			or desc:IsA("Highlight")
			or desc:IsA("ForceField")
		then
			desc:Destroy()
		elseif desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
			desc.CanQuery = false
			desc.CanTouch = false
			desc.CastShadow = false
			desc.Massless = true
		end
	end

	clone.Name = "FearClone"
	clone:SetAttribute("FearVisual", true)
	VfxHelper.setCharacterTransparency(clone, 1)

	local function behindOfTarget(): CFrame
		local root = getRootPart(target)
		if not root then
			return clone:GetPivot()
		end
		return root.CFrame * CFrame.new(0, 0, GameConstants.FEAR_CLONE_OFFSET)
	end

	local function rightOfTarget(): CFrame
		local root = getRootPart(target)
		if not root then
			return clone:GetPivot()
		end
		-- Closer step to the target's right; yaw flipped the other way (*-1)
		local yaw = math.rad(GameConstants.FEAR_SLIDE_YAW_DEG) * -1
		return root.CFrame
			* CFrame.new(GameConstants.FEAR_SLIDE_RIGHT, 0, GameConstants.FEAR_CLONE_OFFSET * 0.2)
			* CFrame.Angles(0, -yaw, 0)
	end

	clone:PivotTo(behindOfTarget())
	clone.Parent = workspace

	local function moveCloneLive(goalFn: () -> CFrame, duration: number)
		local start = clone:GetPivot()
		local t0 = os.clock()
		while clone.Parent and target.Parent and (os.clock() - t0) < duration do
			local alpha = math.clamp((os.clock() - t0) / duration, 0, 1)
			local smooth = alpha * alpha * (3 - 2 * alpha)
			clone:PivotTo(start:Lerp(goalFn(), smooth))
			task.wait()
		end
		if clone.Parent and target.Parent then
			clone:PivotTo(goalFn())
		end
	end

	task.spawn(function()
		if not clone.Parent or not target.Parent then
			if clone.Parent then
				clone:Destroy()
			end
			finishFear()
			return
		end

		-- 1) Appear while sliding from behind â†’ right (and yawing right)
		local appearTime = GameConstants.FEAR_APPEAR_TIME
		tweenCloneTransparency(clone, 0.12, appearTime)
		moveCloneLive(rightOfTarget, appearTime)

		if not clone.Parent or not target.Parent then
			if clone.Parent then
				clone:Destroy()
			end
			finishFear()
			return
		end

		-- Hold at the right pose
		task.wait(GameConstants.FEAR_HOLD_TIME)

		if not clone.Parent or not target.Parent then
			if clone.Parent then
				clone:Destroy()
			end
			finishFear()
			return
		end

		-- 2) Return behind while yawing back and fading out
		local returnTime = GameConstants.FEAR_RETURN_TIME
		tweenCloneTransparency(clone, 1, returnTime)
		moveCloneLive(behindOfTarget, returnTime)

		if clone.Parent then
			clone:Destroy()
		end
		finishFear()
	end)

	Debris:AddItem(
		clone,
		GameConstants.FEAR_APPEAR_TIME + GameConstants.FEAR_HOLD_TIME + GameConstants.FEAR_RETURN_TIME + 4
	)
end

local function setMode(player: Player, abilityId: string, mode: string)
	local character = player.Character
	if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "scarlet_witch" then
		return
	end
	if abilityId == "hex_blast" and (mode == "Single" or mode == "Barrage") then
		character:SetAttribute(GameConstants.HEX_BLAST_MODE_ATTRIBUTE, mode)
	elseif abilityId == "telekinesis" then
		-- Revamp: no TK modes
	elseif abilityId == "ultimate" and (mode == "Absorption" or mode == "Disintegration") then
		character:SetAttribute(GameConstants.ULTIMATE_MODE_ATTRIBUTE, mode)
	end
end

function ScarletWitchService.update(dt: number)
	local now = AbilityCooldownHelper.getNow()
	local dtClamped = math.clamp(dt, 0.001, 0.1)

	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character and character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "scarlet_witch" then
			updateChaosImpact(player, character, dtClamped)
			updateControl(player, character, dtClamped)
			updateRuneDisplacement(player, dtClamped)
			if character:GetAttribute(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE) == true then
				if beamByPlayer[player] then
					stopHexBeam(player, true)
				end
				if shieldByPlayer[player] then
					stopShield(player, true)
				end
				if TelekinesisService.isActive(player) then
					TelekinesisService.release(player)
				end
				if HexFlightService.isFlying(player) then
					HexFlightService.endFlight(player, true)
				end
				if probBeamByPlayer[player] then
					stopProbabilityHex(player, true, nil)
				end
			end
		else
			clearChaosFall(player)
		end
	end

	local beamPlayers: { Player } = {}
	for player in probBeamByPlayer do
		table.insert(beamPlayers, player)
	end
	for _, player in beamPlayers do
		updateProbabilityHex(player, dtClamped)
	end
	updateObjectHexes()

	for player, state in beamByPlayer do
		local char = state.character
		if not char.Parent or player.Character ~= char then
			stopHexBeam(player, true)
			continue
		end

		local victim = state.victim
		local vRoot = state.victimRoot
		local vHum = CombatHelper.getHumanoid(victim)
		if not victim.Parent or not vRoot.Parent or not vHum or vHum.Health <= 0 then
			stopHexBeam(player, true)
			continue
		end

		local casterRoot = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not casterRoot then
			stopHexBeam(player, true)
			continue
		end

		local hand = getRightHand(char)
		local origin = if hand then hand.Position else casterRoot.Position
		local now = os.clock()

		if not state.launched then
			state.smoothedTip = origin
			if state.handWeld and state.handWeld.Parent and hand then
				local look = if (vRoot.Position - origin).Magnitude > 0.08
					then CFrame.lookAt(origin, vRoot.Position)
					else CFrame.new(origin)
				state.handWeld.C0 = hand.CFrame:ToObjectSpace(look)
			end
			if state.tipHost.Parent then
				if (vRoot.Position - origin).Magnitude > 0.08 then
					state.tipHost.CFrame = CFrame.lookAt(origin, vRoot.Position)
				else
					state.tipHost.CFrame = CFrame.new(origin)
				end
			end
			if now - state.startedAt >= GameConstants.HEX_BEAM_START_DELAY then
				state.launched = true
				for _, liveBeam in collectBeams(state.startHost) do
					liveBeam.Enabled = true
				end
				for _, liveBeam in collectBeams(state.tipHost) do
					liveBeam.Enabled = true
				end
				if state.beam and not state.beam.Enabled then
					state.beam.Enabled = true
				end
				VfxHelper.setParticlesEnabled(state.startHost, true)
				VfxHelper.setParticlesEnabled(state.tipHost, true)
			end
			applyBeamMovement(state)
			continue
		end

		local desiredTip = hexBeamTipInFront(origin, vRoot.Position)
		if not state.reached then
			state.smoothedTip = moveToward(
				state.smoothedTip,
				desiredTip,
				GameConstants.HEX_BEAM_TRAVEL_SPEED * dtClamped
			)
			local tipPos = state.smoothedTip
			if state.handWeld and state.handWeld.Parent and hand then
				local look = if (tipPos - origin).Magnitude > 0.08
					then CFrame.lookAt(origin, tipPos)
					else CFrame.new(origin)
				state.handWeld.C0 = hand.CFrame:ToObjectSpace(look)
			end
			if state.tipHost.Parent then
				if (tipPos - origin).Magnitude > 0.08 then
					state.tipHost.CFrame = CFrame.lookAt(tipPos, origin)
				else
					state.tipHost.CFrame = CFrame.new(tipPos)
				end
			end
			if (state.smoothedTip - desiredTip).Magnitude <= GameConstants.HEX_BEAM_REACH then
				state.reached = true
				state.abilityStartedAt = now
				state.smoothedTip = desiredTip
				beginHexBeamOnTarget(state)
			end
			applyBeamMovement(state)
			continue
		end

		local abilityStart = state.abilityStartedAt or state.startedAt
		if now - abilityStart >= GameConstants.HEX_BEAM_DURATION then
			stopHexBeam(player, true)
			continue
		end
		if (vRoot.Position - casterRoot.Position).Magnitude >= GameConstants.HEX_BEAM_BREAK_DISTANCE then
			stopHexBeam(player, true)
			continue
		end

		local energy = char:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		if type(energy) ~= "number" or energy <= 0 then
			stopHexBeam(player, true)
			continue
		end
		char:SetAttribute(
			GameConstants.ENERGY_ATTRIBUTE,
			math.max(0, energy - GameConstants.HEX_BEAM_ENERGY_PER_SEC * dtClamped)
		)
		CharacterService.markAbilityUse(char)
		applyBeamMovement(state)

		local tipLerp = 1 - (1 - GameConstants.HEX_BEAM_TIP_LERP) ^ (dtClamped * 60)
		state.smoothedTip = state.smoothedTip:Lerp(desiredTip, tipLerp)
		local tipPos = state.smoothedTip

		local forcedTip = BeamClashService.getForcedBeamTip(char)
		if forcedTip then
			tipPos = forcedTip
			state.smoothedTip = forcedTip
		end

		if state.handWeld and state.handWeld.Parent and hand then
			local look = if (tipPos - origin).Magnitude > 0.08
				then CFrame.lookAt(origin, tipPos)
				else CFrame.new(origin)
			state.handWeld.C0 = hand.CFrame:ToObjectSpace(look)
		elseif state.startHost.Parent then
			if (tipPos - origin).Magnitude > 0.08 then
				state.startHost.CFrame = CFrame.lookAt(origin, tipPos)
			else
				state.startHost.CFrame = CFrame.new(origin)
			end
		end
		if state.tipHost.Parent then
			if (tipPos - origin).Magnitude > 0.08 then
				state.tipHost.CFrame = CFrame.lookAt(tipPos, origin)
			else
				state.tipHost.CFrame = CFrame.new(tipPos)
			end
		end
		if state.beam and not state.beam.Enabled then
			state.beam.Enabled = true
		end

		local toVictim = vRoot.Position - casterRoot.Position
		local flat = Vector3.new(toVictim.X, 0, toVictim.Z)
		if flat.Magnitude > 0.05 then
			local away = flat.Unit
			local casterLook = CFrame.lookAt(casterRoot.Position, casterRoot.Position + away)
			local victimLook = CFrame.lookAt(vRoot.Position, vRoot.Position - away)
			if state.casterFace and state.casterFace.Parent then
				state.casterFace.CFrame = casterLook
			end
			local flightAlign = casterRoot:FindFirstChild("HeroAlignOrientation")
			if flightAlign and flightAlign:IsA("AlignOrientation") then
				flightAlign.CFrame = casterLook
			end
			if state.victimFace and state.victimFace.Parent then
				state.victimFace.CFrame = victimLook
			end

			if char:GetAttribute(GameConstants.BEAM_CLASH_ATTRIBUTE) ~= true and not forcedTip then
				PushHelper.applyToCharacter(victim, away, {
					speed = GameConstants.HEX_BEAM_PUSH_SPEED,
					upBoost = GameConstants.HEX_BEAM_PUSH_UP,
					impulseMult = 0.28,
				})
				local vel = vRoot.AssemblyLinearVelocity
				vRoot.AssemblyLinearVelocity = Vector3.new(
					away.X * GameConstants.HEX_BEAM_PUSH_SPEED,
					math.max(vel.Y, GameConstants.HEX_BEAM_PUSH_UP),
					away.Z * GameConstants.HEX_BEAM_PUSH_SPEED
				)
			end
		end

		if now - state.lastHit >= 0.12 then
			state.lastHit = now
			if char:GetAttribute(GameConstants.BEAM_CLASH_ATTRIBUTE) == true or forcedTip then
				-- no tip damage while clashing
			else
				CombatHelper.dealDamage(char, victim, GameConstants.HEX_BEAM_DAMAGE_PER_SEC * 0.12, origin, "beam")
			end
		end
	end

	for player, state in shieldByPlayer do
		local char = state.character
		if not char.Parent or player.Character ~= char then
			stopShield(player, true)
			continue
		end
		local energy = char:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		if type(energy) ~= "number" or energy <= 0 then
			stopShield(player, true)
			continue
		end
		char:SetAttribute(
			GameConstants.ENERGY_ATTRIBUTE,
			math.max(0, energy - GameConstants.SHIELD_ENERGY_PER_SEC * dtClamped)
		)
		CharacterService.markAbilityUse(char)
		ProjectileHelper.deflectNearShield(char, 8)
		local hum = CombatHelper.getHumanoid(char)
		if hum then
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum:Move(Vector3.zero, false)
		end
		char:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	end

	for player, state in regenByPlayer do
		local char = state.character
		if not char.Parent or player.Character ~= char then
			stopRegen(player, true)
			continue
		end
		local energy = char:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		if type(energy) ~= "number" or energy <= 0 then
			stopRegen(player, true)
			continue
		end
		char:SetAttribute(
			GameConstants.ENERGY_ATTRIBUTE,
			math.max(0, energy - GameConstants.REGEN_ENERGY_PER_SEC * dtClamped)
		)
		CharacterService.markAbilityUse(char)
		local hum = CombatHelper.getHumanoid(char)
		if hum and hum.Health > 0 and hum.Health < hum.MaxHealth then
			hum.Health = math.min(hum.MaxHealth, hum.Health + GameConstants.REGEN_HEAL_PER_SEC * dtClamped)
		end
	end

	for player, state in absorbByPlayer do
		local char = state.character
		local target = state.target
		if not char.Parent or player.Character ~= char or not target.Parent or not state.targetHum.Parent then
			stopPowerAbsorb(player, true)
			continue
		end
		if state.targetHum.Health <= 0 then
			stopPowerAbsorb(player, true)
			continue
		end
		if not state.casterRoot.Parent or not state.targetRoot.Parent then
			stopPowerAbsorb(player, true)
			continue
		end

		local elapsed = os.clock() - state.startedAt
		local nowClock = os.clock()
		local casterPos = state.casterRoot.Position
		local targetPos = state.targetRoot.Position

		-- Smoothly face each other (flat yaw)
		local toTarget = targetPos - casterPos
		local flatToTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
		if flatToTarget.Magnitude > 0.05 then
			local casterLook = CFrame.lookAt(casterPos, casterPos + flatToTarget.Unit)
			local targetLook = CFrame.lookAt(targetPos, targetPos - flatToTarget.Unit)
			if state.casterFace and state.casterFace.Parent then
				state.casterFace.CFrame = casterLook
			end
			-- While flying, also write flight align so HexFlight doesn't fight us
			local flightAlign = state.casterRoot:FindFirstChild("HeroAlignOrientation")
			if flightAlign and flightAlign:IsA("AlignOrientation") then
				flightAlign.CFrame = casterLook
			end
			if state.targetFace and state.targetFace.Parent then
				state.targetFace.CFrame = targetLook
			end
		end

		-- Smooth lift over ABSORB_LIFT_TIME, then hold height
		if state.liftAlign and state.liftAlign.Parent then
			local liftT = math.clamp(elapsed / GameConstants.ABSORB_LIFT_TIME, 0, 1)
			local liftSmooth = liftT * liftT * (3 - 2 * liftT)
			local targetY = state.liftStartY + GameConstants.ABSORB_LIFT_HEIGHT * liftSmooth
			state.liftAlign.Position = Vector3.new(state.liftBaseX, targetY, state.liftBaseZ)
		end

		-- Animate beam tips from target â†’ caster over ABSORB_BEAM_REACH_TIME (distance-independent)
		local reachAlpha = math.clamp(elapsed / state.reachTime, 0, 1)
		local reachSmooth = reachAlpha * reachAlpha * (3 - 2 * reachAlpha)
		for _, fx in state.beams do
			if not state.beamsReached and fx.travelHost and fx.travelHost.Parent and fx.destPart.Parent then
				local destWorld = fx.destPart.Position
				local tipPos = fx.startWorld:Lerp(destWorld, reachSmooth)
				fx.travelHost.CFrame = CFrame.new(tipPos)
			end

			if fx.beam and fx.beam.Parent then
				local rise = if state.beamsReached then 1 else reachSmooth
				local wiggle0 = math.sin(nowClock * fx.freq0 + fx.phase0) * fx.wander0 * rise
				local wiggle1 = math.sin(nowClock * fx.freq1 + fx.phase1) * fx.wander1 * rise
				fx.beam.CurveSize0 = math.clamp(
					fx.curve0Sign * (rise * fx.curve0Max + wiggle0),
					-GameConstants.ABSORB_CURVE_MAX - 2,
					GameConstants.ABSORB_CURVE_MAX + 2
				)
				fx.beam.CurveSize1 = math.clamp(
					fx.curve1Sign * (rise * fx.curve1Max + wiggle1),
					-GameConstants.ABSORB_CURVE_MAX - 2,
					GameConstants.ABSORB_CURVE_MAX + 2
				)
			end
			local inFx = fx.startAtt:FindFirstChild("In", true)
			if inFx and inFx:IsA("ParticleEmitter") and inFx.Enabled then
				inFx.Enabled = false
			end
		end

		if not state.beamsReached and reachAlpha >= 1 then
			state.beamsReached = true
			state.drainStartedAt = os.clock()
			state.startHealth = state.targetHum.Health
			for _, fx in state.beams do
				if fx.destPart.Parent then
					fx.endAtt.Parent = fx.destPart
					fx.endAtt.Position = Vector3.zero
					VfxHelper.setParticlesEnabled(fx.endAtt, true)
					VfxHelper.emitAllParticles(fx.endAtt, 6)
				end
				if fx.travelHost and fx.travelHost.Parent then
					fx.travelHost:Destroy()
				end
				fx.travelHost = nil
			end
		end

		-- Drain / heal only after beams have reached the caster
		if state.beamsReached and state.drainStartedAt then
			local drainElapsed = os.clock() - state.drainStartedAt
			local u = math.clamp(drainElapsed / state.duration, 0, 1)
			local desiredHealth = state.startHealth * (1 - u)
			local before = state.targetHum.Health
			local nextHealth = math.max(0, math.min(before, desiredHealth))
			local drained = before - nextHealth
			if drained > 0 then
				state.targetHum.Health = nextHealth
				if state.casterHum.Parent and state.casterHum.Health > 0 then
					state.casterHum.Health = math.min(state.casterHum.MaxHealth, state.casterHum.Health + drained)
				end
			end

			if u >= 1 or state.targetHum.Health <= 0 then
				state.targetHum.Health = 0
				stopPowerAbsorb(player, true)
			end
		end
	end
end

function ScarletWitchService.handleAction(player: Player, payload: any)
	if type(payload) ~= "table" then
		return
	end
	local character = player.Character
	if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "scarlet_witch" then
		return
	end
	local action = payload.action
	if type(action) ~= "string" then
		return
	end

	local direction = if typeof(payload.direction) == "Vector3" then payload.direction else Vector3.new(0, 0, -1)
	local aimPoint = if typeof(payload.aimPoint) == "Vector3" then payload.aimPoint else nil
	local targetModel: Model? = nil
	if typeof(payload.target) == "Instance" and (payload.target :: Instance):IsA("Model") then
		targetModel = payload.target :: Model
	end
	local hitPart: BasePart? = nil
	if typeof(payload.hitPart) == "Instance" and (payload.hitPart :: Instance):IsA("BasePart") then
		hitPart = payload.hitPart :: BasePart
	end
	local interactable: Instance? = nil
	if typeof(payload.interactable) == "Instance" then
		interactable = payload.interactable :: Instance
	end

	if action == "SetMode" then
		if type(payload.abilityId) == "string" and type(payload.mode) == "string" then
			setMode(player, payload.abilityId, payload.mode)
		end
		return
	end

	if action == "F" then
		HexFlightService.toggleFlight(player)
	elseif action == "E_down" then
		local aim = aimPoint
			or (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and (player.Character.HumanoidRootPart :: BasePart).Position + direction * 20)
		if aim and TelekinesisService.tryStart(player, aim, targetModel, hitPart, payload.softLock == true) then
			fireCameraShake(player, 0.3, 0.4, 0.18, 0.4)
		end
	elseif action == "E_up" then
		TelekinesisService.release(player)
	elseif action == "E_update" then
		if aimPoint then
			TelekinesisService.updateAim(player, aimPoint)
		end
	elseif action == "E_scroll" then
		if type(payload.scroll) == "number" then
			TelekinesisService.adjustDistance(player, payload.scroll)
		end
		if aimPoint then
			TelekinesisService.updateAim(player, aimPoint)
		end
	elseif action == "E_throw" then
		TelekinesisService.throw(player, direction, aimPoint)
	elseif action == "T" or action == "T_down" then
		startHexBeam(player, targetModel, direction, payload.softLock == true)
	elseif action == "T_up" then
		-- Hex Beam is a one-shot; release does not cancel.
	elseif action == "T_aim" then
		-- Lock-on beam tracks the victim; mouse aim is ignored.
	elseif action == "C" or action == "C_down" then
		startShield(player)
	elseif action == "C_up" then
		stopShield(player, true)
	elseif action == "R" then
		fireHexBolt(player, direction, aimPoint)
	elseif action == "B_down" then
		startRegen(player)
	elseif action == "B_up" then
		stopRegen(player, true)
	elseif action == "V" then
		beginWandaTeleportAim(player)
	elseif action == "V_confirm" then
		castTeleport(player, direction, aimPoint)
	elseif action == "X" then
		castRuneDisplacement(player, aimPoint)
	elseif action == "G" then
		castProbabilityHex(player, targetModel, direction)
	end
end

function ScarletWitchService.tryHexDash(player: Player, moveWorld: Vector3): boolean
	-- Dash temporarily disabled
	return false
end


function ScarletWitchService.cancelAll(player: Player)
	ScarletWitchService.forceStopBeam(player, false)
	stopShield(player, false)
	stopRegen(player, false)
	stopRuneDisplacement(player, false)
	stopProbabilityHex(player, false, nil)
	stopPowerAbsorb(player, false)
	HexFlightService.endFlight(player, false)
	TelekinesisService.release(player)
	clearChaosFall(player)
	hexDashUntil[player] = nil
	hexDashCdUntil[player] = nil
	local char = player.Character
	if char then
		clearWandaTeleportAim(char)
		Remotes.getEvent("HexDisplacementCam"):FireClient(player, nil)
		Remotes.getEvent("SprintInput"):FireClient(player, { clearDash = true })
		local root = char:FindFirstChild("HumanoidRootPart")
		local dashLv = root and root:FindFirstChild("HexDashBoost")
		if dashLv then
			dashLv:Destroy()
		end
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health <= 0 then
			local RagdollService = require(script.Parent.RagdollService)
			RagdollService.apply(char)
		end
	end
end

function ScarletWitchService.getActiveBeamSegments(): {
	{
		id: string,
		kind: "player",
		player: Player,
		character: Model,
		origin: Vector3,
		tip: Vector3,
		label: string,
	}
}
	local list = {}
	for player, state in beamByPlayer do
		local char = state.character
		if char.Parent and player.Character == char then
			local origin = if state.startHost.Parent then state.startHost.Position else char:GetPivot().Position
			local tip = state.tipHost.Position
			table.insert(list, {
				id = "hex:" .. tostring(player.UserId),
				kind = "player" :: "player",
				player = player,
				character = char,
				origin = origin,
				tip = tip,
				label = player.DisplayName,
			})
		end
	end
	return list
end

function ScarletWitchService.init()
	CombatHelper.setShieldDamageHandler(function(character: Model, amount: number, hitFrom: Vector3?): boolean
		return ScarletWitchService.damageShieldForCharacter(character, amount, hitFrom)
	end)

	Remotes.getEvent("UseAbility").OnServerEvent:Connect(function(player: Player, payload: any)
		ScarletWitchService.handleAction(player, payload)
	end)

	local function hookPlayer(player: Player)
		player.CharacterRemoving:Connect(function()
			ScarletWitchService.cancelAll(player)
		end)
		player.CharacterAdded:Connect(function(character)
			local humanoid = character:WaitForChild("Humanoid", 5)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Died:Connect(function()
					ScarletWitchService.cancelAll(player)
				end)
			end
		end)
		if player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.Died:Connect(function()
					ScarletWitchService.cancelAll(player)
				end)
			end
		end
	end

	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end
	Players.PlayerAdded:Connect(hookPlayer)

	Players.PlayerRemoving:Connect(function(player)
		ScarletWitchService.cancelAll(player)
	end)
end

return ScarletWitchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">SprintService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CharacterService = require(script.Parent.CharacterService)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local SprintService = {}

local wantSprint: { [Player]: boolean } = {}
local lastSprintStop: { [Player]: number } = {}

function SprintService.update(dt: number)
	local dtClamped = math.clamp(dt, 0.001, 0.1)
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == nil then
			continue
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			continue
		end

		local stamina = character:GetAttribute(GameConstants.STAMINA_ATTRIBUTE)
		local maxStamina = character:GetAttribute(GameConstants.MAX_STAMINA_ATTRIBUTE)
		if type(stamina) ~= "number" or type(maxStamina) ~= "number" then
			continue
		end

		local blocked = CharacterService.isSprintBlocked(character)
		local trying = wantSprint[player] == true and not blocked and stamina > 0
		local moving = humanoid.MoveDirection.Magnitude > 0.05

		if trying and moving then
			character:SetAttribute(GameConstants.SPRINTING_ATTRIBUTE, true)
			humanoid.WalkSpeed = GameConstants.SPRINT_WALK_SPEED
			stamina = math.max(0, stamina - GameConstants.STAMINA_DRAIN_PER_SEC * dtClamped)
			character:SetAttribute(GameConstants.STAMINA_ATTRIBUTE, stamina)
			if stamina <= 0 then
				wantSprint[player] = false
				lastSprintStop[player] = os.clock()
			end
		else
			if character:GetAttribute(GameConstants.SPRINTING_ATTRIBUTE) == true then
				character:SetAttribute(GameConstants.SPRINTING_ATTRIBUTE, nil)
				lastSprintStop[player] = os.clock()
			end
			if not blocked then
				humanoid.WalkSpeed = GameConstants.DEFAULT_WALK_SPEED
			end
			local stoppedAt = lastSprintStop[player] or 0
			if (os.clock() - stoppedAt) >= GameConstants.STAMINA_REGEN_DELAY then
				if stamina < maxStamina then
					stamina = math.min(maxStamina, stamina + GameConstants.STAMINA_REGEN_PER_SEC * dtClamped)
					character:SetAttribute(GameConstants.STAMINA_ATTRIBUTE, stamina)
				end
			end
		end
	end
end

function SprintService.init()
	Remotes.getEvent("SprintInput").OnServerEvent:Connect(function(player: Player, payload: any)
		if type(payload) ~= "table" then
			return
		end
		if payload.dash == true then
			local mx = if type(payload.moveX) == "number" then payload.moveX else 0
			local mz = if type(payload.moveZ) == "number" then payload.moveZ else 0
			local move = Vector3.new(mx, 0, mz)
			if move.Magnitude < 0.05 then
				return
			end
			local ok, ScarletWitchService = pcall(function()
				return require(script.Parent.ScarletWitchService)
			end)
			if ok and ScarletWitchService and type(ScarletWitchService.tryHexDash) == "function" then
				ScarletWitchService.tryHexDash(player, move.Unit)
			end
			return
		end
		wantSprint[player] = payload.sprinting == true
		if payload.sprinting ~= true then
			lastSprintStop[player] = os.clock()
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		wantSprint[player] = nil
		lastSprintStop[player] = nil
	end)
end

return SprintService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">TelekinesisService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Hold E on cursor target to lift; target follows mouse at scrollable hold distance.
	Click to throw away from caster; release E to drop.
	Modes: Single, Multiple, Torture (locks caster walk, damages while held, head VFX).
	Held targets get Ragdolled status; release clears after 0.5s, throw after 3s.
	On ground, caster faces the lifted target. During flight, HexFlight owns rotation.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local PushHelper = require(ReplicatedStorage.Shared.PushHelper)
local ScreenFeelHelper = require(ReplicatedStorage.Shared.ScreenFeelHelper)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)
local CharacterService = require(script.Parent.CharacterService)
local HandParticleHelper = require(script.Parent.HandParticleHelper)
local RagdollService = require(script.Parent.RagdollService)
local LokiService = require(script.Parent.LokiService)

local TelekinesisService = {}

type HeldTarget = {
	root: BasePart,
	model: Model,
	humanoid: Humanoid,
	align: AlignPosition?,
	attach: Attachment?,
	offsetFromAnchor: Vector3,
	ownerParts: { BasePart },
	particles: { Instance },
	tortureHeadAtt: Instance?,
}

type TkState = {
	character: Model,
	casterRoot: BasePart,
	casterHumanoid: Humanoid,
	held: { HeldTarget },
	isMass: boolean,
	isTorture: boolean,
	cursorWorld: Vector3,
	holdDistance: number,
	smoothedHoldPoint: Vector3,
	lastDrain: number,
	lastTortureDamage: number,
	throwing: boolean,
	startedAt: number,
	faceAlign: AlignOrientation?,
	faceAttach: Attachment?,
	savedAutoRotate: boolean,
	savedWalkSpeed: number?,
	savedJumpPower: number?,
	savedJumpHeight: number?,
	casterWalkLocked: boolean,
	animTrack: AnimationTrack?,
}

local tkByPlayer: { [Player]: TkState } = {}

local function playTkAnim(character: Model, assetId: string, looped: boolean?): AnimationTrack?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = assetId
	local ok, track = pcall(function()
		return (animator :: Animator):LoadAnimation(anim)
	end)
	anim:Destroy()
	if not ok or not track then
		return nil
	end
	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = looped == true
	track:Play(0.08, 1, 1)
	return track
end

local function stopTkHoldAnim(state: TkState)
	if state.animTrack then
		state.animTrack:Stop(0.12)
		state.animTrack:Destroy()
		state.animTrack = nil
	end
end

function TelekinesisService.playThrowAnim(character: Model)
	playTkAnim(character, GameConstants.MG_PSI_BOLT_ANIM, false)
end

local function getMode(_character: Model): string
	return "Single"
end

local function lockCasterWalk(state: TkState)
	local humanoid = state.casterHumanoid
	if not humanoid.Parent then
		return
	end
	if not state.casterWalkLocked then
		state.savedWalkSpeed = humanoid.WalkSpeed
		state.savedJumpPower = humanoid.JumpPower
		local jumpH: number? = nil
		pcall(function()
			jumpH = humanoid.JumpHeight
		end)
		state.savedJumpHeight = jumpH
		state.casterWalkLocked = true
	end
	humanoid.WalkSpeed = GameConstants.TK_HOLD_WALK_SPEED
	humanoid.JumpPower = 0
	pcall(function()
		humanoid.JumpHeight = 0
	end)
	pcall(function()
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	end)
end

local function unlockCasterWalk(state: TkState)
	if not state.casterWalkLocked then
		return
	end
	state.casterWalkLocked = false
	local humanoid = state.casterHumanoid
	if not humanoid.Parent then
		return
	end
	if type(state.savedWalkSpeed) == "number" then
		humanoid.WalkSpeed = state.savedWalkSpeed
	end
	if type(state.savedJumpPower) == "number" then
		humanoid.JumpPower = state.savedJumpPower
	end
	if type(state.savedJumpHeight) == "number" then
		pcall(function()
			humanoid.JumpHeight = state.savedJumpHeight :: number
		end)
	end
	pcall(function()
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	end)
	state.savedWalkSpeed = nil
	state.savedJumpPower = nil
	state.savedJumpHeight = nil
end

local function attachTortureHead(model: Model): Instance?
	local head = model:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		return nil
	end
	local template = VfxHelper.getScarletAsset("TortureHeadAttachment")
	if not template then
		warn("[Telekinesis] Missing Assets.ScarletWitch.TortureHeadAttachment")
		return nil
	end
	local clone: Instance
	if template:IsA("Attachment") then
		clone = template:Clone()
	else
		local nested = template:FindFirstChildWhichIsA("Attachment", true)
		if nested then
			clone = nested:Clone()
		else
			clone = template:Clone()
		end
	end
	clone.Name = "TortureHeadAttachment"
	clone.Parent = head
	VfxHelper.setParticlesEnabled(clone, true)
	VfxHelper.emitAllParticles(clone, 8)
	return clone
end

local function clearTortureHead(target: HeldTarget)
	if target.tortureHeadAtt and target.tortureHeadAtt.Parent then
		VfxHelper.setParticlesEnabled(target.tortureHeadAtt, false)
		target.tortureHeadAtt:Destroy()
	end
	target.tortureHeadAtt = nil
end

local function createHoldAlign(root: BasePart, initialPos: Vector3): (AlignPosition, Attachment)
	local att = Instance.new("Attachment")
	att.Name = "TKHoldAttachment"
	att.Parent = root
	local align = Instance.new("AlignPosition")
	align.Name = "TKHoldAlign"
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.RigidityEnabled = false
	align.Responsiveness = GameConstants.TK_HOLD_ALIGN_RESPONSIVENESS
	align.MaxForce = GameConstants.TK_HOLD_MAX_FORCE
	align.MaxVelocity = GameConstants.TK_HOLD_SPEED
	-- Pull at the grabbed body part
	align.ApplyAtCenterOfMass = true
	align.Position = initialPos
	align.Parent = root
	return align, att
end

local function isAccessoryPart(part: BasePart): boolean
	local parent = part.Parent
	return parent ~= nil and parent:IsA("Accessory")
end

local function resolveGrabPart(model: Model, _preferred: BasePart?): BasePart
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") and not isAccessoryPart(child) then
			return child
		end
	end
	error("character has no grab part")
end

local function clearTkParticles(target: HeldTarget)
	if #target.particles > 0 then
		VfxHelper.fadeOutAndDestroyParticles(target.particles, 0.45, 2.5)
	end
	table.clear(target.particles)
end

local function attachTkParticles(model: Model): { Instance }
	return VfxHelper.attachTelekinesisParticles(model)
end

local function createFaceAlign(root: BasePart): (AlignOrientation, Attachment)
	local att = root:FindFirstChild("TKCasterFaceAttachment")
	if not (att and att:IsA("Attachment")) then
		att = Instance.new("Attachment")
		att.Name = "TKCasterFaceAttachment"
		att.Parent = root
	end
	local align = Instance.new("AlignOrientation")
	align.Name = "TKCasterFaceAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.MaxTorque = math.huge
	align.Responsiveness = 22
	align.CFrame = root.CFrame
	align.Parent = root
	return align, att :: Attachment
end

local function setServerOwnership(model: Model): { BasePart }
	local parts: { BasePart } = {}
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			table.insert(parts, desc)
			pcall(function()
				desc:SetNetworkOwner(nil)
			end)
		end
	end
	return parts
end

local function restoreOwnership(model: Model, parts: { BasePart })
	local plr = Players:GetPlayerFromCharacter(model)
	for _, part in parts do
		if part.Parent then
			pcall(function()
				if plr then
					part:SetNetworkOwner(plr)
				else
					part:SetNetworkOwnershipAuto()
				end
			end)
		end
	end
end

--[[ Pull in, then fling toward cursor. Shared by Wanda throw and Jean push. ]]
function TelekinesisService.launchVictim(
	caster: Model,
	victim: Model,
	direction: Vector3?,
	aimPoint: Vector3?,
	onLaunch: ((root: BasePart) -> ())?,
	speedMul: number?,
	onDone: (() -> ())?
)
	local casterRoot = caster:FindFirstChild("HumanoidRootPart") :: BasePart?
	local vRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
	local vHum = CombatHelper.getHumanoid(victim)
	if not casterRoot or not vRoot or not vHum then
		if onDone then
			onDone()
		end
		return
	end

	ScreenFeelHelper.setSpeedFov(victim, true)
	local ownedParts = setServerOwnership(victim)
	local mul = if type(speedMul) == "number" then speedMul else 1
	local token = (victim:GetAttribute("TkLaunchToken") :: number?) or 0
	token += 1
	victim:SetAttribute("TkLaunchToken", token)

	local att = Instance.new("Attachment")
	att.Name = "TkLaunchDrawAtt"
	att.Parent = vRoot
	local align = Instance.new("AlignPosition")
	align.Name = "TkLaunchDrawPos"
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.ApplyAtCenterOfMass = true
	align.RigidityEnabled = false
	align.MaxForce = GameConstants.MG_PULL_MAX_FORCE
	align.MaxVelocity = 58
	align.Responsiveness = 18
	align.Parent = vRoot

	local origWalk = vHum.WalkSpeed
	local origAutoRotate = vHum.AutoRotate
	vHum.WalkSpeed = 0
	vHum.AutoRotate = false

	local drawTime = GameConstants.MG_PUSH_DRAW_TIME
	local holdDist = GameConstants.MG_PUSH_DRAW_DIST
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < drawTime do
			if not victim.Parent or not vRoot.Parent or not casterRoot.Parent or victim:GetAttribute("TkLaunchToken") ~= token then
				break
			end
			local away = vRoot.Position - casterRoot.Position
			local flat = Vector3.new(away.X, 0, away.Z)
			if flat.Magnitude < 0.08 then
				local look = Vector3.new(casterRoot.CFrame.LookVector.X, 0, casterRoot.CFrame.LookVector.Z)
				flat = if look.Magnitude > 0.05 then look else Vector3.new(0, 0, -1)
			end
			align.Position = casterRoot.Position + flat.Unit * holdDist + Vector3.new(0, 2.2, 0)
			vRoot.AssemblyAngularVelocity = Vector3.zero
			vHum:Move(Vector3.zero, false)
			task.wait()
		end

		if align.Parent then
			align:Destroy()
		end
		if att.Parent then
			att:Destroy()
		end

		if not victim.Parent or not vRoot.Parent or victim:GetAttribute("TkLaunchToken") ~= token then
			restoreOwnership(victim, ownedParts)
			if vHum.Parent then
				vHum.WalkSpeed = origWalk
				vHum.AutoRotate = origAutoRotate
			end
			if victim.Parent then
				ScreenFeelHelper.setSpeedFov(victim, false)
			end
			if onDone then
				onDone()
			end
			return
		end

		local fromPos = vRoot.Position
		local casterLook = Vector3.new(casterRoot.CFrame.LookVector.X, 0, casterRoot.CFrame.LookVector.Z)
		local fallbackAim = aimPoint
		if typeof(fallbackAim) ~= "Vector3" then
			local look = if direction and direction.Magnitude > 0.05 then direction.Unit else casterRoot.CFrame.LookVector
			fallbackAim = fromPos + look * 90
		elseif (fallbackAim - fromPos).Magnitude < 10 then
			local look = if direction and direction.Magnitude > 0.05 then direction.Unit else casterRoot.CFrame.LookVector
			fallbackAim = fromPos + look * 90
		end
		local launch = PushHelper.launchTowardCursor(fromPos, fallbackAim, casterLook)
		RagdollService.applyTimed(victim, GameConstants.MG_PUSH_RAGDOLL_TIME)
		RagdollService.markTelekineticLand(victim)
		pcall(function()
			vRoot:SetNetworkOwner(nil)
		end)
		if onLaunch then
			onLaunch(vRoot)
		end
		PushHelper.telekineticFling(
			victim,
			vRoot,
			launch,
			GameConstants.MG_PUSH_SPEED * mul,
			GameConstants.MG_PUSH_UP
		)

		task.delay(GameConstants.MG_PUSH_RAGDOLL_TIME, function()
			restoreOwnership(victim, ownedParts)
			if vHum.Parent and vHum.Health > 0 then
				vHum.WalkSpeed = origWalk
				vHum.AutoRotate = origAutoRotate
			end
			if victim.Parent then
				ScreenFeelHelper.setSpeedFov(victim, false)
			end
			if onDone then
				onDone()
			end
		end)
	end)
end

local function applyTargetRagdoll(target: HeldTarget, isTorture: boolean?)
	-- Same as NewMarvel: attribute drives RagdollService physics
	target.model:SetAttribute("TelekinesisHeld", true)
	target.model:SetAttribute("Ragdolled", true)
	if isTorture then
		target.model:SetAttribute(GameConstants.TORTURE_LOCKED_ATTRIBUTE, true)
	end
	target.humanoid.AutoRotate = false
	pcall(function()
		target.humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end)
	target.ownerParts = setServerOwnership(target.model)
	target.root.AssemblyLinearVelocity = Vector3.zero
	target.root.AssemblyAngularVelocity = Vector3.zero
end

local function destroyHold(target: HeldTarget, keepServerOwnership: boolean?)
	clearTortureHead(target)
	clearTkParticles(target)
	if target.align then
		target.align:Destroy()
		target.align = nil
	end
	if target.attach then
		target.attach:Destroy()
		target.attach = nil
	end
	if not keepServerOwnership then
		restoreOwnership(target.model, target.ownerParts or {})
	end
	target.model:SetAttribute("TelekinesisHeld", nil)
	target.model:SetAttribute(GameConstants.TORTURE_LOCKED_ATTRIBUTE, nil)
end

local function destroyCasterFace(state: TkState, restoreAutoRotate: boolean?)
	if state.faceAlign then
		state.faceAlign:Destroy()
		state.faceAlign = nil
	end
	if state.faceAttach then
		state.faceAttach:Destroy()
		state.faceAttach = nil
	end
	if restoreAutoRotate ~= false and state.casterHumanoid.Parent then
		local flying = state.character.Parent
			and state.character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
		if not flying then
			state.casterHumanoid.AutoRotate = true
		end
	end
end

local function endTelekinesis(player: Player, applyCooldown: boolean?, ragdollClearDelay: number?)
	local state = tkByPlayer[player]
	if not state then
		-- Clear sticky attribute if present without state
		local char = player.Character
		if char then
			char:SetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE, nil)
			AbilityCooldownHelper.setActive(char, "telekinesis", false)
		end
		return
	end
	tkByPlayer[player] = nil

	unlockCasterWalk(state)
	destroyCasterFace(state)
	stopTkHoldAnim(state)
	if state.casterRoot and state.casterRoot.Parent then
		for _, name in { "TKCasterFaceAlign", "TKCasterFaceAttachment" } do
			local inst = state.casterRoot:FindFirstChild(name)
			if inst then
				inst:Destroy()
			end
		end
	end

	local clearDelay = ragdollClearDelay
	for _, target in state.held do
		local model = target.model
		destroyHold(target)
		if model.Parent then
			if clearDelay and clearDelay > 0 then
				RagdollService.applyTimed(model, clearDelay)
			else
				RagdollService.clear(model)
			end
		end
	end

	if state.character.Parent then
		state.character:SetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE, nil)
		AbilityCooldownHelper.setActive(state.character, "telekinesis", false)
		if state.character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "scarlet_witch" then
			HandParticleHelper.endUse(state.character)
		end
		if applyCooldown then
			AbilityCooldownHelper.applyAfterUse(state.character, "telekinesis", GameConstants.TK_COOLDOWN)
			CharacterService.markAbilityUse(state.character)
		end
	end
end

local function gatherMass(
	caster: Model,
	center: Vector3,
	primaryModel: Model?,
	primaryPart: BasePart?
): { HeldTarget }
	local results: { HeldTarget } = {}
	local seen: { [Model]: boolean } = {}
	for _, model in CombatHelper.overlapCharacters(center, GameConstants.TK_MASS_RADIUS, caster) do
		if seen[model] or CombatHelper.isShielded(model) then
			continue
		end
		local root = resolveGrabPart(model, primaryPart)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 then
			seen[model] = true
			table.insert(results, {
				root = root,
				model = model,
				humanoid = humanoid,
				align = nil,
				attach = nil,
				offsetFromAnchor = root.Position - center,
				ownerParts = {},
				particles = {},
				tortureHeadAtt = nil,
			})
		end
	end
	return results
end

local function getHeldFocusPosition(state: TkState): Vector3?
	if #state.held == 0 then
		return nil
	end
	local sum = Vector3.zero
	local n = 0
	for _, target in state.held do
		if target.root.Parent then
			sum += target.root.Position
			n += 1
		end
	end
	if n == 0 then
		return nil
	end
	return sum / n
end

local function resolveSingleTarget(
	character: Model,
	casterRoot: BasePart,
	cursorWorld: Vector3,
	hitCharacter: Model?,
	hitPart: BasePart?,
	lockOn: boolean?
): (Model?, BasePart?)
	local target = hitCharacter
	local preferredPart = hitPart
	if preferredPart and not target then
		target = CombatHelper.getCharacterFromPart(preferredPart)
	end
	if target and target.Parent and target ~= character then
		local hum = target:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 and not CombatHelper.isShielded(target) then
			local grab = resolveGrabPart(target, preferredPart)
			if grab and (grab.Position - casterRoot.Position).Magnitude <= GameConstants.TK_RANGE then
				return target, grab
			end
		end
	end
	if lockOn ~= true then
		return nil, nil
	end

	local toCursor = cursorWorld - casterRoot.Position
	local dir = if toCursor.Magnitude > 0.05 then toCursor.Unit else casterRoot.CFrame.LookVector
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local result = workspace:Raycast(casterRoot.Position, dir * GameConstants.TK_RANGE, params)
	if result and result.Instance:IsA("BasePart") then
		local model = CombatHelper.getCharacterFromPart(result.Instance)
		if model and not CombatHelper.isShielded(model) then
			local hum = model:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				return model, resolveGrabPart(model, result.Instance)
			end
		end
	end
	local near = CombatHelper.overlapCharacters(cursorWorld, 4, character)
	for _, model in near do
		if not CombatHelper.isShielded(model) then
			local grab = resolveGrabPart(model, nil)
			if grab and (grab.Position - casterRoot.Position).Magnitude <= GameConstants.TK_RANGE then
				return model, grab
			end
		end
	end
	return nil, nil
end

function TelekinesisService.tryStart(player: Player, cursorWorld: Vector3, hitCharacter: Model?, hitPart: BasePart?, lockOn: boolean?): boolean
	if tkByPlayer[player] then
		return false
	end
	local character = player.Character
	if not character then
		return false
	end
	local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
	if heroId ~= "scarlet_witch" and heroId ~= "jean_grey" then
		return false
	end
	if heroId == "scarlet_witch" and character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
		return false
	end
	if CombatHelper.arePowersDisabled(character) then
		return false
	end
	if character:GetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE) == true then
		return false
	end
	if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return false
	end
	if AbilityCooldownHelper.hasBlockingActive(character, "telekinesis") then
		return false
	end
	if AbilityCooldownHelper.isOnCooldown(character, "telekinesis") then
		return false
	end

	-- Clear sticky active flag from a failed prior session
	if character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true then
		character:SetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE, nil)
		AbilityCooldownHelper.setActive(character, "telekinesis", false)
	end

	local casterRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local casterHumanoid = character:FindFirstChildOfClass("Humanoid")
	if not casterRoot or not casterHumanoid then
		return false
	end

	local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
	local mode = getMode(character)
	local isTorture = mode == "Torture"
	if isTorture and character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
		return false
	end
	local startCost = if isTorture then GameConstants.TK_TORTURE_ENERGY_DRAIN else GameConstants.TK_ENERGY_DRAIN
	if type(energy) ~= "number" or energy < startCost then
		return false
	end

	local isMass = mode == "Multiple"
	local held: { HeldTarget } = {}

	if isMass then
		local primary = hitCharacter
		if hitPart and not primary then
			primary = CombatHelper.getCharacterFromPart(hitPart)
		end
		held = gatherMass(character, cursorWorld, primary, hitPart)
		do
			local filtered: { HeldTarget } = {}
			for _, target in held do
				if LokiService.tryReflect(character, target.model, "telekinesis") then
					continue
				end
				table.insert(filtered, target)
			end
			held = filtered
		end
		if #held == 0 then
			return false
		end
	else
		local target, grabPart = resolveSingleTarget(character, casterRoot, cursorWorld, hitCharacter, hitPart, lockOn)
		if not target or not grabPart then
			return false
		end
		local humanoid = target:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return false
		end
		-- Loki Reflect Shield: bounce TK / Torture back onto caster
		local reflectKind = if isTorture then "torture" else "telekinesis"
		if LokiService.tryReflect(character, target, reflectKind) then
			return false
		end
		grabPart = resolveGrabPart(target, nil)
		table.insert(held, {
			root = grabPart,
			model = target,
			humanoid = humanoid,
			align = nil,
			attach = nil,
			offsetFromAnchor = Vector3.zero,
			ownerParts = {},
			particles = {},
			tortureHeadAtt = nil,
		})
	end

	local startDrain = startCost
	if not CharacterService.spendEnergy(character, startDrain) then
		return false
	end

	local holdDist = math.clamp(
		(cursorWorld - casterRoot.Position).Magnitude,
		GameConstants.TK_HOLD_DIST_MIN,
		GameConstants.TK_HOLD_DIST_MAX
	)
	local toCursor = cursorWorld - casterRoot.Position
	local holdPoint = if toCursor.Magnitude > 0.05
		then casterRoot.Position + toCursor.Unit * holdDist
		else casterRoot.Position + casterRoot.CFrame.LookVector * holdDist
	if isTorture then
		holdPoint = holdPoint + Vector3.new(0, GameConstants.TK_TORTURE_LIFT_HEIGHT, 0)
	end

	local isFlying = character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
	local savedAutoRotate = casterHumanoid.AutoRotate
	local faceAlign: AlignOrientation? = nil
	local faceAttach: Attachment? = nil
	if not isFlying then
		casterHumanoid.AutoRotate = false
		faceAlign, faceAttach = createFaceAlign(casterRoot)
	end

	-- Register state first so release/throw always have something to clean up
	local state: TkState = {
		character = character,
		casterRoot = casterRoot,
		casterHumanoid = casterHumanoid,
		held = held,
		isMass = isMass,
		isTorture = isTorture,
		cursorWorld = cursorWorld,
		holdDistance = holdDist,
		smoothedHoldPoint = holdPoint,
		lastDrain = os.clock(),
		lastTortureDamage = 0,
		throwing = false,
		startedAt = os.clock(),
		faceAlign = faceAlign,
		faceAttach = faceAttach,
		savedAutoRotate = savedAutoRotate,
		savedWalkSpeed = nil,
		savedJumpPower = nil,
		savedJumpHeight = nil,
		casterWalkLocked = false,
		animTrack = nil,
	}
	tkByPlayer[player] = state

	AbilityCooldownHelper.setActive(character, "telekinesis", true)
	if heroId == "scarlet_witch" then
		HandParticleHelper.beginUse(character)
		state.animTrack = playTkAnim(character, GameConstants.SW_TELEKINESIS_ANIM, true)
	elseif heroId == "jean_grey" then
		state.animTrack = playTkAnim(character, GameConstants.MG_TELEKINESIS_ANIM, true)
	end
	character:SetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE, true)

	if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) ~= true then
		lockCasterWalk(state)
	end

	for _, target in held do
		local ok, err = pcall(function()
			applyTargetRagdoll(target, isTorture)
			local align, att = createHoldAlign(target.root, holdPoint + target.offsetFromAnchor)
			target.align = align
			target.attach = att
			if isTorture then
				target.tortureHeadAtt = attachTortureHead(target.model)
			end
			if heroId == "scarlet_witch" or heroId == "jean_grey" then
				target.particles = VfxHelper.attachHeroTelekinesisMorphParticles(target.model, heroId, character)
			end
		end)
		if not ok then
			warn("[Telekinesis] hold setup failed:", err)
			destroyHold(target)
			if target.model.Parent then
				RagdollService.clear(target.model)
			end
		end
	end

	-- Drop any targets that failed setup
	local alive: { HeldTarget } = {}
	for _, target in held do
		if target.align and target.root.Parent then
			table.insert(alive, target)
		end
	end
	state.held = alive
	if #alive == 0 then
		endTelekinesis(player, false, 0)
		return false
	end

	VfxHelper.spawnPulseRing(
		casterRoot.Position,
		3,
		if heroId == "jean_grey"
			then (if character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "marvel_girl"
				then GameConstants.MG_PSI_COLOR_MARVEL_GIRL
				else GameConstants.MG_PSI_COLOR)
			else VfxHelper.chaosColor(),
		0.3
	)
	return true
end

function TelekinesisService.updateAim(player: Player, cursorWorld: Vector3)
	local state = tkByPlayer[player]
	if not state or state.throwing then
		return
	end
	state.cursorWorld = cursorWorld
end

function TelekinesisService.adjustDistance(player: Player, scrollDelta: number)
	local state = tkByPlayer[player]
	if not state or state.throwing then
		return
	end
	local step = if scrollDelta > 0 then GameConstants.TK_SCROLL_STEP else -GameConstants.TK_SCROLL_STEP
	state.holdDistance = math.clamp(
		state.holdDistance + step,
		GameConstants.TK_HOLD_DIST_MIN,
		GameConstants.TK_HOLD_DIST_MAX
	)
end

function TelekinesisService.throw(player: Player, throwDir: Vector3, aimPoint: Vector3?)
	local state = tkByPlayer[player]
	if not state or state.throwing then
		return
	end
	-- Torture: hold-only damage mode — no throw
	if state.isTorture then
		return
	end
	if #state.held == 0 then
		return
	end
	state.throwing = true

	CharacterService.spendEnergy(state.character, GameConstants.TK_THROW_COST)

	local mouseDir = if throwDir.Magnitude > 0.01 then throwDir.Unit else state.casterRoot.CFrame.LookVector
	local dmgMul = if state.isMass then GameConstants.TK_MASS_THROW_DAMAGE_MULT else 1
	local speedMul = if state.isMass then GameConstants.TK_MASS_THROW_SPEED_MULT else 1
	local heldSnapshot = table.clone(state.held)
	local caster = state.character

	stopTkHoldAnim(state)
	TelekinesisService.playThrowAnim(caster)

	state.held = {}
	unlockCasterWalk(state)
	destroyCasterFace(state)
	tkByPlayer[player] = nil
	if state.character.Parent then
		state.character:SetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE, nil)
		AbilityCooldownHelper.setActive(state.character, "telekinesis", false)
		if state.character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "scarlet_witch" then
			HandParticleHelper.endUse(state.character)
		end
		AbilityCooldownHelper.applyAfterUse(state.character, "telekinesis", GameConstants.TK_COOLDOWN)
		CharacterService.markAbilityUse(state.character)
	end

	for _, target in heldSnapshot do
		if not target.root.Parent or not target.model.Parent then
			continue
		end
		local model = target.model
		destroyHold(target, true)
		TelekinesisService.launchVictim(state.character, model, mouseDir, aimPoint, function(vRoot)
			CombatHelper.dealDamage(state.character, model, GameConstants.TK_THROW_DAMAGE * dmgMul)
			VfxHelper.spawnBurstSparks(vRoot.Position, VfxHelper.chaosSoft(), 6)
		end, speedMul)
	end
end

function TelekinesisService.takeHeldForJeanPush(player: Player): { Model }
	local state = tkByPlayer[player]
	if not state or state.throwing then
		return {}
	end
	state.throwing = true
	local caster = state.character
	local models: { Model } = {}
	local snapshot = table.clone(state.held)
	stopTkHoldAnim(state)
	TelekinesisService.playThrowAnim(caster)
	state.held = {}
	unlockCasterWalk(state)
	destroyCasterFace(state)
	tkByPlayer[player] = nil
	if state.character.Parent then
		state.character:SetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE, nil)
		AbilityCooldownHelper.setActive(state.character, "telekinesis", false)
	end
	for _, target in snapshot do
		destroyHold(target, true)
		if target.model.Parent then
			table.insert(models, target.model)
		end
	end
	return models
end

function TelekinesisService.release(player: Player)
	endTelekinesis(player, true, GameConstants.RAGDOLL_TK_RELEASE_DELAY)
end

function TelekinesisService.isActive(player: Player): boolean
	return tkByPlayer[player] ~= nil
end

function TelekinesisService.update(dt: number)
	local now = os.clock()
	local dtClamped = math.clamp(dt, 0.001, 0.1)
	local holdLerp = 1 - (1 - GameConstants.TK_HOLD_POINT_LERP) ^ (dtClamped * 60)

	for player, state in tkByPlayer do
		if not state.character.Parent or not state.casterRoot.Parent then
			endTelekinesis(player, false, GameConstants.RAGDOLL_TK_RELEASE_DELAY)
			continue
		end

		if state.throwing then
			continue
		end

		if now - state.lastDrain >= GameConstants.TK_ENERGY_INTERVAL then
			state.lastDrain = now
			local drain = if state.isTorture then GameConstants.TK_TORTURE_ENERGY_DRAIN else GameConstants.TK_ENERGY_DRAIN
			if not CharacterService.spendEnergy(state.character, drain) then
				endTelekinesis(player, true, GameConstants.RAGDOLL_TK_RELEASE_DELAY)
				continue
			end
		end

		if state.character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) ~= true then
			lockCasterWalk(state)
		end

		local casterPos = state.casterRoot.Position
		local toCursor = state.cursorWorld - casterPos
		local desired = if toCursor.Magnitude > 0.05
			then casterPos + toCursor.Unit * state.holdDistance
			else casterPos + state.casterRoot.CFrame.LookVector * state.holdDistance
		if state.isTorture then
			desired = desired + Vector3.new(0, GameConstants.TK_TORTURE_LIFT_HEIGHT, 0)
		end

		state.smoothedHoldPoint = state.smoothedHoldPoint:Lerp(desired, holdLerp)
		local holdPoint = state.smoothedHoldPoint

		local isFlying = state.character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
		if isFlying then
			if state.faceAlign or state.faceAttach then
				destroyCasterFace(state, false)
			end
		else
			if not state.faceAlign then
				state.savedAutoRotate = state.casterHumanoid.AutoRotate
				state.casterHumanoid.AutoRotate = false
				local faceAlign, faceAttach = createFaceAlign(state.casterRoot)
				state.faceAlign = faceAlign
				state.faceAttach = faceAttach
			end
			local focus = getHeldFocusPosition(state)
			if focus and state.faceAlign then
				local flat = Vector3.new(focus.X - casterPos.X, 0, focus.Z - casterPos.Z)
				if flat.Magnitude > 0.15 then
					state.faceAlign.CFrame = CFrame.lookAt(casterPos, casterPos + flat.Unit)
				end
			end
			if state.casterHumanoid.Parent then
				state.casterHumanoid.AutoRotate = false
			end
		end

		-- Torture: continuous damage while held
		if state.isTorture and now - state.lastTortureDamage >= GameConstants.TK_TORTURE_DAMAGE_INTERVAL then
			state.lastTortureDamage = now
			for _, target in state.held do
				if target.model.Parent and target.humanoid.Parent and target.humanoid.Health > 0 then
					CombatHelper.dealDamage(state.character, target.model, GameConstants.TK_TORTURE_DAMAGE)
				end
			end
		end

		local grace = (now - state.startedAt) < 0.75
		local stillHeld: { HeldTarget } = {}
		for _, target in state.held do
			if not target.root.Parent or not target.humanoid.Parent or target.humanoid.Health <= 0 then
				destroyHold(target)
				if target.model.Parent then
					RagdollService.applyTimed(target.model, GameConstants.RAGDOLL_TK_RELEASE_DELAY)
				end
				continue
			end
			if not grace and (target.root.Position - casterPos).Magnitude > GameConstants.TK_RANGE * 1.75 then
				destroyHold(target)
				RagdollService.applyTimed(target.model, GameConstants.RAGDOLL_TK_RELEASE_DELAY)
				continue
			end

			-- Keep Ragdolled status alive (NewMarvel-style soft maintain)
			if target.model:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) ~= true then
				target.model:SetAttribute("Ragdolled", true)
			else
				RagdollService.maintain(target.model)
			end
			pcall(function()
				if target.humanoid:GetState() ~= Enum.HumanoidStateType.Physics then
					target.humanoid:ChangeState(Enum.HumanoidStateType.Physics)
				end
			end)

			local goal = if state.isMass then holdPoint + target.offsetFromAnchor else holdPoint
			if not target.align or not target.align.Parent then
				local align, att = createHoldAlign(target.root, goal)
				target.align = align
				target.attach = att
			else
				target.align.Position = goal
			end
			table.insert(stillHeld, target)
		end
		state.held = stillHeld
		if #stillHeld == 0 then
			endTelekinesis(player, true, GameConstants.RAGDOLL_TK_RELEASE_DELAY)
		end
	end
end

function TelekinesisService.init()
	Players.PlayerRemoving:Connect(function(player)
		endTelekinesis(player, false, 0)
	end)
end

return TelekinesisService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">TelekineticThrowerService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Parts named "TelekineticThrower" on Workspace:
	On touch → TK particles on the character, then throw after 1s.
	Used to test Loki Reflect Shield against telekinesis-style attacks.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local PushHelper = require(ReplicatedStorage.Shared.PushHelper)
local RagdollStatus = require(ReplicatedStorage.Shared.RagdollStatus)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)
local LokiService = require(script.Parent.LokiService)

local TelekineticThrowerService = {}

local tracked: { [BasePart]: boolean } = {}
local busy: { [Model]: boolean } = {}
local ownerModel: Model? = nil

local function getOrCreateOwner(): Model
	if ownerModel and ownerModel.Parent then
		return ownerModel
	end
	local model = Instance.new("Model")
	model.Name = "TelekineticThrowerOwner"
	local hum = Instance.new("Humanoid")
	hum.MaxHealth = 99999
	hum.Health = 99999
	hum.Parent = model
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.Parent = model
	model.PrimaryPart = root
	model.Parent = Workspace
	ownerModel = model
	return model
end

local function getCharacterFromPart(part: BasePart): Model?
	local current: Instance? = part
	while current do
		if current:IsA("Model") then
			local hum = current:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				return current
			end
		end
		current = current.Parent
	end
	return nil
end

local function processVictim(thrower: BasePart, victim: Model)
	if busy[victim] then
		return
	end
	if victim:GetAttribute("LokiUltClone") == true or victim:GetAttribute("LokiDecoy") == true then
		return
	end
	local hum = victim:FindFirstChildOfClass("Humanoid")
	local root = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not root or hum.Health <= 0 then
		return
	end

	busy[victim] = true
	local owner = getOrCreateOwner()
	local ownerRoot = owner:FindFirstChild("HumanoidRootPart") :: BasePart?
	if ownerRoot then
		ownerRoot.CFrame = thrower.CFrame
	end

	-- Reflect test: Loki shield reflects telekinesis onto the thrower owner
	if LokiService.tryReflect(owner, victim, "telekinesis") then
		busy[victim] = nil
		return
	end

	local particles = VfxHelper.attachTelekinesisParticles(victim)
	victim:SetAttribute("TelekinesisHeld", true)

	-- Light lift while held
	local liftAtt = Instance.new("Attachment")
	liftAtt.Name = "TKThrowerLiftAtt"
	liftAtt.Parent = root
	local align = Instance.new("AlignPosition")
	align.Name = "TKThrowerAlign"
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = liftAtt
	align.Position = root.Position + Vector3.new(0, 4, 0)
	align.Responsiveness = 25
	align.MaxForce = 1e5
	align.MaxVelocity = 40
	align.Parent = root

	task.delay(1, function()
		if align.Parent then
			align:Destroy()
		end
		if liftAtt.Parent then
			liftAtt:Destroy()
		end
		victim:SetAttribute("TelekinesisHeld", nil)
		VfxHelper.fadeOutAndDestroyParticles(particles, 0.35, 3)

		if not victim.Parent or not root.Parent or hum.Health <= 0 then
			busy[victim] = nil
			return
		end

		-- Second chance reflect at throw time
		if LokiService.tryReflect(owner, victim, "telekinesis") then
			busy[victim] = nil
			return
		end

		local away = root.Position - thrower.Position
		local dir = if away.Magnitude > 0.05 then away.Unit else thrower.CFrame.LookVector
		RagdollStatus.applyTimed(victim, GameConstants.RAGDOLL_TK_THROW_DURATION)
		PushHelper.applyToCharacter(victim, dir, {
			speed = GameConstants.TK_THROW_SPEED,
			upBoost = GameConstants.TK_THROW_UP,
		})
		busy[victim] = nil
	end)
end

local function track(part: BasePart)
	if tracked[part] then
		return
	end
	tracked[part] = true
	part.Touched:Connect(function(other)
		if not other:IsA("BasePart") then
			return
		end
		local victim = getCharacterFromPart(other)
		if victim then
			processVictim(part, victim)
		end
	end)
	part.AncestryChanged:Connect(function(_, parent)
		if not parent then
			tracked[part] = nil
		end
	end)
end

local function scan(root: Instance)
	for _, desc in root:GetDescendants() do
		if desc:IsA("BasePart") and desc.Name == "TelekineticThrower" then
			track(desc)
		end
	end
end

function TelekineticThrowerService.update(_dt: number)
	-- Touch-driven; nothing per-frame
end

function TelekineticThrowerService.init()
	scan(Workspace)
	Workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("BasePart") and inst.Name == "TelekineticThrower" then
			track(inst)
		end
	end)
end

return TelekineticThrowerService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="53">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="54">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="55">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="56">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local function disableNoisyLegacyScripts(root: Instance)
	for _, inst in root:GetDescendants() do
		if (inst:IsA("Script") or inst:IsA("LocalScript")) and inst.Name == "Game sounds" then
			inst.Disabled = true
		end
	end
end

disableNoisyLegacyScripts(game)
game.DescendantAdded:Connect(function(inst)
	if (inst:IsA("Script") or inst:IsA("LocalScript")) and inst.Name == "Game sounds" then
		inst.Disabled = true
	end
end)

require(ReplicatedStorage.Shared.SmartBonePatch).install()

local AbilityInput = require(script.AbilityInput)
local CharacterSelectUI = require(script.CharacterSelectUI)
local DeathScreenClient = require(script.DeathScreenClient)
local HexFlightClient = require(script.HexFlightClient)
local PartialShieldClient = require(script.PartialShieldClient)
local RagdollController = require(script.RagdollController)
local AnimationPreload = require(ReplicatedStorage.Shared.AnimationPreload)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
require(ReplicatedStorage.Shared.VfxHelper)

task.spawn(function()
	AnimationPreload.preload()
end)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

require(script.PlayerDataClient).init(player)

local awaitingDeploy = false
local deathFlowStarted = false
local deathFlowDone = false

local selection = CharacterSelectUI.create(playerGui, function(heroId: string, skinId: string)
	awaitingDeploy = true
	Remotes.getEvent("SelectHero"):FireServer(heroId, skinId)
end)

local hudOk, hudOrErr = pcall(function()
	return require(script.GameplayHUD).create(playerGui)
end)
if not hudOk then
	warn("[MCU Client] GameplayHUD failed:", hudOrErr)
	local existing = playerGui:FindFirstChild("GameplayHUD")
	if existing and existing:IsA("ScreenGui") then
		existing.ResetOnSpawn = false
		existing.Enabled = true
	end
end
local hud = if hudOk then hudOrErr else nil

local function safeHudShow(heroId: string, character: Model)
	if not hud then
		return
	end
	hud.show(heroId)
	hud.bindCharacter(character)
end

local function safeHudHide()
	if hud then
		hud.hide()
	end
end

require(script.TeleportMarkerClient).init(player)
AbilityInput.init(player)
require(script.SoftLockClient).init(player)
require(script.ShoulderCamClient).init(player)
require(script.AbilityCameraGuard).init(player)
HexFlightClient.init(player)
PartialShieldClient.init(player)
RagdollController.init(player)
require(script.SprintClient).init(player)
require(script.RunAnimClient).init(player)
require(script.CombatHud).init(player)
require(script.LokiInvisClient).init(player)
require(script.LokiDecoyMarkerClient).init(player)
require(script.BlindFlashClient).init(player)
require(script.MarvelGirlClient).init(player)
require(script.InvisibleWomanClient).init(player)
require(script.ScarletWitchClient).init(player)
require(script.CameraShakeClient).init(player)
do
	local ok, err = pcall(function()
		require(script.BeamClashClient).init(player)
	end)
	if not ok then
		warn("[MCU Client] BeamClashClient failed:", err)
	end
end

local function isDeployedHero(character: Model): boolean
	local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
	return type(heroId) == "string" and heroId ~= ""
end

local function isPhoenixJean(character: Model): boolean
	return character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "jean_grey"
		and character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "phoenix"
end

local function beginDeathFlow(character: Model)
	if deathFlowStarted or deathFlowDone or DeathScreenClient.isActive() then
		return
	end
	if not isDeployedHero(character) then
		return
	end
	deathFlowStarted = true
	deathFlowDone = true
	awaitingDeploy = false
	safeHudHide()
	AbilityInput.setInputBlocked(true)

	local phoenix = isPhoenixJean(character)
	DeathScreenClient.play(character, function()
		deathFlowStarted = false
		AbilityInput.setInputBlocked(false)
		selection.showSelection()
	end, {
		isPhoenix = phoenix,
		onRevive = if phoenix
			then function()
				Remotes.getEvent("PhoenixRevive"):FireServer()
			end
			else nil,
	})
end

local function bindHeroCharacter(character: Model)
	local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
	if type(heroId) ~= "string" or heroId == "" then
		return false
	end
	if not character.Parent then
		return false
	end

	deathFlowStarted = false
	deathFlowDone = false
	DeathScreenClient.cancel()
	selection.hide()
	selection.endDeployWhiteout()
	safeHudShow(heroId, character)
	awaitingDeploy = false
	AbilityInput.setInputBlocked(false)
	return true
end

local function hookDeath(character: Model)
	CombatHelper.bindSilenceDeathSounds(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		local waited = character:WaitForChild("Humanoid", 5)
		if waited and waited:IsA("Humanoid") then
			humanoid = waited
		end
	end
	if not humanoid then
		return
	end
	humanoid.Died:Connect(function()
		CombatHelper.silenceDeathSounds(character)
		beginDeathFlow(character)
	end)
end

local function onCharacterSpawned(character: Model)
	task.spawn(hookDeath, character)

	if DeathScreenClient.isActive() or deathFlowStarted then
		return
	end

	safeHudHide()

	if bindHeroCharacter(character) then
		return
	end

	if not awaitingDeploy then
		selection.show(true)
	end

	local attrConn: RBXScriptConnection? = nil
	local destroyConn: RBXScriptConnection? = nil

	local function disconnectAll()
		if attrConn then
			attrConn:Disconnect()
			attrConn = nil
		end
		if destroyConn then
			destroyConn:Disconnect()
			destroyConn = nil
		end
	end

	attrConn = character:GetAttributeChangedSignal(GameConstants.HERO_ATTRIBUTE):Connect(function()
		if bindHeroCharacter(character) then
			disconnectAll()
		end
	end)

	destroyConn = character.Destroying:Connect(disconnectAll)
end

player.CharacterRemoving:Connect(function(character)
	if deathFlowStarted or DeathScreenClient.isActive() then
		DeathScreenClient.notifyBodyGone()
		return
	end
	if deathFlowDone then
		return
	end
	if not isDeployedHero(character) then
		return
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead then
		return
	end
	beginDeathFlow(character)
	DeathScreenClient.notifyBodyGone()
end)

player.CharacterAdded:Connect(function(character)
	if not DeathScreenClient.isActive() then
		AbilityInput.setInputBlocked(false)
	end
	onCharacterSpawned(character)
end)

task.spawn(function()
	local resetBind = Instance.new("BindableEvent")
	resetBind.Event:Connect(function()
		if DeathScreenClient.isActive() or deathFlowStarted then
			DeathScreenClient.notifyBodyGone()
			return
		end
		local character = player.Character
		if not character or not isDeployedHero(character) then
			return
		end
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			hum.Health = 0
		end
	end)
	for _ = 1, 30 do
		local ok = pcall(function()
			StarterGui:SetCore("ResetButtonCallback", resetBind)
		end)
		if ok then
			break
		end
		task.wait(0.4)
	end
end)

if player.Character then
	onCharacterSpawned(player.Character)
else
	selection.show()
end

Remotes.getEvent("PhoenixRevive").OnClientEvent:Connect(function(success: any)
	if success == true then
		deathFlowStarted = false
		deathFlowDone = false
		DeathScreenClient.cancel()
		AbilityInput.setInputBlocked(false)
		selection.hide()
		local character = player.Character
		if character and isDeployedHero(character) then
			local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
			if type(heroId) == "string" then
				safeHudShow(heroId, character)
			end
		end
	end
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">AbilityCameraGuard</string>
            <string name="Source"><![CDATA[--!strict
--[[
	While aiming abilities (TK hold, teleport aim, etc.), freeze camera zoom
	so mouse wheel drives the ability distance — not camera distance.
	Does not Sink the wheel (AbilityInput / TeleportMarkerClient handle it).
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local AbilityCameraGuard = {}

local player: Player? = nil
local frozen = false
local savedMin: number? = nil
local savedMax: number? = nil

local function setZoomRange(plr: Player, minZoom: number, maxZoom: number)
	local lo = math.clamp(minZoom, 0.5, 128)
	local hi = math.clamp(maxZoom, lo, 128)
	if lo > hi then
		lo, hi = hi, lo
	end
	if plr.CameraMinZoomDistance > hi then
		plr.CameraMaxZoomDistance = hi
	end
	plr.CameraMinZoomDistance = lo
	plr.CameraMaxZoomDistance = hi
end

local function currentZoom(): number
	local cam = workspace.CurrentCamera
	if not cam then
		return 12
	end
	local focus = cam.Focus.Position
	return math.clamp((cam.CFrame.Position - focus).Magnitude, 0.5, 128)
end

local function shouldFreeze(character: Model?): boolean
	if not character then
		return false
	end
	if character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true then
		return true
	end
	return false
end

local function freezeZoom()
	local plr = player
	if not plr or frozen then
		return
	end
	local z = currentZoom()
	savedMin = plr.CameraMinZoomDistance
	savedMax = plr.CameraMaxZoomDistance
	setZoomRange(plr, z, z)
	frozen = true
end

local function unfreezeZoom()
	local plr = player
	if not frozen then
		return
	end
	frozen = false
	if plr then
		local restoreMin = if typeof(savedMin) == "number" then savedMin :: number else 0.5
		local restoreMax = if typeof(savedMax) == "number" then savedMax :: number else 128
		setZoomRange(plr, restoreMin, restoreMax)
	end
	savedMin = nil
	savedMax = nil
end

function AbilityCameraGuard.init(localPlayer: Player)
	player = localPlayer

	local function sync()
		local character = localPlayer.Character
		if shouldFreeze(character) then
			if not frozen then
				freezeZoom()
			else
				-- Keep zoom locked even if something else tries to change limits
				local z = math.clamp(currentZoom(), 0.5, 128)
				setZoomRange(localPlayer, z, z)
			end
		else
			unfreezeZoom()
		end
	end

	RunService.RenderStepped:Connect(sync)
	localPlayer.CharacterAdded:Connect(function()
		unfreezeZoom()
	end)
	localPlayer.CharacterRemoving:Connect(function()
		unfreezeZoom()
	end)
end

return AbilityCameraGuard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">AbilityInput</string>
            <string name="Source"><![CDATA[--!strict

local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MouseHelper = require(script.Parent.MouseHelper)
local SoftLockClient = require(script.Parent.SoftLockClient)
local TeleportMarkerClient = require(script.Parent.TeleportMarkerClient)
local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local AbilityInput = {}

local inputBlocked = false

local KEY_MAP = {
	[Enum.KeyCode.Q] = "Q",
	[Enum.KeyCode.E] = "E",
	[Enum.KeyCode.F] = "F",
	[Enum.KeyCode.T] = "T",
	[Enum.KeyCode.C] = "C",
	[Enum.KeyCode.V] = "V",
	[Enum.KeyCode.X] = "X",
	[Enum.KeyCode.G] = "G",
	[Enum.KeyCode.R] = "R",
	[Enum.KeyCode.B] = "B",
	[Enum.KeyCode.Z] = "Z",
	[Enum.KeyCode.H] = "H",
	[Enum.KeyCode.J] = "J",
}

local DECOY_MODE_KEYS = {
	[Enum.KeyCode.One] = "Punch",
	[Enum.KeyCode.Two] = "Run",
	[Enum.KeyCode.Three] = "Detonate",
	[Enum.KeyCode.Four] = "Lie of Place",
}

local ULT_ATTACK_KEYS = {
	[Enum.KeyCode.One] = "Attack",
	[Enum.KeyCode.Two] = "Idle",
}

local HOLD_FALLBACK = {
	E = true,
	T = true,
	C = true,
	B = true,
	Z = true,
}

local function isBarrierHold(character: Model): boolean
	return character:GetAttribute(GameConstants.MG_BARRIER_ATTRIBUTE) == true
		or character:GetAttribute(GameConstants.IW_FORCEFIELD_ATTRIBUTE) == true
end

local holdKeys: { [string]: boolean } = {}
local keyboardHold: { [string]: boolean } = {}
local SCROLL_ACTION = "MCU_AbilityScroll"

local player: Player? = nil
local useAbility: RemoteEvent? = nil

local function isHoldKeyForHero(key: string): boolean
	local plr = player
	local character = plr and plr.Character
	if character then
		local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
		if type(heroId) == "string" then
			local entry = CharacterRegistry.getAbilityByKey(heroId, key)
			if entry then
				return entry.hold == true
			end
		end
	end
	return HOLD_FALLBACK[key] == true
end

local function resolveAimPoint(): Vector3
	local plr = player
	if not plr then
		return Vector3.zero
	end
	local character = plr.Character
	if character and character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true then
		local mark = TeleportMarkerClient.getAimWorldPosition()
		if mark then
			return mark
		end
	end
	return MouseHelper.getHitPosition(plr, 200)
end

local function payload(action: string, withTarget: boolean?, targetOverride: Model?): { [string]: any }
	local plr = player :: Player
	local data: { [string]: any } = {
		action = action,
		direction = MouseHelper.getWorldDirection(plr),
		aimPoint = resolveAimPoint(),
		softLock = SoftLockClient.isEnabled(),
	}
	if withTarget then
		if SoftLockClient.isEnabled() then
			data.target = targetOverride or SoftLockClient.getLockedTarget()
		else
			data.target = targetOverride or MouseHelper.getHoveredCharacter(plr, 200)
		end
		data.hitPart = MouseHelper.getHoveredPart(plr, 200)
		data.interactable = MouseHelper.getHoveredInteractable(plr, 70)
	end
	return data
end

local function keyFromAction(action: string): string
	local key = string.split(action, "_")[1]
	return key or action
end

local function isMindLinkerPart(part: Instance?): boolean
	if not part then
		return false
	end
	if part.Name == "MindLinker" then
		return true
	end
	local parent = part.Parent
	return parent ~= nil and parent.Name == "MindLinker"
end

local function resolveTargetedFire(action: string): (boolean, Model?)
	local plr = player
	local character = plr and plr.Character
	if not character or not plr then
		return false, nil
	end
	local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
	if type(heroId) ~= "string" then
		return true, nil
	end
	local entry = CharacterRegistry.getAbilityByKey(heroId, keyFromAction(action))
	if not entry or entry.requiresTarget ~= true then
		if SoftLockClient.isEnabled() then
			return true, SoftLockClient.getLockedTarget()
		end
		return true, MouseHelper.getHoveredCharacter(plr, 200)
	end
	if SoftLockClient.isEnabled() then
		local locked = SoftLockClient.getLockedTarget()
		if locked then
			return true, locked
		end
		if entry.id == "mind_link" then
			return true, nil
		end
		return false, nil
	end
	local hovered = MouseHelper.getDirectHoveredCharacter(plr, 200)
	if hovered then
		return true, hovered
	end
	if entry.id == "mind_link" and isMindLinkerPart(MouseHelper.getHoveredPart(plr, 200)) then
		return true, nil
	end
	return false, nil
end

local function send(action: string, withTarget: boolean?): boolean
	local remote = useAbility
	if not remote then
		return false
	end
	local forcedTarget: Model? = nil
	if withTarget then
		local ok, target = resolveTargetedFire(action)
		if not ok then
			return false
		end
		forcedTarget = target
	end
	remote:FireServer(payload(action, withTarget, forcedTarget))
	return true
end

local function abilityIdForKey(character: Model, key: string): string?
	local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
	if type(heroId) ~= "string" then
		return nil
	end
	local entry = CharacterRegistry.getAbilityByKey(heroId, key)
	return if entry then entry.id else nil
end

local function isKeyOnCooldown(key: string): boolean
	local plr = player
	local character = plr and plr.Character
	if not character then
		return true
	end
	local abilityId = abilityIdForKey(character, key)
	if not abilityId then
		return false
	end
	if
		abilityId == "shapeshift"
		and character:GetAttribute(GameConstants.LOKI_SHAPESHIFT_ATTRIBUTE) == true
	then
		return false
	end
	if character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true then
		if abilityId == "teleportation" or abilityId == "trickster_dash" or abilityId == "hex_displacement" then
			return false
		end
	end
	if abilityId and AbilityCooldownHelper.isOnCooldown(character, abilityId) then
		return true
	end
	if abilityId and AbilityCooldownHelper.isActive(character, abilityId) then
		if abilityId == "rune_entrapment" then
			return true
		end
	end
	return false
end

local function isHoldRunning(key: string): boolean
	if holdKeys[key] then
		return true
	end
	local plr = player
	local character = plr and plr.Character
	if not character then
		return false
	end
	local abilityId = abilityIdForKey(character, key)
	if abilityId and AbilityCooldownHelper.isActive(character, abilityId) then
		return true
	end
	if character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true and (key == "E" or key == "R") then
		return true
	end
	if key == "C" and character:GetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE) == true then
		return true
	end
	if key == "Q" and character:GetAttribute(GameConstants.MG_BARRIER_ATTRIBUTE) == true then
		return true
	end
	return false
end

local function getMoveVector(): Vector3
	local plr = player
	local camera = workspace.CurrentCamera
	local move = Vector3.zero
	if camera then
		local look = camera.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude > 0.01 then
			flatLook = flatLook.Unit
		else
			flatLook = Vector3.new(0, 0, -1)
		end
		local right = camera.CFrame.RightVector
		local flatRight = Vector3.new(right.X, 0, right.Z)
		if flatRight.Magnitude > 0.01 then
			flatRight = flatRight.Unit
		else
			flatRight = Vector3.new(1, 0, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			move += flatLook
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			move -= flatLook
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			move -= flatRight
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			move += flatRight
		end
	end
	if move.Magnitude < 0.08 and plr and plr.Character then
		local hum = plr.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.MoveDirection.Magnitude > 0.08 then
			move = hum.MoveDirection
		end
	end
	return if move.Magnitude > 0.01 then move.Unit else Vector3.zero
end

local function swFlightAllowsKey(_character: Model, key: string): boolean
	return key == "F" or key == "R"
end

local function iwFlightAllowsKey(character: Model, key: string): boolean
	if key == "F" or key == "T" then
		return true
	end
	if character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern" then
		return key == "E" or key == "X"
	end
	return false
end

local function tkAllowsKey(character: Model, key: string): boolean
	if character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) ~= true then
		return true
	end
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "jean_grey" then
		return key == "R"
	end
	return key == "E"
end

local function otherAbilityBlocks(character: Model, key: string): boolean
	if key == "F" then
		return false
	end
	-- Astral companions: pain (C) / outburst (B) must work while astral (and barrier) stay active
	if character:GetAttribute(GameConstants.MG_ASTRAL_BODY_ATTRIBUTE) == true and (key == "C" or key == "B") then
		return false
	end
	-- Area Forcefield companions: Choke (B) / Protect (C) are usable only while X remains active.
	if
		character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "invisible_woman"
		and AbilityCooldownHelper.isActive(character, "forcefield_area")
		and (key == "B" or key == "C")
	then
		return false
	end
	return AbilityCooldownHelper.hasBlockingActive(character, abilityIdForKey(character, key))
end

local function iwAreaCompanionAllowed(character: Model, key: string): boolean
	return character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "invisible_woman"
		and AbilityCooldownHelper.isActive(character, "forcefield_area")
		and (key == "B" or key == "C")
end

local function iwAreaActionAllowed(character: Model, key: string): boolean
	return character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "invisible_woman"
		and AbilityCooldownHelper.isActive(character, "forcefield_area")
		and (key == "X" or key == "B" or key == "C")
end

local function beginHold(key: string)
	if inputBlocked then
		return
	end
	if not isHoldKeyForHero(key) then
		return
	end
	-- Jean barrier: only allow releasing C
	local character = player and player.Character
	if character then
		if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true
			and not iwAreaActionAllowed(character, key)
			or character:GetAttribute(GameConstants.MG_HAIR_SWITCHING_ATTRIBUTE) == true
			or character:GetAttribute(GameConstants.MG_TK_CONTROLLED_ATTRIBUTE) == true
			or CombatHelper.arePowersDisabled(character)
		then
			return
		end
		if otherAbilityBlocks(character, key) then
			return
		end
		if not tkAllowsKey(character, key) then
			return
		end
		if isBarrierHold(character) and key ~= "Q" then
			if iwAreaCompanionAllowed(character, key) then
				-- Choke / Protect while Area Forcefield is active
			elseif key == "C" and character:GetAttribute(GameConstants.MG_ASTRAL_BODY_ATTRIBUTE) == true then
				-- Jean astral outburst while barrier is up
			else
				return
			end
		end
		if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "scarlet_witch"
			and character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
			and not swFlightAllowsKey(character, key)
		then
			return
		end
		if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "invisible_woman"
			and character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
			and not iwFlightAllowsKey(character, key)
		then
			return
		end
	end
	if isKeyOnCooldown(key) then
		return
	end
	local sent = if key == "E" or key == "Z" or key == "X" or key == "R" or key == "C" or key == "B"
		then send(key .. "_down", true)
		else send(key .. "_down")
	if sent then
		holdKeys[key] = true
	end
end

local function endHold(key: string)
	if not holdKeys[key] and not isHoldRunning(key) then
		return
	end
	holdKeys[key] = false
	send(key .. "_up")
end

local function fireTap(key: string)
	if inputBlocked then
		return
	end
	local character = player and player.Character
	if key == "J" then
		if character then
			if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "jean_grey" then
				return
			end
			if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
				or character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true
				or character:GetAttribute(GameConstants.MG_ASTRAL_BODY_ATTRIBUTE) == true
			then
				return
			end
			if character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "marvel_girl" then
				return
			end
			if AbilityCooldownHelper.isOnCooldown(character, "jean_hair") then
				return
			end
			if character:GetAttribute(GameConstants.MG_HAIR_SWITCHING_ATTRIBUTE) == true then
				return
			end
			if character:GetAttribute(GameConstants.MG_TK_CONTROLLED_ATTRIBUTE) == true
				or CombatHelper.arePowersDisabled(character)
				or character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true
			then
				return
			end
		end
		send("J")
		return
	end
	if character then
		if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true
			and not iwAreaActionAllowed(character, key)
			or character:GetAttribute(GameConstants.MG_HAIR_SWITCHING_ATTRIBUTE) == true
			or character:GetAttribute(GameConstants.MG_TK_CONTROLLED_ATTRIBUTE) == true
			or CombatHelper.arePowersDisabled(character)
		then
			return
		end
		if otherAbilityBlocks(character, key) then
			return
		end
		if not tkAllowsKey(character, key) then
			return
		end
		-- Barrier: only astral (H / V) may fire; other taps blocked
		-- Barrier: Jean may still astral (H / V); Invisible Woman blocks all other taps
		if character:GetAttribute(GameConstants.IW_FORCEFIELD_ATTRIBUTE) == true
			and not iwAreaActionAllowed(character, key)
		then
			return
		end
		if character:GetAttribute(GameConstants.MG_BARRIER_ATTRIBUTE) == true and key ~= "H" and key ~= "V" then
			if not (character:GetAttribute(GameConstants.MG_ASTRAL_BODY_ATTRIBUTE) == true and (key == "B" or key == "C")) then
				return
			end
		end
		if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "scarlet_witch"
			and character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
			and not swFlightAllowsKey(character, key)
		then
			return
		end
		if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "invisible_woman"
			and character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
			and not iwFlightAllowsKey(character, key)
		then
			return
		end
	end
	if isKeyOnCooldown(key) then
		return
	end
	local remote = useAbility
	if not remote then
		return
	end
	local plr = player :: Player
	local heroId = character and character:GetAttribute(GameConstants.HERO_ATTRIBUTE)

	if key == "F" then
		-- Dagger Light Veil is a projectile toward aim (same as Q); others use F for flight/dash
		if heroId == "dagger" then
			send("F")
		else
			remote:FireServer({
				action = "F",
				direction = MouseHelper.getWorldDirection(plr),
				aimPoint = resolveAimPoint(),
				moveVector = getMoveVector(),
			})
		end
	elseif key == "X" or key == "G" or key == "V" or key == "T" or key == "E" or key == "R" or key == "C" or key == "Z" or key == "H" or key == "B" then
		send(key, true)
	else
		local entry = if character and type(heroId) == "string"
			then CharacterRegistry.getAbilityByKey(heroId, key)
			else nil
		if entry and entry.requiresTarget == true then
			send(key, true)
		else
			send(key)
		end
	end
end

--[[ HUD / mobile: press ability button. Hold abilities toggle on/off. ]]
function AbilityInput.setInputBlocked(blocked: boolean)
	inputBlocked = blocked == true
end

function AbilityInput.triggerFromHud(key: string, isHold: boolean?)
	if type(key) ~= "string" or key == "" then
		return
	end
	local character = player and player.Character
	if character and isBarrierHold(character) then
		-- Shield release (Q) or Jean astral (H) while barrier is up
		if key == "Q" and (isHold == true or isHoldKeyForHero(key)) then
			if isHoldRunning(key) then
				endHold(key)
			end
			return
		end
		if iwAreaCompanionAllowed(character, key) then
			if isHold == true or isHoldKeyForHero(key) then
				if isHoldRunning(key) then
					endHold(key)
				else
					beginHold(key)
				end
			end
			return
		end
		if character:GetAttribute(GameConstants.MG_BARRIER_ATTRIBUTE) == true and (key == "H" or key == "V") then
			fireTap(key)
			return
		end
		return
	end
	if isHold == true or isHoldKeyForHero(key) then
		if isHoldRunning(key) then
			endHold(key)
		else
			beginHold(key)
		end
		return
	end
	fireTap(key)
end

function AbilityInput.init(localPlayer: Player)
	player = localPlayer
	useAbility = Remotes.getEvent("UseAbility")
	local flightInput = Remotes.getEvent("FlightInput")

	local function hookDeathFlight(character: Model)
		local hum = character:WaitForChild("Humanoid", 8)
		if not hum or not hum:IsA("Humanoid") then
			return
		end
		local function reportDead()
			if flightInput then
				flightInput:FireServer({ dead = true })
			end
		end
		hum.Died:Connect(reportDead)
		hum.HealthChanged:Connect(function(hp)
			if hp <= 0 then
				reportDead()
			end
		end)
		if hum.Health <= 0 then
			reportDead()
		end
	end
	localPlayer.CharacterAdded:Connect(hookDeathFlight)
	if localPlayer.Character then
		task.spawn(hookDeathFlight, localPlayer.Character)
	end

	-- Stream live mouse aim while Lumen Barrage / Jean slam / Jean bolts are active
	local lastBarrageAimAt = 0
	RunService.Heartbeat:Connect(function()
		local character = localPlayer.Character
		if not character or not useAbility then
			return
		end
		local now = os.clock()
		if now - lastBarrageAimAt < 0.03 then
			return
		end
		if AbilityCooldownHelper.isActive(character, "lumen_barrage") then
			lastBarrageAimAt = now
			useAbility:FireServer({
				action = "X_aim",
				direction = MouseHelper.getWorldDirection(localPlayer),
				aimPoint = resolveAimPoint(),
			})
		elseif AbilityCooldownHelper.isActive(character, "telekinetic_slam") then
			lastBarrageAimAt = now
			useAbility:FireServer({
				action = "X_aim",
				direction = MouseHelper.getWorldDirection(localPlayer),
				aimPoint = resolveAimPoint(),
			})
		elseif AbilityCooldownHelper.isActive(character, "telekinetic_debris") then
			lastBarrageAimAt = now
			useAbility:FireServer({
				action = "Z_aim",
				direction = MouseHelper.getWorldDirection(localPlayer),
				aimPoint = resolveAimPoint(),
			})
		elseif
			AbilityCooldownHelper.isActive(character, "disc_throw")
			or AbilityCooldownHelper.isActive(character, "forcefield_push")
			or AbilityCooldownHelper.isActive(character, "forcefield_area")
			or AbilityCooldownHelper.isActive(character, "forcefield_crush")
		then
			lastBarrageAimAt = now
			useAbility:FireServer({
				action = "Iw_aim",
				direction = MouseHelper.getWorldDirection(localPlayer),
				aimPoint = resolveAimPoint(),
			})
		end
	end)

	local function handleAbilityScroll(scrollDelta: number)
		local character = localPlayer.Character
		if not character then
			return false
		end
		local tkActive = character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true
		local teleportAiming = character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true
		if not tkActive and not teleportAiming then
			return false
		end
			if tkActive then
				useAbility:FireServer({
					action = if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "jean_grey"
						then "R_scroll"
						else "E_scroll",
					scroll = scrollDelta,
					direction = MouseHelper.getWorldDirection(localPlayer),
					aimPoint = MouseHelper.getHitPosition(localPlayer, 200),
				})
			end
		if teleportAiming then
			local hero = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
			if hero ~= "scarlet_witch" then
				TeleportMarkerClient.adjustRange(scrollDelta)
			end
		end
		return true
	end

	ContextActionService:BindActionAtPriority(SCROLL_ACTION, function(_name, inputState, inputObject)
		if inputState ~= Enum.UserInputState.Change then
			return Enum.ContextActionResult.Pass
		end
		if handleAbilityScroll(inputObject.Position.Z) then
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.High.Value + 55, Enum.UserInputType.MouseWheel)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		-- TK throw / teleport confirm (mouse / touch elsewhere handled by SoftLock / screen)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local character = localPlayer.Character
			local tkActive = character and character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true
			if tkActive then
				-- Push/throw the held victim; do not require mouse-on-target.
				if character and character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "jean_grey" then
					send("R_throw")
				else
					send("E_throw")
				end
				return
			end
			if holdKeys.E then
				send("E_throw")
				return
			end
			if character and AbilityCooldownHelper.isActive(character, "telekinetic_debris") then
				send("Z_throw", true)
				return
			end
			if character and character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true then
				local hero = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
				if hero == "loki" then
					send("F_confirm")
				elseif hero == "scarlet_witch" then
					send("V_confirm")
				end
				return
			end
		end

		if gameProcessed then
			return
		end

		local decoyMode = DECOY_MODE_KEYS[input.KeyCode]
		local ultMode = ULT_ATTACK_KEYS[input.KeyCode]
		if decoyMode or ultMode then
			local character = localPlayer.Character
			if character and character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "loki" then
				if character:GetAttribute(GameConstants.LOKI_CLONE_ACTIVE_ATTRIBUTE) == true and decoyMode then
					useAbility:FireServer({
						action = "SetMode",
						abilityId = "illusion_decoy",
						mode = decoyMode,
					})
					character:SetAttribute(GameConstants.LOKI_CLONE_MODE_ATTRIBUTE, decoyMode)
					return
				end
				if character:GetAttribute(GameConstants.LOKI_ULT_ACTIVE_ATTRIBUTE) == true and ultMode then
					useAbility:FireServer({
						action = "SetMode",
						abilityId = "god_of_mischief",
						mode = ultMode,
					})
					character:SetAttribute(
						GameConstants.LOKI_ULT_ATTACK_ATTRIBUTE,
						if ultMode == "Attack" then true else false
					)
					return
				end
			end
		end

		local key = KEY_MAP[input.KeyCode]
		if not key then
			return
		end

		if isHoldKeyForHero(key) then
			keyboardHold[key] = true
			beginHold(key)
		else
			fireTap(key)
		end
	end)

	UserInputService.InputEnded:Connect(function(input, _gameProcessed)
		local key = KEY_MAP[input.KeyCode]
		if key and keyboardHold[key] then
			keyboardHold[key] = false
			endHold(key)
		end
	end)

	localPlayer.CharacterRemoving:Connect(function()
		for key, held in holdKeys do
			if held then
				send(key .. "_up")
			end
		end
		table.clear(holdKeys)
		table.clear(keyboardHold)
	end)

	task.spawn(function()
		while true do
			task.wait(0.04)
			if holdKeys.T then
				send("T_aim")
			end
			if holdKeys.E then
				send("E_update")
			end
			if holdKeys.R then
				send("R_update")
			end
			local character = localPlayer.Character
			if
				character
				and character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "loki"
				and character:GetAttribute(GameConstants.LOKI_CLONE_ACTIVE_ATTRIBUTE) == true
			then
				send("E_update")
			end
		end
	end)
end

return AbilityInput
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">BeamClashClient</string>
