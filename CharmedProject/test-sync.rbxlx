spellsTitle.Parent = spellsFrame

local spellsPadding = Instance.new("UIPadding")
spellsPadding.PaddingTop = UDim.new(0, 6)
spellsPadding.PaddingLeft = UDim.new(0, 6)
spellsPadding.PaddingRight = UDim.new(0, 6)
spellsPadding.PaddingBottom = UDim.new(0, 6)
spellsPadding.Parent = spellsFrame

local function prefillChatPlaceholder(text: string)
	local config = TextChatService:FindFirstChild("ChatInputBarConfiguration")
	if not config then
		return
	end
	pcall(function()
		(config :: any).PlaceholderText = text
	end)
end

local selectedCharacter: string? = nil
local humanoidConn: RBXScriptConnection? = nil
local energyConn: RBXScriptConnection? = nil
local mouse = player:GetMouse()
local levitationControlLoopRunning = false
local powerButtons: { TextButton } = {}
local powerButtonById: { [string]: TextButton } = {}
local cooldownOverlayById: { [string]: Frame } = {}
local cooldownLabelById: { [string]: TextLabel } = {}
local activeAbilities: { [string]: boolean } = {}
local keybindByPowerId: { [string]: Enum.KeyCode } = {}
local powerByKeyCode: { [Enum.KeyCode]: { Id: string, Name: string } } = {}
local keybindOverrideByPowerId: { [string]: Enum.KeyCode } = {
	telekinetic_deviation = Enum.KeyCode.Q,
	telekinesis = Enum.KeyCode.E,
}
local keybindOrder: { Enum.KeyCode } = {
	Enum.KeyCode.Q,
	Enum.KeyCode.E,
	Enum.KeyCode.R,
	Enum.KeyCode.F,
	Enum.KeyCode.T,
}
local startTelekinesisHold: () -> ()
local stopTelekinesisHold: () -> ()

local SPELL_DEFINITIONS = {
	{
		name = "Power of Three",
		text = "The power of three will set us free.",
	},
	{
		name = "Return to Sender",
		text = "Let the object of objection become but a dream, as I cause the scene to be no more than it seems.",
	},
	{
		name = "Binding",
		text = "I bind thee from doing harm, harm against others and harm against yourself.",
	},
}

local function keyCodeToText(code: Enum.KeyCode): string
	return code.Name
end

local function clearPowerButtons()
	for _, button in powerButtons do
		button:Destroy()
	end
	table.clear(powerButtons)
	table.clear(powerButtonById)
	table.clear(cooldownOverlayById)
	table.clear(cooldownLabelById)
	table.clear(activeAbilities)
	table.clear(keybindByPowerId)
	table.clear(powerByKeyCode)
end

local function setAbilityButtonActive(powerId: string, isActive: boolean)
	activeAbilities[powerId] = isActive
	local button = powerButtonById[powerId]
	if button then
		button.BackgroundColor3 = if isActive then Color3.fromRGB(56, 86, 146) else Color3.fromRGB(18, 23, 36)
	end
	if powerId == "levitation" and isActive and not levitationControlLoopRunning then
		levitationControlLoopRunning = true
		task.spawn(function()
			while levitationControlLoopRunning do
				if not activeAbilities.levitation then
					break
				end
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local camera = Workspace.CurrentCamera
				if humanoid and camera then
					powerCastRemoteEvent:FireServer("levitation", nil, humanoid.MoveDirection, "update", camera.CFrame.LookVector)
				end
				task.wait(0.06)
			end
			levitationControlLoopRunning = false
		end)
	elseif powerId == "levitation" and not isActive then
		levitationControlLoopRunning = false
	end
end

local function startCooldownVisual(powerId: string, cooldownSeconds: number)
	local overlay = cooldownOverlayById[powerId]
	local label = cooldownLabelById[powerId]
	if not overlay or not label then
		return
	end
	if cooldownSeconds <= 0 then
		overlay.Visible = false
		label.Text = ""
		return
	end

	overlay.Visible = true
	local startedAt = os.clock()
	task.spawn(function()
		while overlay.Parent do
			local elapsed = os.clock() - startedAt
			local left = math.max(cooldownSeconds - elapsed, 0)
			local ratio = left / cooldownSeconds
			overlay.AnchorPoint = Vector2.new(0, 0)
			overlay.Position = UDim2.new(0, 0, 0, 0)
			overlay.Size = UDim2.new(ratio, 0, 1, 0)
			label.Text = if left > 0 then string.format("%.1f", left) else ""
			if left <= 0 then
				overlay.Visible = false
				break
			end
			task.wait(0.05)
		end
	end)
end

local function buildPowerButtons(characterName: string)
	clearPowerButtons()
	local powers = CharacterConfig.PowersByCharacter[characterName]
	if type(powers) ~= "table" then
		powerFrame.Visible = false
		return
	end

	local usedKeys: { [Enum.KeyCode]: boolean } = {}
	for index, power in powers do
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, 0, 0.14, 0)
		button.BackgroundColor3 = Color3.fromRGB(18, 23, 36)
		button.BorderSizePixel = 0
		button.Text = power.Name
		button.TextColor3 = Color3.fromRGB(222, 232, 248)
		button.TextSize = 11
		button.TextWrapped = true
		button.Font = Enum.Font.GothamBold
		button.AutoButtonColor = true
		button.Parent = powerFrame

		local keyCode = keybindOverrideByPowerId[power.Id]
		if keyCode then
			usedKeys[keyCode] = true
		else
			for _, candidate in keybindOrder do
				if not usedKeys[candidate] then
					keyCode = candidate
					usedKeys[candidate] = true
					break
				end
			end
		end
		if keyCode then
			keybindByPowerId[power.Id] = keyCode
			powerByKeyCode[keyCode] = { Id = power.Id, Name = power.Name }
		end
		powerButtonById[power.Id] = button

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = button

		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(85, 106, 140)
		stroke.Thickness = 1.2
		stroke.Parent = button

		local overlay = Instance.new("Frame")
		overlay.Name = "CooldownOverlay"
		overlay.BackgroundColor3 = Color3.fromRGB(4, 6, 11)
		overlay.BackgroundTransparency = 0.35
		overlay.BorderSizePixel = 0
		overlay.Size = UDim2.new(1, 0, 1, 0)
		overlay.Position = UDim2.new(0, 0, 0, 0)
		overlay.Visible = false
		overlay.ZIndex = button.ZIndex + 1
		overlay.Parent = button

		local overlayCorner = Instance.new("UICorner")
		overlayCorner.CornerRadius = UDim.new(0, 6)
		overlayCorner.Parent = overlay

		local cooldownLabel = Instance.new("TextLabel")
		cooldownLabel.Name = "CooldownLabel"
		cooldownLabel.BackgroundTransparency = 1
		cooldownLabel.Size = UDim2.new(1, 0, 1, 0)
		cooldownLabel.Position = UDim2.new(0, 0, 0, 0)
		cooldownLabel.Font = Enum.Font.GothamBold
		cooldownLabel.TextSize = 13
		cooldownLabel.TextColor3 = Color3.fromRGB(222, 232, 248)
		cooldownLabel.Text = ""
		cooldownLabel.ZIndex = overlay.ZIndex + 1
		cooldownLabel.Parent = overlay
		cooldownOverlayById[power.Id] = overlay
		cooldownLabelById[power.Id] = cooldownLabel

		local keyLabel = Instance.new("TextLabel")
		keyLabel.BackgroundTransparency = 1
		keyLabel.Size = UDim2.new(0.2, 0, 0.3, 0)
		keyLabel.Position = UDim2.new(0.79, 0, 0.03, 0)
		keyLabel.Font = Enum.Font.Gotham
		keyLabel.TextSize = 10
		keyLabel.TextColor3 = Color3.fromRGB(155, 174, 210)
		keyLabel.TextXAlignment = Enum.TextXAlignment.Center
		keyLabel.Text = if keyCode then keyCodeToText(keyCode) else ""
		keyLabel.Parent = button

		button.MouseButton1Click:Connect(function()
			if power.Id == "telekinesis" then
				if activeAbilities.telekinesis then
					stopTelekinesisHold()
				else
					startTelekinesisHold()
				end
				return
			end
			if power.Id == "astral_projection" or power.Id == "molecular_freeze" or power.Id == "premonition" or power.Id == "levitation" or power.Id == "healing" then
				if activeAbilities[power.Id] then
					powerCastRemoteEvent:FireServer(power.Id, mouse.Target, mouse.Hit.Position, "stop")
				else
					powerCastRemoteEvent:FireServer(power.Id, mouse.Target, mouse.Hit.Position, "start")
				end
				return
			end
			powerCastRemoteEvent:FireServer(power.Id, mouse.Target, mouse.Hit.Position)
		end)

		table.insert(powerButtons, button)
	end

	powerFrame.Visible = #powerButtons > 0
end

spellsButton.MouseButton1Click:Connect(function()
	spellsFrame.Visible = not spellsFrame.Visible
end)

for _, spell in SPELL_DEFINITIONS do
	local button = Instance.new("TextButton")
	button.Name = "Spell_" .. spell.name
	button.AutoButtonColor = true
	button.BackgroundColor3 = Color3.fromRGB(17, 22, 32)
	button.BorderSizePixel = 0
	button.Size = UDim2.new(1, -12, 0, 24)
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.Font = Enum.Font.Gotham
	button.TextSize = 14
	button.TextColor3 = Color3.fromRGB(220, 225, 240)
	button.Text = spell.name
	button.Parent = spellsFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = button

	button.MouseButton1Click:Connect(function()
		prefillChatPlaceholder(spell.text)
	end)
end

local function updateBar(fillFrame: Frame, ratio: number)
	fillFrame.Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 0.5, 0)
end

local function updateHealthUi(humanoid: Humanoid)
	local maxHealth = math.max(humanoid.MaxHealth, 1)
	local health = math.clamp(humanoid.Health, 0, maxHealth)
	healthLabel.Text = string.format("HEALTH %d/%d", math.floor(health + 0.5), math.floor(maxHealth + 0.5))
	updateBar(healthFill, health / maxHealth)
end

local function updateEnergyUi(energyValue: number)
	local maxEnergy = math.max(CharacterConfig.DefaultEnergy, 1)
	local current = math.clamp(energyValue, 0, maxEnergy)
	energyLabel.Text = string.format("ENERGY %d/%d", math.floor(current + 0.5), maxEnergy)
	updateBar(energyFill, current / maxEnergy)
end

local telekinesisActive = false

function startTelekinesisHold()
	if telekinesisActive then
		return
	end
	telekinesisActive = true
	setAbilityButtonActive("telekinesis", true)
	powerCastRemoteEvent:FireServer("telekinesis", mouse.Target, mouse.Hit.Position, "start")
	task.spawn(function()
		while telekinesisActive do
			powerCastRemoteEvent:FireServer("telekinesis", mouse.Target, mouse.Hit.Position, "update")
			task.wait(0.06)
		end
	end)
end

function stopTelekinesisHold()
	if not telekinesisActive then
		return
	end
	telekinesisActive = false
	setAbilityButtonActive("telekinesis", false)
	powerCastRemoteEvent:FireServer("telekinesis", mouse.Target, mouse.Hit.Position, "stop")
end

local function hookCharacter(character: Model)
	if humanoidConn then
		humanoidConn:Disconnect()
		humanoidConn = nil
	end
	if energyConn then
		energyConn:Disconnect()
		energyConn = nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	updateHealthUi(humanoid)
	humanoidConn = humanoid.HealthChanged:Connect(function()
		updateHealthUi(humanoid)
	end)

	updateEnergyUi((player:GetAttribute("Energy") or CharacterConfig.DefaultEnergy) :: number)
	energyConn = player:GetAttributeChangedSignal("Energy"):Connect(function()
		local energy = player:GetAttribute("Energy")
		if type(energy) == "number" then
			updateEnergyUi(energy)
		end
	end)
end

for _, characterName in CharacterConfig.Choices do
	local button = Instance.new("TextButton")
	button.Text = characterName
	button.Font = Enum.Font.GothamBold
	button.TextSize = 20
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.BackgroundColor3 = Color3.fromRGB(21, 28, 41)
	button.AutoButtonColor = true
	button.BorderSizePixel = 0
	button.Parent = buttonsFrame

	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(0, 8)
	buttonCorner.Parent = button

	button.MouseButton1Click:Connect(function()
		selectedCharacter = characterName
		statsFrame.Visible = true
		powerFrame.Visible = true
		chooserFrame.Visible = false
		(selectRemote :: RemoteEvent):FireServer(characterName)
		buildPowerButtons(characterName)

		local character = player.Character
		if character then
			hookCharacter(character)
		end
	end)
end

player.CharacterAdded:Connect(function(character)
	selectedCharacter = nil
	chooserFrame.Visible = true
	statsFrame.Visible = false
	powerFrame.Visible = false
	clearPowerButtons()
	player:SetAttribute("ChosenCharacter", nil)
	stopTelekinesisHold()
	levitationControlLoopRunning = false
	hookCharacter(character)
end)

UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if gameProcessed then
		return
	end
	if not selectedCharacter then
		return
	end
	local powerData = powerByKeyCode[input.KeyCode]
	if not powerData then
		return
	end
	if powerData.Id == "telekinesis" then
		startTelekinesisHold()
	elseif powerData.Id == "astral_projection" or powerData.Id == "molecular_freeze" or powerData.Id == "premonition" or powerData.Id == "levitation" or powerData.Id == "healing" then
		if activeAbilities[powerData.Id] then
			powerCastRemoteEvent:FireServer(powerData.Id, mouse.Target, mouse.Hit.Position, "stop")
		else
			powerCastRemoteEvent:FireServer(powerData.Id, mouse.Target, mouse.Hit.Position, "start")
		end
	else
		powerCastRemoteEvent:FireServer(powerData.Id, mouse.Target, mouse.Hit.Position)
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject, _gameProcessed: boolean)
	local teleKey = keybindByPowerId.telekinesis
	if teleKey and input.KeyCode == teleKey then
		stopTelekinesisHold()
	end
end)

mouse.Button1Down:Connect(function()
	if telekinesisActive and selectedCharacter then
		powerCastRemoteEvent:FireServer("telekinesis", mouse.Target, mouse.Hit.Position, "push")
	end
end)

powerCastRemoteEvent.OnClientEvent:Connect(function(action: any, targetHumanoid: any, duration: any)
	if action == "ability_cooldown" then
		if typeof(targetHumanoid) == "string" and type(duration) == "number" then
			startCooldownVisual(targetHumanoid, duration)
		end
		return
	end
	if action == "ability_state" then
		if typeof(targetHumanoid) == "string" and type(duration) == "boolean" then
			setAbilityButtonActive(targetHumanoid, duration)
		end
		return
	end
	if action == "premonition_stop" then
		local camera = Workspace.CurrentCamera
		local localCharacter = player.Character
		local localHumanoid = localCharacter and localCharacter:FindFirstChildOfClass("Humanoid")
		if camera and localHumanoid then
			camera.CameraSubject = localHumanoid
		end
		return
	end
	if action ~= "premonition_view" then
		return
	end
	if typeof(targetHumanoid) ~= "Instance" or not targetHumanoid:IsA("Humanoid") then
		return
	end

	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	local previousSubject = camera.CameraSubject
	camera.CameraSubject = targetHumanoid

	task.delay(type(duration) == "number" and duration or 4, function()
		if not camera.Parent then
			return
		end
		local localCharacter = player.Character
		local localHumanoid = localCharacter and localCharacter:FindFirstChildOfClass("Humanoid")
		if localHumanoid then
			camera.CameraSubject = localHumanoid
		elseif previousSubject then
			camera.CameraSubject = previousSubject
		end
	end)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="20">
          <Properties>
            <string name="Name">RagdollController</string>
            <string name="Source"><![CDATA[--[[
	Local visuals for living Ragdolled status: disable Animate, match Humanoid state.
	R is not used — server applies constraint ragdoll when Ragdolled is true (same duration as status).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer

local ignoreIDs = {
	100114491214554,
}

local ragdollConn: RBXScriptConnection? = nil
local humanoidStateConn: RBXScriptConnection? = nil

local function stopNonAbilityAnimations(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		local animation = track.Animation
		if animation and CollectionService:HasTag(animation, "AbilityAnims") then
			continue
		end
		local id = animation and animation.AnimationId
		local idNum = id and tonumber((id :: string):match("%d+")) or nil
		if idNum and table.find(ignoreIDs, idNum) then
			task.delay(1, function()
				track:Stop()
			end)
		else
			track:Stop()
		end
	end
end

local function applyLocalRagdollVisual(enabled: boolean)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid then
		return
	end

	local animate = character:FindFirstChild("Animate")
	if enabled then
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		stopNonAbilityAnimations(humanoid)
		if animate and animate:IsA("LocalScript") then
			animate.Disabled = true
		end
	else
		if animate and animate:IsA("LocalScript") then
			animate.Disabled = false
		end
		if humanoid.Health > 0 and character:GetAttribute("CombatDeathHandled") ~= true then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

local function onRagdolledAttributeChanged(character: Model)
	applyLocalRagdollVisual(character:GetAttribute("Ragdolled") == true)
end

local function bindHumanoidStateGuard(character: Model, humanoid: Humanoid)
	if humanoidStateConn then
		humanoidStateConn:Disconnect()
		humanoidStateConn = nil
	end
	humanoidStateConn = humanoid.StateChanged:Connect(function(_, newState)
		if newState == Enum.HumanoidStateType.FallingDown then
			if
				character:GetAttribute("Ragdolled") == true
				or humanoid.Health <= 0
				or character:GetAttribute("CombatDeathHandled") == true
			then
				return
			end
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
		local animate = character:FindFirstChild("Animate")
		if not animate or not animate:IsA("LocalScript") then
			return
		end
		if character:GetAttribute("Ragdolled") ~= true then
			return
		end
		if newState ~= Enum.HumanoidStateType.Physics and newState ~= Enum.HumanoidStateType.GettingUp and animate.Disabled then
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end
	end)
end

local function onCharacterAdded(character: Model)
	if ragdollConn then
		ragdollConn:Disconnect()
		ragdollConn = nil
	end

	ragdollConn = character:GetAttributeChangedSignal("Ragdolled"):Connect(function()
		onRagdolledAttributeChanged(character)
	end)

	local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
	if not humanoid then
		return
	end
	bindHumanoidStateGuard(character, humanoid)
	onRagdolledAttributeChanged(character)
end

if player.Character then
	onCharacterAdded(player.Character)
end
player.CharacterAdded:Connect(onCharacterAdded)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="21">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>