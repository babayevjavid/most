	refreshLokiUltPanel = function()
		local show = currentHeroId == "loki"
			and boundCharacter ~= nil
			and boundCharacter:GetAttribute(GameConstants.LOKI_ULT_ACTIVE_ATTRIBUTE) == true
		lokiUltPanel.Visible = show
