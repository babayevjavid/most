function CharacterRegistry.getRoster(): { CharacterEntry }
	return ROSTER
end

function CharacterRegistry.getById(id: string): CharacterEntry?
	if id == "scarlet_witch" then
		id = "scarlet_witch_classic"
	end
	for _, entry in ROSTER do
		if entry.id == id then
			return entry
		end
	end
	return nil
end

function CharacterRegistry.getSkin(entry: CharacterEntry, skinId: string?): SkinDef
	local wanted = if type(skinId) == "string" and skinId ~= "" then skinId else "base"
	for _, skin in entry.skins do
		if skin.id == wanted then
			if skin.blocked then
				break
			end
			return skin
		end
	end
	for _, skin in entry.skins do
		if not skin.blocked then
			return skin
		end
	end
	return entry.skins[1]
end

function CharacterRegistry.getAvailableSkins(entry: CharacterEntry): { SkinDef }
	local list: { SkinDef } = {}
	for _, skin in entry.skins do
		if not skin.blocked then
			table.insert(list, skin)
		end
	end
	return list
end

function CharacterRegistry.getMorphName(heroId: string, skinId: string?): string?
	local entry = CharacterRegistry.getById(heroId)
	if not entry then
		return nil
	end
	return CharacterRegistry.getSkin(entry, skinId).morphName
end

function CharacterRegistry.getMorphTemplate(heroId: string, skinId: string?): Model?
	local morphName = CharacterRegistry.getMorphName(heroId, skinId)
	if not morphName then
		return nil
	end
	local assets = game:GetService("ReplicatedStorage"):FindFirstChild("Assets")
	local morphs = assets and assets:FindFirstChild("Morphs")
	local template = morphs and morphs:FindFirstChild(morphName)
	if template and template:IsA("Model") then
		return template
	end
	return nil
end

function CharacterRegistry.getAbilities(characterId: string): { AbilityDef }
	local entry = CharacterRegistry.getById(characterId)
	if not entry then
		return {}
	end
	return entry.abilities
end

function CharacterRegistry.getAbilityByKey(characterId: string, key: string): AbilityDef?
	for _, ability in CharacterRegistry.getAbilities(characterId) do
		if ability.key == key then
			return ability
		end
	end
	return nil
end

function CharacterRegistry.getAbilityById(characterId: string, abilityId: string): AbilityDef?
	for _, ability in CharacterRegistry.getAbilities(characterId) do
		if ability.id == abilityId then
			return ability
		end
	end
	return nil
end

function CharacterRegistry.resolveAbilityIcon(ability: AbilityDef, mode: string?): string?
	if mode and ability.modeIcons then
		local byMode = ability.modeIcons[mode]
		if type(byMode) == "string" and byMode ~= "" then
			return byMode
		end
	end
	if type(ability.icon) == "string" and ability.icon ~= "" then
		return ability.icon
	end
	return nil
end

return CharacterRegistry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">CombatHelper</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)

local CombatHelper = {}

local shieldDamageHandler: ((Model, number, Vector3?) -> boolean)? = nil

function CombatHelper.setShieldDamageHandler(handler: (Model, number, Vector3?) -> boolean)
	shieldDamageHandler = handler
end

function CombatHelper.getCharacterFromPart(part: BasePart?): Model?
	if not part then
		return nil
	end
	-- Walk up so nested Models (clothing/props) under a character still resolve
	local current: Instance? = part
	while current do
		if current:IsA("Model") then
			if current:GetAttribute("FearVisual") == true or current.Name == "FearClone" then
				return nil
			end
			local hum = current:FindFirstChildOfClass("Humanoid")
			if hum then
				return current
			end
		end
		current = current.Parent
	end
	return nil
end

function CombatHelper.silenceDeathSounds(model: Model?)
	if not model then
		return
	end
	local function mute(sound: Sound)
		sound.Volume = 0
		sound.Playing = false
		pcall(function()
			sound:Stop()
		end)
		pcall(function()
			sound.SoundId = ""
		end)
	end
	for _, desc in model:GetDescendants() do
		if desc:IsA("Sound") then
			local name = string.lower(desc.Name)
			local id = string.lower(desc.SoundId)
			if
				name == "died"
				or name == "death"
				or name == "oof"
				or string.find(name, "died", 1, true)
				or string.find(id, "uuhhh", 1, true)
				or string.find(id, "oof", 1, true)
			then
				mute(desc)
			end
		end
	end
end

--[[ Keep death OOF muted even if Roblox adds the Died sound later. ]]
function CombatHelper.bindSilenceDeathSounds(model: Model?)
	if not model then
		return
	end
	CombatHelper.silenceDeathSounds(model)
	if model:GetAttribute("DeathSoundSilenced") == true then
		return
	end
	model:SetAttribute("DeathSoundSilenced", true)
	model.DescendantAdded:Connect(function(desc)
		if not desc:IsA("Sound") then
			return
		end
		local name = string.lower(desc.Name)
		local id = string.lower(desc.SoundId)
		if
			name == "died"
			or name == "death"
			or name == "oof"
			or string.find(name, "died", 1, true)
			or string.find(id, "uuhhh", 1, true)
			or string.find(id, "oof", 1, true)
		then
			desc.Volume = 0
			desc.Playing = false
			pcall(function()
				desc:Stop()
			end)
			pcall(function()
				desc.SoundId = ""
			end)
		end
	end)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Died:Connect(function()
			CombatHelper.silenceDeathSounds(model)
		end)
	end
end

function CombatHelper.getHumanoid(model: Model?): Humanoid?
	if not model then
		return nil
	end
	return model:FindFirstChildOfClass("Humanoid")
end

function CombatHelper.isCombatEligible(model: Model): boolean
	if model:GetAttribute(GameConstants.MG_ASTRAL_ATTRIBUTE) == true then
		return false
	end
	if model:GetAttribute(GameConstants.PROB_HEX_OBJECT_ATTRIBUTE) == true then
		return false
	end
	local protectedUntil = model:GetAttribute(GameConstants.PROTECTED_UNTIL_ATTRIBUTE)
	if type(protectedUntil) == "number" and protectedUntil > AbilityCooldownHelper.getNow() then
		return false
	end
	local plr = Players:GetPlayerFromCharacter(model)
	if plr then
		local hero = model:GetAttribute(GameConstants.HERO_ATTRIBUTE)
		if type(hero) ~= "string" or hero == "" then
			return false
		end
	end
	return true
end

function CombatHelper.isShielded(character: Model): boolean
	return character:GetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE) == true
end

function CombatHelper.arePowersDisabled(character: Model): boolean
	if character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.TORTURE_LOCKED_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.MG_TK_CONTROLLED_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.MG_SLAM_HELD_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.MG_OVERLOAD_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.MG_WAKING_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.GETTING_UP_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.PROB_HEX_OBJECT_ATTRIBUTE) == true then
		return true
	end
	local untilTime = character:GetAttribute(GameConstants.POWERS_DISABLED_UNTIL)
	if type(untilTime) ~= "number" then
		return false
	end
	return AbilityCooldownHelper.getNow() < untilTime
end

function CombatHelper.markInCombat(character: Model)
	local untilTime = AbilityCooldownHelper.getNow() + GameConstants.COMBAT_TIMEOUT
	character:SetAttribute(GameConstants.COMBAT_UNTIL_ATTRIBUTE, untilTime)
	character:SetAttribute(GameConstants.IN_COMBAT_ATTRIBUTE, true)
end

function CombatHelper.isInCombat(character: Model): boolean
	local untilTime = character:GetAttribute(GameConstants.COMBAT_UNTIL_ATTRIBUTE)
	if type(untilTime) ~= "number" then
		return false
	end
	return AbilityCooldownHelper.getNow() < untilTime
end

function CombatHelper.refreshCombatFlag(character: Model)
	if CombatHelper.isInCombat(character) then
		if character:GetAttribute(GameConstants.IN_COMBAT_ATTRIBUTE) ~= true then
			character:SetAttribute(GameConstants.IN_COMBAT_ATTRIBUTE, true)
		end
	elseif character:GetAttribute(GameConstants.IN_COMBAT_ATTRIBUTE) == true then
		character:SetAttribute(GameConstants.IN_COMBAT_ATTRIBUTE, nil)
		character:SetAttribute(GameConstants.COMBAT_UNTIL_ATTRIBUTE, nil)
	end
end

function CombatHelper.getAbsorbChargeMax(_character: Model?): number
	return GameConstants.ABSORB_CHARGE_MAX
end

local function getAbsorbOutgoingMult(character: Model): number
	local charge = character:GetAttribute(GameConstants.ABSORB_CHARGE_ATTRIBUTE)
	if type(charge) ~= "number" then
		return 1
	end
	local t = math.clamp(charge / GameConstants.ABSORB_CHARGE_MAX, 0, 1)
	return 1 + t * (GameConstants.CM_ABSORB_OUTGOING_MULT_MAX - 1)
end

function CombatHelper.getAbsorbOutgoingMult(character: Model): number
	return getAbsorbOutgoingMult(character)
end

--[[ Spend a fraction of max absorb charge (0.1 = 10% of bar). ]]
function CombatHelper.spendAbsorbCharge(character: Model, fractionOfMax: number)
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "captain_marvel" then
		return
	end
	local charge = character:GetAttribute(GameConstants.ABSORB_CHARGE_ATTRIBUTE)
	if type(charge) ~= "number" or charge <= 0 then
		return
	end
	local spend = GameConstants.ABSORB_CHARGE_MAX * math.clamp(fractionOfMax, 0, 1)
	character:SetAttribute(GameConstants.ABSORB_CHARGE_ATTRIBUTE, math.max(0, charge - spend))
end

function CombatHelper.decayAbsorbCharge(character: Model, dt: number)
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "captain_marvel" then
		return
	end
	local charge = character:GetAttribute(GameConstants.ABSORB_CHARGE_ATTRIBUTE)
	if type(charge) ~= "number" or charge <= 0 then
		return
	end
	character:SetAttribute(
		GameConstants.ABSORB_CHARGE_ATTRIBUTE,
		math.max(0, charge - GameConstants.CM_ABSORB_DECAY_PER_SEC * dt)
	)
end

local function applyCaptainMarvelAbsorb(target: Model, absorbed: number)
	if absorbed <= 0 then
		return
	end
	local gainMult = 1
	if target:GetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE) == true then
		gainMult = GameConstants.BINARY_ABSORB_GAIN_MULT
	end
	local energy = target:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
	local maxEnergy = target:GetAttribute(GameConstants.MAX_ENERGY_ATTRIBUTE)
	if type(energy) == "number" and type(maxEnergy) == "number" then
		target:SetAttribute(
			GameConstants.ENERGY_ATTRIBUTE,
			math.min(maxEnergy, energy + absorbed * GameConstants.CM_ABSORB_TO_ENERGY * gainMult)
		)
	end
	local hum = CombatHelper.getHumanoid(target)
	if hum and hum.Health > 0 then
		hum.Health = math.min(hum.MaxHealth, hum.Health + absorbed * GameConstants.CM_ABSORB_TO_HEALTH * gainMult)
	end
	local charge = target:GetAttribute(GameConstants.ABSORB_CHARGE_ATTRIBUTE)
	if type(charge) ~= "number" then
		charge = 0
	end
	-- Binary: same hit fills the bar twice as fast (1% → 2%)
	target:SetAttribute(
		GameConstants.ABSORB_CHARGE_ATTRIBUTE,
		math.min(
			GameConstants.ABSORB_CHARGE_MAX,
			charge + absorbed * GameConstants.CM_ABSORB_CHARGE_PER_DAMAGE * gainMult
		)
	)
end

--[[ source: "projectile" | "beam" | nil — CM passive absorb only applies to projectile/beam. ]]
function CombatHelper.dealDamage(
	attacker: Model,
	target: Model,
	amount: number,
	hitFrom: Vector3?,
	source: string?
): boolean
	local humanoid = CombatHelper.getHumanoid(target)
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	if target == attacker then
		return false
	end
	if not CombatHelper.isCombatEligible(target) then
		return false
	end
	-- Invulnerable while locked in a beam clash
	if target:GetAttribute(GameConstants.BEAM_CLASH_ATTRIBUTE) == true then
		return false
	end
	local protectedUntil = target:GetAttribute(GameConstants.PROTECTED_UNTIL_ATTRIBUTE)
	if type(protectedUntil) == "number" and protectedUntil > AbilityCooldownHelper.getNow() then
		return false
	end
	if target:GetAttribute(GameConstants.MG_ASTRAL_ATTRIBUTE) == true then
		return false
	end

	local finalAmount = amount
	if attacker:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "captain_marvel" then
		finalAmount *= getAbsorbOutgoingMult(attacker)
		if attacker:GetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE) == true then
			finalAmount *= GameConstants.BINARY_DAMAGE_MULT
		end
	end

	local shopBuff = attacker:GetAttribute(GameConstants.SHOP_DAMAGE_BUFF_ATTRIBUTE)
	if type(shopBuff) == "number" and shopBuff > 1 then
		finalAmount *= shopBuff
	end

	if CombatHelper.isShielded(target) then
		if shieldDamageHandler then
			local blocked = shieldDamageHandler(target, finalAmount, hitFrom)
			CombatHelper.markInCombat(target)
			return blocked
		end
		CombatHelper.markInCombat(target)
		return false
	end

	if
		target:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "captain_marvel"
		and (source == "projectile" or source == "beam")
	then
		local absorbed = finalAmount * GameConstants.CM_ABSORB_DAMAGE_FRACTION
		finalAmount = math.max(0, finalAmount - absorbed)
		applyCaptainMarvelAbsorb(target, absorbed)
	end

	humanoid:TakeDamage(finalAmount)
	CombatHelper.markInCombat(target)
	local attackerPlayer = Players:GetPlayerFromCharacter(attacker)
	if attackerPlayer and attacker ~= target then
		target:SetAttribute(GameConstants.LAST_DAMAGER_USER_ID_ATTRIBUTE, attackerPlayer.UserId)
	end
	return true
end

function CombatHelper.heal(target: Model, amount: number): boolean
	local humanoid = CombatHelper.getHumanoid(target)
	if not humanoid or humanoid.Health <= 0 or amount <= 0 then
		return false
	end
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
	return true
end

function CombatHelper.overlapCharacters(origin: Vector3, radius: number, exclude: Model?): { Model }
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = if exclude then { exclude } else {}
	local parts = workspace:GetPartBoundsInRadius(origin, radius, params)
	local seen: { [Model]: boolean } = {}
	local results: { Model } = {}
	for _, part in parts do
		local character = CombatHelper.getCharacterFromPart(part)
		if character and not seen[character] then
			seen[character] = true
			local humanoid = CombatHelper.getHumanoid(character)
			if humanoid and humanoid.Health > 0 and CombatHelper.isCombatEligible(character) then
				table.insert(results, character)
			end
		end
	end
	return results
end

function CombatHelper.raycastCharacter(
	origin: Vector3,
	direction: Vector3,
	range: number,
	exclude: Model?
): Model?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = if exclude then { exclude } else {}
	local result = workspace:Raycast(origin, direction.Unit * range, params)
	if not result then
		return nil
	end
	local model = CombatHelper.getCharacterFromPart(result.Instance)
	-- Accept any living humanoid (players and NPCs)
	if model then
		local hum = CombatHelper.getHumanoid(model)
		if hum and hum.Health > 0 and CombatHelper.isCombatEligible(model) then
			return model
		end
	end
	return nil
end

function CombatHelper.raycastPoint(
	origin: Vector3,
	direction: Vector3,
	range: number,
	exclude: Model?
): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = if exclude then { exclude } else {}
	local result = workspace:Raycast(origin, direction.Unit * range, params)
	if result then
		return result.Position
	end
	return origin + direction.Unit * range
end

return CombatHelper
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">ConstraintHelper</string>
          <string name="Source"><![CDATA[--!strict

local ConstraintHelper = {}

export type MoverBundle = {
	attachment: Attachment,
	linearVelocity: LinearVelocity,
	vectorForce: VectorForce?,
	alignOrientation: AlignOrientation?,
}

local function getOrCreateAttachment(root: BasePart): Attachment
	local att = root:FindFirstChild("HeroMoverAttachment")
	if att and att:IsA("Attachment") then
		return att
	end
	local created = Instance.new("Attachment")
	created.Name = "HeroMoverAttachment"
	created.Parent = root
	return created
end

function ConstraintHelper.createMover(root: BasePart, withAlign: boolean?, withGravityCancel: boolean?): MoverBundle
	local att = getOrCreateAttachment(root)

	local linearVel = Instance.new("LinearVelocity")
	linearVel.Name = "HeroLinearVelocity"
	linearVel.Attachment0 = att
	linearVel.MaxForce = math.huge
	linearVel.RelativeTo = Enum.ActuatorRelativeTo.World
	linearVel.VectorVelocity = Vector3.zero
	linearVel.Parent = root

	local vectorForce: VectorForce? = nil
	if withGravityCancel then
		vectorForce = Instance.new("VectorForce")
		vectorForce.Name = "HeroGravityCancel"
		vectorForce.Attachment0 = att
		vectorForce.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0)
		vectorForce.RelativeTo = Enum.ActuatorRelativeTo.World
		vectorForce.Parent = root
	end

	local align: AlignOrientation? = nil
	if withAlign then
		align = Instance.new("AlignOrientation")
		align.Name = "HeroAlignOrientation"
		align.Attachment0 = att
		align.Mode = Enum.OrientationAlignmentMode.OneAttachment
		align.MaxTorque = math.huge
		align.Responsiveness = 18
		align.CFrame = root.CFrame
		align.Parent = root
	end

	return {
		attachment = att,
		linearVelocity = linearVel,
		vectorForce = vectorForce,
		alignOrientation = align,
	}
end

function ConstraintHelper.destroyMover(bundle: MoverBundle?)
	if not bundle then
		return
	end
	for _, inst in { bundle.linearVelocity, bundle.vectorForce, bundle.alignOrientation } do
		if inst and inst.Parent then
			inst:Destroy()
		end
	end
end

local function muteLocomotionSounds(character: Model?, muted: boolean)
	if not character then
		return
	end
	for _, desc in character:GetDescendants() do
		if desc:IsA("Sound") then
			local name = string.lower(desc.Name)
			if name == "running" or name == "climbing" or name == "freesound" or name:find("run", 1, true) then
				if muted then
					if desc:GetAttribute("HeroOrigVolume") == nil then
						desc:SetAttribute("HeroOrigVolume", desc.Volume)
					end
					desc:Stop()
					desc.Volume = 0
					desc.Playing = false
				else
					local orig = desc:GetAttribute("HeroOrigVolume")
					if type(orig) == "number" then
						desc.Volume = orig
						desc:SetAttribute("HeroOrigVolume", nil)
					end
				end
			end
		end
	end
end

function ConstraintHelper.lockHumanoidForAbility(humanoid: Humanoid)
	humanoid:SetAttribute("HeroAbilityLocked", true)
	if humanoid:GetAttribute("HeroOrigWalkSpeed") == nil then
		humanoid:SetAttribute("HeroOrigWalkSpeed", humanoid.WalkSpeed)
	end
	humanoid.PlatformStand = true
	humanoid.AutoRotate = false
	humanoid.WalkSpeed = 0
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
	muteLocomotionSounds(humanoid.Parent :: Model?, true)
end

function ConstraintHelper.unlockHumanoid(humanoid: Humanoid)
	humanoid:SetAttribute("HeroAbilityLocked", nil)
	humanoid.PlatformStand = false
	humanoid.AutoRotate = true
	local origSpeed = humanoid:GetAttribute("HeroOrigWalkSpeed")
	if type(origSpeed) == "number" then
		humanoid.WalkSpeed = origSpeed
		humanoid:SetAttribute("HeroOrigWalkSpeed", nil)
	end
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)
	muteLocomotionSounds(humanoid.Parent :: Model?, false)
	-- Don't force Freefall on a dead body (breaks death ragdoll / reset cleanup)
	if humanoid.Health > 0 then
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
end

function ConstraintHelper.muteLocomotionSounds(character: Model, muted: boolean)
	muteLocomotionSounds(character, muted)
end

return ConstraintHelper
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">FrostStatus</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Iceman Chill / Freeze status.

	Chill (0-100) stacks from every ice hit and slows the victim. A full bar
	freezes them solid: locked in place, powers disabled, encased in a block.
	Thawing clears the stacks and grants a short immunity window.

	FrostStatus.update(dt) must be pumped once per frame (IcemanService does it).
	Visuals: Assets.IceMan.Ice shells welded to each body part, revealed feet→head.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local FrostStatus = {}

type ChillEntry = {
	chill: number,
	lastAddAt: number,
	baseWalk: number?,
	lastAppliedWalk: number?,
	shownChill: number?,
	baseJumpPower: number?,
	baseJumpHeight: number?,
	baseAutoRotate: boolean?,
	baseAnchored: boolean?,
	frozenUntil: number?,
	powerLockUntil: number?,
	immuneUntil: number,
	shells: { BasePart }?,
}

local byModel: { [Model]: ChillEntry } = {}

local function getRoot(model: Model): BasePart?
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return model.PrimaryPart
end

local function isValidTarget(model: Model?): boolean
	if not model or not model.Parent then
		return false
	end
	local hum = CombatHelper.getHumanoid(model)
	if not hum or hum.Health <= 0 then
		return false
	end
	-- Illusions / astral copies are not real bodies
	if model:GetAttribute("LokiUltClone") == true or model:GetAttribute("LokiDecoy") == true then
		return false
	end
	if model:GetAttribute("FearVisual") == true or model.Name == "FearClone" then
		return false
	end
	if model:GetAttribute(GameConstants.MG_ASTRAL_ATTRIBUTE) == true then
		return false
	end
	return true
end

--[[ Iceman shrugs off his own element (Sub-Zero Body passive). ]]
function FrostStatus.isImmune(model: Model): boolean
	if model:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "iceman" then
		return true
	end
	local entry = byModel[model]
	if entry and AbilityCooldownHelper.getNow() < entry.immuneUntil then
		return true
	end
	return false
end

function FrostStatus.getChill(model: Model): number
	local entry = byModel[model]
	if not entry then
		return 0
	end
	return entry.chill
end

function FrostStatus.isFrozen(model: Model): boolean
	return model:GetAttribute(GameConstants.ICE_FROZEN_ATTRIBUTE) == true
end

local function ensureEntry(model: Model): ChillEntry
	local entry = byModel[model]
	if entry then
		return entry
	end
	entry = {
		chill = 0,
		lastAddAt = AbilityCooldownHelper.getNow(),
		immuneUntil = 0,
	}
	byModel[model] = entry
	return entry
end

--[[
	Slow off whatever speed the rest of the game wants right now: if another
	system (sprint, Ice Slide, Purify) moved WalkSpeed since our last write,
	that becomes the new base instead of compounding the slow.
]]
local function applySlow(model: Model, entry: ChillEntry)
	local hum = CombatHelper.getHumanoid(model)
	if not hum then
		return
	end
	local applied = entry.lastAppliedWalk
	if entry.baseWalk == nil or applied == nil or math.abs(hum.WalkSpeed - applied) > 0.01 then
		entry.baseWalk = hum.WalkSpeed
	end
	local ratio = math.clamp(entry.chill / GameConstants.ICE_CHILL_MAX, 0, 1)
	local base = entry.baseWalk :: number
	hum.WalkSpeed = base * (1 - GameConstants.ICE_CHILL_SLOW_MAX * ratio)
	entry.lastAppliedWalk = hum.WalkSpeed
end

local function restoreSlow(model: Model, entry: ChillEntry)
	local hum = CombatHelper.getHumanoid(model)
	if hum and hum.Parent and entry.baseWalk ~= nil then
		hum.WalkSpeed = entry.baseWalk :: number
	end
	entry.baseWalk = nil
	entry.lastAppliedWalk = nil
end

--[[ Replicate Chill as a whole number so we're not writing an attribute every frame. ]]
local function publishChill(model: Model, entry: ChillEntry)
	local shown = if entry.chill > 0 then math.floor(entry.chill + 0.5) else 0
	if entry.shownChill == shown then
		return
	end
	entry.shownChill = shown
	model:SetAttribute(GameConstants.ICE_CHILL_ATTRIBUTE, if shown > 0 then shown else nil)
end

--[[ Direct children only — R15/R6 body MeshParts, not accessory Handles. ]]
local function getBodyParts(model: Model): { BasePart }
	local parts: { BasePart } = {}
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
			table.insert(parts, child)
		end
	end
	return parts
end

local function getIceTemplate(): BasePart?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("IceMan")
	local ice = folder and folder:FindFirstChild("Ice")
	if ice and ice:IsA("BasePart") then
		return ice
	end
	return nil
end

--[[
	One Ice shell per body part, welded on, revealed feet→head.
	Uses Assets.IceMan.Ice when present; falls back to a plain ice part.
]]
local function spawnFreezeShells(model: Model): { BasePart }
	local template = getIceTemplate()
	local parts = getBodyParts(model)
	if #parts == 0 then
		return {}
	end

	local minY = math.huge
	local maxY = -math.huge
	for _, part in parts do
		minY = math.min(minY, part.Position.Y)
		maxY = math.max(maxY, part.Position.Y)
	end
	local span = math.max(0.05, maxY - minY)
	local cascade = GameConstants.ICE_FREEZE_CASCADE

	local shells: { BasePart } = {}
	for _, part in parts do
		local shell: BasePart
		if template then
			shell = template:Clone()
		else
			local fallback = Instance.new("Part")
			fallback.Material = Enum.Material.Ice
			fallback.Color = GameConstants.ICE_COLOR
			shell = fallback
		end
		shell.Name = "IceFreezeShell"
		shell.Size = part.Size * GameConstants.ICE_FREEZE_SHELL_SCALE
		shell.CFrame = part.CFrame
		shell.Anchored = false
		shell.CanCollide = false
		shell.CanQuery = false
		shell.CanTouch = false
		shell.Massless = true
		shell.CastShadow = false
		shell.Color = GameConstants.ICE_COLOR
		local targetTransparency = if shell.Transparency < 0.99 then shell.Transparency else 0.2
		shell.Transparency = 1
		shell.Parent = Workspace

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = part
		weld.Part1 = shell
		weld.Parent = shell

		local delaySec = ((part.Position.Y - minY) / span) * cascade
		task.delay(delaySec, function()
			if not shell.Parent then
				return
			end
			TweenService:Create(
				shell,
				TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Transparency = targetTransparency }
			):Play()
		end)
		table.insert(shells, shell)
	end
	return shells
end

local function detachShells(shells: { BasePart })
	for _, shell in shells do
		if not shell.Parent then
			continue
		end
		for _, child in shell:GetChildren() do
			if child:IsA("WeldConstraint") or child:IsA("Weld") or child:IsA("Motor6D") then
				child:Destroy()
			end
		end
		shell.Anchored = false
		shell.CanCollide = false
		shell.CanQuery = false
		shell.CanTouch = false
		shell.Massless = false
	end
end

--[[ Shatter FX: ice pieces fly randomly up, then drop and fade (no collision). ]]
function FrostStatus.flingShells(shells: { BasePart })
	detachShells(shells)
	local up = GameConstants.ICE_SHATTER_ICE_UP
	local spread = GameConstants.ICE_SHATTER_ICE_SPREAD
	local fade = GameConstants.ICE_SHATTER_ICE_FADE
	local life = GameConstants.ICE_SHATTER_ICE_LIFE
	for _, shell in shells do
		if not shell.Parent then
			continue
		end
		local vx = (math.random() - 0.5) * 2 * spread
		local vz = (math.random() - 0.5) * 2 * spread
		local vy = up * (0.65 + math.random() * 0.55)
		shell.AssemblyLinearVelocity = Vector3.new(vx, vy, vz)
		shell.AssemblyAngularVelocity = Vector3.new(
			(math.random() - 0.5) * 14,
			(math.random() - 0.5) * 14,
			(math.random() - 0.5) * 14
		)
		task.delay(life * 0.35, function()
			if not shell.Parent then
				return
			end
			TweenService:Create(shell, TweenInfo.new(fade, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Transparency = 1,
			}):Play()
		end)
		task.delay(life + fade, function()
			if shell.Parent then
				shell:Destroy()
			end
		end)
	end
end

local function retireFreezeShells(shells: { BasePart }?)
	if not shells then
		return
	end
	for _, shell in shells do
		if shell.Parent then
			TweenService:Create(shell, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Transparency = 1,
			}):Play()
			task.delay(0.55, function()
				if shell.Parent then
					shell:Destroy()
				end
			end)
		end
	end
end

function FrostStatus.getBodyParts(model: Model): { BasePart }
	return getBodyParts(model)
end

local function lockFrozen(model: Model, entry: ChillEntry, allowMotion: boolean?)
	local hum = CombatHelper.getHumanoid(model)
	local root = getRoot(model)
	if hum then
		if entry.baseWalk == nil then
			entry.baseWalk = hum.WalkSpeed
		end
		entry.baseAutoRotate = hum.AutoRotate
		if hum.UseJumpPower then
			entry.baseJumpPower = hum.JumpPower
			hum.JumpPower = 0
		else
			entry.baseJumpHeight = hum.JumpHeight
			hum.JumpHeight = 0
		end
		hum.WalkSpeed = 0
		hum.AutoRotate = false
		hum:Move(Vector3.zero, false)
	end
	if root and not allowMotion then
		entry.baseAnchored = root.Anchored
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = true
	end
end

local function unlockFrozen(model: Model, entry: ChillEntry)
	local hum = CombatHelper.getHumanoid(model)
	local root = getRoot(model)
	if hum and hum.Parent then
		if entry.baseAutoRotate ~= nil then
			hum.AutoRotate = entry.baseAutoRotate
		end
		if entry.baseJumpPower ~= nil then
			hum.JumpPower = entry.baseJumpPower
		end
		if entry.baseJumpHeight ~= nil then
			hum.JumpHeight = entry.baseJumpHeight
		end
	end
	if root and root.Parent and entry.baseAnchored ~= nil then
		root.Anchored = entry.baseAnchored
	end
	entry.baseAutoRotate = nil
	entry.baseJumpPower = nil
	entry.baseJumpHeight = nil
	entry.baseAnchored = nil
end

local function thaw(model: Model, entry: ChillEntry)
	unlockFrozen(model, entry)
	retireFreezeShells(entry.shells)
	entry.shells = nil
	entry.frozenUntil = nil
	entry.chill = 0
	entry.immuneUntil = AbilityCooldownHelper.getNow() + GameConstants.ICE_FREEZE_IMMUNE_TIME
	restoreSlow(model, entry)
	if model.Parent then
		model:SetAttribute(GameConstants.ICE_FROZEN_ATTRIBUTE, nil)
		publishChill(model, entry)
		-- Only lift the power lock we set; leave Fear / other locks alone
		if model:GetAttribute(GameConstants.POWERS_DISABLED_UNTIL) == entry.powerLockUntil then
			model:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, nil)
		end
	end
	entry.powerLockUntil = nil
end

export type FreezeOptions = {
	-- Keep root free to move (for Flash Freeze shove while ice climbs)
	allowMotion: boolean?,
}

--[[ Freeze solid regardless of current Chill (Flash Freeze / full bar). ]]
function FrostStatus.freeze(model: Model, duration: number?, options: FreezeOptions?): boolean
	if not isValidTarget(model) or FrostStatus.isImmune(model) then
		return false
	end
	if FrostStatus.isFrozen(model) then
		return false
	end
	local root = getRoot(model)
	if root and root.Anchored then
		-- Already held by another ability (slam / astral body) — don't fight it
		return false
	end

	local entry = ensureEntry(model)
	local dur = duration or GameConstants.ICE_FREEZE_DURATION
	local allowMotion = options ~= nil and options.allowMotion == true
	entry.chill = GameConstants.ICE_CHILL_MAX
	entry.frozenUntil = AbilityCooldownHelper.getNow() + dur
	entry.powerLockUntil = entry.frozenUntil
	lockFrozen(model, entry, allowMotion)
	entry.shells = spawnFreezeShells(model)

	model:SetAttribute(GameConstants.ICE_FROZEN_ATTRIBUTE, true)
	publishChill(model, entry)
	-- Keep a longer existing lock (Fear) instead of shortening it
	local existingLock = model:GetAttribute(GameConstants.POWERS_DISABLED_UNTIL)
	if type(existingLock) ~= "number" or existingLock < entry.frozenUntil then
		model:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, entry.frozenUntil)
	end
	return true
end

--[[ Anchor a soft (motion-allowed) freeze once the shove is done. ]]
function FrostStatus.seal(model: Model)
	if not FrostStatus.isFrozen(model) then
		return
	end
	local entry = byModel[model]
	local root = getRoot(model)
	if not entry or not root or not root.Parent then
		return
	end
	if entry.baseAnchored == nil then
		entry.baseAnchored = root.Anchored
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.Anchored = true
	local hum = CombatHelper.getHumanoid(model)
	if hum then
		hum.WalkSpeed = 0
		hum:Move(Vector3.zero, false)
	end
end

function FrostStatus.addChill(model: Model, amount: number): number
	if amount <= 0 or not isValidTarget(model) or FrostStatus.isImmune(model) then
		return 0
	end
	if CombatHelper.isShielded(model) then
		-- Shields / barriers keep the cold out entirely
		return 0
	end
	if FrostStatus.isFrozen(model) then
		return GameConstants.ICE_CHILL_MAX
	end

	local entry = ensureEntry(model)
	entry.chill = math.clamp(entry.chill + amount, 0, GameConstants.ICE_CHILL_MAX)
	entry.lastAddAt = AbilityCooldownHelper.getNow()
	publishChill(model, entry)

	if entry.chill >= GameConstants.ICE_CHILL_MAX then
		FrostStatus.freeze(model, GameConstants.ICE_FREEZE_DURATION)
	else
		applySlow(model, entry)
	end
	return entry.chill
end

--[[ Shatter: take all stacks off the target and return any ice shells for FX. ]]
function FrostStatus.consumeChill(model: Model): (number, boolean, { BasePart })
	local entry = byModel[model]
	if not entry then
		return 0, false, {}
	end
	local amount = entry.chill
	local wasFrozen = FrostStatus.isFrozen(model)
	local shells = entry.shells or {}
	entry.shells = nil
	if wasFrozen then
		thaw(model, entry)
	else
		entry.chill = 0
		restoreSlow(model, entry)
		if model.Parent then
			publishChill(model, entry)
		end
	end
	return amount, wasFrozen, shells
end

--[[ Full cleanse (death / Purify / respawn). ]]
function FrostStatus.clear(model: Model)
	local entry = byModel[model]
	if not entry then
		if model.Parent then
			model:SetAttribute(GameConstants.ICE_CHILL_ATTRIBUTE, nil)
			model:SetAttribute(GameConstants.ICE_FROZEN_ATTRIBUTE, nil)
		end
		return
	end
	byModel[model] = nil
	unlockFrozen(model, entry)
	retireFreezeShells(entry.shells)
	restoreSlow(model, entry)
	if model.Parent then
		model:SetAttribute(GameConstants.ICE_CHILL_ATTRIBUTE, nil)
		model:SetAttribute(GameConstants.ICE_FROZEN_ATTRIBUTE, nil)
		-- Only lift the power lock the freeze itself set
		local lock = entry.powerLockUntil
		if lock and model:GetAttribute(GameConstants.POWERS_DISABLED_UNTIL) == lock then
			model:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, nil)
		end
	end
end

function FrostStatus.update(dt: number)
	local now = AbilityCooldownHelper.getNow()
	local dtClamped = math.clamp(dt, 0.001, 0.2)

	for model, entry in byModel do
		if not isValidTarget(model) then
			unlockFrozen(model, entry)
			retireFreezeShells(entry.shells)
			restoreSlow(model, entry)
			byModel[model] = nil
			continue
		end

		if entry.frozenUntil then
			if now >= entry.frozenUntil then
				thaw(model, entry)
			else
				local hum = CombatHelper.getHumanoid(model)
				if hum then
					hum.WalkSpeed = 0
					hum:Move(Vector3.zero, false)
				end
			end
			continue
		end

		if entry.chill <= 0 then
			if now >= entry.immuneUntil then
				restoreSlow(model, entry)
				byModel[model] = nil
			end
			continue
		end

		if now - entry.lastAddAt >= GameConstants.ICE_CHILL_DECAY_GRACE then
			entry.chill = math.max(0, entry.chill - GameConstants.ICE_CHILL_DECAY_PER_SEC * dtClamped)
			publishChill(model, entry)
		end

		if entry.chill > 0 then
			applySlow(model, entry)
		else
			restoreSlow(model, entry)
		end
	end
end

function FrostStatus.clearForPlayer(player: Player)
	local character = player.Character
	if character then
		FrostStatus.clear(character)
	end
end

Players.PlayerRemoving:Connect(function(player)
	FrostStatus.clearForPlayer(player)
end)

return FrostStatus
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
