	SelectHero = "SelectHero",
	HeroConfirmed = "HeroConfirmed",
	RequireReselect = "RequireReselect",
	UseAbility = "UseAbility",
	CooldownUpdate = "CooldownUpdate",
	StatUpdate = "StatUpdate",
	SetSprinting = "SetSprinting",

	TelekinesisRequest = "TelekinesisRequest",
	TelekinesisUpdate = "TelekinesisUpdate",
	TelekinesisThrow = "TelekinesisThrow",
	TelekinesisEnd = "TelekinesisEnd",

	ShieldSetActive = "ShieldSetActive",
	ChaosBeamSetActive = "ChaosBeamSetActive",
	ChaosBeamLookUpdate = "ChaosBeamLookUpdate",
	FlightToggle = "FlightToggle",
	FlightInput = "FlightInput",
	ProjectileSteerUpdate = "ProjectileSteerUpdate",
}
]]></string>
        </Properties>
