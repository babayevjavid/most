function VfxHelper.getScarletAsset(...: string): Instance?
	return getScarletAsset(...)
end

function VfxHelper.getCaptainMarvelAsset(name: string): Instance?
	return getCaptainMarvelAsset(name)
end

function VfxHelper.emitAllParticles(root: Instance, count: number?)
	emitAllParticles(root, count)
end

function VfxHelper.setParticlesEnabled(root: Instance, enabled: boolean)
	setParticlesEnabled(root, enabled)
end

function VfxHelper.disableImpactSoon(root: Instance)
	task.delay(0.1, function()
		if root.Parent then
			setParticlesEnabled(root, false)
		end
	end)
end

function VfxHelper.spawnInvisibleWomanDiscImpact(origin: Vector3)
	local folder = VfxHelper.getInvisibleWomanAsset("DiscThrow")
	local names = {
		"DiscImpactAttachment",
		"DiscImpact",
		"ImpactAttachment",
		"Impact",
		"BoltImpactAttachment",
		"BoltImpact",
		"HitImpact",
	}
	local template: Instance? = nil
	if folder then
		for _, name in names do
			local found = folder:FindFirstChild(name)
			if found then
				template = found
				break
			end
		end
		if not template then
			for _, name in names do
				local found = folder:FindFirstChild(name, true)
				if found then
					template = found
					break
				end
			end
		end
		if not template then
			for _, desc in folder:GetDescendants() do
				if string.find(string.lower(desc.Name), "impact") then
					template = desc
					break
				end
			end
		end
	end

	local host = Instance.new("Part")
	host.Name = "IwDiscImpactHost"
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.Transparency = 1
	host.CastShadow = false
	host.Size = Vector3.new(0.2, 0.2, 0.2)
	host.CFrame = CFrame.new(origin)
	host.Parent = workspace

	local spawned: Instance? = nil
	if template then
		local fx = template:Clone()
		spawned = fx
		if fx:IsA("Attachment") then
			fx.CFrame = CFrame.identity
			fx.Parent = host
		elseif fx:IsA("BasePart") then
			fx.Anchored = true
			fx.CanCollide = false
			fx.CanQuery = false
			fx.CanTouch = false
			fx.CFrame = CFrame.new(origin)
			fx.Parent = workspace
		elseif fx:IsA("Model") then
			fx.Parent = workspace
			fx:PivotTo(CFrame.new(origin))
			for _, desc in fx:GetDescendants() do
				if desc:IsA("BasePart") then
					desc.Anchored = true
					desc.CanCollide = false
					desc.CanQuery = false
					desc.CanTouch = false
				end
			end
		else
			fx.Parent = host
		end
		for _, desc in fx:GetDescendants() do
			if desc:IsA("Beam") or desc:IsA("Trail") then
				desc.Enabled = true
			end
		end
		if fx:IsA("Beam") or fx:IsA("Trail") then
			fx.Enabled = true
		end
		local emitRoot = if fx:IsA("Attachment") or fx:IsA("BasePart") or fx:IsA("Model") then fx else host
		emitAllParticles(emitRoot, 5)
		VfxHelper.disableImpactSoon(emitRoot)
	end

	Debris:AddItem(host, 3.2)
	if spawned and spawned ~= host and spawned.Parent then
		Debris:AddItem(spawned, 3.2)
	end
	if not template then
		VfxHelper.spawnBurstSparks(origin, GameConstants.IW_COLOR, 16)
		VfxHelper.spawnPulseRing(origin, 2.4, GameConstants.IW_COLOR, 0.32)
	end
	return host
end

function VfxHelper.collectParticleEmitters(root: Instance): { ParticleEmitter }
	return collectParticleEmitters(root)
end

--[[
	Invisible Ball shell + PartialShieldParticleNew, oriented toward the hit.
]]
function VfxHelper.spawnPartialShieldShell(root: BasePart, hitFrom: Vector3?, emitCount: number?): BasePart?
	local template = getScarletAsset("PartialShieldParticleNew")
	if not template then
		warn("[VfxHelper] Missing Assets.ScarletWitch.PartialShieldParticleNew")
		return nil
	end

	local size = GameConstants.SHIELD_PARTIAL_SHELL_SIZE
	local shell = Instance.new("Part")
	shell.Name = "PartialShieldShell"
	shell.Shape = Enum.PartType.Ball
	shell.Size = Vector3.new(size, size, size)
	shell.Transparency = 1
	shell.Anchored = false
	shell.CanCollide = false
	shell.CanQuery = false
	shell.CanTouch = false
	shell.Massless = true
	shell.CastShadow = false
	shell.Material = Enum.Material.SmoothPlastic

	-- Face the incoming projectile
	if hitFrom and (hitFrom - root.Position).Magnitude > 0.05 then
		shell.CFrame = CFrame.lookAt(root.Position, hitFrom)
	else
		shell.CFrame = root.CFrame
	end
	shell.Parent = workspace

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = shell
	weld.Parent = shell

	local clone = template:Clone()
	clone.Name = "PartialShieldParticleNew"
	if clone:IsA("Attachment") then
		clone.Parent = shell
		clone.Position = Vector3.zero
	elseif clone:IsA("ParticleEmitter") then
		clone.Parent = shell
	elseif clone:IsA("BasePart") then
		for _, em in collectParticleEmitters(clone) do
			em.Parent = shell
		end
		clone:Destroy()
	else
		-- Folder / Model / other: move emitters (and attachments) onto the shell
		for _, child in clone:GetChildren() do
			if child:IsA("Attachment") or child:IsA("ParticleEmitter") then
				child.Parent = shell
			end
		end
		for _, em in collectParticleEmitters(clone) do
			em.Parent = shell
		end
		clone:Destroy()
	end

	local count = emitCount or 10
	for _, em in collectParticleEmitters(shell) do
		em.Enabled = true
		em:Emit(count)
	end

	return shell
end

function VfxHelper.spawnBeamLine(startPos: Vector3, endPos: Vector3, color: Color3, thickness: number?, life: number?)
	-- Procedural beam-line parts disabled — use real Beam instances / Assets.
	return
end

function VfxHelper.spawnTrail(root: BasePart, color: Color3, lifetime: number)
	local trail = Instance.new("Part")
	trail.Name = "AbilityTrail"
	trail.Size = Vector3.new(1.2, 0.2, 1.2)
	trail.CFrame = root.CFrame
	trail.Anchored = true
	trail.CanCollide = false
	trail.CanQuery = false
	trail.Material = Enum.Material.ForceField
	trail.Color = color
	trail.Transparency = 0.65
	trail.Parent = workspace
	TweenService:Create(trail, TweenInfo.new(lifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Transparency = 1,
		Size = Vector3.new(0.2, 0.05, 0.2),
	}):Play()
	Debris:AddItem(trail, lifetime + 0.05)
end

function VfxHelper.spawnBurstSparks(origin: Vector3, color: Color3, count: number?)
	-- Procedural spark parts disabled — use Assets particle attachments.
	return
end

function VfxHelper.spawnPulseRing(origin: Vector3, radius: number, color: Color3, duration: number?)
	-- Procedural ring parts disabled — use Assets particle attachments.
	return
end

function VfxHelper.spawnImpact(origin: Vector3, color: Color3?, radius: number?)
	-- Procedural ForceField flash / ring / sparks disabled.
	return
end

--[[ Place Loki.DaggerImpact at origin and Emit(5) on each ParticleEmitter. ]]
function VfxHelper.spawnLokiDaggerImpact(origin: Vector3)
	local template = getLokiAsset("DaggerImpact")
	if not template then
		VfxHelper.spawnImpact(origin, Color3.fromRGB(80, 255, 120), 1.8)
		return
	end
	local host = Instance.new("Part")
	host.Name = "LokiDaggerImpactHost"
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.Transparency = 1
	host.Size = Vector3.new(0.2, 0.2, 0.2)
	host.CFrame = CFrame.new(origin)
	host.Parent = workspace

	local clone = template:Clone()
	clone.Parent = host
	if clone:IsA("Attachment") then
		clone.WorldPosition = origin
	elseif clone:IsA("BasePart") then
		clone.CFrame = CFrame.new(origin)
		clone.Anchored = true
		clone.CanCollide = false
		clone.CanQuery = false
		clone.Transparency = 1
	end
	emitAllParticles(clone, 5)
	Debris:AddItem(host, 3)
end

--[[ Place Loki.DetonateAttachment at origin; disable after 0.5s; delete after 3s. ]]
function VfxHelper.spawnLokiDetonateAttachment(origin: Vector3)
	local template = getLokiAsset("DetonateAttachment")
	if not template then
		VfxHelper.spawnImpact(origin, Color3.fromRGB(80, 255, 120), 4)
		return
	end
	local host = Instance.new("Part")
	host.Name = "LokiDetonateHost"
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.Transparency = 1
	host.Size = Vector3.new(0.2, 0.2, 0.2)
	host.CFrame = CFrame.new(origin)
	host.Parent = workspace

	local clone = template:Clone()
	clone.Parent = host
	if clone:IsA("Attachment") then
		clone.WorldCFrame = CFrame.new(origin)
	end
	setParticlesEnabled(clone, true)
	emitAllParticles(clone, 8)

	task.delay(0.5, function()
		if clone.Parent then
			setParticlesEnabled(clone, false)
			for _, em in collectParticleEmitters(clone) do
				em.Enabled = false
			end
		end
	end)
	task.delay(3, function()
		if host.Parent then
			host:Destroy()
		end
	end)
end

function VfxHelper.attachProjectileTrail(part: BasePart, color: Color3)
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailA0"
	a0.Position = Vector3.new(0, 0.12, 0.3)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailA1"
	a1.Position = Vector3.new(0, -0.12, -0.3)
	a1.Parent = part

	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.4
	trail.MinLength = 0.06
	trail.FaceCamera = true
	trail.LightEmission = 0.15
	trail.LightInfluence = 0.6
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(0.55, 0.55),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0.1),
	})
	trail.Parent = part
end

function VfxHelper.castHandFlash(origin: Vector3, color: Color3?)
	local c = color or CHAOS
	local orb = Instance.new("Part")
	orb.Name = "HexCastFlash"
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.new(0.5, 0.5, 0.5)
	orb.CFrame = CFrame.new(origin)
	orb.Anchored = true
	orb.CanCollide = false
	orb.CanQuery = false
	orb.Material = Enum.Material.ForceField
	orb.Color = c
	orb.Transparency = 0.35
	orb.Parent = workspace
	TweenService:Create(orb, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
		Size = Vector3.new(2, 2, 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(orb, 0.35)
	VfxHelper.spawnBurstSparks(origin, c, 4)
end

function VfxHelper.getBodyPartsSorted(character: Model, feetFirst: boolean): { BasePart }
	local parts: { BasePart } = {}
	for _, desc in character:GetDescendants() do
		if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
			table.insert(parts, desc)
		end
	end
	table.sort(parts, function(a, b)
		if feetFirst then
			return a.Position.Y < b.Position.Y
		end
		return a.Position.Y > b.Position.Y
	end)
	return parts
end

function VfxHelper.fadePartsByHeight(
	character: Model,
	toTransparency: number,
	duration: number,
	feetFirst: boolean,
	onDone: (() -> ())?,
	onPartStart: ((BasePart) -> ())?
)
	local parts = VfxHelper.getBodyPartsSorted(character, feetFirst)
	if #parts == 0 then
		if onDone then
			onDone()
		end
		return
	end
	local step = duration / math.max(#parts, 1)
	task.spawn(function()
		for _, part in parts do
			if not part.Parent then
				continue
			end
			-- Already-hidden geometry (HRP, invisible accessories) stays untouched.
			if part.Transparency >= 0.999 then
				continue
			end
			if onPartStart then
				onPartStart(part)
			end
			local tweenTime = math.max(0.08, step * 1.6)
			TweenService:Create(part, TweenInfo.new(tweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				Transparency = toTransparency,
			}):Play()
			for _, child in part:GetChildren() do
				if child:IsA("Decal") or child:IsA("Texture") then
					if child.Transparency >= 0.999 then
						continue
					end
					TweenService:Create(child, TweenInfo.new(tweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
						Transparency = toTransparency,
					}):Play()
				end
			end
			task.wait(step * 0.65)
		end
		task.wait(step * 0.8)
		if onDone then
			onDone()
		end
	end)
end

export type VisiblePartSnap = {
	part: BasePart,
	transparency: number,
	decals: { { inst: Decal | Texture, transparency: number } },
}

function VfxHelper.captureVisibleParts(character: Model): { VisiblePartSnap }
	local snaps: { VisiblePartSnap } = {}
	for _, desc in character:GetDescendants() do
		if desc:IsA("BasePart") then
			if desc.Name == "HumanoidRootPart" or desc.Transparency >= 0.999 then
				continue
			end
			local decals: { { inst: Decal | Texture, transparency: number } } = {}
			for _, child in desc:GetChildren() do
				if (child:IsA("Decal") or child:IsA("Texture")) and child.Transparency < 0.999 then
					table.insert(decals, { inst = child, transparency = child.Transparency })
				end
			end
			table.insert(snaps, {
				part = desc,
				transparency = desc.Transparency,
				decals = decals,
			})
		end
	end
	return snaps
end

function VfxHelper.hideCapturedParts(snaps: { VisiblePartSnap }?)
	if type(snaps) ~= "table" then
		return
	end
	for _, snap in snaps do
		if snap and snap.part and snap.part.Parent then
			snap.part.Transparency = 1
		end
		if type(snap.decals) == "table" then
			for _, d in snap.decals do
				if d and d.inst and d.inst.Parent then
					d.inst.Transparency = 1
				end
			end
		end
	end
end

function VfxHelper.restoreCapturedParts(snaps: { VisiblePartSnap }?, duration: number?, onDone: (() -> ())?)
	local fade = duration or 0.35
	if type(snaps) ~= "table" then
		if onDone then
			onDone()
		end
		return
	end
	for _, snap in snaps do
		if not snap or not snap.part or not snap.part.Parent then
			continue
		end
		TweenService:Create(snap.part, TweenInfo.new(fade, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
			Transparency = snap.transparency,
		}):Play()
		if type(snap.decals) == "table" then
			for _, d in snap.decals do
				if d and d.inst and d.inst.Parent then
					TweenService:Create(d.inst, TweenInfo.new(fade, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
						Transparency = d.transparency,
					}):Play()
				end
			end
		end
	end
	if onDone then
		task.delay(fade, onDone)
	end
end

function VfxHelper.setCharacterTransparency(character: Model, transparency: number)
	for _, desc in character:GetDescendants() do
		if desc:IsA("BasePart") then
			if desc.Name == "HumanoidRootPart" then
				desc.Transparency = 1
			elseif desc.Transparency < 0.999 then
				desc.Transparency = transparency
			end
		elseif desc:IsA("Decal") or desc:IsA("Texture") then
			if desc.Transparency < 0.999 then
				desc.Transparency = transparency
			end
		end
	end
end

local function isAccessoryPart(part: BasePart): boolean
	local parent = part.Parent
	while parent and parent ~= game do
		if parent:IsA("Accessory") or parent:IsA("Accoutrement") then
			return true
		end
		parent = parent.Parent
	end
	return false
end

function VfxHelper.attachTelekinesisParticleToPart(part: BasePart): Instance?
	if part.Name == "HumanoidRootPart" or isAccessoryPart(part) then
		return nil
	end
	if part:FindFirstChild("TelekinesisParticle") then
		return part:FindFirstChild("TelekinesisParticle")
	end
	local template = getScarletAsset("TelekinesisParticle")
		or VfxHelper.getMarvelGirlAsset("TelekineticPush")
		or VfxHelper.getMarvelGirlAsset("HeadAttachment")
		or VfxHelper.getMarvelGirlAsset("HandVFXRightAttachment")
	if not template then
		return nil
	end
	local clone = template:Clone()
	clone.Name = "TelekinesisParticle"
	if clone:IsA("ParticleEmitter") or clone:IsA("Attachment") or clone:IsA("Folder") then
		clone.Parent = part
	else
		local nested = clone:FindFirstChildWhichIsA("Attachment", true)
			or clone:FindFirstChildWhichIsA("ParticleEmitter", true)
		if nested then
			local use = nested:Clone()
			use.Name = "TelekinesisParticle"
			use.Parent = part
			clone:Destroy()
			clone = use
		else
			clone.Parent = part
		end
	end
	setParticlesEnabled(clone, true)
	return clone
end

function VfxHelper.attachTelekinesisParticles(model: Model): { Instance }
	local clones: { Instance } = {}
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") then
			local clone = VfxHelper.attachTelekinesisParticleToPart(child)
			if clone then
				table.insert(clones, clone)
			end
		end
	end
	return clones
end

function VfxHelper.smoothDisableParticles(root: Instance, duration: number?)
	-- Stop spawning immediately; leftover particles die on their own lifetime.
	local fade = duration or 0.35
	for _, em in collectParticleEmitters(root) do
		em.Enabled = false
		local startRate = em.Rate
		local t0 = os.clock()
		task.spawn(function()
			while em.Parent and (os.clock() - t0) < fade do
				local a = math.clamp((os.clock() - t0) / fade, 0, 1)
				em.Rate = startRate * (1 - a)
				task.wait()
			end
			if em.Parent then
				em.Rate = 0
				em.Enabled = false
			end
		end)
	end
	for _, beam in collectBeams(root) do
		local w0 = beam.Width0
		local w1 = beam.Width1
		local t0 = os.clock()
		task.spawn(function()
			while beam.Parent and (os.clock() - t0) < fade do
				local a = math.clamp((os.clock() - t0) / fade, 0, 1)
				beam.Width0 = w0 * (1 - a)
				beam.Width1 = w1 * (1 - a)
				task.wait()
			end
			if beam.Parent then
				beam.Width0 = 0
				beam.Width1 = 0
				beam.Enabled = false
			end
		end)
	end
	for _, trail in collectTrails(root) do
		trail.Enabled = false
	end
end

function VfxHelper.fadeOutAndDestroyParticles(clones: { Instance }, fadeDuration: number?, deleteAfter: number?)
	local fade = fadeDuration or 0.4
	local waitDelete = deleteAfter or 2.4
	for _, clone in clones do
		if clone.Parent then
			VfxHelper.smoothDisableParticles(clone, fade)
		end
	end
	task.delay(waitDelete, function()
		for _, clone in clones do
			if clone.Parent then
				clone:Destroy()
			end
		end
	end)
end

function VfxHelper.retireFxSmooth(root: Instance?, fadeDuration: number?, deleteAfter: number?)
	if not root or not root.Parent then
		return
	end
	VfxHelper.fadeOutAndDestroyParticles({ root }, fadeDuration, deleteAfter)
end

--[[ Clone ReplicatedStorage.Assets.<name> attachments/particles onto HumanoidRootPart. ]]
function VfxHelper.attachNamedAssetToHrp(character: Model, assetName: string): { Instance }
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local template = assets and assets:FindFirstChild(assetName)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not template or not (hrp and hrp:IsA("BasePart")) then
		return {}
	end
	local clones: { Instance } = {}
	local function take(inst: Instance)
		local clone = inst:Clone()
		if clone:IsA("Attachment") then
			clone.Position = Vector3.zero
		end
		clone.Parent = hrp
		setParticlesEnabled(clone, true)
		emitAllParticles(clone, 10)
		table.insert(clones, clone)
	end
	if template:IsA("Attachment") or template:IsA("ParticleEmitter") then
		take(template)
	else
		for _, child in template:GetChildren() do
			if child:IsA("Attachment") or child:IsA("ParticleEmitter") then
				take(child)
			end
		end
		if #clones == 0 then
			take(template)
		end
	end
	return clones
end

local TK_MORPH_ALIASES: { [string]: { string } } = {
	UpperTorso = { "UpperTorso", "Torso" },
	LowerTorso = { "LowerTorso", "Torso" },
	Torso = { "Torso", "UpperTorso" },
	Head = { "Head" },
	LeftUpperArm = { "LeftUpperArm", "Left Arm" },
	LeftLowerArm = { "LeftLowerArm", "Left Arm" },
	LeftHand = { "LeftHand", "Left Arm" },
	RightUpperArm = { "RightUpperArm", "Right Arm" },
	RightLowerArm = { "RightLowerArm", "Right Arm" },
	RightHand = { "RightHand", "Right Arm" },
	LeftUpperLeg = { "LeftUpperLeg", "Left Leg" },
	LeftLowerLeg = { "LeftLowerLeg", "Left Leg" },
	LeftFoot = { "LeftFoot", "Left Leg" },
	RightUpperLeg = { "RightUpperLeg", "Right Leg" },
	RightLowerLeg = { "RightLowerLeg", "Right Leg" },
	RightFoot = { "RightFoot", "Right Leg" },
	["Left Arm"] = { "Left Arm", "LeftUpperArm" },
	["Right Arm"] = { "Right Arm", "RightUpperArm" },
	["Left Leg"] = { "Left Leg", "LeftUpperLeg" },
	["Right Leg"] = { "Right Leg", "RightUpperLeg" },
}

local function findVictimBodyPart(model: Model, morphName: string): BasePart?
	if morphName == "HumanoidRootPart" then
		return nil
	end
	local names = TK_MORPH_ALIASES[morphName] or { morphName }
	for _, name in names do
		local found = model:FindFirstChild(name)
		if found and found:IsA("BasePart") then
			return found
		end
	end
	return nil
end

local function isTkMorphFx(inst: Instance): boolean
	return inst:IsA("ParticleEmitter")
		or inst:IsA("Attachment")
		or inst:IsA("Trail")
		or inst:IsA("Beam")
		or inst:IsA("PointLight")
		or inst:IsA("SpotLight")
		or inst:IsA("Folder")
end

local function hardenFollowPart(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
end

function VfxHelper.attachFxToBodyPart(template: Instance, bodyPart: BasePart, namePrefix: string?): Instance?
	local clone = template:Clone()
	stripBlockedSounds(clone)
	clone.Name = (namePrefix or "BodyFx_") .. template.Name
	if clone:IsA("Attachment") then
		clone.Position = Vector3.zero
		clone.Orientation = Vector3.zero
		clone.Parent = bodyPart
		return clone
	end
	local weldTarget: BasePart? = nil
	if clone:IsA("BasePart") then
		hardenFollowPart(clone)
		clone.CFrame = bodyPart.CFrame
		clone.Parent = bodyPart
		weldTarget = clone
	elseif clone:IsA("Model") then
		for _, desc in clone:GetDescendants() do
			if desc:IsA("BasePart") then
				hardenFollowPart(desc)
			end
		end
		clone:PivotTo(bodyPart.CFrame)
		clone.Parent = bodyPart
		weldTarget = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
	else
		clone.Parent = bodyPart
		return clone
	end
	if weldTarget then
		local weld = Instance.new("WeldConstraint")
		weld.Name = "BodyFxWeld"
		weld.Part0 = bodyPart
		weld.Part1 = weldTarget
		weld.Parent = weldTarget
	end
	return clone
end

local function attachMorphFxChildren(model: Model, morph: Instance, namePrefix: string): { Instance }
	local clones: { Instance } = {}
	for _, morphPart in morph:GetDescendants() do
		if not morphPart:IsA("BasePart") then
			continue
		end
		local victimPart = findVictimBodyPart(model, morphPart.Name)
		if not victimPart then
			continue
		end
		for _, child in morphPart:GetChildren() do
			if not isTkMorphFx(child) then
				continue
			end
			local clone = child:Clone()
			stripBlockedSounds(clone)
			clone.Name = namePrefix .. child.Name
			if clone:IsA("Attachment") then
				clone.Position = Vector3.zero
				clone.Orientation = Vector3.zero
			end
			clone.Parent = victimPart
			setParticlesEnabled(clone, true)
			table.insert(clones, clone)
		end
	end
	return clones
end

function VfxHelper.attachMorphParticles(model: Model, morph: Instance): { Instance }
	return attachMorphFxChildren(model, morph, "TkMorph_")
end

function VfxHelper.attachRuneMorphFx(model: Model, morph: Instance): { Instance }
	return attachMorphFxChildren(model, morph, "SwRuneMorph_")
end

type TransparencySnap = {
	part: BasePart,
	transparency: number,
	decals: { { inst: Decal | Texture, transparency: number } },
}

function VfxHelper.capturePartTransparencies(model: Model): { TransparencySnap }
	local snaps: { TransparencySnap } = {}
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			local decals: { { inst: Decal | Texture, transparency: number } } = {}
			for _, child in desc:GetChildren() do
				if child:IsA("Decal") or child:IsA("Texture") then
					table.insert(decals, { inst = child, transparency = child.Transparency })
				end
			end
			table.insert(snaps, {
				part = desc,
				transparency = desc.Transparency,
				decals = decals,
			})
		end
	end
	return snaps
end

function VfxHelper.restorePartTransparencies(snaps: { TransparencySnap }?)
	if type(snaps) ~= "table" then
		return
	end
	for _, snap in snaps do
		if snap.part and snap.part.Parent then
			snap.part.Transparency = snap.transparency
		end
		for _, d in snap.decals do
			if d.inst and d.inst.Parent then
				d.inst.Transparency = d.transparency
			end
		end
	end
end

function VfxHelper.attachHeroTelekinesisMorphParticles(model: Model, heroId: string, caster: Model?): { Instance }
	local morph: Instance? = nil
	if heroId == "jean_grey" then
		morph = VfxHelper.getMarvelGirlAsset("TelekinesisMorph")
		if not morph then
			warn("[VfxHelper] Missing Assets.JeanGrey.TelekinesisMorph")
		end
	elseif heroId == "scarlet_witch" then
		morph = getScarletAsset("TelekinesisMorph")
		if not morph then
			warn("[VfxHelper] Missing Assets.ScarletWitchClassic.TelekinesisMorph")
		end
	end
	if not morph then
		return VfxHelper.attachTelekinesisParticles(model)
	end
	local clones = VfxHelper.attachMorphParticles(model, morph)
	if heroId == "jean_grey" and caster and caster.Parent then
		local MorphVfxTint = require(script.Parent.MorphVfxTint)
		local skin = caster:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE)
		if skin ~= "phoenix" then
			local color = if skin == "marvel_girl"
				then GameConstants.MG_PSI_COLOR_MARVEL_GIRL
				else GameConstants.MG_PSI_COLOR
			for _, clone in clones do
				MorphVfxTint.paintFx(clone, color)
			end
		end
	end
	return clones
end

function VfxHelper.attachTelekinesisMorphParticles(model: Model): { Instance }
	return VfxHelper.attachHeroTelekinesisMorphParticles(model, "scarlet_witch", nil)
end

local function hardenWorldFx(root: Instance)
	stripBlockedSounds(root)
	local function harden(part: BasePart)
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CastShadow = false
	end
	if root:IsA("BasePart") then
		harden(root)
	end
	for _, desc in root:GetDescendants() do
		if desc:IsA("BasePart") then
			harden(desc)
		end
	end
end

local function snapFxToFloor(pos: Vector3, extraExclude: { Instance }?): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = extraExclude and table.clone(extraExclude) or {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(exclude, player.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	local result = workspace:Raycast(pos + Vector3.new(0, 12, 0), Vector3.new(0, -180, 0), params)
	if result then
		return result.Position
	end
	return Vector3.new(pos.X, pos.Y, pos.Z)
end

function VfxHelper.snapToFloor(pos: Vector3, extraExclude: { Instance }?): Vector3
	return snapFxToFloor(pos, extraExclude)
end

local function placeWorldClone(template: Instance, at: CFrame): Instance?
	local clone = template:Clone()
	hardenWorldFx(clone)
	local pos = at.Position
	if clone:IsA("Attachment") then
		local host = Instance.new("Part")
		host.Name = clone.Name .. "Host"
		host.Size = Vector3.new(0.2, 0.2, 0.2)
		host.Transparency = 1
		hardenWorldFx(host)
		host.CFrame = CFrame.new(pos)
		host.Parent = workspace
		clone.Parent = host
		setParticlesEnabled(clone, true)
		emitAllParticles(clone, 14)
		return host
	elseif clone:IsA("BasePart") then
		clone.CFrame = CFrame.new(pos) * clone.CFrame.Rotation
		clone.Parent = workspace
		setParticlesEnabled(clone, true)
		emitAllParticles(clone, 14)
		return clone
	elseif clone:IsA("Model") then
		clone.Parent = workspace
		clone:PivotTo(CFrame.new(pos) * clone:GetPivot().Rotation)
		setParticlesEnabled(clone, true)
		emitAllParticles(clone, 14)
		return clone
	else
		local host = Instance.new("Part")
		host.Name = "HexTeleportHost"
		host.Size = Vector3.new(0.2, 0.2, 0.2)
		host.Transparency = 1
		hardenWorldFx(host)
		host.CFrame = CFrame.new(pos)
		host.Parent = workspace
		clone.Parent = host
		setParticlesEnabled(clone, true)
		emitAllParticles(clone, 14)
		return host
	end
end

function VfxHelper.spawnHexTeleportMark(position: Vector3): Instance?
	local template = getScarletAsset("HexTeleport", "Teleport")
	if not template then
		warn("[VfxHelper] Missing Assets.ScarletWitchClassic.HexTeleport.Teleport")
		return nil
	end
	local floorPos = snapFxToFloor(position)
	local at = CFrame.new(floorPos + Vector3.new(0, GameConstants.HEX_TELEPORT_FX_HEIGHT, 0))
	return placeWorldClone(template, at)
end

function VfxHelper.spawnHexTeleportExplosion(position: Vector3): Instance?
	local floorPos = snapFxToFloor(position)
	local fxPos = floorPos + Vector3.new(0, GameConstants.HEX_TELEPORT_FX_HEIGHT, 0)
	VfxHelper.playWorldSound(GameConstants.HEX_TELEPORT_EXPLOSION_SOUND, fxPos, 1.15)
	local at = CFrame.new(fxPos)
	local explosion = getScarletAsset("HexTeleport", "Explosion")
	local attachment = getScarletAsset("HexTeleport", "ExplosionAttachment")
	if not explosion and not attachment then
		warn("[VfxHelper] Missing Assets.ScarletWitchClassic.HexTeleport.Explosion / ExplosionAttachment")
		return nil
	end
	local spawned: { Instance } = {}
	if explosion then
		local fx = placeWorldClone(explosion, at)
		if fx then
			table.insert(spawned, fx)
		end
	end
	if attachment then
		local fx = placeWorldClone(attachment, at)
		if fx then
			table.insert(spawned, fx)
		end
	end
	task.delay(0.35, function()
		for _, fx in spawned do
			VfxHelper.retireFxSmooth(fx, 0.5, GameConstants.HEX_TELEPORT_FX_LIFE)
		end
	end)
	return spawned[1]
end

function VfxHelper.muteSounds(root: Instance)
	local function mute(inst: Instance)
		if inst:IsA("Sound") then
			inst:Stop()
			inst.Playing = false
			inst.Volume = 0
		end
	end
	mute(root)
	for _, desc in root:GetDescendants() do
		mute(desc)
	end
end

function VfxHelper.playWorldSound(soundId: string, at: Vector3, volume: number?, playbackSpeed: number?)
	if soundId == "" then
		return
	end
	local host = Instance.new("Part")
	host.Name = "WorldSfx"
	host.Size = Vector3.new(0.2, 0.2, 0.2)
	host.Transparency = 1
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.CastShadow = false
	host.CFrame = CFrame.new(at)
	host.Parent = workspace
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or 0.9
	sound.PlaybackSpeed = playbackSpeed or 1
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMaxDistance = 90
	sound.RollOffMinDistance = 4
	sound.Parent = host
	if sound.IsLoaded then
		sound:Play()
	else
		sound.Loaded:Once(function()
			if sound.Parent then
				sound:Play()
			end
		end)
	end
	sound.Ended:Once(function()
		if host.Parent then
			host:Destroy()
		end
	end)
	Debris:AddItem(host, 8)
end

function VfxHelper.getWorldFollowPart(root: Instance?): BasePart?
	if not root then
		return nil
	end
	if root:IsA("BasePart") then
		return root
	end
	if root:IsA("Model") then
		return (root :: Model).PrimaryPart or root:FindFirstChildWhichIsA("BasePart", true)
	end
	return root:FindFirstChildWhichIsA("BasePart", true)
end

local function setWorldPosition(root: Instance, pos: Vector3)
	if root:IsA("Model") then
		local model = root :: Model
		local cf = model:GetPivot()
		model:PivotTo(CFrame.new(pos) * cf.Rotation)
	elseif root:IsA("BasePart") then
		local part = root :: BasePart
		part.CFrame = CFrame.new(pos) * part.CFrame.Rotation
	end
end

--[[
	Returns the travel VFX root plus a dedicated invisible BasePart for CameraSubject.
	camRide is NOT auto-destroyed — caller should clear the camera then destroy it after arrival.
]]
function VfxHelper.playHexTeleportTravel(
	fromPos: Vector3,
	toPos: Vector3,
	onArrived: (() -> ())?
): (Instance?, BasePart?)
	local template = getScarletAsset("HexTeleport", "Part")
	local duration = GameConstants.HEX_TELEPORT_TRAVEL_TIME
	local height = Vector3.new(0, GameConstants.HEX_TELEPORT_FX_HEIGHT, 0)
	fromPos = fromPos + height
	toPos = toPos + height
	local look = toPos - fromPos
	local fromCf = CFrame.new(fromPos)

	local camRide = Instance.new("Part")
	camRide.Name = "HexDisplacementCamRide"
	camRide.Size = Vector3.new(1.2, 1.2, 1.2)
	camRide.Transparency = 1
	camRide.Anchored = true
	camRide.CanCollide = false
	camRide.CanQuery = false
	camRide.CanTouch = false
	camRide.CastShadow = false
	camRide.Massless = true
	camRide.CFrame = fromCf
	camRide.Parent = workspace

	local mover: Instance? = nil
	if template then
		mover = placeWorldClone(template, fromCf)
	else
		warn("[VfxHelper] Missing Assets.ScarletWitchClassic.HexTeleport.Part")
	end

	local seed = math.random() * 32
	local wander = GameConstants.HEX_TELEPORT_WANDER
	local dir = if look.Magnitude > 0.05 then look.Unit else Vector3.new(0, 0, -1)
	local right = dir:Cross(Vector3.yAxis)
	if right.Magnitude < 0.05 then
		right = dir:Cross(Vector3.xAxis)
	end
	right = right.Unit
	local up = right:Cross(dir)
	if up.Magnitude > 0.05 then
		up = up.Unit
	else
		up = Vector3.yAxis
	end
	local dist = look.Magnitude
	local arcHeight = math.clamp(GameConstants.HEX_TELEPORT_ARC_HEIGHT + dist * 0.12, 14, 38)
	local peak = fromPos:Lerp(toPos, 0.5) + Vector3.new(0, arcHeight, 0)

	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.Heartbeat:Connect(function()
		local a = math.clamp((os.clock() - t0) / duration, 0, 1)
		local ease = a * a * (3 - 2 * a)
		local ab = fromPos:Lerp(peak, ease)
		local bc = peak:Lerp(toPos, ease)
		local along = ab:Lerp(bc, ease)
		local envelope = math.sin(math.pi * a)
		local ox = math.sin(a * 9.4 + seed) * wander * envelope
		local oy = math.cos(a * 6.7 + seed * 1.7) * wander * 0.55 * envelope
		local pos = along + right * ox + up * oy
		if camRide.Parent then
			camRide.CFrame = CFrame.new(pos)
		end
		if mover and mover.Parent then
			setWorldPosition(mover, pos)
		end
		if a >= 1 then
			if conn then
				conn:Disconnect()
			end
			if camRide.Parent then
				camRide.CFrame = CFrame.new(toPos)
			end
			if mover and mover.Parent then
				setWorldPosition(mover, toPos)
				VfxHelper.retireFxSmooth(mover, 0.4, GameConstants.HEX_TELEPORT_FX_LIFE)
			end
			VfxHelper.spawnHexTeleportExplosion(toPos)
			if onArrived then
				onArrived()
			end
		end
	end)
	return mover, camRide
end

task.defer(sanitizeScarletSoundTemplates)

return VfxHelper
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="22">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="23">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function disableNoisyLegacyScripts(root: Instance)
	for _, inst in root:GetDescendants() do
		if (inst:IsA("Script") or inst:IsA("LocalScript")) and inst.Name == "Game sounds" then
			inst.Disabled = true
		end
	end
end

disableNoisyLegacyScripts(game)
game.DescendantAdded:Connect(function(inst)
	if (inst:IsA("Script") or inst:IsA("LocalScript")) and inst.Name == "Game sounds" then
		inst.Disabled = true
	end
end)

local CharacterService = require(script.CharacterService)
local HexFlightService = require(script.HexFlightService)
local PhotonFlightService = require(script.PhotonFlightService)
local ProjectileThrowerService = require(script.ProjectileThrowerService)
local TelekineticThrowerService = require(script.TelekineticThrowerService)
local DamagerService = require(script.DamagerService)
local RagdollService = require(script.RagdollService)
local ScarletWitchService = require(script.ScarletWitchService)
local CaptainMarvelService = require(script.CaptainMarvelService)
local LokiService = require(script.LokiService)
local DaggerService = require(script.DaggerService)
local MarvelGirlService = require(script.MarvelGirlService)
local IcemanService = require(script.IcemanService)
local InvisibleWomanService = require(script.InvisibleWomanService)
local TelekinesisService = require(script.TelekinesisService)
local SprintService = require(script.SprintService)
local NameplateService = require(script.NameplateService)
local CombatService = require(script.CombatService)
local BeamClashService = require(script.BeamClashService)
local FallLandingService = require(script.FallLandingService)
local PlayerDataService = require(script.PlayerDataService)
local EconomyService = require(script.EconomyService)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local ProjectileHelper = require(ReplicatedStorage.Shared.ProjectileHelper)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

Remotes.init()
require(ReplicatedStorage.Shared.VfxHelper)
require(ReplicatedStorage.Shared.SmartBonePatch).install()

PlayerDataService.init()
EconomyService.init()
CharacterService.init()
SprintService.init()
NameplateService.init()
CombatService.init()
RagdollService.init()
FallLandingService.init()
HexFlightService.init()
PhotonFlightService.init()
TelekinesisService.init()
ScarletWitchService.init()
CaptainMarvelService.init()
LokiService.init()
DaggerService.init()
MarvelGirlService.init()
InvisibleWomanService.init()
IcemanService.init()
ProjectileThrowerService.init()
TelekineticThrowerService.init()
DamagerService.init()

-- Interrupt active abilities when the caster is ragdolled (beam clash excluded inside RagdollService)
RagdollService.onAbilityInterrupt(function(player: Player, _character: Model)
	ScarletWitchService.cancelAll(player)
	CaptainMarvelService.cancelAll(player)
	LokiService.cancelAll(player)
	DaggerService.cancelAll(player)
	MarvelGirlService.cancelAll(player)
	InvisibleWomanService.cancelAll(player)
	IcemanService.cancelAll(player)
	HexFlightService.endFlight(player, false)
	PhotonFlightService.endFlight(player, false)
	TelekinesisService.release(player)
end)

do
	local ok, err = pcall(function()
		BeamClashService.init()
		BeamClashService.registerSegmentProvider(ScarletWitchService.getActiveBeamSegments)
		BeamClashService.registerSegmentProvider(CaptainMarvelService.getActiveBeamSegments)
	end)
	if not ok then
		warn("[MCU Server] BeamClashService failed to init:", err)
	end
end

RunService.Heartbeat:Connect(function(dt)
	HexFlightService.update(dt)
	PhotonFlightService.update(dt)
	TelekinesisService.update(dt)
	ScarletWitchService.update(dt)
	CaptainMarvelService.update(dt)
	LokiService.update(dt)
	DaggerService.update(dt)
	MarvelGirlService.update(dt)
	InvisibleWomanService.update(dt)
	ProjectileHelper.update(dt)
	ProjectileThrowerService.update(dt)
	TelekineticThrowerService.update(dt)
	DamagerService.update(dt)
	SprintService.update(dt)
	FallLandingService.update(dt)
	-- After SprintService so high-fall landing lock wins over sprint walk speed
	IcemanService.update(dt)
	CombatService.update()
	pcall(function()
		BeamClashService.update(dt)
	end)

	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character and character:GetAttribute(GameConstants.HERO_ATTRIBUTE) then
			CharacterService.regenEnergy(character, dt)
		end
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">BeamClashService</string>
          <string name="Source"><![CDATA[--!strict
--[[ Archived: full Beam Clash lives in src/archive/BeamClashService.luau ]]

local BeamClashService = {}

export type BeamSegment = {
	id: string,
	kind: "player" | "dummy",
	player: Player?,
}

function BeamClashService.registerSegmentProvider(_provider: () -> { BeamSegment }) end

function BeamClashService.isCharacterClashing(_character: Model): boolean
	return false
end

function BeamClashService.shouldKeepBeamAlive(_character: Model): boolean
	return false
end

function BeamClashService.getForcedBeamTip(_character: Model): Vector3?
	return nil
end

function BeamClashService.handlePromptHit(_player: Player, _clashId: string?, _promptId: string?) end

function BeamClashService.update(_dt: number) end

function BeamClashService.init() end

return BeamClashService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">CaptainMarvelService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local ProjectileHelper = require(ReplicatedStorage.Shared.ProjectileHelper)
local PushHelper = require(ReplicatedStorage.Shared.PushHelper)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)
local CharacterService = require(script.Parent.CharacterService)
local PhotonFlightService = require(script.Parent.PhotonFlightService)
local PhotonParticleHelper = require(script.Parent.PhotonParticleHelper)
local RagdollService = require(script.Parent.RagdollService)
local BeamClashService = require(script.Parent.BeamClashService)

local CaptainMarvelService = {}

type BeamState = {
	character: Model,
	tipHost: BasePart,
	startAtt: Attachment,
	endAtt: Attachment,
	beam: Beam?,
	aimPoint: Vector3,
	smoothedTip: Vector3,
	lastHit: number,
}

local beamByPlayer: { [Player]: BeamState } = {}

local BINARY_PARTICLE_NAME = "CM_BinaryParticle"

local function clearBinaryParticles(character: Model)
	for _, desc in character:GetDescendants() do
		if desc.Name == BINARY_PARTICLE_NAME then
			desc:Destroy()
		end
	end
end

local function attachBinaryParticles(character: Model)
	clearBinaryParticles(character)
	local template = VfxHelper.getCaptainMarvelAsset("EnergyAbsorptionParticle")
	if not template then
		warn("[CaptainMarvel] Missing EnergyAbsorptionParticle under Assets.CaptainMarvel")
		return
	end
	local attSource: Instance = template
	if not template:IsA("Attachment") then
		local nested = template:FindFirstChildWhichIsA("Attachment", true)
		if nested then
			attSource = nested
		end
	end

	for _, desc in character:GetDescendants() do
		if desc:IsA("BasePart") and not desc:FindFirstAncestorOfClass("Accessory") then
			local clone = attSource:Clone()
			clone.Name = BINARY_PARTICLE_NAME
			if clone:IsA("Attachment") then
				clone.Position = Vector3.zero
			end
			clone.Parent = desc
			VfxHelper.setParticlesEnabled(clone, true)
			VfxHelper.emitAllParticles(clone, 6)
		end
	end
end

local binaryTokenByPlayer: { [Player]: number } = {}

local function stopBinaryForm(player: Player, applyCooldown: boolean?)
	local character = player.Character
	if not character then
		return
	end
	if character:GetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE) ~= true then
		return
	end
	binaryTokenByPlayer[player] = (binaryTokenByPlayer[player] or 0) + 1
	character:SetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.BINARY_UNTIL_ATTRIBUTE, nil)
	AbilityCooldownHelper.setActive(character, "binary_form", false)
	clearBinaryParticles(character)
	PhotonParticleHelper.endUse(character)
	if applyCooldown then
		AbilityCooldownHelper.applyAfterUse(character, "binary_form", GameConstants.BINARY_COOLDOWN)
	end
end

local function startBinaryForm(player: Player)
	local character = player.Character
	if not character then
		return
	end
	if character:GetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE) == true then
		stopBinaryForm(player, true)
		return
	end
	local entry = CharacterRegistry.getAbilityById("captain_marvel", "binary_form")
	if not entry then
		return
	end
	if CombatHelper.arePowersDisabled(character) then
		return
	end
	if AbilityCooldownHelper.isOnCooldown(character, "binary_form") then
		return
	end
	if AbilityCooldownHelper.isActive(character, "binary_form") then
		return
	end

	AbilityCooldownHelper.setActive(character, "binary_form", true)
	character:SetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE, true)
	local untilTime = AbilityCooldownHelper.getNow() + GameConstants.BINARY_DURATION
	character:SetAttribute(GameConstants.BINARY_UNTIL_ATTRIBUTE, untilTime)
	PhotonParticleHelper.beginUse(character)
	attachBinaryParticles(character)
	CharacterService.markAbilityUse(character)

	local token = (binaryTokenByPlayer[player] or 0) + 1
	binaryTokenByPlayer[player] = token
	task.delay(GameConstants.BINARY_DURATION, function()
		if binaryTokenByPlayer[player] ~= token then
			return
		end
		if player.Character and player.Character:GetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE) == true then
			stopBinaryForm(player, true)
		end
	end)
end

local function energyDrainMult(character: Model): number
	if character:GetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE) == true then
		return GameConstants.BINARY_ENERGY_MULT
	end
	return 1
end

local function finishAbility(character: Model, abilityId: string, cooldown: number)
	AbilityCooldownHelper.setActive(character, abilityId, false)
	AbilityCooldownHelper.applyAfterUse(character, abilityId, cooldown)
end

local function canUse(character: Model, abilityId: string, energyCost: number): boolean
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "captain_marvel" then
		return false
	end
	if CombatHelper.arePowersDisabled(character) then
		return false
	end
	if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return false
	end
	if AbilityCooldownHelper.isOnCooldown(character, abilityId) then
		return false
	end
	if AbilityCooldownHelper.isActive(character, abilityId) then
		return false
	end
	-- One ability at a time (photon flight excluded)
	for _, ab in CharacterRegistry.getAbilities("captain_marvel") do
		if ab.passive or ab.id == abilityId or ab.id == "photon_flight" then
			continue
		end
		if AbilityCooldownHelper.isActive(character, ab.id) then
			return false
		end
	end
	if not CharacterService.spendEnergy(character, energyCost) then
		return false
	end
	return true
end

local function getRightHand(character: Model): BasePart?
	return (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")) :: BasePart?
end

local function getOrigin(character: Model): Vector3
	local hand = getRightHand(character)
	if hand then
		return hand.Position
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if root then root.Position + Vector3.new(0, 1.5, 0) else Vector3.zero
end

local function cloneMarvelAttachment(assetName: string): Attachment?
	local template = VfxHelper.getCaptainMarvelAsset(assetName)
	if not template then
		return nil
	end
	local source: Instance = template
	if not template:IsA("Attachment") then
		local nested = template:FindFirstChildWhichIsA("Attachment", true)
		if not nested then
			return nil
		end
		source = nested
	end
	local clone = source:Clone()
	if not clone:IsA("Attachment") then
		clone:Destroy()
		return nil
	end
	-- Keep beam endpoints at the hand / tip, not the asset's authored offset
	clone.Position = Vector3.zero
	clone.Orientation = Vector3.zero
	return clone
end

local function wireBeam(startAtt: Attachment, endAtt: Attachment): Beam?
	local beam = startAtt:FindFirstChildWhichIsA("Beam", true) or endAtt:FindFirstChildWhichIsA("Beam", true)
	if not beam then
		beam = Instance.new("Beam")
		beam.Name = "PhotonBeam"
		beam.Width0 = 1.1
		beam.Width1 = 0.85
		beam.FaceCamera = true
		beam.LightEmission = 0.85
		beam.LightInfluence = 0
		beam.Color = ColorSequence.new(VfxHelper.photonColor())
		beam.Parent = startAtt
	end
	beam.Attachment0 = startAtt
	beam.Attachment1 = endAtt
	beam.Enabled = true
	return beam
end

local function setMode(player: Player, abilityId: string, mode: string)
	local character = player.Character
	if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "captain_marvel" then
		return
	end
	if abilityId == "photon_flight" and (mode == "Normal" or mode == "Accelerated") then
		character:SetAttribute(GameConstants.PHOTON_FLIGHT_MODE_ATTRIBUTE, mode)
	end
end

local diveTokenByPlayer: { [Player]: number } = {}

local function applyPhotonDiveImpact(character: Model, origin: Vector3)
	VfxHelper.spawnPhotonGroundSlam(origin, GameConstants.PHOTON_DIVE_RADIUS)
	local near = CombatHelper.overlapCharacters(origin, GameConstants.PHOTON_DIVE_RADIUS, character)
	for _, victim in near do
		CombatHelper.dealDamage(character, victim, GameConstants.PHOTON_DIVE_DAMAGE, origin, "explosion")
		RagdollService.applyTimed(victim, GameConstants.PHOTON_DIVE_RAGDOLL)
		local vRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
		if vRoot then
			local push = vRoot.Position - origin
			if push.Magnitude > 0.05 then
				PushHelper.applyToCharacter(victim, push.Unit, {
					speed = GameConstants.PHOTON_DIVE_PUSH_SPEED,
					upBoost = GameConstants.PHOTON_DIVE_PUSH_UP,
				})
			end
		end
	end
end

local function castPhotonDive(player: Player, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	if not PhotonFlightService.isFlying(player) then
		return
	end
	local entry = CharacterRegistry.getAbilityById("captain_marvel", "photon_dive")
	if not entry or not canUse(character, entry.id, GameConstants.PHOTON_DIVE_ENERGY) then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	local probe = aimPoint or (root.Position + root.CFrame.LookVector * 40)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local cast = Workspace:Raycast(probe + Vector3.new(0, 8, 0), Vector3.new(0, -120, 0), params)
	if not cast then
		cast = Workspace:Raycast(root.Position, Vector3.new(0, -200, 0), params)
	end
	if not cast then
		local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		if type(energy) == "number" then
			character:SetAttribute(GameConstants.ENERGY_ATTRIBUTE, energy + GameConstants.PHOTON_DIVE_ENERGY)
		end
		return
	end

	local flat = Vector3.new(cast.Position.X - root.Position.X, 0, cast.Position.Z - root.Position.Z)
	if flat.Magnitude > GameConstants.PHOTON_DIVE_MAX_RANGE then
		flat = flat.Unit * GameConstants.PHOTON_DIVE_MAX_RANGE
		local reclamped = Workspace:Raycast(
			Vector3.new(root.Position.X + flat.X, root.Position.Y + 8, root.Position.Z + flat.Z),
			Vector3.new(0, -120, 0),
			params
		)
		if reclamped then
			cast = reclamped
		end
	end

	local groundPos = cast.Position
	-- Dive toward a point slightly above ground so we don't clip; impact uses groundPos
	local diveTarget = groundPos + Vector3.new(0, 3.2, 0)
	AbilityCooldownHelper.setActive(character, entry.id, true)
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	PhotonParticleHelper.beginUse(character)
	PhotonFlightService.setDiveTarget(player, diveTarget)

	local token = (diveTokenByPlayer[player] or 0) + 1
	diveTokenByPlayer[player] = token

	task.spawn(function()
		local t0 = os.clock()
		local landed = false
		local impactGround = groundPos
		while diveTokenByPlayer[player] == token and PhotonFlightService.isFlying(player) and (os.clock() - t0) < 2.8 do
			local pos = PhotonFlightService.getPosition(player)
			if not pos then
				break
			end
			if (pos - diveTarget).Magnitude <= GameConstants.PHOTON_DIVE_LAND_DIST then
				landed = true
				break
			end
			local groundHit = Workspace:Raycast(pos, Vector3.new(0, -8, 0), params)
			if groundHit then
				local nearTarget = (Vector3.new(groundHit.Position.X, 0, groundHit.Position.Z)
					- Vector3.new(groundPos.X, 0, groundPos.Z)).Magnitude < GameConstants.PHOTON_DIVE_RADIUS
				if nearTarget or pos.Y - groundHit.Position.Y < 4.5 then
					impactGround = groundHit.Position
					landed = true
					break
				end
			end
			task.wait()
		end

		PhotonFlightService.clearDive(player)

		if character.Parent then
			character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
		end

		if landed and character.Parent and player.Character == character then
			-- Stop flight on impact, then slam at ground level
			if PhotonFlightService.isFlying(player) then
				PhotonFlightService.endFlight(player, true)
			end
			local liveRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if liveRoot then
				local g = Workspace:Raycast(liveRoot.Position + Vector3.new(0, 4, 0), Vector3.new(0, -30, 0), params)
				if g then
					impactGround = g.Position
				end
				local look = liveRoot.CFrame.LookVector
				local flatLook = Vector3.new(look.X, 0, look.Z)
				if flatLook.Magnitude < 0.05 then
					flatLook = Vector3.new(0, 0, -1)
				else
					flatLook = flatLook.Unit
				end
				liveRoot.CFrame = CFrame.lookAt(impactGround + Vector3.new(0, 3, 0), impactGround + Vector3.new(0, 3, 0) + flatLook)
				liveRoot.AssemblyLinearVelocity = Vector3.zero
				liveRoot.AssemblyAngularVelocity = Vector3.zero
			end
			applyPhotonDiveImpact(character, impactGround)
		end

		if character.Parent then
			PhotonParticleHelper.endUse(character)
			finishAbility(character, entry.id, GameConstants.PHOTON_DIVE_COOLDOWN)
			CharacterService.markAbilityUse(character)
		end
		if diveTokenByPlayer[player] == token then
			diveTokenByPlayer[player] = nil
		end
	end)
end

local function firePhotonBlast(player: Player, direction: Vector3, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("captain_marvel", "photon_blast")
	if not entry or not canUse(character, entry.id, entry.energyCost) then
		return
	end

	local origin = getOrigin(character)
	local dir = if direction.Magnitude > 0.01 then direction.Unit else character:GetPivot().LookVector
	local homeDir = dir
	if aimPoint then
		local toAim = aimPoint - origin
		if toAim.Magnitude > 0.05 then
			homeDir = toAim.Unit
		end
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	PhotonParticleHelper.beginUse(character)
	VfxHelper.castHandFlash(origin, VfxHelper.photonColor())

	-- Slight delay so blast syncs with cast motion
	task.delay(0.1, function()
		if not character.Parent or player.Character ~= character then
			AbilityCooldownHelper.setActive(character, entry.id, false)
			PhotonParticleHelper.endUse(character)
			return
		end
		local fireOrigin = getOrigin(character)
		ProjectileHelper.spawn(fireOrigin, homeDir, {
			speed = GameConstants.PHOTON_BLAST_SPEED,
			damage = GameConstants.PHOTON_BLAST_DAMAGE,
			radius = GameConstants.PHOTON_BLAST_HIT_RADIUS,
			maxDistance = GameConstants.PHOTON_BLAST_RANGE,
			owner = character,
			color = VfxHelper.photonColor(),
			homeDir = homeDir,
			homePoint = aimPoint or (fireOrigin + homeDir * math.min(60, GameConstants.PHOTON_BLAST_RANGE * 0.7)),
			homeAfter = 0,
			seekUntilClose = true,
			seekCloseDistance = 2.2,
			boltFolder = "CaptainMarvel",
			boltAsset = "PhotonBlast",
			impactFx = "photon_blast",
		})
		CombatHelper.spendAbsorbCharge(character, GameConstants.CM_ABSORB_SPEND_BLAST)
		VfxHelper.spawnBeamLine(fireOrigin, fireOrigin + homeDir * 8, VfxHelper.photonSoft(), 0.35, 0.16)
		finishAbility(character, entry.id, entry.cooldown)
		task.delay(0.4, function()
			if character.Parent then
				PhotonParticleHelper.endUse(character)
			end
		end)
	end)
end

local function firePhotonExplosion(player: Player, direction: Vector3, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("captain_marvel", "photon_explosion")
	if not entry or not canUse(character, entry.id, entry.energyCost) then
		return
	end

	local origin = getOrigin(character)
	local dir = if direction.Magnitude > 0.01 then direction.Unit else character:GetPivot().LookVector
	local homeDir = dir
	if aimPoint then
		local toAim = aimPoint - origin
		if toAim.Magnitude > 0.05 then
			homeDir = toAim.Unit
		end
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	PhotonParticleHelper.beginUse(character)
	VfxHelper.castHandFlash(origin, VfxHelper.photonColor())

	-- Projectile uses PhotonBlast for now; ExplosionAttachment plays at impact
	ProjectileHelper.spawn(origin, homeDir, {
		speed = GameConstants.PHOTON_BLAST_SPEED,
		damage = GameConstants.PHOTON_EXPLOSION_DAMAGE,
		radius = GameConstants.PHOTON_BLAST_HIT_RADIUS,
		maxDistance = GameConstants.PHOTON_BLAST_RANGE,
		owner = character,
		color = VfxHelper.photonColor(),
		homeDir = homeDir,
		homePoint = aimPoint or (origin + homeDir * math.min(60, GameConstants.PHOTON_BLAST_RANGE * 0.7)),
		homeAfter = 0,
		seekUntilClose = true,
		seekCloseDistance = 2.2,
		boltFolder = "CaptainMarvel",
		boltAsset = "PhotonBlast",
		impactAoeRadius = GameConstants.PHOTON_EXPLOSION_RADIUS,
		impactAoeDamage = GameConstants.PHOTON_EXPLOSION_DAMAGE,
		impactFx = "photon_explosion",
		ragdollOnHit = GameConstants.PHOTON_EXPLOSION_RAGDOLL,
		pushOnHit = true,
		pushSpeed = GameConstants.PHOTON_EXPLOSION_PUSH_SPEED,
		pushUp = GameConstants.PHOTON_EXPLOSION_PUSH_UP,
	})
	CombatHelper.spendAbsorbCharge(character, GameConstants.CM_ABSORB_SPEND_EXPLOSION)
	VfxHelper.spawnBeamLine(origin, origin + homeDir * 8, VfxHelper.photonSoft(), 0.4, 0.2)
	finishAbility(character, entry.id, entry.cooldown)
	task.delay(0.45, function()
		if character.Parent then
			PhotonParticleHelper.endUse(character)
		end
	end)
end

local function fadeOutBeamFx(startAtt: Attachment, endAtt: Attachment, tipHost: BasePart, beam: Beam?)
	VfxHelper.setParticlesEnabled(startAtt, false)
	VfxHelper.setParticlesEnabled(endAtt, false)
	if beam then
		beam.Enabled = false
	end
	task.delay(BEAM_FX_FADE, function()
		if startAtt.Parent then
			startAtt:Destroy()
		end
		if tipHost.Parent then
			tipHost:Destroy()
		end
	end)
end

local function stopPhotonBeam(player: Player, applyCooldown: boolean?)
	local state = beamByPlayer[player]
	if not state then
		return
	end
	if state.character:GetAttribute(GameConstants.BEAM_CLASH_ATTRIBUTE) == true
		or BeamClashService.shouldKeepBeamAlive(state.character)
	then
		return
	end
	beamByPlayer[player] = nil
	fadeOutBeamFx(state.startAtt, state.endAtt, state.tipHost, state.beam)
	local char = state.character
	if char.Parent then
		AbilityCooldownHelper.setActive(char, "photon_beam", false)
		PhotonParticleHelper.endUse(char, "Right")
		if applyCooldown then
			local entry = CharacterRegistry.getAbilityById("captain_marvel", "photon_beam")
			if entry then
				AbilityCooldownHelper.applyAfterUse(char, entry.id, entry.cooldown)
			end
		end
	end
end

function CaptainMarvelService.forceStopBeam(player: Player, applyCooldown: boolean?)
	local state = beamByPlayer[player]
	if not state then
		return
	end
	beamByPlayer[player] = nil
	fadeOutBeamFx(state.startAtt, state.endAtt, state.tipHost, state.beam)
	local char = state.character
	if char.Parent then
		AbilityCooldownHelper.setActive(char, "photon_beam", false)
		PhotonParticleHelper.endUse(char, "Right")
		if applyCooldown then
			local entry = CharacterRegistry.getAbilityById("captain_marvel", "photon_beam")
			if entry then
				AbilityCooldownHelper.applyAfterUse(char, entry.id, entry.cooldown)
			end
		end
	end
end

local function startPhotonBeam(player: Player, aimPoint: Vector3)
	local character = player.Character
	if not character or beamByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById("captain_marvel", "photon_beam")
	if not entry or not canUse(character, entry.id, entry.energyCost) then
		return
	end

	local hand = getRightHand(character)
	if not hand then
		return
	end

	local startAtt = cloneMarvelAttachment("BeamStartAttachment")
	local endAtt = cloneMarvelAttachment("BeamEndAttachment")
	if not startAtt or not endAtt then
		warn("[CaptainMarvel] Missing BeamStartAttachment / BeamEndAttachment under Assets.CaptainMarvel")
		-- refund energy spent by canUse
		local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		if type(energy) == "number" then
			character:SetAttribute(
				GameConstants.ENERGY_ATTRIBUTE,
				math.min(
					(character:GetAttribute(GameConstants.MAX_ENERGY_ATTRIBUTE) :: number?) or 100,
					energy + entry.energyCost
				)
			)
		end
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	PhotonParticleHelper.beginUse(character, "Right")

	startAtt.Name = "CM_BeamStartAttachment"
	startAtt.Parent = hand

	local tipHost = Instance.new("Part")
	tipHost.Name = "PhotonBeamTipHost"
	tipHost.Size = Vector3.new(0.2, 0.2, 0.2)
	tipHost.Transparency = 1
	tipHost.Anchored = true
	tipHost.CanCollide = false
	tipHost.CanQuery = false
	tipHost.CanTouch = false
	tipHost.CFrame = CFrame.lookAt(aimPoint, getOrigin(character))
	tipHost.Parent = Workspace

	endAtt.Name = "CM_BeamEndAttachment"
	endAtt.Parent = tipHost

	local beam = wireBeam(startAtt, endAtt)

	VfxHelper.setParticlesEnabled(startAtt, true)
	VfxHelper.setParticlesEnabled(endAtt, true)
	VfxHelper.emitAllParticles(startAtt, 10)
	VfxHelper.emitAllParticles(endAtt, 10)

	beamByPlayer[player] = {
		character = character,
		tipHost = tipHost,
		startAtt = startAtt,
		endAtt = endAtt,
		beam = beam,
		aimPoint = aimPoint,
		smoothedTip = aimPoint,
		lastHit = 0,
	}
end

function CaptainMarvelService.update(dt: number)
	local now = AbilityCooldownHelper.getNow()
	local dtClamped = math.clamp(dt, 0.001, 0.1)

	for _, player in Players:GetPlayers() do
		local char = player.Character
		if char and char:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "captain_marvel" then
			CombatHelper.decayAbsorbCharge(char, dtClamped)
			local untilTime = char:GetAttribute(GameConstants.BINARY_UNTIL_ATTRIBUTE)
			if
				char:GetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE) == true
				and type(untilTime) == "number"
				and now >= untilTime
			then
				stopBinaryForm(player, true)
			end
		end
	end

	for player, state in beamByPlayer do
		local char = state.character
		if not char.Parent or player.Character ~= char then
			stopPhotonBeam(player, true)
			continue
		end

		local energy = char:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		if type(energy) ~= "number" or energy <= 0 then
			stopPhotonBeam(player, true)
			continue
		end
		char:SetAttribute(
			GameConstants.ENERGY_ATTRIBUTE,
			math.max(0, energy - GameConstants.PHOTON_BEAM_ENERGY_PER_SEC * energyDrainMult(char) * dtClamped)
		)
		CharacterService.markAbilityUse(char)
		do
			local charge = char:GetAttribute(GameConstants.ABSORB_CHARGE_ATTRIBUTE)
			if type(charge) == "number" and charge > 0 then
				char:SetAttribute(
					GameConstants.ABSORB_CHARGE_ATTRIBUTE,
					math.max(0, charge - GameConstants.CM_ABSORB_SPEND_BEAM_PER_SEC * dtClamped)
				)
			end
		end

		local origin = if state.startAtt.Parent then state.startAtt.WorldPosition else getOrigin(char)
		local toAim = state.aimPoint - origin
		local dir = if toAim.Magnitude > 0.05 then toAim.Unit else char:GetPivot().LookVector
		local maxDist = GameConstants.PHOTON_BEAM_RANGE

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char, state.tipHost }
		local hit = Workspace:Raycast(origin, dir * maxDist, params)
		local desiredTip = if hit then hit.Position else origin + dir * maxDist

		local tipLerp = 1 - (1 - 0.22) ^ (dtClamped * 60)
		state.smoothedTip = state.smoothedTip:Lerp(desiredTip, tipLerp)
		local tipPos = state.smoothedTip

		local forcedTip = BeamClashService.getForcedBeamTip(char)
		if forcedTip then
			tipPos = forcedTip
			state.smoothedTip = forcedTip
		end

		-- Face tip back toward the hand so end attachment / particles align with the beam
		if (origin - tipPos).Magnitude > 0.05 then
			state.tipHost.CFrame = CFrame.lookAt(tipPos, origin)
		else
			state.tipHost.CFrame = CFrame.new(tipPos)
		end
		if state.beam and not state.beam.Enabled then
			state.beam.Enabled = true
		end
		if state.beam then
			state.beam.Attachment0 = state.startAtt
			state.beam.Attachment1 = state.endAtt
		end

		if now - state.lastHit >= 0.12 then
			state.lastHit = now
			if char:GetAttribute(GameConstants.BEAM_CLASH_ATTRIBUTE) == true or forcedTip then
				-- skip tip damage while clashing
			else
				local half = GameConstants.PHOTON_BEAM_HIT_SIZE
				local overlap = OverlapParams.new()
				overlap.FilterType = Enum.RaycastFilterType.Exclude
				overlap.FilterDescendantsInstances = { char, state.tipHost }
				local tipCf = if (origin - tipPos).Magnitude > 0.05
					then CFrame.lookAt(tipPos, origin)
					else CFrame.new(tipPos)
				local box = Workspace:GetPartBoundsInBox(tipCf, Vector3.new(half, half, half), overlap)
				local seen: { [Model]: boolean } = {}
				for _, part in box do
					local victim = CombatHelper.getCharacterFromPart(part)
					if victim and victim ~= char and not seen[victim] then
						seen[victim] = true
						CombatHelper.dealDamage(char, victim, GameConstants.PHOTON_BEAM_DAMAGE_PER_SEC * 0.12, nil, "beam")
					end
				end
			end
		end
	end
end

function CaptainMarvelService.handleAction(player: Player, payload: any)
	if type(payload) ~= "table" then
		return
	end
	local character = player.Character
	if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "captain_marvel" then
		return
	end

	local action = payload.action
	if type(action) ~= "string" then
		return
	end

	local direction = if typeof(payload.direction) == "Vector3" then payload.direction else Vector3.new(0, 0, -1)
	local aimPoint = if typeof(payload.aimPoint) == "Vector3" then payload.aimPoint else nil

	if action == "SetMode" then
		if type(payload.abilityId) == "string" and type(payload.mode) == "string" then
			setMode(player, payload.abilityId, payload.mode)
		end
		return
	end

	if action == "Q" then
		firePhotonBlast(player, direction, aimPoint)
	elseif action == "E_down" or action == "E" then
		firePhotonExplosion(player, direction, aimPoint)
	elseif action == "F" then
		PhotonFlightService.toggleFlight(player)
	elseif action == "C" then
		castPhotonDive(player, aimPoint)
	elseif action == "X" then
		startBinaryForm(player)
	elseif action == "T_down" then
		startPhotonBeam(
			player,
			aimPoint or (character:GetPivot().Position + direction * 40)
		)
	elseif action == "T_up" then
		stopPhotonBeam(player, true)
	elseif action == "T_aim" then
		local state = beamByPlayer[player]
		if state and aimPoint then
			state.aimPoint = aimPoint
		end
	end
end

function CaptainMarvelService.cancelAll(player: Player)
	CaptainMarvelService.forceStopBeam(player, false)
	stopBinaryForm(player, false)
	diveTokenByPlayer[player] = nil
	PhotonFlightService.clearDive(player)
	PhotonFlightService.endFlight(player, false)
	local char = player.Character
	if char then
		char:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
		AbilityCooldownHelper.setActive(char, "photon_dive", false)
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health <= 0 then
			RagdollService.apply(char)
		end
	end
end

function CaptainMarvelService.getActiveBeamSegments(): {
	{
		id: string,
		kind: "player",
		player: Player,
		character: Model,
		origin: Vector3,
		tip: Vector3,
		label: string,
	}
}
	local list = {}
	for player, state in beamByPlayer do
		local char = state.character
		if char.Parent and player.Character == char then
			local origin = if state.startAtt.Parent then state.startAtt.WorldPosition else char:GetPivot().Position
			local tip = state.tipHost.Position
			table.insert(list, {
				id = "photon:" .. tostring(player.UserId),
				kind = "player" :: "player",
				player = player,
				character = char,
				origin = origin,
				tip = tip,
				label = player.DisplayName,
			})
		end
	end
	return list
end

function CaptainMarvelService.init()
	Remotes.getEvent("UseAbility").OnServerEvent:Connect(function(player: Player, payload: any)
		CaptainMarvelService.handleAction(player, payload)
	end)

	local function hookPlayer(player: Player)
		player.CharacterRemoving:Connect(function()
			CaptainMarvelService.cancelAll(player)
		end)
		player.CharacterAdded:Connect(function(character)
			local humanoid = character:WaitForChild("Humanoid", 5)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Died:Connect(function()
					CaptainMarvelService.cancelAll(player)
				end)
			end
		end)
		if player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.Died:Connect(function()
					CaptainMarvelService.cancelAll(player)
				end)
			end
		end
	end

	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end
	Players.PlayerAdded:Connect(hookPlayer)

	Players.PlayerRemoving:Connect(function(player)
		CaptainMarvelService.cancelAll(player)
	end)
end

return CaptainMarvelService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">CharacterService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local MorphAnimationHelper = require(ReplicatedStorage.Shared.MorphAnimationHelper)
local MorphVfxTint = require(ReplicatedStorage.Shared.MorphVfxTint)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)
local HandParticleHelper = require(script.Parent.HandParticleHelper)
local PlayerDataService = require(script.Parent.PlayerDataService)

local CharacterService = {}

local selectedHero: { [Player]: string } = {}
local pendingDeploy: { [Player]: string } = {}
local pendingSkin: { [Player]: string } = {}
-- "starter" = plain StarterCharacter; "clothes" = starter + player clothes; "avatar" = true Roblox avatar; "morph" = Assets.Morphs
local lookModeByPlayer: { [Player]: string } = {}
local morphReady: { [Player]: boolean } = {}

local function clearHeroSelection(player: Player)
	selectedHero[player] = nil
	pendingDeploy[player] = nil
	pendingSkin[player] = nil
	lookModeByPlayer[player] = nil
	morphReady[player] = nil
end

local function normalizeLookMode(value: any): string
	if value == "starter" or value == "clothes" or value == "avatar" then
		return value
	end
	-- Legacy boolean from older clients
	if value == false then
		return "starter"
	end
	if value == true then
		return "clothes"
	end
	return "clothes"
end

local SPRINT_BLOCK_ABILITIES = {
	"hex_bolt",
	"probability_hex",
	"hex_displacement",
	"rune_entrapment",
	"hex_flight",
	"photon_flight",
	"photon_blast",
	"photon_beam",
	"photon_explosion",
	"binary_form",
	"telekinesis",
	"hex_beam",
	"hex_shield",
	"teleport",
	"fear",
	"regeneration",
	"ultimate",
	"telekinetic_slam",
	"forcefield_crush",
	"forcefield_smash",
}

local function getStarterCharacterTemplate(): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local template = assets and assets:FindFirstChild("StarterCharacter")
	if template and template:IsA("Model") then
		return template
	end
	return nil
end

local function ensureAnimator(humanoid: Humanoid): Animator
	local existing = humanoid:FindFirstChildOfClass("Animator")
	if existing then
		return existing
	end
	local animator = Instance.new("Animator")
	animator.Name = "Animator"
	animator.Parent = humanoid
	return animator
end

local function prepareDescriptionForRobloxian2(desc: HumanoidDescription): HumanoidDescription
	desc.HeightScale = 1
	desc.WidthScale = 1
	desc.DepthScale = 1
	desc.HeadScale = 1
	desc.BodyTypeScale = 0
	desc.ProportionScale = 0
	return desc
end

local function restoreStarterAnimate(morph: Model, animateBackup: Instance?)
	for _, child in morph:GetChildren() do
		if child.Name == "Animate" then
			child:Destroy()
		end
	end
	if animateBackup then
		animateBackup.Parent = morph
	end
end

local function applyPlayerAppearance(humanoid: Humanoid, morph: Model, player: Player, keepNaturalScale: boolean?)
	ensureAnimator(humanoid)
	local animateBackup: Instance? = nil
	local existingAnimate = morph:FindFirstChild("Animate")
	if existingAnimate then
		animateBackup = existingAnimate:Clone()
	end

	local ok, descOrErr = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(player.UserId)
	end)
	if not ok or typeof(descOrErr) ~= "Instance" then
		warn("[CharacterService] Failed to get HumanoidDescription for", player.Name, descOrErr)
		if animateBackup then
			animateBackup:Destroy()
		end
		return
	end
	local desc = descOrErr :: HumanoidDescription
	if not keepNaturalScale then
		-- StarterCharacter (Robloxian2) needs flattened scales
		desc = prepareDescriptionForRobloxian2(desc)
	end
	local applyOk, applyErr = pcall(function()
		humanoid:ApplyDescription(desc)
	end)
	if not applyOk then
		warn("[CharacterService] ApplyDescription failed for", player.Name, applyErr)
	end
	ensureAnimator(humanoid)
	restoreStarterAnimate(morph, animateBackup)
	MorphAnimationHelper.applyToModel(morph, GameConstants.BASIC_IDLE_ANIM)

	task.defer(function()
		local NameplateService = require(script.Parent.NameplateService)
		NameplateService.refresh(morph)
	end)
end

local function replaceWithStarterMorph(player: Player, oldCharacter: Model, applyAvatar: boolean): Model?
	local template = getStarterCharacterTemplate()
	if not template then
		warn("[CharacterService] Missing ReplicatedStorage.Assets.StarterCharacter")
		return nil
	end

	local spawnCf = oldCharacter:GetPivot()
	local morph = template:Clone()
	morph.Name = player.Name

	local humanoid = morph:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		warn("[CharacterService] StarterCharacter has no Humanoid")
		morph:Destroy()
		return nil
	end

	ensureAnimator(humanoid)

	local hrp = morph:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp and not morph.PrimaryPart then
		morph.PrimaryPart = hrp
	end

	morph.Parent = workspace
	morph:PivotTo(spawnCf)

	-- End flight before swapping Character so movers don't stick across bodies
	local HexFlightService = require(script.Parent.HexFlightService)
	local PhotonFlightService = require(script.Parent.PhotonFlightService)
	HexFlightService.endFlight(player, false)
	PhotonFlightService.endFlight(player, false)

	morphReady[player] = true
	player.Character = morph
	if applyAvatar then
		applyPlayerAppearance(humanoid, morph, player)
	end
	ensureAnimator(humanoid)
	MorphAnimationHelper.applyToModel(morph, GameConstants.BASIC_IDLE_ANIM)
	morph:PivotTo(spawnCf)

	if oldCharacter.Parent then
		CombatHelper.silenceDeathSounds(oldCharacter)
		oldCharacter:Destroy()
	end

	return morph
end

local function freezeForMenu(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
		humanoid.AutoRotate = false
	end
end

local function replaceWithHeroMorph(player: Player, oldCharacter: Model, heroId: string, skinId: string): Model?
	local template = CharacterRegistry.getMorphTemplate(heroId, skinId)
	if not template then
		warn("[CharacterService] Missing morph for", heroId, skinId)
		return nil
	end

	local spawnCf = oldCharacter:GetPivot()
	local morph = template:Clone()
	morph.Name = player.Name

	for _, desc in morph:GetDescendants() do
		if desc:IsA("Script") or desc:IsA("LocalScript") then
			desc.Disabled = true
		end
	end

	MorphVfxTint.applyForSkin(morph, heroId, skinId, template.Name)
	MorphAnimationHelper.applyToModel(morph, MorphAnimationHelper.idleIdForMorphName(template.Name))

	local humanoid = morph:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		warn("[CharacterService] Morph has no Humanoid:", template.Name)
		morph:Destroy()
		return nil
	end
	ensureAnimator(humanoid)

	local hrp = morph:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp and not morph.PrimaryPart then
		morph.PrimaryPart = hrp
	end

	morph.Parent = workspace
	morph:PivotTo(spawnCf)

	local HexFlightService = require(script.Parent.HexFlightService)
	local PhotonFlightService = require(script.Parent.PhotonFlightService)
	HexFlightService.endFlight(player, false)
	PhotonFlightService.endFlight(player, false)

	morphReady[player] = true
	player.Character = morph
	ensureAnimator(humanoid)
	morph:PivotTo(spawnCf)

	if oldCharacter.Parent then
		CombatHelper.silenceDeathSounds(oldCharacter)
		oldCharacter:Destroy()
	end

	return morph
end

function CharacterService.getSelectedHero(player: Player): string?
	return selectedHero[player]
end

function CharacterService.getLookMode(player: Player): string
	return lookModeByPlayer[player] or "clothes"
end

function CharacterService.wantsPlayerAvatar(player: Player): boolean
	local mode = lookModeByPlayer[player]
	return mode == "clothes" or mode == "avatar"
end

function CharacterService.isSprintBlocked(character: Model): boolean
	if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute("AbsorbActive") == true then
		return true
	end
	if character:GetAttribute("BarrageSpinActive") == true then
		return true
	end
	if character:GetAttribute(GameConstants.DISINTEGRATE_ACTIVE_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.HIGH_FALL_LANDING_ATTRIBUTE) == true then
		return true
	end
	return AbilityCooldownHelper.isAnyActive(character, SPRINT_BLOCK_ABILITIES)
end

function CharacterService.applyHeroToCharacter(player: Player, character: Model, heroId: string?)
	local resolvedHeroId = heroId or selectedHero[player]
	if not resolvedHeroId then
		return
	end
	local entry = CharacterRegistry.getById(resolvedHeroId)
	if not entry then
		return
	end

	character:SetAttribute(
		GameConstants.HERO_ATTRIBUTE,
		if resolvedHeroId == "scarlet_witch_classic" then "scarlet_witch" else resolvedHeroId
	)
	character:SetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE, pendingSkin[player] or "base")
	character:SetAttribute(GameConstants.ENERGY_ATTRIBUTE, entry.maxEnergy)
	character:SetAttribute(GameConstants.MAX_ENERGY_ATTRIBUTE, entry.maxEnergy)
	character:SetAttribute(GameConstants.STAMINA_ATTRIBUTE, GameConstants.MAX_STAMINA)
	character:SetAttribute(GameConstants.MAX_STAMINA_ATTRIBUTE, GameConstants.MAX_STAMINA)
	if resolvedHeroId == "jean_grey" then
		character:SetAttribute(GameConstants.MG_RESTRAINT_ATTRIBUTE, 0)
		character:SetAttribute(GameConstants.MG_RESTRAINT_MAX_ATTRIBUTE, GameConstants.MG_RESTRAINT_MAX)
		character:SetAttribute(GameConstants.MG_OVERLOAD_ATTRIBUTE, nil)
		character:SetAttribute(GameConstants.MG_WAKING_ATTRIBUTE, nil)
		character:SetAttribute(GameConstants.MG_ASTRAL_END_AT_ATTRIBUTE, nil)
		character:SetAttribute(GameConstants.MG_HAIR_TIED_ATTRIBUTE, false)
	end
	if resolvedHeroId == "invisible_woman" then
		character:SetAttribute(GameConstants.IW_HYPERSPACE_ATTRIBUTE, 0)
		character:SetAttribute(GameConstants.IW_HYPERSPACE_MAX_ATTRIBUTE, GameConstants.IW_HYPERSPACE_MAX)
		character:SetAttribute(GameConstants.IW_HYPERSPACE_LOCK_ATTRIBUTE, nil)
	end
	if resolvedHeroId == "scarlet_witch" or resolvedHeroId == "scarlet_witch_classic" then
		character:SetAttribute(GameConstants.SW_CONTROL_ATTRIBUTE, 0)
		character:SetAttribute(GameConstants.SW_CONTROL_MAX_ATTRIBUTE, GameConstants.SW_CONTROL_MAX)
		character:SetAttribute(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE, nil)
		character:SetAttribute(GameConstants.SW_CONTROL_LOCK_UNTIL_ATTRIBUTE, nil)
	end
	character:SetAttribute(GameConstants.SPRINTING_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.HEX_BLAST_MODE_ATTRIBUTE, "Single")
	character:SetAttribute(GameConstants.TK_MODE_ATTRIBUTE, "Single")
	character:SetAttribute(GameConstants.ULTIMATE_MODE_ATTRIBUTE, "Disintegration")
	character:SetAttribute(GameConstants.PHOTON_FLIGHT_MODE_ATTRIBUTE, "Normal")
	character:SetAttribute(GameConstants.ABSORB_CHARGE_ATTRIBUTE, 0)
	character:SetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.BINARY_UNTIL_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.IS_FLYING_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.FLIGHT_ALPHA_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.FLIGHT_BANK_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.FLIGHT_SIDE_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.LOKI_REFLECT_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.LOKI_CLONE_ACTIVE_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.LOKI_CLONE_MODE_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.LOKI_DASH_MODE_ATTRIBUTE, "Dash")
	character:SetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.LOKI_SHAPESHIFT_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.LOKI_INVISIBLE_ATTRIBUTE, nil)
	character:SetAttribute(GameConstants.PROTECTED_UNTIL_ATTRIBUTE, AbilityCooldownHelper.getNow() + GameConstants.PROTECTED_DURATION)
	character:SetAttribute(
		GameConstants.POWERS_DISABLED_UNTIL,
		AbilityCooldownHelper.getNow() + GameConstants.PROTECTED_DURATION
	)
	local skinId = character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE)
	if type(skinId) ~= "string" then
		skinId = "base"
	end
	character:SetAttribute(
		GameConstants.SHOP_DAMAGE_BUFF_ATTRIBUTE,
		PlayerDataService.getDamageBuff(player, resolvedHeroId, skinId)
	)

	local spawnFx = VfxHelper.attachNamedAssetToHrp(character, "SpawnAura")
	if #spawnFx > 0 then
		task.delay(GameConstants.PROTECTED_DURATION, function()
			VfxHelper.fadeOutAndDestroyParticles(spawnFx, 0.35, 1.2)
		end)
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local hp = entry.health
		if resolvedHeroId == "invisible_woman" and character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern" then
			hp = GameConstants.IW_HEALTH_MODERN
		end
		humanoid.MaxHealth = hp
		humanoid.Health = hp
		humanoid.WalkSpeed = GameConstants.DEFAULT_WALK_SPEED
		if character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "phoenix" then
			humanoid.BreakJointsOnDeath = false
		end
	end

	if resolvedHeroId == "scarlet_witch" or resolvedHeroId == "scarlet_witch_classic" then
		task.defer(function()
			if character.Parent then
				HandParticleHelper.ensure(character)
			end
		end)
	elseif resolvedHeroId == "captain_marvel" then
		task.defer(function()
			if character.Parent then
				local PhotonParticleHelper = require(script.Parent.PhotonParticleHelper)
				PhotonParticleHelper.ensure(character)
			end
		end)
	end

	task.defer(function()
		local NameplateService = require(script.Parent.NameplateService)
		NameplateService.refresh(character)
	end)
	CombatHelper.bindSilenceDeathSounds(character)
end

function CharacterService.markAbilityUse(character: Model)
	character:SetAttribute(GameConstants.LAST_ABILITY_USE_ATTRIBUTE, AbilityCooldownHelper.getNow())
end

function CharacterService.spendEnergy(character: Model, amount: number): boolean
	local cost = amount
	if
		character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "captain_marvel"
		and character:GetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE) == true
	then
		cost *= GameConstants.BINARY_ENERGY_MULT
	end
	local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
	if type(energy) ~= "number" or energy < cost then
		return false
	end
	character:SetAttribute(GameConstants.ENERGY_ATTRIBUTE, energy - cost)
	CharacterService.markAbilityUse(character)
	return true
end

function CharacterService.regenEnergy(character: Model, dt: number)
	if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
		return
	end
	if character:GetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE) == true then
		return
	end
	if AbilityCooldownHelper.isActive(character, "hex_beam") then
		return
	end
	if AbilityCooldownHelper.isActive(character, "photon_beam") then
		return
	end
	if AbilityCooldownHelper.isActive(character, "telekinesis") then
		return
	end
	if AbilityCooldownHelper.isActive(character, "regeneration") then
		return
	end
	local lastUse = character:GetAttribute(GameConstants.LAST_ABILITY_USE_ATTRIBUTE)
	if type(lastUse) == "number" then
		local now = AbilityCooldownHelper.getNow()
		if now - lastUse < GameConstants.ENERGY_REGEN_DELAY then
			return
		end
	end
	local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
	local maxEnergy = character:GetAttribute(GameConstants.MAX_ENERGY_ATTRIBUTE)
	if type(energy) ~= "number" or type(maxEnergy) ~= "number" then
		return
	end
	if energy < maxEnergy then
		character:SetAttribute(
			GameConstants.ENERGY_ATTRIBUTE,
			math.min(maxEnergy, energy + GameConstants.ENERGY_REGEN_PER_SEC * dt)
		)
	end
end

function CharacterService.setHero(player: Player, heroId: string, lookMode: any): boolean
	local entry = CharacterRegistry.getById(heroId)
	if not entry then
		return false
	end
	if heroId == "jean_grey" and lookMode == "phoenix" then
		return false
	end
	local skinId = if type(lookMode) == "string" and lookMode ~= "" then lookMode else "base"
	if skinId == "starter" or skinId == "clothes" or skinId == "avatar" then
		skinId = "base"
	end
	PlayerDataService.waitForProfile(player, 10)
	if not PlayerDataService.canDeploy(player, heroId, skinId) then
		return false
	end
	local skin = CharacterRegistry.getSkin(entry, skinId)
	if skin.blocked then
		return false
	end
	if not PlayerDataService.ownsSkin(player, heroId, skin.id) then
		return false
	end
	selectedHero[player] = heroId
	pendingDeploy[player] = heroId
	pendingSkin[player] = skin.id
	lookModeByPlayer[player] = "morph"
	return true
end

function CharacterService.init()
	Players.RespawnTime = 6
	MorphAnimationHelper.patchAssets()
	local selectHero = Remotes.getEvent("SelectHero")
	selectHero.OnServerEvent:Connect(function(player: Player, heroId: any, lookMode: any)
		if type(heroId) ~= "string" then
			return
		end
		if not CharacterService.setHero(player, heroId, lookMode) then
			return
		end
		player:LoadCharacter()
	end)

	local function onCharacterAdded(player: Player, character: Model)
		CombatHelper.bindSilenceDeathSounds(character)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			ensureAnimator(humanoid)
			humanoid.Died:Connect(function()
				CombatHelper.silenceDeathSounds(character)
				-- Only clear after a deployed hero dies — not blank LoadCharacter / morph swaps
				if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= nil then
					local okMg, MarvelGirlService = pcall(function()
						return require(script.Parent.MarvelGirlService)
					end)
					if okMg and MarvelGirlService.tryPhoenixDown(player, character) then
						return
					end
					clearHeroSelection(player)
				end
			end)
		end

		local deployId = pendingDeploy[player] or selectedHero[player]
		if not deployId then
			freezeForMenu(character)
			return
		end

		local skinId = pendingSkin[player] or "base"

		if morphReady[player] then
			morphReady[player] = false
			pendingDeploy[player] = nil
			task.defer(function()
				if character.Parent then
					local hum = character:FindFirstChildOfClass("Humanoid")
					if hum then
						ensureAnimator(hum)
					end
					CharacterService.applyHeroToCharacter(player, character, deployId)
				end
			end)
			return
		end

		task.spawn(function()
			if not character.Parent then
				return
			end
			task.wait()
			if not character.Parent or player.Character ~= character then
				return
			end

			local morph = replaceWithHeroMorph(player, character, deployId, skinId)
			if not morph then
				pendingDeploy[player] = nil
				freezeForMenu(character)
			end
		end)
	end

	local function hookPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		if player.Character then
			onCharacterAdded(player, player.Character)
		end
	end

	Players.PlayerAdded:Connect(hookPlayer)
	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end

	Players.PlayerRemoving:Connect(clearHeroSelection)
end

return CharacterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--!strict
--[[ Tracks combat from any health loss (players + NPCs) and clears the InCombat flag. ]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)

local CombatService = {}

local hooked: { [Humanoid]: RBXScriptConnection } = {}
local lastHealth: { [Humanoid]: number } = {}

local function hookHumanoid(model: Model, humanoid: Humanoid)
	if hooked[humanoid] then
		return
	end
	if model.Name == "FearClone" or model:GetAttribute("FearVisual") == true then
		return
	end

	lastHealth[humanoid] = humanoid.Health
	hooked[humanoid] = humanoid.HealthChanged:Connect(function(hp)
		local prev = lastHealth[humanoid]
		if prev == nil then
			lastHealth[humanoid] = hp
			return
		end
		-- Any real damage taken puts the victim in combat
		if hp < prev - 0.05 then
			CombatHelper.markInCombat(model)
		end
		lastHealth[humanoid] = hp
	end)

	humanoid.Destroying:Connect(function()
		local conn = hooked[humanoid]
		if conn then
			conn:Disconnect()
		end
		hooked[humanoid] = nil
		lastHealth[humanoid] = nil
	end)
end

local function tryHook(model: Model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		hookHumanoid(model, humanoid)
	end
end

function CombatService.update()
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character then
			CombatHelper.refreshCombatFlag(character)
		end
	end
end

function CombatService.init()
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(tryHook)
		if player.Character then
			tryHook(player.Character)
		end
	end
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(tryHook)
	end)

	for _, desc in Workspace:GetDescendants() do
		if desc:IsA("Model") and desc:FindFirstChildOfClass("Humanoid") then
			tryHook(desc)
		end
	end

	Workspace.DescendantAdded:Connect(function(desc)
		if desc:IsA("Humanoid") then
			local model = desc.Parent
			if model and model:IsA("Model") then
				task.defer(function()
					tryHook(model)
				end)
			end
		end
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">DaggerService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Dagger:
	Q Light Daggers — heal allies / damage others
	E Radiant Bomb — AoE
	F Light Veil — white Highlight on target (particles TBD)
	T Sanctuary — light circle heal/damage zone (particles TBD)
	C Blinding Flash — screen whiteout for foes (particles TBD)
	X Lumen Barrage — 5 light daggers toward cursor
	V Purify — cleanse + 1.5x speed/jump buff 10s (particles TBD)
]]

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local FrostStatus = require(ReplicatedStorage.Shared.FrostStatus)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local ProjectileHelper = require(ReplicatedStorage.Shared.ProjectileHelper)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)
local CharacterService = require(script.Parent.CharacterService)
local RagdollService = require(script.Parent.RagdollService)

local DaggerService = {}

type AllyEntry = {
	key: string,
	name: string,
	model: Model,
}

type SanctuaryState = {
	owner: Model,
	player: Player,
	center: Vector3,
	part: BasePart,
	endsAt: number,
}

local alliesByPlayer: { [Player]: { [string]: AllyEntry } } = {}
local sanctuaryByPlayer: { [Player]: SanctuaryState } = {}
local veilTokenByModel: { [Model]: number } = {}

local function daggerColor(): Color3
	return GameConstants.DAGGER_LIGHT
end

local function fireCameraShake(targetPlayer: Player, intensity: number?, duration: number?)
	Remotes.getEvent("CameraShake"):FireClient(targetPlayer, {
		intensity = intensity or 0.55,
		duration = duration or 0.35,
	})
end

local function shakePlayersNear(pos: Vector3, radius: number, intensity: number?, duration: number?)
	for _, model in CombatHelper.overlapCharacters(pos, radius, nil) do
		local plr = Players:GetPlayerFromCharacter(model)
		if plr then
			fireCameraShake(plr, intensity, duration)
		end
	end
end

local function getRoot(model: Model): BasePart?
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return model.PrimaryPart
end

local function getFootPosition(character: Model): Vector3
	local root = getRoot(character)
	if not root then
		return character:GetPivot().Position
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local cast = Workspace:Raycast(root.Position + Vector3.new(0, 1, 0), Vector3.new(0, -12, 0), params)
	if cast then
		return cast.Position + Vector3.new(0, 0.05, 0)
	end
	local hum = CombatHelper.getHumanoid(character)
	local drop = if hum then (hum.HipHeight + root.Size.Y * 0.5) else 3
	return root.Position - Vector3.new(0, drop, 0)
end

local function getHand(character: Model, preferRight: boolean): BasePart?
	local names = if preferRight
		then { "RightHand", "Right Arm", "RightLowerArm" }
		else { "LeftHand", "Left Arm", "LeftLowerArm" }
	for _, name in names do
		local p = character:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return getRoot(character)
end

local function displayNameFor(model: Model): string
	local plr = Players:GetPlayerFromCharacter(model)
	if plr then
		return plr.DisplayName
	end
	return model.Name
end

local function allyKeyFor(model: Model): string
	local plr = Players:GetPlayerFromCharacter(model)
	if plr then
		return "p:" .. tostring(plr.UserId)
	end
	local existing = model:GetAttribute(GameConstants.DAGGER_ALLY_TAG_ATTRIBUTE)
	if type(existing) == "string" and existing ~= "" then
		return "n:" .. existing
	end
	local tag = HttpService:GenerateGUID(false)
	model:SetAttribute(GameConstants.DAGGER_ALLY_TAG_ATTRIBUTE, tag)
	return "n:" .. tag
end

local function fireAlliesSync(player: Player)
	local map = alliesByPlayer[player]
	local list: { { key: string, name: string } } = {}
	if map then
		for key, entry in map do
			if entry.model.Parent and CombatHelper.getHumanoid(entry.model) then
				table.insert(list, { key = key, name = displayNameFor(entry.model) })
			else
				map[key] = nil
			end
		end
	end
	table.sort(list, function(a, b)
		return a.name < b.name
	end)
	Remotes.getEvent("DaggerAllies"):FireClient(player, list)
end

local function isAllyModel(owner: Model, victim: Model): boolean
	local player = Players:GetPlayerFromCharacter(owner)
	if not player then
		return false
	end
	if victim == owner then
		return true
	end
	local map = alliesByPlayer[player]
	if not map then
		return false
	end
	for _, entry in map do
		if entry.model == victim then
			return true
		end
	end
	return false
end

local function canUse(character: Model, abilityId: string, energyCost: number): boolean
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "dagger" then
		return false
	end
	if CombatHelper.arePowersDisabled(character) then
		return false
	end
	if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return false
	end
	if AbilityCooldownHelper.isOnCooldown(character, abilityId) then
		return false
	end
	if AbilityCooldownHelper.isActive(character, abilityId) then
		return false
	end
	if energyCost > 0 and not CharacterService.spendEnergy(character, energyCost) then
		return false
	end
	return true
end

local function finishAbility(character: Model, abilityId: string, cooldown: number)
	AbilityCooldownHelper.setActive(character, abilityId, false)
	AbilityCooldownHelper.applyAfterUse(character, abilityId, cooldown)
	CharacterService.markAbilityUse(character)
end

local function spawnLightDagger(
	character: Model,
	origin: Vector3,
	homeDir: Vector3,
	aimPoint: Vector3?,
	liveAimAttribute: string?
)
	ProjectileHelper.spawn(origin, homeDir, {
		speed = GameConstants.DAGGER_DAGGER_SPEED,
		damage = GameConstants.DAGGER_DAGGER_DAMAGE,
		healAmount = GameConstants.DAGGER_DAGGER_HEAL,
		radius = GameConstants.DAGGER_DAGGER_HIT_RADIUS,
		maxDistance = GameConstants.DAGGER_DAGGER_RANGE,
		owner = character,
		color = daggerColor(),
		homeDir = homeDir,
		homePoint = aimPoint or (origin + homeDir * 50),
		homeAfter = 0,
		seekUntilClose = false,
		liveHomeAimAttribute = liveAimAttribute,
		boltFolder = "Dagger",
		boltAsset = "LightDagger",
		impactFx = "none",
		shouldHeal = isAllyModel,
		ricochetMax = GameConstants.DAGGER_DAGGER_RICOCHET_MAX,
		ricochetSearchRadius = GameConstants.DAGGER_DAGGER_RICOCHET_RANGE,
	})
end

local function resolveAimDir(character: Model, direction: Vector3, aimPoint: Vector3?): Vector3
	local dir = if direction.Magnitude > 0.01 then direction.Unit else character:GetPivot().LookVector
	local root = getRoot(character)
	if aimPoint and root then
		local toAim = aimPoint - root.Position
		if toAim.Magnitude > 0.05 then
			return toAim.Unit
		end
	end
	return dir
end

local function fireLightDagger(player: Player, direction: Vector3, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("dagger", "light_daggers")
	if not entry or not canUse(character, entry.id, GameConstants.DAGGER_DAGGER_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	local homeDir = resolveAimDir(character, direction, aimPoint)
	local hand = getHand(character, true)
	local origin = if hand then hand.Position else character:GetPivot().Position
	spawnLightDagger(character, origin, homeDir, aimPoint)
	-- PARTICLE_PLACEHOLDER: LightDagger cast flash (hand)
	VfxHelper.castHandFlash(origin, daggerColor())
	finishAbility(character, entry.id, GameConstants.DAGGER_DAGGER_COOLDOWN)
end

local function fireRadiantBomb(player: Player, direction: Vector3, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("dagger", "radiant_bomb")
	if not entry or not canUse(character, entry.id, GameConstants.DAGGER_BOMB_ENERGY) then
