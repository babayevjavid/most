	HIGH_FALL_LANDING_ANIM = "rbxassetid://127462640878942",
	HIGH_FALL_LANDING_LOCK_FALLBACK = 1.6,
	HIGH_FALL_LANDING_HIP_HEIGHT = 0.08,
	HIGH_FALL_LANDING_DAMAGE = 16,
