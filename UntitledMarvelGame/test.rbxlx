        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">BeamClient</string>
            <string name="Source"><![CDATA[--!strict

--[[

	Chaos Beam client — Blue Marvel antimatter beam aim pattern (mouse raycast → server look update).

]]



local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RunService = game:GetService("RunService")

local UserInputService = game:GetService("UserInputService")

local Workspace = game:GetService("Workspace")



local AbilityConstants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AbilityConstants"))

local Keybinds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Keybinds"))

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))



local AbilityController = require(script.Parent.Controllers.AbilityController)



local BeamClient = {}



local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")

local chaosBeamSetActive = remotesFolder:WaitForChild(Remotes.ChaosBeamSetActive) :: RemoteEvent

local chaosBeamLookUpdate = remotesFolder:WaitForChild(Remotes.ChaosBeamLookUpdate) :: RemoteEvent



local BEAM_KEY = Keybinds.AbilitySlots[4]

local holding = false

local lookConn: RBXScriptConnection? = nil

local lastSendTime = 0



local function getCharacter(): Model?

	return game:GetService("Players").LocalPlayer.Character

end



local function isChaosBeam(): boolean

	return AbilityController.getAbilityIdForSlot(4) == "ChaosBeam"

end



local function getBeamTargetPos(char: Model): Vector3?

	local cam = Workspace.CurrentCamera

	if not cam then

		return nil

	end



	local mouse = UserInputService:GetMouseLocation()

	local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)

	local params = RaycastParams.new()

	params.FilterType = Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = { char }

	params.IgnoreWater = true



	local result = Workspace:Raycast(ray.Origin, ray.Direction * 500, params)

	if result then

		return result.Position

	end

	return ray.Origin + ray.Direction * 500

end



local function disconnectLook()

	if lookConn then

		lookConn:Disconnect()

		lookConn = nil

	end

	lastSendTime = 0

end



local function startLookLoop(char: Model)

	disconnectLook()



	local function fireLookUpdate()

		local curChar = getCharacter()

		if not curChar or curChar ~= char or curChar:GetAttribute("IsChaosBeamActive") ~= true then

			return

		end

		local targetPos = getBeamTargetPos(curChar)

		if not targetPos then

			return

		end

		chaosBeamLookUpdate:FireServer(targetPos.X, targetPos.Y, targetPos.Z)

	end



	fireLookUpdate()

	lookConn = RunService.Heartbeat:Connect(function()

		local curChar = getCharacter()

		if not curChar or curChar ~= char or curChar:GetAttribute("IsChaosBeamActive") ~= true then

			disconnectLook()

			return

		end

		if not holding and not UserInputService:IsKeyDown(BEAM_KEY) then

			return

		end



		local now = os.clock()

		if now - lastSendTime < AbilityConstants.CHAOS_BEAM_LOOK_SEND_INTERVAL then

			return

		end

		lastSendTime = now

		fireLookUpdate()

	end)

end



function BeamClient.setup()

	UserInputService.InputBegan:Connect(function(input, gameProcessed)

		if gameProcessed or not AbilityController.hasHero() or not isChaosBeam() then

			return

		end

		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == BEAM_KEY then

			if holding then

				return

			end

			holding = true

			local char = getCharacter()

			if char then

				startLookLoop(char)

			end

			chaosBeamSetActive:FireServer(true)

		end

	end)



	UserInputService.InputEnded:Connect(function(input, _gameProcessed)

		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == BEAM_KEY then

			if not holding then

				return

			end

			holding = false

			disconnectLook()

			chaosBeamSetActive:FireServer(false)

		end

	end)



	local player = game:GetService("Players").LocalPlayer

	player.CharacterAdded:Connect(function(char)

		char:GetAttributeChangedSignal("IsChaosBeamActive"):Connect(function()

			if char:GetAttribute("IsChaosBeamActive") == true and holding then

				startLookLoop(char)

			elseif char:GetAttribute("IsChaosBeamActive") ~= true then

				disconnectLook()

			end

		end)

	end)

end



return BeamClient

]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="39">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">AbilityController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local ProjectileSteerClient = require(script.Parent.Parent.ProjectileSteerClient)

local AbilityController = {}

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local useAbilityRemote = remotesFolder:WaitForChild(Remotes.UseAbility) :: RemoteEvent
local cooldownRemote = remotesFolder:WaitForChild(Remotes.CooldownUpdate) :: RemoteEvent

local STEERED_BASICS: { [string]: boolean } = {
	ChaosBlast = true,
}

local currentHeroId: string? = nil
local abilityLayout: any = nil
local onCooldownUpdate: ((abilityId: string, duration: number) -> ())? = nil

function AbilityController.setup(hudCooldownCallback: (abilityId: string, duration: number) -> ())
	onCooldownUpdate = hudCooldownCallback

	cooldownRemote.OnClientEvent:Connect(function(abilityId: string, duration: number)
		if onCooldownUpdate then
			onCooldownUpdate(abilityId, duration)
		end
	end)
end

function AbilityController.setHero(heroId: string, layout: any)
	currentHeroId = heroId
	abilityLayout = layout
end

function AbilityController.clearHero()
	currentHeroId = nil
	abilityLayout = nil
end

function AbilityController.hasHero(): boolean
	return currentHeroId ~= nil
end

function AbilityController.getBasicId(): string?
	if not abilityLayout then
		return nil
	end
	return abilityLayout.basic.Id
end

function AbilityController.getAbilityIdForSlot(slotIndex: number): string?
	if not abilityLayout then
		return nil
	end
	local def = abilityLayout.abilities[slotIndex]
	return if def then def.Id else nil
end

function AbilityController.getMovementId(): string?
	if not abilityLayout then
		return nil
	end
	return abilityLayout.movement.Id
end

local function getCameraAimDirection(): Vector3
	local camera = workspace.CurrentCamera
	if not camera then
		return Vector3.new(0, 0, -1)
	end
	return camera.CFrame.LookVector
end

function AbilityController.fire(abilityId: string)
	if not currentHeroId then
		return
	end

	if STEERED_BASICS[abilityId] then
		local player = Players.LocalPlayer
		local char = player.Character
		if not char then
			return
		end
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end

		local aim = ProjectileSteerClient.getAimWorldPos(char, 300)
		local dir = if aim then (aim - root.Position) else getCameraAimDirection()
		if dir.Magnitude < 0.01 then
			dir = getCameraAimDirection()
		end
		dir = dir.Unit

		local token = ProjectileSteerClient.generateSteerToken()
		useAbilityRemote:FireServer(abilityId, dir.X, dir.Y, dir.Z, token)
		ProjectileSteerClient.beginMouseSteerSession(token)
		return
	end

	local aim = getCameraAimDirection()
	useAbilityRemote:FireServer(abilityId, aim.X, aim.Y, aim.Z)
end

return AbilityController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict



local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UserInputService = game:GetService("UserInputService")



local Keybinds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Keybinds"))

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))



local AbilityController = require(script.Parent.AbilityController)

local TelekinesisClient = require(script.Parent.Parent.TelekinesisClient)



local InputController = {}



local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")

local sprintRemote = remotesFolder:WaitForChild(Remotes.SetSprinting) :: RemoteEvent



local HOLD_ABILITIES = {

	Telekinesis = true,

	ChaosShield = true,

	ChaosBeam = true,

}



local function keyCodeToSlot(keyCode: Enum.KeyCode): number?

	for slot, code in Keybinds.AbilitySlots do

		if code == keyCode then

			return slot

		end

	end

	return nil

end



local function setSprint(active: boolean)

	if not AbilityController.hasHero() then

		sprintRemote:FireServer(false)

		return

	end

	sprintRemote:FireServer(active)

end



function InputController.setup()

	UserInputService.InputBegan:Connect(function(input, gameProcessed)

		if gameProcessed then

			return

		end

		if not AbilityController.hasHero() then

			return

		end



		if input.UserInputType == Enum.UserInputType.MouseButton1 then

			if TelekinesisClient.isTelekinesisActive() then

				return

			end

			local basicId = AbilityController.getBasicId()

			if basicId then

				AbilityController.fire(basicId)

			end

			return

		end



		if input.UserInputType ~= Enum.UserInputType.Keyboard then

			return

		end



		if input.KeyCode == Keybinds.Sprint then

			setSprint(true)

			return

		end



		local slot = keyCodeToSlot(input.KeyCode)

		if slot then

			local abilityId = AbilityController.getAbilityIdForSlot(slot)

			if abilityId and not HOLD_ABILITIES[abilityId] then

				AbilityController.fire(abilityId)

			end

			return

		end



		if input.KeyCode == Keybinds.Movement then
			local moveId = AbilityController.getMovementId()
			if moveId and moveId ~= "ChaosLevitate" then
				AbilityController.fire(moveId)
			end
			return
		end

	end)



	UserInputService.InputEnded:Connect(function(input, _gameProcessed)

		if input.UserInputType ~= Enum.UserInputType.Keyboard then

			return

		end

		if input.KeyCode == Keybinds.Sprint then

			setSprint(false)

		end

	end)

end



return InputController

]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local AbilityController = require(script.Parent.AbilityController)
local CharacterSelectUI = require(script.Parent.Parent.UI.CharacterSelectUI)
local MainHUD = require(script.Parent.Parent.UI.MainHUD)

local UIController = {}

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local selectHeroRemote = remotesFolder:WaitForChild(Remotes.SelectHero) :: RemoteEvent
local heroConfirmedRemote = remotesFolder:WaitForChild(Remotes.HeroConfirmed) :: RemoteEvent
local requireReselectRemote = remotesFolder:WaitForChild(Remotes.RequireReselect) :: RemoteEvent
local statUpdateRemote = remotesFolder:WaitForChild(Remotes.StatUpdate) :: RemoteEvent
local sprintRemote = remotesFolder:WaitForChild(Remotes.SetSprinting) :: RemoteEvent

local selectUI: CharacterSelectUI.CharacterSelectController
local mainHUD: MainHUD.MainHUDController

function UIController.init()
	local player = Players.LocalPlayer

	selectUI = CharacterSelectUI.create(function(heroId: string)
		selectHeroRemote:FireServer(heroId)
	end)

	mainHUD = MainHUD.create()

	AbilityController.setup(function(abilityId, duration)
		mainHUD:UpdateCooldown(abilityId, duration)
	end)

	heroConfirmedRemote.OnClientEvent:Connect(function(heroId: string, layout: any)
		AbilityController.setHero(heroId, layout)
		selectUI:Hide()
		mainHUD:Show(heroId, layout)
	end)

	requireReselectRemote.OnClientEvent:Connect(function()
		AbilityController.clearHero()
		sprintRemote:FireServer(false)
		mainHUD:Hide()
		selectUI:Show()
	end)

	statUpdateRemote.OnClientEvent:Connect(function(payload: { [string]: any })
		if mainHUD.Gui.Enabled then
			mainHUD:UpdateStats(payload)
		end
	end)

	player.CharacterAdded:Connect(function(_character)
		task.defer(function()
			if mainHUD.Gui.Enabled then
				mainHUD:RefreshAvatar(player)
			end
		end)
	end)

	RunService.RenderStepped:Connect(function()
		if mainHUD.Gui.Enabled then
			mainHUD:TickCooldowns()
		end
	end)

	selectUI:Show()
end

return UIController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">FlightClient</string>
            <string name="Source"><![CDATA[--!strict

--[[

	Chaos Flight input — ported from NewMarvel NewFlightInputClient.

]]



local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RunService = game:GetService("RunService")

local UserInputService = game:GetService("UserInputService")



local Keybinds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Keybinds"))

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))



local AbilityController = require(script.Parent.Controllers.AbilityController)



local FlightClient = {}



local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")

local flightToggle = remotesFolder:WaitForChild(Remotes.FlightToggle) :: RemoteEvent

local flightInput = remotesFolder:WaitForChild(Remotes.FlightInput) :: RemoteEvent



local function isChaosLevitate(): boolean

	return AbilityController.getMovementId() == "ChaosLevitate"

end



function FlightClient.setup()

	UserInputService.InputBegan:Connect(function(input, gameProcessed)

		if gameProcessed or not AbilityController.hasHero() or not isChaosLevitate() then

			return

		end

		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Keybinds.Movement then

			flightToggle:FireServer()

		end

	end)



	RunService.Heartbeat:Connect(function()

		local player = game:GetService("Players").LocalPlayer

		local char = player.Character

		if not char or char:GetAttribute("NewFlightActive") ~= true then

			return

		end



		local cam = workspace.CurrentCamera

		if not cam then

			return

		end



		local look = cam.CFrame.LookVector

		if look.Magnitude < 0.01 then

			look = Vector3.new(0, 0, -1)

		else

			look = look.Unit

		end



		local right = cam.CFrame.RightVector

		if right.Magnitude < 0.01 then

			right = Vector3.new(1, 0, 0)

		else

			right = right.Unit

		end



		local w = UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0

		local s = UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0

		local a = UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0

		local d = UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0

		local moveDir = look * (w - s) + right * (d - a)

		if moveDir.Magnitude > 1 then

			moveDir = moveDir.Unit

		end



		flightInput:FireServer(moveDir.X, moveDir.Y, moveDir.Z, look.X, look.Y, look.Z)

	end)

end



return FlightClient

]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">ProjectileSteerClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	While LMB is held after a steered projectile fires, send mouse aim to the server.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local STEER_INTERVAL = 0.05
local AIM_RANGE = 300

local player = Players.LocalPlayer
local steerRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(Remotes.ProjectileSteerUpdate) :: RemoteEvent

type SteerSession = {
	steerToken: string,
	heartbeatConn: RBXScriptConnection?,
	mouseUpConn: RBXScriptConnection?,
}

local sessionsByToken: { [string]: SteerSession } = {}
local mouseHeld = false

local ProjectileSteerClient = {}

function ProjectileSteerClient.getAimWorldPos(char: Model, maxRange: number?): Vector3?
	local cam = Workspace.CurrentCamera
	if not cam then
		return nil
	end
	local range = maxRange or AIM_RANGE
	local mousePos = UserInputService:GetMouseLocation()
	local ray = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	params.IgnoreWater = true
	local result = Workspace:Raycast(ray.Origin, ray.Direction.Unit * range, params)
	if result then
		return result.Position
	end
	return ray.Origin + ray.Direction.Unit * range
end

function ProjectileSteerClient.generateSteerToken(): string
	return HttpService:GenerateGUID(false)
end

local lastSteerSendAt = 0
local lastSteerPos: Vector3? = nil

local function sendSteerUpdate(steerToken: string, targetPos: Vector3)
	local now = os.clock()
	if lastSteerPos and (now - lastSteerSendAt) < STEER_INTERVAL then
		if (targetPos - lastSteerPos).Magnitude < 0.5 then
			return
		end
	end
	lastSteerSendAt = now
	lastSteerPos = targetPos
	steerRemote:FireServer(steerToken, targetPos)
end

local function endSession(steerToken: string)
	local session = sessionsByToken[steerToken]
	if not session then
		return
	end
	sessionsByToken[steerToken] = nil
	if session.heartbeatConn then
		session.heartbeatConn:Disconnect()
	end
	if session.mouseUpConn then
		session.mouseUpConn:Disconnect()
	end
end

function ProjectileSteerClient.beginMouseSteerSession(steerToken: string)
	if steerToken == "" then
		return
	end
	endSession(steerToken)
	mouseHeld = true

	local session: SteerSession = {
		steerToken = steerToken,
		heartbeatConn = nil,
		mouseUpConn = nil,
	}
	sessionsByToken[steerToken] = session

	session.mouseUpConn = UserInputService.InputEnded:Connect(function(input, _gameProcessed)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		mouseHeld = false
		endSession(steerToken)
	end)

	session.heartbeatConn = RunService.Heartbeat:Connect(function()
		if not sessionsByToken[steerToken] or not mouseHeld then
			endSession(steerToken)
			return
		end
		local char = player.Character
		if not char or not char.Parent then
			endSession(steerToken)
			return
		end
		local aim = ProjectileSteerClient.getAimWorldPos(char, AIM_RANGE)
		if aim then
			sendSteerUpdate(steerToken, aim)
		end
	end)
end

UserInputService.InputEnded:Connect(function(input, _gameProcessed)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		mouseHeld = false
	end
end)

return ProjectileSteerClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">ShieldClient</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Keybinds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Keybinds"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local AbilityController = require(script.Parent.Controllers.AbilityController)

local ShieldClient = {}

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local shieldSetActive = remotesFolder:WaitForChild(Remotes.ShieldSetActive) :: RemoteEvent

local SHIELD_KEY = Keybinds.AbilitySlots[1]
local holding = false

local function isChaosShield(): boolean
	return AbilityController.getAbilityIdForSlot(1) == "ChaosShield"
end

function ShieldClient.setup()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not AbilityController.hasHero() or not isChaosShield() then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == SHIELD_KEY then
			if not holding then
				holding = true
				shieldSetActive:FireServer(true)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input, _gameProcessed)
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == SHIELD_KEY then
			if holding then
				holding = false
				shieldSetActive:FireServer(false)
			end
		end
	end)
end

return ShieldClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">TargetingHelper</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local PropHelper = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PropHelper"))

local TargetingHelper = {}

local CURSOR_HITBOX_PIXELS = 80

local function getScreenPosition(customPos: Vector2?): Vector2
	if customPos then
		return customPos
	end
	local mouse = UserInputService:GetMouseLocation()
	return Vector2.new(mouse.X, mouse.Y)
end

local function findBestTargetFromScreen(
	character: Model,
	screenPos: Vector2,
	maxRange: number,
	includeObjects: boolean,
	filterFunc: ((Model) -> boolean)?
): (BasePart?, Model?)
	local casterRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not casterRoot then
		return nil, nil
	end

	local cam = workspace.CurrentCamera
	if not cam then
		return nil, nil
	end

	local overlapParams = OverlapParams.new()
	overlapParams.FilterDescendantsInstances = { character }
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude

	local partsInRange = workspace:GetPartBoundsInRadius(casterRoot.Position, maxRange, overlapParams)

	local bestPart: BasePart? = nil
	local bestModel: Model? = nil
	local bestScreenDist = math.huge
	local checkedModels: { [Model]: boolean } = {}

	for _, part in partsInRange do
		if not part:IsA("BasePart") then
			continue
		end

		local model = part:FindFirstAncestorOfClass("Model")
		if model and model ~= character then
			if not checkedModels[model] then
				checkedModels[model] = true
				local humanoid = model:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root then
						if filterFunc and not filterFunc(model) then
							continue
						end
						local worldPos, onScreen = cam:WorldToScreenPoint(root.Position)
						if onScreen then
							local screenPos2D = Vector2.new(worldPos.X, worldPos.Y)
							local screenDist = (screenPos2D - screenPos).Magnitude
							if screenDist < CURSOR_HITBOX_PIXELS and screenDist < bestScreenDist then
								bestScreenDist = screenDist
								bestPart = root
								bestModel = model
							end
						end
						continue
					end
				end
			else
				continue
			end
		end

		if includeObjects and PropHelper.isProp(part) then
			local worldPos, onScreen = cam:WorldToScreenPoint(part.Position)
			if onScreen then
				local screenPos2D = Vector2.new(worldPos.X, worldPos.Y)
				local screenDist = (screenPos2D - screenPos).Magnitude
				if screenDist < CURSOR_HITBOX_PIXELS and screenDist < bestScreenDist then
					bestScreenDist = screenDist
					bestPart = part
					bestModel = nil
				end
			end
		end
	end

	return bestPart, bestModel
end

function TargetingHelper.getTargetPartAtCursor(character: Model, maxRange: number, filterFunc: ((Model) -> boolean)?): BasePart?
	local screenPos = getScreenPosition(nil)
	local part, _ = findBestTargetFromScreen(character, screenPos, maxRange, true, filterFunc)
	return part
end

function TargetingHelper.getCursorWorldPos(maxRange: number): Vector3?
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end
	local mousePos = UserInputService:GetMouseLocation()
	local ray = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local character = cam.CameraSubject
	if character and character:IsA("Humanoid") then
		local charModel = character.Parent
		if charModel and charModel:IsA("Model") then
			params.FilterDescendantsInstances = { charModel }
		end
	end
	local result = workspace:Raycast(ray.Origin, ray.Direction * maxRange, params)
	if result then
		return result.Position
	end
	return ray.Origin + ray.Direction * maxRange
end

return TargetingHelper
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">TelekinesisClient</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local AbilityConstants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AbilityConstants"))
local Keybinds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Keybinds"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local AbilityController = require(script.Parent.Controllers.AbilityController)
local TargetingHelper = require(script.Parent.TargetingHelper)

local TelekinesisClient = {}

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local telekinesisRequest = remotesFolder:WaitForChild(Remotes.TelekinesisRequest) :: RemoteEvent
local telekinesisUpdate = remotesFolder:WaitForChild(Remotes.TelekinesisUpdate) :: RemoteEvent
local telekinesisThrow = remotesFolder:WaitForChild(Remotes.TelekinesisThrow) :: RemoteEvent
local telekinesisEnd = remotesFolder:WaitForChild(Remotes.TelekinesisEnd) :: RemoteEvent

local RAYCAST_MAX_DIST = AbilityConstants.TELEKINESIS_MAX_RANGE
local UPDATE_SEND_INTERVAL = 0.05
local TELEKINESIS_KEY = Keybinds.AbilitySlots[2]

local lastQState = false
local lastUpdateSend = 0
local throwKeyPressed = false
local targetHoldDistance = AbilityConstants.TELEKINESIS_HOLD_DISTANCE

local function getCharacter(): Model?
	local player = game:GetService("Players").LocalPlayer
	return player.Character
end

local function isTelekinesisAbility(): boolean
	return AbilityController.getAbilityIdForSlot(2) == "Telekinesis"
end

local function isActive(char: Model): boolean
	return char:GetAttribute("IsTelekinesisActive") == true
end

local function getAimDirection(): Vector3
	local cam = workspace.CurrentCamera
	if not cam then
		return Vector3.new(0, 0, -1)
	end
	local mousePos = UserInputService:GetMouseLocation()
	local ray = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
	local dir = ray.Direction
	if dir.Magnitude < 0.01 then
		return Vector3.new(0, 0, -1)
	end
	return dir.Unit
end

local function getCursorWorldPos(): Vector3?
	return TargetingHelper.getCursorWorldPos(RAYCAST_MAX_DIST)
end

function TelekinesisClient.setup()
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			local char = getCharacter()
			if not char or not isActive(char) then
				return
			end
			targetHoldDistance = math.clamp(
				targetHoldDistance - input.Position.Z * 2,
				AbilityConstants.TELEKINESIS_HOLD_DISTANCE_MIN,
				AbilityConstants.TELEKINESIS_HOLD_DISTANCE_MAX
			)
		end
	end)

	RunService.RenderStepped:Connect(function()
		if not AbilityController.hasHero() or not isTelekinesisAbility() then
			lastQState = false
			return
		end

		local char = getCharacter()
		if not char then
			return
		end

		local now = os.clock()
		local qHeld = UserInputService:IsKeyDown(TELEKINESIS_KEY)
		local active = isActive(char)

		local wantThrow = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		if active and wantThrow and not throwKeyPressed then
			throwKeyPressed = true
			local dir = getAimDirection()
			local cursorWorldPos = getCursorWorldPos()
			local cx, cy, cz = 0, 0, 0
			if cursorWorldPos then
				cx, cy, cz = cursorWorldPos.X, cursorWorldPos.Y, cursorWorldPos.Z
			end
			telekinesisUpdate:FireServer(dir.X, dir.Y, dir.Z, cx, cy, cz, targetHoldDistance)
			telekinesisThrow:FireServer()
		elseif not wantThrow then
			throwKeyPressed = false
		end

		if qHeld then
			if not lastQState then
				if active then
					lastUpdateSend = now
				else
					local nearestPart = TargetingHelper.getTargetPartAtCursor(char, RAYCAST_MAX_DIST)
					local cursorWorldPos = getCursorWorldPos()
					local cx, cy, cz = 0, 0, 0
					if cursorWorldPos then
						cx, cy, cz = cursorWorldPos.X, cursorWorldPos.Y, cursorWorldPos.Z
					end
					if nearestPart then
						telekinesisRequest:FireServer(nearestPart, cx, cy, cz)
					end
				end
			elseif active and now - lastUpdateSend >= UPDATE_SEND_INTERVAL then
				lastUpdateSend = now
				local dir = getAimDirection()
				local cursorWorldPos = getCursorWorldPos()
				local cx, cy, cz = 0, 0, 0
				if cursorWorldPos then
					cx, cy, cz = cursorWorldPos.X, cursorWorldPos.Y, cursorWorldPos.Z
				end
				telekinesisUpdate:FireServer(dir.X, dir.Y, dir.Z, cx, cy, cz, targetHoldDistance)
			end
		else
			if lastQState and active then
				telekinesisEnd:FireServer()
				targetHoldDistance = AbilityConstants.TELEKINESIS_HOLD_DISTANCE
			end
		end

		lastQState = qHeld
	end)
end

function TelekinesisClient.isTelekinesisActive(): boolean
	local char = getCharacter()
	return char ~= nil and isActive(char)
end

return TelekinesisClient
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="48">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">CharacterSelectUI</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HeroRegistry = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HeroRegistry"))
local Theme = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HUDTheme"))

export type CharacterSelectController = {
	Gui: ScreenGui,
	Show: (self: CharacterSelectController) -> (),
	Hide: (self: CharacterSelectController) -> (),
}

local CharacterSelectUI = {}

function CharacterSelectUI.create(onSelect: (heroId: string) -> ()): CharacterSelectController
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "CharacterSelect"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = playerGui

	local container = Instance.new("Frame")
	container.Name = "ButtonContainer"
	container.AnchorPoint = Vector2.new(1, 1)
	container.BackgroundTransparency = 1
	container.Position = UDim2.fromScale(0.985, 0.985)
	container.Size = UDim2.fromScale(0.09, 0.2)
	container.Parent = screenGui

	local containerSize = Instance.new("UISizeConstraint")
	containerSize.MinSize = Vector2.new(0, 0)
	containerSize.Parent = container

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.Padding = UDim.new(0.04, 0)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = container

	local buttons: { [string]: TextButton } = {}

	for index, heroId in HeroRegistry.getHeroIds() do
		local heroDef = HeroRegistry[heroId]
		local accent = Theme.HeroAccents[heroId] or Theme.Stroke

		local button = Instance.new("TextButton")
		button.Name = heroId
		button.AutoButtonColor = false
		button.BackgroundColor3 = Theme.PanelBg
		button.BackgroundTransparency = 0.08
		button.BorderSizePixel = 0
		button.Size = UDim2.fromScale(1, 0.22)
		button.Font = Theme.FontBody
		button.TextScaled = true
		button.TextColor3 = Theme.TextPrimary
		button.Text = heroDef.DisplayName
		button.LayoutOrder = index
		button.Parent = container

		local buttonSize = Instance.new("UISizeConstraint")
		buttonSize.MinSize = Vector2.new(0, 0)
		buttonSize.Parent = button

		local textConstraint = Instance.new("UITextSizeConstraint")
		textConstraint.MaxTextSize = 14
		textConstraint.MinTextSize = 10
		textConstraint.Parent = button

		local corner = Instance.new("UICorner")
		corner.CornerRadius = Theme.CornerSmall
		corner.Parent = button

		local stroke = Instance.new("UIStroke")
		stroke.Color = Theme.Stroke
		stroke.Thickness = 1
		stroke.Transparency = 0.35
		stroke.Parent = button

		button.MouseEnter:Connect(function()
			stroke.Color = accent
			stroke.Transparency = 0.1
		end)
		button.MouseLeave:Connect(function()
			stroke.Color = Theme.Stroke
			stroke.Transparency = 0.35
		end)
		button.MouseButton1Click:Connect(function()
			onSelect(heroId)
		end)

		buttons[heroId] = button
	end

	local controller: CharacterSelectController = {
		Gui = screenGui,
		Show = function(_self)
			screenGui.Enabled = true
			for _, button in buttons do
				button.Visible = true
			end
		end,
		Hide = function(_self)
			screenGui.Enabled = false
		end,
	}

	return controller
end

return CharacterSelectUI
]]></string>
            </Properties>
          </Item>
