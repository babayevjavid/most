  <Item class="ReplicatedStorage" referent="1">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="2">
      <Properties>
        <string name="Name">RagdollRemotes</string>
      </Properties>
      <Item class="RemoteEvent" referent="3">
        <Properties>
          <string name="Name">RagdollToggle</string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">RagdollConfig</string>
          <string name="Source"><![CDATA[return {
	CooldownSeconds = 1,
	RemoteName = "RagdollToggle",
}
]]></string>
