      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="10">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="11">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="12">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local localPlayer = Players.LocalPlayer

local shared = ReplicatedStorage:WaitForChild("Shared", 30)
if not shared then
	warn("[RagdollTesting] ReplicatedStorage.Shared missing — use Rojo with RagdollTesting/default.project.json and sync.")
	return
end

local ragdollConfigModule = shared:WaitForChild("RagdollConfig", 10)
if not ragdollConfigModule then
	warn("[RagdollTesting] RagdollConfig module missing — sync Rojo.")
	return
end

local ok, RagdollConfig = pcall(require, ragdollConfigModule)
if not ok or type(RagdollConfig) ~= "table" then
	warn("[RagdollTesting] Failed to require RagdollConfig — sync Rojo.")
	return
end

-- #region agent log
local DEBUG_ENDPOINT = "http://127.0.0.1:7480/ingest/d8e2d61d-5277-4b90-816f-fcf06fb13604"
local DEBUG_SESSION_ID = "97f79d"
local DEBUG_RUN_ID = "pre-fix"

local function debugLog(hypothesisId: string, location: string, message: string, data: any?)
	pcall(function()
		local payload = {
			sessionId = DEBUG_SESSION_ID,
			runId = DEBUG_RUN_ID,
			hypothesisId = hypothesisId,
			location = location,
			message = message,
			data = data,
			timestamp = os.time() * 1000,
		}
		local body = HttpService:JSONEncode(payload)
		HttpService:RequestAsync({
			Url = DEBUG_ENDPOINT,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["X-Debug-Session-Id"] = DEBUG_SESSION_ID,
			},
			Body = body,
		})
	end)
end
-- #endregion agent log

local remoteFolder = ReplicatedStorage:WaitForChild("RagdollRemotes", 60)
if not remoteFolder then
	warn("[RagdollTesting] RagdollRemotes missing after 60s — is the server running? Sync Rojo from RagdollTesting.")
	return
end

local toggleRemote = remoteFolder:WaitForChild(RagdollConfig.RemoteName, 10)
if not toggleRemote or not toggleRemote:IsA("RemoteEvent") then
	warn("[RagdollTesting] RemoteEvent " .. tostring(RagdollConfig.RemoteName) .. " missing.")
	return
end

local lastLocalFire = 0.0

local function tryFire()
	local now = os.clock()
	if now - lastLocalFire < RagdollConfig.CooldownSeconds then
		return
	end
	lastLocalFire = now
	local remote = toggleRemote :: RemoteEvent

	-- #region agent log
	debugLog(
		"H1_clientFire",
		"RagdollTesting/src/client/init.client.luau:tryFire",
		"FireServer called",
		{
			hasCharacter = localPlayer.Character ~= nil,
			charRagdollActive = localPlayer.Character and localPlayer.Character:GetAttribute("RagdollActive") or nil,
		}
	)
	-- #endregion agent log
	remote:FireServer()
end

local function shouldBlockR(): boolean
	local box = UserInputService:GetFocusedTextBox()
	return box ~= nil
end

-- Single CAS binding (no duplicate Input path) — catches cases where raw keyboard events are swallowed.
ContextActionService:BindActionAtPriority(
	"RagdollTesting_ToggleR",
	function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if shouldBlockR() then
			return Enum.ContextActionResult.Pass
		end
		tryFire()
		return Enum.ContextActionResult.Sink
	end,
	false,
	50000,
	Enum.KeyCode.R
)

print("[RagdollTesting] Client loaded — press R to toggle ragdoll")
]]></string>
