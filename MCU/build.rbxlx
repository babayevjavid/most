        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">BlindFlashClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Blinding Flash screen overlay:
	Quick fade-in to ~95% white, hold, then slow fade-out over the remaining duration.
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local BlindFlashClient = {}

function BlindFlashClient.init(localPlayer: Player)
	local playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "MCU_BlindFlash"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 100
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = playerGui

	local cover = Instance.new("Frame")
	cover.Name = "Cover"
	cover.Size = UDim2.fromScale(1, 1)
	cover.BackgroundColor3 = Color3.new(1, 1, 1)
	cover.BackgroundTransparency = 1
	cover.BorderSizePixel = 0
	cover.Parent = gui

	local token = 0

	Remotes.getEvent("BlindFlash").OnClientEvent:Connect(function(payload: any)
		local duration = GameConstants.DAGGER_FLASH_DURATION
		if type(payload) == "table" and type(payload.duration) == "number" then
			duration = payload.duration
		end
		token += 1
		local myToken = token

		gui.Enabled = true
		cover.BackgroundTransparency = 1

		-- Quick enable (~0.12s) to 95% white (transparency 0.05)
		local fadeIn = TweenService:Create(
			cover,
			TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 0.05 }
		)
		fadeIn:Play()
		fadeIn.Completed:Wait()
		if myToken ~= token then
			return
		end

		local hold = math.max(0, duration - 0.12 - 1.4)
		if hold > 0 then
			task.wait(hold)
		end
		if myToken ~= token then
			return
		end

		-- Slow disable over ~1.4s
		local fadeOut = TweenService:Create(
			cover,
			TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ BackgroundTransparency = 1 }
		)
		fadeOut:Play()
		fadeOut.Completed:Wait()
		if myToken == token then
			gui.Enabled = false
		end
	end)

	localPlayer.CharacterRemoving:Connect(function()
		token += 1
		gui.Enabled = false
		cover.BackgroundTransparency = 1
	end)
end

return BlindFlashClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">CameraShakeClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Ability camera feel: tweened shake, colored vignette, FOV dip (quick in, smooth out).
	payload: { intensity: number?, duration: number?, range: number? }
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ClientSettings = require(script.Parent.ClientSettings)

local CameraShakeClient = {}

local VIGNETTE_IMAGE = "rbxassetid://18720640136"
local fovPunch = 0
local heldFov = 0
local speedFov = 0
local heldLayerApply: ((string, boolean, {
	shake: number?,
	fov: number?,
	vignette: number?,
	fade: number?,
	shakeRange: number?,
	shakeSlow: number?,
}?) -> ())? = nil

function CameraShakeClient.isAbilityZoomEnabled(): boolean
	return ClientSettings.isAbilityZoomEnabled()
end

function CameraShakeClient.setAbilityZoomEnabled(on: boolean)
	ClientSettings.setAbilityZoomEnabled(on)
end

function CameraShakeClient.isScreenShakeEnabled(): boolean
	return ClientSettings.isScreenShakeEnabled()
end

function CameraShakeClient.setScreenShakeEnabled(on: boolean)
	ClientSettings.setScreenShakeEnabled(on)
end

function CameraShakeClient.isScreenVfxEnabled(): boolean
	return ClientSettings.isScreenVfxEnabled()
end

function CameraShakeClient.setScreenVfxEnabled(on: boolean)
	ClientSettings.setScreenVfxEnabled(on)
end

function CameraShakeClient.getFovPunch(): number
	if not ClientSettings.isAbilityZoomEnabled() then
		return 0
	end
	return fovPunch + heldFov + speedFov
end

function CameraShakeClient.setHeldLayer(
	name: string,
	enabled: boolean,
	opts: {
		shake: number?,
		fov: number?,
		vignette: number?,
		fade: number?,
		shakeRange: number?,
		shakeSlow: number?,
	}?
)
	if heldLayerApply then
		heldLayerApply(name, enabled, opts)
	end
end

function CameraShakeClient.setHeldVignette(enabled: boolean, fadeSeconds: number?)
	CameraShakeClient.setHeldLayer("astral", enabled, {
		fade = fadeSeconds,
		shake = if enabled then 0.16 else 0,
		fov = if enabled then 2.5 else 0,
		vignette = if enabled then 0.4 else 1,
		shakeRange = 1.35,
		shakeSlow = 0.55,
	})
end

local function vignetteColorFor(character: Model?): Color3
	if not character then
		return Color3.fromRGB(40, 28, 48)
	end
	local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
	if heroId == "jean_grey" then
		local skin = character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE)
		if skin == "marvel_girl" then
			return GameConstants.MG_PSI_COLOR_MARVEL_GIRL
		end
		return GameConstants.MG_PSI_COLOR
	elseif heroId == "scarlet_witch" then
		return Color3.fromRGB(190, 55, 90)
	elseif heroId == "captain_marvel" then
		return Color3.fromRGB(255, 196, 72)
	elseif heroId == "iceman" then
		return Color3.fromRGB(129, 184, 255)
	elseif heroId == "invisible_woman" then
		return Color3.fromRGB(77, 71, 255)
	elseif heroId == "dagger" then
		return Color3.fromRGB(240, 236, 210)
	elseif heroId == "loki" then
		return Color3.fromRGB(80, 200, 120)
	end
	return Color3.fromRGB(40, 28, 48)
end

local function parseColor(value: any): Color3?
	if typeof(value) == "Color3" then
		return value
	end
	if type(value) == "table" then
		local r = value.R or value.r or value[1]
		local g = value.G or value.g or value[2]
		local b = value.B or value.b or value[3]
		if type(r) == "number" and type(g) == "number" and type(b) == "number" then
			if r > 1 or g > 1 or b > 1 then
				return Color3.fromRGB(r, g, b)
			end
			return Color3.new(r, g, b)
		end
	end
	return nil
end

function CameraShakeClient.init(localPlayer: Player)
	local ampValue = Instance.new("NumberValue")
	ampValue.Name = "ShakeAmp"
	ampValue.Value = 0

	local fovValue = Instance.new("NumberValue")
	fovValue.Name = "FovPunch"
	fovValue.Value = 0

	local vigValue = Instance.new("NumberValue")
	vigValue.Name = "Vignette"
	vigValue.Value = 1

	local heldVigValue = Instance.new("NumberValue")
	heldVigValue.Name = "HeldVignette"
	heldVigValue.Value = 1

	local heldAmpValue = Instance.new("NumberValue")
	heldAmpValue.Name = "HeldShake"
	heldAmpValue.Value = 0

	local heldFovValue = Instance.new("NumberValue")
	heldFovValue.Name = "HeldFov"
	heldFovValue.Value = 0

	local punchTintValue = Instance.new("NumberValue")
	punchTintValue.Name = "PunchTint"
	punchTintValue.Value = 0

	local colorFx = Instance.new("ColorCorrectionEffect")
	colorFx.Name = "MCU_ScreenFeel"
	colorFx.Enabled = true
	colorFx.TintColor = Color3.new(1, 1, 1)
	colorFx.Brightness = 0
	colorFx.Contrast = 0
	colorFx.Saturation = 0

	local punchTintColor: Color3? = nil
	local heldTintColor: Color3? = nil
	local heldTintAmp = 0
	local seed = 1.7
	local currentOffset = Vector3.zero
	local shakeTweens: { Tween } = {}
	local heldTweens: { Tween } = {}
	local bound = false
	local layers: {
		[string]: {
			shake: number,
			fov: number,
			vignette: number,
			shakeRange: number,
			shakeSlow: number,
		},
	} = {}
	local heldShakeRange = 1
	local heldShakeSlow = 1
	local holdConn: RBXScriptConnection? = nil

	local gui = Instance.new("ScreenGui")
	gui.Name = "AbilityFeelVignette"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 8
	gui.Parent = localPlayer:WaitForChild("PlayerGui")

	local vig = Instance.new("ImageLabel")
	vig.Name = "Vignette"
	vig.BackgroundTransparency = 1
	vig.Size = UDim2.fromScale(1, 1)
	vig.Image = VIGNETTE_IMAGE
	vig.ImageColor3 = Color3.fromRGB(40, 28, 48)
	vig.ImageTransparency = 1
	vig.ScaleType = Enum.ScaleType.Stretch
	vig.ZIndex = 1
	vig.Parent = gui

	local function cancelTweens()
		for _, tw in shakeTweens do
			tw:Cancel()
		end
		table.clear(shakeTweens)
	end

	local function cancelHeldTweens()
		for _, tw in heldTweens do
			tw:Cancel()
		end
		table.clear(heldTweens)
	end

	local function playTween(list: { Tween }, inst: Instance, info: TweenInfo, props: { [string]: any })
		local tw = TweenService:Create(inst, info, props)
		table.insert(list, tw)
		tw:Play()
		return tw
	end

	local function refreshVignette()
		if not ClientSettings.isScreenVfxEnabled() then
			vig.ImageTransparency = 1
			return
		end
		local mul = ClientSettings.getVignetteMul()
		vig.ImageTransparency = 1 - (1 - math.min(vigValue.Value, heldVigValue.Value)) * mul
	end

	fovValue.Changed:Connect(function(v)
		fovPunch = v
	end)
	heldFovValue.Changed:Connect(function(v)
		heldFov = v
	end)
	vigValue.Changed:Connect(refreshVignette)
	heldVigValue.Changed:Connect(refreshVignette)

	local function tweenHeldTo(shake: number, fov: number, vig: number, fade: number)
		cancelHeldTweens()
		local info = TweenInfo.new(math.max(0.16, fade * 1.44), Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
		playTween(heldTweens, heldAmpValue, info, { Value = shake })
		playTween(heldTweens, heldFovValue, info, { Value = fov })
		playTween(heldTweens, heldVigValue, info, { Value = vig })
	end

	heldLayerApply = function(
		name: string,
		enabled: boolean,
		opts: {
			shake: number?,
			fov: number?,
			vignette: number?,
			fade: number?,
			shakeRange: number?,
			shakeSlow: number?,
		}?
	)
		local fade = if opts and type(opts.fade) == "number" then opts.fade else 0.45
		if enabled then
			vig.ImageColor3 = vignetteColorFor(localPlayer.Character)
			layers[name] = {
				shake = if opts and type(opts.shake) == "number" then opts.shake else 0.1,
				fov = if opts and type(opts.fov) == "number" then opts.fov else -2,
				vignette = if opts and type(opts.vignette) == "number" then opts.vignette else 0.5,
				shakeRange = if opts and type(opts.shakeRange) == "number" then opts.shakeRange else 1,
				shakeSlow = if opts and type(opts.shakeSlow) == "number" then opts.shakeSlow else 1,
			}
		else
			layers[name] = nil
		end
		local shake, fov, vigT, range, slow = 0, 0, 1, 1, 1
		for _, layer in layers do
			shake = math.max(shake, layer.shake)
			fov += layer.fov
			vigT = math.min(vigT, layer.vignette)
			range = math.max(range, layer.shakeRange)
			slow = math.min(slow, layer.shakeSlow)
		end
		heldShakeRange = range
		heldShakeSlow = slow
		if fade <= 0.08 then
			cancelHeldTweens()
			heldAmpValue.Value = shake
			heldFovValue.Value = fov
			heldVigValue.Value = vigT
			heldFov = fov
		else
			tweenHeldTo(shake, fov, vigT, fade)
		end
	end

	local lastShakeHold = false
	local lastHeldTintKey = ""

	local function applyColorCorrection()
		if not ClientSettings.isScreenVfxEnabled() then
			colorFx.TintColor = Color3.new(1, 1, 1)
			colorFx.Brightness = 0
			colorFx.Contrast = 0
			colorFx.Saturation = 0
			return
		end
		local punchAmp = punchTintValue.Value * ClientSettings.getVignetteMul()
		local amp = math.max(punchAmp, heldTintAmp * ClientSettings.getVignetteMul())
		local color = if punchAmp >= heldTintAmp then punchTintColor else heldTintColor
		if amp < 0.01 or not color then
			colorFx.TintColor = Color3.new(1, 1, 1)
			colorFx.Brightness = 0
			colorFx.Contrast = 0
			colorFx.Saturation = 0
			return
		end
		local blend = math.clamp(amp, 0, 1)
		colorFx.TintColor = Color3.new(1, 1, 1):Lerp(color, blend)
		colorFx.Brightness = -0.1 * blend
		colorFx.Contrast = 0.16 * blend
		colorFx.Saturation = 0.2 * blend
	end

	local function syncHeldScreenFeel(character: Model?)
		if not character or not character.Parent then
			heldTintColor = nil
			heldTintAmp = 0
			if lastShakeHold then
				lastShakeHold = false
				CameraShakeClient.setHeldLayer("victimHit", false, { fade = 0.28 })
			end
			lastHeldTintKey = ""
			return
		end
		local untilTime = character:GetAttribute(GameConstants.SCREEN_TINT_UNTIL_ATTRIBUTE)
		local tint = parseColor(character:GetAttribute(GameConstants.SCREEN_TINT_ATTRIBUTE))
		if tint and type(untilTime) == "number" and workspace:GetServerTimeNow() >= untilTime then
			tint = nil
		end
		heldTintColor = tint
		heldTintAmp = if tint then 0.72 else 0
		local tintKey = if tint
			then string.format("%.3f,%.3f,%.3f", tint.R, tint.G, tint.B)
			else ""
		lastHeldTintKey = tintKey
		local shakeHold = character:GetAttribute(GameConstants.SCREEN_SHAKE_HOLD_ATTRIBUTE) == true
		if shakeHold ~= lastShakeHold then
			lastShakeHold = shakeHold
			CameraShakeClient.setHeldLayer("victimHit", shakeHold, {
				fade = if shakeHold then 0.12 else 0.28,
				shake = if shakeHold then 0.32 else 0,
				fov = if shakeHold then -3.2 else 0,
				vignette = if shakeHold then 0.42 else 1,
				shakeRange = 1.45,
				shakeSlow = 0.72,
			})
		end
	end

	local function updateSpeedFov(character: Model?, dt: number)
		local target = 0
		if character and character.Parent and character:GetAttribute(GameConstants.SCREEN_SPEED_FOV_ATTRIBUTE) == true then
			local root = character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				target = math.clamp(root.AssemblyLinearVelocity.Magnitude / 68, 0, 1) * 12
			end
		end
		speedFov += (target - speedFov) * math.clamp(dt * 9, 0, 1)
		if math.abs(speedFov) < 0.02 then
			speedFov = 0
		end
	end

	local function tickShake(dt: number)
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		if colorFx.Parent ~= cam then
			colorFx.Parent = cam
		end
		applyColorCorrection()
		updateSpeedFov(localPlayer.Character, dt)
		syncHeldScreenFeel(localPlayer.Character)
		local punchAmp = ampValue.Value
		local heldAmp = heldAmpValue.Value
		local amp = if ClientSettings.isScreenShakeEnabled() then math.max(punchAmp, heldAmp) else 0
		if amp < 0.004 then
			currentOffset = currentOffset:Lerp(Vector3.zero, math.clamp(dt * 16, 0, 1))
			if currentOffset.Magnitude < 0.01 then
				currentOffset = Vector3.zero
			end
			if currentOffset.Magnitude > 0.001 then
				cam.CFrame *= CFrame.new(currentOffset * 0.05)
			end
			return
		end

		local t = os.clock()
		local fast = punchAmp > 0.02
		local slowMul = math.clamp(heldShakeSlow, 0.25, 1.2)
		local rangeMul = math.clamp(heldShakeRange, 0.6, 3)
		local f1 = if fast then 6.2 else (0.92 * slowMul)
		local f2 = if fast then 5.4 else (0.68 * slowMul)
		local f3 = if fast then 4.1 else (0.52 * slowMul)
		local n1 = math.noise(t * f1, seed, 0.2)
		local n2 = math.noise(seed * 0.3, t * f2, 1.1)
		local n3 = math.noise(0.7, seed, t * f3)
		local span = if fast then 1.25 else rangeMul
		local targetOffset = Vector3.new(n1 * amp * 2.55 * span, n2 * amp * 2.15 * span, n3 * amp * 1.2 * span)
		local follow = if fast then 14 else 2.8
		currentOffset = currentOffset:Lerp(targetOffset, math.clamp(dt * follow, 0.05, 1))
		local roll = (if fast then 0.055 else 0.032) * span
		local pitch = (if fast then 0.048 else 0.024) * span
		cam.CFrame = cam.CFrame
			* CFrame.new(currentOffset * (if fast then 0.12 else 0.11 * span))
			* CFrame.Angles(n2 * amp * pitch, 0, n1 * amp * roll)
	end

	local function ensureLoop()
		if bound then
			return
		end
		bound = true
		RunService:BindToRenderStep("MCU_AbilityCameraFeel", Enum.RenderPriority.Camera.Value + 3, function(dt)
			tickShake(math.clamp(dt, 0.001, 0.05))
		end)
	end

	Remotes.getEvent("CameraShake").OnClientEvent:Connect(function(payload: any)
		local intensity = 0.55
		local duration = 0.45
		local rangeScale = 1
		local fovScale = 1
		local vignetteScale = 1
		local tintColor: Color3? = nil
		local tintDuration: number? = nil
		if type(payload) == "table" then
			if type(payload.intensity) == "number" then
				intensity = payload.intensity
			end
			if type(payload.duration) == "number" then
				duration = payload.duration
			end
			if type(payload.range) == "number" then
				rangeScale = math.clamp(payload.range, 0.35, 2.5)
			end
			if type(payload.fovScale) == "number" then
				fovScale = math.clamp(payload.fovScale, 0, 2.5)
			end
			if type(payload.vignetteScale) == "number" then
				vignetteScale = math.clamp(payload.vignetteScale, 0, 2)
			end
			tintColor = parseColor(payload.tint)
			if type(payload.tintDuration) == "number" then
				tintDuration = payload.tintDuration
			end
		end

		local incoming = math.max(0, intensity) * rangeScale * 1.32
		local peak = if ClientSettings.isScreenShakeEnabled() then math.max(ampValue.Value, incoming) else 0
		local dip = if ClientSettings.isAbilityZoomEnabled()
			then -math.clamp((1.6 + incoming * 2.7) * fovScale, 0, 5.6)
			else 0
		local vigPeak = if ClientSettings.isScreenVfxEnabled()
			then math.clamp(1 - (0.38 + incoming * 0.48) * vignetteScale * ClientSettings.getVignetteMul(), 0.1, 1)
			else 1
		local attack = 0.06
		local recover = math.max(0.42, duration * 1.85)
		seed = os.clock() * 13.17 + incoming * 4.1

		local character = localPlayer.Character
		if heldVigValue.Value > 0.92 then
			vig.ImageColor3 = vignetteColorFor(character)
		end

		cancelTweens()
		playTween(shakeTweens, ampValue, TweenInfo.new(attack, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { Value = peak })
		playTween(shakeTweens, fovValue, TweenInfo.new(attack, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { Value = dip })
		playTween(shakeTweens, vigValue, TweenInfo.new(attack, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { Value = vigPeak })

		task.delay(attack, function()
			playTween(shakeTweens, ampValue, TweenInfo.new(recover, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { Value = 0 })
			playTween(shakeTweens, fovValue, TweenInfo.new(recover, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), { Value = 0 })
			playTween(shakeTweens, vigValue, TweenInfo.new(recover * 1.05, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Value = 1 })
		end)

		if tintColor and ClientSettings.isScreenVfxEnabled() then
			punchTintColor = tintColor
			local tintHold = math.max(0.18, tintDuration or (duration * 0.85))
			local tintOut = math.max(0.28, tintHold * 0.9)
			playTween(shakeTweens, punchTintValue, TweenInfo.new(attack, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { Value = 0.88 })
			task.delay(attack + tintHold * 0.35, function()
				playTween(shakeTweens, punchTintValue, TweenInfo.new(tintOut, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Value = 0 })
			end)
		end

		ensureLoop()
	end)

	ClientSettings.onChanged(function()
		refreshVignette()
		applyColorCorrection()
		if not ClientSettings.isScreenShakeEnabled() then
			cancelTweens()
			cancelHeldTweens()
			ampValue.Value = 0
			heldAmpValue.Value = 0
			currentOffset = Vector3.zero
		end
		if not ClientSettings.isScreenVfxEnabled() then
			vigValue.Value = 1
			heldVigValue.Value = 1
			punchTintValue.Value = 0
		end
	end)

	localPlayer.CharacterRemoving:Connect(function()
		if holdConn then
			holdConn:Disconnect()
			holdConn = nil
		end
		cancelTweens()
		cancelHeldTweens()
		ampValue.Value = 0
		fovValue.Value = 0
		vigValue.Value = 1
		heldVigValue.Value = 1
		heldAmpValue.Value = 0
		heldFovValue.Value = 0
		heldVigValue.Value = 1
		punchTintValue.Value = 0
		heldFov = 0
		speedFov = 0
		punchTintColor = nil
		heldTintColor = nil
		heldTintAmp = 0
		lastShakeHold = false
		lastHeldTintKey = ""
		table.clear(layers)
		fovPunch = 0
		currentOffset = Vector3.zero
		vig.ImageTransparency = 1
		colorFx.TintColor = Color3.new(1, 1, 1)
		colorFx.Brightness = 0
		colorFx.Contrast = 0
		colorFx.Saturation = 0
	end)

	ensureLoop()

	local HOLD_FEEL_IDS: { [string]: boolean } = {
		psionic_barrier = true,
		psionic_bolt = true,
		psychic_pull = true,
		telekinesis = true,
		telekinetic_debris = true,
		telekinetic_slam = true,
		telepathic_pain = true,
		telepathic_outburst = true,
		mind_link = true,
		hex_beam = true,
		hex_bolt = true,
		hex_shield = true,
		hex_displacement = true,
		hex_blast = true,
		probability_hex = true,
		rune_entrapment = true,
		regeneration = true,
		iw_forcefield = true,
		forcefield_crush = true,
		forcefield_area = true,
		forcefield_choke = true,
		forcefield_push = true,
		forcefield_smash = true,
		disc_throw = true,
		body_projection = true,
		invisibility = true,
		astral_projection = true,
	}

	local function syncAbilityHold(character: Model)
		local on = false
		for abilityId, _ in HOLD_FEEL_IDS do
			if AbilityCooldownHelper.isActive(character, abilityId) then
				on = true
				break
			end
		end
		CameraShakeClient.setHeldLayer("abilityHold", on, {
			fade = if on then 0.28 else 0.7,
			shake = if on then 0.08 else 0,
			fov = if on then -2.4 else 0,
			vignette = if on then 0.52 else 1,
			shakeRange = 0.9,
			shakeSlow = 0.4,
		})
	end

	local function hookAbilityHold(character: Model)
		if holdConn then
			holdConn:Disconnect()
			holdConn = nil
		end
		holdConn = character.AttributeChanged:Connect(function(attr)
			if string.sub(attr, 1, 14) == "AbilityActive_" then
				syncAbilityHold(character)
			elseif attr == GameConstants.SCREEN_TINT_ATTRIBUTE
				or attr == GameConstants.SCREEN_TINT_UNTIL_ATTRIBUTE
				or attr == GameConstants.SCREEN_SHAKE_HOLD_ATTRIBUTE
			then
				syncHeldScreenFeel(character)
			end
		end)
		syncAbilityHold(character)
		syncHeldScreenFeel(character)
	end

	if localPlayer.Character then
		hookAbilityHold(localPlayer.Character)
	end
	localPlayer.CharacterAdded:Connect(hookAbilityHold)
end

return CameraShakeClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">CharacterSelectUI</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local AnimationPreload = require(ReplicatedStorage.Shared.AnimationPreload)
local MorphVfxTint = require(ReplicatedStorage.Shared.MorphVfxTint)
local MorphAnimationHelper = require(ReplicatedStorage.Shared.MorphAnimationHelper)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)
local ViewportHelper = require(script.Parent.ViewportHelper)
local PlayerDataClient = require(script.Parent.PlayerDataClient)
local ShopUI = require(script.Parent.ShopUI)
local SettingsUI = require(script.Parent.SettingsUI)
local CoinDisplayClient = require(script.Parent.CoinDisplayClient)
local CoinPurchasePopup = require(script.Parent.CoinPurchasePopup)
local StarterGuiUtil = require(script.Parent.StarterGuiUtil)

export type SelectionController = {
	show: (skipIntro: boolean?) -> (),
	showSelection: () -> (),
	hide: () -> (),
	destroy: () -> (),
	beginDeployWhiteout: () -> (),
	endDeployWhiteout: () -> (),
}

local THEME = Color3.fromHex("238591")
local THEME_DARK = Color3.fromRGB(42, 118, 128)
local THEME_DEEP = Color3.fromRGB(28, 88, 98)
local THEME_MID = Color3.fromRGB(58, 148, 158)
local GLASS = Color3.fromRGB(18, 72, 82)
local CREAM = Color3.fromRGB(245, 252, 252)
local MUTED = Color3.fromRGB(200, 228, 232)
local GOLD = Color3.fromRGB(240, 220, 150)
local GOLD_DIM = Color3.fromRGB(210, 185, 110)
local CIRCLE_IDLE = Color3.fromRGB(28, 92, 102)
local CIRCLE_HOVER = Color3.fromRGB(48, 130, 140)
local DEPLOY_GRAD_FROM = Color3.fromRGB(48, 92, 86)
local CONFIRM_BG = Color3.fromRGB(46, 132, 78)
local CONFIRM_GRAD_FROM = Color3.fromRGB(58, 158, 96)
local CONFIRM_GRAD_TO = Color3.fromRGB(24, 88, 52)
local CLICK_SOUND_ID = "rbxassetid://3848738002"
local DEPLOY_SOUND_ID = "rbxassetid://3785105076"
local CONFIRM_SOUND_ID = "rbxassetid://3785104770"

local TWEEN_IN = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_OUT = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local HOVER = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local WHITE_IN = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local WHITE_OUT = TweenInfo.new(1.85, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
local LOADING_ZOOM = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local LOADING_WHITE_IN = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local ROTATE_SPEED = 1.35
local SELECT_DECO_IMAGE = "rbxassetid://107401688193642"
local DECO_SPIN_SPEED = 34
local SELECT_DECO_SCALE = 1.24

local CharacterSelectUI = {}

local function corner(parent: Instance, scale: number, px: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scale, px or 0)
	c.Parent = parent
	return c
end

local function stroke(parent: Instance, color: Color3, thickness: number, trans: number): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = trans
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function uiGradient(parent: Instance, from: Color3, to: Color3, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, from),
		ColorSequenceKeypoint.new(0.55, from:Lerp(to, 0.35)),
		ColorSequenceKeypoint.new(1, to),
	})
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

local function applyButtonGradient(parent: Instance, from: Color3, to: Color3)
	local g = parent:FindFirstChildOfClass("UIGradient")
	if not g then
		g = uiGradient(parent, from, to, 95)
		return
	end
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, from),
		ColorSequenceKeypoint.new(0.55, from:Lerp(to, 0.35)),
		ColorSequenceKeypoint.new(1, to),
	})
end

local function addVignette(parent: Instance)
	local dim = Instance.new("Frame")
	dim.Name = "MenuDim"
	dim.Size = UDim2.fromScale(1, 1)
	dim.BackgroundColor3 = Color3.fromRGB(8, 28, 34)
	dim.BackgroundTransparency = 0.72
	dim.BorderSizePixel = 0
	dim.ZIndex = 0
	dim.Parent = parent
	local g = Instance.new("UIGradient")
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(0.4, 0.55),
		NumberSequenceKeypoint.new(0.7, 0.62),
		NumberSequenceKeypoint.new(1, 0.08),
	})
	g.Rotation = 90
	g.Parent = dim
end

local function label(parent: Instance, name: string, text: string, size: UDim2, pos: UDim2): TextLabel
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("TextLabel") then
		return existing
	end
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.Font = Enum.Font.GothamMedium
	l.Text = text
	l.TextColor3 = CREAM
	l.TextScaled = true
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
	l.TextWrapped = true
	l.Parent = parent
	return l
end

local function addLayeredBackground(parent: GuiObject, rotation: number)
	parent.BackgroundColor3 = THEME_DEEP
	local base = Instance.new("UIGradient")
	base.Name = "BaseGrad"
	base.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 88, 98)),
		ColorSequenceKeypoint.new(0.4, THEME_DARK),
		ColorSequenceKeypoint.new(0.75, THEME),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(48, 130, 140)),
	})
	base.Rotation = rotation
	base.Parent = parent

	local wash = Instance.new("Frame")
	wash.Name = "Wash"
	wash.Size = UDim2.fromScale(1, 1)
	wash.BackgroundColor3 = Color3.fromRGB(28, 70, 78)
	wash.BackgroundTransparency = 0.78
	wash.BorderSizePixel = 0
	wash.ZIndex = 0
	wash.Parent = parent
	local washGrad = Instance.new("UIGradient")
	washGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 22, 28)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(36, 82, 90)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(12, 32, 38)),
	})
	washGrad.Rotation = rotation + 70
	washGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(0.45, 0.7),
		NumberSequenceKeypoint.new(1, 0.3),
	})
	washGrad.Parent = wash

	local stripes = Instance.new("Frame")
	stripes.Name = "Stripes"
	stripes.Size = UDim2.fromScale(1.4, 1.4)
	stripes.AnchorPoint = Vector2.new(0.5, 0.5)
	stripes.Position = UDim2.fromScale(0.5, 0.5)
	stripes.Rotation = 28
	stripes.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	stripes.BackgroundTransparency = 0.92
	stripes.BorderSizePixel = 0
	stripes.ZIndex = 0
	stripes.Parent = parent
	local stripeGrad = Instance.new("UIGradient")
	stripeGrad.Color = ColorSequence.new(CREAM)
	stripeGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.12, 1),
		NumberSequenceKeypoint.new(0.13, 0.9),
		NumberSequenceKeypoint.new(0.15, 1),
		NumberSequenceKeypoint.new(0.37, 1),
		NumberSequenceKeypoint.new(0.38, 0.92),
		NumberSequenceKeypoint.new(0.4, 1),
		NumberSequenceKeypoint.new(0.62, 1),
		NumberSequenceKeypoint.new(0.63, 0.92),
		NumberSequenceKeypoint.new(0.65, 1),
		NumberSequenceKeypoint.new(0.87, 1),
		NumberSequenceKeypoint.new(0.88, 0.92),
		NumberSequenceKeypoint.new(0.9, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	stripeGrad.Rotation = 90
	stripeGrad.Parent = stripes

	local vignette = Instance.new("Frame")
	vignette.Name = "Vignette"
	vignette.Size = UDim2.fromScale(1, 1)
	vignette.BackgroundColor3 = Color3.fromRGB(0, 40, 48)
	vignette.BackgroundTransparency = 0.78
	vignette.BorderSizePixel = 0
	vignette.ZIndex = 0
	vignette.Parent = parent
	local vigGrad = Instance.new("UIGradient")
	vigGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(0.35, 0.85),
		NumberSequenceKeypoint.new(0.65, 0.85),
		NumberSequenceKeypoint.new(1, 0.35),
	})
	vigGrad.Rotation = 90
	vigGrad.Parent = vignette

	local rim = Instance.new("Frame")
	rim.Name = "InnerRim"
	rim.AnchorPoint = Vector2.new(0.5, 0.5)
	rim.Position = UDim2.fromScale(0.5, 0.5)
	rim.Size = UDim2.new(1, -18, 1, -18)
	rim.BackgroundTransparency = 1
	rim.ZIndex = 1
	rim.Parent = parent
	stroke(rim, Color3.fromRGB(90, 120, 118), 1, 0.62)
end

local function glassPanel(parent: Instance, name: string): Frame
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Frame") then
		return existing
	end
	local panel = Instance.new("Frame")
	panel.Name = name
	panel.BackgroundColor3 = GLASS
	panel.BackgroundTransparency = 0.08
	panel.BorderSizePixel = 0
	panel.Parent = parent
	corner(panel, 0, 10)
	stroke(panel, Color3.fromRGB(48, 86, 90), 1.2, 0.38)
	uiGradient(panel, Color3.fromRGB(48, 128, 138), Color3.fromRGB(22, 78, 88), 110)
	local shine = Instance.new("Frame")
	shine.Name = "Shine"
	shine.Size = UDim2.new(1, 0, 0.22, 0)
	shine.BackgroundColor3 = Color3.fromRGB(210, 220, 218)
	shine.BackgroundTransparency = 0.94
	shine.BorderSizePixel = 0
	shine.ZIndex = 0
	shine.Parent = panel
	corner(shine, 0, 10)
	uiGradient(shine, Color3.fromRGB(255, 255, 255), Color3.fromRGB(120, 140, 138), 0)
	return panel
end

local function findTyped(parent: Instance, name: string, className: string, recursive: boolean?): Instance?
	local inst = parent:FindFirstChild(name, recursive == true)
	if inst and inst:IsA(className) then
		return inst
	end
	return nil
end

local function strokeOf(btn: Instance): UIStroke?
	local ring = btn:FindFirstChildWhichIsA("UIStroke")
	if ring and ring:IsA("UIStroke") then
		return ring
	end
	return nil
end

local function hookHover(btn: GuiButton, ring: UIStroke?, isLocked: (() -> boolean)?)
	btn.AutoButtonColor = false
	local existingScale = btn:FindFirstChild("HoverScale")
	local scale: UIScale
	if existingScale and existingScale:IsA("UIScale") then
		scale = existingScale
	else
		scale = Instance.new("UIScale")
		scale.Name = "HoverScale"
		scale.Parent = btn
	end
	local baseColor = ring and ring.Color or THEME
	local baseThick = if ring then ring.Thickness else 1.2
	btn.MouseEnter:Connect(function()
		TweenService:Create(scale, HOVER, { Scale = 1.04 }):Play()
		if ring and not (isLocked and isLocked()) then
			TweenService:Create(ring, HOVER, { Color = GOLD, Thickness = baseThick + 0.6, Transparency = 0.12 }):Play()
		end
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(scale, HOVER, { Scale = 1 }):Play()
		if ring and not (isLocked and isLocked()) then
			TweenService:Create(ring, HOVER, { Color = baseColor, Thickness = baseThick, Transparency = 0.28 }):Play()
		end
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(scale, HOVER, { Scale = 0.97 }):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(scale, HOVER, { Scale = 1.04 }):Play()
	end)
end

function CharacterSelectUI.create(playerGui: PlayerGui, onSelect: (string, string) -> ()): SelectionController
	local roster = CharacterRegistry.getRoster()
	local selectedId: string? = nil
	local selectedSkin: string = "base"
	local awaitingDeployConfirm = false
	local deployLocked = false
	local confirmToken = 0
	local previewYaw = 0
	local page: "initial" | "select" | "shop" | "settings" = "initial"
	local circleRings: { [string]: UIStroke } = {}
	local circleFills: { [string]: TextButton } = {}
	local rosterLocks: { [string]: TextButton } = {}
	local rotateDir = 0
	local rotateConn: RBXScriptConnection? = nil
	local selectCamConn: RBXScriptConnection? = nil
	local camWatchConn: RBXScriptConnection? = nil
	local worldPreview: Model? = nil
	local worldPreviewIdle: AnimationTrack? = nil
	local selectCamActive = false
	local menuCamActive = false
	local selectPageCamActive = false
	local selectCamWarned = false
	local selectCamBound = false
	local savedCamType: Enum.CameraType? = nil
	local savedCamCf: CFrame? = nil
	local localCharHidden = false
	local SELECT_CAM_BIND = "MCU_SelectCamera"
	local MENU_CAM_MARKER = "CameraPosition1"
	local SELECT_CAM_MARKER = "CameraPosition"

	local function getMarkerCFrame(name: string): CFrame?
		local marker = Workspace:FindFirstChild(name)
		if not marker then
			return nil
		end
		if marker:IsA("BasePart") then
			return marker.CFrame
		end
		if marker:IsA("Model") then
			return marker:GetPivot()
		end
		if marker:IsA("Attachment") then
			return marker.WorldCFrame
		end
		return nil
	end

	local function setLocalCharacterHidden(hidden: boolean)
		local char = Players.LocalPlayer.Character
		if not char then
			localCharHidden = false
			return
		end
		localCharHidden = hidden
		for _, desc in char:GetDescendants() do
			if desc:IsA("BasePart") then
				desc.LocalTransparencyModifier = if hidden then 1 else 0
			end
		end
	end

	local function clearWorldPreview()
		if worldPreviewIdle then
			worldPreviewIdle:Stop(0)
			worldPreviewIdle:Destroy()
			worldPreviewIdle = nil
		end
		if worldPreview then
			worldPreview:Destroy()
			worldPreview = nil
		end
	end

	local function findIdleAnimId(root: Instance?): string?
		if not root then
			return nil
		end
		local animate = root:FindFirstChild("Animate")
		if not animate then
			return nil
		end
		local folder = animate:FindFirstChild("idle") or animate:FindFirstChild("Idle")
		if not folder then
			return nil
		end
		local preferred = folder:FindFirstChild("Animation1")
		if preferred then
			if preferred:IsA("Animation") and preferred.AnimationId ~= "" then
				return preferred.AnimationId
			end
			if preferred:IsA("StringValue") and preferred.Value ~= "" then
				return preferred.Value
			end
			local nested = preferred:FindFirstChildOfClass("Animation")
			if nested and nested.AnimationId ~= "" then
				return nested.AnimationId
			end
		end
		for _, child in folder:GetChildren() do
			if child:IsA("Animation") and child.AnimationId ~= "" then
				return child.AnimationId
			end
			if child:IsA("StringValue") and child.Value ~= "" then
				return child.Value
			end
			local nested = child:FindFirstChildOfClass("Animation")
			if nested and nested.AnimationId ~= "" then
				return nested.AnimationId
			end
		end
		return nil
	end

	local function playWorldIdle(clone: Model, idleId: string?): AnimationTrack?
		if not idleId then
			return nil
		end
		local hum = clone:FindFirstChildOfClass("Humanoid")
		if not hum then
			return nil
		end
		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = hum
		end
		local anim = Instance.new("Animation")
		anim.AnimationId = idleId
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		anim:Destroy()
		if not ok or not track then
			return nil
		end
		track.Looped = true
		track.Priority = Enum.AnimationPriority.Idle
		track:Play(0.15)
		return track
	end

	local function applyWorldPreviewYaw()
		local model = worldPreview
		local spawnCf = getMarkerCFrame("SpawnSelect")
		local camCf = getMarkerCFrame(SELECT_CAM_MARKER)
		if not model or not model.Parent or not spawnCf then
			return
		end
		local pos = spawnCf.Position
		local faceCf: CFrame
		if camCf then
			local lookTarget = Vector3.new(camCf.Position.X, pos.Y, camCf.Position.Z)
			if (lookTarget - pos).Magnitude < 0.05 then
				faceCf = spawnCf
			else
				faceCf = CFrame.lookAt(pos, lookTarget)
			end
		else
			faceCf = spawnCf
		end
		model:PivotTo(faceCf * CFrame.Angles(0, previewYaw, 0))
	end

	local function spawnWorldPreview(template: Model?)
		clearWorldPreview()
		if not template then
			return
		end
		local spawnCf = getMarkerCFrame("SpawnSelect")
		if not spawnCf then
			warn("[CharacterSelect] Missing Workspace.SpawnSelect")
			return
		end
		local wasArchivable = template.Archivable
		template.Archivable = true
		local ok, clone = pcall(function()
			return template:Clone()
		end)
		template.Archivable = wasArchivable
		if not ok or not clone or not clone:IsA("Model") then
			return
		end

		for _, desc in clone:GetDescendants() do
			if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ModuleScript") then
				if desc.Name ~= "Animate" then
					desc:Destroy()
				end
			elseif desc:IsA("BasePart") then
				desc.CanCollide = false
				desc.CanQuery = false
				desc.CanTouch = false
				if desc.Name == "HumanoidRootPart" then
					desc.Transparency = 1
					desc.Anchored = true
				else
					-- Leave unanchored so Motor6D idle can play
					desc.Anchored = false
				end
			elseif desc:IsA("Humanoid") then
				desc.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				desc.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
				desc.PlatformStand = false
			end
		end
		MorphVfxTint.applyForSkin(clone, selectedId, selectedSkin, template.Name)
		MorphAnimationHelper.applyToModel(clone, MorphAnimationHelper.idleIdForMorphName(template.Name))
		clone.Name = "SelectPreviewMorph"
		clone.Parent = Workspace
		worldPreview = clone
		applyWorldPreviewYaw()
		local idleId = findIdleAnimId(clone) or MorphAnimationHelper.idleIdForMorphName(template.Name)
		worldPreviewIdle = playWorldIdle(clone, idleId)
		VfxHelper.attachNamedAssetToHrp(clone, "CharacterChooseAttachment")
		local burst = VfxHelper.attachNamedAssetToHrp(clone, "InitialParticleAttachment")
		task.delay(0.1, function()
			for _, inst in burst do
				if inst.Parent then
					VfxHelper.setParticlesEnabled(inst, false)
				end
			end
		end)
	end

	local function applyCameraAt(markerName: string): boolean
		local cam = Workspace.CurrentCamera
		local camCf = getMarkerCFrame(markerName)
		if not cam or not camCf then
			if cam then
				cam.CameraType = Enum.CameraType.Custom
				local character = Players.LocalPlayer.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					cam.CameraSubject = humanoid
				end
			end
			return false
		end
		cam.CameraType = Enum.CameraType.Scriptable
		cam.CFrame = camCf
		return true
	end

	local function applyMenuCamera(): boolean
		return applyCameraAt(MENU_CAM_MARKER)
	end

	local function applySelectPageCamera(): boolean
		return applyCameraAt(SELECT_CAM_MARKER)
	end

	local function ensureMenuCameraBind()
		if selectCamBound then
			return
		end
		selectCamBound = true
		RunService:BindToRenderStep(SELECT_CAM_BIND, Enum.RenderPriority.Last.Value, function()
			if menuCamActive then
				applyMenuCamera()
			elseif selectPageCamActive then
				applySelectPageCamera()
			end
		end)
	end

	local function reapplyActiveCamera()
		if menuCamActive then
			applyMenuCamera()
		elseif selectPageCamActive then
			applySelectPageCamera()
		end
	end

	local function enterMenuCamera()
		local cam = Workspace.CurrentCamera
		if cam and savedCamCf == nil then
			savedCamType = cam.CameraType
			savedCamCf = cam.CFrame
		end
		menuCamActive = true
		selectPageCamActive = false
		selectCamActive = true
		setLocalCharacterHidden(true)
		if not applyMenuCamera() then
			if not selectCamWarned then
				selectCamWarned = true
				warn("[CharacterSelect] Waiting for Workspace.CameraPosition1")
			end
		end
		ensureMenuCameraBind()
		if not camWatchConn then
			camWatchConn = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
				if menuCamActive or selectPageCamActive then
					task.defer(reapplyActiveCamera)
				end
			end)
		end
		task.spawn(function()
			if not getMarkerCFrame(MENU_CAM_MARKER) then
				Workspace:WaitForChild(MENU_CAM_MARKER, 20)
			end
			if menuCamActive then
				applyMenuCamera()
			end
		end)
	end

	local function enterSelectPageCamera()
		menuCamActive = false
		selectPageCamActive = true
		selectCamActive = true
		setLocalCharacterHidden(true)
		if not applySelectPageCamera() then
			warn("[CharacterSelect] Waiting for Workspace.CameraPosition")
		end
		ensureMenuCameraBind()
		if not camWatchConn then
			camWatchConn = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
				if menuCamActive or selectPageCamActive then
					task.defer(reapplyActiveCamera)
				end
			end)
		end
		task.spawn(function()
			if not getMarkerCFrame(SELECT_CAM_MARKER) then
				Workspace:WaitForChild(SELECT_CAM_MARKER, 20)
			end
			if selectPageCamActive then
				applySelectPageCamera()
			end
		end)
	end

	local function exitSelectCamera()
		clearWorldPreview()
		setLocalCharacterHidden(false)
		menuCamActive = false
		selectPageCamActive = false
		if selectCamBound then
			pcall(function()
				RunService:UnbindFromRenderStep(SELECT_CAM_BIND)
			end)
			selectCamBound = false
		end
		if camWatchConn then
			camWatchConn:Disconnect()
			camWatchConn = nil
		end
		if selectCamConn then
			selectCamConn:Disconnect()
			selectCamConn = nil
		end
		local cam = Workspace.CurrentCamera
		if cam and selectCamActive then
			cam.CameraType = savedCamType or Enum.CameraType.Custom
			if savedCamCf then
				cam.CFrame = savedCamCf
			end
		end
		selectCamActive = false
		savedCamType = nil
		savedCamCf = nil
	end

