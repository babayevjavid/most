	rosterLeftGap.BackgroundTransparency = 1
	rosterLeftGap.Parent = rosterBar

	local function ensureRotateLoop()
		if rotateConn then
			return
		end
		rotateConn = RunService.RenderStepped:Connect(function(dt)
			if rotateDir == 0 or not selectedId then
				return
			end
			previewYaw += rotateDir * ROTATE_SPEED * dt
			applyWorldPreviewYaw()
			if selectPageCamActive then
				applySelectPageCamera()
			elseif menuCamActive then
				applyMenuCamera()
			end
		end)
	end

	local function bindHoldRotate(btn: TextButton, dir: number)
		btn.MouseButton1Down:Connect(function()
			playClick()
			rotateDir = dir
			ensureRotateLoop()
		end)
		btn.MouseButton1Up:Connect(function()
			if rotateDir == dir then
				rotateDir = 0
			end
		end)
		btn.MouseLeave:Connect(function()
			if rotateDir == dir then
				rotateDir = 0
			end
		end)
	end
	bindHoldRotate(leftArrow, -1)
	bindHoldRotate(rightArrow, 1)

	local function setDeployLabel(isConfirm: boolean)
		if isConfirm then
			deploy.Text = "CONFIRM"
			deploy.BackgroundColor3 = CONFIRM_BG
			applyButtonGradient(deploy, CONFIRM_GRAD_FROM, CONFIRM_GRAD_TO)
		else
			deploy.Text = "DEPLOY"
			deploy.BackgroundColor3 = THEME
			applyButtonGradient(deploy, DEPLOY_GRAD_FROM, THEME_DEEP)
		end
	end

	local function refreshPreview()
		if not selectedId then
			deploy.Visible = false
			clearWorldPreview()
			return
		end
		local entry = CharacterRegistry.getById(selectedId)
		if not entry then
			return
		end
		nameLabel.Text = "Name: " .. entry.displayName
		aliasLabel.Text = "Alias: " .. entry.alias
		powersLabel.Text = "Powers: " .. entry.powers
		bioLabel.Text = "Biography: " .. entry.biography
		deploy.Visible = canDeploySelection()
		deploy.Active = deploy.Visible and not deployLocked
		if deploy.Visible and not deployLocked and not awaitingDeployConfirm then
			setDeployLabel(false)
		end
		local template = CharacterRegistry.getMorphTemplate(selectedId, selectedSkin)
		spawnWorldPreview(template)
	end

	local function rebuildSkins()
		for _, child in skinsList:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		if not selectedId then
			return
		end
		local entry = CharacterRegistry.getById(selectedId)
		if not entry then
			return
		end
		if not PlayerDataClient.ownsSkin(selectedId, selectedSkin) then
			for _, skin in entry.skins do
				if not skin.blocked and PlayerDataClient.ownsSkin(selectedId, skin.id) then
					selectedSkin = skin.id
					break
				end
			end
		end
		for i, skin in entry.skins do
			local owned = not skin.blocked and PlayerDataClient.ownsSkin(selectedId, skin.id)
			local btn = Instance.new("TextButton")
			btn.Name = skin.id
			btn.LayoutOrder = i
			btn.Size = UDim2.new(1, 0, 0, 24)
			btn.AutoButtonColor = false
			btn.BackgroundColor3 = THEME_DEEP
			btn.Font = Enum.Font.GothamBold
			btn.Text = if owned then skin.name else (skin.name .. "  ·  Locked")
			btn.TextColor3 = if owned then CREAM else MUTED
			btn.TextScaled = true
			btn.TextStrokeTransparency = 1
			btn.Parent = skinsList
			corner(btn, 0, 6)
			local selected = owned and skin.id == selectedSkin
			uiGradient(btn, if selected then THEME_MID else THEME_DEEP, THEME_DEEP, 90)
			local ring = stroke(btn, if selected then GOLD else Color3.fromRGB(48, 86, 90), if selected then 1.6 else 1, if selected then 0.18 else 0.48)
			if selected then
				btn.BackgroundColor3 = THEME_MID
			end
			if not owned then
				btn.BackgroundTransparency = 0.15
			end
			hookHover(btn, ring, function()
				return selected
			end)
			btn.MouseButton1Click:Connect(function()
				if deployLocked then
					return
				end
				if not owned then
					playClick()
					showSkinLockToast(skin.name)
					return
				end
				playClick()
				selectedSkin = skin.id
				previewYaw = 0
				rebuildSkins()
				refreshPreview()
			end)
		end
	end

	local function paintCircleRings()
		for heroId, ring in circleRings do
			local picked = heroId == selectedId
			ring.Color = if picked then GOLD else THEME
			ring.Thickness = if picked then 2.8 else 1.4
			ring.Transparency = if picked then 0.05 else 0.28
			local btn = circleFills[heroId]
			if btn then
				if not picked then
					btn.BackgroundColor3 = CIRCLE_IDLE
				else
					btn.BackgroundColor3 = THEME_DEEP
				end
				local deco = btn:FindFirstChild("SelectedDeco")
				if picked then
					if not deco or not deco:IsA("ImageLabel") then
						if deco then
							deco:Destroy()
						end
						deco = Instance.new("ImageLabel")
						deco.Name = "SelectedDeco"
						deco.AnchorPoint = Vector2.new(0.5, 0.5)
						deco.Position = UDim2.fromScale(0.5, 0.5)
						deco.Size = UDim2.fromScale(SELECT_DECO_SCALE, SELECT_DECO_SCALE)
						deco.BackgroundTransparency = 1
						deco.Image = SELECT_DECO_IMAGE
						deco.ImageColor3 = Color3.new(1, 1, 1)
						deco.ScaleType = Enum.ScaleType.Stretch
						deco.ZIndex = 5
						deco.Parent = btn
						corner(deco, 1, 0)
					else
						deco.Size = UDim2.fromScale(SELECT_DECO_SCALE, SELECT_DECO_SCALE)
						deco.ImageColor3 = Color3.new(1, 1, 1)
					end
				elseif deco then
					deco:Destroy()
				end
			end
		end
	end

	local function selectHero(heroId: string)
		if deployLocked then
			return
		end
		selectedId = heroId
		selectedSkin = "base"
		previewYaw = 0
		awaitingDeployConfirm = false
		confirmToken += 1
		rebuildSkins()
		refreshPreview()
		paintCircleRings()
	end

	local COL = 2
	local colFrames: { Frame } = {}
	local function columnFor(index: number): Frame
		local colIndex = math.floor((index - 1) / COL) + 1
		local existing = colFrames[colIndex]
		if existing then
			return existing
		end
		local col = Instance.new("Frame")
		col.Name = "Col" .. tostring(colIndex)
		col.LayoutOrder = colIndex
		col.Size = UDim2.new(0, 0, 1, 0)
		col.AutomaticSize = Enum.AutomaticSize.X
		col.BackgroundTransparency = 1
		col.Parent = rosterBar
		local list = Instance.new("UIListLayout")
		list.FillDirection = Enum.FillDirection.Vertical
		list.HorizontalAlignment = Enum.HorizontalAlignment.Center
		list.VerticalAlignment = Enum.VerticalAlignment.Center
		list.Padding = UDim.new(0.04, 0)
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Parent = col
		colFrames[colIndex] = col
		return col
	end

	for index, entry in roster do
		local col = columnFor(index)
		local btn = Instance.new("TextButton")
		btn.Name = entry.id
		btn.LayoutOrder = ((index - 1) % COL) + 1
		btn.Size = UDim2.new(0, 118, 0.52, 0)
		btn.BackgroundColor3 = CIRCLE_IDLE
		btn.Text = ""
		btn.AutoButtonColor = false
		btn.Parent = col
		local aspect = Instance.new("UIAspectRatioConstraint")
		aspect.AspectRatio = 1
		aspect.DominantAxis = Enum.DominantAxis.Height
		aspect.Parent = btn
		corner(btn, 1, 0)
		uiGradient(btn, CIRCLE_HOVER, CIRCLE_IDLE, 120)
		local ring = stroke(btn, THEME, 1.4, 0.28)
		circleRings[entry.id] = ring
		circleFills[entry.id] = btn

		local vp = Instance.new("ViewportFrame")
		vp.Name = "Preview"
		vp.Size = UDim2.fromScale(0.92, 0.92)
		vp.Position = UDim2.fromScale(0.04, 0.04)
		vp.BackgroundTransparency = 1
		vp.BorderSizePixel = 0
		vp.ZIndex = 2
		vp.Parent = btn
		corner(vp, 1, 0)

		local chip = Instance.new("TextLabel")
		chip.Name = "HoverName"
		chip.AnchorPoint = Vector2.new(0.5, 0.5)
		chip.Position = UDim2.fromScale(0.5, 0.5)
		chip.Size = UDim2.fromScale(0.75, 0.75)
		chip.BackgroundColor3 = THEME_DEEP
		chip.BackgroundTransparency = 1
		chip.Font = Enum.Font.GothamBold
		chip.Text = entry.displayName
		chip.TextColor3 = CREAM
		chip.TextScaled = true
		chip.TextTransparency = 1
		chip.ZIndex = 4
		chip.Parent = btn
		corner(chip, 1, 0)
		local chipPad = Instance.new("UIPadding")
		chipPad.PaddingTop = UDim.new(0.28, 0)
		chipPad.PaddingBottom = UDim.new(0.28, 0)
		chipPad.PaddingLeft = UDim.new(0.1, 0)
		chipPad.PaddingRight = UDim.new(0.1, 0)
		chipPad.Parent = chip

		local template = CharacterRegistry.getMorphTemplate(entry.id, "base")
		if template then
			ViewportHelper.bindTemplate(vp, template, 0, "select")
		end

		hookHover(btn, ring, function()
			return selectedId == entry.id
		end)
		btn.MouseEnter:Connect(function()
			if selectedId ~= entry.id then
				TweenService:Create(btn, HOVER, { BackgroundColor3 = CIRCLE_HOVER }):Play()
			end
			TweenService:Create(chip, HOVER, { TextTransparency = 0, BackgroundTransparency = 0.28 }):Play()
		end)
		btn.MouseLeave:Connect(function()
			if selectedId ~= entry.id then
				TweenService:Create(btn, HOVER, { BackgroundColor3 = CIRCLE_IDLE }):Play()
			end
			TweenService:Create(chip, HOVER, { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
		end)
		btn.MouseButton1Click:Connect(function()
			playClick()
			if not PlayerDataClient.ownsCharacter(entry.id) then
				showLockToast(entry.displayName)
				return
			end
			selectHero(entry.id)
		end)
	end

	refreshRosterLocks()

	local function validateSelectionOwnership()
		if selectedId and not PlayerDataClient.ownsCharacter(selectedId) then
			selectedId = nil
			selectedSkin = "base"
			awaitingDeployConfirm = false
			confirmToken += 1
			setDeployLabel(false)
			nameLabel.Text = "Name: —"
			aliasLabel.Text = "Alias: —"
			powersLabel.Text = "Powers: —"
			bioLabel.Text = "Biography: —"
			clearWorldPreview()
			rebuildSkins()
			paintCircleRings()
		end
		refreshPreview()
	end

	PlayerDataClient.onChanged(function()
		refreshRosterLocks()
		validateSelectionOwnership()
	end)

	local whiteoutTween: Tween? = nil

	local function beginDeployWhiteout()
		if whiteoutTween then
			whiteoutTween:Cancel()
			whiteoutTween = nil
		end
		overlayGui.Enabled = true
		whiteout.Visible = true
		whiteout.BackgroundTransparency = 1
		whiteoutTween = TweenService:Create(whiteout, WHITE_IN, { BackgroundTransparency = 0 })
		whiteoutTween:Play()
	end

	local function endDeployWhiteout()
		if whiteoutTween then
			whiteoutTween:Cancel()
			whiteoutTween = nil
		end
		overlayGui.Enabled = true
		local covering = whiteout.BackgroundTransparency < 0.98
		if covering then
			whiteout.Visible = true
			whiteoutTween = TweenService:Create(whiteout, WHITE_OUT, { BackgroundTransparency = 1 })
			whiteoutTween:Play()
			local fadeToken = whiteoutTween
			task.delay(WHITE_OUT.Time, function()
				if whiteout.Parent and whiteoutTween == fadeToken then
					whiteout.Visible = false
					whiteoutTween = nil
					overlayGui.Enabled = false
				end
			end)
		else
			whiteout.Visible = false
			whiteout.BackgroundTransparency = 1
			if whiteout.BackgroundTransparency >= 0.99 then
				overlayGui.Enabled = false
			end
		end
	end

	deploy.MouseButton1Click:Connect(function()
		if deployLocked then
			return
		end
		if not selectedId then
			return
		end
		if not canDeploySelection() then
			showDeployLockToast()
			return
		end
		if not awaitingDeployConfirm then
			awaitingDeployConfirm = true
			setDeployLabel(true)
			playUiSound(deploySound)
			confirmToken += 1
			local token = confirmToken
			task.delay(3, function()
				if token ~= confirmToken or deployLocked or not awaitingDeployConfirm then
					return
				end
				awaitingDeployConfirm = false
				setDeployLabel(false)
			end)
			return
		end
		deployLocked = true
		awaitingDeployConfirm = false
		confirmToken += 1
		deploy.Active = false
		playUiSound(confirmSound)
		beginDeployWhiteout()
		task.delay(0.32, function()
			onSelect(selectedId :: string, selectedSkin)
		end)
	end)

	local function showInitial()
		page = "initial"
		hideSubPages()
		loadingIntro.Visible = false
		enterMenuCamera()
		initial.Visible = true
		initial.GroupTransparency = 0
		selectPage.BackgroundTransparency = 1
		layoutCoinBanner()
	end

	local function playLoadingIntro()
		if introPlaying or introPlayed then
			showInitial()
			return
		end
		introPlaying = true
		gui.Enabled = true
		initial.Visible = false
		hideSubPages()
		selectPage.Visible = false
		shopPage.page.Visible = false
		settingsPage.page.Visible = false
		loadingIntro.Visible = true
		loadingIntro.GroupTransparency = 0
		loadingScale.Scale = 1
		endDeployWhiteout()
		enterMenuCamera()

		local pulseRunning = true
		task.spawn(function()
			while pulseRunning and loadingIntro.Visible do
				local up = TweenService:Create(loadingScale, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
					Scale = 1.04,
				})
				up:Play()
				up.Completed:Wait()
				if not pulseRunning or not loadingIntro.Visible then
					break
				end
				local down = TweenService:Create(loadingScale, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
					Scale = 1,
				})
				down:Play()
				down.Completed:Wait()
			end
		end)

		local function finishIntro()
			if not introPlaying then
				return
			end
			pulseRunning = false
			overlayGui.Enabled = true
			whiteout.Visible = true
			whiteout.BackgroundTransparency = 1

			local zoomTween = TweenService:Create(loadingScale, LOADING_ZOOM, { Scale = 14 })
			zoomTween:Play()
			task.delay(0.35, function()
				if introPlaying then
					TweenService:Create(whiteout, LOADING_WHITE_IN, { BackgroundTransparency = 0 }):Play()
				end
			end)
			zoomTween.Completed:Wait()
			task.wait(0.12)

			loadingIntro.Visible = false
			introPlaying = false
			introPlayed = true
			showInitial()
			endDeployWhiteout()
		end

		if AnimationPreload.isReady() then
			finishIntro()
		else
			AnimationPreload.onReady(finishIntro)
		end
	end

	local function showShop()
		page = "shop"
		initial.Visible = false
		initial.GroupTransparency = 0
		hideSubPages()
		shopPage.page.Visible = true
		shopPage.refresh()
		enterMenuCamera()
		layoutCoinBanner()
	end

	local function showSettings()
		page = "settings"
		initial.Visible = false
		initial.GroupTransparency = 0
		hideSubPages()
		settingsPage.page.Visible = true
		settingsPage.refresh()
		enterMenuCamera()
		layoutCoinBanner()
	end

	local function showSelect()
		page = "select"
		hideSubPages()
		loadingIntro.Visible = false
		initial.Visible = false
		initial.GroupTransparency = 0
		selectPage.Visible = true
		selectPage.BackgroundTransparency = 1
		info.Visible = true
		skins.Visible = true
		rosterBar.Visible = true
		layoutCoinBanner()
		enterSelectPageCamera()
		if selectedId then
			refreshPreview()
		end
	end

	ensureDecoSpinLoop()

	playBtn.MouseButton1Click:Connect(function()
		showSelect()
	end)

	shopBtn.MouseButton1Click:Connect(function()
		showShop()
	end)

	settingsBtn.MouseButton1Click:Connect(function()
		showSettings()
	end)

	selectBackBtn.MouseButton1Click:Connect(function()
		playClick()
		showInitial()
	end)

	shopBackBtn.MouseButton1Click:Connect(function()
		playClick()
		showInitial()
	end)

	settingsBackBtn.MouseButton1Click:Connect(function()
		playClick()
		showInitial()
	end)

	return {
		show = function(skipIntro: boolean?)
			selectedId = nil
			selectedSkin = "base"
			previewYaw = 0
			deployLocked = false
			awaitingDeployConfirm = false
			confirmToken += 1
			deploy.Active = true
			deploy.Visible = false
			setDeployLabel(false)
			nameLabel.Text = "Name: —"
			aliasLabel.Text = "Alias: —"
			powersLabel.Text = "Powers: —"
			bioLabel.Text = "Biography: —"
			clearWorldPreview()
			rebuildSkins()
			paintCircleRings()
			hideSubPages()
			endDeployWhiteout()
			if skipIntro == true or introPlayed then
				gui.Enabled = true
				showInitial()
			else
				playLoadingIntro()
			end
		end,
			showSelection = function()
				selectedId = nil
				selectedSkin = "base"
				previewYaw = 0
				deployLocked = false
				awaitingDeployConfirm = false
				confirmToken += 1
				deploy.Active = true
				deploy.Visible = false
				setDeployLabel(false)
				clearWorldPreview()
				rebuildSkins()
				paintCircleRings()
				gui.Enabled = true
				showSelect()
			end,
		hide = function()
			introPlaying = false
			gui.Enabled = false
			loadingIntro.Visible = false
			rotateDir = 0
			exitSelectCamera()
		end,
		destroy = function()
			if rotateConn then
				rotateConn:Disconnect()
			end
			exitSelectCamera()
			gui:Destroy()
			overlayGui:Destroy()
		end,
		beginDeployWhiteout = beginDeployWhiteout,
		endDeployWhiteout = endDeployWhiteout,
	}
end

return CharacterSelectUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">ClientSettings</string>
            <string name="Source"><![CDATA[--!strict
--[[ Client-side gameplay settings: screen shake/VFX, ability zoom, graphics quality. ]]

export type GraphicsQuality = "High" | "Low"

local ClientSettings = {}

local screenShakeEnabled = true
local screenVfxEnabled = true
local abilityZoomEnabled = true
local graphicsQuality: GraphicsQuality = "High"
local listeners: { () -> () } = {}

local function notify()
	for _, fn in listeners do
		task.spawn(fn)
	end
end

function ClientSettings.onChanged(fn: () -> ())
	table.insert(listeners, fn)
end

function ClientSettings.isScreenShakeEnabled(): boolean
	return screenShakeEnabled
end

function ClientSettings.setScreenShakeEnabled(on: boolean)
	screenShakeEnabled = on == true
	notify()
end

function ClientSettings.isScreenVfxEnabled(): boolean
	return screenVfxEnabled
end

function ClientSettings.setScreenVfxEnabled(on: boolean)
	screenVfxEnabled = on == true
	notify()
end

function ClientSettings.isAbilityZoomEnabled(): boolean
	return abilityZoomEnabled
end

function ClientSettings.setAbilityZoomEnabled(on: boolean)
	abilityZoomEnabled = on == true
	notify()
end

function ClientSettings.getGraphicsQuality(): GraphicsQuality
	return graphicsQuality
end

function ClientSettings.setGraphicsQuality(quality: GraphicsQuality)
	if quality ~= "High" and quality ~= "Low" then
		return
	end
	graphicsQuality = quality
	notify()
end

function ClientSettings.getParticleMul(): number
	return if graphicsQuality == "Low" then 0.4 else 1
end

function ClientSettings.getVignetteMul(): number
	return if graphicsQuality == "Low" then 0.55 else 1
end

return ClientSettings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">CoinDisplayClient</string>
            <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local PlayerDataClient = require(script.Parent.PlayerDataClient)

export type CoinDisplayStyle = {
	background: Color3?,
	backgroundTransparency: number?,
	stroke: Color3?,
	strokeTransparency: number?,
	text: Color3?,
	corner: number?,
	height: number?,
}

export type CoinDisplay = {
	root: Frame,
	setAnchor: (anchorPoint: Vector2, position: UDim2, size: UDim2?) -> (),
	setVisible: (visible: boolean) -> (),
	destroy: () -> (),
}

local CoinDisplayClient = {}

local MAX_TWEEN_SEC = 3

local function formatCoins(n: number): string
	local s = tostring(math.max(0, math.floor(n + 0.5)))
	local result = ""
	local count = 0
	for i = #s, 1, -1 do
		result = s:sub(i, i) .. result
		count += 1
		if count % 3 == 0 and i > 1 then
			result = "," .. result
		end
	end
	return result
end

function CoinDisplayClient.create(
	parent: Instance,
	opts: {
		zIndex: number?,
		style: CoinDisplayStyle?,
		onPlusClick: ((anchor: GuiObject) -> ())?,
	}?
): CoinDisplay
	local style = if opts then opts.style else nil
	local zIndex = if opts and opts.zIndex then opts.zIndex else 30

	local displayed = PlayerDataClient.getCoins()
	local target = displayed
	local tweenConn: RBXScriptConnection? = nil

	local root = Instance.new("Frame")
	root.Name = "TokenDisplay"
	root.AnchorPoint = Vector2.new(1, 0)
	root.Size = UDim2.fromScale(0.072, 0.022)
	root.BackgroundColor3 = if style and style.background then style.background else Color3.fromRGB(18, 36, 42)
	root.BackgroundTransparency = if style and style.backgroundTransparency ~= nil then style.backgroundTransparency else 0.08
	root.BorderSizePixel = 0
	root.ZIndex = zIndex
	root.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.22, 0)
	corner.Parent = root

	local stroke = Instance.new("UIStroke")
	stroke.Color = if style and style.stroke then style.stroke else Color3.fromRGB(228, 198, 120)
	stroke.Thickness = 1
	stroke.Transparency = if style and style.strokeTransparency ~= nil then style.strokeTransparency else 0.35
	stroke.Parent = root

	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.03, 0)
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.Parent = root

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.03, 0)
	layout.Parent = root

	local prefixLabel = Instance.new("TextLabel")
	prefixLabel.Name = "Prefix"
	prefixLabel.LayoutOrder = 1
	prefixLabel.Size = UDim2.fromScale(0.34, 1)
	prefixLabel.BackgroundTransparency = 1
	prefixLabel.Font = Enum.Font.GothamBold
	prefixLabel.Text = "Tokens"
	prefixLabel.TextColor3 = if style and style.text then style.text else Color3.fromRGB(240, 220, 150)
	prefixLabel.TextScaled = true
	prefixLabel.TextXAlignment = Enum.TextXAlignment.Left
	prefixLabel.ZIndex = zIndex + 1
	prefixLabel.Parent = root

	local prefixConstraint = Instance.new("UITextSizeConstraint")
	prefixConstraint.MaxTextSize = 12
	prefixConstraint.MinTextSize = 7
	prefixConstraint.Parent = prefixLabel

	local amountLabel = Instance.new("TextLabel")
	amountLabel.Name = "Amount"
	amountLabel.LayoutOrder = 2
	amountLabel.Size = UDim2.fromScale(0.42, 1)
	amountLabel.BackgroundTransparency = 1
	amountLabel.Font = Enum.Font.GothamBold
	amountLabel.Text = formatCoins(displayed)
	amountLabel.TextColor3 = if style and style.text then style.text else Color3.fromRGB(240, 220, 150)
	amountLabel.TextScaled = true
	amountLabel.TextXAlignment = Enum.TextXAlignment.Left
	amountLabel.ZIndex = zIndex + 1
	amountLabel.Parent = root

	local amountConstraint = Instance.new("UITextSizeConstraint")
	amountConstraint.MaxTextSize = 13
	amountConstraint.MinTextSize = 8
	amountConstraint.Parent = amountLabel

	local plusBtn = Instance.new("TextButton")
	plusBtn.Name = "BuyTokens"
	plusBtn.LayoutOrder = 3
	plusBtn.Size = UDim2.fromScale(0.2, 1)
	plusBtn.BackgroundColor3 = Color3.fromRGB(228, 198, 120)
	plusBtn.BackgroundTransparency = 0.05
	plusBtn.AutoButtonColor = true
	plusBtn.Font = Enum.Font.GothamBlack
	plusBtn.Text = "+"
	plusBtn.TextColor3 = Color3.fromRGB(18, 28, 32)
	plusBtn.TextScaled = true
	plusBtn.ZIndex = zIndex + 2
	plusBtn.Parent = root

	local plusCorner = Instance.new("UICorner")
	plusCorner.CornerRadius = UDim.new(0.22, 0)
	plusCorner.Parent = plusBtn

	local plusAspect = Instance.new("UIAspectRatioConstraint")
	plusAspect.AspectRatio = 1
	plusAspect.DominantAxis = Enum.DominantAxis.Height
	plusAspect.Parent = plusBtn

	local function paintAmount()
		amountLabel.Text = formatCoins(displayed)
	end

	local function stopTween()
		if tweenConn then
			tweenConn:Disconnect()
			tweenConn = nil
		end
	end

	local function animateTo(nextTarget: number)
		target = math.max(0, math.floor(nextTarget))
		stopTween()
		local delta = target - displayed
		if math.abs(delta) < 0.5 then
			displayed = target
			paintAmount()
			return
		end
		local duration = math.clamp(math.abs(delta) / 1200, 0.35, MAX_TWEEN_SEC)
		local start = displayed
		local startClock = os.clock()
		tweenConn = RunService.RenderStepped:Connect(function()
			local t = math.clamp((os.clock() - startClock) / duration, 0, 1)
			local eased = TweenService:GetValue(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			displayed = start + (target - start) * eased
			paintAmount()
			if t >= 1 then
				displayed = target
				paintAmount()
				stopTween()
			end
		end)
	end

	local function onProfileChanged()
		animateTo(PlayerDataClient.getCoins())
	end

	PlayerDataClient.onChanged(onProfileChanged)
	paintAmount()

	if opts and opts.onPlusClick then
		local callback = opts.onPlusClick
		plusBtn.MouseButton1Click:Connect(function()
			callback(root)
		end)
	end

	return {
		root = root,
		setAnchor = function(anchorPoint: Vector2, position: UDim2, size: UDim2?)
			root.AnchorPoint = anchorPoint
			root.Position = position
			if size then
				root.Size = size
			end
		end,
		setVisible = function(visible: boolean)
			root.Visible = visible
		end,
		destroy = function()
			stopTween()
			root:Destroy()
		end,
	}
end

function CoinDisplayClient.bind(
	root: Frame,
	opts: {
		onPlusClick: ((anchor: GuiObject) -> ())?,
	}?
): CoinDisplay
	local displayed = PlayerDataClient.getCoins()
	local target = displayed
	local tweenConn: RBXScriptConnection? = nil

	local amountLabel = root:FindFirstChild("Amount")
	if not amountLabel or not amountLabel:IsA("TextLabel") then
		amountLabel = root:FindFirstChildWhichIsA("TextLabel", true)
	end
	if not amountLabel or not amountLabel:IsA("TextLabel") then
		warn("[CoinDisplayClient] TokenDisplay missing Amount label")
		return {
			root = root,
			setAnchor = function() end,
			setVisible = function(visible: boolean)
				root.Visible = visible
			end,
			destroy = function() end,
		}
	end

	local prefixLabel = root:FindFirstChild("Prefix")
	if prefixLabel and prefixLabel:IsA("TextLabel") then
		prefixLabel.Text = "Tokens"
	end

	local plusBtn = root:FindFirstChild("BuyTokens") or root:FindFirstChild("BuyCoins")
	if plusBtn and plusBtn:IsA("TextButton") then
		plusBtn.Name = "BuyTokens"
	end

	local function paintAmount()
		amountLabel.Text = formatCoins(displayed)
	end

	local function stopTween()
		if tweenConn then
			tweenConn:Disconnect()
			tweenConn = nil
		end
	end

	local function animateTo(nextTarget: number)
		target = math.max(0, math.floor(nextTarget))
		stopTween()
		local delta = target - displayed
		if math.abs(delta) < 0.5 then
			displayed = target
			paintAmount()
			return
		end
		local duration = math.clamp(math.abs(delta) / 1200, 0.35, MAX_TWEEN_SEC)
		local start = displayed
		local startClock = os.clock()
		tweenConn = RunService.RenderStepped:Connect(function()
			local t = math.clamp((os.clock() - startClock) / duration, 0, 1)
			local eased = TweenService:GetValue(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			displayed = start + (target - start) * eased
			paintAmount()
			if t >= 1 then
				displayed = target
				paintAmount()
				stopTween()
			end
		end)
	end

	PlayerDataClient.onChanged(function()
		animateTo(PlayerDataClient.getCoins())
	end)
	paintAmount()

	if opts and opts.onPlusClick and plusBtn and plusBtn:IsA("TextButton") then
		local callback = opts.onPlusClick
		plusBtn.MouseButton1Click:Connect(function()
			callback(root)
		end)
	end

	return {
		root = root,
		setAnchor = function(anchorPoint: Vector2, position: UDim2, size: UDim2?)
			root.AnchorPoint = anchorPoint
			root.Position = position
			if size then
				root.Size = size
			end
		end,
		setVisible = function(visible: boolean)
			root.Visible = visible
		end,
		destroy = function()
			stopTween()
		end,
	}
end

return CoinDisplayClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">CoinPurchasePopup</string>
            <string name="Source"><![CDATA[--!strict

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ShopCatalog = require(ReplicatedStorage.Shared.ShopCatalog)

local CoinPurchasePopup = {}

local PANEL = Color3.fromRGB(14, 44, 52)
local CARD = Color3.fromRGB(18, 58, 66)
local CARD_HOVER = Color3.fromRGB(24, 72, 82)
local STROKE = Color3.fromRGB(48, 110, 118)
local GOLD = Color3.fromRGB(228, 198, 120)
local HOVER = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function addCorner(parent: GuiObject, scale: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scale, 0)
	c.Parent = parent
end

local function addStroke(parent: GuiObject, color: Color3, thickness: number, transparency: number)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency
	s.Parent = parent
end

function CoinPurchasePopup.create(parent: Instance, zIndex: number?): { toggle: (anchor: GuiObject) -> (), close: () -> () }
	local player = Players.LocalPlayer
	local layer = zIndex or 40

	local popup = Instance.new("Frame")
	popup.Name = "CoinPurchasePopup"
	popup.AnchorPoint = Vector2.new(1, 0)
	popup.Position = UDim2.fromScale(0.905, 0.07)
	popup.Size = UDim2.fromOffset(248, 196)
	popup.BackgroundColor3 = PANEL
	popup.BorderSizePixel = 0
	popup.Visible = false
	popup.ZIndex = layer
	popup.Parent = parent
	addCorner(popup, 0.04)
	addStroke(popup, STROKE, 1, 0.28)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -16, 0, 28)
	title.Position = UDim2.fromOffset(10, 8)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.Text = "GET TOKENS"
	title.TextColor3 = Color3.fromRGB(236, 248, 250)
	title.TextScaled = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.ZIndex = layer + 1
	title.Parent = popup

	local grid = Instance.new("Frame")
	grid.Name = "Grid"
	grid.Position = UDim2.fromOffset(10, 42)
	grid.Size = UDim2.new(1, -20, 1, -52)
	grid.BackgroundTransparency = 1
	grid.ZIndex = layer + 1
	grid.Parent = popup

	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.fromOffset(108, 62)
	gridLayout.CellPadding = UDim2.fromOffset(8, 8)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = grid

	local function tryPurchase(pack: ShopCatalog.CoinPack)
		if pack.productId <= 0 then
			warn("[CoinPurchasePopup] Set Creator Dashboard dev product ID for", pack.id)
			return
		end
		MarketplaceService:PromptProductPurchase(player, pack.productId)
	end

	for i, pack in ShopCatalog.getCoinPacks() do
		local card = Instance.new("TextButton")
		card.Name = pack.id
		card.LayoutOrder = i
		card.BackgroundColor3 = CARD
		card.AutoButtonColor = false
		card.Text = ""
		card.ZIndex = layer + 2
		card.Parent = grid
		addCorner(card, 0.08)
		addStroke(card, STROKE, 1, 0.35)

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 0.55)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.Text = pack.label
		label.TextColor3 = GOLD
		label.TextScaled = true
		label.ZIndex = layer + 3
		label.Parent = card

		local price = Instance.new("TextLabel")
		price.Size = UDim2.new(1, 0, 0.38, 0)
		price.Position = UDim2.fromScale(0, 0.58)
		price.BackgroundTransparency = 1
		price.Font = Enum.Font.Gotham
		price.Text = if pack.robuxPrice and pack.robuxPrice > 0
			then string.format("R$ %d", pack.robuxPrice)
			else "Dev Product"
		price.TextColor3 = Color3.fromRGB(180, 210, 215)
		price.TextScaled = true
		price.ZIndex = layer + 3
		price.Parent = card

		card.MouseEnter:Connect(function()
			TweenService:Create(card, HOVER, { BackgroundColor3 = CARD_HOVER }):Play()
		end)
		card.MouseLeave:Connect(function()
			TweenService:Create(card, HOVER, { BackgroundColor3 = CARD }):Play()
		end)
		card.MouseButton1Click:Connect(function()
			tryPurchase(pack)
		end)
	end

	MarketplaceService.PromptProductPurchaseFinished:Connect(function(purchasedPlayer, productId, purchased)
		if purchasedPlayer ~= player or not purchased then
			return
		end
		for _, pack in ShopCatalog.getCoinPacks() do
			if pack.productId == productId then
				Remotes.getEvent("RefreshPlayerData"):FireServer()
				break
			end
		end
	end)

	local function close()
		popup.Visible = false
	end

	local function toggle(anchor: GuiObject)
		if popup.Visible then
			close()
			return
		end
		local anchorPos = anchor.AbsolutePosition
		local anchorSize = anchor.AbsoluteSize
		local parentPos = popup.Parent and (popup.Parent :: GuiObject).AbsolutePosition or Vector2.zero
		popup.Position = UDim2.fromOffset(
			anchorPos.X - parentPos.X + anchorSize.X,
			anchorPos.Y - parentPos.Y + anchorSize.Y + 6
		)
		popup.Visible = true
	end

	return {
		toggle = toggle,
		close = close,
	}
end

function CoinPurchasePopup.bind(popup: Frame): { toggle: (anchor: GuiObject) -> (), close: () -> () }
	local player = Players.LocalPlayer
	local grid = popup:FindFirstChild("Grid")
	if not grid or not grid:IsA("Frame") then
		error("[CoinPurchasePopup] Missing Grid frame")
	end

	local function tryPurchase(pack: ShopCatalog.CoinPack)
		if pack.productId <= 0 then
			warn("[CoinPurchasePopup] Set Creator Dashboard dev product ID for", pack.id)
			return
		end
		MarketplaceService:PromptProductPurchase(player, pack.productId)
	end

	for i, pack in ShopCatalog.getCoinPacks() do
		local card = grid:FindFirstChild(pack.id)
		if card and card:IsA("TextButton") then
			card.LayoutOrder = i
			card.MouseButton1Click:Connect(function()
				tryPurchase(pack)
			end)
		end
	end

	local title = popup:FindFirstChildWhichIsA("TextLabel")
	if title then
		title.Text = "GET TOKENS"
	end

	local function close()
		popup.Visible = false
	end

	local function toggle(anchor: GuiObject)
		if popup.Visible then
			close()
			return
		end
		local anchorPos = anchor.AbsolutePosition
		local anchorSize = anchor.AbsoluteSize
		local parentPos = popup.Parent and (popup.Parent :: GuiObject).AbsolutePosition or Vector2.zero
		popup.Position = UDim2.fromOffset(
			anchorPos.X - parentPos.X + anchorSize.X,
			anchorPos.Y - parentPos.Y + anchorSize.Y + 6
		)
		popup.Visible = true
	end

	return {
		toggle = toggle,
		close = close,
	}
end

return CoinPurchasePopup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">CombatHud</string>
            <string name="Source"><![CDATA[--!strict
--[[ Top-center status labels with smooth fade in/out. ]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local CombatHud = {}

function CombatHud.init(player: Player)
	local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "CombatHud"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 25
	screenGui.Parent = playerGui

	local function makeTopLabel(name: string, text: string, color: Color3, y: number): TextLabel
		local label = Instance.new("TextLabel")
		label.Name = name
		label.AnchorPoint = Vector2.new(0.5, 0)
		label.Position = UDim2.fromScale(0.5, y)
		label.Size = UDim2.fromScale(0.28, 0.045)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Bangers
		label.Text = text
		label.TextColor3 = color
		label.TextStrokeColor3 = Color3.fromRGB(20, 8, 10)
		label.TextStrokeTransparency = 1
		label.TextScaled = true
		label.TextTransparency = 1
		label.Visible = true
		label.Parent = screenGui

		local textConstraint = Instance.new("UITextSizeConstraint")
		textConstraint.MaxTextSize = 36
		textConstraint.MinTextSize = 14
		textConstraint.Parent = label

		return label
	end

	local combatLabel = makeTopLabel("CombatLabel", "IN COMBAT", Color3.fromRGB(220, 70, 80), 0.09)
	local protectedLabel = makeTopLabel("ProtectedLabel", "PROTECTED", Color3.fromRGB(90, 200, 255), 0.04)

	local function bindFade(label: TextLabel): (boolean) -> ()
		local shown = false
		local activeTween: Tween? = nil
		return function(on: boolean)
			if on == shown then
				return
			end
			shown = on
			if activeTween then
				activeTween:Cancel()
				activeTween = nil
			end
			local goal = { TextTransparency = if on then 0 else 1, TextStrokeTransparency = if on then 0.35 else 1 }
			local info = TweenInfo.new(if on then 0.28 else 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			activeTween = TweenService:Create(label, info, goal)
			activeTween:Play()
		end
	end

	local setCombatVisible = bindFade(combatLabel)
	local setProtectedVisible = bindFade(protectedLabel)

	local function bindCharacter(character: Model)
		local function syncCombat()
			setCombatVisible(character:GetAttribute(GameConstants.IN_COMBAT_ATTRIBUTE) == true)
		end
		local function syncProtected()
			local untilTime = character:GetAttribute(GameConstants.PROTECTED_UNTIL_ATTRIBUTE)
			local on = type(untilTime) == "number" and untilTime > AbilityCooldownHelper.getNow()
			setProtectedVisible(on)
		end
		character:GetAttributeChangedSignal(GameConstants.IN_COMBAT_ATTRIBUTE):Connect(syncCombat)
		character:GetAttributeChangedSignal(GameConstants.PROTECTED_UNTIL_ATTRIBUTE):Connect(syncProtected)
		syncCombat()
		syncProtected()
		task.spawn(function()
			while character.Parent do
				syncProtected()
				task.wait(0.12)
			end
			setProtectedVisible(false)
			setCombatVisible(false)
		end)
	end

	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then
		bindCharacter(player.Character)
	end
end

return CombatHud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">DeathScreenClient</string>
            <string name="Source"><![CDATA[--!strict

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local DeathScreenClient = {}

export type DeathScreenOptions = {
	isPhoenix: boolean?,
	onRevive: (() -> ())?,
}

local DURATION = 5
local CAM_RISE = 0.9
local CAM_HEIGHT_START = 16
local CAM_HEIGHT_END = 3.5
local CAM_BIND = "MCU_DeathCam"
local activeToken = 0
local activeCleanup: ((runComplete: boolean?) -> ())? = nil
local requestStandardCountdown: (() -> ())? = nil

local function findLookTarget(character: Model): BasePart?
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	local upper = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if upper and upper:IsA("BasePart") then
		return upper
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function captureFocus(character: Model): Vector3
	local lookPart = findLookTarget(character)
	if lookPart then
		return lookPart.Position
	end
	local ok, pivot = pcall(function()
		return character:GetPivot().Position
	end)
	if ok then
		return pivot
	end
	return Vector3.new(0, 6, 0)
end

function DeathScreenClient.isActive(): boolean
	return activeCleanup ~= nil
end

function DeathScreenClient.play(character: Model, onComplete: (() -> ())?, options: DeathScreenOptions?)
	if activeCleanup then
		activeToken += 1
		activeCleanup(false)
	end

	activeToken += 1
	local token = activeToken

	local player = Players.LocalPlayer
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		activeToken = 0
		if onComplete then
			onComplete()
		end
		return
	end

	local hidden: { ScreenGui } = {}
	for _, child in playerGui:GetChildren() do
		if child:IsA("ScreenGui") and child.Enabled and child.Name ~= "DeathScreen" then
			child.Enabled = false
			table.insert(hidden, child)
		end
	end

	local existing = playerGui:FindFirstChild("DeathScreen")
	if existing then
		existing:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "DeathScreen"
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 2000
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = playerGui

	local overlay = Instance.new("Frame")
	overlay.Name = "Overlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
	overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0
	overlay.ZIndex = 1
	overlay.Parent = screenGui

	local countdown = Instance.new("TextLabel")
	countdown.Name = "Countdown"
	countdown.AnchorPoint = Vector2.new(0.5, 0.5)
	countdown.Position = UDim2.fromScale(0.5, 0.5)
	countdown.Size = UDim2.fromOffset(220, 180)
	countdown.BackgroundTransparency = 1
	countdown.Font = Enum.Font.GothamBlack
	countdown.TextSize = 110
	countdown.TextColor3 = Color3.fromRGB(235, 235, 240)
	countdown.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	countdown.TextStrokeTransparency = 0.25
	countdown.Text = tostring(DURATION)
	countdown.Visible = options == nil or options.isPhoenix ~= true
	countdown.ZIndex = 3
	countdown.Parent = screenGui

	local reviveBtn: TextButton? = nil
	if options and options.isPhoenix then
		local btn = Instance.new("TextButton")
		btn.Name = "PhoenixRevive"
		btn.AnchorPoint = Vector2.new(0.5, 0.5)
		btn.Position = UDim2.fromScale(0.5, 0.56)
		btn.Size = UDim2.fromOffset(280, 64)
		btn.BackgroundColor3 = Color3.fromRGB(255, 57, 17)
		btn.BorderSizePixel = 0
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 28
		btn.TextColor3 = Color3.fromRGB(255, 240, 228)
		btn.Text = "COME BACK"
		btn.AutoButtonColor = true
		btn.ZIndex = 4
		btn.Parent = screenGui
		reviveBtn = btn

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = btn

		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(255, 140, 95)
		stroke.Thickness = 2
		stroke.Parent = btn
	end

	local corpse = character
	local focusPos = captureFocus(corpse)
	local cam = Workspace.CurrentCamera
	local startCf = if cam then cam.CFrame else CFrame.new(focusPos + Vector3.new(0, 16, 0))
	local riseStart = os.clock()
	local countdownStart = os.clock()
	local zoomT = 0
	local zoomGoal = 0
	local lastCamTick = os.clock()
	local savedCamSubject = if cam then cam.CameraSubject else nil

	local grey = Lighting:FindFirstChild("MCU_DeathGrey")
	if grey then
		grey:Destroy()
	end
	local colorFx = Instance.new("ColorCorrectionEffect")
	colorFx.Name = "MCU_DeathGrey"
	colorFx.Saturation = 0
	colorFx.Contrast = 0
	colorFx.Brightness = 0
	colorFx.Parent = Lighting
	TweenService:Create(colorFx, TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Saturation = -0.92,
		Contrast = -0.1,
		Brightness = -0.08,
	}):Play()

	overlay.BackgroundTransparency = 0.88
	TweenService:Create(overlay, TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0.28,
	}):Play()

	local finished = false
	local camBound = false
	local function stopDeathCam()
		if camBound then
			pcall(function()
				RunService:UnbindFromRenderStep(CAM_BIND)
			end)
			camBound = false
		end
	end
	local function cleanup(runComplete: boolean?)
		if finished then
			return
		end
		finished = true
		activeCleanup = nil
		requestStandardCountdown = nil
		stopDeathCam()
		if colorFx.Parent then
			colorFx:Destroy()
		end
		if screenGui.Parent then
			screenGui:Destroy()
		end
		for _, gui in hidden do
			if gui.Parent then
				gui.Enabled = true
			end
		end
		local liveCam = Workspace.CurrentCamera
		if liveCam then
			liveCam.CameraType = Enum.CameraType.Custom
			local subject = savedCamSubject
			local subjectHumanoid = subject and subject:IsA("Humanoid") and subject
			if subjectHumanoid and subjectHumanoid.Parent and subjectHumanoid.Health > 0 then
				liveCam.CameraSubject = subject
			else
				local spawned = Players.LocalPlayer.Character
				local hum = spawned and spawned:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					liveCam.CameraSubject = hum
				end
			end
		end
		local invokeComplete = runComplete ~= false and token == activeToken
		if token == activeToken then
			activeToken = 0
		end
		if onComplete and invokeComplete then
			onComplete()
		end
	end
	activeCleanup = cleanup

	local phoenixMode = options ~= nil and options.isPhoenix == true
	countdown.Visible = not phoenixMode

	pcall(function()
		RunService:UnbindFromRenderStep(CAM_BIND)
	end)
	RunService:BindToRenderStep(CAM_BIND, Enum.RenderPriority.Last.Value, function()
		if token ~= activeToken or finished then
			return
		end
		local liveCam = Workspace.CurrentCamera
		if not liveCam then
			return
		end
		if corpse.Parent then
			local lookPart = findLookTarget(corpse)
			if lookPart then
				focusPos = lookPart.Position
			end
		end
		liveCam.CameraType = Enum.CameraType.Scriptable
		local now = os.clock()
		local dt = math.clamp(now - lastCamTick, 0, 0.05)
		lastCamTick = now
		if not phoenixMode then
			zoomGoal = math.clamp((now - countdownStart) / DURATION, 0, 1)
		end
		zoomT += (zoomGoal - zoomT) * math.clamp(dt * 2.6, 0, 1)
		local height = CAM_HEIGHT_START + (CAM_HEIGHT_END - CAM_HEIGHT_START) * zoomT
		local target = CFrame.lookAt(focusPos + Vector3.new(0, height, 0), focusPos)
		local alpha = math.clamp((now - riseStart) / CAM_RISE, 0, 1)
		alpha = 1 - (1 - alpha) * (1 - alpha)
		if zoomT > 0.02 then
			liveCam.CFrame = liveCam.CFrame:Lerp(target, math.clamp(dt * 6, 0, 1))
		else
			liveCam.CFrame = startCf:Lerp(target, alpha)
		end
	end)
	camBound = true

	requestStandardCountdown = function()
		phoenixMode = false
		if reviveBtn then
			reviveBtn.Visible = false
		end
		countdown.Visible = true
	end

	if reviveBtn and options and options.onRevive then
		reviveBtn.MouseButton1Click:Connect(function()
			if finished then
				return
			end
			if options.onRevive then
				options.onRevive()
			end
			cleanup(false)
		end)
	end

	task.spawn(function()
		while phoenixMode and token == activeToken and not finished do
			task.wait(0.1)
		end
		if token ~= activeToken or finished then
			return
		end

		countdownStart = os.clock()
		zoomGoal = 0
		zoomT = 0

		local remaining = DURATION
		while remaining > 0 do
			if token ~= activeToken or finished then
				return
			end
			countdown.Text = tostring(remaining)
			task.wait(1)
			remaining -= 1
		end

		if token ~= activeToken or finished then
			return
		end

		TweenService:Create(countdown, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		}):Play()
		task.wait(0.35)
		if token ~= activeToken or finished then
			return
		end
		if onComplete then
			onComplete()
		end
		task.wait(0.25)
		if token ~= activeToken or finished then
			return
		end
		TweenService:Create(overlay, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = 1,
		}):Play()
		if colorFx.Parent then
			TweenService:Create(colorFx, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Saturation = 0,
				Contrast = 0,
				Brightness = 0,
			}):Play()
		end
		task.wait(0.45)
		cleanup()
	end)
end

function DeathScreenClient.notifyBodyGone()
	if requestStandardCountdown then
		requestStandardCountdown()
	end
end

function DeathScreenClient.cancel()
	local cleanupFn = activeCleanup
	if cleanupFn then
		activeToken += 1
		cleanupFn(false)
	end
end

return DeathScreenClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">GameplayHUD</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local AbilityInput = require(script.Parent.AbilityInput)
local ViewportHelper = require(script.Parent.ViewportHelper)
local PlayerDataClient = require(script.Parent.PlayerDataClient)
local ClientSettings = require(script.Parent.ClientSettings)
local GameplayHUDSettings = require(script.Parent.GameplayHUDSettings)
local SettingsUI = require(script.Parent.SettingsUI)
local CoinDisplayClient = require(script.Parent.CoinDisplayClient)
local CoinPurchasePopup = require(script.Parent.CoinPurchasePopup)
local StarterGuiUtil = require(script.Parent.StarterGuiUtil)

export type HudController = {
	show: (heroId: string) -> (),
	hide: () -> (),
	bindCharacter: (character: Model) -> (),
	destroy: () -> (),
}

type AbilitySlot = {
	holder: Frame,
	btn: TextButton,
	nameLabel: TextLabel,
	iconImage: ImageLabel?,
	cooldownOverlay: Frame,
	cooldownLabel: TextLabel,
	abilityId: string?,
	cooldownSeconds: number?,
	suppressActiveEllipsis: boolean?,
}

local BAR_COLORS = {
	Health = Color3.fromRGB(55, 175, 85),
	EnergyScarlet = Color3.fromRGB(200, 55, 65),
	EnergyPhoton = Color3.fromRGB(255, 210, 55),
	Stamina = Color3.fromRGB(220, 185, 55),
}

local THEME_SCARLET = {
	accent = BAR_COLORS.EnergyScarlet,
	keyText = Color3.fromRGB(250, 250, 252),
	btn = Color3.fromRGB(120, 58, 68),
	btnHover = Color3.fromRGB(155, 78, 90),
	stroke = BAR_COLORS.EnergyScarlet,
	modeOn = BAR_COLORS.EnergyScarlet,
	modeOff = Color3.fromRGB(85, 40, 48),
	panel = Color3.fromRGB(36, 18, 22),
	panelTitle = BAR_COLORS.EnergyScarlet,
	barBg = Color3.fromRGB(28, 16, 20),
	viewportBg = Color3.fromRGB(22, 14, 16),
	abilityBar = Color3.fromRGB(32, 18, 22),
	energy = BAR_COLORS.EnergyScarlet,
}

local THEME_MARVEL = {
	accent = Color3.fromRGB(255, 210, 50),
	keyText = Color3.fromRGB(20, 20, 24),
	btn = Color3.fromRGB(42, 32, 8),
