      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">CharacterSelect</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local shared = ReplicatedStorage:WaitForChild("Shared", 30)
if not shared then
	error("[CharacterSelect] ReplicatedStorage.Shared missing.")
end

local characterConfigModule = shared:WaitForChild("CharacterConfig", 10)
local ok, CharacterConfig = pcall(require, characterConfigModule)
if not ok or type(CharacterConfig) ~= "table" then
	error("[CharacterSelect] Failed to require CharacterConfig.")
end

local validChoices: { [string]: boolean } = {}
for _, name in CharacterConfig.Choices do
	validChoices[name] = true
end

local function ensureSelectionRemote(): RemoteEvent
	local folder = ReplicatedStorage:FindFirstChild(CharacterConfig.RemotesFolderName)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = CharacterConfig.RemotesFolderName
		folder.Parent = ReplicatedStorage
	end

	local ev = folder:FindFirstChild(CharacterConfig.SelectionRemoteName)
	if not ev then
		ev = Instance.new("RemoteEvent")
		ev.Name = CharacterConfig.SelectionRemoteName
		ev.Parent = folder
	elseif not ev:IsA("RemoteEvent") then
		error("[CharacterSelect] Selection event must be a RemoteEvent.")
	end

	return ev :: RemoteEvent
end

local selectRemote = ensureSelectionRemote()

local function getOrCreateBillboard(character: Model): BillboardGui?
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return nil
	end

	local existing = head:FindFirstChild("ChosenCharacterBillboard")
	if existing and existing:IsA("BillboardGui") then
		return existing
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ChosenCharacterBillboard"
	billboard.Size = UDim2.new(4.2, 0, 1.3, 0)
	billboard.StudsOffset = Vector3.new(0, 2.8, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 100
	billboard.Parent = head

	local frame = Instance.new("Frame")
	frame.Name = "Container"
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = billboard

	local barBg = Instance.new("Frame")
	barBg.Name = "HealthBarBg"
	barBg.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	barBg.BackgroundTransparency = 0.2
	barBg.BorderSizePixel = 0
	barBg.Size = UDim2.new(1, 0, 0.2, 0)
	barBg.Position = UDim2.new(0, 0, 0, 0)
	barBg.Parent = frame

	local barFill = Instance.new("Frame")
	barFill.Name = "HealthBarFill"
	barFill.BackgroundColor3 = Color3.fromRGB(74, 197, 94)
	barFill.BorderSizePixel = 0
	barFill.Size = UDim2.fromScale(1, 1)
	barFill.Parent = barBg

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(0, 5)
	bgCorner.Parent = barBg

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 5)
	fillCorner.Parent = barFill

	local label = Instance.new("TextLabel")
	label.Name = "InfoText"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0.78, 0)
	label.Position = UDim2.new(0, 0, 0.22, 0)
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextSize = 14
	label.TextWrapped = true
	label.Parent = frame

	return billboard
end

local function updateBillboardText(player: Player, character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local selectedCharacter = player:GetAttribute("ChosenCharacter")
	if type(selectedCharacter) ~= "string" then
		selectedCharacter = "Unknown"
	end

	local billboard = getOrCreateBillboard(character)
	if not billboard then
		return
	end

	local container = billboard:FindFirstChild("Container")
	if not container or not container:IsA("Frame") then
		return
	end
	local label = container:FindFirstChild("InfoText")
	if not label or not label:IsA("TextLabel") then
		return
	end
	local barBg = container:FindFirstChild("HealthBarBg")
	if barBg and barBg:IsA("Frame") then
		local barFill = barBg:FindFirstChild("HealthBarFill")
		if barFill and barFill:IsA("Frame") then
			local maxHealth = math.max(humanoid.MaxHealth, 1)
			local ratio = math.clamp(humanoid.Health / maxHealth, 0, 1)
			barFill.Size = UDim2.fromScale(ratio, 1)
		end
	end

	label.Text = string.format("%s  |  %s", selectedCharacter, player.Name)
end

local healthConnections: { [Player]: RBXScriptConnection } = {}

local function clearHealthConnection(player: Player)
	local conn = healthConnections[player]
	if conn then
		conn:Disconnect()
		healthConnections[player] = nil
	end
end

local function cleanupCharacterUi(character: Model)
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		local billboard = head:FindFirstChild("ChosenCharacterBillboard")
		if billboard then
			billboard:Destroy()
		end
	end
end

local function applySelectionToCharacter(player: Player, character: Model)
	local chosen = player:GetAttribute("ChosenCharacter")
	if type(chosen) ~= "string" then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	character:SetAttribute("ChosenCharacter", chosen)
	player:SetAttribute("Energy", CharacterConfig.DefaultEnergy)
	character:SetAttribute("Energy", CharacterConfig.DefaultEnergy)

	updateBillboardText(player, character)
	clearHealthConnection(player)
	healthConnections[player] = humanoid.HealthChanged:Connect(function()
		updateBillboardText(player, character)
	end)
end

selectRemote.OnServerEvent:Connect(function(player: Player, characterName: string)
	if type(characterName) ~= "string" or not validChoices[characterName] then
		return
	end

	player:SetAttribute("ChosenCharacter", characterName)
	if player:GetAttribute("Energy") == nil then
		player:SetAttribute("Energy", CharacterConfig.DefaultEnergy)
	end

	local character = player.Character
	if character then
		applySelectionToCharacter(player, character)
	end
end)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		task.wait(0.2)
		applySelectionToCharacter(player, character)
	end)

	player.CharacterRemoving:Connect(function(character)
		clearHealthConnection(player)
		cleanupCharacterUi(character)
		player:SetAttribute("ChosenCharacter", nil)
		player:SetAttribute("Energy", CharacterConfig.DefaultEnergy)
	end)
end)

for _, player in Players:GetPlayers() do
	player.CharacterAdded:Connect(function(character)
		task.wait(0.2)
		applySelectionToCharacter(player, character)
	end)

	player.CharacterRemoving:Connect(function(character)
		clearHealthConnection(player)
		cleanupCharacterUi(character)
		player:SetAttribute("ChosenCharacter", nil)
		player:SetAttribute("Energy", CharacterConfig.DefaultEnergy)
	end)
end

Players.PlayerRemoving:Connect(function(player)
	clearHealthConnection(player)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">RagdollHandler</string>
          <string name="Source"><![CDATA[local PhysicsService = game:GetService("PhysicsService")

local module = {}
local RAGDOLL_COLLISION_GROUP = "RagdollCharacter"
local ORIGINAL_COLLISION_GROUP_ATTR = "RagdollOriginalCollisionGroup"
local ORIGINAL_CAN_COLLIDE_ATTR = "RagdollOrigCanCollide"

local function ensureRagdollCollisionGroup()
	local hasGroup = false
	local ok, result = pcall(function()
		return PhysicsService:IsCollisionGroupRegistered(RAGDOLL_COLLISION_GROUP)
	end)
	if ok then
		hasGroup = result == true
	end
	if not hasGroup then
		pcall(function()
			PhysicsService:RegisterCollisionGroup(RAGDOLL_COLLISION_GROUP)
		end)
	end
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(RAGDOLL_COLLISION_GROUP, RAGDOLL_COLLISION_GROUP, false)
	end)
end

local function clampAssemblyVelocity(part: BasePart)
	local linear = part.AssemblyLinearVelocity
	local linearMagnitude = linear.Magnitude
	if linearMagnitude > 90 then
		part.AssemblyLinearVelocity = linear.Unit * 90
	end

	local angular = part.AssemblyAngularVelocity
	local angularMagnitude = angular.Magnitude
	if angularMagnitude > 35 then
		part.AssemblyAngularVelocity = angular.Unit * 35
	end
end

local function saveOriginalCanCollide(part: BasePart)
	if part:GetAttribute(ORIGINAL_CAN_COLLIDE_ATTR) == nil then
		part:SetAttribute(ORIGINAL_CAN_COLLIDE_ATTR, part.CanCollide)
	end
end

local function restoreOriginalCanCollide(part: BasePart)
	local orig = part:GetAttribute(ORIGINAL_CAN_COLLIDE_ATTR)
	if typeof(orig) == "boolean" then
		part.CanCollide = orig
		part:SetAttribute(ORIGINAL_CAN_COLLIDE_ATTR, nil)
	end
end

type RagdollEnableOpts = {
	skipVelocityClamp: boolean?,
}

local function setRagdollEnabled(humanoid: Humanoid, isEnabled: boolean, opts: RagdollEnableOpts?)
	local character = humanoid.Parent
	if not character then
		return
	end

	local skipClamp = opts and opts.skipVelocityClamp == true
	local rootPart = character:FindFirstChild("HumanoidRootPart")

	-- Collision: only override while ragdoll is active. When disabling, restore saved values.
	-- (Previously HRP was always CanCollide=false and "off" zeroed all limbs — NPCs lost floor collision.)
	if isEnabled then
		if rootPart and rootPart:IsA("BasePart") then
			saveOriginalCanCollide(rootPart)
			rootPart.CanCollide = false
		end
		for _, inst in ipairs(character:GetDescendants()) do
			if inst:IsA("BasePart") and inst.Name ~= "HumanoidRootPart" then
				local isAccessoryHandle = inst.Parent and inst.Parent:IsA("Accessory")
				if isAccessoryHandle then
					saveOriginalCanCollide(inst)
					inst.CanCollide = false
				else
					saveOriginalCanCollide(inst)
					inst.CanCollide = true
					if inst:GetAttribute(ORIGINAL_COLLISION_GROUP_ATTR) == nil then
						inst:SetAttribute(ORIGINAL_COLLISION_GROUP_ATTR, inst.CollisionGroup)
					end
					inst.CollisionGroup = RAGDOLL_COLLISION_GROUP
					if not skipClamp then
						clampAssemblyVelocity(inst)
					end
				end
			end
		end
	else
		if rootPart and rootPart:IsA("BasePart") then
			restoreOriginalCanCollide(rootPart)
		end
		for _, inst in ipairs(character:GetDescendants()) do
			if inst:IsA("BasePart") and inst.Name ~= "HumanoidRootPart" then
				local isAccessoryHandle = inst.Parent and inst.Parent:IsA("Accessory")
				if isAccessoryHandle then
					restoreOriginalCanCollide(inst)
				else
					restoreOriginalCanCollide(inst)
					local original = inst:GetAttribute(ORIGINAL_COLLISION_GROUP_ATTR)
					if typeof(original) == "string" and original ~= "" then
						inst.CollisionGroup = original
						inst:SetAttribute(ORIGINAL_COLLISION_GROUP_ATTR, nil)
					end
				end
			end
		end
	end

	local ragdollConstraints = character:FindFirstChild("RagdollConstraints")
	if ragdollConstraints then
		for _, constraint in pairs(ragdollConstraints:GetChildren()) do
			if constraint:IsA("Constraint") then
				local rigidPointer = constraint:FindFirstChild("RigidJoint")
				local rigidJoint = rigidPointer and rigidPointer:IsA("ObjectValue") and rigidPointer.Value
				if rigidJoint and rigidJoint:IsA("Motor6D") then
					local expected = (not isEnabled) and constraint.Attachment1 and constraint.Attachment1.Parent or nil
					if rigidJoint.Part1 ~= expected then
						rigidJoint.Part1 = expected
					end
				end
			end
		end
	end
end

local function keepRagdollActiveLightweight(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end
	local ragdollConstraints = character:FindFirstChild("RagdollConstraints")
	if ragdollConstraints then
		for _, constraint in pairs(ragdollConstraints:GetChildren()) do
			if constraint:IsA("Constraint") then
				local rigidPointer = constraint:FindFirstChild("RigidJoint")
				local rigidJoint = rigidPointer and rigidPointer:IsA("ObjectValue") and rigidPointer.Value
				if rigidJoint and rigidJoint:IsA("Motor6D") then
					if rigidJoint.Part1 ~= nil then
						rigidJoint.Part1 = nil
					end
				end
			end
		end
	end
end

--[[ True if any ragdoll Motor6D is still welded (embedded AI/scripts reconnected Part1 after physics). ]]
function module:AnyRagdollMotorWelded(humanoid: Humanoid): boolean
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return false
	end
	local ragdollConstraints = character:FindFirstChild("RagdollConstraints")
	if not ragdollConstraints then
		return false
	end
	for _, constraint in pairs(ragdollConstraints:GetChildren()) do
		if constraint:IsA("Constraint") then
			local rigidPointer = constraint:FindFirstChild("RigidJoint")
			local rigidJoint = rigidPointer and rigidPointer:IsA("ObjectValue") and rigidPointer.Value
			if rigidJoint and rigidJoint:IsA("Motor6D") and rigidJoint.Part1 ~= nil then
				return true
			end
		end
	end
	return false
end

--[[ After physics: only disconnect constraint motors + keep Humanoid in Physics (no full descendant scan). ]]
function module:MaintainNpcRagdollAfterPhysics(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end
	if character:GetAttribute("Ragdolled") ~= true or humanoid.Health <= 0 then
		return
	end
	local st = humanoid:GetState()
	if st ~= Enum.HumanoidStateType.Physics and st ~= Enum.HumanoidStateType.Dead then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end
	humanoid.PlatformStand = false
	humanoid.RequiresNeck = false
	keepRagdollActiveLightweight(humanoid)
end

function module:ManualRagdoll(humanoid: Humanoid, isEnabled: boolean)
	if isEnabled then
		-- Prevent instant death when neck Motor6D is temporarily disconnected.
		humanoid.RequiresNeck = false
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	else
		humanoid.RequiresNeck = true
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	setRagdollEnabled(humanoid, isEnabled, nil)
end

--[[
	While Ragdolled status is active, collisions/state can still kick the Humanoid out of Physics.
	Call from Heartbeat — skips velocity clamp so we don't damp the ragdoll every frame.
]]
function module:MaintainStatusRagdoll(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end
	if character:GetAttribute("Ragdolled") ~= true or humanoid.Health <= 0 then
		return
	end
	local st = humanoid:GetState()
	if st ~= Enum.HumanoidStateType.Physics and st ~= Enum.HumanoidStateType.Dead then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end
	humanoid.PlatformStand = false
	humanoid.RequiresNeck = false
	keepRagdollActiveLightweight(humanoid)
end

--[[
	NPCs: embedded server Scripts / Animator can re-weld Motor6Ds after physics. Re-apply full ragdoll
	collision + joint disconnect (skip velocity clamp). Call after physics / deferred.
]]
function module:MaintainNpcRagdollHard(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end
	if character:GetAttribute("Ragdolled") ~= true or humanoid.Health <= 0 then
		return
	end
	local st = humanoid:GetState()
	if st ~= Enum.HumanoidStateType.Physics and st ~= Enum.HumanoidStateType.Dead then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end
	humanoid.PlatformStand = false
	humanoid.RequiresNeck = false
	setRagdollEnabled(humanoid, true, { skipVelocityClamp = true })
end

function module:ragdollAdded(humanoid: Humanoid)
	if not humanoid then
		return
	end
	ensureRagdollCollisionGroup()
	-- Do NOT use Humanoid.StateChanged to drive ragdoll on/off: contact/state churn calls it with
	-- non-Physics states and was disabling constraint ragdoll while Ragdolled stayed true.
end

function module:ragdollRemoved(humanoid: Humanoid)
	-- kept for API symmetry
end

return module
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">buildCollisionFilters</string>
            <string name="Source"><![CDATA[return function(attachmentMap, characterRoot: BasePart?)
	local folder = Instance.new("Folder")
	folder.Name = "NoCollisionConstraints"
	if not characterRoot then
		return folder
	end

	local seen = {}
	local function pairKey(a: BasePart, b: BasePart): string
		local aPath = a:GetFullName()
		local bPath = b:GetFullName()
		if aPath < bPath then
			return aPath .. "|" .. bPath
		end
		return bPath .. "|" .. aPath
	end
	for _, jointData in pairs(attachmentMap) do
		local p0 = jointData.Attachment0 and jointData.Attachment0.Parent
		local p1 = jointData.Attachment1 and jointData.Attachment1.Parent
		if p0 and p1 and p0:IsA("BasePart") and p1:IsA("BasePart") and p0 ~= p1 then
			local key = pairKey(p0, p1)
			if not seen[key] then
				seen[key] = true
				local ncc = Instance.new("NoCollisionConstraint")
				ncc.Name = p0.Name .. "<->" .. p1.Name
				ncc.Part0 = p0
				ncc.Part1 = p1
				ncc.Parent = folder
			end
		end
	end

	return folder
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">buildConstraints</string>
            <string name="Source"><![CDATA[local getLastWordFromPascalCase = require(script.Parent:WaitForChild("getLastWordFromPascalCase"))

local function makeHinge(lower: number, upper: number, restitution: number): HingeConstraint
	local h = Instance.new("HingeConstraint")
	h.LimitsEnabled = true
	h.LowerAngle = lower
	h.UpperAngle = upper
	h.Restitution = restitution
	h.Radius = 0.15
	return h
end

local function makeBall(upper: number, twistLower: number, twistUpper: number): BallSocketConstraint
	local b = Instance.new("BallSocketConstraint")
	b.LimitsEnabled = true
	b.TwistLimitsEnabled = true
	b.UpperAngle = upper
	b.TwistLowerAngle = twistLower
	b.TwistUpperAngle = twistUpper
	return b
end

local function constraintTemplateForJoint(jointName: string): Constraint
	local jointType = getLastWordFromPascalCase(jointName)
	if jointType == "Ankle" then
		return makeHinge(-45, 0, 0)
	elseif jointType == "Elbow" then
		return makeHinge(0, 135, 0)
	elseif jointType == "Knee" then
		return makeHinge(-135, -10, 0)
	elseif jointType == "Wrist" then
		return makeHinge(-20, 20, 0)
	elseif jointType == "Hip" then
		return makeBall(40, -3, 3)
	elseif jointType == "Neck" then
		return makeBall(0, -45, 45)
	elseif jointType == "Shoulder" then
		return makeBall(30, -30, 30)
	elseif jointType == "Waist" then
		return makeBall(15, -1, 1)
	end
	return makeBall(20, -15, 15)
end

local function createConstraint(jointData)
	local joint = jointData.Joint
	local constraint = constraintTemplateForJoint(joint.Name)
	constraint.Attachment0 = jointData.Attachment0
	constraint.Attachment1 = jointData.Attachment1
	constraint.Name = getLastWordFromPascalCase(joint.Name) .. "RagdollConstraint"

	local rigidPointer = Instance.new("ObjectValue")
	rigidPointer.Name = "RigidJoint"
	rigidPointer.Value = joint
	rigidPointer.Parent = constraint
	return constraint
end

return function(attachmentMap)
	local ragdollConstraints = Instance.new("Folder")
	ragdollConstraints.Name = "RagdollConstraints"

	for _, jointData in pairs(attachmentMap) do
		if jointData.Joint.Name ~= "Root" then
			createConstraint(jointData).Parent = ragdollConstraints
		end
	end
	return ragdollConstraints
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">buildRagdoll</string>
            <string name="Source"><![CDATA[local buildConstraints = require(script.Parent:WaitForChild("buildConstraints"))
local buildCollisionFilters = require(script.Parent:WaitForChild("buildCollisionFilters"))
local AUTO_ATTACHMENT_PREFIX = "__RagdollAutoAttachment_"

local function clearAutoAttachments(character: Model)
	for _, inst in ipairs(character:GetDescendants()) do
		if inst:IsA("Attachment") and string.sub(inst.Name, 1, #AUTO_ATTACHMENT_PREFIX) == AUTO_ATTACHMENT_PREFIX then
			inst:Destroy()
		end
	end
end

local function buildAttachmentMap(character: Model)
	local attachmentMap = {}
	local handledJoints: { [Motor6D]: boolean } = {}

	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			for _, attachment in pairs(part:GetChildren()) do
				if attachment:IsA("Attachment") then
					local jointName = attachment.Name:match("^(.+)RigAttachment$")
					local joint = jointName and attachment.Parent:FindFirstChild(jointName) or nil
					if joint and joint:IsA("Motor6D") and joint.Part0 and joint.Part1 then
						local a0 = joint.Part0:FindFirstChild(attachment.Name)
						local a1 = joint.Part1:FindFirstChild(attachment.Name)
						if a0 and a1 and a0:IsA("Attachment") and a1:IsA("Attachment") then
							attachmentMap[attachment.Name] = {
								Joint = joint,
								Attachment0 = a0,
								Attachment1 = a1,
							}
							handledJoints[joint] = true
						end
					end
				end
			end
		end
	end

	-- Fallback for NPC/custom rigs without RigAttachments: synthesize attachments from Motor6D C0/C1.
	for _, inst in ipairs(character:GetDescendants()) do
		if inst:IsA("Motor6D") and inst.Part0 and inst.Part1 and not handledJoints[inst] then
			local key = AUTO_ATTACHMENT_PREFIX .. inst:GetFullName()
			local a0Name = AUTO_ATTACHMENT_PREFIX .. inst.Name
			local a1Name = AUTO_ATTACHMENT_PREFIX .. inst.Name

			local a0 = inst.Part0:FindFirstChild(a0Name)
			if not (a0 and a0:IsA("Attachment")) then
				a0 = Instance.new("Attachment")
				a0.Name = a0Name
				a0.Parent = inst.Part0
			end
			a0.CFrame = inst.C0

			local a1 = inst.Part1:FindFirstChild(a1Name)
			if not (a1 and a1:IsA("Attachment")) then
				a1 = Instance.new("Attachment")
				a1.Name = a1Name
				a1.Parent = inst.Part1
			end
			a1.CFrame = inst.C1

			attachmentMap[key] = {
				Joint = inst,
				Attachment0 = a0,
				Attachment1 = a1,
			}
		end
	end
	return attachmentMap
end

return function(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end

	humanoid.BreakJointsOnDeath = false

	local old = character:FindFirstChild("RagdollConstraints")
	if old then
		old:Destroy()
	end
	clearAutoAttachments(character)

	local attachmentMap = buildAttachmentMap(character)
	local ragdollConstraints = buildConstraints(attachmentMap)
	local collisionFilters = buildCollisionFilters(attachmentMap, character.PrimaryPart)
	collisionFilters.Parent = ragdollConstraints
	ragdollConstraints.Parent = character
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">getLastWordFromPascalCase</string>
            <string name="Source"><![CDATA[local function getLastWordFromPascalCase(value: string): string
	local words = {}
	for word in string.gmatch(value, "%u[%l%d]*") do
		table.insert(words, word)
	end
	if #words == 0 then
		return value
	end
	return words[#words]
end

return getLastWordFromPascalCase
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">RagdollService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Living "Ragdolled" status (abilities, TK, Crystal, etc.) drives the constraint ragdoll.
	On death, main.server sets Ragdolled = true with BreakJointsOnDeath = false — we apply the same
	physics ragdoll once so the body collapses instead of staying in T-pose.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ragdollHandlerFolder = script.Parent:WaitForChild("RagdollHandler")
local BuildRagdoll = require(ragdollHandlerFolder:WaitForChild("buildRagdoll"))
local RagdollHandler = require(ragdollHandlerFolder)

local ragdollVisualLast: { [Model]: boolean? } = {}
local ragdollAttrConns: { [Model]: RBXScriptConnection } = {}
local npcDescendantScriptConns: { [Model]: RBXScriptConnection } = {}
local npcLastAnimatorStop: { [Model]: number } = {}

local SCRIPT_WAS_ENABLED_ATTR = "RagdollNpcScriptWasEnabled"
local NPC_ANIMATOR_STOP_INTERVAL = 0.4

local function stopNpcAnimatorTracks(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	for _, track in animator:GetPlayingAnimationTracks() do
		pcall(function()
			track:Stop(0)
		end)
	end
end

-- NPC models often include server Scripts that reset Motor6D / pose on contact; suspend while Ragdolled.
local function suspendNpcServerScripts(character: Model)
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Script") and d:GetAttribute("RagdollNeverSuspend") ~= true then
			if d:GetAttribute(SCRIPT_WAS_ENABLED_ATTR) == nil then
				d:SetAttribute(SCRIPT_WAS_ENABLED_ATTR, d.Enabled)
				d.Enabled = false
			end
		end
	end
end

local function resumeNpcServerScripts(character: Model)
	if not character.Parent then
		return
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("Script") then
			local was = d:GetAttribute(SCRIPT_WAS_ENABLED_ATTR)
			if typeof(was) == "boolean" then
				d.Enabled = was
				d:SetAttribute(SCRIPT_WAS_ENABLED_ATTR, nil)
			end
		end
	end
end

local function suspendOneNpcScriptIfNeeded(scriptInst: Script)
	if scriptInst:GetAttribute("RagdollNeverSuspend") == true then
		return
	end
	if scriptInst:GetAttribute(SCRIPT_WAS_ENABLED_ATTR) ~= nil then
		return
	end
	scriptInst:SetAttribute(SCRIPT_WAS_ENABLED_ATTR, scriptInst.Enabled)
	scriptInst.Enabled = false
end

-- Catch scripts spawned after ragdoll starts (no full GetDescendants every frame).
local function startNpcScriptDescendantWatcher(character: Model)
	if npcDescendantScriptConns[character] then
		return
	end
	npcDescendantScriptConns[character] = character.DescendantAdded:Connect(function(inst)
		if character:GetAttribute("Ragdolled") ~= true then
			return
		end
		if inst:IsA("Script") then
			suspendOneNpcScriptIfNeeded(inst)
		end
	end)
end

local function stopNpcScriptDescendantWatcher(character: Model)
	local c = npcDescendantScriptConns[character]
	if c then
		c:Disconnect()
		npcDescendantScriptConns[character] = nil
	end
end

local function setServerOwnership(character: Model, owner: Player?)
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function()
				d:SetNetworkOwner(owner)
			end)
		end
	end
end

local function ensureRagdollBuilt(humanoid: Humanoid)
	local character = humanoid.Parent
	if not character or not character:IsA("Model") then
		return
	end
	if character:FindFirstChild("RagdollConstraints") then
		return
	end
	BuildRagdoll(humanoid)
	RagdollHandler:ragdollAdded(humanoid)
end

local function syncPhysicsRagdollFromRagdolledAttribute(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local want = character:GetAttribute("Ragdolled") == true
	-- No work when dead and not marked ragdolled (corpse cleanup / unrelated attribute churn).
	if humanoid.Health <= 0 and not want then
		return
	end
	if ragdollVisualLast[character] == want then
		return
	end
	ragdollVisualLast[character] = want

	ensureRagdollBuilt(humanoid)

	if want then
		local plr = Players:GetPlayerFromCharacter(character)
		if plr then
			setServerOwnership(character, nil)
		else
			suspendNpcServerScripts(character)
			startNpcScriptDescendantWatcher(character)
			stopNpcAnimatorTracks(humanoid)
			npcLastAnimatorStop[character] = nil
			-- Humanoid can leave Physics / try to stand on limb contact; block until Ragdolled clears.
			pcall(function()
				humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
			end)
		end
		RagdollHandler:ManualRagdoll(humanoid, true)
	else
		RagdollHandler:ManualRagdoll(humanoid, false)
		local plr = Players:GetPlayerFromCharacter(character)
		if plr then
			setServerOwnership(character, plr)
		else
			stopNpcScriptDescendantWatcher(character)
			resumeNpcServerScripts(character)
			npcLastAnimatorStop[character] = nil
			pcall(function()
				humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
			end)
		end
	end
end

local function bindRagdolledAttributeSync(character: Model)
	if ragdollAttrConns[character] then
		ragdollAttrConns[character]:Disconnect()
		ragdollAttrConns[character] = nil
	end
	ragdollAttrConns[character] = character:GetAttributeChangedSignal("Ragdolled"):Connect(function()
		syncPhysicsRagdollFromRagdolledAttribute(character)
	end)
	syncPhysicsRagdollFromRagdolledAttribute(character)
end

local function disconnectRagdoll(character: Model)
	stopNpcScriptDescendantWatcher(character)
	resumeNpcServerScripts(character)
	npcLastAnimatorStop[character] = nil
	local conn = ragdollAttrConns[character]
	if conn then
		conn:Disconnect()
		ragdollAttrConns[character] = nil
	end
	ragdollVisualLast[character] = nil
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and Players:GetPlayerFromCharacter(character) == nil then
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
		end)
	end
	if humanoid then
		RagdollHandler:ragdollRemoved(humanoid)
	end
end

local function setupRagdoll(character: Model)
	if ragdollAttrConns[character] then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if not humanoid then
		return
	end
	BuildRagdoll(humanoid)
	RagdollHandler:ragdollAdded(humanoid)
	bindRagdolledAttributeSync(character)
	humanoid.Died:Connect(function()
		character:SetAttribute("Ragdolled", true)
	end)
	character.Destroying:Once(function()
		disconnectRagdoll(character)
	end)
end

local function bindPlayerRagdoll(player: Player)
	player.CharacterAdded:Connect(function(character)
		setupRagdoll(character)
	end)
	player.CharacterRemoving:Connect(function(character)
		disconnectRagdoll(character)
	end)
	if player.Character then
		setupRagdoll(player.Character)
	end
end

Players.PlayerAdded:Connect(bindPlayerRagdoll)
for _, player in ipairs(Players:GetPlayers()) do
	bindPlayerRagdoll(player)
end

-- NPCs / non-player models in Workspace that receive Ragdolled from abilities
local function trySetupWorkspaceCharacter(model: Model)
	if Players:GetPlayerFromCharacter(model) then
		return
	end
	setupRagdoll(model)
end

for _, inst in ipairs(Workspace:GetDescendants()) do
	if inst:IsA("Humanoid") then
		local parent = inst.Parent
		if parent and parent:IsA("Model") then
			trySetupWorkspaceCharacter(parent)
		end
	end
end

Workspace.DescendantAdded:Connect(function(inst)
	if inst:IsA("Humanoid") then
		local parent = inst.Parent
		if parent and parent:IsA("Model") then
			trySetupWorkspaceCharacter(parent)
		end
	end
end)

for _, character in ipairs(CollectionService:GetTagged("TestCharacter")) do
	if character:IsA("Model") then
		setupRagdoll(character)
	end
end

CollectionService:GetInstanceAddedSignal("TestCharacter"):Connect(function(character)
	if character:IsA("Model") then
		setupRagdoll(character)
	end
end)

local postSimOk, postSimEvent = pcall(function()
	return (RunService :: any).PostSimulation
end)

RunService.Heartbeat:Connect(function()
	for character, _ in pairs(ragdollAttrConns) do
		if not character.Parent then
			continue
		end
		if character:GetAttribute("Ragdolled") ~= true then
			continue
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or not humanoid.Parent or humanoid.Health <= 0 then
			continue
		end
		-- NPCs: lightweight maintain runs on PostSimulation (after physics). Heartbeat here would duplicate work and miss touch re-welds.
		if postSimOk and postSimEvent and Players:GetPlayerFromCharacter(character) == nil then
			continue
		end
		RagdollHandler:MaintainStatusRagdoll(humanoid)
	end
end)

-- NPCs: dedicated simplified ragdoll mode. Keep joints disconnected + Physics every step.
if postSimOk and postSimEvent then
	postSimEvent:Connect(function()
		local now = tick()
		for character, _ in pairs(ragdollAttrConns) do
			if not character.Parent then
				continue
			end
			if Players:GetPlayerFromCharacter(character) ~= nil then
				continue
			end
			if character:GetAttribute("Ragdolled") ~= true then
				continue
			end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not humanoid or not humanoid.Parent or humanoid.Health <= 0 then
				continue
			end
			RagdollHandler:MaintainNpcRagdollAfterPhysics(humanoid)

			local lastAnim = npcLastAnimatorStop[character]
			if lastAnim == nil or now - lastAnim >= NPC_ANIMATOR_STOP_INTERVAL then
				npcLastAnimatorStop[character] = now
				stopNpcAnimatorTracks(humanoid)
			end
		end
	end)
end
]]></string>
        </Properties>
      </Item>
    </Item>
