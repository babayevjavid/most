		speed = GameConstants.DAGGER_BOMB_SPEED,
		damage = GameConstants.DAGGER_BOMB_DAMAGE,
		healAmount = GameConstants.DAGGER_BOMB_HEAL,
		radius = GameConstants.DAGGER_BOMB_HIT_RADIUS,
		maxDistance = GameConstants.DAGGER_BOMB_RANGE,
		owner = character,
		color = daggerColor(),
		homeDir = homeDir,
		homePoint = aimPoint or (origin + homeDir * math.min(60, GameConstants.DAGGER_BOMB_RANGE * 0.7)),
		homeAfter = 0,
		seekUntilClose = true,
		seekCloseDistance = 2.4,
		boltFolder = "Dagger",
		boltAsset = "RadiantBomb",
		impactAoeRadius = aoeR,
		impactAoeDamage = GameConstants.DAGGER_BOMB_DAMAGE,
		impactFx = "dagger_light",
		ragdollOnHit = GameConstants.DAGGER_BOMB_RAGDOLL,
		pushOnHit = true,
		pushSpeed = GameConstants.DAGGER_BOMB_PUSH_SPEED,
		pushUp = GameConstants.DAGGER_BOMB_PUSH_UP,
		shouldHeal = isAllyModel,
		onImpact = function(pos: Vector3)
			shakePlayersNear(pos, aoeR, 0.7, 0.4)
		end,
	})

	finishAbility(character, entry.id, GameConstants.DAGGER_BOMB_COOLDOWN)
end

local function clearLightVeil(target: Model)
	local existing = target:FindFirstChild("DaggerLightVeilHighlight")
	if existing then
		existing:Destroy()
	end
	target:SetAttribute(GameConstants.DAGGER_VEIL_ATTRIBUTE, nil)
	-- PARTICLE_PLACEHOLDER: remove LightVeil body particles on target
end

local function applyLightVeilBuff(target: Model)
	local hum = CombatHelper.getHumanoid(target)
	if not hum or hum.Health <= 0 then
		return
	end
	clearLightVeil(target)

	local hl = Instance.new("Highlight")
	hl.Name = "DaggerLightVeilHighlight"
	hl.FillColor = Color3.fromRGB(255, 255, 255)
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = 0.65
	hl.OutlineTransparency = 0.15
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = target
	hl.Parent = target

	target:SetAttribute(GameConstants.DAGGER_VEIL_ATTRIBUTE, true)
	-- PARTICLE_PLACEHOLDER: LightVeil wrap particles on target (white)

	local token = (veilTokenByModel[target] or 0) + 1
	veilTokenByModel[target] = token
	task.delay(GameConstants.DAGGER_VEIL_DURATION, function()
		if veilTokenByModel[target] ~= token then
			return
		end
		if target.Parent then
			clearLightVeil(target)
		end
		veilTokenByModel[target] = nil
	end)
end

local function castLightVeil(player: Player, direction: Vector3, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("dagger", "light_veil")
	if not entry or not canUse(character, entry.id, GameConstants.DAGGER_VEIL_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	local homeDir = resolveAimDir(character, direction, aimPoint)
	local hand = getHand(character, true)
	local origin = if hand then hand.Position else character:GetPivot().Position
	-- PARTICLE_PLACEHOLDER: LightVeil cast flash (hand)
	VfxHelper.castHandFlash(origin, daggerColor())

	ProjectileHelper.spawn(origin, homeDir, {
		speed = GameConstants.DAGGER_VEIL_SPEED,
		damage = 0,
		healAmount = 0,
		radius = GameConstants.DAGGER_VEIL_HIT_RADIUS,
		maxDistance = GameConstants.DAGGER_VEIL_RANGE,
		owner = character,
		color = daggerColor(),
		homeDir = homeDir,
		homePoint = aimPoint or (origin + homeDir * 55),
		homeAfter = 0,
		seekUntilClose = false,
		boltFolder = "Dagger",
		boltAsset = "LightDagger",
		impactFx = "none",
		-- Treat hit as buff path (no damage); veil applied in onHit
		shouldHeal = function(_owner: Model, _victim: Model)
			return true
		end,
		onHit = function(victim: Model, _hitPos: Vector3)
			applyLightVeilBuff(victim)
		end,
	})

	finishAbility(character, entry.id, GameConstants.DAGGER_VEIL_COOLDOWN)
end

local function getDaggerAttachmentAsset(assetName: string): Attachment?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local dagger = assets and assets:FindFirstChild("Dagger")
	local inst = dagger and dagger:FindFirstChild(assetName)
	if inst and inst:IsA("Attachment") then
		return inst
	end
	if inst then
		local nested = inst:FindFirstChildWhichIsA("Attachment", true)
		if nested then
			return nested
		end
	end
	return nil
end

--[[ Clone attachment onto a BasePart already in Workspace, enable + immediate Emit. ]]
local function attachAndEmitDaggerFx(host: BasePart, assetName: string, emitCount: number?): Attachment?
	local template = getDaggerAttachmentAsset(assetName)
	if not template then
		warn("[DaggerService] Missing ReplicatedStorage.Assets.Dagger." .. assetName)
		return nil
	end
	local att = template:Clone()
	att.Name = assetName
	att.Position = Vector3.zero
	att.Orientation = Vector3.zero
	att.Parent = host
	VfxHelper.tintParticles(att, daggerColor())
	VfxHelper.setParticlesEnabled(att, true)
	VfxHelper.emitAllParticles(att, emitCount or 14)
	return att
end

--[[ Charge rises smoothly from character position into the air. ]]
local function spawnRisingCharge(character: Model, player: Player): (BasePart?, Vector3)
	local root = getRoot(character)
	local startPos = if root then root.Position else character:GetPivot().Position
	local endPos = startPos + Vector3.new(0, GameConstants.DAGGER_FLASH_CHARGE_RISE, 0)

	local host = Instance.new("Part")
	host.Name = "DaggerFlashChargeHost"
	host.Size = Vector3.new(0.3, 0.3, 0.3)
	host.Transparency = 1
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.CastShadow = false
	host.CFrame = CFrame.new(startPos)
	host:SetAttribute("OwnerUserId", player.UserId)
	host.Parent = Workspace

	attachAndEmitDaggerFx(host, "Charge", 16)
	TweenService:Create(
		host,
		TweenInfo.new(GameConstants.DAGGER_FLASH_CHARGE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = CFrame.new(endPos) }
	):Play()

	return host, endPos
end

local function fadeDestroyAttachment(att: Attachment?, fade: number?, deleteAfter: number?)
	if not att or not att.Parent then
		return
	end
	VfxHelper.fadeOutAndDestroyParticles({ att }, fade or 0.45, deleteAfter or 1.25)
end

--[[ Face the burst and get shoved outward — no damage / ragdoll. ]]
local function applyFlashStruggle(victim: Model, burstPos: Vector3)
	local vRoot = getRoot(victim)
	local hum = CombatHelper.getHumanoid(victim)
	if not vRoot or not hum or hum.Health <= 0 or vRoot.Anchored then
		return
	end

	local away = vRoot.Position - burstPos
	local flat = Vector3.new(away.X, 0, away.Z)
	if flat.Magnitude < 0.08 then
		local look = vRoot.CFrame.LookVector
		flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.08 then
			flat = Vector3.new(0, 0, -1)
		end
	end
	flat = flat.Unit

	local att = Instance.new("Attachment")
	att.Name = "DaggerFlashStruggleAtt"
	att.Parent = vRoot

	local align = Instance.new("AlignOrientation")
	align.Name = "DaggerFlashStruggleAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.RigidityEnabled = false
	align.MaxTorque = 120000
	align.Responsiveness = 14
	align.CFrame = CFrame.lookAt(vRoot.Position, Vector3.new(burstPos.X, vRoot.Position.Y, burstPos.Z))
	align.Parent = vRoot

	-- Soft shove (no Humanoid Physics state / ragdoll)
	local speed = GameConstants.DAGGER_FLASH_PUSH_SPEED
	local up = GameConstants.DAGGER_FLASH_PUSH_UP
	vRoot.AssemblyLinearVelocity = flat * speed + Vector3.new(0, up, 0)

	local origWalk = hum.WalkSpeed
	local origJumpPower = if hum.UseJumpPower then hum.JumpPower else nil
	local origJumpHeight = if not hum.UseJumpPower then hum.JumpHeight else nil
	local origAutoRotate = hum.AutoRotate
	local token = (victim:GetAttribute("DaggerFlashStruggleToken") :: number?) or 0
	token += 1
	victim:SetAttribute("DaggerFlashStruggleToken", token)
	-- Lock movement until push finishes
	hum.WalkSpeed = 0
	hum.AutoRotate = false
	if hum.UseJumpPower then
		hum.JumpPower = 0
	else
		hum.JumpHeight = 0
	end

	task.spawn(function()
		local t0 = os.clock()
		local dur = GameConstants.DAGGER_FLASH_STRUGGLE_TIME
		while os.clock() - t0 < dur do
			if not vRoot.Parent or not victim.Parent then
				break
			end
			if victim:GetAttribute("DaggerFlashStruggleToken") ~= token then
				break
			end
			local elapsed = os.clock() - t0
			local wobble = math.sin(elapsed * 16) * 0.18
			local facePos = Vector3.new(burstPos.X, vRoot.Position.Y, burstPos.Z)
			if (facePos - vRoot.Position).Magnitude > 0.05 then
				align.CFrame = CFrame.lookAt(vRoot.Position, facePos) * CFrame.Angles(wobble * 0.35, wobble, 0)
			end
			-- Keep a struggling outward shove; block player input movement
			hum:Move(Vector3.zero, false)
			hum.WalkSpeed = 0
			local vel = vRoot.AssemblyLinearVelocity
			local retain = math.clamp(1 - elapsed / dur, 0.25, 1)
			vRoot.AssemblyLinearVelocity = Vector3.new(flat.X * speed * 0.55 * retain, math.max(vel.Y, 1.5), flat.Z * speed * 0.55 * retain)
			task.wait()
		end
		if align.Parent then
			align:Destroy()
		end
		if att.Parent then
			att:Destroy()
		end
		if hum.Parent and hum.Health > 0 and victim:GetAttribute("DaggerFlashStruggleToken") == token then
			hum.WalkSpeed = origWalk
			hum.AutoRotate = origAutoRotate
			if origJumpPower ~= nil then
				hum.JumpPower = origJumpPower
			end
			if origJumpHeight ~= nil then
				hum.JumpHeight = origJumpHeight
			end
		end
	end)
end

local function clearFlashChargeHosts(player: Player)
	for _, child in Workspace:GetChildren() do
		if child.Name == "DaggerFlashChargeHost" and child:GetAttribute("OwnerUserId") == player.UserId then
			child:Destroy()
		end
	end
end

local function endSanctuary(player: Player)
	local state = sanctuaryByPlayer[player]
	if not state then
		return
	end
	sanctuaryByPlayer[player] = nil
	if state.part.Parent then
		state.part:Destroy()
	end
end

local function castSanctuary(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("dagger", "sanctuary")
	if not entry or not canUse(character, entry.id, GameConstants.DAGGER_SANCTUARY_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	endSanctuary(player)

	local pos = getFootPosition(character)

	-- Foot-level upright host so SanctuaryAttachment sits on the ground
	local host = Instance.new("Part")
	host.Name = "DaggerSanctuaryZone"
	host.Shape = Enum.PartType.Ball
	host.Size = Vector3.new(1, 1, 1)
	host.CFrame = CFrame.new(pos)
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.Transparency = 1
	host.Parent = Workspace

	local att = attachAndEmitDaggerFx(host, "SanctuaryAttachment", 18)
	if not att then
		host.Shape = Enum.PartType.Cylinder
		host.Size = Vector3.new(0.2, GameConstants.DAGGER_SANCTUARY_RADIUS * 2, GameConstants.DAGGER_SANCTUARY_RADIUS * 2)
		host.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
		host.Transparency = 0.75
		host.Material = Enum.Material.Neon
		host.Color = Color3.fromRGB(255, 255, 255)
	end

	sanctuaryByPlayer[player] = {
		owner = character,
		player = player,
		center = pos,
		part = host,
		endsAt = os.clock() + GameConstants.DAGGER_SANCTUARY_DURATION,
	}

	finishAbility(character, entry.id, GameConstants.DAGGER_SANCTUARY_COOLDOWN)
end

local function castBlindingFlash(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("dagger", "blinding_flash")
	if not entry or not canUse(character, entry.id, GameConstants.DAGGER_FLASH_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)

	local root = getRoot(character)
	if not root then
		character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
		finishAbility(character, entry.id, GameConstants.DAGGER_FLASH_COOLDOWN)
		return
	end

	clearFlashChargeHosts(player)
	local chargeHost, burstPos = spawnRisingCharge(character, player)
	local chargeToken = (character:GetAttribute("DaggerFlashToken") :: number?) or 0
	chargeToken += 1
	character:SetAttribute("DaggerFlashToken", chargeToken)

	task.delay(GameConstants.DAGGER_FLASH_CHARGE_TIME, function()
		local liveBurstPos = burstPos
		if chargeHost and chargeHost.Parent then
			liveBurstPos = chargeHost.Position
			chargeHost:Destroy()
		end
		if not character.Parent or player.Character ~= character then
			return
		end
		if character:GetAttribute("DaggerFlashToken") ~= chargeToken then
			return
		end

		-- Burst at risen charge position
		local burstHost = Instance.new("Part")
		burstHost.Name = "DaggerFlashBurstHost"
		burstHost.Size = Vector3.new(0.3, 0.3, 0.3)
		burstHost.Transparency = 1
		burstHost.Anchored = true
		burstHost.CanCollide = false
		burstHost.CanQuery = false
		burstHost.CanTouch = false
		burstHost.CastShadow = false
		burstHost.CFrame = CFrame.new(liveBurstPos)
		burstHost.Parent = Workspace
		local burstAtt = attachAndEmitDaggerFx(burstHost, "Burst", 24)
		fadeDestroyAttachment(burstAtt, 0.5, 1.4)
		task.delay(1.6, function()
			if burstHost.Parent then
				burstHost:Destroy()
			end
		end)

		local near = CombatHelper.overlapCharacters(liveBurstPos, GameConstants.DAGGER_FLASH_RADIUS, character)
		local blindEvent = Remotes.getEvent("BlindFlash")
		for _, model in near do
			if isAllyModel(character, model) then
				continue
			end
			if model:GetAttribute("LokiUltClone") == true or model:GetAttribute("LokiDecoy") == true then
				continue
			end
			-- No damage / ragdoll — face the burst and struggle-push outward
			applyFlashStruggle(model, liveBurstPos)
			local victimPlayer = Players:GetPlayerFromCharacter(model)
			if victimPlayer then
				fireCameraShake(victimPlayer, 0.85, 0.55)
				blindEvent:FireClient(victimPlayer, {
					duration = GameConstants.DAGGER_FLASH_DURATION,
				})
			end
		end

		character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
		finishAbility(character, entry.id, GameConstants.DAGGER_FLASH_COOLDOWN)
	end)
end

local function restorePurifyBuff(model: Model, humanoid: Humanoid)
	local origWalk = humanoid:GetAttribute("DaggerPurifyOrigWalk")
	if type(origWalk) == "number" then
		humanoid.WalkSpeed = origWalk
		humanoid:SetAttribute("DaggerPurifyOrigWalk", nil)
	end
	local origJump = humanoid:GetAttribute("DaggerPurifyOrigJump")
	if type(origJump) == "number" then
		if humanoid.UseJumpPower then
			humanoid.JumpPower = origJump
		else
			humanoid.JumpHeight = origJump
		end
		humanoid:SetAttribute("DaggerPurifyOrigJump", nil)
	end
	model:SetAttribute("DaggerPurifyUntil", nil)
	-- PARTICLE_PLACEHOLDER: remove Purify buff particles
end

local function applyPurifyBuff(model: Model)
	local humanoid = CombatHelper.getHumanoid(model)
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	-- Cleanse
	model:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, nil)
	model:SetAttribute(GameConstants.TORTURE_LOCKED_ATTRIBUTE, nil)
	RagdollService.clear(model)
	FrostStatus.clear(model)

	local token = (model:GetAttribute("DaggerPurifyToken") :: number?) or 0
	token += 1
	model:SetAttribute("DaggerPurifyToken", token)
	model:SetAttribute("DaggerPurifyUntil", AbilityCooldownHelper.getNow() + GameConstants.DAGGER_PURIFY_BUFF_DURATION)

	if humanoid:GetAttribute("DaggerPurifyOrigWalk") == nil then
		humanoid:SetAttribute("DaggerPurifyOrigWalk", humanoid.WalkSpeed)
	end
	local baseWalk = humanoid:GetAttribute("DaggerPurifyOrigWalk") :: number
	humanoid.WalkSpeed = baseWalk * GameConstants.DAGGER_PURIFY_SPEED_MULT

	if humanoid.UseJumpPower then
		if humanoid:GetAttribute("DaggerPurifyOrigJump") == nil then
			humanoid:SetAttribute("DaggerPurifyOrigJump", humanoid.JumpPower)
		end
		local baseJump = humanoid:GetAttribute("DaggerPurifyOrigJump") :: number
		humanoid.JumpPower = baseJump * GameConstants.DAGGER_PURIFY_JUMP_MULT
	else
		if humanoid:GetAttribute("DaggerPurifyOrigJump") == nil then
			humanoid:SetAttribute("DaggerPurifyOrigJump", humanoid.JumpHeight)
		end
		local baseJump = humanoid:GetAttribute("DaggerPurifyOrigJump") :: number
		humanoid.JumpHeight = baseJump * GameConstants.DAGGER_PURIFY_JUMP_MULT
	end

	-- PARTICLE_PLACEHOLDER: Purify buff particles on model (speed aura)

	task.delay(GameConstants.DAGGER_PURIFY_BUFF_DURATION, function()
		if not model.Parent or not humanoid.Parent then
			return
		end
		if model:GetAttribute("DaggerPurifyToken") ~= token then
			return
		end
		restorePurifyBuff(model, humanoid)
	end)
end

local function castPurify(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("dagger", "purify")
	if not entry or not canUse(character, entry.id, GameConstants.DAGGER_PURIFY_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	local root = getRoot(character)
	local pos = if root then root.Position else getFootPosition(character)

	-- PurifyingAttachment on caster (HRP), not a custom pulse area
	local host = root
	local ownedHost: BasePart? = nil
	if not host then
		local part = Instance.new("Part")
		part.Name = "DaggerPurifyHost"
		part.Size = Vector3.new(0.4, 0.4, 0.4)
		part.Transparency = 1
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.CFrame = CFrame.new(pos)
		part.Parent = Workspace
		ownedHost = part
		host = part
	end

	local purifyAtt = attachAndEmitDaggerFx(host, "PurifyingAttachment", 22)
	if purifyAtt then
		fadeDestroyAttachment(purifyAtt, 0.55, 1.8)
	else
		warn("[DaggerService] Missing ReplicatedStorage.Assets.Dagger.PurifyingAttachment")
	end
	if ownedHost then
		task.delay(2, function()
			if ownedHost and ownedHost.Parent then
				ownedHost:Destroy()
			end
		end)
	end

	applyPurifyBuff(character)
	for _, model in CombatHelper.overlapCharacters(pos, GameConstants.DAGGER_PURIFY_RADIUS, character) do
		if isAllyModel(character, model) then
			applyPurifyBuff(model)
		end
	end

	finishAbility(character, entry.id, GameConstants.DAGGER_PURIFY_COOLDOWN)
end

local function castLumenBarrage(player: Player, direction: Vector3, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("dagger", "lumen_barrage")
	if not entry or not canUse(character, entry.id, GameConstants.DAGGER_BARRAGE_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	if aimPoint then
		character:SetAttribute("DaggerBarrageAim", aimPoint)
	end

	task.spawn(function()
		for i = 1, GameConstants.DAGGER_BARRAGE_COUNT do
			if not character.Parent or player.Character ~= character then
				break
			end
			local liveAim = character:GetAttribute("DaggerBarrageAim")
			local shotAim: Vector3? = if typeof(liveAim) == "Vector3" then liveAim else aimPoint
			local homeDir = resolveAimDir(character, direction, shotAim)
			local preferRight = (i % 2) == 1
			local hand = getHand(character, preferRight)
			local origin = if hand then hand.Position else character:GetPivot().Position
			-- slight spread so the 5 shots aren't perfectly stacked
			local spread = ((i - 3) * 0.04)
			local right = homeDir:Cross(Vector3.yAxis)
			if right.Magnitude < 0.05 then
				right = homeDir:Cross(Vector3.xAxis)
			end
			right = right.Unit
			local shotDir = (homeDir + right * spread)
			if shotDir.Magnitude > 0.01 then
				shotDir = shotDir.Unit
			else
				shotDir = homeDir
			end
			-- Home to live mouse aim (updated via X_aim while barrage is active)
			spawnLightDagger(character, origin, shotDir, shotAim, "DaggerBarrageAim")
			if i < GameConstants.DAGGER_BARRAGE_COUNT then
				task.wait(GameConstants.DAGGER_BARRAGE_SPACING)
			end
		end
		if character.Parent then
			character:SetAttribute("DaggerBarrageAim", nil)
			if AbilityCooldownHelper.isActive(character, entry.id) then
				finishAbility(character, entry.id, GameConstants.DAGGER_BARRAGE_COOLDOWN)
			end
		end
	end)
end

local function addAlly(player: Player, target: Model?)
	if not target or not target.Parent then
		return
	end
	local character = player.Character
	if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "dagger" then
		return
	end
	if target == character then
		return
	end
	local humanoid = CombatHelper.getHumanoid(target)
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	if target:GetAttribute("LokiUltClone") == true or target:GetAttribute("LokiDecoy") == true then
		return
	end
	if target:GetAttribute("FearVisual") == true or target.Name == "FearClone" then
		return
	end

	local map = alliesByPlayer[player]
	if not map then
		map = {}
		alliesByPlayer[player] = map
	end
	local key = allyKeyFor(target)
	map[key] = {
		key = key,
		name = displayNameFor(target),
		model = target,
	}
	fireAlliesSync(player)
end

local function removeAlly(player: Player, key: string?)
	if type(key) ~= "string" or key == "" then
		return
	end
	local map = alliesByPlayer[player]
	if not map then
		return
	end
	map[key] = nil
	fireAlliesSync(player)
end

function DaggerService.clearAllies(player: Player)
	alliesByPlayer[player] = nil
	fireAlliesSync(player)
end

function DaggerService.cancelAll(player: Player)
	endSanctuary(player)
	clearFlashChargeHosts(player)
	local character = player.Character
	if character then
		character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
		character:SetAttribute("DaggerFlashToken", nil)
		character:SetAttribute("DaggerBarrageAim", nil)
		for _, name in { "Charge", "Burst", "DaggerFlashStruggleAlign", "DaggerFlashStruggleAtt" } do
			local fx = character:FindFirstChild(name, true)
			if fx then
				fx:Destroy()
			end
		end
		AbilityCooldownHelper.setActive(character, "light_daggers", false)
		AbilityCooldownHelper.setActive(character, "radiant_bomb", false)
		AbilityCooldownHelper.setActive(character, "light_veil", false)
		AbilityCooldownHelper.setActive(character, "sanctuary", false)
		AbilityCooldownHelper.setActive(character, "blinding_flash", false)
		AbilityCooldownHelper.setActive(character, "lumen_barrage", false)
		AbilityCooldownHelper.setActive(character, "purify", false)
	end
end

function DaggerService.handleAction(player: Player, payload: any)
	if type(payload) ~= "table" then
		return
	end
	local character = player.Character
	if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "dagger" then
		return
	end

	local action = payload.action
	if type(action) ~= "string" then
		return
	end

	local direction = if typeof(payload.direction) == "Vector3" then payload.direction else Vector3.new(0, 0, -1)
	local aimPoint = if typeof(payload.aimPoint) == "Vector3" then payload.aimPoint else nil
	local targetModel = if typeof(payload.target) == "Instance" and payload.target:IsA("Model")
		then payload.target
		else nil

	if action == "Q" then
		fireLightDagger(player, direction, aimPoint)
	elseif action == "E" or action == "E_down" then
		fireRadiantBomb(player, direction, aimPoint)
	elseif action == "F" then
		castLightVeil(player, direction, aimPoint)
	elseif action == "T" or action == "T_down" then
		castSanctuary(player)
	elseif action == "C" or action == "C_down" then
		castBlindingFlash(player)
	elseif action == "X" then
		castLumenBarrage(player, direction, aimPoint)
	elseif action == "X_aim" then
		if AbilityCooldownHelper.isActive(character, "lumen_barrage") and aimPoint then
			character:SetAttribute("DaggerBarrageAim", aimPoint)
		end
	elseif action == "V" then
		castPurify(player)
	elseif action == "AllyAdd" then
		addAlly(player, targetModel)
	elseif action == "AllyRemove" then
		removeAlly(player, if type(payload.key) == "string" then payload.key else nil)
	elseif action == "AllyRefresh" then
		fireAlliesSync(player)
	end
end

function DaggerService.update(dt: number)
	local now = os.clock()
	local dtClamped = math.clamp(dt, 0, 0.2)

	for player, state in sanctuaryByPlayer do
		if now >= state.endsAt or not state.owner.Parent or player.Character ~= state.owner then
			endSanctuary(player)
			continue
		end
		if not state.part.Parent then
			endSanctuary(player)
			continue
		end

		local near = CombatHelper.overlapCharacters(state.center, GameConstants.DAGGER_SANCTUARY_RADIUS, nil)
		for _, model in near do
			if model:GetAttribute("LokiUltClone") == true or model:GetAttribute("LokiDecoy") == true then
				continue
			end
			if isAllyModel(state.owner, model) then
				CombatHelper.heal(model, GameConstants.DAGGER_SANCTUARY_HEAL_PER_SEC * dtClamped)
			elseif model ~= state.owner then
				CombatHelper.dealDamage(
					state.owner,
					model,
					GameConstants.DAGGER_SANCTUARY_DAMAGE_PER_SEC * dtClamped,
					state.center,
					"projectile"
				)
			end
		end
	end
end

function DaggerService.init()
	Remotes.getEvent("DaggerAllies")
	Remotes.getEvent("BlindFlash")
	Remotes.getEvent("CameraShake")
	Remotes.getEvent("UseAbility").OnServerEvent:Connect(function(player: Player, payload: any)
		DaggerService.handleAction(player, payload)
	end)

	local function hookPlayer(player: Player)
		player.CharacterRemoving:Connect(function()
			DaggerService.cancelAll(player)
			DaggerService.clearAllies(player)
		end)
		player.CharacterAdded:Connect(function(character)
			DaggerService.cancelAll(player)
			DaggerService.clearAllies(player)
			local humanoid = character:WaitForChild("Humanoid", 5)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Died:Connect(function()
					DaggerService.cancelAll(player)
				end)
			end
		end)
	end

	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end
	Players.PlayerAdded:Connect(hookPlayer)
	Players.PlayerRemoving:Connect(function(player)
		DaggerService.cancelAll(player)
		alliesByPlayer[player] = nil
	end)
end

return DaggerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">DamagerService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Workspace part named "Damager" damages humanoids standing on / overlapping it.
	Optional attributes on the part:
	  DamagePerSecond / DPS (number) — default 25
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)

local DamagerService = {}

local DEFAULT_DPS = 25
local damagers: { [BasePart]: boolean } = {}
local damageAcc: { [Model]: number } = {}

local function getDps(part: BasePart): number
	local a = part:GetAttribute("DamagePerSecond")
	if type(a) ~= "number" then
		a = part:GetAttribute("DPS")
	end
	if type(a) == "number" and a > 0 then
		return a
	end
	return DEFAULT_DPS
end

local function register(inst: Instance)
	if inst:IsA("BasePart") and inst.Name == "Damager" then
		damagers[inst] = true
	end
end

local function unregister(inst: Instance)
	if inst:IsA("BasePart") then
		damagers[inst] = nil
	end
end

function DamagerService.update(dt: number)
	local dtClamped = math.clamp(dt, 0, 0.2)
	local hitThisFrame: { [Model]: number } = {}

	for part in damagers do
		if not part.Parent then
			damagers[part] = nil
			continue
		end
		local dps = getDps(part)
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { part }
		-- Expand slightly upward so standing on the top surface still counts
		local boxCf = part.CFrame * CFrame.new(0, part.Size.Y * 0.35, 0)
		local boxSize = part.Size + Vector3.new(1.5, 4, 1.5)
		local overlapping = Workspace:GetPartBoundsInBox(boxCf, boxSize, params)
		local seen: { [Model]: boolean } = {}
		for _, other in overlapping do
			local model = CombatHelper.getCharacterFromPart(other)
			if model and not seen[model] then
				seen[model] = true
				hitThisFrame[model] = math.max(hitThisFrame[model] or 0, dps)
			end
		end
	end

	for model, dps in hitThisFrame do
		local humanoid = CombatHelper.getHumanoid(model)
		if not humanoid or humanoid.Health <= 0 then
			continue
		end
		local acc = (damageAcc[model] or 0) + dps * dtClamped
		-- Apply in ~1 HP chunks so small DPS still ticks
		if acc >= 1 then
			local amount = math.floor(acc)
			acc -= amount
			humanoid:TakeDamage(amount)
			CombatHelper.markInCombat(model)
		end
		damageAcc[model] = acc
	end

	-- Clear accumulators for anyone who left the pad
	for model in damageAcc do
		if not hitThisFrame[model] then
			damageAcc[model] = nil
		end
	end
end

function DamagerService.init()
	for _, desc in Workspace:GetDescendants() do
		register(desc)
	end
	Workspace.DescendantAdded:Connect(register)
	Workspace.DescendantRemoving:Connect(unregister)

	-- Also watch top-level rename / late spawn
	Workspace.ChildAdded:Connect(register)
end

return DamagerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[--!strict
--[[ Kill coin rewards and humanoid death hooks. ]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local ShopCatalog = require(ReplicatedStorage.Shared.ShopCatalog)
local PlayerDataService = require(script.Parent.PlayerDataService)

local EconomyService = {}

local deathHooked: { [Humanoid]: boolean } = {}

local function coinRewardFor(killer: Player): number
	local base = ShopCatalog.KILL_COIN_REWARD
	if PlayerDataService.hasElite(killer) then
		return base * ShopCatalog.ELITE_COIN_MULT
	end
	return base
end

local function resolveKiller(victim: Model): Player?
	local userId = victim:GetAttribute(GameConstants.LAST_DAMAGER_USER_ID_ATTRIBUTE)
	if type(userId) ~= "number" then
		return nil
	end
	local killer = Players:GetPlayerByUserId(userId)
	if not killer or not killer.Character then
		return nil
	end
	if killer.Character == victim then
		return nil
	end
	if killer.Character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == nil then
		return nil
	end
	return killer
end

local function onHumanoidDied(victim: Model, _humanoid: Humanoid)
	local killer = resolveKiller(victim)
	if not killer then
		return
	end
	local reward = coinRewardFor(killer)
	PlayerDataService.addCoins(killer, reward)
	PlayerDataService.addKill(killer)
	victim:SetAttribute(GameConstants.LAST_DAMAGER_USER_ID_ATTRIBUTE, nil)
end

local function hookHumanoid(model: Model, humanoid: Humanoid)
	if deathHooked[humanoid] then
		return
	end
	if model.Name == "FearClone" or model:GetAttribute("FearVisual") == true then
		return
	end
	deathHooked[humanoid] = true
	humanoid.Died:Connect(function()
		onHumanoidDied(model, humanoid)
	end)
	humanoid.Destroying:Connect(function()
		deathHooked[humanoid] = nil
	end)
end

local function tryHook(model: Model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		hookHumanoid(model, humanoid)
	end
end

function EconomyService.init()
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(tryHook)
		if player.Character then
			tryHook(player.Character)
		end
	end
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(tryHook)
	end)

	for _, desc in Workspace:GetDescendants() do
		if desc:IsA("Model") and desc:FindFirstChildOfClass("Humanoid") then
			tryHook(desc)
		end
	end

	Workspace.DescendantAdded:Connect(function(desc)
		if desc:IsA("Humanoid") then
			local model = desc.Parent
			if model and model:IsA("Model") then
				task.defer(function()
					tryHook(model)
				end)
			end
		end
	end)
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">FallLandingService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local PushHelper = require(ReplicatedStorage.Shared.PushHelper)
local RagdollStatus = require(ReplicatedStorage.Shared.RagdollStatus)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)

local FallLandingService = {}

type FallTrackState = {
	character: Model,
	peakHeightAboveGround: number,
	wasFlying: boolean,
}

type LandingLockState = {
	character: Model,
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	hipHeight: number?,
	animTrack: AnimationTrack?,
	token: number,
}

local fallByPlayer: { [Player]: FallTrackState } = {}
local landingByPlayer: { [Player]: LandingLockState } = {}
local landingToken = 0

local function heightAboveGround(root: BasePart, character: Model): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local hit = Workspace:Raycast(root.Position, Vector3.new(0, -500, 0), params)
	if hit then
		return math.max(0, root.Position.Y - hit.Position.Y)
	end
	return 500
end

local function shouldSuppressForChaosImpact(character: Model, peakHeight: number): boolean
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "scarlet_witch" then
		return false
	end
	if peakHeight < GameConstants.CHAOS_IMPACT_MIN_FALL then
		return false
	end
	return not AbilityCooldownHelper.isOnCooldown(character, "chaos_impact")
end

local function shouldTrackFall(character: Model): boolean
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == nil then
		return false
	end
	if character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
		return false
	end
	if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
		return false
	end
	if character:GetAttribute(GameConstants.MG_ASTRAL_BODY_ATTRIBUTE) == true then
		return false
	end
	if character:GetAttribute(GameConstants.ICE_SLIDE_ATTRIBUTE) == true then
		return false
	end
	if character:GetAttribute(GameConstants.HIGH_FALL_LANDING_ATTRIBUTE) == true then
		return false
	end
	if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return false
	end
	return true
end

local function playLandingAnim(character: Model): AnimationTrack?
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "scarlet_witch" then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = GameConstants.HIGH_FALL_LANDING_ANIM
	local ok, track = pcall(function()
		return (animator :: Animator):LoadAnimation(anim)
	end)
	anim:Destroy()
	if not ok or not track then
		return nil
	end
	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = false
	track:Play(0, 1, 1)
	return track
end

local function applyLandingImpact(character: Model, landPos: Vector3)
	local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
	if heroId == "scarlet_witch" then
		return
	end

	local radius = GameConstants.HIGH_FALL_LANDING_RADIUS
	if heroId == "captain_marvel" then
		VfxHelper.spawnPhotonGroundSlam(landPos, radius)
	else
		VfxHelper.spawnPulseRing(landPos, radius * 0.7, Color3.fromRGB(220, 220, 230), 0.35)
		VfxHelper.spawnBurstSparks(landPos, Color3.fromRGB(240, 240, 245), 12)
	end
	pcall(function()
		VfxHelper.playWorldSound(GameConstants.TK_LAND_SOUND, landPos, 0.9)
	end)

	for _, victim in CombatHelper.overlapCharacters(landPos, radius, character) do
		if victim == character then
			continue
		end
		if victim:GetAttribute("LokiUltClone") == true or victim:GetAttribute("LokiDecoy") == true then
			continue
		end
		CombatHelper.dealDamage(character, victim, GameConstants.HIGH_FALL_LANDING_DAMAGE, landPos, "projectile")
		RagdollStatus.applyTimed(victim, GameConstants.HIGH_FALL_LANDING_RAGDOLL)
		local vRoot = victim:FindFirstChild("HumanoidRootPart") :: BasePart?
		local away = if vRoot then (vRoot.Position - landPos) else Vector3.new(0, 0, -1)
		if away.Magnitude < 0.05 then
			away = Vector3.new(0, 0, -1)
		end
		PushHelper.applyToCharacter(victim, away, {
			speed = GameConstants.HIGH_FALL_LANDING_PUSH_SPEED,
			upBoost = GameConstants.HIGH_FALL_LANDING_PUSH_UP,
		})
	end
end

local function lockMovement(humanoid: Humanoid)
	humanoid.WalkSpeed = 0
	humanoid.AutoRotate = false
	if humanoid.UseJumpPower then
		humanoid.JumpPower = 0
	else
		humanoid.JumpHeight = 0
	end
	humanoid:Move(Vector3.zero, false)
end

local function unlockMovement(state: LandingLockState)
	local character = state.character
	if not character.Parent then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	humanoid.WalkSpeed = state.walk
	humanoid.AutoRotate = true
	if state.jumpPower ~= nil then
		humanoid.JumpPower = state.jumpPower
	end
	if state.jumpHeight ~= nil then
		humanoid.JumpHeight = state.jumpHeight
	end
	if state.hipHeight ~= nil then
		humanoid.HipHeight = state.hipHeight
	end
	character:SetAttribute(GameConstants.HIGH_FALL_LANDING_ATTRIBUTE, nil)
end

local function endLandingLock(player: Player, token: number)
	local state = landingByPlayer[player]
	if not state or state.token ~= token then
		return
	end
	if state.animTrack then
		state.animTrack:Stop(0.12)
		state.animTrack:Destroy()
		state.animTrack = nil
	end
	unlockMovement(state)
	landingByPlayer[player] = nil
end

local function beginLandingLock(player: Player, character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	landingToken += 1
	local token = landingToken
	local savedWalk = humanoid.WalkSpeed
	local savedJumpPower: number? = nil
	local savedJumpHeight: number? = nil
	if humanoid.UseJumpPower then
		savedJumpPower = humanoid.JumpPower
	else
		savedJumpHeight = humanoid.JumpHeight
	end

	character:SetAttribute(GameConstants.HIGH_FALL_LANDING_ATTRIBUTE, true)
	lockMovement(humanoid)

	local savedHip = humanoid.HipHeight
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		local hit = Workspace:Raycast(root.Position + Vector3.new(0, 2, 0), Vector3.new(0, -12, 0), params)
		if hit then
			humanoid.HipHeight = GameConstants.HIGH_FALL_LANDING_HIP_HEIGHT
			local rot = root.CFrame - root.CFrame.Position
			root.CFrame = CFrame.new(root.Position.X, hit.Position.Y + humanoid.HipHeight, root.Position.Z) * rot
			root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
		end
	end

	local animTrack = playLandingAnim(character)
	local landPos = if root then root.Position else character:GetPivot().Position
	applyLandingImpact(character, landPos)
	local lockDuration = GameConstants.HIGH_FALL_LANDING_LOCK_FALLBACK
	if animTrack then
		lockDuration = math.max(animTrack.Length, lockDuration)
		animTrack.Stopped:Connect(function()
			endLandingLock(player, token)
		end)
	end

	landingByPlayer[player] = {
		character = character,
		walk = savedWalk,
		jumpPower = savedJumpPower,
		jumpHeight = savedJumpHeight,
		hipHeight = savedHip,
		animTrack = animTrack,
		token = token,
	}

	task.delay(lockDuration, function()
		endLandingLock(player, token)
	end)
end

local function clearFallTrack(player: Player)
	fallByPlayer[player] = nil
end

local function updateFallTrack(player: Player, character: Model, dt: number)
	local landingLock = landingByPlayer[player]
	if landingLock and landingLock.character == character then
		if character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
			endLandingLock(player, landingLock.token)
			clearFallTrack(player)
			return
		end
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum and hum.Parent then
			lockMovement(hum)
		end
		return
	end

	if not shouldTrackFall(character) then
		clearFallTrack(player)
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		clearFallTrack(player)
		return
	end

	local state = fallByPlayer[player]
	if not state or state.character ~= character then
		state = {
			character = character,
			peakHeightAboveGround = 0,
			wasFlying = false,
		}
		fallByPlayer[player] = state
	end

	local flying = character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
	if flying then
		state.wasFlying = true
		return
	end

	if state.wasFlying then
		state.wasFlying = false
	end

	local height = heightAboveGround(root, character)
	local vel = root.AssemblyLinearVelocity
	local falling = vel.Y < -2
	local humState = humanoid:GetState()
	local inAirState = humState == Enum.HumanoidStateType.Freefall
		or humState == Enum.HumanoidStateType.Jumping
		or humState == Enum.HumanoidStateType.FallingDown
	local trulyLanded = humState == Enum.HumanoidStateType.Landed
		or (
			(humState == Enum.HumanoidStateType.Running or humState == Enum.HumanoidStateType.RunningNoPhysics)
			and humanoid.FloorMaterial ~= Enum.Material.Air
			and height < 2.8
			and vel.Y > -6
		)

	if inAirState or (falling and height > 3) then
		state.peakHeightAboveGround = math.max(state.peakHeightAboveGround, height)
	end

	if trulyLanded and state.peakHeightAboveGround >= GameConstants.HIGH_FALL_LANDING_MIN_HEIGHT then
		local peak = state.peakHeightAboveGround
		state.peakHeightAboveGround = 0
		if character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) ~= true
			and not shouldSuppressForChaosImpact(character, peak)
		then
			beginLandingLock(player, character)
		end
		return
	end

	if trulyLanded and not falling then
		state.peakHeightAboveGround = 0
	end

	-- dt unused but kept for heartbeat signature parity
	_ = dt
end

function FallLandingService.init()
	Players.PlayerRemoving:Connect(function(player)
		local state = landingByPlayer[player]
		if state then
			endLandingLock(player, state.token)
		end
		clearFallTrack(player)
	end)
end

function FallLandingService.update(_dt: number)
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character then
			updateFallTrack(player, character, _dt)
		else
			clearFallTrack(player)
		end
	end
end

return FallLandingService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">HandParticleHelper</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Clones ReplicatedStorage.Assets.ScarletWitch.HandParticle onto both hands once.
	beginUse/endUse enable/disable only (no Emit, no extra clones).
	A stack keeps overlapping abilities from stacking VFX; ending one restores the previous.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local HandParticleHelper = {}

export type HandSide = "Both" | "Right" | "Left"

local ATTACHMENT_NAME = "HandParticle"
local FADE_TIME = 0.35

local ensured: { [Model]: boolean } = {}
local useStack: { [Model]: { HandSide } } = {}
local flyingHands: { [Model]: boolean } = {}
local handOn: { [Model]: { Left: boolean, Right: boolean } } = {}
local savedRates: { [ParticleEmitter]: number } = {}
local fadeConns: { [ParticleEmitter]: RBXScriptConnection } = {}

local function getRightHandName(character: Model): string
	if character:FindFirstChild("RightHand") then
		return "RightHand"
	end
	return "Right Arm"
end

local function getLeftHandName(character: Model): string
	if character:FindFirstChild("LeftHand") then
		return "LeftHand"
	end
	return "Left Arm"
end

local function getHandNames(character: Model): { string }
	return { getLeftHandName(character), getRightHandName(character) }
end

local function getTemplate(): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local classic = assets and assets:FindFirstChild("ScarletWitchClassic")
	local classicFx = classic and classic:FindFirstChild("HandVFXBasepart")
	if classicFx then
		if classicFx:IsA("Attachment") or classicFx:IsA("BasePart") then
			return classicFx
		end
		local nested = classicFx:FindFirstChildWhichIsA("Attachment", true)
			or classicFx:FindFirstChildWhichIsA("BasePart", true)
		if nested then
			return nested
		end
		return classicFx
	end
	local folder = assets and assets:FindFirstChild("ScarletWitch")
	local template = folder and folder:FindFirstChild("HandParticle")
	if not template then
		return nil
	end
	if template:IsA("Attachment") then
		return template
	end
	local nested = template:FindFirstChildWhichIsA("Attachment", true)
	return nested or template
end

local function stopFade(em: ParticleEmitter)
	local conn = fadeConns[em]
	if conn then
		conn:Disconnect()
		fadeConns[em] = nil
	end
end

local function forEachFxOnHand(character: Model, handName: string, fn: (Instance) -> ())
	local hand = character:FindFirstChild(handName)
	if not (hand and hand:IsA("BasePart")) then
		return
	end
	local fx = hand:FindFirstChild(ATTACHMENT_NAME)
	if not fx then
		return
	end
	fn(fx)
	for _, desc in fx:GetDescendants() do
		fn(desc)
	end
end

local function collectEmittersOnHand(character: Model, handName: string): { ParticleEmitter }
	local list: { ParticleEmitter } = {}
	forEachFxOnHand(character, handName, function(inst)
		if inst:IsA("ParticleEmitter") then
			table.insert(list, inst)
		end
	end)
	return list
end

local function rememberRate(em: ParticleEmitter)
	if savedRates[em] == nil and em.Rate > 0 then
		savedRates[em] = em.Rate
	elseif savedRates[em] == nil then
		savedRates[em] = 20
	end
end

local function disableAllFx(root: Instance)
	for _, desc in root:GetDescendants() do
		if desc:IsA("ParticleEmitter") then
			rememberRate(desc)
			desc.Enabled = false
		elseif desc:IsA("Trail") or desc:IsA("Beam") then
			(desc :: any).Enabled = false
		elseif desc:IsA("Sound") then
			desc:Stop()
			desc.Playing = false
		end
	end
	if root:IsA("ParticleEmitter") then
		rememberRate(root)
		root.Enabled = false
	elseif root:IsA("Trail") or root:IsA("Beam") then
		(root :: any).Enabled = false
	elseif root:IsA("Sound") then
		root:Stop()
		root.Playing = false
	end
end

local function setHandFxEnabled(character: Model, handName: string, enabled: boolean, smooth: boolean)
	local emitters = collectEmittersOnHand(character, handName)
	for _, em in emitters do
		rememberRate(em)
		stopFade(em)
		local targetRate = savedRates[em] or 20
		if enabled then
			em.Enabled = true
			em.Rate = targetRate
		else
			if smooth then
				local startRate = em.Rate
				local start = os.clock()
				fadeConns[em] = RunService.Heartbeat:Connect(function()
					if not em.Parent then
						stopFade(em)
						return
					end
					local t = math.min(1, (os.clock() - start) / FADE_TIME)
					em.Rate = startRate * (1 - t)
					if t >= 1 then
						em.Enabled = false
						em.Rate = targetRate
						stopFade(em)
					end
				end)
			else
				em.Enabled = false
				em.Rate = targetRate
			end
		end
	end
	forEachFxOnHand(character, handName, function(inst)
		if inst:IsA("Beam") then
			inst.Enabled = enabled
		elseif inst:IsA("Trail") then
			-- Trails only while flying — handled by setFlightTrails
		end
	end)
end

local function setAllTrails(character: Model, enabled: boolean)
	for _, handName in getHandNames(character) do
		forEachFxOnHand(character, handName, function(inst)
			if inst:IsA("Trail") then
				inst.Enabled = enabled
			end
		end)
	end
end

local function desiredHands(character: Model): (boolean, boolean)
	local stack = useStack[character]
	if stack and #stack > 0 then
		local side = stack[#stack]
		if side == "Both" then
			return true, true
		elseif side == "Right" then
			return false, true
		end
		return true, false
	end
	if flyingHands[character] then
		return true, true
	end
	return false, false
end

local function refreshHands(character: Model, smoothOff: boolean)
	if not character.Parent then
		return
	end
	local wantLeft, wantRight = desiredHands(character)
	local state = handOn[character]
	if not state then
		state = { Left = false, Right = false }
		handOn[character] = state
	end

	if wantLeft ~= state.Left then
		setHandFxEnabled(character, getLeftHandName(character), wantLeft, smoothOff and not wantLeft)
		state.Left = wantLeft
	end
	if wantRight ~= state.Right then
		setHandFxEnabled(character, getRightHandName(character), wantRight, smoothOff and not wantRight)
		state.Right = wantRight
	end
end

--[[ Enable hand trails only during hex flight; disable otherwise. ]]
function HandParticleHelper.setFlightTrails(character: Model, flying: boolean)
	if not character.Parent then
		return
	end
	HandParticleHelper.ensure(character)
	flyingHands[character] = flying == true
	setAllTrails(character, flying == true)
	refreshHands(character, not flying)
end

local function anyActive(character: Model): boolean
	local stack = useStack[character]
	return flyingHands[character] == true or (stack ~= nil and #stack > 0)
end

function HandParticleHelper.ensure(character: Model)
	if not character.Parent then
		return
	end
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "scarlet_witch" then
		return
	end
	if ensured[character] then
		for _, handName in getHandNames(character) do
			local hand = character:FindFirstChild(handName)
			if hand then
				local keep = false
				for _, ch in hand:GetChildren() do
					if ch.Name == ATTACHMENT_NAME then
						if keep then
							ch:Destroy()
						else
							keep = true
						end
					end
				end
			end
		end
		if not anyActive(character) then
			for _, handName in getHandNames(character) do
				for _, em in collectEmittersOnHand(character, handName) do
					if em.Enabled then
						em.Enabled = false
					end
				end
				forEachFxOnHand(character, handName, function(inst)
					if inst:IsA("Beam") then
						inst.Enabled = false
					elseif inst:IsA("Trail") then
						-- keep trail state tied to flight only
						local flying = character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
						inst.Enabled = flying
					end
				end)
			end
		end
		return
	end

	local template = getTemplate()
	if not template then
		return
	end

	for _, handName in getHandNames(character) do
		local hand = character:FindFirstChild(handName)
		if hand and hand:IsA("BasePart") then
			local keep = false
			for _, ch in hand:GetChildren() do
				if ch.Name == ATTACHMENT_NAME then
					if keep then
						ch:Destroy()
					else
						keep = true
					end
				end
			end
			if not hand:FindFirstChild(ATTACHMENT_NAME) then
				local clone = template:Clone()
				clone.Name = ATTACHMENT_NAME
				if clone:IsA("Attachment") then
					clone.Parent = hand
				elseif clone:IsA("BasePart") then
					clone.Anchored = false
					clone.CanCollide = false
					clone.CanQuery = false
					clone.CanTouch = false
					clone.Massless = true
					clone.CFrame = hand.CFrame
					clone.Parent = hand
					local weld = Instance.new("Weld")
					weld.Name = "HandVfxWeld"
					weld.Part0 = hand
					weld.Part1 = clone
					weld.C0 = CFrame.identity
					weld.Parent = clone
				else
					clone.Parent = hand
				end
				disableAllFx(clone)
			else
				local existing = hand:FindFirstChild(ATTACHMENT_NAME)
				if existing then
					disableAllFx(existing)
				end
			end
		end
	end

	ensured[character] = true
	handOn[character] = { Left = false, Right = false }
	character.Destroying:Once(function()
		ensured[character] = nil
		useStack[character] = nil
		flyingHands[character] = nil
		handOn[character] = nil
	end)
end

--[[ Ability started. side defaults to Both; use "Right" for hex beam. ]]
function HandParticleHelper.beginUse(character: Model, side: HandSide?)
	if not character or not character.Parent then
		return
	end
	HandParticleHelper.ensure(character)
	local stack = useStack[character]
	if not stack then
		stack = {}
		useStack[character] = stack
	end
	table.insert(stack, side or "Both")
	refreshHands(character, false)
end

--[[ Ability ended. Pass the same side used in beginUse. ]]
function HandParticleHelper.endUse(character: Model, side: HandSide?)
	if not character or not character.Parent then
		return
	end
	local stack = useStack[character]
	if not stack then
		refreshHands(character, true)
		return
	end
	local useSide: HandSide = side or "Both"
	for i = #stack, 1, -1 do
		if stack[i] == useSide then
			table.remove(stack, i)
			break
		end
	end
	if #stack == 0 then
		useStack[character] = nil
	end
	refreshHands(character, true)
end

function HandParticleHelper.pulse(character: Model, holdSeconds: number?, side: HandSide?)
	HandParticleHelper.beginUse(character, side)
	local hold = holdSeconds or 0.45
	task.delay(hold, function()
		if character.Parent then
			HandParticleHelper.endUse(character, side)
		end
	end)
end

function HandParticleHelper.clear(character: Model)
	useStack[character] = nil
	flyingHands[character] = nil
	ensured[character] = nil
	handOn[character] = nil
	for _, handName in getHandNames(character) do
		for _, em in collectEmittersOnHand(character, handName) do
			stopFade(em)
			em.Enabled = false
		end
		forEachFxOnHand(character, handName, function(inst)
			if inst:IsA("Beam") then
				inst.Enabled = false
			elseif inst:IsA("Trail") then
				inst.Enabled = false
			end
		end)
	end
end

return HandParticleHelper
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">HexFlightService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local ConstraintHelper = require(ReplicatedStorage.Shared.ConstraintHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local CharacterService = require(script.Parent.CharacterService)
local HandParticleHelper = require(script.Parent.HandParticleHelper)

local HexFlightService = {}

type FlightState = {
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	mover: ConstraintHelper.MoverBundle,
	moveDir: Vector3,
	lookDir: Vector3,
	currentVel: Vector3,
	sideInput: number,
	healthConn: RBXScriptConnection?,
}

type HeroFxHooks = {
	begin: (character: Model) -> (),
	finish: (character: Model) -> (),
}

local flightByPlayer: { [Player]: FlightState } = {}
local heroFxHooks: { [string]: HeroFxHooks } = {}

function HexFlightService.registerHeroFx(heroId: string, hooks: HeroFxHooks)
	heroFxHooks[heroId] = hooks
end

local function flightAbilityIdFor(heroId: any): string?
	if heroId == "jean_grey" then
		return "telekinetic_flight"
	elseif heroId == "scarlet_witch" then
		return "hex_flight"
	elseif heroId == "invisible_woman" then
		return "forcefield_flight"
	end
	return nil
end

local function runHeroFx(character: Model, which: "begin" | "finish")
	local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
	if type(heroId) ~= "string" then
		return
	end
	local hooks = heroFxHooks[heroId]
	if not hooks then
		return
	end
	local fn = if which == "begin" then hooks.begin else hooks.finish
	pcall(fn, character)
end

local function normalize(v: Vector3): Vector3
	if v.Magnitude < 0.01 then
		return Vector3.new(0, 0, -1)
	end
	return v.Unit
end

local function powersBlocked(character: Model): boolean
	return CombatHelper.arePowersDisabled(character)
		or character:GetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE) == true
		or character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true
end

local function getBank(direction: Vector3, velocity: Vector3): number
	if direction.Magnitude < 0.01 or velocity.Magnitude < 2 then
		return 0
	end
	local lookVec = (CFrame.new(Vector3.zero, direction) * CFrame.Angles(0, math.rad(90), 0)).LookVector
	local dot = lookVec:Dot(velocity.Unit)
	local len = lookVec.Magnitude * velocity.Magnitude
	if len < 0.0001 then
		return 0
	end
	return math.clamp(90 - math.deg(math.acos(math.clamp(dot / len, -1, 1))), -90, 90)
end

function HexFlightService.isFlying(player: Player): boolean
	return flightByPlayer[player] ~= nil
end

function HexFlightService.endFlight(player: Player, applyCooldown: boolean?)
	local state = flightByPlayer[player]
	flightByPlayer[player] = nil

	local function clearFlightAttrs(char: Model?)
		if not char then
			return
		end
		char:SetAttribute(GameConstants.IS_FLYING_ATTRIBUTE, nil)
		char:SetAttribute(GameConstants.FLIGHT_ALPHA_ATTRIBUTE, nil)
		char:SetAttribute(GameConstants.FLIGHT_BANK_ATTRIBUTE, nil)
		char:SetAttribute(GameConstants.FLIGHT_SIDE_ATTRIBUTE, nil)
		char:SetAttribute("BarrageSpinActive", nil)
		char:SetAttribute("BarrageSpinYaw", nil)
	end

	local function stripFlightConstraints(root: BasePart?)
		if not root or not root.Parent then
			return
		end
		for _, name in { "HeroLinearVelocity", "HeroGravityCancel", "HeroAlignOrientation" } do
			local inst = root:FindFirstChild(name)
			if inst then
				inst:Destroy()
			end
		end
	end

	-- Always clear attrs on current body (reset / morph race)
	clearFlightAttrs(player.Character)

	if not state then
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		stripFlightConstraints(root)
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum:GetAttribute("HeroAbilityLocked") == true then
			ConstraintHelper.unlockHumanoid(hum)
		end
		return
	end

	if state.healthConn then
		state.healthConn:Disconnect()
		state.healthConn = nil
	end

	local char = state.character
	local exitVel = state.currentVel
	local isDead = state.humanoid ~= nil and state.humanoid.Health <= 0
	clearFlightAttrs(char)

	pcall(function()
		ConstraintHelper.destroyMover(state.mover)
	end)
	stripFlightConstraints(state.root)
	if state.humanoid and state.humanoid.Parent then
		ConstraintHelper.unlockHumanoid(state.humanoid)
	end
	if state.root and state.root.Parent then
		state.root.AssemblyLinearVelocity = if isDead then Vector3.zero else exitVel
		state.root.AssemblyAngularVelocity = Vector3.zero
	end
	if isDead and state.humanoid and state.humanoid.Parent then
		state.humanoid.PlatformStand = false
		state.humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
		pcall(function()
			state.humanoid:ChangeState(Enum.HumanoidStateType.Dead)
		end)
	end

	if char and char.Parent then
		HandParticleHelper.setFlightTrails(char, false)
		runHeroFx(char, "finish")
	end

	if applyCooldown and char and char.Parent then
		local heroId = char:GetAttribute(GameConstants.HERO_ATTRIBUTE)
		local flightId = flightAbilityIdFor(heroId) or "hex_flight"
		local entry = CharacterRegistry.getAbilityById(if type(heroId) == "string" then heroId else "scarlet_witch", flightId)
		if entry then
			AbilityCooldownHelper.applyAfterUse(char, entry.id, entry.cooldown)
		end
	end
end

function HexFlightService.startFlight(player: Player): boolean
	if flightByPlayer[player] then
		return false
	end
	local character = player.Character
	if not character then
		return false
	end
	local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
	local flightAbilityId = flightAbilityIdFor(heroId)
	if not flightAbilityId then
		return false
	end
	if powersBlocked(character) then
		return false
	end
	if heroId == "invisible_woman" then
		if character:GetAttribute(GameConstants.IW_HYPERSPACE_LOCK_ATTRIBUTE) == true then
			return false
		end
		local hs = character:GetAttribute(GameConstants.IW_HYPERSPACE_ATTRIBUTE)
		local maxHs = character:GetAttribute(GameConstants.IW_HYPERSPACE_MAX_ATTRIBUTE)
		if type(maxHs) ~= "number" or maxHs <= 0 then
			maxHs = GameConstants.IW_HYPERSPACE_MAX
		end
		if type(hs) == "number" and hs >= maxHs then
			return false
		end
	end

	local entry = CharacterRegistry.getAbilityById(heroId :: string, flightAbilityId)
	if not entry then
		return false
	end
	if AbilityCooldownHelper.isOnCooldown(character, entry.id) then
		return false
	end

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return false
	end

	ConstraintHelper.lockHumanoidForAbility(humanoid)
	local mover = ConstraintHelper.createMover(root, true, true)

	flightByPlayer[player] = {
		character = character,
		humanoid = humanoid,
		root = root,
		mover = mover,
		moveDir = Vector3.zero,
		lookDir = root.CFrame.LookVector,
		currentVel = Vector3.zero,
		sideInput = 0,
		healthConn = humanoid.HealthChanged:Connect(function(hp)
			if hp > 0 then
				return
			end
			HexFlightService.endFlight(player, false)
			if humanoid.Parent and humanoid.Health <= 0 then
				humanoid.PlatformStand = false
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
				pcall(function()
					humanoid:ChangeState(Enum.HumanoidStateType.Dead)
				end)
			end
		end),
	}

	character:SetAttribute(GameConstants.IS_FLYING_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.FLIGHT_ALPHA_ATTRIBUTE, 0)
	character:SetAttribute(GameConstants.FLIGHT_BANK_ATTRIBUTE, 0)
	character:SetAttribute(GameConstants.FLIGHT_SIDE_ATTRIBUTE, 0)
	if heroId == "scarlet_witch" then
		HandParticleHelper.setFlightTrails(character, true)
	end
	runHeroFx(character, "begin")
	return true
end

function HexFlightService.toggleFlight(player: Player)
	if flightByPlayer[player] then
		HexFlightService.endFlight(player, true)
	else
		HexFlightService.startFlight(player)
	end
end

function HexFlightService.setInput(
	player: Player,
	moveDir: Vector3,
	lookDir: Vector3,
	sideInput: number?
)
	local state = flightByPlayer[player]
	if not state then
		return
	end
	state.moveDir = moveDir
	state.lookDir = lookDir
	state.sideInput = sideInput or 0
end

function HexFlightService.update(dt: number)
	local dtClamped = math.clamp(dt, 0.001, 0.1)
	local velLerpMove = 1 - (1 - GameConstants.FLIGHT_VEL_LERP_MOVE) ^ (dtClamped * 60)
	local velLerpDecay = 1 - (1 - GameConstants.FLIGHT_VEL_LERP_DECAY) ^ (dtClamped * 60)

	for player, state in flightByPlayer do
		local char = state.character
		-- Stale body after reset / morph: current Character is no longer the flying one
		if player.Character ~= char or not char.Parent or not state.humanoid.Parent or not state.root.Parent then
			HexFlightService.endFlight(player, false)
			continue
		end
		if state.humanoid.Health <= 0 then
			HexFlightService.endFlight(player, false)
			continue
		end

		local energy = char:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		if type(energy) ~= "number" or energy <= 0 then
			HexFlightService.endFlight(player, true)
			continue
		end
		local heroId = char:GetAttribute(GameConstants.HERO_ATTRIBUTE)
		local drainRate = GameConstants.FLIGHT_ENERGY_PER_SEC
		if heroId == "invisible_woman" then
			drainRate = GameConstants.IW_FLIGHT_ENERGY_PER_SEC
			if char:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern" then
				drainRate *= 0.75
			end
		end
		char:SetAttribute(
			GameConstants.ENERGY_ATTRIBUTE,
			math.max(0, energy - drainRate * dtClamped)
		)
		CharacterService.markAbilityUse(char)

		if AbilityCooldownHelper.isActive(char, "forcefield_crush") then
			state.moveDir = Vector3.zero
			state.currentVel = Vector3.zero
			state.mover.linearVelocity.VectorVelocity = Vector3.zero
			if state.mover.vectorForce then
				state.mover.vectorForce.Force = Vector3.new(0, state.root.AssemblyMass * workspace.Gravity, 0)
			end
			char:SetAttribute(GameConstants.FLIGHT_ALPHA_ATTRIBUTE, 0)
			continue
		end

		local moveMag = state.moveDir.Magnitude
		local direction = if moveMag > 0.01 then state.moveDir.Unit else normalize(state.lookDir)
		local speed = GameConstants.FLIGHT_SPEED

		local sideLean = math.clamp(state.sideInput, -1, 1)

		local targetVel = if moveMag > 0.01 then direction * speed else Vector3.zero
		local lerpAlpha = if moveMag > 0.01 then velLerpMove else velLerpDecay
		state.currentVel = state.currentVel:Lerp(targetVel, lerpAlpha)
		state.mover.linearVelocity.VectorVelocity = state.currentVel
		if state.mover.vectorForce then
			state.mover.vectorForce.Force = Vector3.new(0, state.root.AssemblyMass * workspace.Gravity, 0)
		end

		local velMag = state.currentVel.Magnitude
		local alphaSpeed = if speed > 0 then velMag / speed else 0
		local leanStrength = math.clamp(alphaSpeed, 0, 1)
		local facingDir = if moveMag > 0.01 then direction else normalize(state.lookDir)
		local bank = 0
		local sideYaw = 0
		local pitchAlpha = 0
		local pitchMax = GameConstants.FLIGHT_PITCH_MAX
		if heroId == "scarlet_witch" then
			pitchMax = GameConstants.SW_FLIGHT_PITCH_MAX
		elseif heroId == "jean_grey" then
			pitchMax = GameConstants.MG_FLIGHT_PITCH_MAX
		elseif heroId == "invisible_woman" then
			local modern = char:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern"
			pitchMax = if modern then GameConstants.IW_FLIGHT_PITCH_MAX_MODERN else GameConstants.IW_FLIGHT_PITCH_MAX
		end
		if moveMag > 0.01 and velMag > 2 then
			bank = getBank(direction, state.currentVel) * leanStrength * GameConstants.FLIGHT_BANK_SCALE
			bank += sideLean * GameConstants.FLIGHT_BANK_MAX * GameConstants.FLIGHT_SIDE_YIELD * leanStrength
			sideYaw = sideLean * GameConstants.FLIGHT_SIDE_YAW * leanStrength
			pitchAlpha = math.min(1, alphaSpeed) * 1.15
		end
		bank = math.clamp(bank, -GameConstants.FLIGHT_BANK_MAX, GameConstants.FLIGHT_BANK_MAX)
		sideYaw = math.clamp(sideYaw, -GameConstants.FLIGHT_SIDE_YAW, GameConstants.FLIGHT_SIDE_YAW)

		local spinActive = char:GetAttribute("BarrageSpinActive") == true
		local absorbActive = char:GetAttribute("AbsorbActive") == true
		if state.mover.alignOrientation and not spinActive and not absorbActive then
			local baseCf = CFrame.lookAt(state.root.Position, state.root.Position + facingDir)
			-- X pitch, Y yaw (turn), Z roll (shoulders)
			local targetCf = baseCf
				* CFrame.Angles(
					math.rad(-pitchAlpha * pitchMax),
					math.rad(sideYaw),
					math.rad(-bank)
				)
			local rotAlpha = 1 - (1 - GameConstants.FLIGHT_ROTATION_LERP) ^ (dtClamped * 60)
			state.mover.alignOrientation.CFrame = state.mover.alignOrientation.CFrame:Lerp(targetCf, rotAlpha)
		end

		char:SetAttribute(GameConstants.FLIGHT_ALPHA_ATTRIBUTE, math.clamp(alphaSpeed, 0, 1))
		char:SetAttribute(GameConstants.FLIGHT_BANK_ATTRIBUTE, bank)
		char:SetAttribute(GameConstants.FLIGHT_SIDE_ATTRIBUTE, sideLean)
	end
end

function HexFlightService.init()
	Remotes.getEvent("FlightInput").OnServerEvent:Connect(function(player: Player, payload: any)
		if type(payload) ~= "table" then
			return
		end
		if payload.dead == true then
			HexFlightService.endFlight(player, false)
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.PlatformStand = false
				hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
				if hum.Health <= 0 then
					pcall(function()
						hum:ChangeState(Enum.HumanoidStateType.Dead)
					end)
				end
			end
			return
		end
		local move = if typeof(payload.moveVector) == "Vector3" then payload.moveVector else Vector3.zero
		local look = if typeof(payload.lookVector) == "Vector3" then payload.lookVector else Vector3.new(0, 0, -1)
		local side = if type(payload.sideInput) == "number" then payload.sideInput else 0
		HexFlightService.setInput(player, move, look, side)
	end)

	local function hookPlayer(player: Player)
		player.CharacterRemoving:Connect(function(character)
			HexFlightService.endFlight(player, false)
			if character then
				character:SetAttribute(GameConstants.IS_FLYING_ATTRIBUTE, nil)
				character:SetAttribute(GameConstants.FLIGHT_ALPHA_ATTRIBUTE, nil)
				character:SetAttribute(GameConstants.FLIGHT_BANK_ATTRIBUTE, nil)
				character:SetAttribute(GameConstants.FLIGHT_SIDE_ATTRIBUTE, nil)
				character:SetAttribute("BarrageSpinActive", nil)
				character:SetAttribute("BarrageSpinYaw", nil)
				local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root then
					for _, name in { "HeroLinearVelocity", "HeroGravityCancel", "HeroAlignOrientation", "HeroMoverAttachment" } do
						local inst = root:FindFirstChild(name)
						if inst then
							inst:Destroy()
						end
					end
				end
			end
		end)
		player.CharacterAdded:Connect(function(character)
			HexFlightService.endFlight(player, false)
			local humanoid = character:WaitForChild("Humanoid", 8)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Died:Connect(function()
					HexFlightService.endFlight(player, false)
					-- Unlock then ragdoll so death isn't stuck in flight pose
					if humanoid.Parent then
						if humanoid:GetAttribute("HeroAbilityLocked") == true then
							ConstraintHelper.unlockHumanoid(humanoid)
						end
						local RagdollService = require(script.Parent.RagdollService)
						RagdollService.apply(character)
					end
				end)
			end
			task.defer(function()
				HexFlightService.endFlight(player, false)
				local hum = character:FindFirstChildOfClass("Humanoid")
				if hum and hum:GetAttribute("HeroAbilityLocked") == true then
					ConstraintHelper.unlockHumanoid(hum)
				end
				local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root then
					for _, name in { "HeroLinearVelocity", "HeroGravityCancel", "HeroAlignOrientation", "HeroMoverAttachment" } do
						local inst = root:FindFirstChild(name)
						if inst then
							inst:Destroy()
						end
					end
				end
				-- Clear stale flying attrs if somehow still set
				if character.Parent then
					character:SetAttribute(GameConstants.IS_FLYING_ATTRIBUTE, nil)
					character:SetAttribute(GameConstants.FLIGHT_ALPHA_ATTRIBUTE, nil)
					character:SetAttribute(GameConstants.FLIGHT_BANK_ATTRIBUTE, nil)
					character:SetAttribute(GameConstants.FLIGHT_SIDE_ATTRIBUTE, nil)
				end
			end)
		end)
	end
	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end
	Players.PlayerAdded:Connect(hookPlayer)

	Players.PlayerRemoving:Connect(function(player)
		HexFlightService.endFlight(player, false)
	end)
end

return HexFlightService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">IcemanService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Iceman (Bobby Drake) — Chill / Freeze pressure hero.
	Q Ice Shards — one shard, stacks Chill
	E Ice Wall — anchored wall wherever you aim, ground or mid-air
	F Ice Slide — camera-aimed skate (not flight); ice path is visual only
	T Cryo Stream — hold frontal chill cone (hands particle FX)
	C Ice Form — toggle, double health, ice material + blue body
	X Absolute Zero — expanding ice circle from caster
	V Flash Freeze — freeze one target solid
	G Shatter — spend Chill on nearby foes for burst damage
	Passive Sub-Zero Body — immune to Chill

	All visuals here are PARTICLE_PLACEHOLDER parts until Assets.IceMan is filled in.
]]

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local FrostStatus = require(ReplicatedStorage.Shared.FrostStatus)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local ProjectileHelper = require(ReplicatedStorage.Shared.ProjectileHelper)
local PushHelper = require(ReplicatedStorage.Shared.PushHelper)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)
local CharacterService = require(script.Parent.CharacterService)

local IcemanService = {}

type StreamState = {
	character: Model,
	handFx: { Instance },
	aimPoint: Vector3,
	lastTick: number,
	baseAutoRotate: boolean?,
	faceAtt: Attachment?,
	faceAlign: AlignOrientation?,
	animTrack: AnimationTrack?,
}

type SlideBeamFx = {
	leftStart: Attachment,
	rightStart: Attachment,
	backHost: BasePart,
	frontHost: BasePart,
	backEnd: Attachment,
	frontEnd: Attachment,
	backBeam: Beam,
	frontBeam: Beam,
}

type SlideState = {
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	baseWalk: number,
	baseAutoRotate: boolean,
	moveDir: Vector3,
	lookDir: Vector3,
	lastSlabAt: number,
	faceAtt: Attachment,
	faceAlign: AlignOrientation,
	animTrack: AnimationTrack?,
	beamFx: SlideBeamFx?,
}

type FormPartLook = {
	material: Enum.Material,
	color: Color3,
}

type FormState = {
	character: Model,
	baseMaxHealth: number,
	endsAt: number,
	lastAuraAt: number,
	parts: { [BasePart]: FormPartLook },
}

type BlizzardState = {
	character: Model,
	center: Vector3,
	part: BasePart,
	startedAt: number,
	endsAt: number,
	lastTick: number,
}

local streamByPlayer: { [Player]: StreamState } = {}
local slideByPlayer: { [Player]: SlideState } = {}
local formByPlayer: { [Player]: FormState } = {}
local blizzardByPlayer: { [Player]: BlizzardState } = {}
local wallsByPlayer: { [Player]: { BasePart } } = {}

-- Toggles / stances that should not block (or be blocked by) other casts
local NON_BLOCKING: { [string]: boolean } = {
	ice_slide = true,
	ice_form = true,
}

----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------
local function getRoot(model: Model?): BasePart?
	if not model then
		return nil
	end
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return model.PrimaryPart
end

local function getHand(character: Model, preferRight: boolean): BasePart?
	local names = if preferRight
		then { "RightHand", "Right Arm", "RightLowerArm" }
		else { "LeftHand", "Left Arm", "LeftLowerArm" }
	for _, name in names do
		local p = character:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return getRoot(character)
end

local function getFootPosition(character: Model): Vector3
	local root = getRoot(character)
	if not root then
		return character:GetPivot().Position
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local cast = Workspace:Raycast(root.Position + Vector3.new(0, 1, 0), Vector3.new(0, -14, 0), params)
	if cast then
		return cast.Position + Vector3.new(0, 0.05, 0)
	end
	local hum = CombatHelper.getHumanoid(character)
	local drop = if hum then (hum.HipHeight + root.Size.Y * 0.5) else 3
	return root.Position - Vector3.new(0, drop, 0)
end

local function isRealTarget(victim: Model, caster: Model): boolean
	if victim == caster then
		return false
	end
	if victim:GetAttribute("LokiUltClone") == true or victim:GetAttribute("LokiDecoy") == true then
		return false
	end
	if victim:GetAttribute("FearVisual") == true or victim.Name == "FearClone" then
		return false
	end
	if victim:GetAttribute(GameConstants.MG_ASTRAL_ATTRIBUTE) == true then
		return false
	end
	return true
end

local function resolveAimDir(character: Model, direction: Vector3?, aimPoint: Vector3?): Vector3
	local root = getRoot(character)
	local origin = if root then root.Position else character:GetPivot().Position
	if aimPoint then
		local d = aimPoint - origin
		if d.Magnitude > 0.05 then
			return d.Unit
		end
	end
	if direction and direction.Magnitude > 0.05 then
		return direction.Unit
	end
	if root then
		return root.CFrame.LookVector
	end
	return Vector3.new(0, 0, -1)
end

local function getIceManAsset(assetName: string): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("IceMan")
	return if folder then folder:FindFirstChild(assetName) else nil
end

local function getIceManAttachment(assetName: string): Attachment?
	local inst = getIceManAsset(assetName)
	if inst and inst:IsA("Attachment") then
		return inst
	end
	if inst then
		local nested = inst:FindFirstChildWhichIsA("Attachment", true)
		if nested then
			return nested
		end
	end
	return nil
end

local function cloneIceManAttachment(assetName: string): Attachment?
	local template = getIceManAttachment(assetName)
	if not template then
		return nil
	end
	return template:Clone()
end

local function getIceManPart(assetName: string): BasePart?
	local ice = getIceManAsset(assetName)
	if ice and ice:IsA("BasePart") then
		return ice
	end
	return nil
end

local function refundEnergy(character: Model, amount: number)
	if amount <= 0 then
		return
	end
	local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
	local maxEnergy = character:GetAttribute(GameConstants.MAX_ENERGY_ATTRIBUTE)
	if type(energy) ~= "number" then
		return
	end
	local cap = if type(maxEnergy) == "number" then maxEnergy else 100
	character:SetAttribute(GameConstants.ENERGY_ATTRIBUTE, math.min(cap, energy + amount))
end

local function playAbilityAnim(humanoid: Humanoid, animId: string, looped: boolean): AnimationTrack?
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = animId
	local ok, track = pcall(function()
		return (animator :: Animator):LoadAnimation(anim)
	end)
	anim:Destroy()
	if not ok or not track then
		return nil
	end
	track.Priority = Enum.AnimationPriority.Action
	track.Looped = looped
	track:Play(0.15, 1, 1)
	return track
end

local function makeTipHost(name: string): (BasePart, Attachment)
	local host = Instance.new("Part")
	host.Name = name
	host.Size = Vector3.new(0.2, 0.2, 0.2)
	host.Transparency = 1
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.CastShadow = false
	host.Parent = Workspace
	local att = Instance.new("Attachment")
	att.Name = name .. "Att"
	att.Parent = host
	return host, att
end

local function makeIceSlideBeam(startParent: BasePart, endAtt: Attachment, name: string): (Attachment, Beam)
	local startAtt = Instance.new("Attachment")
	startAtt.Name = name .. "Start"
	startAtt.Parent = startParent
	local beam = Instance.new("Beam")
	beam.Name = name
	beam.Attachment0 = startAtt
	beam.Attachment1 = endAtt
	beam.Width0 = 0.35
	beam.Width1 = 0.85
	beam.FaceCamera = true
	beam.LightEmission = 0.55
	beam.LightInfluence = 0
	beam.Color = ColorSequence.new(GameConstants.ICE_COLOR)
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 0.65),
	})
	beam.Enabled = true
	beam.Parent = startAtt
	return startAtt, beam
end

local function getSlidePathPoint(character: Model, cameraLook: Vector3, lead: number): Vector3
	local root = getRoot(character)
	if not root then
		return character:GetPivot().Position
	end
	local hum = CombatHelper.getHumanoid(character)
	local drop = if hum then (hum.HipHeight + root.Size.Y * 0.5) else 3
	local flat = Vector3.new(cameraLook.X, 0, cameraLook.Z)
	if flat.Magnitude < 0.05 then
		local look = root.CFrame.LookVector
		flat = Vector3.new(look.X, 0, look.Z)
	end
	if flat.Magnitude < 0.05 then
		flat = Vector3.new(0, 0, -1)
	else
		flat = flat.Unit
	end
	return root.Position - Vector3.new(0, drop, 0) + flat * lead
end

local function clearSlideBeamFx(fx: SlideBeamFx?)
	if not fx then
		return
	end
	if fx.leftStart.Parent then
		fx.leftStart:Destroy()
	end
	if fx.rightStart.Parent then
		fx.rightStart:Destroy()
	end
	if fx.backHost.Parent then
		fx.backHost:Destroy()
	end
	if fx.frontHost.Parent then
		fx.frontHost:Destroy()
	end
end

local function attachCryoStreamParticle(hand: BasePart): Instance?
	local template = getIceManAsset("CryoStreamParticle")
	if not template then
		warn("[IcemanService] Missing ReplicatedStorage.Assets.IceMan.CryoStreamParticle")
		return nil
	end
	local clone = template:Clone()
	clone.Name = "CryoStreamParticle"
	if clone:IsA("Attachment") then
		clone.Position = Vector3.zero
		clone.Orientation = Vector3.zero
		clone.Parent = hand
	elseif clone:IsA("ParticleEmitter") then
		clone.Parent = hand
	else
		clone.Parent = hand
		local nested = clone:FindFirstChildWhichIsA("Attachment", true)
		if nested then
			nested.Position = Vector3.zero
			nested.Orientation = Vector3.zero
		end
	end
	VfxHelper.setParticlesEnabled(clone, true)
	VfxHelper.emitAllParticles(clone, 10)
	return clone
end

--[[ PARTICLE_PLACEHOLDER: expanding ice orb, stands in for Assets.IceMan impact FX. ]]
local function iceBurst(pos: Vector3, radius: number)
	local r = math.clamp(radius, 1, 30)
	local orb = Instance.new("Part")
	orb.Name = "IcePlaceholderBurst"
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.new(r * 0.5, r * 0.5, r * 0.5)
	orb.CFrame = CFrame.new(pos)
	orb.Anchored = true
	orb.CanCollide = false
	orb.CanQuery = false
	orb.CanTouch = false
	orb.CastShadow = false
	orb.Material = Enum.Material.Ice
	orb.Color = GameConstants.ICE_COLOR
	orb.Transparency = 0.35
	orb.Parent = Workspace
	TweenService:Create(orb, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(r * 2, r * 2, r * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(orb, 0.5)
end

local function fireCameraShake(player: Player, intensity: number?, duration: number?)
	Remotes.getEvent("CameraShake"):FireClient(player, {
		intensity = intensity or 0.45,
		duration = duration or 0.3,
	})
end

local function canUse(character: Model, abilityId: string, energy: number): boolean
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "iceman" then
		return false
	end
	if CombatHelper.arePowersDisabled(character) then
		return false
	end
	if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return false
	end
	if AbilityCooldownHelper.isOnCooldown(character, abilityId) then
		return false
	end
	if AbilityCooldownHelper.isActive(character, abilityId) then
		return false
	end
	-- One cast at a time; stances (slide / form) are exempt both ways
	for _, ab in CharacterRegistry.getAbilities("iceman") do
		if ab.passive or ab.id == abilityId or NON_BLOCKING[ab.id] then
			continue
		end
		if AbilityCooldownHelper.isActive(character, ab.id) then
			return false
		end
	end
	if energy > 0 and not CharacterService.spendEnergy(character, energy) then
		return false
	end
	return true
end

local function finishAbility(character: Model, abilityId: string, cooldown: number)
	AbilityCooldownHelper.setActive(character, abilityId, false)
	AbilityCooldownHelper.applyAfterUse(character, abilityId, cooldown)
	CharacterService.markAbilityUse(character)
end

----------------------------------------------------------------
-- Q Ice Shards
----------------------------------------------------------------
local function castIceShards(player: Player, direction: Vector3?, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("iceman", "ice_shards")
	if not entry or not canUse(character, entry.id, GameConstants.ICE_SHARD_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)

	local hand = getHand(character, true)
	local origin = if hand then hand.Position else character:GetPivot().Position
	local dir = resolveAimDir(character, direction, aimPoint)
	if aimPoint then
		local toAim = aimPoint - origin
		if toAim.Magnitude > 0.05 then
			dir = toAim.Unit
		end
	end

	ProjectileHelper.spawn(origin, dir, {
		speed = GameConstants.ICE_SHARD_SPEED,
		damage = GameConstants.ICE_SHARD_DAMAGE,
		radius = GameConstants.ICE_SHARD_HIT_RADIUS,
		maxDistance = GameConstants.ICE_SHARD_RANGE,
		owner = character,
		color = GameConstants.ICE_COLOR,
		homeDir = dir,
		homePoint = aimPoint or (origin + dir * 60),
		homeAfter = 0,
		boltFolder = "IceMan",
		boltAsset = "IceShard",
		impactFx = "none",
		deleteAfterFx = GameConstants.ICE_SHARD_DELETE_AFTER_FX,
		onHit = function(victim: Model, hitPos: Vector3)
			FrostStatus.addChill(victim, GameConstants.ICE_SHARD_CHILL)
			iceBurst(hitPos, 2.5)
		end,
	})

	finishAbility(character, entry.id, GameConstants.ICE_SHARD_COOLDOWN)
end

----------------------------------------------------------------
-- E Ice Wall
----------------------------------------------------------------
local function retireWall(wall: BasePart)
	if not wall.Parent then
		return
	end
	wall.CanCollide = false
	TweenService:Create(wall, TweenInfo.new(GameConstants.ICE_WALL_FADE), { Transparency = 1 }):Play()
	Debris:AddItem(wall, GameConstants.ICE_WALL_FADE + 0.2)
end

local function trackWall(player: Player, wall: BasePart)
	local list = wallsByPlayer[player]
	if not list then
		list = {}
		wallsByPlayer[player] = list
	end
	for i = #list, 1, -1 do
		if not list[i].Parent then
			table.remove(list, i)
		end
	end
	table.insert(list, wall)
end

local function castIceWall(player: Player, direction: Vector3?, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("iceman", "ice_wall")
	if not entry or not canUse(character, entry.id, GameConstants.ICE_WALL_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)

	local root = getRoot(character)
	local origin = if root then root.Position else character:GetPivot().Position
	-- Always rise square in front of the body (character facing), not under the camera
	local look = if root then root.CFrame.LookVector else character:GetPivot().LookVector
	local facing = Vector3.new(look.X, 0, look.Z)
	if facing.Magnitude < 0.05 then
		facing = Vector3.new(0, 0, -1)
	else
		facing = facing.Unit
	end

	local height = GameConstants.ICE_WALL_HEIGHT
	local front = GameConstants.ICE_WALL_FRONT_DISTANCE
	local spot = origin + facing * front

	-- Must plant on solid ground — no mid-air walls
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local probe = GameConstants.ICE_WALL_GROUND_PROBE
	local snap = GameConstants.ICE_WALL_GROUND_SNAP
	local ground = Workspace:Raycast(spot + Vector3.new(0, probe, 0), Vector3.new(0, -(snap + probe), 0), params)
	if not ground then
		AbilityCooldownHelper.setActive(character, entry.id, false)
		refundEnergy(character, GameConstants.ICE_WALL_ENERGY)
		return
	end
	local basePos = ground.Position

	local center = basePos + Vector3.new(0, height * 0.5, 0)
	local finalCf = CFrame.lookAt(center, center + facing)

	local width = GameConstants.ICE_WALL_WIDTH
	local thickness = GameConstants.ICE_WALL_THICKNESS

	local template = getIceManPart("Ice")
	local wall: BasePart
	if template then
		wall = template:Clone()
	else
		wall = Instance.new("Part")
		wall.Material = Enum.Material.Ice
		wall.Color = GameConstants.ICE_COLOR
		wall.Transparency = 0.25
	end
	wall.Name = "IceWall"
	wall.Size = Vector3.new(width, 0.5, thickness)
	wall.CFrame = CFrame.lookAt(basePos + Vector3.new(0, 0.25, 0), basePos + Vector3.new(0, 0.25, 0) + facing)
	wall.Anchored = true
	wall.CanCollide = true
	wall.CanQuery = true
	wall.CanTouch = false
	wall.CastShadow = false
	wall.Color = GameConstants.ICE_COLOR
	wall:SetAttribute("OwnerUserId", player.UserId)
	wall.Parent = Workspace

	-- Grow up out of the ground
	TweenService:Create(
		wall,
		TweenInfo.new(GameConstants.ICE_WALL_RISE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = finalCf, Size = Vector3.new(width, height, thickness) }
	):Play()
	iceBurst(basePos, 5)
	trackWall(player, wall)

	task.delay(GameConstants.ICE_WALL_DURATION, function()
		retireWall(wall)
	end)

	finishAbility(character, entry.id, GameConstants.ICE_WALL_COOLDOWN)
end

----------------------------------------------------------------
-- F Ice Slide (camera-aimed skate — humanoid stays free; slabs are visual)
----------------------------------------------------------------
local function createYawAlign(root: BasePart, namePrefix: string): (Attachment, AlignOrientation)
	local att = Instance.new("Attachment")
	att.Name = namePrefix .. "Att"
	att.Parent = root

	local align = Instance.new("AlignOrientation")
	align.Name = namePrefix .. "Align"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.RigidityEnabled = false
	align.MaxTorque = 200000
	align.Responsiveness = 18
	align.CFrame = CFrame.new(root.Position) * (root.CFrame - root.Position)
	align.Parent = root
	return att, align
end

local function setYawAlign(align: AlignOrientation, root: BasePart, lookFlat: Vector3)
	local face = Vector3.new(lookFlat.X, 0, lookFlat.Z)
	if face.Magnitude < 0.05 then
		return
	end
	face = face.Unit
	local lookCf = CFrame.lookAt(root.Position, root.Position + face)
	local _p, yaw, _r = lookCf:ToOrientation()
	-- Pitch locked to 0 — upright skate
	align.CFrame = CFrame.new(root.Position) * CFrame.fromOrientation(0, yaw, 0)
end

local function playSlideAnim(humanoid: Humanoid): AnimationTrack?
	return playAbilityAnim(humanoid, GameConstants.ICE_SLIDE_ANIM, true)
end

local function stopIceSlide(player: Player, applyCooldown: boolean?)
	local state = slideByPlayer[player]
	slideByPlayer[player] = nil

	local function clearAttrs(char: Model?)
		if char and char.Parent then
			char:SetAttribute(GameConstants.ICE_SLIDE_ATTRIBUTE, nil)
			AbilityCooldownHelper.setActive(char, "ice_slide", false)
		end
	end

	if not state then
		clearAttrs(player.Character)
		return
	end

	local character = state.character
	clearAttrs(character)
	clearSlideBeamFx(state.beamFx)

	if state.animTrack then
		state.animTrack:Stop(0.15)
		state.animTrack:Destroy()
	end
	if state.faceAlign.Parent then
		state.faceAlign:Destroy()
	end
	if state.faceAtt.Parent then
		state.faceAtt:Destroy()
	end

	local hum = state.humanoid
	if hum.Parent then
		hum.WalkSpeed = state.baseWalk
		hum.AutoRotate = state.baseAutoRotate
	end

	if applyCooldown and character.Parent then
		AbilityCooldownHelper.applyAfterUse(character, "ice_slide", GameConstants.ICE_SLIDE_COOLDOWN)
		CharacterService.markAbilityUse(character)
	end
end

local function startIceSlide(player: Player)
	local character = player.Character
	if not character then
		return
	end
	if slideByPlayer[player] then
		stopIceSlide(player, true)
		return
	end
	local entry = CharacterRegistry.getAbilityById("iceman", "ice_slide")
	if not entry or not canUse(character, entry.id, 0) then
		return
	end
	local root = getRoot(character)
	local hum = CombatHelper.getHumanoid(character)
	if not root or not hum or hum.Health <= 0 then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	character:SetAttribute(GameConstants.ICE_SLIDE_ATTRIBUTE, true)

	local faceAtt, faceAlign = createYawAlign(root, "IceSlide")
	local baseAutoRotate = hum.AutoRotate
	local baseWalk = hum.WalkSpeed
	hum.AutoRotate = false
	hum.WalkSpeed = GameConstants.ICE_SLIDE_SPEED

	local beamFx: SlideBeamFx? = nil
	local leftHand = getHand(character, false)
	local rightHand = getHand(character, true)
	if leftHand and rightHand then
		local backHost, backEnd = makeTipHost("IceSlideBackTip")
		local frontHost, frontEnd = makeTipHost("IceSlideFrontTip")
		local leftStart, backBeam = makeIceSlideBeam(leftHand, backEnd, "IceSlideBackBeam")
		local rightStart, frontBeam = makeIceSlideBeam(rightHand, frontEnd, "IceSlideFrontBeam")
		local look = root.CFrame.LookVector
		backHost.CFrame = CFrame.new(getSlidePathPoint(character, look, -GameConstants.ICE_SLIDE_SLAB_LEAD))
		frontHost.CFrame = CFrame.new(getSlidePathPoint(character, look, GameConstants.ICE_SLIDE_SLAB_LEAD))
		beamFx = {
			leftStart = leftStart,
			rightStart = rightStart,
			backHost = backHost,
			frontHost = frontHost,
			backEnd = backEnd,
			frontEnd = frontEnd,
			backBeam = backBeam,
			frontBeam = frontBeam,
		}
	end

	slideByPlayer[player] = {
		character = character,
		humanoid = hum,
		root = root,
		baseWalk = baseWalk,
		baseAutoRotate = baseAutoRotate,
		moveDir = Vector3.zero,
		lookDir = root.CFrame.LookVector,
		lastSlabAt = 0,
		faceAtt = faceAtt,
		faceAlign = faceAlign,
		animTrack = playSlideAnim(hum),
		beamFx = beamFx,
	}
end

function IcemanService.setSlideInput(player: Player, moveDir: Vector3, lookDir: Vector3)
	local state = slideByPlayer[player]
	if not state then
		return
	end
	state.moveDir = moveDir
	state.lookDir = lookDir
end

--[[ Visual ice path under / ahead of the skater — facing follows camera look. ]]
local function spawnSlideSlab(character: Model, cameraLook: Vector3)
	local root = getRoot(character)
	if not root then
		return
	end
	local flat = Vector3.new(cameraLook.X, 0, cameraLook.Z)
	if flat.Magnitude < 0.05 then
		local look = root.CFrame.LookVector
		flat = Vector3.new(look.X, 0, look.Z)
	end
	if flat.Magnitude < 0.05 then
		flat = Vector3.new(0, 0, -1)
	else
		flat = flat.Unit
	end

	local pos = getSlidePathPoint(character, cameraLook, GameConstants.ICE_SLIDE_SLAB_LEAD)
	local size = GameConstants.ICE_SLIDE_SLAB_SIZE
	local slab = Instance.new("Part")
	slab.Name = "IceSlideSlab"
	slab.Size = size
	-- Yaw from camera; slight pitch so looking up/down tips the visual path
	local pitch = math.clamp(math.asin(math.clamp(cameraLook.Y, -0.95, 0.95)), math.rad(-35), math.rad(35))
	local lookCf = CFrame.lookAt(Vector3.zero, flat)
	local _p, yaw, _r = lookCf:ToOrientation()
	slab.CFrame = CFrame.new(pos - Vector3.new(0, size.Y * 0.5, 0)) * CFrame.fromOrientation(pitch, yaw, 0)
	slab.Anchored = true
	slab.CanCollide = false
	slab.CanQuery = false
	slab.CanTouch = false
	slab.CastShadow = false
	slab.Material = Enum.Material.Ice
	slab.Color = GameConstants.ICE_COLOR_SOFT
	slab.Transparency = 0.35
	slab.Parent = Workspace

	TweenService:Create(slab, TweenInfo.new(GameConstants.ICE_SLIDE_SLAB_LIFE), { Transparency = 1 }):Play()
	Debris:AddItem(slab, GameConstants.ICE_SLIDE_SLAB_LIFE + 0.2)
end

----------------------------------------------------------------
-- T Cryo Stream (frontal chill cone + hand particles)
----------------------------------------------------------------
local CRYO_FX_FADE = 0.35

local function fadeOutCryoStreamFx(state: StreamState)
	for _, fx in state.handFx do
		VfxHelper.setParticlesEnabled(fx, false)
		VfxHelper.smoothDisableParticles(fx, CRYO_FX_FADE)
	end
	task.delay(CRYO_FX_FADE, function()
		for _, fx in state.handFx do
			if fx.Parent then
				fx:Destroy()
			end
		end
	end)
end

local function stopCryoStream(player: Player, applyCooldown: boolean?)
	local state = streamByPlayer[player]
	if not state then
		return
	end
	streamByPlayer[player] = nil

	local character = state.character
	local hum = CombatHelper.getHumanoid(character)
	if hum and hum.Parent and state.baseAutoRotate ~= nil then
		hum.AutoRotate = state.baseAutoRotate
	end
	if state.animTrack then
		state.animTrack:Stop(0.15)
		state.animTrack:Destroy()
	end
	if state.faceAlign and state.faceAlign.Parent then
		state.faceAlign:Destroy()
	end
	if state.faceAtt and state.faceAtt.Parent then
		state.faceAtt:Destroy()
	end

	fadeOutCryoStreamFx(state)

	if character.Parent then
		AbilityCooldownHelper.setActive(character, "cryo_stream", false)
		if applyCooldown then
			AbilityCooldownHelper.applyAfterUse(character, "cryo_stream", GameConstants.ICE_STREAM_COOLDOWN)
			CharacterService.markAbilityUse(character)
		end
	end
end

local function startCryoStream(player: Player, aimPoint: Vector3)
	local character = player.Character
	if not character or streamByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById("iceman", "cryo_stream")
	if not entry or not canUse(character, entry.id, entry.energyCost) then
		return
	end

	local rightHand = getHand(character, true)
	local leftHand = getHand(character, false)
	if not rightHand and not leftHand then
		refundEnergy(character, entry.energyCost)
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)

	local hum = CombatHelper.getHumanoid(character)
	local root = getRoot(character)
	local baseAutoRotate: boolean? = nil
	local faceAtt: Attachment? = nil
	local faceAlign: AlignOrientation? = nil
	if hum then
		baseAutoRotate = hum.AutoRotate
		hum.AutoRotate = false
	end
	if root then
		faceAtt, faceAlign = createYawAlign(root, "CryoStream")
	end

	local handFx: { Instance } = {}
	if rightHand then
		local fx = attachCryoStreamParticle(rightHand)
		if fx then
			table.insert(handFx, fx)
		end
	end
	if leftHand and leftHand ~= rightHand then
		local fx = attachCryoStreamParticle(leftHand)
		if fx then
			table.insert(handFx, fx)
		end
	end
	if #handFx == 0 then
		warn("[IcemanService] CryoStreamParticle failed to attach")
	end

	local animTrack: AnimationTrack? = nil
	if hum then
		animTrack = playAbilityAnim(hum, GameConstants.ICE_STREAM_ANIM, true)
	end

	streamByPlayer[player] = {
		character = character,
		handFx = handFx,
		aimPoint = aimPoint,
		lastTick = AbilityCooldownHelper.getNow(),
		baseAutoRotate = baseAutoRotate,
		faceAtt = faceAtt,
		faceAlign = faceAlign,
		animTrack = animTrack,
	}
end

----------------------------------------------------------------
-- C Ice Form (toggle — double health)
----------------------------------------------------------------
--[[
	Turn only body MeshParts to ice (direct children of the character).
	Accessories / Handle parts are left alone.
]]
local function applyIceLook(character: Model): { [BasePart]: FormPartLook }
	local saved: { [BasePart]: FormPartLook } = {}
	for _, part in FrostStatus.getBodyParts(character) do
		saved[part] = {
			material = part.Material,
			color = part.Color,
		}
		part.Material = Enum.Material.Ice
		part.Color = GameConstants.ICE_COLOR
	end
	return saved
end

local function stopIceForm(player: Player, applyCooldown: boolean?)
	local state = formByPlayer[player]
	if not state then
		return
	end
	formByPlayer[player] = nil

	local character = state.character
	local hum = CombatHelper.getHumanoid(character)
	if hum and hum.Parent then
		local ratio = if hum.MaxHealth > 0 then math.clamp(hum.Health / hum.MaxHealth, 0, 1) else 1
		hum.MaxHealth = state.baseMaxHealth
		hum.Health = math.clamp(state.baseMaxHealth * ratio, 1, state.baseMaxHealth)
	end
	for part, look in state.parts do
		if part.Parent then
			part.Material = look.material
			part.Color = look.color
		end
	end
	if character.Parent then
		character:SetAttribute(GameConstants.ICE_FORM_ATTRIBUTE, nil)
		character:SetAttribute(GameConstants.ICE_FORM_UNTIL_ATTRIBUTE, nil)
		AbilityCooldownHelper.setActive(character, "ice_form", false)
		if applyCooldown then
			AbilityCooldownHelper.applyAfterUse(character, "ice_form", GameConstants.ICE_FORM_COOLDOWN)
			CharacterService.markAbilityUse(character)
		end
	end
end

local function startIceForm(player: Player)
	local character = player.Character
	if not character then
		return
	end
	if formByPlayer[player] then
		stopIceForm(player, true)
		return
	end
	local entry = CharacterRegistry.getAbilityById("iceman", "ice_form")
	if not entry or not canUse(character, entry.id, 0) then
		return
	end
	local hum = CombatHelper.getHumanoid(character)
	if not hum or hum.Health <= 0 then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)

	-- Percentage HP scale only — Ice Form is not a heal / regen ability
	local base = hum.MaxHealth
	local ratio = if base > 0 then math.clamp(hum.Health / base, 0, 1) else 1
	local newMax = base * GameConstants.ICE_FORM_HEALTH_MULT
	hum.MaxHealth = newMax
	hum.Health = math.clamp(newMax * ratio, 1, newMax)

	local endsAt = AbilityCooldownHelper.getNow() + GameConstants.ICE_FORM_DURATION
	character:SetAttribute(GameConstants.ICE_FORM_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.ICE_FORM_UNTIL_ATTRIBUTE, endsAt)

	formByPlayer[player] = {
		character = character,
		baseMaxHealth = base,
		endsAt = endsAt,
		lastAuraAt = 0,
		parts = applyIceLook(character),
	}
	iceBurst(character:GetPivot().Position, 6)
end

----------------------------------------------------------------
-- V Flash Freeze (shard → soft shove like Blinding Flash + cascade freeze)
----------------------------------------------------------------
--[[ Face the caster and get shoved outward while ice climbs the body. ]]
local function applyFlashFreezeStruggle(victim: Model, burstPos: Vector3)
	local vRoot = getRoot(victim)
	local hum = CombatHelper.getHumanoid(victim)
	if not vRoot or not hum or hum.Health <= 0 then
		return
	end

	local away = vRoot.Position - burstPos
	local flat = Vector3.new(away.X, 0, away.Z)
	if flat.Magnitude < 0.08 then
		local look = vRoot.CFrame.LookVector
		flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.08 then
			flat = Vector3.new(0, 0, -1)
		end
	end
	flat = flat.Unit

	local att = Instance.new("Attachment")
	att.Name = "IceFlashStruggleAtt"
	att.Parent = vRoot

	local align = Instance.new("AlignOrientation")
	align.Name = "IceFlashStruggleAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.RigidityEnabled = false
	align.MaxTorque = 120000
	align.Responsiveness = 14
	align.CFrame = CFrame.lookAt(vRoot.Position, Vector3.new(burstPos.X, vRoot.Position.Y, burstPos.Z))
	align.Parent = vRoot

	local speed = GameConstants.ICE_FLASH_PUSH_SPEED
	local up = GameConstants.ICE_FLASH_PUSH_UP
	vRoot.AssemblyLinearVelocity = flat * speed + Vector3.new(0, up, 0)

	local token = (victim:GetAttribute("IceFlashStruggleToken") :: number?) or 0
	token += 1
	victim:SetAttribute("IceFlashStruggleToken", token)

	task.spawn(function()
		local t0 = os.clock()
		local dur = GameConstants.ICE_FLASH_STRUGGLE_TIME
		while os.clock() - t0 < dur do
			if not vRoot.Parent or not victim.Parent then
				break
			end
			if victim:GetAttribute("IceFlashStruggleToken") ~= token then
				break
			end
			if not FrostStatus.isFrozen(victim) then
				break
			end
			local elapsed = os.clock() - t0
			local wobble = math.sin(elapsed * 16) * 0.18
			local facePos = Vector3.new(burstPos.X, vRoot.Position.Y, burstPos.Z)
			if (facePos - vRoot.Position).Magnitude > 0.05 then
				align.CFrame = CFrame.lookAt(vRoot.Position, facePos) * CFrame.Angles(wobble * 0.35, wobble, 0)
			end
			if hum.Parent then
				hum:Move(Vector3.zero, false)
				hum.WalkSpeed = 0
			end
			-- Don't fight seal() once it anchors
			if not vRoot.Anchored then
				local vel = vRoot.AssemblyLinearVelocity
				local retain = math.clamp(1 - elapsed / dur, 0.25, 1)
				vRoot.AssemblyLinearVelocity =
					Vector3.new(flat.X * speed * 0.55 * retain, math.max(vel.Y, 1.5), flat.Z * speed * 0.55 * retain)
			end
			task.wait()
		end
		if align.Parent then
			align:Destroy()
		end
		if att.Parent then
			att:Destroy()
		end
		-- Lock solid after the shove
		if victim.Parent and FrostStatus.isFrozen(victim) and victim:GetAttribute("IceFlashStruggleToken") == token then
			FrostStatus.seal(victim)
		end
	end)
end

local function castFlashFreeze(player: Player, direction: Vector3?, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("iceman", "flash_freeze")
	if not entry or not canUse(character, entry.id, GameConstants.ICE_FLASH_FREEZE_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)

	local hand = getHand(character, true)
	local origin = if hand then hand.Position else character:GetPivot().Position
	local dir = resolveAimDir(character, direction, aimPoint)
	if aimPoint then
		local toAim = aimPoint - origin
		if toAim.Magnitude > 0.05 then
			dir = toAim.Unit
		end
	end

	ProjectileHelper.spawn(origin, dir, {
		speed = GameConstants.ICE_FLASH_FREEZE_SPEED,
		damage = GameConstants.ICE_FLASH_FREEZE_DAMAGE,
		radius = GameConstants.ICE_FLASH_FREEZE_HIT_RADIUS,
		maxDistance = GameConstants.ICE_FLASH_FREEZE_RANGE,
		owner = character,
		color = GameConstants.ICE_COLOR,
		homeDir = dir,
		homePoint = aimPoint or (origin + dir * 60),
		homeAfter = 0,
		boltFolder = "IceMan",
		boltAsset = "IceShard",
		impactFx = "none",
		deleteAfterFx = GameConstants.ICE_SHARD_DELETE_AFTER_FX,
		onHit = function(victim: Model, hitPos: Vector3)
			if not isRealTarget(victim, character) or FrostStatus.isImmune(victim) or CombatHelper.isShielded(victim) then
				return
			end
			iceBurst(hitPos, 4)
			local victimPlayer = Players:GetPlayerFromCharacter(victim)
			if victimPlayer then
				fireCameraShake(victimPlayer, 0.55, 0.35)
			end
			-- Soft freeze (shells climb feet→head) while the shove plays out, then seal
			if FrostStatus.freeze(victim, GameConstants.ICE_FLASH_FREEZE_DURATION, { allowMotion = true }) then
				applyFlashFreezeStruggle(victim, origin)
			end
		end,
	})

	finishAbility(character, entry.id, GameConstants.ICE_FLASH_FREEZE_COOLDOWN)
end

----------------------------------------------------------------
-- G Shatter
----------------------------------------------------------------
--[[ Clone ShatterAttachment onto HRP; smooth-disable at 0.2s, delete at 5s. ]]
local function playShatterAttachment(root: BasePart)
	local template = getIceManAttachment("ShatterAttachment")
	if not template then
		warn("[IcemanService] Missing ReplicatedStorage.Assets.IceMan.ShatterAttachment")
		return
	end
	local att = template:Clone()
	att.Name = "ShatterAttachment"
	att.Position = Vector3.zero
	att.Orientation = Vector3.zero
	att.Parent = root
	VfxHelper.setParticlesEnabled(att, true)
	VfxHelper.emitAllParticles(att, 18)
	task.delay(0.05, function()
		if att.Parent then
			VfxHelper.smoothDisableParticles(att, 0.08)
		end
	end)
	task.delay(1.5, function()
		if att.Parent then
			att:Destroy()
		end
	end)
end

local function castShatter(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("iceman", "shatter")
	if not entry or not canUse(character, entry.id, GameConstants.ICE_SHATTER_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)

	local root = getRoot(character)
	local center = if root then root.Position else character:GetPivot().Position
	if root then
		playShatterAttachment(root)
	end
	iceBurst(center, GameConstants.ICE_SHATTER_RADIUS * 0.6)
	fireCameraShake(player, 0.5, 0.3)

	for _, victim in CombatHelper.overlapCharacters(center, GameConstants.ICE_SHATTER_RADIUS, character) do
		if not isRealTarget(victim, character) then
			continue
		end
		local chill, wasFrozen, shells = FrostStatus.consumeChill(victim)
		if chill <= 0 and not wasFrozen then
			continue
		end

		local damage = math.max(GameConstants.ICE_SHATTER_MIN_DAMAGE, chill * GameConstants.ICE_SHATTER_CHILL_MULT)
		if wasFrozen then
			damage += GameConstants.ICE_SHATTER_FROZEN_BONUS
		end

		local vRoot = getRoot(victim)
		local hitPos = if vRoot then vRoot.Position else victim:GetPivot().Position
		CombatHelper.dealDamage(character, victim, damage, center, "projectile")
		iceBurst(hitPos, 4)

		if #shells > 0 then
			FrostStatus.flingShells(shells)
		end

		if not CombatHelper.isShielded(victim) then
			local away = hitPos - center
			if away.Magnitude < 0.05 then
				away = Vector3.new(0, 0, -1)
			end
			PushHelper.applyToCharacter(victim, away, {
				speed = GameConstants.ICE_SHATTER_PUSH_SPEED,
				upBoost = GameConstants.ICE_SHATTER_PUSH_UP,
			})
		end
	end

	finishAbility(character, entry.id, GameConstants.ICE_SHATTER_COOLDOWN)
end

----------------------------------------------------------------
-- X Absolute Zero
----------------------------------------------------------------
local function endBlizzard(player: Player, applyCooldown: boolean?)
	local state = blizzardByPlayer[player]
	if not state then
		return
	end
	blizzardByPlayer[player] = nil

	if state.part.Parent then
		TweenService:Create(state.part, TweenInfo.new(0.6), { Transparency = 1 }):Play()
		Debris:AddItem(state.part, 0.8)
	end
	local character = state.character
	if character.Parent then
		AbilityCooldownHelper.setActive(character, "absolute_zero", false)
		if applyCooldown then
			AbilityCooldownHelper.applyAfterUse(character, "absolute_zero", GameConstants.ICE_BLIZZARD_COOLDOWN)
			CharacterService.markAbilityUse(character)
		end
	end
end

local function castAbsoluteZero(player: Player)
	local character = player.Character
	if not character or blizzardByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById("iceman", "absolute_zero")
	if not entry or not canUse(character, entry.id, GameConstants.ICE_BLIZZARD_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)

	local center = getFootPosition(character)

	-- PARTICLE_PLACEHOLDER: flat ice disc that grows out from Iceman
	local zone = Instance.new("Part")
	zone.Name = "AbsoluteZeroField"
	zone.Shape = Enum.PartType.Cylinder
	local thick = GameConstants.ICE_BLIZZARD_DISC_THICKNESS
	zone.Size = Vector3.new(thick, 2, 2)
	-- Cylinder axis is X; rotate so the disc lies flat on the ground plane
	zone.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
	zone.Anchored = true
	zone.CanCollide = false
	zone.CanQuery = false
	zone.CanTouch = false
	zone.CastShadow = false
	zone.Material = Enum.Material.Ice
	zone.Color = GameConstants.ICE_COLOR
	zone.Transparency = 0.55
	zone.Parent = Workspace

	local now = AbilityCooldownHelper.getNow()
	blizzardByPlayer[player] = {
		character = character,
		center = center,
		part = zone,
		startedAt = now,
		endsAt = now + GameConstants.ICE_BLIZZARD_DURATION,
		lastTick = now,
	}
	fireCameraShake(player, 0.7, 0.5)
end

----------------------------------------------------------------
-- Public API
----------------------------------------------------------------
function IcemanService.cancelAll(player: Player)
	stopCryoStream(player, false)
	stopIceSlide(player, false)
	stopIceForm(player, false)
	endBlizzard(player, false)

	local walls = wallsByPlayer[player]
	if walls then
		wallsByPlayer[player] = nil
		for _, wall in walls do
			retireWall(wall)
		end
	end

	local character = player.Character
	if character then
		character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
		for _, ability in CharacterRegistry.getAbilities("iceman") do
			AbilityCooldownHelper.setActive(character, ability.id, false)
		end
	end
end

function IcemanService.handleAction(player: Player, payload: any)
	if type(payload) ~= "table" then
		return
	end
	local character = player.Character
	if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "iceman" then
		return
	end
	if character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
		return
	end

	local action = payload.action
	if type(action) ~= "string" then
		return
	end

	local direction = if typeof(payload.direction) == "Vector3" then payload.direction else nil
	local aimPoint = if typeof(payload.aimPoint) == "Vector3" then payload.aimPoint else nil

	if action == "Q" then
		castIceShards(player, direction, aimPoint)
	elseif action == "E" or action == "E_down" then
		castIceWall(player, direction, aimPoint)
	elseif action == "F" then
		startIceSlide(player)
	elseif action == "T_down" then
		startCryoStream(player, aimPoint or (character:GetPivot().Position + character:GetPivot().LookVector * 40))
	elseif action == "T_up" then
		stopCryoStream(player, true)
	elseif action == "T_aim" then
		local state = streamByPlayer[player]
		if state and aimPoint then
			state.aimPoint = aimPoint
		end
	elseif action == "C" or action == "C_down" then
		startIceForm(player)
	elseif action == "X" then
		castAbsoluteZero(player)
	elseif action == "V" then
		castFlashFreeze(player, direction, aimPoint)
	elseif action == "G" then
		castShatter(player)
	end
end

local function updateStreams(dtClamped: number, now: number)
	for player, state in streamByPlayer do
		local character = state.character
		if not character.Parent or player.Character ~= character then
			stopCryoStream(player, true)
			continue
		end
		if CombatHelper.arePowersDisabled(character) then
			stopCryoStream(player, true)
			continue
		end

		local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		if type(energy) ~= "number" or energy <= 0 then
			stopCryoStream(player, true)
			continue
		end
		character:SetAttribute(
			GameConstants.ENERGY_ATTRIBUTE,
			math.max(0, energy - GameConstants.ICE_STREAM_ENERGY_PER_SEC * dtClamped)
		)
		CharacterService.markAbilityUse(character)

		local root = getRoot(character)
		local origin = if root then root.Position else character:GetPivot().Position
		local toAim = state.aimPoint - origin
		local faceDir = if toAim.Magnitude > 0.05 then toAim.Unit else character:GetPivot().LookVector
		local forward = Vector3.new(faceDir.X, 0, faceDir.Z)
		if forward.Magnitude < 0.05 then
			forward = Vector3.new(0, 0, -1)
		else
			forward = forward.Unit
		end

		if root and state.faceAlign then
			setYawAlign(state.faceAlign, root, forward)
		end

		if state.animTrack and state.animTrack.Parent and not state.animTrack.IsPlaying then
			state.animTrack:Play(0.1, 1, 1)
		end

		if now - state.lastTick >= GameConstants.ICE_STREAM_TICK then
			local tick = math.clamp(now - state.lastTick, 0, 0.5)
			state.lastTick = now
			local range = GameConstants.ICE_STREAM_RANGE
			local chill = GameConstants.ICE_STREAM_CHILL_PER_SEC * tick
			for _, victim in CombatHelper.overlapCharacters(origin, range, character) do
				if not isRealTarget(victim, character) then
					continue
				end
				local vRoot = getRoot(victim)
				local vPos = if vRoot then vRoot.Position else victim:GetPivot().Position
				local delta = vPos - origin
				local flat = Vector3.new(delta.X, 0, delta.Z)
				if flat.Magnitude > range or flat.Magnitude < 0.05 then
					continue
				end
				if flat.Unit:Dot(forward) < GameConstants.ICE_STREAM_FRONT_DOT then
					continue
				end
				FrostStatus.addChill(victim, chill)
			end
		end
	end
end

local function updateSlides(dtClamped: number, now: number)
	for player, state in slideByPlayer do
		local character = state.character
		if player.Character ~= character or not character.Parent or not state.humanoid.Parent or not state.root.Parent then
			stopIceSlide(player, false)
			continue
		end
		if state.humanoid.Health <= 0 or CombatHelper.arePowersDisabled(character) then
			stopIceSlide(player, true)
			continue
		end

		local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		if type(energy) ~= "number" or energy <= 0 then
			stopIceSlide(player, true)
			continue
		end
		character:SetAttribute(
			GameConstants.ENERGY_ATTRIBUTE,
			math.max(0, energy - GameConstants.ICE_SLIDE_ENERGY_PER_SEC * dtClamped)
		)
		CharacterService.markAbilityUse(character)

		local look = state.lookDir
		if look.Magnitude < 0.01 then
			look = Vector3.new(0, 0, -1)
		else
			look = look.Unit
		end
		local lookFlat = Vector3.new(look.X, 0, look.Z)
		if lookFlat.Magnitude < 0.01 then
			lookFlat = Vector3.new(0, 0, -1)
		else
			lookFlat = lookFlat.Unit
		end

		local speed = GameConstants.ICE_SLIDE_SPEED
		-- Always skate forward along camera look, biased a bit upward — ignore strafe/WASD
		local dir = (look + Vector3.new(0, GameConstants.ICE_SLIDE_LOOK_UP, 0))
		if dir.Magnitude < 0.05 then
			dir = lookFlat + Vector3.new(0, GameConstants.ICE_SLIDE_LOOK_UP, 0)
		end
		dir = dir.Unit
		state.root.AssemblyLinearVelocity = dir * speed
		state.humanoid:Move(lookFlat, false)

		setYawAlign(state.faceAlign, state.root, lookFlat)

		if state.animTrack and state.animTrack.Parent and not state.animTrack.IsPlaying then
			state.animTrack:Play(0.1, 1, 1)
		end

		if state.humanoid.WalkSpeed < speed - 0.5 then
			state.humanoid.WalkSpeed = speed
		end

		local fx = state.beamFx
		if fx then
			local backPos = getSlidePathPoint(character, look, -GameConstants.ICE_SLIDE_SLAB_LEAD)
			local frontPos = getSlidePathPoint(character, look, GameConstants.ICE_SLIDE_SLAB_LEAD)
			fx.backHost.CFrame = CFrame.new(backPos)
			fx.frontHost.CFrame = CFrame.new(frontPos)
			if not fx.backBeam.Enabled then
				fx.backBeam.Enabled = true
			end
			if not fx.frontBeam.Enabled then
				fx.frontBeam.Enabled = true
			end
		end

		if now - state.lastSlabAt >= GameConstants.ICE_SLIDE_SLAB_INTERVAL then
			state.lastSlabAt = now
			spawnSlideSlab(character, look)
		end
	end
end

local function updateForms(dtClamped: number, now: number)
	for player, state in formByPlayer do
		local character = state.character
		if not character.Parent or player.Character ~= character then
			stopIceForm(player, true)
			continue
		end
		local hum = CombatHelper.getHumanoid(character)
		if not hum or hum.Health <= 0 then
			stopIceForm(player, true)
			continue
		end
		if now >= state.endsAt then
			stopIceForm(player, true)
			continue
		end

		local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		if type(energy) ~= "number" or energy <= 0 then
			stopIceForm(player, true)
			continue
		end
		character:SetAttribute(
			GameConstants.ENERGY_ATTRIBUTE,
			math.max(0, energy - GameConstants.ICE_FORM_ENERGY_PER_SEC * dtClamped)
		)

		if now - state.lastAuraAt >= GameConstants.ICE_FORM_AURA_INTERVAL then
			state.lastAuraAt = now
			local root = getRoot(character)
			local center = if root then root.Position else character:GetPivot().Position
			for _, victim in CombatHelper.overlapCharacters(center, GameConstants.ICE_FORM_AURA_RADIUS, character) do
				if isRealTarget(victim, character) then
					FrostStatus.addChill(victim, GameConstants.ICE_FORM_AURA_CHILL)
				end
			end
		end
	end
end

local function updateBlizzards(now: number)
	for player, state in blizzardByPlayer do
		local character = state.character
		if not character.Parent or player.Character ~= character then
			endBlizzard(player, true)
			continue
		end
		if now >= state.endsAt then
			endBlizzard(player, true)
			continue
		end

		-- Fixed spawn center — does not follow Iceman
		local radius = GameConstants.ICE_BLIZZARD_RADIUS
		local grow = math.clamp((now - state.startedAt) / GameConstants.ICE_BLIZZARD_GROW_TIME, 0, 1)
		local diameter = math.max(2, radius * 2 * grow)
		local thick = GameConstants.ICE_BLIZZARD_DISC_THICKNESS
		if state.part.Parent then
			state.part.Size = Vector3.new(thick, diameter, diameter)
			state.part.CFrame = CFrame.new(state.center) * CFrame.Angles(0, 0, math.rad(90))
		end

		if now - state.lastTick >= GameConstants.ICE_BLIZZARD_TICK then
			local tick = math.clamp(now - state.lastTick, 0, 0.5)
			state.lastTick = now
			for _, victim in CombatHelper.overlapCharacters(state.center, radius * grow, character) do
				if not isRealTarget(victim, character) then
					continue
				end
				CombatHelper.dealDamage(
					character,
					victim,
					GameConstants.ICE_BLIZZARD_DAMAGE_PER_SEC * tick,
					state.center,
					"projectile"
				)
				FrostStatus.addChill(victim, GameConstants.ICE_BLIZZARD_CHILL_PER_SEC * tick)
			end
		end
	end
end

function IcemanService.update(dt: number)
	local dtClamped = math.clamp(dt, 0.001, 0.1)
	local now = AbilityCooldownHelper.getNow()

	FrostStatus.update(dtClamped)
	updateStreams(dtClamped, now)
	updateSlides(dtClamped, now)
	updateForms(dtClamped, now)
	updateBlizzards(now)
end

function IcemanService.init()
	Remotes.getEvent("CameraShake")
	Remotes.getEvent("UseAbility").OnServerEvent:Connect(function(player: Player, payload: any)
		IcemanService.handleAction(player, payload)
	end)
	-- Reuse the flight input stream while Ice Slide is active
	Remotes.getEvent("FlightInput").OnServerEvent:Connect(function(player: Player, payload: any)
		if type(payload) ~= "table" or not slideByPlayer[player] then
			return
		end
		local move = if typeof(payload.moveVector) == "Vector3" then payload.moveVector else Vector3.zero
		local look = if typeof(payload.lookVector) == "Vector3" then payload.lookVector else Vector3.new(0, 0, -1)
		IcemanService.setSlideInput(player, move, look)
	end)

	local function hookPlayer(player: Player)
		player.CharacterRemoving:Connect(function(character)
			IcemanService.cancelAll(player)
			FrostStatus.clear(character)
		end)
		player.CharacterAdded:Connect(function(character)
			IcemanService.cancelAll(player)
			FrostStatus.clear(character)
			local humanoid = character:WaitForChild("Humanoid", 5)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Died:Connect(function()
					IcemanService.cancelAll(player)
					FrostStatus.clear(character)
				end)
			end
		end)
	end

	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end
	Players.PlayerAdded:Connect(hookPlayer)
	Players.PlayerRemoving:Connect(function(player)
		IcemanService.cancelAll(player)
		wallsByPlayer[player] = nil
	end)
end

return IcemanService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">InvisibleWomanService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local ProjectileHelper = require(ReplicatedStorage.Shared.ProjectileHelper)
local PushHelper = require(ReplicatedStorage.Shared.PushHelper)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ScreenFeelHelper = require(ReplicatedStorage.Shared.ScreenFeelHelper)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)
local CharacterService = require(script.Parent.CharacterService)
local HexFlightService = require(script.Parent.HexFlightService)
local NameplateService = require(script.Parent.NameplateService)
local RagdollService = require(script.Parent.RagdollService)

local InvisibleWomanService = {}

type PowerFx = { instances: { Instance }, refs: number }

type ShieldState = {
	character: Model,
	hp: number,
	maxHp: number,
	forcefield: Instance,
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	healthConn: RBXScriptConnection?,
	lastHealth: number,
	billboard: BillboardGui?,
	hpLabel: TextLabel?,
	hpFill: Frame?,
	lockWalk: boolean,
	fromProtect: boolean,
	animTrack: AnimationTrack?,
}

type FlightFx = {
	instances: { Instance },
	hp: number,
	maxHp: number,
	billboard: BillboardGui?,
	hpLabel: TextLabel?,
	hpFill: Frame?,
	stealthSaved: { { inst: Instance, t: number, enabled: boolean? } }?,
}

type PushState = {
	part: BasePart,
	visual: Instance,
	owner: Model,
	hit: { [Model]: boolean },
	alive: boolean,
	launched: boolean,
	launchAt: number,
	dir: Vector3,
	bornAt: number,
	casterHoldPos: Vector3,
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	autoRotate: boolean,
}

type CrushState = {
	character: Model,
	victim: Model,
	vRoot: BasePart,
	fx: Instance,
	holdPos: Vector3,
	casterHoldPos: Vector3,
	tickAcc: number,
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	autoRotate: boolean,
	faceAlign: AlignOrientation?,
	casterAnim: AnimationTrack?,
	victimAnim: AnimationTrack?,
	endsAt: number,
}

type ChokeVictim = {
	character: Model,
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	fx: Instance?,
	damageTaken: number,
	previousPowersDisabledUntil: number?,
}

type AreaState = {
	character: Model,
	part: BasePart,
	visual: Instance,
	choking: boolean,
	victims: { [Model]: ChokeVictim },
	powerDisabled: { [Model]: number? },
	tickAcc: number,
	hp: number,
	maxHp: number,
	billboard: BillboardGui?,
	hpLabel: TextLabel?,
	hpFill: Frame?,
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	autoRotate: boolean,
}

type ProjectionState = {
	visual: Instance,
	part: BasePart,
	owner: Model,
	hit: { [Model]: boolean },
	alive: boolean,
	dir: Vector3,
	launched: boolean,
	launchAt: number,
	bornAt: number,
	spawnPos: Vector3,
	casterHoldPos: Vector3,
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	autoRotate: boolean,
}

type InvisState = {
	character: Model,
	fx: { Instance },
	saved: { { inst: Instance, t: number } },
	token: number,
}

local HERO = "invisible_woman"
local AIM_POINT_RADIUS = 6
local AIM_LOCK_RADIUS = 10

local powerFxByCharacter: { [Model]: PowerFx } = {}
local shieldByPlayer: { [Player]: ShieldState } = {}
local flightFxByCharacter: { [Model]: FlightFx } = {}
local pushByPlayer: { [Player]: PushState } = {}
local crushByPlayer: { [Player]: CrushState } = {}
local areaByPlayer: { [Player]: AreaState } = {}
local projectionByPlayer: { [Player]: ProjectionState } = {}
local smashToken: { [Player]: number } = {}
local smashWallsByPlayer: { [Player]: { Instance } } = {}
local smashHoldByPlayer: { [Player]: {
	walk: number,
	jumpPower: number?,
	jumpHeight: number?,
	autoRotate: boolean,
} } = {}
local discSideByPlayer: { [Player]: boolean } = {}
local invisByPlayer: { [Player]: InvisState } = {}
local invisToken: { [Player]: number } = {}

local function getRoot(model: Model): BasePart?
	local r = model:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then
		return r
	end
	return model.PrimaryPart
end

local function playWorldSound(soundId: string, at: Vector3, volume: number?)
	local host = Instance.new("Part")
	host.Name = "IwSfx"
	host.Size = Vector3.new(0.2, 0.2, 0.2)
	host.Transparency = 1
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.CastShadow = false
	host.CFrame = CFrame.new(at)
	host.Parent = Workspace
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or 0.85
	sound.RollOffMaxDistance = 120
	sound.RollOffMinDistance = 12
	sound.Parent = host
	if sound.IsLoaded then
		sound:Play()
	else
		sound.Loaded:Once(function()
			if sound.Parent then
				sound:Play()
			end
		end)
	end
	sound.Ended:Once(function()
		if host.Parent then
			host:Destroy()
		end
	end)
	task.delay(8, function()
		if host.Parent then
			host:Destroy()
		end
	end)
end

local function stopTrack(track: AnimationTrack?)
	if track then
		pcall(function()
			track:Stop(0.12)
		end)
	end
end

local function playCharacterAnim(
	character: Model,
	assetId: string,
	looped: boolean?,
	priority: Enum.AnimationPriority?
): AnimationTrack?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = assetId
	local ok, track = pcall(function()
		return (animator :: Animator):LoadAnimation(anim)
	end)
	anim:Destroy()
	if not ok or not track then
		return nil
	end
	track.Priority = priority or Enum.AnimationPriority.Action
	track.Looped = looped == true
	track:Play(0.1, 1, 1)
	return track
end

local function getHand(character: Model, preferRight: boolean): BasePart?
	local names = if preferRight
		then { "RightHand", "Right Arm", "RightLowerArm" }
		else { "LeftHand", "Left Arm", "LeftLowerArm" }
	for _, name in names do
		local p = character:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return getRoot(character)
end

local function normalizeDir(v: Vector3): Vector3
	if v.Magnitude < 0.01 then
		return Vector3.new(0, 0, -1)
	end
	return v.Unit
end

local function fireCameraShake(player: Player, intensity: number?, duration: number?, fovScale: number?, vignetteScale: number?)
	Remotes.getEvent("CameraShake"):FireClient(player, {
		intensity = intensity or 0.42,
		duration = duration or 0.3,
		fovScale = fovScale,
		vignetteScale = vignetteScale,
	})
end

local function applyStandingPush(victim: Model, direction: Vector3, speed: number, upBoost: number)
	local vRoot = getRoot(victim)
	local hum = CombatHelper.getHumanoid(victim)
	if not vRoot or not hum or hum.Health <= 0 or vRoot.Anchored then
		return
	end

	local pushDir = if direction.Magnitude > 0.05 then direction.Unit else Vector3.new(0, 0, -1)
	local flat = Vector3.new(pushDir.X, 0, pushDir.Z)
	if flat.Magnitude < 0.08 then
		local look = vRoot.CFrame.LookVector
		flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.08 then
			flat = Vector3.new(0, 0, -1)
		end
	end
	flat = flat.Unit

	local att = Instance.new("Attachment")
	att.Name = "IwPushStruggleAtt"
	att.Parent = vRoot

	local align = Instance.new("AlignOrientation")
	align.Name = "IwPushStruggleAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.RigidityEnabled = false
	align.MaxTorque = 120000
	align.Responsiveness = 14
	-- Face reverse of shove (look back along the push)
	local facePos = vRoot.Position - flat
	align.CFrame = CFrame.lookAt(vRoot.Position, Vector3.new(facePos.X, vRoot.Position.Y, facePos.Z))
	align.Parent = vRoot

	vRoot.AssemblyLinearVelocity = flat * speed + Vector3.new(0, upBoost, 0)
	ScreenFeelHelper.pulseCharacter(victim, {
		intensity = 0.62,
		duration = 0.32,
		fovScale = 0.36,
		vignetteScale = 0.4,
	})

	local origWalk = hum.WalkSpeed
	local origJumpPower = if hum.UseJumpPower then hum.JumpPower else nil
	local origJumpHeight = if not hum.UseJumpPower then hum.JumpHeight else nil
	local origAutoRotate = hum.AutoRotate
	local token = (victim:GetAttribute("IwPushStruggleToken") :: number?) or 0
	token += 1
	victim:SetAttribute("IwPushStruggleToken", token)
	hum.WalkSpeed = 0
	hum.AutoRotate = false
	if hum.UseJumpPower then
		hum.JumpPower = 0
	else
		hum.JumpHeight = 0
	end

	task.spawn(function()
		local t0 = os.clock()
		local dur = GameConstants.IW_PUSH_STRUGGLE_TIME
		while os.clock() - t0 < dur do
			if not vRoot.Parent or not victim.Parent then
				break
			end
			if victim:GetAttribute("IwPushStruggleToken") ~= token then
				break
			end
			local elapsed = os.clock() - t0
			local wobble = math.sin(elapsed * 16) * 0.18
			local lookBack = vRoot.Position - flat
			local faceAt = Vector3.new(lookBack.X, vRoot.Position.Y, lookBack.Z)
			if (faceAt - vRoot.Position).Magnitude > 0.05 then
				align.CFrame = CFrame.lookAt(vRoot.Position, faceAt) * CFrame.Angles(wobble * 0.35, wobble, 0)
			end
			hum:Move(Vector3.zero, false)
			hum.WalkSpeed = 0
			local vel = vRoot.AssemblyLinearVelocity
			local retain = math.clamp(1 - elapsed / dur, 0.25, 1)
			vRoot.AssemblyLinearVelocity = Vector3.new(flat.X * speed * 0.55 * retain, math.max(vel.Y, 1.5), flat.Z * speed * 0.55 * retain)
			task.wait()
		end
		if align.Parent then
			align:Destroy()
		end
		if att.Parent then
			att:Destroy()
		end
		if hum.Parent and hum.Health > 0 and victim:GetAttribute("IwPushStruggleToken") == token then
			hum.WalkSpeed = origWalk
			hum.AutoRotate = origAutoRotate
			if origJumpPower ~= nil then
				hum.JumpPower = origJumpPower
			end
			if origJumpHeight ~= nil then
				hum.JumpHeight = origJumpHeight
			end
		end
	end)
end

local function yawLookAt(origin: Vector3, target: Vector3): CFrame
	local flat = Vector3.new(target.X - origin.X, 0, target.Z - origin.Z)
	if flat.Magnitude < 0.08 then
		return CFrame.new(origin)
	end
	return CFrame.lookAt(origin, origin + flat.Unit)
end

local function ensureCrushFaceAlign(root: BasePart, targetCf: CFrame): AlignOrientation
	local att = root:FindFirstChild("IwCrushFaceAtt")
	if not (att and att:IsA("Attachment")) then
		if att then
			att:Destroy()
		end
		att = Instance.new("Attachment")
		att.Name = "IwCrushFaceAtt"
		att.Parent = root
	end
	local align = root:FindFirstChild("IwCrushFaceAlign")
	if not (align and align:IsA("AlignOrientation")) then
		if align then
			align:Destroy()
		end
		align = Instance.new("AlignOrientation")
		align.Name = "IwCrushFaceAlign"
		align.Mode = Enum.OrientationAlignmentMode.OneAttachment
		align.Attachment0 = att
		align.RigidityEnabled = false
		align.MaxTorque = 400000
		align.Responsiveness = GameConstants.IW_FACE_RESPONSIVENESS
		align.Parent = root
	end
	align.CFrame = targetCf
	local flightAlign = root:FindFirstChild("HeroAlignOrientation")
	if flightAlign and flightAlign:IsA("AlignOrientation") then
		flightAlign.CFrame = targetCf
	end
	return align
end

local function clearCrushFace(root: BasePart?)
	if not root then
		return
	end
	local align = root:FindFirstChild("IwCrushFaceAlign")
	if align then
		align:Destroy()
	end
	local att = root:FindFirstChild("IwCrushFaceAtt")
	if att then
		att:Destroy()
	end
end

local faceTokenByCharacter: { [Model]: number } = {}

local function clearCastFace(character: Model)
	local root = getRoot(character)
	if root then
		local align = root:FindFirstChild("IwCastFaceAlign")
		if align then
			align:Destroy()
		end
		local att = root:FindFirstChild("IwCastFaceAtt")
		if att then
			att:Destroy()
		end
		clearCrushFace(root)
	end
	faceTokenByCharacter[character] = (faceTokenByCharacter[character] or 0) + 1
end

local function faceToward(character: Model, worldPoint: Vector3?, holdSeconds: number?)
	if not worldPoint then
		return
	end
	local root = getRoot(character)
	local hum = CombatHelper.getHumanoid(character)
	if not root or not hum or hum.Health <= 0 then
		return
	end
	local owner = Players:GetPlayerFromCharacter(character)
	if owner and crushByPlayer[owner] then
		ensureCrushFaceAlign(root, yawLookAt(root.Position, worldPoint))
		return
	end
	if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
		return
	end
	local flat = Vector3.new(worldPoint.X - root.Position.X, 0, worldPoint.Z - root.Position.Z)
	if flat.Magnitude < 0.08 then
		return
	end
	local targetCf = CFrame.lookAt(root.Position, root.Position + flat.Unit)
	local token = (faceTokenByCharacter[character] or 0) + 1
	faceTokenByCharacter[character] = token

	local att = root:FindFirstChild("IwCastFaceAtt")
	if not (att and att:IsA("Attachment")) then
		if att then
			att:Destroy()
		end
		att = Instance.new("Attachment")
		att.Name = "IwCastFaceAtt"
		att.Parent = root
	end
	local existing = root:FindFirstChild("IwCastFaceAlign")
	if existing then
		existing:Destroy()
	end
	local align = Instance.new("AlignOrientation")
	align.Name = "IwCastFaceAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.RigidityEnabled = false
	align.MaxTorque = 420000
	align.Responsiveness = GameConstants.IW_FACE_RESPONSIVENESS
	align.CFrame = targetCf
	align.Parent = root

	local origAuto = hum.AutoRotate
	hum.AutoRotate = false
	task.delay(holdSeconds or 0.32, function()
		if faceTokenByCharacter[character] ~= token then
			return
		end
		if align.Parent then
			align:Destroy()
		end
		if att.Parent and att.Name == "IwCastFaceAtt" then
			att:Destroy()
		end
		if hum.Parent and hum.Health > 0 then
			local flying = character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
			hum.AutoRotate = if flying then false else true
		end
	end)
end

local function finishAbility(character: Model, abilityId: string, cooldown: number)
	AbilityCooldownHelper.setActive(character, abilityId, false)
	AbilityCooldownHelper.applyAfterUse(character, abilityId, cooldown)
	CharacterService.markAbilityUse(character)
end

local function canUse(character: Model, abilityId: string, energy: number): boolean
	if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
		local modern = character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern"
		if
			abilityId ~= "forcefield_flight"
			and abilityId ~= "invisibility"
			and not (modern and (abilityId == "disc_throw" or abilityId == "forcefield_area"))
		then
			return false
		end
	end
	if CombatHelper.arePowersDisabled(character) then
		return false
	end
	local owner = Players:GetPlayerFromCharacter(character)
	local area = if owner then areaByPlayer[owner] else nil
	local areaCompanion = area ~= nil
		and (abilityId == "forcefield_choke" or abilityId == "forcefield_protect")
	if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true and not areaCompanion then
		return false
	end
	if character:GetAttribute(GameConstants.MG_TK_CONTROLLED_ATTRIBUTE) == true then
		return false
	end
	if AbilityCooldownHelper.isOnCooldown(character, abilityId) then
		return false
	end
	if AbilityCooldownHelper.isActive(character, abilityId) then
		return false
	end
	if area then
		if abilityId == "forcefield_flight" then
			return false
		end
		if not area.choking then
			if abilityId ~= "forcefield_area" and abilityId ~= "forcefield_choke" and abilityId ~= "forcefield_protect" then
				return false
			end
		end
	end
	for _, ab in CharacterRegistry.getAbilities(HERO) do
		if ab.passive or ab.id == abilityId or ab.id == "forcefield_flight" or ab.id == "invisibility" then
			continue
		end
		if area and (ab.id == "forcefield_area" or (area.choking and ab.id == "forcefield_choke")) then
			continue
		end
		if AbilityCooldownHelper.isActive(character, ab.id) then
			return false
		end
	end
	if character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern" then
		energy *= 0.75
	end
	if energy > 0 and not CharacterService.spendEnergy(character, energy) then
		return false
	end
	return true
end

local function fadeParticles(root: Instance, enabled: boolean)
	VfxHelper.setParticlesEnabled(root, enabled)
	for _, desc in root:GetDescendants() do
		if desc:IsA("ParticleEmitter") then
			desc.Enabled = enabled
		end
	end
end

local function forEachEmitter(root: Instance, fn: (ParticleEmitter) -> ())
	if root:IsA("ParticleEmitter") then
		fn(root)
	end
	for _, desc in root:GetDescendants() do
		if desc:IsA("ParticleEmitter") then
			fn(desc)
		end
	end
end

local function setBreakBurst(root: Instance, enabled: boolean)
	forEachEmitter(root, function(em)
		if em.Name == "1" then
			em.Enabled = false
			if enabled then
				em:Emit(math.clamp(math.floor(em.Rate * 0.3 + 8), 6, 40))
			end
		end
	end)
end

local function setIdleShieldParticles(root: Instance, enabled: boolean)
	forEachEmitter(root, function(em)
		if em.Name == "1" then
			em.Enabled = false
		else
			em.Enabled = enabled
		end
	end)
end

local function disableAreaShieldCollision(root: Instance)
	local function prep(bp: BasePart)
		bp.CanCollide = false
		bp.CanQuery = false
	end
	if root:IsA("BasePart") then
		prep(root)
	end
	for _, desc in root:GetDescendants() do
		if desc:IsA("BasePart") then
			prep(desc)
		end
	end
end

local function fadeOutVisual(root: Instance, duration: number, skipParticles: boolean?)
	disableAreaShieldCollision(root)
	local fade = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local function fadeInst(inst: Instance)
		if inst:IsA("BasePart") then
			TweenService:Create(inst, fade, { Transparency = 1 }):Play()
		elseif inst:IsA("Decal") or inst:IsA("Texture") then
			TweenService:Create(inst, fade, { Transparency = 1 }):Play()
		elseif inst:IsA("Beam") or inst:IsA("Trail") then
			inst.Enabled = false
			local keys: { NumberSequenceKeypoint } = {}
			for _, key in inst.Transparency.Keypoints do
				table.insert(keys, NumberSequenceKeypoint.new(key.Time, 1, key.Envelope))
			end
			inst.Transparency = NumberSequence.new(keys)
		elseif inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then
			TweenService:Create(inst, fade, { Brightness = 0 }):Play()
		end
	end
	fadeInst(root)
	for _, desc in root:GetDescendants() do
		fadeInst(desc)
	end
	if skipParticles ~= true then
		VfxHelper.smoothDisableParticles(root, duration)
		forEachEmitter(root, function(em)
			local startKeys = em.Transparency.Keypoints
			local t0 = os.clock()
			task.spawn(function()
				while em.Parent and (os.clock() - t0) < duration do
					local a = math.clamp((os.clock() - t0) / duration, 0, 1)
					local keys: { NumberSequenceKeypoint } = {}
					for _, key in startKeys do
						table.insert(keys, NumberSequenceKeypoint.new(key.Time, key.Value + (1 - key.Value) * a, key.Envelope))
					end
					em.Transparency = NumberSequence.new(keys)
					task.wait()
				end
				if em.Parent then
					em.Enabled = false
				end
			end)
		end)
	end
	task.delay(duration + 0.55, function()
		if root.Parent then
			root:Destroy()
		end
	end)
end

local function fadeInVisual(root: Instance, duration: number)
	local fade = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local function prepare(inst: Instance)
		if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture") then
			local orig = inst.Transparency
			inst:SetAttribute("IwFadeOrigT", orig)
			inst.Transparency = 1
			TweenService:Create(inst, fade, { Transparency = orig }):Play()
		elseif inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then
			local origB = inst.Brightness
			inst:SetAttribute("IwFadeOrigB", origB)
			inst.Brightness = 0
			TweenService:Create(inst, fade, { Brightness = origB }):Play()
		end
	end
	prepare(root)
	for _, desc in root:GetDescendants() do
		prepare(desc)
	end
	setIdleShieldParticles(root, true)
end

local function destroyShieldUi(gui: BillboardGui?)
	if gui and gui.Parent then
		gui:Destroy()
	end
end

local function updateShieldUi(hpLabel: TextLabel?, hpFill: Frame?, hp: number, maxHp: number)
	if hpLabel then
		hpLabel.Text = string.format("%d/%d", math.max(0, math.ceil(hp)), maxHp)
	end
	if hpFill then
		local ratio = if maxHp > 0 then math.clamp(hp / maxHp, 0, 1) else 0
		TweenService:Create(hpFill, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(ratio, 0, 1, 0),
		}):Play()
	end
end

local function createShieldHpBillboard(adornee: BasePart, maxHp: number, compact: boolean?): (BillboardGui, TextLabel, Frame)
	local character = adornee:FindFirstAncestorOfClass("Model")
	local head: BasePart? = nil
	if character and character:FindFirstChildOfClass("Humanoid") then
		local found = character:FindFirstChild("Head")
		if found and found:IsA("BasePart") then
			head = found
		end
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "ShieldHealthGui"
	gui.Size = if compact then GameConstants.SHIELD_UI_SIZE_COMPACT else GameConstants.SHIELD_UI_SIZE
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = GameConstants.NAMEPLATE_MAX_DISTANCE
	if head and character then
		gui.Adornee = head
		gui.StudsOffset = if compact then GameConstants.SHIELD_UI_OFFSET_COMPACT else GameConstants.SHIELD_UI_OFFSET
		gui.Parent = character
	else
		gui.Adornee = adornee
		gui.StudsOffset = Vector3.new(0, if compact then 3.4 else 4.2, 0)
		gui.Parent = adornee.Parent or adornee
	end

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Size = UDim2.fromScale(1, 1)
	track.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
	track.BorderSizePixel = 0
	track.Parent = gui

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(0.2, 0)
	trackCorner.Parent = track

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = GameConstants.IW_COLOR
	fill.BorderSizePixel = 0
	fill.Parent = track

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.2, 0)
	fillCorner.Parent = fill

	local hpLabel = Instance.new("TextLabel")
	hpLabel.Name = "HpLabel"
	hpLabel.Size = UDim2.fromScale(1, 1)
	hpLabel.BackgroundTransparency = 1
	hpLabel.Font = Enum.Font.Bangers
	hpLabel.Text = string.format("%d/%d", maxHp, maxHp)
	hpLabel.TextColor3 = Color3.fromRGB(245, 245, 248)
	hpLabel.TextScaled = true
	hpLabel.TextStrokeTransparency = 0.35
	hpLabel.ZIndex = 2
	hpLabel.Parent = track

	local textConstraint = Instance.new("UITextSizeConstraint")
	textConstraint.MaxTextSize = if compact then 14 else 18
	textConstraint.MinTextSize = 7
	textConstraint.Parent = hpLabel

	return gui, hpLabel, fill
end

local function setInstanceHidden(inst: Instance, hidden: boolean)
	if inst:IsA("BillboardGui") then
		inst.Enabled = not hidden
		return
	end
	local function hide(obj: Instance)
		if obj:IsA("BasePart") then
			if hidden then
				if obj:GetAttribute("IwVisT") == nil then
					obj:SetAttribute("IwVisT", obj.Transparency)
				end
				obj.Transparency = 1
			else
				local saved = obj:GetAttribute("IwVisT")
				if type(saved) == "number" then
					obj.Transparency = saved
				end
				obj:SetAttribute("IwVisT", nil)
			end
		elseif obj:IsA("Beam") or obj:IsA("Trail") then
			obj.Enabled = not hidden
		elseif obj:IsA("ParticleEmitter") then
			obj.Enabled = if hidden then false else obj.Name ~= "1"
		elseif obj:IsA("BillboardGui") then
			obj.Enabled = not hidden
		end
	end
	hide(inst)
	for _, desc in inst:GetDescendants() do
		hide(desc)
	end
end

local function restoreFlightFx(character: Model)
	local flight = flightFxByCharacter[character]
	if not flight then
		return
	end
	if flight.billboard then
		flight.billboard.Enabled = true
	end
	for _, inst in flight.instances do
		if not inst.Parent then
			continue
		end
		local function restore(em: ParticleEmitter)
			local orig = em:GetAttribute("IwOrigRate")
			if type(orig) == "number" then
				em.Rate = orig
			end
			em.Enabled = em.Name ~= "1"
		end
		if inst:IsA("ParticleEmitter") then
			restore(inst)
		end
		for _, desc in inst:GetDescendants() do
			if desc:IsA("ParticleEmitter") then
				restore(desc)
			end
		end
		if inst:IsA("BasePart") then
			local saved = inst:GetAttribute("IwVisT")
			if type(saved) == "number" then
				inst.Transparency = saved
				inst:SetAttribute("IwVisT", nil)
			end
		end
	end
end

local function isBaseInvisibleWoman(character: Model): boolean
	return character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) ~= "modern"
end

local function setDefenceHidden(character: Model, hidden: boolean)
	local player = Players:GetPlayerFromCharacter(character)
	local hideQShield = hidden and not isBaseInvisibleWoman(character)
	local hideFlightShield = hidden and not isBaseInvisibleWoman(character)
	if player then
		local shield = shieldByPlayer[player]
		if shield then
			if shield.billboard then
				shield.billboard.Enabled = not hidden
			end
			if shield.forcefield.Parent then
				setInstanceHidden(shield.forcefield, hideQShield)
			end
		end
	end
	local flight = flightFxByCharacter[character]
	if flight then
		if flight.billboard then
			flight.billboard.Enabled = not hideFlightShield
		end
		for _, inst in flight.instances do
			if inst.Parent then
				setInstanceHidden(inst, hideFlightShield)
			end
		end
	end
	local gui = character:FindFirstChild("ShieldHealthGui", true)
	if gui and gui:IsA("BillboardGui") then
		local keepFlightUi = isBaseInvisibleWoman(character) and flight ~= nil and gui == flight.billboard
		gui.Enabled = if keepFlightUi then true else not hidden
	end
end

local function hideHandVfx(character: Model)
	local fx = powerFxByCharacter[character]
	if not fx then
		return
	end
	for _, inst in fx.instances do
		if inst.Parent then
			fadeParticles(inst, false)
			task.delay(0.2, function()
				if inst.Parent then
					inst:Destroy()
				end
			end)
		end
	end
	fx.instances = {}
end

local function isFlightFxInst(character: Model, inst: Instance): boolean
	if inst.Name == "IwFlightForcefield" or inst:FindFirstAncestor("IwFlightForcefield") ~= nil then
		return true
	end
	local flight = flightFxByCharacter[character]
	if not flight then
		return false
	end
	if flight.billboard and (inst == flight.billboard or inst:IsDescendantOf(flight.billboard)) then
		return true
	end
	for _, fx in flight.instances do
		if inst == fx or inst:IsDescendantOf(fx) or (fx:IsDescendantOf(inst) and inst:IsDescendantOf(character)) then
			return true
		end
	end
	return false
end

local function lockHumanoidMotion(hum: Humanoid)
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.UseJumpPower = true
	pcall(function()
		hum.JumpHeight = 0
	end)
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	end)
	hum:Move(Vector3.zero, false)
end

local function unlockHumanoidMotion(hum: Humanoid, walk: number, jumpPower: number?, jumpHeight: number?)
	hum.WalkSpeed = walk
	if jumpPower ~= nil then
		hum.JumpPower = jumpPower
	end
	if jumpHeight ~= nil then
		hum.JumpHeight = jumpHeight
	end
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	end)
end

local function restoreMove(character: Model, walk: number, jumpPower: number?, jumpHeight: number?, autoRotate: boolean?)
	local hum = CombatHelper.getHumanoid(character)
	if hum then
		unlockHumanoidMotion(hum, walk, jumpPower, jumpHeight)
		if autoRotate ~= nil then
			hum.AutoRotate = autoRotate
		end
	end
end

local function freezeCasterInPlace(character: Model, _holdPos: Vector3)
	local hum = CombatHelper.getHumanoid(character)
	if hum then
		lockHumanoidMotion(hum)
		hum.AutoRotate = false
		hum:Move(Vector3.zero, false)
	end
end

local function captureAndLockMove(character: Model): (number, number?, number?)
	local hum = CombatHelper.getHumanoid(character)
	local walk = GameConstants.DEFAULT_WALK_SPEED
	local jumpPower: number? = nil
	local jumpHeight: number? = nil
	if hum then
		walk = hum.WalkSpeed
		jumpPower = hum.JumpPower
		pcall(function()
			jumpHeight = hum.JumpHeight
		end)
		lockHumanoidMotion(hum)
	end
	return walk, jumpPower, jumpHeight
end

local function isHumanoidPart(part: BasePart): boolean
	if CombatHelper.getCharacterFromPart(part) then
		return true
	end
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then
			return true
		end
		local parent = model.Parent
		if not parent then
			break
		end
		model = parent:FindFirstAncestorOfClass("Model")
	end
	return false
end

local function worldYOf(inst: Instance): number
	if inst:IsA("BasePart") then
		return inst.Position.Y
	end
	local parent = inst.Parent
	if parent and parent:IsA("BasePart") then
		return parent.Position.Y
	end
	return 0
end

local function retireFx(inst: Instance, fadeWait: number, deleteWait: number)
	task.delay(fadeWait, function()
		if inst.Parent then
			fadeParticles(inst, false)
		end
	end)
	task.delay(fadeWait + deleteWait, function()
		if inst.Parent then
			inst:Destroy()
		end
	end)
end

local function weldVisual(inst: Instance, root: BasePart)
	local function prep(part: BasePart)
		part.Anchored = false
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
	end
	if inst:IsA("BasePart") then
		prep(inst)
		inst.CFrame = root.CFrame
		inst.Parent = root.Parent
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = inst
		weld.Parent = inst
		return
	end
	inst.Parent = root.Parent
	if inst:IsA("Model") then
		inst:PivotTo(root.CFrame)
	end
	local primary = if inst:IsA("Model")
		then (inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true))
		else inst:FindFirstChildWhichIsA("BasePart", true)
	if primary and primary:IsA("BasePart") then
		for _, desc in inst:GetDescendants() do
			if desc:IsA("BasePart") then
				prep(desc)
			end
		end
		prep(primary)
		primary.CFrame = root.CFrame
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = primary
		weld.Parent = primary
	end
end

local function spawnHandVfx(character: Model): { Instance }
	local instances: { Instance } = {}
	local template = VfxHelper.getInvisibleWomanAsset("HandVFXAttachment")
	local right = getHand(character, true)
	local left = getHand(character, false)
	local function attach(hand: BasePart?)
		if not hand or not template then
			return
		end
		local fx = template:Clone()
		if fx:IsA("Attachment") then
			fx.Position = Vector3.zero
			fx.Orientation = Vector3.zero
		end
		fx.Parent = hand
		fadeParticles(fx, true)
		table.insert(instances, fx)
	end
	attach(right)
	if left and left ~= right then
		attach(left)
	end
	return instances
end

local function isPowerFxInst(character: Model, inst: Instance): boolean
	local fx = powerFxByCharacter[character]
	if not fx then
		return false
	end
	for _, handFx in fx.instances do
		if inst == handFx or inst:IsDescendantOf(handFx) then
			return true
		end
	end
	return false
end

local function beginPowerFx(character: Model, allowDuringInvis: boolean?)
	local invisible = character:GetAttribute(GameConstants.IW_INVIS_ATTRIBUTE) == true
	local skipHands = invisible and allowDuringInvis ~= true
	local existing = powerFxByCharacter[character]
	if existing then
		existing.refs += 1
		if not skipHands and #existing.instances == 0 then
			existing.instances = spawnHandVfx(character)
		end
		return
	end
	if skipHands then
		powerFxByCharacter[character] = { instances = {}, refs = 1 }
		return
	end
	powerFxByCharacter[character] = { instances = spawnHandVfx(character), refs = 1 }
end

local function endPowerFx(character: Model)
	local fx = powerFxByCharacter[character]
	if not fx then
		return
	end
	fx.refs -= 1
	if fx.refs > 0 then
		return
	end
	powerFxByCharacter[character] = nil
	for _, inst in fx.instances do
		if inst.Parent then
			fadeParticles(inst, false)
			task.delay(GameConstants.IW_HAND_FADE + 2.5, function()
				if inst.Parent then
					inst:Destroy()
				end
			end)
		end
	end
end

local function clearPowerFx(character: Model)
	local fx = powerFxByCharacter[character]
	if not fx then
		return
	end
	powerFxByCharacter[character] = nil
	for _, inst in fx.instances do
		if inst.Parent then
			fadeParticles(inst, false)
			task.delay(2, function()
				if inst.Parent then
					inst:Destroy()
				end
			end)
		end
	end
end

local function snapshotStealthVisuals(character: Model): { { inst: Instance, t: number, enabled: boolean? } }
	local saved: { { inst: Instance, t: number, enabled: boolean? } } = {}
	local function remember(inst: Instance)
		if inst.Name == "HumanoidRootPart" then
			return
		end
		if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture") then
			table.insert(saved, { inst = inst, t = inst.Transparency })
		elseif inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") then
			table.insert(saved, { inst = inst, t = 1, enabled = inst.Enabled })
		end
	end
	for _, desc in character:GetDescendants() do
		remember(desc)
	end
	return saved
end

local function fadeStealthVisuals(saved: { { inst: Instance, t: number, enabled: boolean? } }, hidden: boolean)
	local info = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for _, rec in saved do
		if not rec.inst.Parent then
			continue
		end
		if rec.inst:IsA("BasePart") or rec.inst:IsA("Decal") or rec.inst:IsA("Texture") then
			local target = if hidden then 1 else rec.t
			TweenService:Create(rec.inst, info, { Transparency = target }):Play()
		elseif rec.inst:IsA("ParticleEmitter") or rec.inst:IsA("Beam") or rec.inst:IsA("Trail") then
			rec.inst.Enabled = if hidden then false else rec.enabled == true
		end
	end
end

local function stealthTransparencyOf(character: Model, inst: Instance, fallback: number): number
	local flight = flightFxByCharacter[character]
	if flight and flight.stealthSaved then
		for _, rec in flight.stealthSaved do
			if rec.inst == inst then
				return rec.t
			end
		end
	end
	return fallback
end

local function beginFlightFx(character: Model)
	if flightFxByCharacter[character] then
		return
	end
	beginPowerFx(character)
	local instances: { Instance } = {}
	local modern = character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern"
	local maxHp = if modern then GameConstants.IW_FLIGHT_SHIELD_HP_MODERN else GameConstants.IW_FLIGHT_SHIELD_HP
	local stealthSaved: { { inst: Instance, t: number, enabled: boolean? } }? = nil
	if modern then
		local em1 = VfxHelper.getInvisibleWomanAsset("ForcefieldFlight", "ParticleEmitter1")
		local em2 = VfxHelper.getInvisibleWomanAsset("ForcefieldFlight", "ParticleEmitter2")
		for _, child in character:GetChildren() do
			if child:IsA("BasePart") then
				if em1 then
					local a = em1:Clone()
					a.Parent = child
					if a:IsA("ParticleEmitter") then
						a:SetAttribute("IwOrigRate", a.Rate)
						a.Enabled = character:GetAttribute(GameConstants.IW_INVIS_ATTRIBUTE) ~= true
					end
					table.insert(instances, a)
				end
				if em2 then
					local b = em2:Clone()
					b.Parent = child
					if b:IsA("ParticleEmitter") then
						b:SetAttribute("IwOrigRate", b.Rate)
						b.Enabled = character:GetAttribute(GameConstants.IW_INVIS_ATTRIBUTE) ~= true
					end
					table.insert(instances, b)
				end
			end
		end
	else
		local root = getRoot(character)
		local shieldTemplate = VfxHelper.getInvisibleWomanAsset("ForcefieldFlight", "FlightForcefield")
		if shieldTemplate and root then
			local shield = shieldTemplate:Clone()
			shield.Name = "IwFlightForcefield"
			weldVisual(shield, root)
			setIdleShieldParticles(shield, true)
			table.insert(instances, shield)
		end
	end
	local root = getRoot(character)
	character:SetAttribute(GameConstants.IW_FLIGHT_SHIELD_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.SHIELD_HP_ATTRIBUTE, maxHp)
	AbilityCooldownHelper.setActive(character, "forcefield_flight", true)
	local billboard: BillboardGui? = nil
	local hpLabel: TextLabel? = nil
	local hpFill: Frame? = nil
	if root and not shieldByPlayer[Players:GetPlayerFromCharacter(character) :: Player] then
		billboard, hpLabel, hpFill = createShieldHpBillboard(root, maxHp, true)
	end
	flightFxByCharacter[character] = {
		instances = instances,
		hp = maxHp,
		maxHp = maxHp,
		billboard = billboard,
		hpLabel = hpLabel,
		hpFill = hpFill,
		stealthSaved = stealthSaved,
	}
	if character:GetAttribute(GameConstants.IW_INVIS_ATTRIBUTE) == true then
		setDefenceHidden(character, true)
	end
end

local function endFlightFx(character: Model)
	local fx = flightFxByCharacter[character]
	if not fx then
		return
	end
	flightFxByCharacter[character] = nil
	character:SetAttribute(GameConstants.IW_FLIGHT_SHIELD_ATTRIBUTE, nil)
	if character:GetAttribute(GameConstants.IW_FORCEFIELD_ATTRIBUTE) ~= true then
		character:SetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE, nil)
		character:SetAttribute(GameConstants.SHIELD_HP_ATTRIBUTE, nil)
	end
	AbilityCooldownHelper.setActive(character, "forcefield_flight", false)
	destroyShieldUi(fx.billboard)
	if fx.stealthSaved and character:GetAttribute(GameConstants.IW_INVIS_ATTRIBUTE) ~= true then
		fadeStealthVisuals(fx.stealthSaved, false)
		pcall(function()
			NameplateService.setHidden(character, false, 0.22)
		end)
	end
	for _, inst in fx.instances do
		if inst.Parent then
			if inst.Name == "IwFlightForcefield" then
				setBreakBurst(inst, false)
				fadeOutVisual(inst, 0.4)
			else
				VfxHelper.smoothDisableParticles(inst, 1.05)
				fadeParticles(inst, false)
				task.delay(2.15, function()
					if inst.Parent then
						inst:Destroy()
					end
				end)
			end
		end
	end
	endPowerFx(character)
end

local function spawnShieldImpact(character: Model, hitFrom: Vector3?)
	local template = VfxHelper.getInvisibleWomanAsset("Forcefield", "ShieldImpactAttachment")
	local root = getRoot(character)
	if not template or not root then
		return
	end
	local pos = hitFrom or root.Position
	local host = Instance.new("Part")
	host.Name = "IwShieldImpact"
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.Transparency = 1
	host.Size = Vector3.new(0.2, 0.2, 0.2)
	host.CFrame = CFrame.new(pos)
	host.Parent = Workspace
	local fx = template:Clone()
	if fx:IsA("Attachment") then
		fx.Parent = host
	else
		fx.Parent = host
	end
	fadeParticles(fx, true)
	VfxHelper.emitAllParticles(fx, 10)
	task.delay(0.08, function()
		if fx.Parent then
			fadeParticles(fx, false)
		end
	end)
	task.delay(GameConstants.IW_FORCEFIELD_IMPACT_LIFE, function()
		if host.Parent then
			host:Destroy()
		end
	end)
end

local function stopForcefield(player: Player, applyCooldown: boolean, broken: boolean?)
	local state = shieldByPlayer[player]
	if not state then
		return
	end
	shieldByPlayer[player] = nil
	if state.healthConn then
		state.healthConn:Disconnect()
	end
	destroyShieldUi(state.billboard)
	stopTrack(state.animTrack)
	local character = state.character
	character:SetAttribute(GameConstants.IW_FORCEFIELD_ATTRIBUTE, nil)
	if character:GetAttribute(GameConstants.IW_FLIGHT_SHIELD_ATTRIBUTE) ~= true then
		character:SetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE, nil)
		character:SetAttribute(GameConstants.SHIELD_HP_ATTRIBUTE, nil)
	end
	local hum = CombatHelper.getHumanoid(character)
	if hum and state.lockWalk then
		hum.WalkSpeed = state.walk
		if state.jumpPower then
			hum.JumpPower = state.jumpPower
		end
		if state.jumpHeight then
			hum.JumpHeight = state.jumpHeight
		end
	end
	if state.forcefield.Parent then
		if broken then
			setIdleShieldParticles(state.forcefield, false)
			setBreakBurst(state.forcefield, true)
			task.delay(1, function()
				if state.forcefield.Parent then
					VfxHelper.smoothDisableParticles(state.forcefield, 0.5)
				end
			end)
		else
			setBreakBurst(state.forcefield, false)
			setIdleShieldParticles(state.forcefield, false)
			fadeOutVisual(state.forcefield, 0.4)
		end
	end
	endPowerFx(character)
	local flightFx = flightFxByCharacter[character]
	if flightFx and character:GetAttribute(GameConstants.IW_FLIGHT_SHIELD_ATTRIBUTE) == true then
		character:SetAttribute(GameConstants.SHIELD_HP_ATTRIBUTE, math.max(0, flightFx.hp))
		local root = getRoot(character)
		if root and not flightFx.billboard then
			local gui, label, fill = createShieldHpBillboard(root, flightFx.maxHp, true)
			flightFx.billboard = gui
			flightFx.hpLabel = label
			flightFx.hpFill = fill
			updateShieldUi(label, fill, flightFx.hp, flightFx.maxHp)
		end
	end
	if applyCooldown and not state.fromProtect then
		finishAbility(character, "iw_forcefield", GameConstants.IW_FORCEFIELD_COOLDOWN)
	else
		AbilityCooldownHelper.setActive(character, "iw_forcefield", false)
	end
end

local function startForcefield(player: Player, fromProtect: boolean?)
	local character = player.Character
	if not character then
		return
	end
	if shieldByPlayer[player] then
		if fromProtect then
			stopForcefield(player, false)
		else
			return
		end
	end
	local entry = CharacterRegistry.getAbilityById(HERO, "iw_forcefield")
	if not fromProtect then
		if not entry or not canUse(character, entry.id, 0) then
			return
		end
	end
	local root = getRoot(character)
	local template = VfxHelper.getInvisibleWomanAsset("Forcefield", "Forcefield")
	if not root or not template then
		return
	end
	if not fromProtect and entry then
		AbilityCooldownHelper.setActive(character, entry.id, true)
	end
	beginPowerFx(character)
	fireCameraShake(player, 0.38, 0.34, 0.26, 0.5)
	local ff = template:Clone()
	ff.Name = "IwForcefield"
	weldVisual(ff, root)
	setIdleShieldParticles(ff, true)
	local maxHp = if fromProtect then GameConstants.IW_PROTECT_SHIELD_HP else GameConstants.IW_FORCEFIELD_HP
	if not fromProtect and character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern" then
		maxHp = GameConstants.IW_FORCEFIELD_HP_MODERN
	end
	character:SetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.IW_FORCEFIELD_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.SHIELD_HP_ATTRIBUTE, maxHp)
	local hum = CombatHelper.getHumanoid(character)
	local savedWalk = GameConstants.DEFAULT_WALK_SPEED
	local savedJumpPower: number? = nil
	local savedJumpHeight: number? = nil
	local lockWalk = fromProtect ~= true
	if hum and lockWalk then
		savedWalk = hum.WalkSpeed
		if hum.UseJumpPower then
			savedJumpPower = hum.JumpPower
			hum.JumpPower = 0
		else
			savedJumpHeight = hum.JumpHeight
			hum.JumpHeight = 0
		end
		hum.WalkSpeed = GameConstants.IW_FORCEFIELD_WALK_SPEED
	end
	local flightFx = flightFxByCharacter[character]
	if flightFx then
		destroyShieldUi(flightFx.billboard)
		flightFx.billboard = nil
		flightFx.hpLabel = nil
		flightFx.hpFill = nil
	end
	local billboard, hpLabel, hpFill = createShieldHpBillboard(root, maxHp, true)
	local state: ShieldState = {
		character = character,
		hp = maxHp,
		maxHp = maxHp,
		forcefield = ff,
		walk = savedWalk,
		jumpPower = savedJumpPower,
		jumpHeight = savedJumpHeight,
		healthConn = nil,
		lastHealth = if hum then hum.Health else 100,
		billboard = billboard,
		hpLabel = hpLabel,
		hpFill = hpFill,
		lockWalk = lockWalk,
		fromProtect = fromProtect == true,
		animTrack = playCharacterAnim(character, GameConstants.IW_FORCEFIELD_ANIM, true, Enum.AnimationPriority.Action),
	}
	shieldByPlayer[player] = state
	if hum then
		state.healthConn = hum.HealthChanged:Connect(function(hp)
			local live = shieldByPlayer[player]
			if not live or live ~= state then
				return
			end
			if hp >= live.lastHealth then
				live.lastHealth = hp
				return
			end
			if hp <= 0 then
				return
			end
			local lost = live.lastHealth - hp
			hum.Health = live.lastHealth
			InvisibleWomanService.absorbShield(character, lost, nil)
		end)
	end
	if character:GetAttribute(GameConstants.IW_INVIS_ATTRIBUTE) == true then
		setDefenceHidden(character, true)
	end
end

local function isValidVictim(model: Model?, caster: Model): boolean
	if not model or model == caster or not model.Parent then
		return false
	end
	local hum = CombatHelper.getHumanoid(model)
	return hum ~= nil and hum.Health > 0 and CombatHelper.isCombatEligible(model)
end

local function resolveTarget(
	caster: Model,
	root: BasePart,
	target: Model?,
	direction: Vector3?,
	aimPoint: Vector3?,
	range: number,
	lockOn: boolean?
): Model?
	if isValidVictim(target, caster) then
		local tRoot = getRoot(target :: Model)
		if tRoot and (tRoot.Position - root.Position).Magnitude <= range then
			return target
		end
	end
	if lockOn ~= true then
		return nil
	end
	if aimPoint then
		local best: Model? = nil
		local bestD = AIM_POINT_RADIUS
		for _, model in CombatHelper.overlapCharacters(aimPoint, AIM_POINT_RADIUS, caster) do
			if not isValidVictim(model, caster) then
				continue
			end
			local tRoot = getRoot(model)
			if not tRoot then
				continue
			end
			local d = (tRoot.Position - aimPoint).Magnitude
			if d < bestD then
				bestD = d
				best = model
			end
		end
		if best then
			return best
		end
	end
	local aimDir = if direction and direction.Magnitude > 0.05
		then direction.Unit
		elseif aimPoint
		then normalizeDir(aimPoint - root.Position)
		else root.CFrame.LookVector
	return CombatHelper.raycastCharacter(root.Position, aimDir, range, caster)
end

local function liveAim(character: Model, fallback: Vector3?): Vector3?
	local attr = character:GetAttribute(GameConstants.IW_AIM_ATTRIBUTE)
	if typeof(attr) == "Vector3" then
		return attr
	end
	return fallback
end

local function spawnDiscImpact(pos: Vector3)
	playWorldSound(GameConstants.IW_DISC_HIT_SOUND, pos, 0.95)
	VfxHelper.spawnInvisibleWomanDiscImpact(pos)
end

local function returnDiscToCaster(visual: Instance, caster: Model, fromPos: Vector3)
	task.spawn(function()
		local pos = fromPos
		local speed = GameConstants.IW_DISC_SPEED * 0.9
		local fading = false
		local fadeDist = 6.2
		local removeDist = 3.2
		local fadeInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		while visual.Parent and caster.Parent do
			local root = getRoot(caster)
			if not root then
				break
			end
			local dest = root.Position + Vector3.new(0, 1.15, 0)
			local delta = dest - pos
			local dist = delta.Magnitude
			if dist <= removeDist then
				if visual.Parent then
					visual:Destroy()
				end
				return
			end
			if not fading and dist <= fadeDist then
				fading = true
				local function fadeInst(inst: Instance)
					if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture") then
						TweenService:Create(inst, fadeInfo, { Transparency = 1 }):Play()
					end
				end
				fadeInst(visual)
				for _, desc in visual:GetDescendants() do
					fadeInst(desc)
				end
				VfxHelper.smoothDisableParticles(visual, 0.18)
			end
			local dt = task.wait()
			local step = speed * math.max(dt, 0.016)
			if dist > 0.05 then
				pos += delta.Unit * math.min(step, dist)
				local look = delta.Unit
				local cf = CFrame.lookAt(pos, pos + look)
				if visual:IsA("Model") then
					visual:PivotTo(cf)
				elseif visual:IsA("BasePart") then
					visual.CFrame = cf
				end
			end
		end
		if visual.Parent then
			visual:Destroy()
		end
	end)
end

local function castDisc(player: Player, direction: Vector3?, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById(HERO, "disc_throw")
	if not entry or not canUse(character, entry.id, GameConstants.IW_DISC_ENERGY) then
		return
	end
	local root = getRoot(character)
	local template = VfxHelper.getInvisibleWomanAsset("DiscThrow", "Bolt")
	if not root or not template then
		return
	end
	AbilityCooldownHelper.setActive(character, entry.id, true)
	beginPowerFx(character)
	fireCameraShake(player, 0.4, 0.26, 0.3, 0.5)
	if aimPoint then
		character:SetAttribute(GameConstants.IW_AIM_ATTRIBUTE, aimPoint)
		faceToward(character, aimPoint, 0.34)
	elseif direction and direction.Magnitude > 0.05 then
		faceToward(character, root.Position + direction.Unit * 40, 0.34)
	end
	local useRight = discSideByPlayer[player] == true
	discSideByPlayer[player] = not useRight
	playCharacterAnim(
		character,
		if useRight then GameConstants.IW_DISC_RIGHT_ANIM else GameConstants.IW_DISC_LEFT_ANIM,
		false,
		Enum.AnimationPriority.Action
	)
	task.delay(0.1, function()
		if not character.Parent or not AbilityCooldownHelper.isActive(character, entry.id) then
			return
		end
		local liveRoot = getRoot(character)
		if not liveRoot then
			if character.Parent then
				endPowerFx(character)
				AbilityCooldownHelper.setActive(character, entry.id, false)
			end
			return
		end
		local hand = getHand(character, useRight)
		local origin = if hand
			then hand.Position + liveRoot.CFrame.LookVector * 0.35
			else liveRoot.Position + liveRoot.CFrame.LookVector * 2 + Vector3.new(0, 1.2, 0)
		local liveAim = character:GetAttribute(GameConstants.IW_AIM_ATTRIBUTE)
		local dir = if typeof(liveAim) == "Vector3"
			then normalizeDir(liveAim - origin)
			elseif aimPoint then normalizeDir(aimPoint - origin)
			else normalizeDir(direction or liveRoot.CFrame.LookVector)
		local bolt = template:Clone()
		if bolt:IsA("BasePart") then
			bolt.CFrame = CFrame.lookAt(origin, origin + dir)
			bolt.Anchored = true
			bolt.CanCollide = false
			bolt.Parent = Workspace
			fadeParticles(bolt, true)
		elseif bolt:IsA("Model") then
			bolt:PivotTo(CFrame.lookAt(origin, origin + dir))
			bolt.Parent = Workspace
			fadeParticles(bolt, true)
		end
		playWorldSound(GameConstants.IW_DISC_RELEASE_SOUND, origin, 0.9)
		ProjectileHelper.spawn(origin, dir, {
			speed = GameConstants.IW_DISC_SPEED,
			damage = GameConstants.IW_DISC_DAMAGE,
			radius = GameConstants.IW_DISC_HIT_RADIUS,
			maxDistance = GameConstants.IW_DISC_RANGE,
			owner = character,
			customVisual = bolt,
			impactFx = "none",
			keepVisual = true,
			impactOnCharacter = true,
			onImpact = function(pos: Vector3)
				spawnDiscImpact(pos)
				if bolt.Parent then
					returnDiscToCaster(bolt, character, pos)
				end
			end,
		})
		task.delay(0.2, function()
			if character.Parent then
				endPowerFx(character)
				if AbilityCooldownHelper.isActive(character, entry.id) then
					finishAbility(character, entry.id, GameConstants.IW_DISC_COOLDOWN)
				end
			end
		end)
	end)
end

local function destroyPush(player: Player)
	local state = pushByPlayer[player]
	if not state then
		return
	end
	pushByPlayer[player] = nil
	state.alive = false
	if not state.launched then
		restoreMove(state.owner, state.walk, state.jumpPower, state.jumpHeight, state.autoRotate)
		if state.owner.Parent then
			state.owner:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
		end
	end
	if state.visual.Parent then
		fadeOutVisual(state.visual, GameConstants.IW_PUSH_FADE)
	end
end

local function castPush(player: Player, direction: Vector3?, aimPoint: Vector3?)
	local character = player.Character
	if not character or pushByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById(HERO, "forcefield_push")
	if not entry or not canUse(character, entry.id, GameConstants.IW_PUSH_ENERGY) then
		return
	end
	local root = getRoot(character)
	local template = VfxHelper.getInvisibleWomanAsset("ForcefieldPush", "ForcefieldPush")
	if not root or not template then
		return
	end
	AbilityCooldownHelper.setActive(character, entry.id, true)
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	beginPowerFx(character)
	playCharacterAnim(character, GameConstants.IW_PUSH_ANIM, false, Enum.AnimationPriority.Action)
	fireCameraShake(player, 0.52, 0.4, 0.38, 0.62)
	if aimPoint then
		character:SetAttribute(GameConstants.IW_AIM_ATTRIBUTE, aimPoint)
	end
	local flatLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	local dir = if flatLook.Magnitude > 0.05 then flatLook.Unit else Vector3.new(0, 0, -1)
	local origin = root.Position + Vector3.new(0, 1.2, 0) + dir * 2.2
	local clone = template:Clone()
	local part: BasePart?
	if clone:IsA("BasePart") then
		part = clone
		clone.CFrame = CFrame.lookAt(origin, origin + dir)
		clone.Anchored = true
		clone.CanCollide = false
		clone.CanQuery = true
		clone.CanTouch = true
		clone.Parent = Workspace
	elseif clone:IsA("Model") then
		clone:PivotTo(CFrame.lookAt(origin, origin + dir))
		clone.Parent = Workspace
		part = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
		if part then
			part.Anchored = true
			part.CanCollide = false
		end
	end
	if not part then
		clone:Destroy()
		endPowerFx(character)
		AbilityCooldownHelper.setActive(character, entry.id, false)
		return
	end
	fadeParticles(clone, true)
	fireCameraShake(player, 0.38, 0.28, 0.28, 0.45)
	local walk, jumpPower, jumpHeight = captureAndLockMove(character)
	local hum = CombatHelper.getHumanoid(character)
	local autoRotate = if hum then hum.AutoRotate else true
	if hum then
		hum.AutoRotate = false
	end
	pushByPlayer[player] = {
		part = part,
		visual = clone,
		owner = character,
		hit = {},
		alive = true,
		launched = false,
		launchAt = os.clock() + GameConstants.IW_PUSH_WINDUP,
		dir = dir,
		bornAt = os.clock(),
		casterHoldPos = root.Position,
		walk = walk,
		jumpPower = jumpPower,
		jumpHeight = jumpHeight,
		autoRotate = autoRotate,
	}
	task.delay(0.25, function()
		if character.Parent then
			endPowerFx(character)
			if AbilityCooldownHelper.isActive(character, entry.id) then
				finishAbility(character, entry.id, GameConstants.IW_PUSH_COOLDOWN)
			end
		end
	end)
end

local function attachInvisMorphFx(character: Model): { Instance }
	local copied: { Instance } = {}
	local morph = VfxHelper.getInvisibleWomanAsset("InvisibilityMorph")
	if not morph then
		return copied
	end
	for _, src in morph:GetChildren() do
		if src:IsA("BasePart") then
			local dest = character:FindFirstChild(src.Name)
			if dest and dest:IsA("BasePart") then
				for _, child in src:GetChildren() do
					if child:IsA("Attachment") or child:IsA("ParticleEmitter") then
						local clone = child:Clone()
						clone.Name = "IwInvisFx"
						clone.Parent = dest
						table.insert(copied, clone)
					end
				end
			end
		end
	end
	return copied
end

local function restoreInvis(player: Player, character: Model?)
	local state = invisByPlayer[player]
	if not state then
		return
	end
	invisByPlayer[player] = nil
	local char = character or state.character
	local token = (invisToken[player] or 0) + 1
	invisToken[player] = token
	char:SetAttribute(GameConstants.IW_INVIS_ATTRIBUTE, nil)
	local charRoot = getRoot(char)
	if charRoot then
		playWorldSound(GameConstants.IW_INVIS_OFF_SOUND, charRoot.Position, 0.9)
	end
	pcall(function()
		NameplateService.setHidden(char, false, GameConstants.IW_INVIS_FADE)
	end)
	for _, fx in state.fx do
		if fx.Parent then
			fx:Destroy()
		end
	end
	local copied = attachInvisMorphFx(char)
	for _, fx in copied do
		fadeParticles(fx, true)
		VfxHelper.emitAllParticles(fx, 6)
	end
	local fadeTime = GameConstants.IW_INVIS_FADE
	local sweep = GameConstants.IW_INVIS_SWEEP
	local minY, maxY = math.huge, -math.huge
	for _, rec in state.saved do
		if rec.inst.Parent then
			local y = worldYOf(rec.inst)
			if y < minY then
				minY = y
			end
			if y > maxY then
				maxY = y
			end
		end
	end
	local span = math.max(0.2, maxY - minY)
	for _, rec in state.saved do
		if rec.inst.Parent and (rec.inst:IsA("BasePart") or rec.inst:IsA("Decal") or rec.inst:IsA("Texture")) then
			local y = worldYOf(rec.inst)
			local delay = ((maxY - y) / span) * sweep
			task.delay(delay, function()
				if invisToken[player] ~= token or not rec.inst.Parent then
					return
				end
				if isFlightFxInst(char, rec.inst) then
					return
				end
				TweenService:Create(
					rec.inst,
					TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Transparency = rec.t }
				):Play()
			end)
		end
	end
	task.delay(sweep + fadeTime, function()
		if invisToken[player] ~= token then
			return
		end
		for _, fx in copied do
			if fx.Parent then
				fadeParticles(fx, false)
			end
		end
		task.delay(0.35, function()
			for _, fx in copied do
				if fx.Parent then
					fx:Destroy()
				end
			end
		end)
	end)
	setDefenceHidden(char, false)
	restoreFlightFx(char)
	if char.Parent then
		finishAbility(char, "invisibility", GameConstants.IW_INVIS_COOLDOWN)
	end
end

local function castInvis(player: Player)
	local character = player.Character
	if not character then
		return
	end
	if invisByPlayer[player] then
		restoreInvis(player, character)
		return
	end
	local entry = CharacterRegistry.getAbilityById(HERO, "invisibility")
	if not entry or not canUse(character, entry.id, GameConstants.IW_INVIS_ENERGY) then
		return
	end
	AbilityCooldownHelper.setActive(character, entry.id, true)
	hideHandVfx(character)
	fireCameraShake(player, 0.36, 0.42, 0.22, 0.48)
	local root = getRoot(character)
	if root then
		playWorldSound(GameConstants.IW_INVIS_ON_SOUND, root.Position, 0.9)
	end
	local copied = attachInvisMorphFx(character)
	for _, fx in copied do
		fadeParticles(fx, true)
		VfxHelper.emitAllParticles(fx, 6)
	end
	local saved: { { inst: Instance, t: number } } = {}
	local function remember(inst: Instance)
		if isFlightFxInst(character, inst) then
			return
		end
		if isPowerFxInst(character, inst) then
			return
		end
		if inst.Name == "IwInvisFx" then
			return
		end
		if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture") then
			table.insert(saved, { inst = inst, t = stealthTransparencyOf(character, inst, inst.Transparency) })
		end
	end
	for _, desc in character:GetDescendants() do
		remember(desc)
		if desc:IsA("Accessory") then
			for _, p in desc:GetDescendants() do
				remember(p)
			end
		end
	end
	local token = (invisToken[player] or 0) + 1
	invisToken[player] = token
	invisByPlayer[player] = {
		character = character,
		fx = copied,
		saved = saved,
		token = token,
	}
	character:SetAttribute(GameConstants.IW_INVIS_ATTRIBUTE, true)
	setDefenceHidden(character, true)
	if crushByPlayer[player] or areaByPlayer[player] then
		local fx = powerFxByCharacter[character]
		if fx and #fx.instances == 0 then
			fx.instances = spawnHandVfx(character)
		end
	end
	task.delay(GameConstants.IW_INVIS_COPY_WAIT, function()
		if invisToken[player] ~= token then
			return
		end
		for _, fx in copied do
			if fx.Parent then
				fadeParticles(fx, false)
			end
		end
		local fadeTime = GameConstants.IW_INVIS_FADE
		local sweep = GameConstants.IW_INVIS_SWEEP
		local minY, maxY = math.huge, -math.huge
		for _, rec in saved do
			if rec.inst.Parent then
				local y = worldYOf(rec.inst)
				if y < minY then
					minY = y
				end
				if y > maxY then
					maxY = y
				end
			end
		end
		local span = math.max(0.2, maxY - minY)
		for _, rec in saved do
			if rec.inst.Parent and (rec.inst:IsA("BasePart") or rec.inst:IsA("Decal") or rec.inst:IsA("Texture")) then
				local y = worldYOf(rec.inst)
				local delay = ((maxY - y) / span) * sweep
				task.delay(delay, function()
					if invisToken[player] ~= token or not rec.inst.Parent then
						return
					end
					if isFlightFxInst(character, rec.inst) then
						return
					end
					TweenService:Create(
						rec.inst,
						TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
						{ Transparency = 1 }
					):Play()
				end)
			end
		end
		pcall(function()
			NameplateService.setHidden(character, true, sweep + fadeTime)
		end)
	end)
end

local function getHead(model: Model): BasePart?
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	return getRoot(model)
end

local function charactersInPart(part: BasePart, visual: Instance, owner: Model): { Model }
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { owner, visual }
	local cf = part.CFrame
	local size = part.Size
	if visual:IsA("Model") then
		cf, size = visual:GetBoundingBox()
	end
	local hits = Workspace:GetPartBoundsInBox(cf, size, params)
	local seen: { [Model]: boolean } = {}
	local results: { Model } = {}
	for _, hit in hits do
		local character = CombatHelper.getCharacterFromPart(hit)
		if character and not seen[character] and character ~= owner then
			seen[character] = true
			if isValidVictim(character, owner) then
				table.insert(results, character)
			end
		end
	end
	return results
end

local function releaseChokeVictim(hold: ChokeVictim)
	local hum = CombatHelper.getHumanoid(hold.character)
	if hum and hum.Parent and hum.Health > 0 then
		hum.WalkSpeed = hold.walk
		if hold.jumpPower ~= nil then
			hum.JumpPower = hold.jumpPower
		end
		if hold.jumpHeight ~= nil then
			hum.JumpHeight = hold.jumpHeight
		end
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end)
	end
	if hold.fx and hold.fx.Parent then
		fadeOutVisual(hold.fx, GameConstants.IW_CHOKE_FADE)
	end
	if hold.previousPowersDisabledUntil ~= nil then
		hold.character:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, hold.previousPowersDisabledUntil)
	else
		hold.character:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, nil)
	end
	hold.character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
	if Players:GetPlayerFromCharacter(hold.character) then
		hold.character:SetAttribute(GameConstants.IW_CHOKED_ATTRIBUTE, nil)
	end
end

local function stopChoke(state: AreaState, applyCooldown: boolean?)
	local wasChoking = state.choking
	state.choking = false
	for victim, hold in state.victims do
		releaseChokeVictim(hold)
		state.victims[victim] = nil
	end
	if state.character.Parent then
		if wasChoking and applyCooldown then
			finishAbility(state.character, "forcefield_choke", GameConstants.IW_CHOKE_COOLDOWN)
		else
			AbilityCooldownHelper.setActive(state.character, "forcefield_choke", false)
		end
	end
end

local function findChildByNames(root: Instance?, names: { string }): Instance?
	if not root then
		return nil
	end
	for _, name in names do
		local child = root:FindFirstChild(name)
		if child then
			return child
		end
		local deep = root:FindFirstChild(name, true)
		if deep then
			return deep
		end
	end
	return nil
end

local function getForcefieldAreaRoot(): Instance?
	return VfxHelper.getInvisibleWomanAsset("ForcefieldArea")
end

local function getAreaVisualTemplate(): Instance?
	return VfxHelper.getInvisibleWomanAsset("ForcefieldArea", "ForcefieldArea")
end

local function getChokeTemplate(): Instance?
	local root = getForcefieldAreaRoot()
	local named = findChildByNames(root, { "ChokeAttachment", "ChokenArea", "ChokeArea", "Choke" })
	if named then
		return named
	end
	return VfxHelper.getInvisibleWomanAsset("ForcefieldPush", "ChokeAttachment")
end

local function attachChokeFx(victim: Model): Instance?
	local template = getChokeTemplate()
	local head = getHead(victim)
	if not template or not head then
		return nil
	end
	local fx = template:Clone()
	fx.Name = "IwChokeAttachment"
	fx.Parent = head
	fadeParticles(fx, true)
	VfxHelper.emitAllParticles(fx, 8)
	return fx
end

local function seizeChokeVictim(owner: Model, victim: Model): ChokeVictim?
	local hum = CombatHelper.getHumanoid(victim)
	if not hum or hum.Health <= 0 then
		return nil
	end
	local jumpPower: number? = if hum.UseJumpPower then hum.JumpPower else nil
	local jumpHeight: number? = nil
	if not hum.UseJumpPower then
		pcall(function()
			jumpHeight = hum.JumpHeight
		end)
	end
	local hold: ChokeVictim = {
		character = victim,
		walk = hum.WalkSpeed,
		jumpPower = jumpPower,
		jumpHeight = jumpHeight,
		fx = attachChokeFx(victim),
		damageTaken = 0,
		previousPowersDisabledUntil = victim:GetAttribute(GameConstants.POWERS_DISABLED_UNTIL),
	}
	hum.WalkSpeed = 0
	if hum.UseJumpPower then
		hum.JumpPower = 0
	else
		hum.JumpHeight = 0
	end
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	end)
	victim:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	victim:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, AbilityCooldownHelper.getNow() + 0.5)
	if Players:GetPlayerFromCharacter(victim) then
		victim:SetAttribute(GameConstants.IW_CHOKED_ATTRIBUTE, true)
	end
	return hold
end

local function endArea(player: Player, applyCooldown: boolean, broken: boolean?)
	local state = areaByPlayer[player]
	if not state then
		return
	end
	areaByPlayer[player] = nil
	local ragdollVictims: { Model } = {}
	if state.choking then
		for victim in state.victims do
			table.insert(ragdollVictims, victim)
		end
	end
	stopChoke(state, applyCooldown)
	for victim, previous in state.powerDisabled do
		if victim.Parent then
			victim:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, previous)
		end
		state.powerDisabled[victim] = nil
	end
	for _, victim in ragdollVictims do
		if victim.Parent then
			RagdollService.applyTimed(victim, 3)
		end
	end
	destroyShieldUi(state.billboard)
	if state.visual.Parent then
		disableAreaShieldCollision(state.visual)
		fadeOutVisual(state.visual, GameConstants.IW_AREA_FADE, true)
	elseif state.part.Parent then
		disableAreaShieldCollision(state.part)
		fadeOutVisual(state.part, GameConstants.IW_AREA_FADE, true)
	end
	endPowerFx(state.character)
	if state.character.Parent then
		state.character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
	end
	local casterHum = CombatHelper.getHumanoid(state.character)
	if casterHum and state.character.Parent then
		clearCastFace(state.character)
		restoreMove(state.character, state.walk, state.jumpPower, state.jumpHeight, state.autoRotate)
	end
	if applyCooldown then
		finishAbility(state.character, "forcefield_area", GameConstants.IW_AREA_COOLDOWN)
	else
		AbilityCooldownHelper.setActive(state.character, "forcefield_area", false)
	end
	local shield = shieldByPlayer[player]
	if shield and shield.fromProtect then
		stopForcefield(player, false)
		if state.character.Parent then
			if applyCooldown then
				finishAbility(state.character, "forcefield_protect", GameConstants.IW_PROTECT_COOLDOWN)
			else
				AbilityCooldownHelper.setActive(state.character, "forcefield_protect", false)
			end
		end
	end
end

local function startChoke(player: Player)
	local state = areaByPlayer[player]
	if not state or not state.part.Parent then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById(HERO, "forcefield_choke")
	if not entry or not canUse(character, entry.id, 0) then
		return
	end
	if state.choking then
		return
	end
	AbilityCooldownHelper.setActive(character, entry.id, true)
	state.choking = true
	fireCameraShake(player, 0.38, 0.28, 0.2, 0.4)
	faceToward(character, state.part.Position, 0.4)
end

local function protectArea(player: Player)
	local state = areaByPlayer[player]
	if not state then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById(HERO, "forcefield_protect")
	if not entry or not canUse(character, entry.id, 0) then
		return
	end
	local existingShield = shieldByPlayer[player]
	if existingShield and existingShield.fromProtect then
		return
	end
	startForcefield(player, true)
	AbilityCooldownHelper.setActive(character, entry.id, true)
	fireCameraShake(player, 0.28, 0.22, 0.12, 0.3)
end

local function stopProtect(player: Player, applyCooldown: boolean)
	local character = player.Character
	local wasActive = character ~= nil and AbilityCooldownHelper.isActive(character, "forcefield_protect")
	local shield = shieldByPlayer[player]
	if shield and shield.fromProtect then
		stopForcefield(player, false)
	end
	if not character then
		return
	end
	if wasActive and applyCooldown then
		finishAbility(character, "forcefield_protect", GameConstants.IW_PROTECT_COOLDOWN)
	else
		AbilityCooldownHelper.setActive(character, "forcefield_protect", false)
	end
end

local function stampAreaShield(root: Instance, part: BasePart, maxHp: number)
	local function prep(bp: BasePart)
		bp.Anchored = true
		bp.CanCollide = true
		bp.CanQuery = true
		bp.CanTouch = false
		bp:SetAttribute("IwAreaShield", true)
		bp:SetAttribute("IwAreaHp", maxHp)
	end
	prep(part)
	if root:IsA("BasePart") then
		prep(root)
	end
	for _, desc in root:GetDescendants() do
		if desc:IsA("BasePart") then
			prep(desc)
		end
	end
	root:SetAttribute("IwAreaShield", true)
	root:SetAttribute("IwAreaHp", maxHp)
end

local function placeAreaVisual(aimPoint: Vector3): (BasePart?, Instance?)
	local template = getAreaVisualTemplate()
	if not template then
		warn("[InvisibleWoman] Missing Assets.InvisibleWoman.ForcefieldArea.ForcefieldArea")
		return nil, nil
	end
	local clone = template:Clone()
	clone.Name = "IwForcefieldArea"
	local maxHp = GameConstants.IW_AREA_HP
	if clone:IsA("BasePart") then
		local part = clone
		part.CFrame = CFrame.new(aimPoint)
		stampAreaShield(clone, part, maxHp)
		part.Parent = Workspace
		return part, part
	end
	if clone:IsA("Model") then
		local primary = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
		if not primary then
			clone:Destroy()
			return nil, nil
		end
		if not clone.PrimaryPart then
			clone.PrimaryPart = primary
		end
		clone:PivotTo(CFrame.new(aimPoint))
		stampAreaShield(clone, primary, maxHp)
		clone.Parent = Workspace
		return primary, clone
	end
	if clone:IsA("Attachment") then
		local host = Instance.new("Part")
		host.Name = "IwForcefieldArea"
		host.Anchored = true
		host.CanCollide = true
		host.CanQuery = true
		host.Transparency = 1
		host.Size = Vector3.new(12, 12, 12)
		host.CFrame = CFrame.new(aimPoint)
		host.Parent = Workspace
		clone.Parent = host
		stampAreaShield(host, host, maxHp)
		return host, host
	end
	clone:Destroy()
	return nil, nil
end

local function castArea(player: Player, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local existing = areaByPlayer[player]
	if existing then
		endArea(player, true, false)
		return
	end
	local entry = CharacterRegistry.getAbilityById(HERO, "forcefield_area")
	local map = Workspace:FindFirstChild("Map")
	local spawnModel = map and map:FindFirstChild("SpawnModel")
	if spawnModel and spawnModel:IsA("Model") and aimPoint then
		local boxCf, boxSize = spawnModel:GetBoundingBox()
		local expanded = boxSize + Vector3.new(24, 24, 24)
		local localPoint = boxCf:PointToObjectSpace(aimPoint)
		if math.abs(localPoint.X) <= expanded.X * 0.5
			and math.abs(localPoint.Y) <= expanded.Y * 0.5
			and math.abs(localPoint.Z) <= expanded.Z * 0.5
		then
			return
		end
	end
	if not entry or not canUse(character, entry.id, GameConstants.IW_AREA_ENERGY) then
		return
	end
	local root = getRoot(character)
	if not root then
		return
	end
	local aim = aimPoint
		or liveAim(character, root.Position + root.CFrame.LookVector * 24)
		or (root.Position + root.CFrame.LookVector * 24)
	faceToward(character, aim, 0.36)
	local part, visual = placeAreaVisual(aim)
	if not part or not visual then
		local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		if type(energy) == "number" then
			character:SetAttribute(GameConstants.ENERGY_ATTRIBUTE, energy + GameConstants.IW_AREA_ENERGY)
		end
		return
	end
	AbilityCooldownHelper.setActive(character, entry.id, true)
	beginPowerFx(character, true)
	fireCameraShake(player, 0.52, 0.38, 0.44, 0.55)
	local maxHp = GameConstants.IW_AREA_HP
	local billboard, hpLabel, hpFill = createShieldHpBillboard(part, maxHp, true)
	local hum = CombatHelper.getHumanoid(character)
	local savedWalk = GameConstants.DEFAULT_WALK_SPEED
	local savedJumpPower: number? = nil
	local savedJumpHeight: number? = nil
	local savedAutoRotate = true
	if hum then
		savedWalk = hum.WalkSpeed
		savedJumpPower = hum.JumpPower
		savedJumpHeight = hum.JumpHeight
		savedAutoRotate = hum.AutoRotate
		lockHumanoidMotion(hum)
		hum.AutoRotate = false
		hum:Move(Vector3.zero, false)
	end
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	areaByPlayer[player] = {
		character = character,
		part = part,
		visual = visual,
		choking = false,
		victims = {},
		powerDisabled = {},
		tickAcc = 0,
		hp = maxHp,
		maxHp = maxHp,
		billboard = billboard,
		hpLabel = hpLabel,
		hpFill = hpFill,
		walk = savedWalk,
		jumpPower = savedJumpPower,
		jumpHeight = savedJumpHeight,
		autoRotate = savedAutoRotate,
	}
	updateShieldUi(hpLabel, hpFill, maxHp, maxHp)
end

local function updateArea(player: Player, state: AreaState, dt: number)
	if not state.character.Parent or not state.part.Parent or player.Character ~= state.character then
		endArea(player, true, false)
		return
	end
	local extra = 0
	if state.choking then
		local n = 0
		for _victim in state.victims do
			n += 1
		end
		extra = GameConstants.IW_CHOKE_ENERGY_PER_VICTIM_PER_SEC * n
	end
	local areaDrain = (GameConstants.IW_AREA_ENERGY_PER_SEC + extra) * dt
	if state.character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern" then
		areaDrain *= 0.75
	end
	if not CharacterService.spendEnergy(state.character, areaDrain) then
		endArea(player, true, false)
		return
	end
	local flying = state.character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
	local modern = state.character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern"
	local strainRate = GameConstants.IW_HYPERSPACE_AREA_PER_SEC
	if flying and modern then
		strainRate = GameConstants.IW_HYPERSPACE_AREA_FLIGHT_PER_SEC
	end
	local maxHs = GameConstants.IW_HYPERSPACE_MAX
	local hs = state.character:GetAttribute(GameConstants.IW_HYPERSPACE_ATTRIBUTE)
	if type(hs) ~= "number" then
		hs = 0
	end
	hs = math.clamp(hs + strainRate * dt, 0, maxHs)
	state.character:SetAttribute(GameConstants.IW_HYPERSPACE_ATTRIBUTE, hs)
	state.character:SetAttribute(GameConstants.IW_HYPERSPACE_MAX_ATTRIBUTE, maxHs)
	if hs >= maxHs then
		state.character:SetAttribute(GameConstants.IW_HYPERSPACE_LOCK_ATTRIBUTE, true)
		HexFlightService.endFlight(player, true)
		endArea(player, true, false)
		return
	end
	local attrHp = state.visual:GetAttribute("IwAreaHp")
	if type(attrHp) == "number" then
		state.hp = attrHp
	end
	if state.visual:GetAttribute("IwAreaBroken") == true or state.hp <= 0 then
		endArea(player, true, true)
		return
	end
	updateShieldUi(state.hpLabel, state.hpFill, state.hp, state.maxHp)
	local casterHum = CombatHelper.getHumanoid(state.character)
	local casterRoot = getRoot(state.character)
	if casterHum then
		lockHumanoidMotion(casterHum)
		casterHum.AutoRotate = false
		casterHum:Move(Vector3.zero, false)
	end
	if casterRoot then
		casterRoot.AssemblyLinearVelocity = Vector3.zero
		casterRoot.AssemblyAngularVelocity = Vector3.zero
	end
	local insideArea: { [Model]: boolean } = {}
	for _, victim in charactersInPart(state.part, state.visual, state.character) do
		insideArea[victim] = true
		if state.powerDisabled[victim] == nil then
			state.powerDisabled[victim] = victim:GetAttribute(GameConstants.POWERS_DISABLED_UNTIL)
		end
		victim:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, AbilityCooldownHelper.getNow() + 0.5)
	end
	for victim, previous in state.powerDisabled do
		if not insideArea[victim] or not victim.Parent then
			victim:SetAttribute(GameConstants.POWERS_DISABLED_UNTIL, previous)
			state.powerDisabled[victim] = nil
		end
	end
	if not state.choking then
		return
	end
	local inside: { [Model]: boolean } = {}
	for _, victim in charactersInPart(state.part, state.visual, state.character) do
		inside[victim] = true
		if not state.victims[victim] then
			local hold = seizeChokeVictim(state.character, victim)
			if hold then
				state.victims[victim] = hold
			end
		end
	end
	for victim, hold in state.victims do
		if not inside[victim] or not victim.Parent then
			releaseChokeVictim(hold)
			state.victims[victim] = nil
		end
	end
	state.tickAcc += dt
	if state.tickAcc >= GameConstants.IW_CHOKE_TICK then
		local slice = state.tickAcc
		state.tickAcc = 0
		local n = 0
		for _victim, _hold in state.victims do
			n += 1
		end
		if n <= 0 then
			return
		end
		local dmg = (GameConstants.IW_CHOKE_DAMAGE_PER_SEC / n) * slice
		for victim, _hold in state.victims do
			local vRoot = getRoot(victim)
			CombatHelper.dealDamage(state.character, victim, dmg, vRoot and vRoot.Position or nil, "dot")
		end
	end
end

local function endCrush(player: Player, applyCooldown: boolean, launchVictim: boolean?)
	local state = crushByPlayer[player]
	if not state then
		return
	end
	crushByPlayer[player] = nil
	stopTrack(state.casterAnim)
	stopTrack(state.victimAnim)
	state.victim:SetAttribute(GameConstants.MG_TK_CONTROLLED_ATTRIBUTE, nil)
	state.victim:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
	if state.character.Parent then
		state.character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
	end
	local casterRoot = getRoot(state.character)
	clearCrushFace(casterRoot)
	local casterHum = CombatHelper.getHumanoid(state.character)
	if casterHum then
		unlockHumanoidMotion(casterHum, state.walk, state.jumpPower, state.jumpHeight)
		casterHum.AutoRotate = state.autoRotate
	end
	if casterRoot then
		local plr = Players:GetPlayerFromCharacter(state.character)
		pcall(function()
			if plr then
				casterRoot:SetNetworkOwner(plr)
			else
				casterRoot:SetNetworkOwnershipAuto()
			end
		end)
	end
	if state.fx.Parent then
		fadeParticles(state.fx, false)
		task.delay(0.4, function()
			if state.fx.Parent then
				state.fx:Destroy()
			end
		end)
	end
	endPowerFx(state.character)
	if launchVictim and state.victim.Parent and state.vRoot.Parent then
		local victim = state.victim
		local vRoot = state.vRoot
		local away = vRoot.Position - state.casterHoldPos
		local dir = if away.Magnitude > 0.05 then away.Unit else Vector3.new(0, 0, -1)
		local speed = GameConstants.IW_CRUSH_KNOCK_SPEED
		local up = GameConstants.IW_CRUSH_KNOCK_UP
		local velocity = dir * speed + Vector3.new(0, up, 0)
		PushHelper.applyToCharacter(victim, dir, {
			speed = speed,
			upBoost = up,
			impulseMult = 1.35,
		})
		vRoot.AssemblyLinearVelocity = velocity
		RagdollService.applyTimed(victim, 2.2)
		task.delay(0.05, function()
			if not victim.Parent then
				return
			end
			PushHelper.applyToCharacter(victim, dir, {
				speed = speed,
				upBoost = up,
				impulseMult = 1.35,
			})
			for _, desc in victim:GetDescendants() do
				if desc:IsA("BasePart") and not desc.Anchored then
					desc.AssemblyLinearVelocity = velocity
				end
			end
		end)
	end
	if applyCooldown then
		finishAbility(state.character, "forcefield_crush", GameConstants.IW_CRUSH_COOLDOWN)
	else
		AbilityCooldownHelper.setActive(state.character, "forcefield_crush", false)
	end
end

local function tryCrushExecute(character: Model, victim: Model, vRoot: BasePart): boolean
	if character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) ~= "modern" then
		return false
	end
	local hum = CombatHelper.getHumanoid(victim)
	if not hum or hum.MaxHealth <= 0 then
		return false
	end
	if hum.Health / hum.MaxHealth >= GameConstants.IW_CRUSH_EXECUTE_HP then
		return false
	end
	if AbilityCooldownHelper.isOnCooldown(character, "crush_execute") then
		return false
	end
	local snaps = VfxHelper.captureVisibleParts(victim)
	local crushFx: Instance? = nil
	local template = VfxHelper.getInvisibleWomanAsset("ForcefieldCrush", "BodyCrushInsta")
	if template then
		local fx = template:Clone()
		fx.Name = "IwBodyCrushInsta"
		crushFx = fx
		if fx:IsA("Attachment") then
			fx.Position = Vector3.zero
			fx.Parent = vRoot
		else
			fx.Parent = vRoot
		end
		fadeParticles(fx, true)
		VfxHelper.emitAllParticles(fx, 16)
		task.delay(4, function()
			if fx.Parent then
				fadeParticles(fx, false)
			end
		end)
		task.delay(6, function()
			if fx.Parent then
				fx:Destroy()
			end
		end)
	end
	AbilityCooldownHelper.applyAfterUse(character, "crush_execute", GameConstants.IW_CRUSH_EXECUTE_COOLDOWN)
	AbilityCooldownHelper.applyAfterUse(character, "forcefield_crush", GameConstants.IW_CRUSH_EXECUTE_COOLDOWN)
	AbilityCooldownHelper.setActive(character, "forcefield_crush", false)
	VfxHelper.hideCapturedParts(snaps)
	for _, desc in victim:GetDescendants() do
		if crushFx and (desc == crushFx or desc:IsDescendantOf(crushFx)) then
			continue
		end
		if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
			desc.Transparency = 1
			for _, child in desc:GetChildren() do
				if child:IsA("Decal") or child:IsA("Texture") then
					child.Transparency = 1
				end
			end
		end
	end
	local victimPlayer = Players:GetPlayerFromCharacter(victim)
	if victimPlayer then
		local crushRed = Color3.fromRGB(190, 18, 18)
		ScreenFeelHelper.setTint(victim, crushRed, 1.25)
		ScreenFeelHelper.pulsePlayer(victimPlayer, {
			intensity = 0.72,
			duration = 0.7,
			fovScale = 0.45,
			vignetteScale = 0.85,
			tint = crushRed,
			tintDuration = 1.05,
		})
	end
	hum.Health = 0
	playWorldSound(GameConstants.IW_CRUSH_INSTA_SOUND, vRoot.Position, 1.15)
	local ownerPlayer = Players:GetPlayerFromCharacter(character)
	if ownerPlayer then
		fireCameraShake(ownerPlayer, 0.78, 0.48, 0.58, 0.9)
	end
	return true
end

local function startCrush(player: Player, target: Model?, direction: Vector3?, aimPoint: Vector3?, lockOn: boolean?)
	local character = player.Character
	if not character or crushByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById(HERO, "forcefield_crush")
	if not entry then
		return
	end
	local root = getRoot(character)
	if not root then
		return
	end
	local victim = resolveTarget(character, root, target, direction, aimPoint, GameConstants.IW_CRUSH_RANGE, lockOn)
	if not victim then
		return
	end
	local vRoot = getRoot(victim)
	if not vRoot then
		return
	end
	if not canUse(character, entry.id, GameConstants.IW_CRUSH_START_ENERGY) then
		return
	end
	if tryCrushExecute(character, victim, vRoot) then
		beginPowerFx(character, true)
		task.delay(0.25, function()
			if character.Parent then
				endPowerFx(character)
			end
		end)
		return
	end
	AbilityCooldownHelper.setActive(character, entry.id, true)
	beginPowerFx(character, true)
	fireCameraShake(player, 0.56, 0.42, 0.4, 0.65)
	victim:SetAttribute(GameConstants.MG_TK_CONTROLLED_ATTRIBUTE, true)
	victim:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	local casterHum = CombatHelper.getHumanoid(character)
	local walk = GameConstants.DEFAULT_WALK_SPEED
	local jumpPower: number? = nil
	local jumpHeight: number? = nil
	local autoRotate = true
	if casterHum then
		walk = casterHum.WalkSpeed
		autoRotate = casterHum.AutoRotate
		jumpPower = casterHum.JumpPower
		pcall(function()
			jumpHeight = casterHum.JumpHeight
		end)
		lockHumanoidMotion(casterHum)
		casterHum.AutoRotate = false
		casterHum:Move(Vector3.zero, false)
	end
	local victimHum = CombatHelper.getHumanoid(victim)
	if victimHum then
		lockHumanoidMotion(victimHum)
	end
	local lookCf = yawLookAt(root.Position, vRoot.Position)
	root.CFrame = CFrame.new(root.Position) * lookCf.Rotation
	ensureCrushFaceAlign(root, lookCf)
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local template = VfxHelper.getInvisibleWomanAsset("ForcefieldCrush", "BodyCrush")
	local fx: Instance
	if template then
		fx = template:Clone()
		fx.Name = "IwBodyCrush"
		if fx:IsA("BasePart") then
			fx.Anchored = true
			fx.CanCollide = false
			fx.CFrame = vRoot.CFrame
			fx.Parent = Workspace
		elseif fx:IsA("Model") then
			fx:PivotTo(vRoot.CFrame)
			fx.Parent = Workspace
			for _, desc in fx:GetDescendants() do
				if desc:IsA("BasePart") then
					desc.Anchored = true
					desc.CanCollide = false
				end
			end
		else
			fx.Parent = Workspace
		end
		fadeParticles(fx, true)
		VfxHelper.emitAllParticles(fx, 8)
	else
		fx = Instance.new("Folder")
		fx.Parent = Workspace
	end
	crushByPlayer[player] = {
		character = character,
		victim = victim,
		vRoot = vRoot,
		fx = fx,
		holdPos = vRoot.Position,
		casterHoldPos = root.Position,
		tickAcc = 0,
		walk = walk,
		jumpPower = jumpPower,
		jumpHeight = jumpHeight,
		autoRotate = autoRotate,
		faceAlign = nil,
		casterAnim = playCharacterAnim(character, GameConstants.IW_CRUSH_ANIM, true, Enum.AnimationPriority.Action),
		victimAnim = playCharacterAnim(victim, GameConstants.IW_CRUSH_TARGET_ANIM, true, Enum.AnimationPriority.Action4),
		endsAt = os.clock() + GameConstants.IW_CRUSH_DURATION,
	}
end

local function aoeBurst(owner: Model, pos: Vector3, radius: number, damage: number, ragdoll: number, knock: number)
	for _, victim in CombatHelper.overlapCharacters(pos, radius, owner) do
		CombatHelper.dealDamage(owner, victim, damage, pos, "projectile")
		RagdollService.applyTimed(victim, ragdoll)
		ScreenFeelHelper.pulseCharacter(victim, {
			intensity = 0.64,
			duration = 0.34,
			fovScale = 0.38,
			vignetteScale = 0.4,
		})
		local vRoot = getRoot(victim)
		if vRoot then
			local away = vRoot.Position - pos
			PushHelper.applyToCharacter(victim, if away.Magnitude > 0.05 then away.Unit else Vector3.new(0, 0, -1), {
				speed = knock,
				upBoost = 22,
			})
		end
	end
end

local function applyProjectionHit(owner: Model, victim: Model, dir: Vector3, pos: Vector3)
	CombatHelper.dealDamage(owner, victim, GameConstants.IW_PROJECTION_DAMAGE, pos, "projectile")
	RagdollService.applyTimed(victim, GameConstants.IW_PROJECTION_RAGDOLL)
	ScreenFeelHelper.pulseCharacter(victim, {
		intensity = 0.58,
		duration = 0.32,
		fovScale = 0.34,
		vignetteScale = 0.38,
		tint = GameConstants.IW_COLOR,
		tintDuration = 0.8,
	})
	local vRoot = getRoot(victim)
	if vRoot then
		local pushDir = if dir.Magnitude > 0.05 then dir.Unit else Vector3.new(0, 0, -1)
		vRoot.AssemblyLinearVelocity = pushDir * GameConstants.IW_PUSH_KNOCK_SPEED + Vector3.new(0, GameConstants.IW_PUSH_KNOCK_UP, 0)
	end
end

local function restoreProjectionMove(state: ProjectionState)
	restoreMove(state.owner, state.walk, state.jumpPower, state.jumpHeight, state.autoRotate)
end

local function destroyProjection(player: Player, explode: boolean, pos: Vector3?)
	local state = projectionByPlayer[player]
	if not state then
		return
	end
	projectionByPlayer[player] = nil
	state.alive = false
	if not state.launched then
		restoreProjectionMove(state)
	end
	if explode then
		aoeBurst(
			state.owner,
			pos or state.part.Position,
			GameConstants.IW_PROJECTION_AOE,
			GameConstants.IW_PROJECTION_DAMAGE,
			GameConstants.IW_PROJECTION_RAGDOLL,
			GameConstants.IW_PROJECTION_KNOCK
		)
	end
	if state.visual.Parent then
		fadeOutVisual(state.visual, GameConstants.IW_PUSH_FADE)
	elseif state.part.Parent then
		fadeOutVisual(state.part, GameConstants.IW_PUSH_FADE)
	end
end

local function isSolidWorldPart(part: BasePart, owner: Model): boolean
	local character = CombatHelper.getCharacterFromPart(part)
	if character then
		return false
	end
	if part:IsDescendantOf(owner) then
		return false
	end
	return true
end

local function castProjection(player: Player, direction: Vector3?, aimPoint: Vector3?)
	local character = player.Character
	if not character or projectionByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById(HERO, "body_projection")
	if not entry or not canUse(character, entry.id, GameConstants.IW_PROJECTION_ENERGY) then
		return
	end
	local root = getRoot(character)
	local template = VfxHelper.getInvisibleWomanAsset("BodyProjection", "BodyProjection")
	if not root or not template then
		return
	end
	beginPowerFx(character)
	fireCameraShake(player, 0.42, 0.32, 0.32, 0.52)
	local flatLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	local dir = if flatLook.Magnitude > 0.05 then flatLook.Unit else Vector3.new(0, 0, -1)
	local origin = root.Position + Vector3.new(0, 1.2, 0) + dir * 2.2
	local clone = template:Clone()
	clone.Name = "IwBodyProjection"
	local part: BasePart?
	if clone:IsA("BasePart") then
		part = clone
		clone.CFrame = CFrame.lookAt(origin, origin + dir)
		clone.Anchored = true
		clone.CanCollide = false
		clone.CanQuery = true
		clone.CanTouch = true
		clone.Parent = Workspace
	elseif clone:IsA("Model") then
		clone:PivotTo(CFrame.lookAt(origin, origin + dir))
		clone.Parent = Workspace
		part = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
		if part then
			part.Anchored = true
			part.CanCollide = false
		end
	end
	if not part then
		clone:Destroy()
		endPowerFx(character)
		return
	end
	fadeParticles(clone, true)
	playWorldSound(GameConstants.IW_PROJECTION_RELEASE_SOUND, origin, 0.95)
	AbilityCooldownHelper.setActive(character, entry.id, true)
	local walk, jumpPower, jumpHeight = captureAndLockMove(character)
	local hum = CombatHelper.getHumanoid(character)
	local autoRotate = if hum then hum.AutoRotate else true
	if hum then
		hum.AutoRotate = false
	end
	projectionByPlayer[player] = {
		visual = clone,
		part = part,
		owner = character,
		hit = {},
		alive = true,
		dir = dir,
		launched = false,
		launchAt = os.clock() + GameConstants.IW_PROJECTION_HOLD,
		bornAt = os.clock(),
		spawnPos = origin,
		casterHoldPos = root.Position,
		walk = walk,
		jumpPower = jumpPower,
		jumpHeight = jumpHeight,
		autoRotate = autoRotate,
	}
	task.delay(0.25, function()
		if character.Parent then
			endPowerFx(character)
			if AbilityCooldownHelper.isActive(character, entry.id) then
				finishAbility(character, entry.id, GameConstants.IW_PROJECTION_COOLDOWN)
			end
		end
	end)
end

local function beginSmashLock(player: Player, character: Model)
	if smashHoldByPlayer[player] then
		return
	end
	local hum = CombatHelper.getHumanoid(character)
	if not hum then
		return
	end
	local walk = hum.WalkSpeed
	local jumpPower: number? = hum.JumpPower
	local jumpHeight: number? = nil
	pcall(function()
		jumpHeight = hum.JumpHeight
	end)
	smashHoldByPlayer[player] = {
		walk = walk,
		jumpPower = jumpPower,
		jumpHeight = jumpHeight,
		autoRotate = hum.AutoRotate,
	}
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
	lockHumanoidMotion(hum)
	hum.AutoRotate = false
	hum:Move(Vector3.zero, false)
end

local function applySmashLock(character: Model)
	local hum = CombatHelper.getHumanoid(character)
	if hum then
		lockHumanoidMotion(hum)
		hum.AutoRotate = false
		hum:Move(Vector3.zero, false)
	end
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)
end

local function endSmashLock(player: Player, character: Model?)
	local hold = smashHoldByPlayer[player]
	smashHoldByPlayer[player] = nil
	if not hold then
		return
	end
	local char = character
	if not char then
		return
	end
	if char:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		char:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
	end
	clearCastFace(char)
	local flying = char:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
	restoreMove(char, hold.walk, hold.jumpPower, hold.jumpHeight, not flying)
end

local function smashSkinFolder(character: Model): string
	if character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern" then
		return "ModernSmash"
	end
	return "BaseSmash"
end

local function smashAsset(character: Model, name: string): Instance?
	return VfxHelper.getInvisibleWomanAsset("ForcefieldSmash", smashSkinFolder(character), name)
end

local function abortSmash(player: Player)
	smashToken[player] = (smashToken[player] or 0) + 1
	local walls = smashWallsByPlayer[player]
	smashWallsByPlayer[player] = nil
	if walls then
		for _, inst in walls do
			if inst.Parent then
				fadeOutVisual(inst, 0.2)
			end
		end
	end
	endSmashLock(player, player.Character)
end

local function spawnSmashPart(template: Instance?, cf: CFrame, name: string, particlesOn: boolean): Instance?
	if not template then
		return nil
	end
	local clone = template:Clone()
	clone.Name = name
	if clone:IsA("BasePart") then
		clone.Anchored = true
		clone.CanCollide = false
		clone.CFrame = cf
		clone.Parent = Workspace
	elseif clone:IsA("Model") then
		clone:PivotTo(cf)
		clone.Parent = Workspace
		for _, desc in clone:GetDescendants() do
			if desc:IsA("BasePart") then
				desc.Anchored = true
				desc.CanCollide = false
			end
		end
	else
		clone.Parent = Workspace
	end
	fadeParticles(clone, particlesOn)
	if particlesOn then
		VfxHelper.emitAllParticles(clone, 8)
	end
	return clone
end

local function setInstCf(inst: Instance, cf: CFrame)
	if inst:IsA("BasePart") then
		inst.CFrame = cf
	elseif inst:IsA("Model") then
		inst:PivotTo(cf)
	end
end

local function castSmash(player: Player, direction: Vector3?, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById(HERO, "forcefield_smash")
	if not entry or not canUse(character, entry.id, GameConstants.IW_SMASH_ENERGY) then
		return
	end
	local root = getRoot(character)
	if not root then
		return
	end
	local smashRange = if character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern"
		then GameConstants.IW_SMASH_RANGE_MODERN
		else GameConstants.IW_SMASH_RANGE
	local midPos = aimPoint or (root.Position + root.CFrame.LookVector * 18)
	if (midPos - root.Position).Magnitude > smashRange then
		midPos = root.Position + normalizeDir(midPos - root.Position) * smashRange
	end
	local groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Exclude
	groundParams.FilterDescendantsInstances = { character }
	local groundHit = Workspace:Raycast(midPos + Vector3.new(0, 12, 0), Vector3.new(0, -60, 0), groundParams)
	if not groundHit then
		groundHit = Workspace:Raycast(root.Position + Vector3.new(0, 4, 0), Vector3.new(0, -40, 0), groundParams)
	end
	local wallTemplate = smashAsset(character, "WallCrush1")
	local wallHeight = 6
	if wallTemplate and wallTemplate:IsA("BasePart") then
		wallHeight = wallTemplate.Size.Y
	elseif wallTemplate and wallTemplate:IsA("Model") then
		wallHeight = wallTemplate:GetExtentsSize().Y
	end
	local groundY = if groundHit then groundHit.Position.Y + wallHeight * 0.5 else midPos.Y
	midPos = Vector3.new(midPos.X, groundY, midPos.Z)
	local flat = Vector3.new(midPos.X - root.Position.X, 0, midPos.Z - root.Position.Z)
	local look = if flat.Magnitude > 0.05 then flat.Unit else Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if look.Magnitude < 0.05 then
		look = Vector3.new(0, 0, -1)
	else
		look = look.Unit
	end
	root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
	local right = look:Cross(Vector3.yAxis)
	if right.Magnitude < 0.05 then
		right = Vector3.new(1, 0, 0)
	else
		right = right.Unit
	end
	AbilityCooldownHelper.setActive(character, entry.id, true)
	beginSmashLock(player, character)
	beginPowerFx(character)
	playCharacterAnim(character, GameConstants.IW_SMASH_ANIM, false, Enum.AnimationPriority.Action)
	fireCameraShake(player, 0.46, 0.3, 0.38, 0.58)
	local token = (smashToken[player] or 0) + 1
	smashToken[player] = token
	local leftPos = midPos - right * GameConstants.IW_SMASH_WALL_DIST
	local rightPos = midPos + right * GameConstants.IW_SMASH_WALL_DIST
	local leftRot = CFrame.lookAt(leftPos, midPos).Rotation
	local rightRot = CFrame.lookAt(rightPos, midPos).Rotation
	local midCf = CFrame.lookAt(midPos, midPos + look)
	task.spawn(function()
		task.wait(GameConstants.IW_SMASH_SPAWN_HOLD)
		if smashToken[player] ~= token then
			return
		end
		if not character.Parent or character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
			abortSmash(player)
			if character.Parent then
				endPowerFx(character)
				AbilityCooldownHelper.setActive(character, entry.id, false)
			end
			return
		end
		local leftStart = CFrame.new(leftPos) * leftRot
		local rightStart = CFrame.new(rightPos) * rightRot
		local wall1 = spawnSmashPart(smashAsset(character, "WallCrush1"), leftStart, "IwSmashWall1", true)
		local wall2 = spawnSmashPart(smashAsset(character, "WallCrush2"), rightStart, "IwSmashWall2", true)
		smashWallsByPlayer[player] = {}
		if wall1 then
			table.insert(smashWallsByPlayer[player], wall1)
		end
		if wall2 then
			table.insert(smashWallsByPlayer[player], wall2)
		end
		task.wait(GameConstants.IW_SMASH_VISIBLE_HOLD)
		if smashToken[player] ~= token or character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
			abortSmash(player)
			if character.Parent then
				endPowerFx(character)
				AbilityCooldownHelper.setActive(character, entry.id, false)
			end
			return
		end
		local t0 = os.clock()
		local dur = GameConstants.IW_SMASH_CLOSE_TIME
		while os.clock() - t0 < dur do
			if smashToken[player] ~= token or character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
				abortSmash(player)
				if character.Parent then
					endPowerFx(character)
					AbilityCooldownHelper.setActive(character, entry.id, false)
				end
				return
			end
			local a = math.clamp((os.clock() - t0) / dur, 0, 1)
			local s = a * a * (3 - 2 * a)
			if wall1 then
				setInstCf(wall1, CFrame.new(leftPos:Lerp(midPos, s)) * leftRot)
			end
			if wall2 then
				setInstCf(wall2, CFrame.new(rightPos:Lerp(midPos, s)) * rightRot)
			end
			task.wait()
		end
		if smashToken[player] ~= token or character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
			abortSmash(player)
			if character.Parent then
				endPowerFx(character)
				AbilityCooldownHelper.setActive(character, entry.id, false)
			end
			return
		end
		if wall1 then
			setInstCf(wall1, CFrame.new(midPos) * leftRot)
		end
		if wall2 then
			setInstCf(wall2, CFrame.new(midPos) * rightRot)
		end
		local middle = spawnSmashPart(smashAsset(character, "Impact"), midCf, "IwSmashImpact", true)
		if middle and smashWallsByPlayer[player] then
			table.insert(smashWallsByPlayer[player], middle)
		end
		playWorldSound(GameConstants.IW_SMASH_COLLIDE_SOUND, midPos, 1.05)
		fireCameraShake(player, 0.68, 0.4, 0.52, 0.82)
		aoeBurst(
			character,
			midPos,
			GameConstants.IW_SMASH_RADIUS,
			GameConstants.IW_SMASH_DAMAGE,
			GameConstants.IW_SMASH_RAGDOLL,
			GameConstants.IW_SMASH_KNOCK_SPEED
		)
		for _, victim in CombatHelper.overlapCharacters(midPos, GameConstants.IW_SMASH_RADIUS, character) do
			local vRoot = getRoot(victim)
			if not vRoot then
				continue
			end
			local away = vRoot.Position - midPos
			local dir = if away.Magnitude > 0.08 then away.Unit else look
			local speed = GameConstants.IW_SMASH_KNOCK_SPEED
			local up = GameConstants.IW_SMASH_KNOCK_UP
			local function shove()
				if not victim.Parent or not vRoot.Parent then
					return
				end
				PushHelper.applyToCharacter(victim, dir, {
					speed = speed,
					upBoost = up,
					impulseMult = 1.4,
				})
				vRoot.AssemblyLinearVelocity = dir * speed + Vector3.new(0, up, 0)
			end
			shove()
			task.defer(shove)
			task.delay(0.06, shove)
		end
		task.wait(GameConstants.IW_SMASH_WALL_LINGER)
		if smashToken[player] ~= token then
			return
		end
		if middle then
			fadeOutVisual(middle, 0.55)
		end
		if wall1 then
			fadeOutVisual(wall1, 0.9)
		end
		if wall2 then
			fadeOutVisual(wall2, 0.9)
		end
		smashWallsByPlayer[player] = nil
		endSmashLock(player, character)
		if character.Parent then
			endPowerFx(character)
			if AbilityCooldownHelper.isActive(character, entry.id) then
				finishAbility(character, entry.id, GameConstants.IW_SMASH_COOLDOWN)
			end
		end
	end)
end

function InvisibleWomanService.absorbShield(character: Model, amount: number, hitFrom: Vector3?): boolean
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= HERO then
		return false
	end
	local hum = CombatHelper.getHumanoid(character)
	if hum and hum.Health <= 0 then
		return false
	end
	local player = Players:GetPlayerFromCharacter(character)
	if character:GetAttribute(GameConstants.IW_FORCEFIELD_ATTRIBUTE) == true and player then
		local state = shieldByPlayer[player]
		if state then
			if hitFrom and math.random() < 0.3 then
				spawnShieldImpact(character, hitFrom)
				return true
			end
			state.hp -= amount
			character:SetAttribute(GameConstants.SHIELD_HP_ATTRIBUTE, math.max(0, state.hp))
			updateShieldUi(state.hpLabel, state.hpFill, state.hp, state.maxHp)
			spawnShieldImpact(character, hitFrom)
			if state.hp <= 0 then
				local overflow = -state.hp
				stopForcefield(player, true, true)
				if overflow > 0 then
					local hum = CombatHelper.getHumanoid(character)
					if hum and hum.Health > 0 then
						hum:TakeDamage(overflow)
					end
				end
			end
			return true
		end
	end
	if character:GetAttribute(GameConstants.IW_FLIGHT_SHIELD_ATTRIBUTE) == true then
		local fx = flightFxByCharacter[character]
		if fx then
			if hitFrom and math.random() < 0.3 then
				spawnShieldImpact(character, hitFrom)
				return true
			end
			fx.hp -= amount
			character:SetAttribute(GameConstants.SHIELD_HP_ATTRIBUTE, math.max(0, fx.hp))
			updateShieldUi(fx.hpLabel, fx.hpFill, fx.hp, fx.maxHp)
			spawnShieldImpact(character, hitFrom)
			if fx.hp <= 0 then
				local overflow = -fx.hp
				if player then
					HexFlightService.endFlight(player, true)
				else
					endFlightFx(character)
				end
				if overflow > 0 then
					local hum = CombatHelper.getHumanoid(character)
					if hum and hum.Health > 0 then
						hum:TakeDamage(overflow)
					end
				end
			end
			return true
		end
	end
	return false
end

function InvisibleWomanService.cancelAll(player: Player)
	HexFlightService.endFlight(player, false)
	stopForcefield(player, false)
	endArea(player, false)
	endCrush(player, false)
	destroyPush(player)
	destroyProjection(player, false)
	abortSmash(player)
	restoreInvis(player, player.Character)
	local char = player.Character
	if char then
		endFlightFx(char)
		clearPowerFx(char)
		AbilityCooldownHelper.setActive(char, "forcefield_flight", false)
		AbilityCooldownHelper.setActive(char, "iw_forcefield", false)
		AbilityCooldownHelper.setActive(char, "disc_throw", false)
		AbilityCooldownHelper.setActive(char, "forcefield_push", false)
		AbilityCooldownHelper.setActive(char, "invisibility", false)
		AbilityCooldownHelper.setActive(char, "forcefield_area", false)
		AbilityCooldownHelper.setActive(char, "forcefield_choke", false)
		AbilityCooldownHelper.setActive(char, "forcefield_protect", false)
		AbilityCooldownHelper.setActive(char, "forcefield_crush", false)
		AbilityCooldownHelper.setActive(char, "body_projection", false)
		AbilityCooldownHelper.setActive(char, "forcefield_smash", false)
		char:SetAttribute(GameConstants.IW_AIM_ATTRIBUTE, nil)
	end
end

function InvisibleWomanService.handleAction(player: Player, payload: any)
	if type(payload) ~= "table" then
		return
	end
	local character = player.Character
	if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= HERO then
		return
	end
	if character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
		return
	end
	if areaByPlayer[player] then
		local areaAction = payload.action
		if
			areaAction ~= "X"
			and areaAction ~= "X_down"
			and areaAction ~= "B"
			and areaAction ~= "B_down"
			and areaAction ~= "B_up"
			and areaAction ~= "C"
			and areaAction ~= "C_down"
			and areaAction ~= "C_up"
			and areaAction ~= "Iw_aim"
			and areaAction ~= "X_aim"
		then
			return
		end
	end
	if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
		local flyAction = payload.action
		local modern = character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern"
		if
			flyAction ~= "F"
			and flyAction ~= "T"
			and flyAction ~= "Iw_aim"
			and not (modern and (flyAction == "E" or flyAction == "E_aim" or flyAction == "X" or flyAction == "X_down" or flyAction == "X_aim"))
		then
			return
		end
	end
	local action = payload.action
	local direction = if typeof(payload.direction) == "Vector3" then payload.direction else nil
	local aimPoint = if typeof(payload.aimPoint) == "Vector3" then payload.aimPoint else nil
	local target = if typeof(payload.target) == "Instance" and payload.target:IsA("Model") then payload.target else nil
	local lockOn = payload.softLock == true
	if not target and typeof(payload.hitPart) == "Instance" and payload.hitPart:IsA("BasePart") then
		target = CombatHelper.getCharacterFromPart(payload.hitPart)
	end
	if aimPoint then
		character:SetAttribute(GameConstants.IW_AIM_ATTRIBUTE, aimPoint)
	end
	if action == "Q_down" then
		startForcefield(player)
	elseif action == "Q_up" then
		if shieldByPlayer[player] then
			stopForcefield(player, true)
		end
	elseif action == "E" then
		castDisc(player, direction, aimPoint)
	elseif action == "R" then
		castPush(player, direction, aimPoint)
	elseif action == "T" then
		castInvis(player)
	elseif action == "F" then
		HexFlightService.toggleFlight(player)
	elseif action == "X_down" or action == "X" then
		castArea(player, aimPoint)
	elseif action == "B" or action == "B_down" then
		startChoke(player)
	elseif action == "B_up" then
		local area = areaByPlayer[player]
		if area then
			stopChoke(area, true)
		end
	elseif action == "C" or action == "C_down" then
		protectArea(player)
	elseif action == "C_up" then
		stopProtect(player, true)
	elseif action == "Z" or action == "Z_down" then
		startCrush(player, target, direction, aimPoint, lockOn)
	elseif action == "Z_up" then
		-- Crush is timed; release does not cancel it.
	elseif action == "G" then
		castProjection(player, direction, aimPoint)
	elseif action == "H" then
		castSmash(player, direction, aimPoint)
	elseif action == "Iw_aim" or action == "E_aim" or action == "X_aim" or action == "Z_aim" then
		-- live aim already stored
	end
end

local function updateHyperspaceStrain(player: Player, dt: number)
	local character = player.Character
	if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= HERO then
		return
	end
	local maxHs = GameConstants.IW_HYPERSPACE_MAX
	local current = character:GetAttribute(GameConstants.IW_HYPERSPACE_ATTRIBUTE)
	if type(current) ~= "number" then
		current = 0
	end
	local locked = character:GetAttribute(GameConstants.IW_HYPERSPACE_LOCK_ATTRIBUTE) == true
	local flying = character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
	if flying and not locked then
		current += GameConstants.IW_HYPERSPACE_FLIGHT_PER_SEC * dt
	else
		current -= GameConstants.IW_HYPERSPACE_DECAY_PER_SEC * dt
	end
	current = math.clamp(current, 0, maxHs)
	character:SetAttribute(GameConstants.IW_HYPERSPACE_ATTRIBUTE, current)
	character:SetAttribute(GameConstants.IW_HYPERSPACE_MAX_ATTRIBUTE, maxHs)
	if not locked and current >= maxHs then
		character:SetAttribute(GameConstants.IW_HYPERSPACE_LOCK_ATTRIBUTE, true)
		HexFlightService.endFlight(player, true)
		return
	end
	if locked and current <= maxHs * GameConstants.IW_HYPERSPACE_WAKE_RATIO then
		character:SetAttribute(GameConstants.IW_HYPERSPACE_LOCK_ATTRIBUTE, nil)
	end
end

function InvisibleWomanService.update(dt: number)
	local dtClamped = math.clamp(dt, 0.001, 0.1)
	local now = os.clock()
	for player, _hold in smashHoldByPlayer do
		local character = player.Character
		if character then
			applySmashLock(character)
		end
	end
	for _, player in Players:GetPlayers() do
		updateHyperspaceStrain(player, dtClamped)
	end

	for player, state in invisByPlayer do
		if not state.character.Parent then
			restoreInvis(player, state.character)
			continue
		end
		local invisDrain = GameConstants.IW_INVIS_ENERGY_PER_SEC * dtClamped
		if state.character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern" then
			invisDrain *= 0.75
		end
		if not CharacterService.spendEnergy(state.character, invisDrain) then
			restoreInvis(player, state.character)
		end
	end

	for player, state in pushByPlayer do
		if not state.alive or not state.part.Parent then
			destroyPush(player)
			continue
		end
		local owner = state.owner
		if owner:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
			destroyPush(player)
			continue
		end
		if not state.launched then
			freezeCasterInPlace(owner, state.casterHoldPos)
			if now < state.launchAt then
				continue
			end
			state.launched = true
			state.bornAt = now
			if owner.Parent then
				owner:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
			end
			restoreMove(owner, state.walk, state.jumpPower, state.jumpHeight, state.autoRotate)
			playWorldSound(GameConstants.IW_PUSH_RELEASE_SOUND, state.part.Position, 0.95)
			local plr = Players:GetPlayerFromCharacter(owner)
			if plr then
				fireCameraShake(plr, 0.46, 0.3, 0.34, 0.55)
			end
		end
		local origin = state.part.Position
		local dir = state.dir
		local nextPos = origin + dir * GameConstants.IW_PUSH_SPEED * dtClamped
		local traveled = (nextPos - origin).Magnitude
		local ownerRoot = getRoot(owner)
		if now - state.bornAt > GameConstants.IW_PUSH_MAX_LIFE then
			destroyPush(player)
			continue
		end
		if ownerRoot and (origin - ownerRoot.Position).Magnitude > GameConstants.IW_PUSH_RANGE then
			destroyPush(player)
			continue
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { owner, state.visual }
		local hit = Workspace:Raycast(origin, dir * math.max(traveled, 1.2), params)
		if hit then
			local otherChar = CombatHelper.getCharacterFromPart(hit.Instance)
			if otherChar and isValidVictim(otherChar, owner) then
				if not state.hit[otherChar] then
					state.hit[otherChar] = true
					CombatHelper.dealDamage(owner, otherChar, GameConstants.IW_PUSH_DAMAGE, origin, "projectile")
					applyStandingPush(otherChar, dir, GameConstants.IW_PUSH_KNOCK_SPEED, GameConstants.IW_PUSH_KNOCK_UP)
				end
			else
				destroyPush(player)
				continue
			end
		end
		local cf = CFrame.lookAt(nextPos, nextPos + dir)
		if state.visual:IsA("Model") then
			state.visual:PivotTo(cf)
		else
			state.part.CFrame = cf
		end
		for _, victim in CombatHelper.overlapCharacters(nextPos, GameConstants.IW_PUSH_HIT_RADIUS, owner) do
			if not state.hit[victim] then
				state.hit[victim] = true
				CombatHelper.dealDamage(owner, victim, GameConstants.IW_PUSH_DAMAGE, nextPos, "projectile")
				applyStandingPush(victim, dir, GameConstants.IW_PUSH_KNOCK_SPEED, GameConstants.IW_PUSH_KNOCK_UP)
			end
		end
	end

	for player, state in areaByPlayer do
		updateArea(player, state, dtClamped)
	end

	for player, state in projectionByPlayer do
		if not state.alive or not state.part.Parent or not state.owner.Parent then
			destroyProjection(player, false)
			continue
		end
		local owner = state.owner
		if owner:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
			destroyProjection(player, false)
			continue
		end
		if not state.launched then
			freezeCasterInPlace(owner, state.casterHoldPos)
			if now < state.launchAt then
				continue
			end
			state.launched = true
			state.bornAt = now
			restoreProjectionMove(state)
			local plr = Players:GetPlayerFromCharacter(owner)
			if plr then
				fireCameraShake(plr, 0.46, 0.3, 0.34, 0.55)
			end
		end
		local origin = state.part.Position
		local dir = state.dir
		local nextPos = origin + dir * GameConstants.IW_PROJECTION_SPEED * dtClamped
		local traveled = (nextPos - origin).Magnitude
		local ownerRoot = getRoot(owner)
		if now - state.bornAt > GameConstants.IW_PROJECTION_MAX_LIFE then
			destroyProjection(player, false)
			continue
		end
		if ownerRoot and (origin - ownerRoot.Position).Magnitude > GameConstants.IW_PROJECTION_RANGE then
			destroyProjection(player, false)
			continue
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { owner, state.visual }
		local hit = Workspace:Raycast(origin, dir * math.max(traveled, 1.2), params)
		if hit then
			local otherChar = CombatHelper.getCharacterFromPart(hit.Instance)
			if otherChar and isValidVictim(otherChar, owner) then
				if not state.hit[otherChar] then
					state.hit[otherChar] = true
					applyProjectionHit(owner, otherChar, dir, origin)
				end
			else
				destroyProjection(player, false)
				continue
			end
		end
		local cf = CFrame.lookAt(nextPos, nextPos + dir)
		if state.visual:IsA("Model") then
			state.visual:PivotTo(cf)
		else
			state.part.CFrame = cf
		end
		for _, victim in CombatHelper.overlapCharacters(nextPos, GameConstants.IW_PROJECTION_HIT_RADIUS, owner) do
			if not state.hit[victim] then
				state.hit[victim] = true
				applyProjectionHit(owner, victim, dir, nextPos)
			end
		end
	end

	for player, state in crushByPlayer do
		if not state.character.Parent or not state.victim.Parent or not state.vRoot.Parent then
			endCrush(player, true)
			continue
		end
		if now >= state.endsAt then
			endCrush(player, true, true)
			continue
		end
		local hum = CombatHelper.getHumanoid(state.victim)
		if not hum or hum.Health <= 0 then
			endCrush(player, true)
			continue
		end
		local casterRoot = getRoot(state.character)
		if casterRoot and (state.vRoot.Position - casterRoot.Position).Magnitude > GameConstants.IW_CRUSH_RANGE + 8 then
			endCrush(player, true)
			continue
		end
		state.vRoot.AssemblyLinearVelocity = Vector3.zero
		state.vRoot.AssemblyAngularVelocity = Vector3.zero
		local victimHum = CombatHelper.getHumanoid(state.victim)
		if victimHum then
			lockHumanoidMotion(victimHum)
		end
		if tryCrushExecute(state.character, state.victim, state.vRoot) then
			endCrush(player, false)
			continue
		end
		if casterRoot then
			local casterHum = CombatHelper.getHumanoid(state.character)
			if casterHum then
				lockHumanoidMotion(casterHum)
				casterHum.AutoRotate = false
				casterHum:Move(Vector3.zero, false)
			end
			ensureCrushFaceAlign(casterRoot, yawLookAt(casterRoot.Position, state.vRoot.Position))
		end
		if state.fx:IsA("BasePart") then
			state.fx.CFrame = state.vRoot.CFrame
		elseif state.fx:IsA("Model") then
			state.fx:PivotTo(state.vRoot.CFrame)
		end
		state.tickAcc += dtClamped
		if state.tickAcc >= 0.25 then
			local slice = state.tickAcc
			state.tickAcc = 0
			CombatHelper.dealDamage(state.character, state.victim, GameConstants.IW_CRUSH_DAMAGE_PER_SEC * slice, state.holdPos, "beam")
			if tryCrushExecute(state.character, state.victim, state.vRoot) then
				endCrush(player, false)
				continue
			end
			local crushDrain = GameConstants.IW_CRUSH_ENERGY_PER_SEC * slice
			if state.character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "modern" then
				crushDrain *= 0.75
			end
			CharacterService.spendEnergy(state.character, crushDrain)
		end
	end
end

function InvisibleWomanService.init()
	HexFlightService.registerHeroFx(HERO, {
		begin = beginFlightFx,
		finish = endFlightFx,
	})
	Remotes.getEvent("UseAbility").OnServerEvent:Connect(function(player: Player, payload: any)
		InvisibleWomanService.handleAction(player, payload)
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		InvisibleWomanService.cancelAll(player)
	end)
	Players.PlayerAdded:Connect(function(player: Player)
		player.CharacterRemoving:Connect(function()
			InvisibleWomanService.cancelAll(player)
		end)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterRemoving:Connect(function()
			InvisibleWomanService.cancelAll(player)
		end)
	end
end

return InvisibleWomanService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">LokiService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Loki:
	Q Dagger Throw (R then L)
	E Illusion Decoy (hold + click; Punch / Run / Detonate / Lie of Place)
	F Trickster Dash (WASD)
	C Reflect Shield (0.5s outline)
	V Shapeshift
	X God of Mischief (invis + 3 roaming clones; Attack/Idle panel)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local ProjectileHelper = require(ReplicatedStorage.Shared.ProjectileHelper)
local PushHelper = require(ReplicatedStorage.Shared.PushHelper)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)
local CharacterService = require(script.Parent.CharacterService)
local RagdollStatus = require(ReplicatedStorage.Shared.RagdollStatus)

local LokiService = {}

type DecoyState = {
	character: Model,
	clone: Model,
	humanoid: Humanoid,
	root: BasePart,
	mode: string,
	aimPoint: Vector3,
	startedAt: number,
	ownerName: string,
	animConn: RBXScriptConnection?,
	swapping: boolean?,
}

type UltCloneState = {
	clone: Model,
	root: BasePart,
	humanoid: Humanoid,
	lastBlast: number,
	owner: Model,
	home: Vector3,
	wanderTarget: Vector3,
	nextWanderAt: number,
	animConn: RBXScriptConnection?,
}

type UltState = {
	character: Model,
	clones: { UltCloneState },
	startedAt: number,
	attackEnabled: boolean,
}

local decoyArmed: { [Player]: boolean } = {}
local decoyByPlayer: { [Player]: DecoyState } = {}
local reflectUntil: { [Player]: number } = {}
local shapeshiftToken: { [Player]: number } = {}
local ultByPlayer: { [Player]: UltState } = {}
local dashUntil: { [Player]: number } = {}

local function lokiGreen(): Color3
	return Color3.fromRGB(40, 200, 90)
end

local function getRoot(model: Model): BasePart?
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return model.PrimaryPart
end

local function getHand(character: Model, preferRight: boolean): BasePart?
	local names = if preferRight
		then { "RightHand", "Right Arm", "RightLowerArm" }
		else { "LeftHand", "Left Arm", "LeftLowerArm" }
	for _, name in names do
		local p = character:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return getRoot(character)
end

local function canUse(character: Model, abilityId: string, energyCost: number): boolean
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "loki" then
		return false
	end
	if CombatHelper.arePowersDisabled(character) then
		return false
	end
	if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return false
	end
	if AbilityCooldownHelper.isOnCooldown(character, abilityId) then
		return false
	end
	if AbilityCooldownHelper.isActive(character, abilityId) then
		return false
	end
	if energyCost > 0 and not CharacterService.spendEnergy(character, energyCost) then
		return false
	end
	return true
end

local function finishAbility(character: Model, abilityId: string, cooldown: number)
	AbilityCooldownHelper.setActive(character, abilityId, false)
	AbilityCooldownHelper.applyAfterUse(character, abilityId, cooldown)
	CharacterService.markAbilityUse(character)
end

function LokiService.isReflecting(character: Model): boolean
	return character:GetAttribute(GameConstants.LOKI_REFLECT_ATTRIBUTE) == true
end

--[[ Returns true if the ability was reflected (caller should cancel effect on Loki). ]]
function LokiService.tryReflect(attacker: Model, victim: Model, kind: string): boolean
	if victim:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "loki" then
		return false
	end
	if not LokiService.isReflecting(victim) then
		return false
	end
	if kind == "projectile" or kind == "beam" or kind == "explosion" or kind == "blast" then
		return false
	end

	local aRoot = getRoot(attacker)
	local vRoot = getRoot(victim)
	if not aRoot or not vRoot then
		return true
	end

	if kind == "telekinesis" then
		local away = aRoot.Position - vRoot.Position
		local dir = if away.Magnitude > 0.05 then away.Unit else aRoot.CFrame.LookVector
		PushHelper.applyToCharacter(attacker, dir, {
			speed = GameConstants.TK_THROW_SPEED,
			upBoost = GameConstants.TK_THROW_UP,
		})
		RagdollStatus.applyTimed(attacker, GameConstants.RAGDOLL_TK_THROW_DURATION)
		return true
	end

	if kind == "torture" then
		attacker:SetAttribute(GameConstants.TORTURE_LOCKED_ATTRIBUTE, true)
		local hum = CombatHelper.getHumanoid(attacker)
		if hum then
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum.AutoRotate = false
		end
		task.delay(GameConstants.LOKI_REFLECT_TORTURE_DURATION, function()
			if attacker.Parent then
				attacker:SetAttribute(GameConstants.TORTURE_LOCKED_ATTRIBUTE, nil)
			end
			if hum and hum.Parent then
				hum.WalkSpeed = GameConstants.DEFAULT_WALK_SPEED
				hum.JumpPower = 50
				hum.AutoRotate = true
			end
		end)
		local now = os.clock()
		task.spawn(function()
			while os.clock() - now < GameConstants.LOKI_REFLECT_TORTURE_DURATION do
				if not attacker.Parent then
					break
				end
				CombatHelper.dealDamage(victim, attacker, GameConstants.TK_TORTURE_DAMAGE)
				task.wait(GameConstants.TK_TORTURE_DAMAGE_INTERVAL)
			end
		end)
		return true
	end

	if kind == "disintegrate" then
		local hum = CombatHelper.getHumanoid(attacker)
		if
			hum
			and hum.MaxHealth > 0
			and (hum.Health / hum.MaxHealth) <= GameConstants.DISINTEGRATE_HP_THRESHOLD
		then
			VfxHelper.spawnImpact(aRoot.Position, lokiGreen(), 5)
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum.AutoRotate = false
			VfxHelper.fadePartsByHeight(attacker, 1, GameConstants.DISINTEGRATE_DURATION, true, function()
				if hum.Parent then
					hum.Health = 0
				end
			end)
		else
			-- Redirect disintegration blast visually / lightly without full dissolve
			VfxHelper.spawnImpact(aRoot.Position, lokiGreen(), 4)
			VfxHelper.spawnBeamLine(vRoot.Position, aRoot.Position, lokiGreen(), 0.35, 0.2)
			CombatHelper.dealDamage(victim, attacker, 8)
		end
		return true
	end

	if kind == "fear" or kind == "generic" then
		attacker:SetAttribute(
			GameConstants.POWERS_DISABLED_UNTIL,
			AbilityCooldownHelper.getNow() + 4
		)
		return true
	end

	return true
end

local function stripCloneNoise(clone: Model, keepHumanoid: boolean)
	for _, desc in clone:GetDescendants() do
		if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ModuleScript") or desc:IsA("Sound") then
			-- Keep Animate asset tree for server playback (LocalScript itself is useless on NPCs)
			if desc.Name == "Animate" then
				continue
			end
			desc:Destroy()
		elseif not keepHumanoid and (desc:IsA("Humanoid") or desc:IsA("Animator")) then
			desc:Destroy()
		elseif
			desc:IsA("ParticleEmitter")
			or desc:IsA("Trail")
			or desc:IsA("Beam")
			or desc:IsA("Fire")
			or desc:IsA("Smoke")
			or desc:IsA("Sparkles")
		then
			desc:Destroy()
		elseif
			desc.Name == "HandParticle"
			or desc.Name == "MCU_Nameplate"
			or desc.Name == "ShieldHealthGui"
			or desc:IsA("BillboardGui")
			or desc:IsA("Highlight")
			or desc:IsA("ForceField")
		then
			desc:Destroy()
		end
	end
	-- Remove Animate LocalScript runners but keep folder/value children with AnimationIds
	local animate = clone:FindFirstChild("Animate")
	if animate then
		if animate:IsA("LocalScript") or animate:IsA("Script") then
			-- Convert to Folder preserving children
			local folder = Instance.new("Folder")
			folder.Name = "Animate"
			for _, child in animate:GetChildren() do
				child.Parent = folder
			end
			folder.Parent = clone
			animate:Destroy()
		end
	end
end

local function findAnimIdFromAnimate(animate: Instance?, categoryNames: { string }): string?
	if not animate then
		return nil
	end
	for _, catName in categoryNames do
		local folder = animate:FindFirstChild(catName)
		if not folder then
			continue
		end
		for _, child in folder:GetChildren() do
			if child:IsA("Animation") and child.AnimationId ~= "" then
				return child.AnimationId
			end
			if child:IsA("StringValue") and child.Value ~= "" then
				return child.Value
			end
			local nested = child:FindFirstChildOfClass("Animation")
			if nested and nested.AnimationId ~= "" then
				return nested.AnimationId
			end
		end
	end
	return nil
end

--[[ Server-side idle/walk using the owner's Animate AnimationIds. ]]
local function attachCloneAnimate(clone: Model, source: Model): RBXScriptConnection?
	local hum = clone:FindFirstChildOfClass("Humanoid")
	if not hum then
		return nil
	end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end

	local srcAnimate = source:FindFirstChild("Animate") or clone:FindFirstChild("Animate")
	local idleId = findAnimIdFromAnimate(srcAnimate, { "idle", "Idle" })
	local walkId = findAnimIdFromAnimate(srcAnimate, { "walk", "Walk", "run", "Run" })

	local idleTrack: AnimationTrack? = nil
	local walkTrack: AnimationTrack? = nil
	if idleId then
		local anim = Instance.new("Animation")
		anim.AnimationId = idleId
		idleTrack = animator:LoadAnimation(anim)
		idleTrack.Looped = true
		idleTrack.Priority = Enum.AnimationPriority.Idle
	end
	if walkId then
		local anim = Instance.new("Animation")
		anim.AnimationId = walkId
		walkTrack = animator:LoadAnimation(anim)
		walkTrack.Looped = true
		walkTrack.Priority = Enum.AnimationPriority.Movement
	end

	local playing: string? = nil
	local function setAnim(kind: string)
		if playing == kind then
			return
		end
		playing = kind
		if kind == "walk" then
			if idleTrack and idleTrack.IsPlaying then
				idleTrack:Stop(0.15)
			end
			if walkTrack and not walkTrack.IsPlaying then
				walkTrack:Play(0.15)
			end
		else
			if walkTrack and walkTrack.IsPlaying then
				walkTrack:Stop(0.15)
			end
			if idleTrack and not idleTrack.IsPlaying then
				idleTrack:Play(0.2)
			end
		end
	end
	setAnim("idle")

	local conn = RunService.Heartbeat:Connect(function()
		if not clone.Parent or not hum.Parent then
			return
		end
		local moving = hum.MoveDirection.Magnitude > 0.08
		local root = clone:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local flat = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
			if flat.Magnitude > 1.2 then
				moving = true
			end
		end
		setAnim(if moving then "walk" else "idle")
	end)
	return conn
end

local function copyAnimateFromSource(clone: Model, source: Model)
	local existing = clone:FindFirstChild("Animate")
	if existing then
		existing:Destroy()
	end
	local src = source:FindFirstChild("Animate")
	if not src then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "Animate"
	for _, child in src:GetChildren() do
		-- Skip scripts; copy animation data only
		if child:IsA("LocalScript") or child:IsA("Script") or child:IsA("ModuleScript") then
			for _, nested in child:GetChildren() do
				nested:Clone().Parent = folder
			end
		else
			child:Clone().Parent = folder
		end
	end
	folder.Parent = clone
end

-- Smooth reveal from feet → head
local function revealCloneFeetToHead(clone: Model, duration: number)
	type PartFade = { inst: BasePart | Decal | Texture, goal: number, y: number }
	local fades: { PartFade } = {}
	local minY = math.huge
	local maxY = -math.huge
	for _, desc in clone:GetDescendants() do
		if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
			local y = desc.Position.Y
			minY = math.min(minY, y - desc.Size.Y * 0.5)
			maxY = math.max(maxY, y + desc.Size.Y * 0.5)
			table.insert(fades, { inst = desc, goal = desc.Transparency, y = y })
			desc.Transparency = 1
		elseif desc:IsA("Decal") or desc:IsA("Texture") then
			local parent = desc.Parent
			local y = if parent and parent:IsA("BasePart") then parent.Position.Y else 0
			table.insert(fades, { inst = desc, goal = desc.Transparency, y = y })
			desc.Transparency = 1
		end
	end
	if maxY <= minY or #fades == 0 then
		return
	end
	task.spawn(function()
		local t0 = os.clock()
		while clone.Parent and (os.clock() - t0) < duration do
			local a = math.clamp((os.clock() - t0) / duration, 0, 1)
			local cutY = minY + (maxY - minY) * a
			for _, info in fades do
				local inst = info.inst
				if not inst.Parent then
					continue
				end
				if info.y <= cutY then
					inst.Transparency = info.goal
				else
					local blend = math.clamp(1 - (info.y - cutY) / math.max(maxY - minY, 0.01) * 3, 0, 1)
					inst.Transparency = 1 - (1 - info.goal) * blend
				end
			end
			task.wait()
		end
		for _, info in fades do
			if info.inst.Parent then
				info.inst.Transparency = info.goal
			end
		end
	end)
end

local function addCloneNameplate(clone: Model, labelText: string)
	local head = clone:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "LokiCloneNameplate"
	gui.Size = UDim2.new(4, 0, 0.7, 0)
	gui.StudsOffset = Vector3.new(0, 2.2, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 80
	gui.Adornee = head
	gui.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = lokiGreen()
	label.TextStrokeTransparency = 0.4
	label.Text = labelText
	label.Parent = gui
end

local function spawnDagger(character: Model, origin: Vector3, homeDir: Vector3, aimPoint: Vector3?)
	ProjectileHelper.spawn(origin, homeDir, {
		speed = GameConstants.LOKI_DAGGER_SPEED,
		damage = GameConstants.LOKI_DAGGER_DAMAGE,
		radius = GameConstants.LOKI_DAGGER_HIT_RADIUS,
		maxDistance = GameConstants.LOKI_DAGGER_RANGE,
		owner = character,
		color = lokiGreen(),
		homeDir = homeDir,
		homePoint = aimPoint or (origin + homeDir * 50),
		homeAfter = 0,
		seekUntilClose = true,
		seekCloseDistance = 2.2,
		boltFolder = "Loki",
		boltAsset = "Dagger",
		impactFx = "none",
		deleteAfterFx = GameConstants.LOKI_DAGGER_DELETE_AFTER_FX,
		-- Omit facingOffset so Tip attachment or size heuristic can auto-align tip to travel
	})
end

local function fireDaggers(player: Player, direction: Vector3, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("loki", "dagger_throw")
	if not entry or not canUse(character, entry.id, GameConstants.LOKI_DAGGER_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	local dir = if direction.Magnitude > 0.01 then direction.Unit else character:GetPivot().LookVector
	local homeDir = dir
	local root = getRoot(character)
	if aimPoint then
		local from = if root then root.Position else character:GetPivot().Position
		local toAim = aimPoint - from
		if toAim.Magnitude > 0.05 then
			homeDir = toAim.Unit
		end
	end

	local right = getHand(character, true)
	local left = getHand(character, false)
	local rightPos = if right then right.Position else character:GetPivot().Position
	spawnDagger(character, rightPos, homeDir, aimPoint)
	VfxHelper.castHandFlash(rightPos, lokiGreen())

	task.delay(GameConstants.LOKI_DAGGER_HAND_DELAY, function()
		if not character.Parent or player.Character ~= character then
			AbilityCooldownHelper.setActive(character, entry.id, false)
			return
		end
		local leftPos = if left and left.Parent then left.Position else character:GetPivot().Position
		spawnDagger(character, leftPos, homeDir, aimPoint)
		VfxHelper.castHandFlash(leftPos, lokiGreen())
		finishAbility(character, entry.id, GameConstants.LOKI_DAGGER_COOLDOWN)
	end)
end

local function endDecoy(player: Player, applyCooldown: boolean)
	local state = decoyByPlayer[player]
	if not state then
		return
	end
	decoyByPlayer[player] = nil
	local char = state.character
	if char.Parent then
		char:SetAttribute(GameConstants.LOKI_CLONE_ACTIVE_ATTRIBUTE, nil)
		char:SetAttribute(GameConstants.LOKI_CLONE_MODE_ATTRIBUTE, nil)
		AbilityCooldownHelper.setActive(char, "illusion_decoy", false)
		if applyCooldown then
			AbilityCooldownHelper.applyAfterUse(char, "illusion_decoy", GameConstants.LOKI_CLONE_COOLDOWN)
			CharacterService.markAbilityUse(char)
		end
	end
	if state.animConn then
		state.animConn:Disconnect()
		state.animConn = nil
	end
	if state.clone.Parent then
		state.clone:Destroy()
	end
end

local function detonateDecoy(player: Player)
	local state = decoyByPlayer[player]
	if not state then
		return
	end
	-- Don't start a second detonate
	if state.mode == "Detonating" then
		return
	end
	state.mode = "Detonating"
	if state.character.Parent then
		state.character:SetAttribute(GameConstants.LOKI_CLONE_MODE_ATTRIBUTE, "Detonate")
	end

	-- Freeze in place for the windup (don't keep walking from Run)
	if state.humanoid.Parent then
		state.humanoid.WalkSpeed = 0
		state.humanoid:MoveTo(state.root.Position)
	end
	if state.root.Parent then
		state.root.AssemblyLinearVelocity = Vector3.zero
		state.root.AssemblyAngularVelocity = Vector3.zero
	end

	local existing = state.clone:FindFirstChild("LokiDetonateHighlight")
	if existing then
		existing:Destroy()
	end
	local hl = Instance.new("Highlight")
	hl.Name = "LokiDetonateHighlight"
	hl.FillColor = Color3.fromRGB(80, 255, 120)
	hl.FillTransparency = 1
	hl.OutlineColor = Color3.fromRGB(180, 255, 200)
	hl.OutlineTransparency = 1
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = state.clone
	hl.Parent = state.clone

	TweenService:Create(hl, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		FillTransparency = 0.05,
		OutlineTransparency = 0,
	}):Play()

	task.wait(1)
	if not state.clone.Parent or decoyByPlayer[player] ~= state then
		if hl.Parent then
			hl:Destroy()
		end
		return
	end

	local pos = state.root.Position
	VfxHelper.spawnLokiDetonateAttachment(pos)
	local near = CombatHelper.overlapCharacters(pos, GameConstants.LOKI_CLONE_DETONATE_RADIUS, state.character)
	for _, model in near do
		if model ~= state.clone and model:GetAttribute("LokiUltClone") ~= true then
			CombatHelper.dealDamage(state.character, model, GameConstants.LOKI_CLONE_DETONATE_DAMAGE)
			RagdollStatus.applyTimed(model, GameConstants.LOKI_CLONE_DETONATE_RAGDOLL)
			local mRoot = getRoot(model)
			if mRoot then
				local push = mRoot.Position - pos
				if push.Magnitude > 0.05 then
					PushHelper.applyToCharacter(model, push.Unit, {
						speed = GameConstants.LOKI_CLONE_DETONATE_PUSH_SPEED,
						upBoost = GameConstants.LOKI_CLONE_DETONATE_PUSH_UP,
					})
				end
			end
		end
	end
	endDecoy(player, true)
end

local function punchWithDecoy(state: DecoyState)
	local look = state.root.CFrame.LookVector
	local origin = state.root.Position
	local best: Model? = nil
	local bestDist = GameConstants.LOKI_CLONE_PUNCH_RANGE
	local near = CombatHelper.overlapCharacters(origin, GameConstants.LOKI_CLONE_PUNCH_RANGE, state.character)
	for _, model in near do
		if model == state.clone then
			continue
		end
		local root = getRoot(model)
		if not root then
			continue
		end
		local to = root.Position - origin
		if to.Magnitude < 0.05 then
			continue
		end
		if to.Unit:Dot(look) < 0.35 then
			continue
		end
		if to.Magnitude < bestDist then
			bestDist = to.Magnitude
			best = model
		end
	end
	if best then
		CombatHelper.dealDamage(state.character, best, GameConstants.LOKI_CLONE_PUNCH_DAMAGE)
		local r = getRoot(best)
		if r then
			PushHelper.applyToCharacter(best, look, { speed = 28, upBoost = 4 })
		end
	end
end

local function placeDecoy(player: Player, aimPoint: Vector3?)
	local character = player.Character
	if not character or not decoyArmed[player] then
		return
	end
	decoyArmed[player] = false
	if decoyByPlayer[player] then
		return
	end
	local entry = CharacterRegistry.getAbilityById("loki", "illusion_decoy")
	if not entry or not canUse(character, entry.id, GameConstants.LOKI_CLONE_ENERGY) then
		return
	end

	local placeAt = aimPoint or (character:GetPivot().Position + character:GetPivot().LookVector * 8)
	do
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		local cast = Workspace:Raycast(placeAt + Vector3.new(0, 3, 0), Vector3.new(0, -50, 0), params)
		if cast then
			placeAt = cast.Position
		end
	end
	local ok, clone = pcall(function()
		local was = character.Archivable
		character.Archivable = true
		local c = character:Clone()
		character.Archivable = was
		return c
	end)
	if not ok or not clone or not clone:IsA("Model") then
		AbilityCooldownHelper.setActive(character, entry.id, false)
		return
	end

	stripCloneNoise(clone, true)
	copyAnimateFromSource(clone, character)
	clone.Name = string.format("%s's clone", player.DisplayName)
	clone:SetAttribute("LokiDecoy", true)
	clone:SetAttribute("FearVisual", true) -- soft-lock ignore pattern
	local hum = clone:FindFirstChildOfClass("Humanoid")
	local root = getRoot(clone)
	if not hum or not root then
		clone:Destroy()
		AbilityCooldownHelper.setActive(character, entry.id, false)
		return
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.Health = math.max(50, hum.MaxHealth * 0.35)
	hum.WalkSpeed = 0
	hum.MaxHealth = hum.Health
	for _, part in clone:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = true
			part.Massless = false
		end
	end
	local spawnPos = placeAt + Vector3.new(0, 3, 0)
	local lookFlat = Vector3.new(character:GetPivot().LookVector.X, 0, character:GetPivot().LookVector.Z)
	if lookFlat.Magnitude > 0.01 then
		clone:PivotTo(CFrame.lookAt(spawnPos, spawnPos + lookFlat.Unit))
	else
		clone:PivotTo(CFrame.new(spawnPos))
	end
	clone.Parent = Workspace
	revealCloneFeetToHead(clone, 0.55)
	addCloneNameplate(clone, clone.Name)
	local animConn = attachCloneAnimate(clone, character)

	AbilityCooldownHelper.setActive(character, entry.id, true)
	character:SetAttribute(GameConstants.LOKI_CLONE_ACTIVE_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.LOKI_CLONE_MODE_ATTRIBUTE, "Punch")
	CharacterService.markAbilityUse(character)

	decoyByPlayer[player] = {
		character = character,
		clone = clone,
		humanoid = hum,
		root = root,
		mode = "Punch",
		aimPoint = placeAt,
		startedAt = os.clock(),
		ownerName = player.DisplayName,
		animConn = animConn,
		swapping = false,
	}
end

local function lieOfPlace(player: Player)
	local state = decoyByPlayer[player]
	if not state or state.swapping or state.mode == "Detonating" then
		return
	end
	local character = state.character
	local charRoot = getRoot(character)
	if not charRoot or not state.root.Parent or not character.Parent then
		return
	end

	state.swapping = true
	state.mode = "Lie of Place"
	character:SetAttribute(GameConstants.LOKI_CLONE_MODE_ATTRIBUTE, "Lie of Place")
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)

	-- Stop run walk during swap
	state.humanoid.WalkSpeed = 0
	state.humanoid:MoveTo(state.root.Position)

	local playerCf = charRoot.CFrame
	local decoyCf = state.root.CFrame
	VfxHelper.spawnBurstSparks(playerCf.Position, lokiGreen(), 6)
	VfxHelper.spawnBurstSparks(decoyCf.Position, lokiGreen(), 6)

	local duration = 0.32
	local t0 = os.clock()
	while decoyByPlayer[player] == state and (os.clock() - t0) < duration do
		local a = math.clamp((os.clock() - t0) / duration, 0, 1)
		-- Smoothstep
		a = a * a * (3 - 2 * a)
		if charRoot.Parent and state.root.Parent then
			charRoot.CFrame = playerCf:Lerp(decoyCf, a)
			state.root.CFrame = decoyCf:Lerp(playerCf, a)
			charRoot.AssemblyLinearVelocity = Vector3.zero
			state.root.AssemblyLinearVelocity = Vector3.zero
		end
		task.wait()
	end

	if decoyByPlayer[player] == state and charRoot.Parent and state.root.Parent then
		charRoot.CFrame = decoyCf
		state.root.CFrame = playerCf
		charRoot.AssemblyLinearVelocity = Vector3.zero
		state.root.AssemblyLinearVelocity = Vector3.zero
		VfxHelper.spawnBurstSparks(decoyCf.Position, lokiGreen(), 5)
		VfxHelper.spawnBurstSparks(playerCf.Position, lokiGreen(), 5)
	end

	if character.Parent then
		character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
	end
	if decoyByPlayer[player] == state then
		state.swapping = false
		-- Stay on Lie of Place highlight; idle until next mode
		state.humanoid.WalkSpeed = 0
	end
end

local function setDecoyMode(player: Player, mode: string)
	local state = decoyByPlayer[player]
	if not state then
		return
	end
	if state.swapping or state.mode == "Detonating" then
		return
	end
	if mode ~= "Punch" and mode ~= "Run" and mode ~= "Detonate" and mode ~= "Lie of Place" then
		return
	end
	if mode == "Detonate" then
		task.spawn(function()
			detonateDecoy(player)
		end)
		return
	end
	if mode == "Lie of Place" then
		task.spawn(function()
			lieOfPlace(player)
		end)
		return
	end

	-- Leaving Run: cancel ongoing MoveTo so Punch doesn't keep walking forever
	if state.mode == "Run" and mode ~= "Run" then
		state.humanoid:MoveTo(state.root.Position)
		state.humanoid.WalkSpeed = 0
	end

	state.mode = mode
	if state.character.Parent then
		state.character:SetAttribute(GameConstants.LOKI_CLONE_MODE_ATTRIBUTE, mode)
	end
	if mode == "Punch" then
		punchWithDecoy(state)
		-- Keep decoy alive after punch so it can Run / Detonate
	elseif mode == "Run" then
		state.humanoid.WalkSpeed = GameConstants.LOKI_CLONE_RUN_SPEED
	end
end

local function clearTeleportAim(character: Model?, abilityId: string?)
	if not character or not character.Parent then
		return
	end
	character:SetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE, nil)
	if abilityId then
		AbilityCooldownHelper.setActive(character, abilityId, false)
	end
end

local function beginTeleportAim(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("loki", "trickster_dash")
	if not entry then
		return
	end
	if character:GetAttribute(GameConstants.LOKI_DASH_MODE_ATTRIBUTE) ~= "Teleport" then
		return
	end
	if AbilityCooldownHelper.isOnCooldown(character, entry.id) then
		return
	end
	if CombatHelper.arePowersDisabled(character) or character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return
	end
	-- Already aiming: confirm handled by client separately
	if character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true then
		return
	end
	character:SetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE, true)
	-- UI hold/select effect (no energy until confirm)
	AbilityCooldownHelper.setActive(character, entry.id, true)
end

local function confirmTeleport(player: Player, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("loki", "trickster_dash")
	if not entry then
		return
	end
	if character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) ~= true then
		return
	end
	local root = getRoot(character)
	if not root then
		clearTeleportAim(character, entry.id)
		return
	end
	if not CharacterService.spendEnergy(character, GameConstants.LOKI_DASH_ENERGY) then
		clearTeleportAim(character, entry.id)
		return
	end

	local target = aimPoint or (root.Position + root.CFrame.LookVector * GameConstants.LOKI_TELEPORT_RANGE)
	local offset = target - root.Position
	local flat = Vector3.new(offset.X, 0, offset.Z)
	if flat.Magnitude > GameConstants.LOKI_TELEPORT_RANGE then
		flat = flat.Unit * GameConstants.LOKI_TELEPORT_RANGE
	end
	local dest = root.Position + flat
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local cast = Workspace:Raycast(dest + Vector3.new(0, 4, 0), Vector3.new(0, -60, 0), params)
	if cast then
		dest = cast.Position + Vector3.new(0, 3, 0)
	else
		dest = Vector3.new(dest.X, root.Position.Y, dest.Z)
	end

	character:SetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE, nil)
	AbilityCooldownHelper.setActive(character, entry.id, true)
	character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, true)

	local fade = GameConstants.TELEPORT_FADE
	local lookCf = root.CFrame - root.CFrame.Position
	VfxHelper.spawnBurstSparks(root.Position, lokiGreen(), 6)
	VfxHelper.fadePartsByHeight(character, 1, fade, true, function()
		if not character.Parent or not root.Parent then
			if character.Parent then
				character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
				finishAbility(character, entry.id, GameConstants.LOKI_DASH_COOLDOWN)
			end
			return
		end
		root.CFrame = CFrame.new(dest) * lookCf
		VfxHelper.setCharacterTransparency(character, 1)
		VfxHelper.spawnBurstSparks(dest, lokiGreen(), 8)
		VfxHelper.fadePartsByHeight(character, 0, fade, true, function()
			if character.Parent then
				character:SetAttribute(GameConstants.BUSY_ATTRIBUTE, nil)
				finishAbility(character, entry.id, GameConstants.LOKI_DASH_COOLDOWN)
			end
		end)
	end)
end

local function tricksterMove(player: Player, moveVector: Vector3?, lookDir: Vector3?, aimPoint: Vector3?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("loki", "trickster_dash")
	if not entry then
		return
	end
	local root = getRoot(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return
	end

	local modeAttr = character:GetAttribute(GameConstants.LOKI_DASH_MODE_ATTRIBUTE)
	if modeAttr == "Teleport" then
		-- Teleport uses aim → confirm flow
		if character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true then
			confirmTeleport(player, aimPoint)
		else
			beginTeleportAim(player)
		end
		return
	end

	if not canUse(character, entry.id, GameConstants.LOKI_DASH_ENERGY) then
		return
	end

	-- Dash mode (original)
	local move = moveVector or Vector3.zero
	local dir: Vector3
	if move.Magnitude > 0.08 then
		dir = move.Unit
	elseif lookDir and lookDir.Magnitude > 0.01 then
		dir = lookDir.Unit
	else
		dir = root.CFrame.LookVector
	end
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.05 then
		dir = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	end
	if dir.Magnitude < 0.05 then
		AbilityCooldownHelper.setActive(character, entry.id, false)
		finishAbility(character, entry.id, 0.5)
		return
	end
	dir = dir.Unit

	AbilityCooldownHelper.setActive(character, entry.id, true)
	dashUntil[player] = os.clock() + GameConstants.LOKI_DASH_DURATION

	local att = root:FindFirstChild("LokiDashAttachment") :: Attachment?
	if not att then
		att = Instance.new("Attachment")
		att.Name = "LokiDashAttachment"
		att.Parent = root
	end
	local oldLv = root:FindFirstChild("LokiDashVelocity")
	if oldLv then
		oldLv:Destroy()
	end
	local lv = Instance.new("LinearVelocity")
	lv.Name = "LokiDashVelocity"
	lv.Attachment0 = att
	lv.MaxForce = 1e6
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VectorVelocity = dir * GameConstants.LOKI_DASH_SPEED + Vector3.new(0, 8, 0)
	lv.Parent = root

	VfxHelper.spawnBurstSparks(root.Position, lokiGreen(), 5)

	task.delay(GameConstants.LOKI_DASH_DURATION, function()
		dashUntil[player] = nil
		if lv.Parent then
			lv:Destroy()
		end
		if character.Parent then
			finishAbility(character, entry.id, GameConstants.LOKI_DASH_COOLDOWN)
		end
	end)
end

local SHAPESHIFT_HIDE_NAME = "LokiShapeshiftHidden"
local SHAPESHIFT_BODY_NAME = "LokiShapeshiftBody"
local SHAPESHIFT_ORIG_T = "LokiShapeshiftOrigT"
local SHAPESHIFT_MORPH_TIME = 0.45

local function clearShapeshift(player: Player, character: Model?)
	if not character or not character.Parent then
		return
	end
	character:SetAttribute(GameConstants.LOKI_SHAPESHIFT_ATTRIBUTE, nil)
	local body = character:FindFirstChild(SHAPESHIFT_BODY_NAME)
	if body then
		-- Fade disguise out quickly
		for _, desc in body:GetDescendants() do
			if desc:IsA("BasePart") or desc:IsA("Decal") or desc:IsA("Texture") then
				TweenService:Create(desc, TweenInfo.new(0.25), { Transparency = 1 }):Play()
			end
		end
		task.delay(0.28, function()
			if body.Parent then
				body:Destroy()
			end
		end)
	end
	for _, desc in character:GetDescendants() do
		if desc:IsA("BasePart") and desc:GetAttribute(SHAPESHIFT_HIDE_NAME) == true then
			local orig = desc:GetAttribute(SHAPESHIFT_ORIG_T)
			local goal = if typeof(orig) == "number" then orig else 0
			desc.LocalTransparencyModifier = 0
			TweenService:Create(desc, TweenInfo.new(SHAPESHIFT_MORPH_TIME), { Transparency = goal }):Play()
			desc:SetAttribute(SHAPESHIFT_HIDE_NAME, nil)
			desc:SetAttribute(SHAPESHIFT_ORIG_T, nil)
		elseif (desc:IsA("Decal") or desc:IsA("Texture")) and desc:GetAttribute(SHAPESHIFT_HIDE_NAME) == true then
			local orig = desc:GetAttribute(SHAPESHIFT_ORIG_T)
			local goal = if typeof(orig) == "number" then orig else 0
			TweenService:Create(desc, TweenInfo.new(SHAPESHIFT_MORPH_TIME), { Transparency = goal }):Play()
			desc:SetAttribute(SHAPESHIFT_HIDE_NAME, nil)
			desc:SetAttribute(SHAPESHIFT_ORIG_T, nil)
		elseif desc:IsA("Accessory") and desc:GetAttribute(SHAPESHIFT_HIDE_NAME) == true then
			desc:SetAttribute(SHAPESHIFT_HIDE_NAME, nil)
			for _, p in desc:GetDescendants() do
				if p:IsA("BasePart") then
					local orig = p:GetAttribute(SHAPESHIFT_ORIG_T)
					local goal = if typeof(orig) == "number" then orig else 0
					TweenService:Create(p, TweenInfo.new(SHAPESHIFT_MORPH_TIME), { Transparency = goal }):Play()
					p:SetAttribute(SHAPESHIFT_ORIG_T, nil)
				end
			end
		end
	end
end

local function startShapeshift(player: Player, targetModel: Model?)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("loki", "shapeshift")
	if not entry then
		return
	end

	-- V again while shifted: cancel early and start cooldown
	if character:GetAttribute(GameConstants.LOKI_SHAPESHIFT_ATTRIBUTE) == true then
		shapeshiftToken[player] = (shapeshiftToken[player] or 0) + 1
		clearShapeshift(player, character)
		finishAbility(character, entry.id, GameConstants.LOKI_SHAPESHIFT_COOLDOWN)
		return
	end

	-- Validate target BEFORE spending energy
	if character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "loki" then
		return
	end
	if CombatHelper.arePowersDisabled(character) then
		return
	end
	if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return
	end
	if AbilityCooldownHelper.isOnCooldown(character, entry.id) then
		return
	end
	if AbilityCooldownHelper.isActive(character, entry.id) then
		return
	end

	local target = targetModel
	if not target or target == character then
		return
	end
	if not CombatHelper.getHumanoid(target) then
		return
	end

	if not CharacterService.spendEnergy(character, GameConstants.LOKI_SHAPESHIFT_ENERGY) then
		return
	end

	local ok, body = pcall(function()
		local was = target.Archivable
		target.Archivable = true
		local c = target:Clone()
		target.Archivable = was
		return c
	end)
	if not ok or not body or not body:IsA("Model") then
		-- Refund energy if clone failed
		local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		local maxE = character:GetAttribute(GameConstants.MAX_ENERGY_ATTRIBUTE)
		if type(energy) == "number" and type(maxE) == "number" then
			character:SetAttribute(
				GameConstants.ENERGY_ATTRIBUTE,
				math.min(maxE, energy + GameConstants.LOKI_SHAPESHIFT_ENERGY)
			)
		end
		return
	end

	stripCloneNoise(body, false)
	-- Remove leftover humanoid / UI; keep visual transparency exactly as cloned
	for _, d in body:GetDescendants() do
		if d:IsA("Humanoid") or d:IsA("Animator") or d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		elseif d:IsA("BillboardGui") or d:IsA("Highlight") then
			d:Destroy()
		end
	end
	body.Name = SHAPESHIFT_BODY_NAME
	local bodyRoot = getRoot(body)
	local charRoot = getRoot(character)
	if not bodyRoot or not charRoot then
		body:Destroy()
		local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		local maxE = character:GetAttribute(GameConstants.MAX_ENERGY_ATTRIBUTE)
		if type(energy) == "number" and type(maxE) == "number" then
			character:SetAttribute(
				GameConstants.ENERGY_ATTRIBUTE,
				math.min(maxE, energy + GameConstants.LOKI_SHAPESHIFT_ENERGY)
			)
		end
		return
	end

	-- Fade Loki out (restore later from saved transparency — keep invisible parts invisible)
	for _, desc in character:GetDescendants() do
		if desc:IsA("BasePart") and desc ~= charRoot then
			desc:SetAttribute(SHAPESHIFT_HIDE_NAME, true)
			desc:SetAttribute(SHAPESHIFT_ORIG_T, desc.Transparency)
			TweenService:Create(desc, TweenInfo.new(SHAPESHIFT_MORPH_TIME), { Transparency = 1 }):Play()
		elseif desc:IsA("Decal") or desc:IsA("Texture") then
			desc:SetAttribute(SHAPESHIFT_HIDE_NAME, true)
			desc:SetAttribute(SHAPESHIFT_ORIG_T, desc.Transparency)
			TweenService:Create(desc, TweenInfo.new(SHAPESHIFT_MORPH_TIME), { Transparency = 1 }):Play()
		elseif desc:IsA("Accessory") then
			desc:SetAttribute(SHAPESHIFT_HIDE_NAME, true)
			for _, p in desc:GetDescendants() do
				if p:IsA("BasePart") then
					p:SetAttribute(SHAPESHIFT_ORIG_T, p.Transparency)
					TweenService:Create(p, TweenInfo.new(SHAPESHIFT_MORPH_TIME), { Transparency = 1 }):Play()
				end
			end
		end
	end

	-- Disguise: collision off, preserve exact visual transparency (incl. already-invisible parts)
	local fadeGoals: { { inst: Instance, goal: number } } = {}
	for _, part in body:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
			local goal = part.Transparency
			table.insert(fadeGoals, { inst = part, goal = goal })
			part.Transparency = 1
		elseif part:IsA("Decal") or part:IsA("Texture") then
			local goal = part.Transparency
			table.insert(fadeGoals, { inst = part, goal = goal })
			part.Transparency = 1
		end
	end
	body:PivotTo(character:GetPivot())
	body.Parent = character
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = charRoot
	weld.Part1 = bodyRoot
	weld.Parent = bodyRoot

	for _, entryFade in fadeGoals do
		local inst = entryFade.inst
		if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture") then
			TweenService:Create(inst, TweenInfo.new(SHAPESHIFT_MORPH_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Transparency = entryFade.goal,
			}):Play()
		end
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	character:SetAttribute(GameConstants.LOKI_SHAPESHIFT_ATTRIBUTE, true)

	local token = (shapeshiftToken[player] or 0) + 1
	shapeshiftToken[player] = token
	task.delay(GameConstants.LOKI_SHAPESHIFT_DURATION, function()
		if shapeshiftToken[player] ~= token then
			return
		end
		clearShapeshift(player, character)
		if character.Parent then
			finishAbility(character, entry.id, GameConstants.LOKI_SHAPESHIFT_COOLDOWN)
		end
	end)
end

local INVIS_ORIG_T = "LokiInvisServerOrigT"
local INVIS_WAS_ENABLED = "LokiInvisServerWasEnabled"
local invisDescConns: { [Model]: RBXScriptConnection } = {}

local function applyInvisToDescendant(desc: Instance, on: boolean)
	if desc:IsA("BasePart") then
		if on then
			if desc:GetAttribute(INVIS_ORIG_T) == nil then
				desc:SetAttribute(INVIS_ORIG_T, desc.Transparency)
			end
			desc.Transparency = 1
			desc.LocalTransparencyModifier = 0
		else
			local orig = desc:GetAttribute(INVIS_ORIG_T)
			if type(orig) == "number" then
				desc.Transparency = if desc.Name == "HumanoidRootPart" then 1 else orig
				desc:SetAttribute(INVIS_ORIG_T, nil)
			end
			desc.LocalTransparencyModifier = 0
		end
	elseif desc:IsA("Decal") or desc:IsA("Texture") then
		if on then
			if desc:GetAttribute(INVIS_ORIG_T) == nil then
				desc:SetAttribute(INVIS_ORIG_T, desc.Transparency)
			end
			desc.Transparency = 1
		else
			local orig = desc:GetAttribute(INVIS_ORIG_T)
			if type(orig) == "number" then
				desc.Transparency = orig
				desc:SetAttribute(INVIS_ORIG_T, nil)
			end
		end
	elseif desc:IsA("ParticleEmitter") or desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("Fire") or desc:IsA("Smoke") then
		if on then
			if desc:GetAttribute(INVIS_WAS_ENABLED) == nil then
				desc:SetAttribute(INVIS_WAS_ENABLED, desc.Enabled)
			end
			desc.Enabled = false
		else
			local was = desc:GetAttribute(INVIS_WAS_ENABLED)
			if typeof(was) == "boolean" then
				desc.Enabled = was
				desc:SetAttribute(INVIS_WAS_ENABLED, nil)
			end
		end
	elseif desc:IsA("Highlight") then
		desc.Enabled = not on
	elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
		desc.Enabled = not on
	elseif desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") then
		if on then
			if desc:GetAttribute(INVIS_WAS_ENABLED) == nil then
				desc:SetAttribute(INVIS_WAS_ENABLED, desc.Enabled)
			end
			desc.Enabled = false
		else
			local was = desc:GetAttribute(INVIS_WAS_ENABLED)
			if typeof(was) == "boolean" then
				desc.Enabled = was
				desc:SetAttribute(INVIS_WAS_ENABLED, nil)
			end
		end
	end
end

local function setInvisible(character: Model, on: boolean)
	-- Server-authoritative invis (replicates to all clients + Studio server view).
	-- Local Loki client restores a ghost silhouette for the caster only.
	character:SetAttribute(GameConstants.LOKI_INVISIBLE_ATTRIBUTE, if on then true else nil)

	for _, desc in character:GetDescendants() do
		applyInvisToDescendant(desc, on)
	end

	local existing = invisDescConns[character]
	if existing then
		existing:Disconnect()
		invisDescConns[character] = nil
	end
	if on then
		invisDescConns[character] = character.DescendantAdded:Connect(function(desc)
			if character:GetAttribute(GameConstants.LOKI_INVISIBLE_ATTRIBUTE) == true then
				applyInvisToDescendant(desc, true)
			end
		end)
	end

	local hum = character:FindFirstChildOfClass("Humanoid")
	if hum then
		if on then
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			hum.NameDisplayDistance = 0
			hum.HealthDisplayDistance = 0
		else
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		end
	end
end

local function destroyUlt(player: Player, applyCooldown: boolean)
	local state = ultByPlayer[player]
	if not state then
		return
	end
	ultByPlayer[player] = nil
	for _, c in state.clones do
		if c.animConn then
			c.animConn:Disconnect()
			c.animConn = nil
		end
		if c.clone.Parent then
			for _, part in c.clone:GetDescendants() do
				if part:IsA("BasePart") then
					TweenService:Create(part, TweenInfo.new(0.45), { Transparency = 1 }):Play()
				end
			end
			task.delay(0.5, function()
				if c.clone.Parent then
					c.clone:Destroy()
				end
			end)
		end
	end
	if state.character.Parent then
		setInvisible(state.character, false)
		state.character:SetAttribute(GameConstants.LOKI_ULT_ACTIVE_ATTRIBUTE, nil)
		state.character:SetAttribute(GameConstants.LOKI_ULT_ATTACK_ATTRIBUTE, nil)
		AbilityCooldownHelper.setActive(state.character, "god_of_mischief", false)
		if applyCooldown then
			AbilityCooldownHelper.applyAfterUse(state.character, "god_of_mischief", GameConstants.LOKI_ULT_COOLDOWN)
			CharacterService.markAbilityUse(state.character)
		end
	end
end

local function pickUltWander(home: Vector3): Vector3
	local angle = math.random() * math.pi * 2
	local dist = math.random() * GameConstants.LOKI_ULT_ROAM_RADIUS
	return home + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
end

local function spawnUltClone(owner: Model, offset: Vector3): UltCloneState?
	local ok, clone = pcall(function()
		local was = owner.Archivable
		owner.Archivable = true
		local c = owner:Clone()
		owner.Archivable = was
		return c
	end)
	if not ok or not clone or not clone:IsA("Model") then
		return nil
	end
	stripCloneNoise(clone, true)
	copyAnimateFromSource(clone, owner)
	clone.Name = "LokiMischiefClone"
	clone:SetAttribute("LokiUltClone", true)
	clone:SetAttribute("FearVisual", true)
	-- Roaming clones: unanchored, light collision
	for _, part in clone:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = 0
			part.CanCollide = part.Name == "HumanoidRootPart" or part.Name == "UpperTorso" or part.Name == "Torso"
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = false
			part.Anchored = false
		elseif part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Beam") then
			part:Destroy()
		end
	end
	local hum = clone:FindFirstChildOfClass("Humanoid")
	local root = getRoot(clone)
	if not hum or not root then
		clone:Destroy()
		return nil
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.PlatformStand = false
	hum.WalkSpeed = GameConstants.LOKI_ULT_ROAM_SPEED
	hum.AutoRotate = true
	root.Anchored = false
	root.CanCollide = true
	local ownerRoot = getRoot(owner)
	local base = if ownerRoot then ownerRoot.CFrame else owner:GetPivot()
	clone:PivotTo(base * CFrame.new(offset))
	clone.Parent = Workspace
	revealCloneFeetToHead(clone, 0.45)
	local home = root.Position
	local animConn = attachCloneAnimate(clone, owner)
	return {
		clone = clone,
		root = root,
		humanoid = hum,
		lastBlast = 0,
		owner = owner,
		home = home,
		wanderTarget = pickUltWander(home),
		nextWanderAt = os.clock() + 0.2 + math.random() * 0.5,
		animConn = animConn,
	}
end

local function setUltAttackMode(player: Player, mode: string)
	local state = ultByPlayer[player]
	if not state then
		return
	end
	local enabled = mode == "Attack" or mode == "Attack On" or mode == "On"
	if mode == "Idle" or mode == "Attack Off" or mode == "Off" or mode == "Cease" then
		enabled = false
	elseif mode ~= "Attack" and mode ~= "Attack On" and mode ~= "On" then
		return
	end
	state.attackEnabled = enabled
	if state.character.Parent then
		state.character:SetAttribute(GameConstants.LOKI_ULT_ATTACK_ATTRIBUTE, if enabled then true else false)
	end
end

local function startGodOfMischief(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("loki", "god_of_mischief")
	if not entry or not canUse(character, entry.id, GameConstants.LOKI_ULT_ENERGY) then
		return
	end
	if ultByPlayer[player] then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)

	-- Spawn clones WHILE still visible, then go invisible
	local clones: { UltCloneState } = {}
	local offsets = {
		Vector3.new(4, 0, 2),
		Vector3.new(-4, 0, 2),
		Vector3.new(0, 0, -4),
	}
	for _, off in offsets do
		local c = spawnUltClone(character, off)
		if c then
			table.insert(clones, c)
		end
	end
	setInvisible(character, true)
	character:SetAttribute(GameConstants.LOKI_ULT_ACTIVE_ATTRIBUTE, true)
	character:SetAttribute(GameConstants.LOKI_ULT_ATTACK_ATTRIBUTE, true)

	ultByPlayer[player] = {
		character = character,
		clones = clones,
		startedAt = os.clock(),
		attackEnabled = true,
	}

	task.delay(GameConstants.LOKI_ULT_CLONE_LIFE, function()
		local state = ultByPlayer[player]
		if not state then
			return
		end
		for _, c in state.clones do
			if c.animConn then
				c.animConn:Disconnect()
				c.animConn = nil
			end
			if c.clone.Parent then
				for _, part in c.clone:GetDescendants() do
					if part:IsA("BasePart") then
						TweenService:Create(part, TweenInfo.new(0.45), { Transparency = 1 }):Play()
					end
				end
				task.delay(0.5, function()
					if c.clone.Parent then
						c.clone:Destroy()
					end
				end)
			end
		end
		state.clones = {}
	end)

	task.delay(GameConstants.LOKI_ULT_DURATION_INVIS, function()
		destroyUlt(player, true)
	end)
end

local function startReflect(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local entry = CharacterRegistry.getAbilityById("loki", "reflect_shield")
	if not entry or not canUse(character, entry.id, GameConstants.LOKI_REFLECT_ENERGY) then
		return
	end

	AbilityCooldownHelper.setActive(character, entry.id, true)
	character:SetAttribute(GameConstants.LOKI_REFLECT_ATTRIBUTE, true)
	reflectUntil[player] = AbilityCooldownHelper.getNow() + GameConstants.LOKI_REFLECT_DURATION

	local hl = Instance.new("Highlight")
	hl.Name = "LokiReflectHighlight"
	hl.FillTransparency = 1
	hl.OutlineTransparency = 0
	hl.OutlineColor = lokiGreen()
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = character
	hl.Parent = character

	task.delay(GameConstants.LOKI_REFLECT_DURATION, function()
		if hl.Parent then
			hl:Destroy()
		end
		if character.Parent then
			character:SetAttribute(GameConstants.LOKI_REFLECT_ATTRIBUTE, nil)
			finishAbility(character, entry.id, GameConstants.LOKI_REFLECT_COOLDOWN)
		end
		reflectUntil[player] = nil
	end)
end

local function fireUltCloneBlast(c: UltCloneState)
	local near = CombatHelper.overlapCharacters(c.root.Position, GameConstants.LOKI_ULT_BLAST_RANGE, c.owner)
	local best: Model? = nil
	local bestDist = GameConstants.LOKI_ULT_BLAST_RANGE
	for _, model in near do
		if model:GetAttribute("LokiUltClone") == true or model:GetAttribute("LokiDecoy") == true then
			continue
		end
		local root = getRoot(model)
		if not root then
			continue
		end
		local d = (root.Position - c.root.Position).Magnitude
		if d < bestDist then
			bestDist = d
			best = model
		end
	end
	if not best then
		return
	end
	local tRoot = getRoot(best)
	if not tRoot then
		return
	end
	local origin = c.root.Position + Vector3.new(0, 1.5, 0)
	local dir = (tRoot.Position - origin)
	if dir.Magnitude < 0.05 then
		return
	end
	dir = dir.Unit
	c.root.CFrame = CFrame.lookAt(c.root.Position, Vector3.new(tRoot.Position.X, c.root.Position.Y, tRoot.Position.Z))
	ProjectileHelper.spawn(origin, dir, {
		speed = 120,
		damage = GameConstants.LOKI_ULT_BLAST_DAMAGE,
		radius = 2.4,
		maxDistance = GameConstants.LOKI_ULT_BLAST_RANGE,
		owner = c.owner,
		color = lokiGreen(),
		homeDir = dir,
		homePoint = tRoot.Position,
		homeTarget = best,
		homeAfter = 0,
		seekUntilClose = true,
		seekCloseDistance = 2.2,
		boltFolder = "Loki",
		boltAsset = "EnergyBlast",
		impactFx = "loki",
	})
end

function LokiService.update(dt: number)
	local now = os.clock()
	local _ = dt

	for player, state in decoyByPlayer do
		if not state.character.Parent or player.Character ~= state.character or not state.clone.Parent then
			endDecoy(player, true)
			continue
		end
		if now - state.startedAt >= GameConstants.LOKI_CLONE_DURATION then
			endDecoy(player, true)
			continue
		end
		if state.humanoid.Health <= 0 then
			endDecoy(player, true)
			continue
		end
		if state.mode == "Run" then
			state.humanoid.WalkSpeed = GameConstants.LOKI_CLONE_RUN_SPEED
			state.humanoid:MoveTo(state.aimPoint)
		end
	end

	for player, state in ultByPlayer do
		if not state.character.Parent or player.Character ~= state.character then
			destroyUlt(player, false)
			continue
		end
		for _, c in state.clones do
			if not c.clone.Parent or not c.root.Parent then
				continue
			end
			-- Random roam in a small area around spawn home
			if now >= c.nextWanderAt then
				c.wanderTarget = pickUltWander(c.home)
				c.nextWanderAt = now + GameConstants.LOKI_ULT_WANDER_INTERVAL * (0.7 + math.random() * 0.6)
			end
			c.humanoid.WalkSpeed = GameConstants.LOKI_ULT_ROAM_SPEED
			c.humanoid:MoveTo(c.wanderTarget)

			if state.attackEnabled and now - c.lastBlast >= GameConstants.LOKI_ULT_BLAST_CD then
				c.lastBlast = now
				fireUltCloneBlast(c)
			end
		end
	end
end

function LokiService.cancelAll(player: Player)
	decoyArmed[player] = false
	endDecoy(player, false)
	destroyUlt(player, false)
	reflectUntil[player] = nil
	dashUntil[player] = nil
	shapeshiftToken[player] = (shapeshiftToken[player] or 0) + 1
	local char = player.Character
	if char then
		clearShapeshift(player, char)
		clearTeleportAim(char, "trickster_dash")
		char:SetAttribute(GameConstants.LOKI_REFLECT_ATTRIBUTE, nil)
		char:SetAttribute(GameConstants.LOKI_CLONE_ACTIVE_ATTRIBUTE, nil)
		char:SetAttribute(GameConstants.LOKI_CLONE_MODE_ATTRIBUTE, nil)
		char:SetAttribute(GameConstants.LOKI_SHAPESHIFT_ATTRIBUTE, nil)
		char:SetAttribute(GameConstants.LOKI_INVISIBLE_ATTRIBUTE, nil)
		local hl = char:FindFirstChild("LokiReflectHighlight")
		if hl then
			hl:Destroy()
		end
		local dashLv = char:FindFirstChild("LokiDashVelocity", true)
		if dashLv then
			dashLv:Destroy()
		end
	end
end

function LokiService.handleAction(player: Player, payload: any)
	if type(payload) ~= "table" then
		return
	end
	local character = player.Character
	if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "loki" then
		return
	end

	local action = payload.action
	if type(action) ~= "string" then
		return
	end

	local direction = if typeof(payload.direction) == "Vector3" then payload.direction else Vector3.new(0, 0, -1)
	local aimPoint = if typeof(payload.aimPoint) == "Vector3" then payload.aimPoint else nil
	local moveVector = if typeof(payload.moveVector) == "Vector3" then payload.moveVector else nil
	local targetModel = if typeof(payload.target) == "Instance" and payload.target:IsA("Model")
		then payload.target
		else nil

	if action == "SetMode" then
		if type(payload.abilityId) == "string" and type(payload.mode) == "string" then
			if payload.abilityId == "illusion_decoy" then
				setDecoyMode(player, payload.mode)
			elseif payload.abilityId == "god_of_mischief" then
				setUltAttackMode(player, payload.mode)
			elseif payload.abilityId == "trickster_dash" then
				if payload.mode == "Dash" or payload.mode == "Teleport" then
					character:SetAttribute(GameConstants.LOKI_DASH_MODE_ATTRIBUTE, payload.mode)
				end
			end
		end
		return
	end

	if action == "Q" then
		fireDaggers(player, direction, aimPoint)
	elseif action == "E_down" then
		local entry = CharacterRegistry.getAbilityById("loki", "illusion_decoy")
		if
			entry
			and not AbilityCooldownHelper.isOnCooldown(character, entry.id)
			and not decoyByPlayer[player]
		then
			decoyArmed[player] = true
		end
	elseif action == "E_up" then
		decoyArmed[player] = false
	elseif action == "E_throw" then
		placeDecoy(player, aimPoint)
	elseif action == "E_update" then
		local state = decoyByPlayer[player]
		if state and aimPoint then
			state.aimPoint = aimPoint
		end
	elseif action == "F" then
		tricksterMove(player, moveVector, direction, aimPoint)
	elseif action == "F_confirm" then
		confirmTeleport(player, aimPoint)
	elseif action == "C" or action == "C_down" then
		startReflect(player)
	elseif action == "V" then
		startShapeshift(player, targetModel)
	elseif action == "X" then
		startGodOfMischief(player)
	end
end

function LokiService.init()
	Remotes.getEvent("UseAbility").OnServerEvent:Connect(function(player: Player, payload: any)
		LokiService.handleAction(player, payload)
	end)

	local function hookPlayer(player: Player)
		player.CharacterRemoving:Connect(function()
			LokiService.cancelAll(player)
		end)
		player.CharacterAdded:Connect(function(character)
			LokiService.cancelAll(player)
			local humanoid = character:WaitForChild("Humanoid", 5)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Died:Connect(function()
					LokiService.cancelAll(player)
				end)
			end
		end)
		if player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.Died:Connect(function()
					LokiService.cancelAll(player)
				end)
			end
		end
	end

	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end
	Players.PlayerAdded:Connect(hookPlayer)
	Players.PlayerRemoving:Connect(function(player)
		LokiService.cancelAll(player)
	end)
end

return LokiService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">MarvelGirlService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Marvel Girl / Jean Grey:
	Q Psionic Barrier
	E Psionic Bolt
	F Telekinetic Flight
	R Telekinesis (hold lift, click push)
	T Telekinetic Pull
	X Telekinetic Slam
	Z Telekinetic Debris (hold: summon + click throw)
	G Mind Link
	H Astral Projection (30s)
	C/B Telepathic Pain / Outburst while astral
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ContentProvider = game:GetService("ContentProvider")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)
local ConstraintHelper = require(ReplicatedStorage.Shared.ConstraintHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local ProjectileHelper = require(ReplicatedStorage.Shared.ProjectileHelper)
local PushHelper = require(ReplicatedStorage.Shared.PushHelper)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ScreenFeelHelper = require(ReplicatedStorage.Shared.ScreenFeelHelper)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)
local CharacterService = require(script.Parent.CharacterService)
local HexFlightService = require(script.Parent.HexFlightService)
local NameplateService = require(script.Parent.NameplateService)
local RagdollService = require(script.Parent.RagdollService)
local TelekinesisService = require(script.Parent.TelekinesisService)

local MarvelGirlService = {}

type BarrierState = {
	character: Model,
	hp: number,
	maxHp: number,
	forcefield: Instance,
	billboard: BillboardGui,
	hpLabel: TextLabel,
	hpFill: Frame,
	healthConn: RBXScriptConnection?,
	lastHealth: number,
	walk: number?,
	jumpPower: number?,
	jumpHeight: number?,
	animTrack: AnimationTrack?,
}

type AstralState = {
	character: Model,
	body: Model,
	astral: Model,
	root: BasePart,
	humanoid: Humanoid,
	mover: ConstraintHelper.MoverBundle,
	moveDir: Vector3,
	lookDir: Vector3,
	sideInput: number,
	currentVel: Vector3,
	startedAt: number,
	returning: boolean,
	healthConn: RBXScriptConnection?,
	fx: { Instance },
	outbursting: boolean,
	keepHighlightUntilNear: boolean,
	outburstHoldCf: CFrame?,
	loopSound: Sound?,
	bodyAnimTrack: AnimationTrack?,
}

type MindLinkState = {
	character: Model,
	members: { Model }, -- includes Jean
	startedAt: number,
	token: number,
	linkerIncluded: boolean,
	jeanFx: Instance?,
	jeanAtts: { Attachment },
	beamTemplates: { Beam },
	activeBeams: { Beam },
	targetFx: { Instance },
	healthConn: RBXScriptConnection?,
	lastHealth: number,
	spreading: boolean,
}

type SlamState = {
	character: Model,
	victim: Model,
	vRoot: BasePart,
	token: number,
	align: AlignPosition?,
	attach: Attachment?,
	fx: { Instance },
	ownedParts: { BasePart },
	throwDir: Vector3,
	slam2Host: BasePart?,
	faceConn: RBXScriptConnection?,
	faceAlign: AlignOrientation?,
	faceAtt: Attachment?,
	animTrack: AnimationTrack?,
}

type DebrisRock = {
	part: BasePart,
	visual: Instance,
	ready: boolean,
	rising: boolean,
	thrown: boolean,
	expiring: boolean,
	followOffset: Vector3,
	homeOffset: Vector3,
	liftY: number,
	rot: CFrame,
	baseTilt: CFrame,
	spinAxis: Vector3,
	spinSpeed: number,
	spinAngle: number,
	yawSpeed: number,
	yawAngle: number,
	bobSpeed: number,
	bobPhase: number,
	orbitRadius: number,
	orbitHeight: number,
	orbitAngle: number,
	orbitSpeed: number,
}

type DebrisState = {
	character: Model,
	token: number,
	remaining: number,
	rocks: { DebrisRock },
	aimPoint: Vector3?,
	followUntil: number,
	holding: boolean,
	lastThrowAt: number,
	liftAnimTrack: AnimationTrack?,
}

type PainState = {
	body: Model,
	victim: Model,
	fx: Instance?,
	sound: Sound?,
	tickAcc: number,
	animTrack: AnimationTrack?,
	victimAnimTrack: AnimationTrack?,
	startedAt: number,
}

local barrierByPlayer: { [Player]: BarrierState } = {}
local astralByPlayer: { [Player]: AstralState } = {}
local painByPlayer: { [Player]: PainState } = {}
local phoenixDownByPlayer: { [Player]: { character: Model, reviving: boolean? } } = {}
local phoenixAutoLoadBlocks = 0

local function blockPhoenixAutoRespawn()
	if phoenixAutoLoadBlocks == 0 then
		Players.CharacterAutoLoads = false
	end
	phoenixAutoLoadBlocks += 1
end

local function unblockPhoenixAutoRespawn()
	if phoenixAutoLoadBlocks <= 0 then
		return
	end
	phoenixAutoLoadBlocks -= 1
	if phoenixAutoLoadBlocks == 0 then
		Players.CharacterAutoLoads = true
	end
end

