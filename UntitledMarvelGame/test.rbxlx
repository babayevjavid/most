local remotes = RemoteSetup.create()
CharacterSelectService.setup(remotes)

print("[Server] Marvel Testing Place initialized")
]]></string>
      </Properties>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">AbilityService</string>
            <string name="Source"><![CDATA[--!strict



local ReplicatedStorage = game:GetService("ReplicatedStorage")



local AbilityDefinitions = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AbilityDefinitions"))

local HeroRegistry = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HeroRegistry"))



local InteractionService = require(script.Parent.InteractionService)

local PlayerStateService = require(script.Parent.PlayerStateService)

local ProjectileService = require(script.Parent.ProjectileService)

local BeamService = require(script.Parent.BeamService)
local FlightService = require(script.Parent.FlightService)
local ShieldService = require(script.Parent.ShieldService)

local TelekinesisService = require(script.Parent.TelekinesisService)
local WandaHandParticlesService = require(script.Parent.WandaHandParticlesService)

local MjolnirFactory = require(script.Parent.Parent.Util.MjolnirFactory)



local AbilityService = {}



export type AbilityCallbacks = {

	onCooldown: (player: Player, abilityId: string, duration: number) -> (),

	onStatUpdate: (player: Player) -> (),

}



local callbacks: AbilityCallbacks? = nil



local HOLD_ABILITIES = {

	Telekinesis = true,

	ChaosShield = true,

	ChaosBeam = true,

	ChaosLevitate = true,

}



function AbilityService.setup(cbs: AbilityCallbacks)

	callbacks = cbs

end



local function getRoot(character: Model): BasePart?

	return character:FindFirstChild("HumanoidRootPart") :: BasePart?

end



local function applyCooldown(player: Player, abilityId: string, duration: number)

	local endTime = os.clock() + duration

	PlayerStateService.setCooldown(player, abilityId, endTime)

	if callbacks then

		callbacks.onCooldown(player, abilityId, duration)

	end

end



local function executeAbility(player: Player, character: Model, abilityId: string, aimDirection: Vector3?, steerToken: string?)

	local root = getRoot(character)

	if not root then

		return

	end



	local direction = if aimDirection and aimDirection.Magnitude > 0 then aimDirection.Unit else root.CFrame.LookVector



	if abilityId == "ChaosBlast" then

		ProjectileService.fireChaosBlast(player, character, direction, steerToken)

	elseif abilityId == "ForcePush" or abilityId == "ThunderClap" then

		if abilityId == "ForcePush" then

			ProjectileService.executeForcePush(player, character)

		else

			InteractionService.pushCone(character, abilityId, 30, 45)

		end

	elseif abilityId == "CosmicPunch" then

		local target = InteractionService.getTargetFromRay(root.Position, direction, 20, { character })

		if target then

			InteractionService.pushTarget(target, direction, abilityId, player)

		end

	elseif abilityId == "MjolnirThrow" then

		MjolnirFactory.throwAndReturn(character, direction)

	elseif abilityId == "MjolnirStrike" or abilityId == "MjolnirFlight" or abilityId == "GodBlast" or abilityId == "LightningStrike" or abilityId == "StormCall" then

		MjolnirFactory.createWieldModel(character)

		if abilityId == "MjolnirFlight" then

			root.AssemblyLinearVelocity = direction * 80 + Vector3.new(0, 40, 0)

		end

	elseif abilityId == "CosmicDash" or abilityId == "ShadowStep" then

		root.AssemblyLinearVelocity = direction * 60 + Vector3.new(0, 35, 0)

	elseif abilityId == "OverwhelmingForce" then

		ProjectileService.executeForcePush(player, character)

		InteractionService.pushCone(character, "ForcePush", 40, 60)

	end

end



function AbilityService.useAbility(player: Player, abilityId: string, aimDirection: Vector3?, steerToken: string?)

	if HOLD_ABILITIES[abilityId] then

		return

	end



	local state = PlayerStateService.get(player)

	if not state.HeroId then

		return

	end

	if not HeroRegistry.heroOwnsAbility(state.HeroId, abilityId) then

		return

	end



	local def = AbilityDefinitions[abilityId]

	if not def then

		return

	end



	if PlayerStateService.isOnCooldown(player, abilityId) then

		return

	end



	local character = player.Character

	if not character then

		return

	end



	if def.EnergyCost > 0 and not PlayerStateService.spendEnergy(player, def.EnergyCost) then

		return

	end



	executeAbility(player, character, abilityId, aimDirection, steerToken)

	if state.HeroId == "Wanda" then
		WandaHandParticlesService.onInstantAbility(character)
	end

	applyCooldown(player, abilityId, def.Cooldown)



	if callbacks then

		callbacks.onStatUpdate(player)

	end

end



function AbilityService.cleanupPlayer(player: Player)

	TelekinesisService.cleanupPlayer(player)

	ShieldService.cleanupPlayer(player)

	BeamService.cleanupPlayer(player)

	FlightService.cleanupPlayer(player)

	WandaHandParticlesService.cleanupPlayer(player)

	local character = player.Character

	if character then

		MjolnirFactory.cleanup(character)

	end

end



return AbilityService

]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">BeamService</string>
            <string name="Source"><![CDATA[--!strict

--[[

	Wanda Chaos Beam — ported from NewMarvel Blue Marvel antimatter beam + Human Torch hold beam.

	Workspace EndBeam follower, dual-hand VFX, server raycast/extend/damage, flat yaw while grounded.

]]



local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RunService = game:GetService("RunService")



local AbilityConstants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AbilityConstants"))

local HeroRegistry = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HeroRegistry"))



local CombatService = require(script.Parent.CombatService)

local PlayerStateService = require(script.Parent.PlayerStateService)

local ShieldService = require(script.Parent.ShieldService)

local SprintService = require(script.Parent.SprintService)

local TelekinesisService = require(script.Parent.TelekinesisService)
local WandaHandParticlesService = require(script.Parent.WandaHandParticlesService)



local C = AbilityConstants



type BeamState = {

	active: boolean,

	handStartAtts: { Attachment },

	beams: { Beam },

	beamEndAtt: Attachment?,

	beamEndFollowerPart: BasePart?,

	beamEndAttLocalCFrame: CFrame?,

	animTrack: AnimationTrack?,

	jumpRestore: {

		jumpPower: number,

		jumpHeight: number?,

		autoJumpEnabled: boolean,

		jumpingEnabled: boolean,

	}?,

	beamAlign: AlignOrientation?,

	beamAttach: Attachment?,

	targetEndPos: Vector3?,

	startPos: Vector3?,

	channelStartTime: number?,

	lastDamageTime: number,

	heartbeatConn: RBXScriptConnection?,

	retractConn: RBXScriptConnection?,

}



local BeamService = {}



local stateByPlayer: { [Player]: BeamState } = {}

local onStatUpdate: ((player: Player) -> ())? = nil

local onCooldown: ((player: Player, abilityId: string, duration: number) -> ())? = nil



local function getState(plr: Player): BeamState

	if not stateByPlayer[plr] then

		stateByPlayer[plr] = {

			active = false,

			handStartAtts = {},

			beams = {},

			beamEndAtt = nil,

			beamEndFollowerPart = nil,

			beamEndAttLocalCFrame = nil,

			animTrack = nil,

			jumpRestore = nil,

			beamAlign = nil,

			beamAttach = nil,

			targetEndPos = nil,

			startPos = nil,

			channelStartTime = nil,

			lastDamageTime = 0,

			heartbeatConn = nil,

			retractConn = nil,

		}

	end

	return stateByPlayer[plr]

end



local function canUseBeam(plr: Player): boolean

	local state = PlayerStateService.get(plr)

	if not state.HeroId then

		return false

	end

	return HeroRegistry.heroOwnsAbility(state.HeroId, "ChaosBeam")

end



local function findBothHands(char: Model): { BasePart }

	local hands: { BasePart } = {}

	local right = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")

	local left = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")

	if right and right:IsA("BasePart") then

		table.insert(hands, right)

	end

	if left and left:IsA("BasePart") and left ~= right then

		table.insert(hands, left)

	end

	return hands

end



local function getHandsMedianPos(char: Model): Vector3?

	local hands = findBothHands(char)

	if #hands == 0 then

		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?

		return root and root.Position or nil

	end

	local sum = Vector3.zero

	for _, hand in hands do

		sum += hand.Position

	end

	return sum / #hands

end



local function getWandaAssets(): (Instance?, Instance?)

	local assets = ReplicatedStorage:FindFirstChild("Assets")

	if not assets then

		return nil, nil

	end

	local wanda = assets:FindFirstChild("WandaMaximoff")

	if not wanda then

		return nil, nil

	end

	return wanda:FindFirstChild("HandParticles"), wanda:FindFirstChild("EndBeam")

end



local function resolveHandAttachment(inst: Instance, handPart: BasePart): Attachment

	if inst:IsA("Attachment") then

		inst.Parent = handPart

		return inst

	end

	local existing = inst:FindFirstChildWhichIsA("Attachment", true)

	if existing then

		existing.Parent = handPart

		return existing

	end

	local att = Instance.new("Attachment")

	att.Name = "HandParticles"

	att.Parent = handPart

	return att

end



local function getRaycastParams(char: Model): RaycastParams

	local params = RaycastParams.new()

	params.FilterType = Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = { char }

	params.IgnoreWater = true

	return params

end



local function getOverlapParams(char: Model): OverlapParams

	local params = OverlapParams.new()

	params.FilterType = Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = { char }

	return params

end



local function wireBeams(handRoot: Instance, handAtt: Attachment, endAtt: Attachment): { Beam }

	local beams: { Beam } = {}

	local function tryWire(beam: Beam)

		beam.Attachment0 = handAtt

		beam.Attachment1 = endAtt

		beam.Enabled = true

		table.insert(beams, beam)

	end

	for _, desc in handRoot:GetDescendants() do

		if desc:IsA("Beam") then

			tryWire(desc)

		end

	end

	for _, child in handRoot:GetChildren() do

		if child:IsA("Beam") then

			tryWire(child)

		end

	end

	return beams

end



local function createEndFollower(endTpl: Instance, initialPos: Vector3): (BasePart, Attachment, CFrame)

	local follower = Instance.new("Part")

	follower.Name = "ChaosBeamEndFollowerPart"

	follower.Size = Vector3.new(0.2, 0.2, 0.2)

	follower.Anchored = true

	follower.CanCollide = false

	follower.CanTouch = false

	follower.CanQuery = false

	follower.Transparency = 1

	follower.Parent = workspace



	local endAtt: Attachment

	local localCf: CFrame

	if endTpl:IsA("Attachment") then

		endAtt = endTpl:Clone() :: Attachment

		endAtt.Name = "EndBeam"

		endAtt.Parent = follower

		localCf = endAtt.CFrame

	elseif endTpl:IsA("BasePart") then

		local clone = endTpl:Clone() :: BasePart

		clone.Anchored = false

		clone.CanCollide = false

		clone.CanTouch = false

		clone.CanQuery = false

		clone.Parent = follower

		local found = clone:FindFirstChildWhichIsA("Attachment")

		if found then

			endAtt = found

			localCf = endAtt.CFrame

		else

			endAtt = Instance.new("Attachment")

			endAtt.Name = "EndBeam"

			endAtt.Parent = follower

			localCf = endAtt.CFrame

		end

	else

		local clone = endTpl:Clone()

		clone.Parent = follower

		local found = clone:FindFirstChildWhichIsA("Attachment", true)

		if found then

			endAtt = found

			endAtt.Parent = follower

			localCf = endAtt.CFrame

		else

			endAtt = Instance.new("Attachment")

			endAtt.Name = "EndBeam"

			endAtt.Parent = follower

			localCf = endAtt.CFrame

		end

	end



	follower.CFrame = CFrame.new(initialPos) * localCf:Inverse()

	return follower, endAtt, localCf

end



local function moveFollowerToWorldPos(st: BeamState, worldPos: Vector3)

	if not st.beamEndFollowerPart or not st.beamEndAttLocalCFrame then

		return

	end

	st.beamEndFollowerPart.CFrame = CFrame.new(worldPos) * st.beamEndAttLocalCFrame:Inverse()

end



local function updateBeamFacing(char: Model, root: BasePart, tipPos: Vector3, st: BeamState)

	local flat = Vector3.new(tipPos.X - root.Position.X, 0, tipPos.Z - root.Position.Z)

	if flat.Magnitude < 0.01 then

		return

	end

	local unit = flat.Unit

	char:SetAttribute("ChaosBeamLookX", unit.X)

	char:SetAttribute("ChaosBeamLookZ", unit.Z)



	if char:GetAttribute("NewFlightActive") == true then

		return

	end

	if not st.beamAlign or not st.beamAlign.Parent then

		return

	end

	st.beamAlign.CFrame = CFrame.lookAt(Vector3.zero, unit, Vector3.yAxis)

end



local function computeEndPos(

	char: Model,

	root: BasePart,

	startPos: Vector3,

	targetPos: Vector3,

	channelStartTime: number?

): Vector3

	local toTarget = targetPos - startPos

	local dist = toTarget.Magnitude

	local clampedDist = math.min(dist, C.CHAOS_BEAM_RANGE)

	local endPos: Vector3

	if dist > 0.0001 then

		local rayDir = toTarget.Unit * clampedDist

		local hit = workspace:Raycast(startPos, rayDir, getRaycastParams(char))

		endPos = if hit then hit.Position else (startPos + rayDir)

	else

		endPos = startPos

	end



	local fromRoot = endPos - root.Position

	if fromRoot.Magnitude > C.CHAOS_BEAM_RANGE then

		endPos = root.Position + fromRoot.Unit * C.CHAOS_BEAM_RANGE

	end



	local elapsed = if channelStartTime then (os.clock() - channelStartTime) else 0

	local extendSpeed = C.CHAOS_BEAM_RANGE / math.max(0.0001, C.CHAOS_BEAM_MAX_EXTEND_TIME)

	local maxReach = math.min(C.CHAOS_BEAM_RANGE, extendSpeed * math.min(elapsed, C.CHAOS_BEAM_MAX_EXTEND_TIME))

	local fromStart = endPos - startPos

	local idealLen = fromStart.Magnitude

	if idealLen > 0.05 then

		local allowedLen = math.min(idealLen, math.max(maxReach, 1))

		endPos = startPos + fromStart.Unit * allowedLen

	end



	local fromRootFinal = endPos - root.Position

	if fromRootFinal.Magnitude > C.CHAOS_BEAM_RANGE then

		endPos = root.Position + fromRootFinal.Unit * C.CHAOS_BEAM_RANGE

	end



	return endPos

end



local function destroyBeamInstances(st: BeamState)

	for _, beam in st.beams do

		beam.Enabled = false

	end

	st.beams = {}



	st.handStartAtts = {}



	if st.beamEndAtt and st.beamEndAtt.Parent then

		st.beamEndAtt:Destroy()

	end

	st.beamEndAtt = nil



	if st.beamEndFollowerPart and st.beamEndFollowerPart.Parent then

		st.beamEndFollowerPart:Destroy()

	end

	st.beamEndFollowerPart = nil

	st.beamEndAttLocalCFrame = nil

end



local function destroyBeamFacing(st: BeamState)

	if st.beamAlign and st.beamAlign.Parent then

		st.beamAlign:Destroy()

	end

	if st.beamAttach and st.beamAttach.Parent then

		st.beamAttach:Destroy()

	end

	st.beamAlign = nil

	st.beamAttach = nil

end



local function damageAtBeamEnd(plr: Player, char: Model, tipPos: Vector3)

	local heroId = PlayerStateService.get(plr).HeroId

	local overlap = getOverlapParams(char)

	local parts = workspace:GetPartBoundsInBox(CFrame.new(tipPos), C.CHAOS_BEAM_DAMAGE_BOX, overlap)

	local hitModels: { [Model]: boolean } = {}



	for _, part in parts do

		local model = part:FindFirstAncestorOfClass("Model")

		if not model or model == char or hitModels[model] then

			continue

		end

		hitModels[model] = true

		local humanoid = model:FindFirstChildOfClass("Humanoid")

		if humanoid and humanoid.Health > 0 then

			local damage = CombatService.computeDamage(plr, heroId, C.CHAOS_BEAM_DAMAGE)

			humanoid:TakeDamage(damage)

		end

	end

end



local function finishStop(plr: Player, applyCooldown: boolean)

	local st = getState(plr)

	if not st.active and #st.handStartAtts == 0 then

		return

	end



	st.active = false

	st.targetEndPos = nil

	st.startPos = nil

	st.channelStartTime = nil



	if st.heartbeatConn then

		st.heartbeatConn:Disconnect()

		st.heartbeatConn = nil

	end

	if st.retractConn then

		st.retractConn:Disconnect()

		st.retractConn = nil

	end



	if st.animTrack then

		pcall(function()

			st.animTrack:Stop()

		end)

		st.animTrack = nil

	end



	destroyBeamInstances(st)

	destroyBeamFacing(st)



	local char = plr.Character

	if char then

		WandaHandParticlesService.disable(char)

		char:SetAttribute("IsChaosBeamActive", nil)

		char:SetAttribute("ChaosBeamLookX", nil)

		char:SetAttribute("ChaosBeamLookZ", nil)

		local humanoid = char:FindFirstChildOfClass("Humanoid")

		if humanoid and st.jumpRestore then

			humanoid.JumpPower = st.jumpRestore.jumpPower

			if st.jumpRestore.jumpHeight ~= nil then

				humanoid.JumpHeight = st.jumpRestore.jumpHeight

			end

			humanoid.AutoJumpEnabled = st.jumpRestore.autoJumpEnabled

			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, st.jumpRestore.jumpingEnabled)

		end

	end

	st.jumpRestore = nil



	if applyCooldown then

		PlayerStateService.setCooldown(plr, "ChaosBeam", os.clock() + C.CHAOS_BEAM_COOLDOWN)

		if onCooldown then

			onCooldown(plr, "ChaosBeam", C.CHAOS_BEAM_COOLDOWN)

		end

	end



	if onStatUpdate then

		onStatUpdate(plr)

	end

end



local function stopBeam(plr: Player, applyCooldown: boolean)

	local st = getState(plr)

	if not st.active then

		finishStop(plr, applyCooldown)

		return

	end



	st.active = false

	if st.heartbeatConn then

		st.heartbeatConn:Disconnect()

		st.heartbeatConn = nil

	end



	local startAtt = st.handStartAtts[1]

	local follower = st.beamEndFollowerPart

	local endAtt = st.beamEndAtt

	local localCf = st.beamEndAttLocalCFrame



	if not startAtt or not startAtt.Parent or not follower or not follower.Parent or not endAtt or not localCf then

		finishStop(plr, applyCooldown)

		return

	end



	if st.retractConn then

		st.retractConn:Disconnect()

	end



	local retractAcc = 0

	st.retractConn = RunService.Heartbeat:Connect(function(dt: number)

		retractAcc += dt

		if not startAtt.Parent or not follower.Parent or not endAtt.Parent then

			if st.retractConn then

				st.retractConn:Disconnect()

				st.retractConn = nil

			end

			finishStop(plr, applyCooldown)

			return

		end



		local startP = startAtt.WorldPosition

		local endP = endAtt.WorldPosition

		local offset = startP - endP

		local dist = offset.Magnitude

		if dist < 0.35 or retractAcc > 2.5 then

			follower.CFrame = CFrame.new(startP) * localCf:Inverse()

			if st.retractConn then

				st.retractConn:Disconnect()

				st.retractConn = nil

			end

			finishStop(plr, applyCooldown)

			return

		end



		local move = math.min(dist, dist * math.clamp(dt * 10, 0.08, 1))

		local newEnd = endP + offset.Unit * move

		follower.CFrame = CFrame.new(newEnd) * localCf:Inverse()

	end)

end



local function applyLookUpdate(plr: Player, targetPos: Vector3)

	local st = getState(plr)

	if not st.active or not st.beamEndFollowerPart or not st.beamEndAttLocalCFrame then

		return

	end



	local char = plr.Character

	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?

	if not char or not root then

		return

	end



	local startPos = getHandsMedianPos(char)

	if not startPos then

		return

	end

	st.startPos = startPos



	local endPos = computeEndPos(char, root, startPos, targetPos, st.channelStartTime)

	st.targetEndPos = endPos

	moveFollowerToWorldPos(st, endPos)

	updateBeamFacing(char, root, endPos, st)

end



local function startBeamHeartbeat(plr: Player)

	local st = getState(plr)

	if st.heartbeatConn then

		st.heartbeatConn:Disconnect()

	end



	st.heartbeatConn = RunService.Heartbeat:Connect(function(dt: number)

		if not st.active then

			return

		end



		local char = plr.Character

		if not char or not char.Parent then

			stopBeam(plr, false)

			return

		end



		local humanoid = char:FindFirstChildOfClass("Humanoid")

		if humanoid and humanoid.Health <= 0 then

			stopBeam(plr, false)

			return

		end



		local playerState = PlayerStateService.get(plr)

		playerState.Energy = math.max(0, playerState.Energy - C.CHAOS_BEAM_ENERGY_PER_SEC * dt)

		PlayerStateService.markResourceUsed(plr)

		if playerState.Energy <= 0 then

			stopBeam(plr, true)

			return

		end



		local tipPos = st.targetEndPos

		if tipPos then

			local now = os.clock()

			if now - st.lastDamageTime >= C.CHAOS_BEAM_DAMAGE_INTERVAL then

				st.lastDamageTime = now

				damageAtBeamEnd(plr, char, tipPos)

			end

		end



		if onStatUpdate then

			onStatUpdate(plr)

		end

	end)

end



local function playBeamAnimation(char: Model): AnimationTrack?

	local humanoid = char:FindFirstChildOfClass("Humanoid")

	if not humanoid then

		return nil

	end

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then

		animator = Instance.new("Animator")

		animator.Parent = humanoid

	end

	local anim = Instance.new("Animation")

	anim.AnimationId = C.CHAOS_BEAM_ANIMATION_ID

	local track = humanoid:LoadAnimation(anim)

	track.Looped = true

	track:Play()

	return track

end



local function turnOn(plr: Player): boolean

	if not canUseBeam(plr) then

		return false

	end

	if PlayerStateService.isOnCooldown(plr, "ChaosBeam") then

		return false

	end



	local char = plr.Character

	if not char or not char.Parent then

		return false

	end

	local humanoid = char:FindFirstChildOfClass("Humanoid")

	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?

	if not humanoid or not root or humanoid.Health <= 0 then

		return false

	end



	local playerState = PlayerStateService.get(plr)

	if playerState.Energy <= 0 then

		return false

	end



	local st = getState(plr)

	if st.active then

		return true

	end



	TelekinesisService.cleanupPlayer(plr)

	ShieldService.turnOff(plr)

	SprintService.forceStopSprint(plr)



	local _, endTpl = getWandaAssets()

	if not endTpl then

		warn("[BeamService] Missing Assets.WandaMaximoff.EndBeam")

		return false

	end



	local hands = findBothHands(char)

	if #hands == 0 then

		return false

	end



	WandaHandParticlesService.ensure(char)

	WandaHandParticlesService.enable(char)

	WandaHandParticlesService.emit(char)



	local startPos = getHandsMedianPos(char) or root.Position

	local lookDir = root.CFrame.LookVector

	local initialEnd = computeEndPos(char, root, startPos, startPos + lookDir * C.CHAOS_BEAM_RANGE, os.clock())



	local follower, endAtt, localCf = createEndFollower(endTpl, initialEnd)

	follower.CFrame = CFrame.new(initialEnd) * localCf:Inverse()



	local handStartAtts: { Attachment } = {}

	local allBeams: { Beam } = {}



	for _, handPart in hands do

		local handAtt = WandaHandParticlesService.getHandAttachment(handPart)

		if not handAtt then

			continue

		end

		table.insert(handStartAtts, handAtt)

		local handRoot = handPart:FindFirstChild("HandParticles") or handPart

		for _, beam in wireBeams(handRoot, handAtt, endAtt) do

			table.insert(allBeams, beam)

		end

	end



	if #handStartAtts == 0 then

		WandaHandParticlesService.disable(char)

		follower:Destroy()

		return false

	end



	st.active = true

	st.handStartAtts = handStartAtts

	st.beams = allBeams

	st.beamEndAtt = endAtt

	st.beamEndFollowerPart = follower

	st.beamEndAttLocalCFrame = localCf

	st.startPos = startPos

	st.targetEndPos = initialEnd

	st.channelStartTime = os.clock()

	st.lastDamageTime = 0

	st.animTrack = playBeamAnimation(char)



	st.jumpRestore = {

		jumpPower = humanoid.JumpPower,

		jumpHeight = humanoid.JumpHeight,

		autoJumpEnabled = humanoid.AutoJumpEnabled,

		jumpingEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping),

	}

	humanoid.JumpPower = 0

	humanoid.JumpHeight = 0

	humanoid.AutoJumpEnabled = false

	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)



	if char:GetAttribute("NewFlightActive") ~= true then

		local att = Instance.new("Attachment")

		att.Name = "ChaosBeamRotateAttachment"

		att.Parent = root

		local align = Instance.new("AlignOrientation")

		align.Name = "ChaosBeamRotateAlign"

		align.Mode = Enum.OrientationAlignmentMode.OneAttachment

		align.Attachment0 = att

		align.RigidityEnabled = false

		align.MaxTorque = math.huge

		align.Responsiveness = C.ROTATE_ALIGN_RESPONSIVENESS

		align.Parent = root

		st.beamAttach = att

		st.beamAlign = align

	end



	char:SetAttribute("IsChaosBeamActive", true)

	updateBeamFacing(char, root, initialEnd, st)



	humanoid.Died:Once(function()

		stopBeam(plr, false)

	end)



	startBeamHeartbeat(plr)

	return true

end



function BeamService.setup(

	chaosBeamSetActive: RemoteEvent,

	chaosBeamLookUpdate: RemoteEvent,

	statUpdateCallback: (player: Player) -> (),

	cooldownCallback: (player: Player, abilityId: string, duration: number) -> ()

)

	onStatUpdate = statUpdateCallback

	onCooldown = cooldownCallback



	chaosBeamSetActive.OnServerEvent:Connect(function(plr: Player, holding: boolean)

		if typeof(holding) ~= "boolean" then

			return

		end

		if holding then

			turnOn(plr)

		elseif getState(plr).active then

			stopBeam(plr, true)

		end

	end)



	chaosBeamLookUpdate.OnServerEvent:Connect(function(plr: Player, targetX: number, targetY: number, targetZ: number)

		if typeof(targetX) ~= "number" or typeof(targetY) ~= "number" or typeof(targetZ) ~= "number" then

			return

		end

		applyLookUpdate(plr, Vector3.new(targetX, targetY, targetZ))

	end)

end



function BeamService.cleanupPlayer(player: Player)

	stopBeam(player, false)

	stateByPlayer[player] = nil

end



return BeamService

]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">CharacterSelectService</string>
            <string name="Source"><![CDATA[--!strict



local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")



local HUDTheme = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HUDTheme"))

local HeroRegistry = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HeroRegistry"))



local AbilityService = require(script.Parent.AbilityService)

local OverheadService = require(script.Parent.OverheadService)

local PlayerStateService = require(script.Parent.PlayerStateService)

local FlightService = require(script.Parent.FlightService)
local BeamService = require(script.Parent.BeamService)
local ProjectileFlight = require(script.Parent.ProjectileFlight)

local RemoteSetup = require(script.Parent.RemoteSetup)

local ShieldService = require(script.Parent.ShieldService)

local SpawnService = require(script.Parent.SpawnService)

local SprintService = require(script.Parent.SprintService)

local TelekinesisService = require(script.Parent.TelekinesisService)



local CharacterSelectService = {}



local remotes: RemoteSetup.RemoteFolder? = nil



local function fireStatUpdate(player: Player)

	if not remotes then

		return

	end

	remotes.StatUpdate:FireClient(player, PlayerStateService.getStatPayload(player))

end



local function fireCooldown(player: Player, abilityId: string, duration: number)

	if not remotes then

		return

	end

	remotes.CooldownUpdate:FireClient(player, abilityId, duration)

end



local function applyPlayerOverhead(player: Player, heroId: string)

	local character = player.Character

	if not character then

		return

	end

	local heroDef = HeroRegistry[heroId]

	if not heroDef then

		return

	end

	local accent = HUDTheme.HeroAccents[heroId]

	OverheadService.setPlayerHero(character, player, heroDef.DisplayName, accent)

end



local function requireReselect(player: Player)

	PlayerStateService.clearHero(player)

	AbilityService.cleanupPlayer(player)

	SprintService.setSprinting(player, false)

	if remotes then

		remotes.RequireReselect:FireClient(player)

	end

end



local function confirmHero(player: Player, heroId: string)

	local layout = HeroRegistry.getAbilityLayout(heroId)

	if not layout then

		return

	end

	PlayerStateService.setHero(player, heroId)

	SprintService.applyWalkSpeed(player)

	applyPlayerOverhead(player, heroId)

	if remotes then

		remotes.HeroConfirmed:FireClient(player, heroId, layout)

		fireStatUpdate(player)

	end

end



local function bindCharacter(player: Player, character: Model)

	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?

	if not humanoid then

		return

	end



	OverheadService.attachPlayer(character, player)



	local state = PlayerStateService.get(player)

	if state.HeroId then

		applyPlayerOverhead(player, state.HeroId)

		SprintService.applyWalkSpeed(player)

	end



	humanoid.Died:Connect(function()

		PlayerStateService.clearHero(player)

		AbilityService.cleanupPlayer(player)

		SprintService.setSprinting(player, false)

		OverheadService.hidePlayerPlate(character)

	end)



	humanoid.HealthChanged:Connect(function()

		PlayerStateService.syncFromCharacter(player)

		fireStatUpdate(player)

	end)

end



local function onPlayerAdded(player: Player)

	PlayerStateService.initPlayer(player)



	player.CharacterAdded:Connect(function(character)

		bindCharacter(player, character)

		SpawnService.teleportCharacter(character)



		local state = PlayerStateService.get(player)

		if not state.HeroId then

			requireReselect(player)

		else

			fireStatUpdate(player)

		end

	end)



	if player.Character then

		bindCharacter(player, player.Character)

	end

end



function CharacterSelectService.setup(remoteFolder: RemoteSetup.RemoteFolder)

	remotes = remoteFolder



	AbilityService.setup({

		onCooldown = fireCooldown,

		onStatUpdate = fireStatUpdate,

	})



	TelekinesisService.setup(

		remoteFolder.TelekinesisRequest,

		remoteFolder.TelekinesisUpdate,

		remoteFolder.TelekinesisThrow,

		remoteFolder.TelekinesisEnd,

		fireStatUpdate,

		fireCooldown

	)

	TelekinesisService.startUpdateLoop()



	ShieldService.setup(remoteFolder.ShieldSetActive, fireStatUpdate, fireCooldown)

	BeamService.setup(remoteFolder.ChaosBeamSetActive, remoteFolder.ChaosBeamLookUpdate, fireStatUpdate, fireCooldown)

	FlightService.setup(remoteFolder.FlightToggle, remoteFolder.FlightInput, fireStatUpdate, fireCooldown)
	FlightService.startUpdateLoop()

	ProjectileFlight.setupSteerRemote(remoteFolder.ProjectileSteerUpdate)



	SprintService.setup(fireStatUpdate)

	SprintService.startLoop()

	OverheadService.init()

	SpawnService.init()



	remoteFolder.SelectHero.OnServerEvent:Connect(function(player: Player, heroId: string)

		if typeof(heroId) ~= "string" then

			return

		end

		if not HeroRegistry[heroId] then

			return

		end

		confirmHero(player, heroId)

	end)



	remoteFolder.UseAbility.OnServerEvent:Connect(function(

		player: Player,

		abilityId: string,

		aimX: number?,

		aimY: number?,

		aimZ: number?,

		steerToken: string?

	)

		if typeof(abilityId) ~= "string" then

			return

		end

		local aimDirection: Vector3? = nil

		if typeof(aimX) == "number" and typeof(aimY) == "number" and typeof(aimZ) == "number" then

			aimDirection = Vector3.new(aimX, aimY, aimZ)

		end

		local token: string? = if type(steerToken) == "string" and #steerToken > 0 then steerToken else nil

		AbilityService.useAbility(player, abilityId, aimDirection, token)

	end)



	remoteFolder.SetSprinting.OnServerEvent:Connect(function(player: Player, isSprinting: boolean)

		if typeof(isSprinting) ~= "boolean" then

			return

		end

		SprintService.setSprinting(player, isSprinting)

	end)



	for _, player in Players:GetPlayers() do

		onPlayerAdded(player)

	end

	Players.PlayerAdded:Connect(onPlayerAdded)

	Players.PlayerRemoving:Connect(function(player)

		AbilityService.cleanupPlayer(player)

		SprintService.clearPlayer(player)

		PlayerStateService.removePlayer(player)

	end)



	PlayerStateService.startRegenLoop(fireStatUpdate)

end



return CharacterSelectService

]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))

local CombatService = {}

function CombatService.getDamageMultiplier(player: Player, heroId: string?): number
	if heroId ~= "Wanda" then
		return 1
	end

	local character = player.Character
	if not character then
		return 1
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.MaxHealth <= 0 then
		return 1
	end

	local hpRatio = humanoid.Health / humanoid.MaxHealth
	if hpRatio <= Constants.UNDONE_GRIEF_HP_THRESHOLD then
		return Constants.UNDONE_GRIEF_DAMAGE_MULTIPLIER
	end
	return 1
end

function CombatService.applyDamage(attacker: Player, targetHumanoid: Humanoid, baseDamage: number, heroId: string?)
	local damage = CombatService.computeDamage(attacker, heroId, baseDamage)
	targetHumanoid:TakeDamage(damage)
end

function CombatService.computeDamage(attacker: Player, heroId: string?, baseDamage: number): number
	return baseDamage * CombatService.getDamageMultiplier(attacker, heroId)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">FlightService</string>
            <string name="Source"><![CDATA[--!strict

--[[

	Wanda flight — ported from NewMarvelProject NewFlightService (Scarlet Witch).

	LinearVelocity + gravity cancel + idle/move animation blend. NewMarvel pitch/bank with reduced forward tilt.

]]



local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RunService = game:GetService("RunService")



local AbilityConstants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AbilityConstants"))

local HeroRegistry = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HeroRegistry"))



local PlayerStateService = require(script.Parent.PlayerStateService)

local ShieldService = require(script.Parent.ShieldService)

local SprintService = require(script.Parent.SprintService)

local TelekinesisService = require(script.Parent.TelekinesisService)
local WandaHandParticlesService = require(script.Parent.WandaHandParticlesService)



local C = AbilityConstants



local NEAR_ZERO_VEL = Vector3.new(0.001, 0.001, 0.001)

local function GetRotate(direction: Vector3, velocityUnit: Vector3): number
	if direction.Magnitude < 0.01 or velocityUnit.Magnitude < 0.01 then
		return 0
	end
	local rootPos = Vector3.zero
	local lookVec = (CFrame.new(rootPos, rootPos + direction) * CFrame.Angles(0, math.rad(90), 0)).LookVector
	local dot = lookVec:Dot(velocityUnit)
	local len = lookVec.Magnitude * velocityUnit.Magnitude
	if len < 0.0001 then
		return 0
	end
	local deg = 90 - math.deg(math.acos(math.clamp(dot / len, -1, 1)))
	return math.clamp(deg, -90, 90)
end



type FlightState = {

	character: Model?,

	moveDir: Vector3,

	lookDir: Vector3,

	lastInputTime: number,

	linearVel: LinearVelocity?,

	linearVelAtt: Attachment?,

	gravityCancel: VectorForce?,

	gravCancelAtt: Attachment?,

	align: AlignOrientation?,

	att: Attachment?,

	tracks: { idle: AnimationTrack, move: AnimationTrack },

	originalWalkSpeed: number?,

	originalJumpPower: number?,

	originalJumpHeight: number?,

}



local FlightService = {}



local stateByPlayer: { [Player]: FlightState } = {}

local lastFlightToggleTime: { [Player]: number } = {}

local onStatUpdate: ((player: Player) -> ())? = nil

local onCooldown: ((player: Player, abilityId: string, duration: number) -> ())? = nil

local updateConn: RBXScriptConnection? = nil



local function canUseFlight(plr: Player): boolean

	local state = PlayerStateService.get(plr)

	if not state.HeroId then

		return false

	end

	return HeroRegistry.heroOwnsAbility(state.HeroId, "ChaosLevitate")

end



local function setWandaFlightTrailsEnabled(char: Model, enabled: boolean)

	for _, desc in char:GetDescendants() do

		if desc.Name == "HandTrail" then

			local trail = desc:FindFirstChild("Trail")

			if trail and trail:IsA("Trail") then

				trail.Enabled = enabled

			else

				local att = desc:FindFirstChild("Attachment")

				if att then

					local nested = att:FindFirstChild("Trail")

					if nested and nested:IsA("Trail") then

						nested.Enabled = enabled

					end

				end

			end

		end

	end

end



local function endFlight(plr: Player, applyCooldown: boolean)

	local s = stateByPlayer[plr]

	stateByPlayer[plr] = nil



	local char = plr.Character

	if char and char.Parent then

		char:SetAttribute("FlightAlphaSpeed", nil)

		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?

		if root and root.AssemblyLinearVelocity.Magnitude > 0 then

			local vel = root.AssemblyLinearVelocity

			vel = Vector3.new(vel.X * 0.92, vel.Y, vel.Z * 0.92)

			if vel.Y < -C.FLIGHT_MAX_LANDING_VERTICAL_SPEED then

				vel = Vector3.new(vel.X, -C.FLIGHT_MAX_LANDING_VERTICAL_SPEED, vel.Z)

			end

			root.AssemblyLinearVelocity = vel

		end

		char:SetAttribute("IsLevitating", nil)

		char:SetAttribute("NewFlightActive", nil)

		char:SetAttribute("FlightMoving", nil)

		char:SetAttribute("FlightInputActive", nil)



		local humanoid = char:FindFirstChildOfClass("Humanoid")

		if humanoid then

			humanoid.PlatformStand = false

			if s and s.originalWalkSpeed then

				humanoid.WalkSpeed = s.originalWalkSpeed

			end

			if s and s.originalJumpPower then

				humanoid.JumpPower = s.originalJumpPower

			end

			if s and s.originalJumpHeight then

				humanoid.JumpHeight = s.originalJumpHeight

			end

		end



		setWandaFlightTrailsEnabled(char, false)
		WandaHandParticlesService.disable(char)



		if applyCooldown then

			PlayerStateService.setCooldown(plr, "ChaosLevitate", os.clock() + C.FLIGHT_COOLDOWN)

			if onCooldown then

				onCooldown(plr, "ChaosLevitate", C.FLIGHT_COOLDOWN)

			end

		end

	end



	if s then

		if s.linearVel and s.linearVel.Parent then

			s.linearVel:Destroy()

		end

		if s.linearVelAtt and s.linearVelAtt.Parent then

			s.linearVelAtt:Destroy()

		end

		if s.gravityCancel and s.gravityCancel.Parent then

			s.gravityCancel:Destroy()

		end

		if s.gravCancelAtt and s.gravCancelAtt.Parent then

			s.gravCancelAtt:Destroy()

		end

		if s.align and s.align.Parent then

			s.align:Destroy()

		end

		if s.att and s.att.Parent then

			s.att:Destroy()

		end

		for _, track in { s.tracks.idle, s.tracks.move } do

			if track.IsPlaying then

				track:Stop()

			end

		end

	end



	if onStatUpdate then

		onStatUpdate(plr)

	end

end



local function startFlight(plr: Player, char: Model, humanoid: Humanoid, root: BasePart)

	char:SetAttribute("IsLevitating", true)

	char:SetAttribute("NewFlightActive", true)

	char:SetAttribute("FlightMoving", nil)

	char:SetAttribute("FlightInputActive", nil)

	humanoid.PlatformStand = true



	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then

		animator = Instance.new("Animator")

		animator.Parent = humanoid

	end



	local function loadAnim(id: string): AnimationTrack

		local anim = Instance.new("Animation")

		anim.AnimationId = id

		return humanoid:LoadAnimation(anim)

	end



	local tracks = {

		idle = loadAnim(C.FLIGHT_IDLE_ANIMATION_ID),

		move = loadAnim(C.FLIGHT_MOVE_ANIMATION_ID),

	}



	local att = Instance.new("Attachment")

	att.Name = "NewFlightAlignAtt"

	att.Parent = root

	local align = Instance.new("AlignOrientation")

	align.Mode = Enum.OrientationAlignmentMode.OneAttachment

	align.Attachment0 = att

	align.MaxTorque = math.huge

	align.Responsiveness = C.FLIGHT_ALIGN_RESPONSIVENESS

	align.Parent = root



	local linearVelAtt = Instance.new("Attachment")

	linearVelAtt.Name = "NewFlightLinearVelAtt"

	linearVelAtt.Parent = root

	local linearVel = Instance.new("LinearVelocity")

	linearVel.Name = "NewFlightLinearVel"

	linearVel.Attachment0 = linearVelAtt

	linearVel.RelativeTo = Enum.ActuatorRelativeTo.World

	linearVel.MaxForce = math.huge

	linearVel.VectorVelocity = Vector3.zero

	linearVel.Parent = root



	local gravCancelAtt = Instance.new("Attachment")

	gravCancelAtt.Name = "NewFlightGravCancelAtt"

	gravCancelAtt.Parent = root

	local gravityCancel = Instance.new("VectorForce")

	gravityCancel.Name = "NewFlightGravityCancel"

	gravityCancel.RelativeTo = Enum.ActuatorRelativeTo.World

	gravityCancel.Attachment0 = gravCancelAtt

	gravityCancel.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0)

	gravityCancel.Parent = root



	align.Enabled = true

	align.CFrame = root.CFrame



	local look = root.CFrame.LookVector

	if look.Magnitude < 0.01 then

		look = Vector3.new(0, 0, -1)

	else

		look = look.Unit

	end



	setWandaFlightTrailsEnabled(char, true)
	WandaHandParticlesService.enable(char)
	WandaHandParticlesService.emit(char)



	stateByPlayer[plr] = {

		character = char,

		moveDir = Vector3.zero,

		lookDir = look,

		lastInputTime = os.clock(),

		linearVel = linearVel,

		linearVelAtt = linearVelAtt,

		gravityCancel = gravityCancel,

		gravCancelAtt = gravCancelAtt,

		align = align,

		att = att,

		tracks = tracks,

		originalWalkSpeed = humanoid.WalkSpeed,

		originalJumpPower = humanoid.JumpPower,

		originalJumpHeight = humanoid.JumpHeight,

	}



	humanoid.WalkSpeed = 0

	humanoid.JumpPower = 0

	if humanoid.JumpHeight then

		humanoid.JumpHeight = 0

	end



	tracks.idle:Play(0.3, 1, 1)



	humanoid.Died:Once(function()

		endFlight(plr, false)

	end)

end



local function toggleFlight(plr: Player)

	if not canUseFlight(plr) then

		return

	end



	local char = plr.Character

	if not char then

		return

	end



	local now = os.clock()

	local lastToggle = lastFlightToggleTime[plr]

	if lastToggle and (now - lastToggle) < C.FLIGHT_TOGGLE_COOLDOWN then

		return

	end

	lastFlightToggleTime[plr] = now



	if char:GetAttribute("NewFlightActive") == true then

		endFlight(plr, true)

		return

	end



	if PlayerStateService.isOnCooldown(plr, "ChaosLevitate") then

		return

	end

	if char:GetAttribute("IsShieldActive") == true then

		return

	end

	if TelekinesisService.isActive(plr) then

		return

	end

	local humanoid = char:FindFirstChildOfClass("Humanoid")

	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?

	if not humanoid or not root or humanoid.Health <= 0 then

		return

	end



	local playerState = PlayerStateService.get(plr)

	if playerState.Energy <= 0 then

		return

	end



	SprintService.forceStopSprint(plr)

	ShieldService.turnOff(plr)

	startFlight(plr, char, humanoid, root)



	if onStatUpdate then

		onStatUpdate(plr)

	end

end



local function onInput(plr: Player, moveX: number, moveY: number, moveZ: number, lookX: number, lookY: number, lookZ: number)

	local s = stateByPlayer[plr]

	if not s then

		return

	end



	local moveDir = Vector3.new(

		type(moveX) == "number" and moveX or 0,

		type(moveY) == "number" and moveY or 0,

		type(moveZ) == "number" and moveZ or 0

	)

	if moveDir.Magnitude > 1 then

		moveDir = moveDir.Unit

	end



	local lookDir = Vector3.new(

		type(lookX) == "number" and lookX or 0,

		type(lookY) == "number" and lookY or 0,

		type(lookZ) == "number" and lookZ or -1

	)

	if lookDir.Magnitude < 0.01 then

		lookDir = Vector3.new(0, 0, -1)

	else

		lookDir = lookDir.Unit

	end



	s.moveDir = moveDir

	s.lookDir = lookDir

	s.lastInputTime = os.clock()

end



local function updateFlight(dt: number)

	local now = os.clock()

	local dtClamped = math.clamp(dt, 0.001, 0.1)

	local velLerpMoveAlpha = 1 - (1 - C.FLIGHT_VEL_LERP_MOVE) ^ (dtClamped * 60)

	local velLerpDecayAlpha = 1 - (1 - C.FLIGHT_VEL_LERP_DECAY) ^ (dtClamped * 60)



	for plr, s in stateByPlayer do

		local char = plr.Character

		if s.character and char ~= s.character then

			endFlight(plr, true)

			continue

		end

		if not char or not char.Parent or char:GetAttribute("NewFlightActive") ~= true then

			endFlight(plr, true)

			continue

		end



		local humanoid = char:FindFirstChildOfClass("Humanoid")

		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?

		if not humanoid or not root or humanoid.Health <= 0 then

			endFlight(plr, true)

			continue

		end

		if char:GetAttribute("IsShieldActive") == true then

			endFlight(plr, true)

			continue

		end



		local moveDir = s.moveDir

		local lookDir = s.lookDir

		local moveMag = moveDir.Magnitude



		if now - s.lastInputTime > C.FLIGHT_STALE_INPUT_TIME and moveMag > 0.01 then

			s.moveDir = s.moveDir * 0.95

			moveDir = s.moveDir

			moveMag = moveDir.Magnitude

		end



		local playerState = PlayerStateService.get(plr)

		local drainRate = if moveMag > 0.01 then C.FLIGHT_ENERGY_DRAIN_MOVING else C.FLIGHT_ENERGY_DRAIN_IDLE

		playerState.Energy = math.max(0, playerState.Energy - drainRate * dtClamped)

		PlayerStateService.markResourceUsed(plr)

		if playerState.Energy <= 0 then

			endFlight(plr, true)

			continue

		end



		local direction: Vector3?

		if char:GetAttribute("IsChaosBeamActive") == true then

			local bx = char:GetAttribute("ChaosBeamLookX")

			local bz = char:GetAttribute("ChaosBeamLookZ")

			if type(bx) == "number" and type(bz) == "number" then

				local beamDir = Vector3.new(bx, 0, bz)

				if beamDir.Magnitude > 0.01 then

					direction = beamDir.Unit

				end

			end

		end

		if not direction then

			if moveMag > 0.01 then

				direction = moveDir.Unit

			else

				direction = lookDir

			end

			if direction.Magnitude < 0.01 then

				direction = lookDir

			end

			direction = direction.Unit

		end



		local flySpeed = C.FLIGHT_SPEED

		local velocity = root.AssemblyLinearVelocity

		local targetVel: Vector3

		local lerpAlpha: number

		if moveMag > 0.01 then

			targetVel = direction * flySpeed

			lerpAlpha = velLerpMoveAlpha

		else

			targetVel = NEAR_ZERO_VEL

			lerpAlpha = velLerpDecayAlpha

		end

		velocity = velocity:Lerp(targetVel, lerpAlpha)

		local velMag = velocity.Magnitude



		if s.linearVel and s.linearVel.Parent then

			s.linearVel.VectorVelocity = velocity

			s.linearVel.MaxForce = math.huge

		end

		if s.gravityCancel and s.gravityCancel.Parent then

			s.gravityCancel.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0)

		end



		local alphaSpeed = velMag / flySpeed



		if s.align and s.align.Parent then
			local charPos = root.Position
			local baseCf: CFrame
			if math.abs(direction.Y) >= 0.99 then
				baseCf = CFrame.lookAt(charPos, charPos + direction, Vector3.new(1, 0, 0))
			else
				baseCf = CFrame.new(charPos, charPos + direction)
			end

			local difference = 0
			if velMag > 0.01 then
				difference = GetRotate(direction, velocity.Unit)
					* math.clamp(alphaSpeed * 1.2, 0, 1)
					* C.FLIGHT_BANK_SCALE
			end

			local pitchAlpha = math.min(1, alphaSpeed * C.FLIGHT_PITCH_RESPONSE_FACTOR)
			local targetCf = baseCf
				* CFrame.Angles(math.rad(pitchAlpha * -C.FLIGHT_PITCH_DEG_AT_MAX), math.rad(difference), 0)
			s.align.CFrame = s.align.CFrame:Lerp(targetCf, C.FLIGHT_ROTATION_LERP)
		end



		char:SetAttribute("FlightMoving", velMag > C.FLIGHT_IDLE_STOPPED_SPEED)

		char:SetAttribute("FlightInputActive", moveMag > 0.01)

		char:SetAttribute("FlightAlphaSpeed", math.clamp(alphaSpeed, 0, 1))



		local tracks = s.tracks

		local a = math.clamp(alphaSpeed, 0, 1)

		if not tracks.idle.IsPlaying then

			tracks.idle:Play(0.2, 1, 1)

		end

		if not tracks.move.IsPlaying then

			tracks.move:Play(0.2, 1, 1)

		end

		tracks.idle:AdjustWeight(1 - a, 0.1)

		tracks.move:AdjustWeight(a, 0.1)

		tracks.move:AdjustSpeed(0.9 + a * 0.35, 0.1)

	end

end



function FlightService.setup(

	flightToggle: RemoteEvent,

	flightInput: RemoteEvent,

	statUpdateCallback: (player: Player) -> (),

	cooldownCallback: (player: Player, abilityId: string, duration: number) -> ()

)

	onStatUpdate = statUpdateCallback

	onCooldown = cooldownCallback



	flightToggle.OnServerEvent:Connect(function(plr: Player)

		toggleFlight(plr)

	end)



	flightInput.OnServerEvent:Connect(function(

		plr: Player,

		moveX: number,

		moveY: number,

		moveZ: number,

		lookX: number,

		lookY: number,

		lookZ: number,

		_speedBoost: boolean?

	)

		onInput(plr, moveX, moveY, moveZ, lookX, lookY, lookZ)

	end)

end



function FlightService.startUpdateLoop()

	if updateConn then

		return

	end

	updateConn = RunService.Heartbeat:Connect(updateFlight)

end



function FlightService.forceStop(plr: Player, applyCooldown: boolean)

	endFlight(plr, applyCooldown)

end



function FlightService.cleanupPlayer(plr: Player)

	endFlight(plr, false)

	stateByPlayer[plr] = nil

	lastFlightToggleTime[plr] = nil

end



function FlightService.isFlying(plr: Player): boolean

	local char = plr.Character

	return char ~= nil and char:GetAttribute("NewFlightActive") == true

end



Players.PlayerRemoving:Connect(function(plr)

	endFlight(plr, false)

end)



return FlightService

]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">HexBlastProjectile</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Wanda Hex Blast — mouse-steered projectile (NewMarvel Scarlet Witch Hex Bolt pattern).
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local AbilityConstants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AbilityConstants"))
local ProjectileFlight = require(script.Parent.ProjectileFlight)

local CombatService = require(script.Parent.CombatService)
local PlayerStateService = require(script.Parent.PlayerStateService)

local C = AbilityConstants

local WANDA_HEX_COLOR = Color3.fromRGB(200, 35, 55)

local function getOverlapParams(char: Model): OverlapParams
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	return params
end

local function getHexTemplate(): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local wanda = assets and assets:FindFirstChild("WandaMaximoff")
	local tpl = wanda and (wanda:FindFirstChild("HexBlast") or wanda:FindFirstChild("HexBolt"))
	if tpl then
		return tpl
	end
	local sw = assets and assets:FindFirstChild("ScarletWitch")
	return sw and (sw:FindFirstChild("HexBlast") or sw:FindFirstChild("HexBolt"))
end

local function getHandPart(char: Model, useRight: boolean): BasePart?
	local name = if useRight then "RightHand" else "LeftHand"
	local fallback = if useRight then "Right Arm" else "Left Arm"
	return (char:FindFirstChild(name) or char:FindFirstChild(fallback)) :: BasePart?
end

local function spawnVisual(spawnPos: Vector3, color: Color3): (Instance?, BasePart?)
	local template = getHexTemplate()
	if template then
		local projectile = template:Clone()
		projectile.Name = "HexBlastProjectile"
		local part: BasePart?
		if projectile:IsA("Model") then
			part = projectile.PrimaryPart or projectile:FindFirstChildWhichIsA("BasePart")
			if part then
				if not projectile.PrimaryPart then
					projectile.PrimaryPart = part
				end
				projectile:PivotTo(CFrame.new(spawnPos))
			end
			for _, desc in projectile:GetDescendants() do
				if desc:IsA("BasePart") then
					desc.Anchored = true
					desc.CanCollide = false
					desc.CanTouch = false
					desc.CanQuery = false
				end
			end
		elseif projectile:IsA("BasePart") then
			part = projectile
			part.CFrame = CFrame.new(spawnPos)
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
		end
		if not part then
			projectile:Destroy()
			return nil, nil
		end
		for _, desc in projectile:GetDescendants() do
			if desc:IsA("ParticleEmitter") then
				desc.Color = ColorSequence.new(color)
				desc.Enabled = true
				desc:Emit(8)
			elseif desc:IsA("BasePart") then
				desc.Color = color
			end
		end
		projectile.Parent = workspace
		return projectile, part
	end

	local part = Instance.new("Part")
	part.Name = "HexBlastProjectile"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(1.1, 1.1, 1.1)
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CFrame = CFrame.new(spawnPos)
	part.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.25, 0.5)
	emitter.Speed = NumberRange.new(0, 2)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new(0.35, 0)
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Parent = part
	emitter:Emit(10)

	return part, part
end

local function doImpact(
	projectile: Instance,
	part: BasePart,
	char: Model,
	plr: Player,
	impactPos: Vector3,
	damage: number
)
	for _, desc in projectile:GetDescendants() do
		if desc:IsA("ParticleEmitter") then
			desc.Enabled = false
			desc.Rate = 0
		end
	end

	local overlap = getOverlapParams(char)
	local parts = workspace:GetPartBoundsInRadius(impactPos, C.HEX_BLAST_HIT_RADIUS, overlap)
	local hitModels: { [Model]: boolean } = {}
	local heroId = PlayerStateService.get(plr).HeroId

	for _, hitPart in parts do
		local model = hitPart:FindFirstAncestorOfClass("Model")
		if not model or model == char or hitModels[model] then
			continue
		end
		hitModels[model] = true
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			local finalDamage = CombatService.computeDamage(plr, heroId, damage)
			humanoid:TakeDamage(finalDamage)
		end
	end

	for _, desc in projectile:GetDescendants() do
		if desc:IsA("BasePart") and desc.Transparency < 0.99 then
			TweenService:Create(desc, TweenInfo.new(0.22), { Transparency = 1 }):Play()
		end
	end
	if part.Transparency < 0.99 then
		TweenService:Create(part, TweenInfo.new(0.22), { Transparency = 1 }):Play()
	end
	Debris:AddItem(projectile, 1.5)
end

local hexNextRight: { [Player]: boolean } = {}

local HexBlastProjectile = {}

function HexBlastProjectile.fire(
	plr: Player,
	char: Model,
	aimDirection: Vector3,
	steerToken: string?,
	targetPos: Vector3?
)
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	local useRight = hexNextRight[plr] ~= false
	hexNextRight[plr] = not useRight
	local hand = getHandPart(char, useRight)
	local spawnPos = if hand then hand.Position else (root.Position + Vector3.new(0, 1, 0))

	local dir = if aimDirection.Magnitude > 0.01 then aimDirection.Unit else root.CFrame.LookVector
	local impactPos = targetPos or (spawnPos + dir * C.HEX_BLAST_RANGE)

	local projectile, part = spawnVisual(spawnPos, WANDA_HEX_COLOR)
	if not projectile or not part then
		return
	end

	if steerToken and steerToken ~= "" then
		ProjectileFlight.registerSteerToken(steerToken, plr.UserId, impactPos)
	end

	ProjectileFlight.runProjectileFlight({
		part = part,
		spawnPos = spawnPos,
		initialDir = (impactPos - spawnPos).Unit,
		maxRange = C.HEX_BLAST_RANGE,
		speed = C.HEX_BLAST_SPEED,
		casterChar = char,
		steerToken = steerToken,
		curveArcHeight = 0,
		excludeInstances = { char, projectile },
		faceMovement = true,
		onStepHit = function(_hitPos: Vector3, hitPart: BasePart?)
			if not hitPart then
				return false
			end
			local hitModel = hitPart:FindFirstAncestorOfClass("Model")
			if not hitModel or hitModel == char then
				return false
			end
			return true
		end,
		onEnd = function(endPos: Vector3)
			doImpact(projectile, part, char, plr, endPos, C.HEX_BLAST_DAMAGE)
		end,
	})
end

return HexBlastProjectile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">InteractionService</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))
local InteractionConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("InteractionConfig"))
local PropHelper = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PropHelper"))

local InteractionService = {}

local function getHumanoidRoot(model: Model): BasePart?
	return model:FindFirstChild("HumanoidRootPart") :: BasePart?
		or model:FindFirstChild("Torso") :: BasePart?
		or model:FindFirstChild("UpperTorso") :: BasePart?
end

local function unanchorIfNeeded(part: BasePart)
	if part.Anchored then
		part.Anchored = false
	end
	local model = part:FindFirstAncestorOfClass("Model")
	if model then
		for _, desc in model:GetDescendants() do
			if desc:IsA("BasePart") and desc.Anchored then
				desc.Anchored = false
			end
		end
	end
end

function InteractionService.getTargetFromRay(origin: Vector3, direction: Vector3, maxDistance: number, exclude: { Instance }?): Instance?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclude or {}
	local result = workspace:Raycast(origin, direction.Unit * maxDistance, params)
	if not result then
		return nil
	end
	return result.Instance
end

function InteractionService.isValidPushTarget(inst: Instance): boolean
	if inst:IsA("BasePart") then
		local model = inst:FindFirstAncestorOfClass("Model")
		if model then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				return true
			end
			if PropHelper.isProp(inst) then
				return true
			end
		end
		if PropHelper.isProp(inst) then
			return true
		end
	end
	return false
end

function InteractionService.pushTarget(target: Instance, direction: Vector3, abilityId: string, attacker: Player?)
	local profile = InteractionConfig[abilityId]
	if not profile then
		return
	end

	local model = if target:IsA("Model") then target else target:FindFirstAncestorOfClass("Model")
	if not model then
		if target:IsA("BasePart") and PropHelper.isProp(target) then
			model = target:FindFirstAncestorOfClass("Model") or target
		else
			return
		end
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		local root = getHumanoidRoot(model)
		if root then
			root.AssemblyLinearVelocity = direction.Unit * profile.humanoidForce
		end
		return
	end

	if PropHelper.isProp(model) or PropHelper.isProp(target) then
		local root = PropHelper.getPropRoot(model) or PropHelper.getPropRoot(target)
		if root then
			unanchorIfNeeded(root)
			root.AssemblyLinearVelocity = direction.Unit * profile.propForce
		end
	end
end

function InteractionService.pushCone(attackerCharacter: Model, abilityId: string, range: number, halfAngle: number)
	local root = getHumanoidRoot(attackerCharacter)
	if not root then
		return
	end

	local origin = root.Position
	local look = root.CFrame.LookVector

	for _, player in game:GetService("Players"):GetPlayers() do
		local char = player.Character
		if char and char ~= attackerCharacter then
			local targetRoot = getHumanoidRoot(char)
			if targetRoot then
				local offset = targetRoot.Position - origin
				local dist = offset.Magnitude
				if dist <= range and dist > 0 then
					local dot = look:Dot(offset.Unit)
					if dot >= math.cos(math.rad(halfAngle)) then
						InteractionService.pushTarget(char, look, abilityId, nil)
					end
				end
			end
		end
	end

	for _, model in workspace:GetDescendants() do
		if model:IsA("Model") and PropHelper.isProp(model) then
			local part = PropHelper.getPropRoot(model)
			if part then
				local offset = part.Position - origin
				local dist = offset.Magnitude
				if dist <= range and dist > 0 then
					local dot = look:Dot(offset.Unit)
					if dot >= math.cos(math.rad(halfAngle)) then
						InteractionService.pushTarget(model, look, abilityId, nil)
					end
				end
			end
		end
	end
end

function InteractionService.telekinesisThrow(attackerCharacter: Model, target: Instance, aimDirection: Vector3)
	local profile = InteractionConfig.Telekinesis
	if not profile then
		return
	end

	local model = if target:IsA("Model") then target else target:FindFirstAncestorOfClass("Model")
	if not model then
		return
	end

	local direction = if aimDirection.Magnitude > 0 then aimDirection.Unit else attackerCharacter:GetPivot().LookVector
	local humanoid = model:FindFirstChildOfClass("Humanoid")

	if humanoid and humanoid.Health > 0 then
		local root = getHumanoidRoot(model)
		if root then
			root.AssemblyLinearVelocity = direction * Constants.TELEKINESIS_THROW_FORCE
		end
		return
	end

	if PropHelper.isProp(model) or PropHelper.isProp(target) then
		local root = PropHelper.getPropRoot(model)
		if root then
			unanchorIfNeeded(root)
			root.AssemblyLinearVelocity = direction * Constants.TELEKINESIS_THROW_FORCE
		end
	end
end

return InteractionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">OverheadService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local OverheadService = {}

local PLATE_NAME = "OverheadPlate"
local HEALTH_COLOR = Color3.fromRGB(72, 188, 96)
local HEALTH_DARK = Color3.fromRGB(42, 118, 56)

local function getAdornee(character: Model): BasePart?
	return character:FindFirstChild("Head") :: BasePart?
		or character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function styleTextLabel(label: TextLabel, size: number, bold: boolean)
	label.BackgroundTransparency = 1
	label.Font = if bold then Enum.Font.GothamBold else Enum.Font.GothamMedium
	label.TextSize = size
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextColor3 = Color3.fromRGB(245, 247, 250)
	label.TextStrokeTransparency = 0.55
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
end

local function createPlate(character: Model, title: string, subtitle: string?, showSubtitle: boolean): BillboardGui?
	local adornee = getAdornee(character)
	if not adornee then
		return nil
	end

	local existing = adornee:FindFirstChild(PLATE_NAME)
	if existing then
		existing:Destroy()
	end

	local plateHeight = if showSubtitle then 82 else 62
	local billboard = Instance.new("BillboardGui")
	billboard.Name = PLATE_NAME
	billboard.Adornee = adornee
	billboard.AlwaysOnTop = false
	billboard.LightInfluence = 0
	billboard.MaxDistance = 90
	billboard.Size = UDim2.fromOffset(220, plateHeight)
	billboard.StudsOffset = Vector3.new(0, 2.8, 0)
	billboard.Parent = adornee

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Size = UDim2.fromOffset(220, plateHeight)
	root.Parent = billboard

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = root

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Title"
	nameLabel.Size = UDim2.fromOffset(210, 20)
	nameLabel.Text = title
	nameLabel.LayoutOrder = 1
	styleTextLabel(nameLabel, 17, true)
	nameLabel.Parent = root

	local subLabel = Instance.new("TextLabel")
	subLabel.Name = "Subtitle"
	subLabel.Size = UDim2.fromOffset(210, 16)
	subLabel.Text = subtitle or ""
	subLabel.Visible = showSubtitle and subtitle ~= nil and subtitle ~= ""
	subLabel.LayoutOrder = 2
	styleTextLabel(subLabel, 14, false)
	subLabel.TextColor3 = Color3.fromRGB(190, 198, 210)
	subLabel.Parent = root

	local healthRow = Instance.new("Frame")
	healthRow.Name = "HealthRow"
	healthRow.BackgroundTransparency = 1
	healthRow.Size = UDim2.fromOffset(150, 22)
	healthRow.LayoutOrder = 3
	healthRow.Parent = root

	local healthTrack = Instance.new("Frame")
	healthTrack.Name = "Track"
	healthTrack.AnchorPoint = Vector2.new(0.5, 0)
	healthTrack.BackgroundColor3 = Color3.fromRGB(22, 26, 32)
	healthTrack.BackgroundTransparency = 0.35
	healthTrack.BorderSizePixel = 0
	healthTrack.Position = UDim2.new(0.5, 0, 0, 0)
	healthTrack.Size = UDim2.fromOffset(130, 8)
	healthTrack.ClipsDescendants = true
	healthTrack.Parent = healthRow

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = healthTrack

	local healthFill = Instance.new("Frame")
	healthFill.Name = "Fill"
	healthFill.BackgroundColor3 = HEALTH_COLOR
	healthFill.BorderSizePixel = 0
	healthFill.Size = UDim2.fromScale(1, 1)
	healthFill.Parent = healthTrack

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = healthFill

	local fillGradient = Instance.new("UIGradient")
	fillGradient.Rotation = 90
	fillGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, HEALTH_COLOR),
		ColorSequenceKeypoint.new(1, HEALTH_DARK),
	})
	fillGradient.Parent = healthFill

	local hpText = Instance.new("TextLabel")
	hpText.Name = "HpText"
	hpText.BackgroundTransparency = 1
	hpText.Size = UDim2.fromOffset(150, 14)
	hpText.Position = UDim2.fromOffset(0, 10)
	hpText.Text = "100 HP"
	hpText.LayoutOrder = 4
	styleTextLabel(hpText, 13, false)
	hpText.TextColor3 = Color3.fromRGB(210, 216, 224)
	hpText.Parent = healthRow

	return billboard
end

local function updateHealth(character: Model, humanoid: Humanoid)
	local adornee = getAdornee(character)
	if not adornee then
		return
	end
	local billboard = adornee:FindFirstChild(PLATE_NAME) :: BillboardGui?
	if not billboard then
		return
	end
	local root = billboard:FindFirstChild("Root")
	if not root then
		return
	end
	local healthRow = root:FindFirstChild("HealthRow")
	if not healthRow then
		return
	end
	local track = healthRow:FindFirstChild("Track")
	local hpText = healthRow:FindFirstChild("HpText") :: TextLabel?
	local fill = track and track:FindFirstChild("Fill") :: Frame?
	if not fill or not hpText then
		return
	end

	local hp = math.floor(humanoid.Health + 0.5)
	local ratio = if humanoid.MaxHealth > 0 then math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) else 0
	fill.Size = UDim2.fromScale(ratio, 1)
	hpText.Text = `{hp} HP`
end

local function bindHealth(character: Model, humanoid: Humanoid)
	updateHealth(character, humanoid)
	humanoid.HealthChanged:Connect(function()
		updateHealth(character, humanoid)
	end)
end

function OverheadService.attachNpc(character: Model)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local adornee = getAdornee(character)
	if adornee and adornee:FindFirstChild(PLATE_NAME) then
		return
	end

	createPlate(character, character.Name, nil, false)
	bindHealth(character, humanoid)
end

function OverheadService.attachPlayer(character: Model, player: Player)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local adornee = getAdornee(character)
	if adornee and adornee:FindFirstChild(PLATE_NAME) then
		return
	end

	local billboard = createPlate(character, player.DisplayName, nil, false)
	if billboard then
		billboard.Enabled = false
	end
	bindHealth(character, humanoid)
end

function OverheadService.setPlayerHero(character: Model, player: Player, heroDisplayName: string, accent: Color3?)
	local adornee = getAdornee(character)
	if not adornee then
		return
	end

	local existing = adornee:FindFirstChild(PLATE_NAME)
	if existing then
		existing:Destroy()
	end

	local billboard = createPlate(character, player.DisplayName, heroDisplayName, true)
	if not billboard then
		return
	end

	billboard.Enabled = true

	local root = billboard:FindFirstChild("Root")
	local subtitle = root and root:FindFirstChild("Subtitle") :: TextLabel?
	if subtitle and accent then
		subtitle.TextColor3 = accent
	end
end

function OverheadService.hidePlayerPlate(character: Model)
	local adornee = getAdornee(character)
	if not adornee then
		return
	end
	local billboard = adornee:FindFirstChild(PLATE_NAME) :: BillboardGui?
	if billboard then
		billboard.Enabled = false
	end
end

function OverheadService.bindCharacter(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local player = Players:GetPlayerFromCharacter(character)
	if player then
		OverheadService.attachPlayer(character, player)
	else
		OverheadService.attachNpc(character)
	end
end

function OverheadService.init()
	for _, desc in workspace:GetDescendants() do
		if desc:IsA("Model") and desc:FindFirstChildOfClass("Humanoid") then
			OverheadService.bindCharacter(desc)
		end
	end

	workspace.DescendantAdded:Connect(function(desc)
		if desc:IsA("Humanoid") then
			local character = desc.Parent
			if character and character:IsA("Model") then
				task.defer(function()
					OverheadService.bindCharacter(character)
				end)
			end
		end
	end)
end

return OverheadService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">PlayerStateService</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))

export type PlayerState = {
	HeroId: string?,
	Health: number,
	Stamina: number,
	Energy: number,
	Currencies: {
		Blue: number,
		Yellow: number,
	},
	Cooldowns: { [string]: number },
	lastResourceUseAt: number?,
}

local PlayerStateService = {}

local states: { [Player]: PlayerState } = {}

local function defaultState(): PlayerState
	return {
		HeroId = nil,
		Health = Constants.MAX_HEALTH,
		Stamina = Constants.MAX_STAMINA,
		Energy = Constants.MAX_ENERGY,
		Currencies = {
			Blue = 0,
			Yellow = 0,
		},
		Cooldowns = {},
		lastResourceUseAt = nil,
	}
end

function PlayerStateService.initPlayer(player: Player)
	states[player] = defaultState()
end

function PlayerStateService.removePlayer(player: Player)
	states[player] = nil
end

function PlayerStateService.get(player: Player): PlayerState
	if not states[player] then
		states[player] = defaultState()
	end
	return states[player]
end

function PlayerStateService.markResourceUsed(player: Player)
	local state = PlayerStateService.get(player)
	state.lastResourceUseAt = os.clock()
end

function PlayerStateService.canRegenResources(player: Player): boolean
	local state = PlayerStateService.get(player)
	if state.lastResourceUseAt == nil then
		return true
	end
	return os.clock() - state.lastResourceUseAt >= Constants.RESOURCE_REGEN_DELAY
end

function PlayerStateService.setHero(player: Player, heroId: string?)
	local state = PlayerStateService.get(player)
	state.HeroId = heroId
	state.Cooldowns = {}
	state.lastResourceUseAt = nil
	if heroId then
		state.Health = Constants.MAX_HEALTH
		state.Stamina = Constants.MAX_STAMINA
		state.Energy = Constants.MAX_ENERGY
	end
end

function PlayerStateService.clearHero(player: Player)
	PlayerStateService.setHero(player, nil)
end

function PlayerStateService.syncFromCharacter(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local state = PlayerStateService.get(player)
	state.Health = humanoid.Health
	state.Stamina = math.clamp(state.Stamina, 0, Constants.MAX_STAMINA)
	state.Energy = math.clamp(state.Energy, 0, Constants.MAX_ENERGY)
end

function PlayerStateService.setCooldown(player: Player, abilityId: string, endTime: number)
	local state = PlayerStateService.get(player)
	state.Cooldowns[abilityId] = endTime
end

function PlayerStateService.isOnCooldown(player: Player, abilityId: string): boolean
	local state = PlayerStateService.get(player)
	local endTime = state.Cooldowns[abilityId]
	return endTime ~= nil and endTime > os.clock()
end

function PlayerStateService.spendEnergy(player: Player, amount: number): boolean
	local state = PlayerStateService.get(player)
	if state.Energy < amount then
		return false
	end
	state.Energy -= amount
	PlayerStateService.markResourceUsed(player)
	return true
end

function PlayerStateService.spendStamina(player: Player, amount: number): boolean
	local state = PlayerStateService.get(player)
	if state.Stamina < amount then
		return false
	end
	state.Stamina -= amount
	PlayerStateService.markResourceUsed(player)
	return true
end

function PlayerStateService.getStatPayload(player: Player): { [string]: any }
	local state = PlayerStateService.get(player)
	PlayerStateService.syncFromCharacter(player)
	return {
		Health = state.Health,
		MaxHealth = Constants.MAX_HEALTH,
		Stamina = state.Stamina,
		MaxStamina = Constants.MAX_STAMINA,
		Energy = state.Energy,
		MaxEnergy = Constants.MAX_ENERGY,
		Blue = state.Currencies.Blue,
		Yellow = state.Currencies.Yellow,
	}
end

function PlayerStateService.startRegenLoop(onStatUpdate: (player: Player) -> ())
	task.spawn(function()
		while true do
			task.wait(0.25)
			for player, state in states do
				if not player.Parent or not state.HeroId then
					continue
				end
				if not PlayerStateService.canRegenResources(player) then
					continue
				end

				local prevStamina = state.Stamina
				local prevEnergy = state.Energy
				state.Stamina = math.min(Constants.MAX_STAMINA, state.Stamina + Constants.STAMINA_REGEN * 0.25)
				state.Energy = math.min(Constants.MAX_ENERGY, state.Energy + Constants.ENERGY_REGEN * 0.25)

				if state.Stamina ~= prevStamina or state.Energy ~= prevEnergy then
					onStatUpdate(player)
				end
			end
		end
	end)
end

return PlayerStateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">ProjectileFlight</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local AbilityConstants = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("AbilityConstants"))

local STEER_TURN_RATE = math.rad(AbilityConstants.PROJECTILE_STEER_TURN_RATE_DEG)
local STEER_EXPIRE_SEC = 8

type SteerState = {
	targetPos: Vector3,
	ownerUserId: number,
	expiresAt: number,
}

local steerByToken: { [string]: SteerState } = {}

export type FlightOpts = {
	part: BasePart,
	spawnPos: Vector3,
	initialDir: Vector3,
	maxRange: number,
	speed: number,
	casterChar: Model,
	steerToken: string?,
	curveArcHeight: number?,
	fixedOrientation: CFrame?,
	excludeInstances: { Instance }?,
	faceMovement: boolean?,
	onStepHit: ((hitPos: Vector3, hitPart: BasePart?) -> boolean)?,
	onEnd: (endPos: Vector3) -> (),
}

local function rotateDirToward(current: Vector3, target: Vector3, maxRadians: number): Vector3
	local cur = current.Unit
	local tgt = target.Unit
	local dot = math.clamp(cur:Dot(tgt), -1, 1)
	if dot > 0.9999 then
		return tgt
	end
	local angle = math.acos(dot)
	if angle <= maxRadians then
		return tgt
	end
	local axis = cur:Cross(tgt)
	if axis.Magnitude < 1e-5 then
		return cur
	end
	axis = axis.Unit
	return (CFrame.fromAxisAngle(axis, maxRadians):VectorToWorldSpace(cur)).Unit
end

local function clearSteerToken(token: string?)
	if not token or token == "" then
		return
	end
	steerByToken[token] = nil
end

local function registerSteerToken(token: string, ownerUserId: number, initialTarget: Vector3?)
	if type(token) ~= "string" or token == "" then
		return
	end
	steerByToken[token] = {
		targetPos = initialTarget or Vector3.zero,
		ownerUserId = ownerUserId,
		expiresAt = os.clock() + STEER_EXPIRE_SEC,
	}
end

local function updateSteerTarget(plr: Player, token: string, targetPos: Vector3): boolean
	if typeof(targetPos) ~= "Vector3" then
		return false
	end
	local st = steerByToken[token]
	if not st or st.ownerUserId ~= plr.UserId then
		return false
	end
	if os.clock() > st.expiresAt then
		steerByToken[token] = nil
		return false
	end
	st.targetPos = targetPos
	st.expiresAt = os.clock() + STEER_EXPIRE_SEC
	return true
end

local function runProjectileFlight(opts: FlightOpts): RBXScriptConnection?
	local part = opts.part
	if not part.Parent then
		return nil
	end

	local dir = if opts.initialDir.Magnitude > 0.01 then opts.initialDir.Unit else Vector3.new(0, 0, -1)
	local steerToken = opts.steerToken
	local arcHeight = opts.curveArcHeight or 0
	local fixedOri = opts.fixedOrientation
	local spawnPos = opts.spawnPos
	local distanceTraveled = 0
	local currentPos = spawnPos

	part.CFrame = if fixedOri
		then CFrame.new(spawnPos) * fixedOri
		elseif opts.faceMovement ~= false then CFrame.lookAt(spawnPos, spawnPos + dir)
		else CFrame.new(spawnPos)

	local conn: RBXScriptConnection?
	conn = RunService.Heartbeat:Connect(function(dt: number)
		if not part.Parent then
			if conn then
				conn:Disconnect()
			end
			clearSteerToken(steerToken)
			return
		end

		if steerToken and steerByToken[steerToken] then
			local st = steerByToken[steerToken]
			local desired = st.targetPos - currentPos
			if desired.Magnitude > 0.05 then
				dir = rotateDirToward(dir, desired, STEER_TURN_RATE * dt)
			end
		end

		local step = opts.speed * dt
		local moveVec = dir * step

		if opts.onStepHit then
			local rayParams = RaycastParams.new()
			rayParams.FilterType = Enum.RaycastFilterType.Exclude
			rayParams.FilterDescendantsInstances = opts.excludeInstances or {}
			rayParams.IgnoreWater = true
			local ray = Workspace:Raycast(currentPos, moveVec, rayParams)
			if ray then
				if opts.onStepHit(ray.Position, ray.Instance :: BasePart?) then
					if conn then
						conn:Disconnect()
					end
					clearSteerToken(steerToken)
					opts.onEnd(ray.Position)
					return
				end
			end
		end

		distanceTraveled += step
		if distanceTraveled >= opts.maxRange then
			if conn then
				conn:Disconnect()
			end
			clearSteerToken(steerToken)
			local endPos = currentPos + dir * math.max(0, opts.maxRange - (distanceTraveled - step))
			part.CFrame = if fixedOri
				then CFrame.new(endPos) * fixedOri
				elseif opts.faceMovement ~= false then CFrame.lookAt(endPos, endPos + dir)
				else CFrame.new(endPos)
			opts.onEnd(endPos)
			return
		end

		currentPos += moveVec
		local tNorm = math.clamp(distanceTraveled / math.max(opts.maxRange, 0.01), 0, 1)
		local displayPos = currentPos
		if arcHeight ~= 0 then
			displayPos += Vector3.new(0, math.sin(math.pi * tNorm) * arcHeight, 0)
		end

		local targetCf: CFrame
		if fixedOri then
			targetCf = CFrame.new(displayPos) * fixedOri
		elseif opts.faceMovement ~= false then
			targetCf = CFrame.lookAt(displayPos, displayPos + dir)
		else
			targetCf = CFrame.new(displayPos)
		end
		part.CFrame = part.CFrame:Lerp(targetCf, math.min(1, dt * 18))
	end)

	return conn
end

local function setupSteerRemote(projectileSteerUpdate: RemoteEvent)
	projectileSteerUpdate.OnServerEvent:Connect(function(plr: Player, token: unknown, targetPos: unknown)
		if type(token) ~= "string" or token == "" then
			return
		end
		if typeof(targetPos) ~= "Vector3" then
			return
		end
		updateSteerTarget(plr, token, targetPos)
	end)
end

return {
	runProjectileFlight = runProjectileFlight,
	registerSteerToken = registerSteerToken,
	updateSteerTarget = updateSteerTarget,
	clearSteerToken = clearSteerToken,
	setupSteerRemote = setupSteerRemote,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">ProjectileService</string>
            <string name="Source"><![CDATA[--!strict

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityConstants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AbilityConstants"))
local HeroRegistry = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HeroRegistry"))

local CombatService = require(script.Parent.CombatService)
local HexBlastProjectile = require(script.Parent.HexBlastProjectile)
local InteractionService = require(script.Parent.InteractionService)
local PlayerStateService = require(script.Parent.PlayerStateService)
local ProjectileFlight = require(script.Parent.ProjectileFlight)

local C = AbilityConstants
local CHAOS_COLOR = Color3.fromRGB(220, 60, 180)

local ProjectileService = {}

local function createProjectilePart(size: Vector3, color: Color3): BasePart
	local part = Instance.new("Part")
	part.Name = "ChaosProjectile"
	part.Size = size
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = color
	part.CanCollide = false
	part.CanQuery = true
	part.CanTouch = true
	part.Anchored = true
	part.CastShadow = false
	return part
end

local function damageHumanoid(attacker: Player, humanoid: Humanoid, baseDamage: number)
	local heroId = PlayerStateService.get(attacker).HeroId
	local damage = CombatService.computeDamage(attacker, heroId, baseDamage)
	humanoid:TakeDamage(damage)
end

local function tryDamageFromHit(attacker: Player, hitPart: BasePart?, casterChar: Model): boolean
	if not hitPart then
		return false
	end
	local hitModel = hitPart:FindFirstAncestorOfClass("Model")
	if not hitModel or hitModel == casterChar then
		return false
	end
	local humanoid = hitModel:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	return true
end

local function fireProjectile(
	player: Player,
	character: Model,
	direction: Vector3,
	opts: {
		damage: number,
		speed: number,
		range: number,
		size: Vector3,
		color: Color3,
		steerToken: string?,
	}
)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	local dir = if direction.Magnitude > 0.01 then direction.Unit else root.CFrame.LookVector
	local spawnPos = root.Position + dir * 2 + Vector3.new(0, 1, 0)
	local part = createProjectilePart(opts.size, opts.color)
	part.Parent = workspace

	if opts.steerToken then
		ProjectileFlight.registerSteerToken(opts.steerToken, player.UserId, spawnPos + dir * opts.range)
	end

	local hitTargets: { [Model]: boolean } = {}

	ProjectileFlight.runProjectileFlight({
		part = part,
		spawnPos = spawnPos,
		initialDir = dir,
		maxRange = opts.range,
		speed = opts.speed,
		casterChar = character,
		steerToken = opts.steerToken,
		excludeInstances = { character, part },
		onStepHit = function(_hitPos: Vector3, hitPart: BasePart?)
			if not hitPart then
				return false
			end
			if not tryDamageFromHit(player, hitPart, character) then
				return false
			end
			local hitModel = hitPart:FindFirstAncestorOfClass("Model")
			if not hitModel or hitTargets[hitModel] then
				return false
			end
			hitTargets[hitModel] = true
			local humanoid = hitModel:FindFirstChildOfClass("Humanoid")
			if humanoid then
				damageHumanoid(player, humanoid, opts.damage)
			end
			return true
		end,
		onEnd = function(_endPos: Vector3)
			if part.Parent then
				part:Destroy()
			end
		end,
	})
end

function ProjectileService.fireChaosBlast(player: Player, character: Model, direction: Vector3, steerToken: string?)
	HexBlastProjectile.fire(player, character, direction, steerToken, nil)
end

function ProjectileService.fireChaosBeam(player: Player, character: Model, direction: Vector3, steerToken: string?)
	fireProjectile(player, character, direction, {
		damage = C.CHAOS_BEAM_DAMAGE,
		speed = C.CHAOS_BEAM_SPEED,
		range = C.CHAOS_BEAM_RANGE,
		size = C.CHAOS_BEAM_SIZE,
		color = CHAOS_COLOR,
		steerToken = steerToken,
	})
end

function ProjectileService.parseSteerArgs(aimDirection: Vector3?, steerTokenArg: any): (Vector3?, string?)
	local steerToken: string? = if type(steerTokenArg) == "string" and #steerTokenArg > 0 then steerTokenArg else nil
	return aimDirection, steerToken
end

function ProjectileService.newSteerToken(): string
	return HttpService:GenerateGUID(false)
end

function ProjectileService.executeForcePush(player: Player, character: Model)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	local heroId = PlayerStateService.get(player).HeroId
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { character }

	local parts = workspace:GetPartBoundsInRadius(root.Position, C.FORCE_PUSH_RADIUS, overlap)
	local hitModels: { [Model]: boolean } = {}

	for _, part in parts do
		local model = part:FindFirstAncestorOfClass("Model")
		if not model or hitModels[model] then
			continue
		end
		hitModels[model] = true

		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			local pushDir = (model:GetPivot().Position - root.Position)
			if pushDir.Magnitude > 0.1 then
				pushDir = pushDir.Unit
			else
				pushDir = root.CFrame.LookVector
			end
			damageHumanoid(player, humanoid, C.FORCE_PUSH_DAMAGE)
			InteractionService.pushTarget(model, pushDir, "ForcePush", player)
		elseif part:IsA("BasePart") and part.Parent == workspace then
			local pushDir = (part.Position - root.Position)
			if pushDir.Magnitude > 0.1 then
				part:ApplyImpulse(pushDir.Unit * part.AssemblyMass * 80)
			end
		end
	end
end

function ProjectileService.heroUsesProjectile(heroId: string?, abilityId: string): boolean
	if not heroId then
		return false
	end
	if abilityId == "ChaosBlast" or abilityId == "ChaosBeam" then
		return HeroRegistry.heroOwnsAbility(heroId, abilityId)
	end
	return false
end

return ProjectileService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">RemoteSetup</string>
            <string name="Source"><![CDATA[--!strict



local ReplicatedStorage = game:GetService("ReplicatedStorage")



local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))



export type RemoteFolder = {

	SelectHero: RemoteEvent,

	HeroConfirmed: RemoteEvent,

	RequireReselect: RemoteEvent,

	UseAbility: RemoteEvent,

	CooldownUpdate: RemoteEvent,

	StatUpdate: RemoteEvent,

	SetSprinting: RemoteEvent,

	TelekinesisRequest: RemoteEvent,

	TelekinesisUpdate: RemoteEvent,

	TelekinesisThrow: RemoteEvent,

	TelekinesisEnd: RemoteEvent,

	ShieldSetActive: RemoteEvent,

	ChaosBeamSetActive: RemoteEvent,

	ChaosBeamLookUpdate: RemoteEvent,

	FlightToggle: RemoteEvent,

	FlightInput: RemoteEvent,

	ProjectileSteerUpdate: RemoteEvent,

}



local RemoteSetup = {}



function RemoteSetup.create(): RemoteFolder

	local folder = ReplicatedStorage:FindFirstChild("Remotes")

	if not folder then

		folder = Instance.new("Folder")

		folder.Name = "Remotes"

		folder.Parent = ReplicatedStorage

	end



	local function ensureRemote(name: string): RemoteEvent

		local existing = folder:FindFirstChild(name)

		if existing and existing:IsA("RemoteEvent") then

			return existing

		end

		if existing then

			existing:Destroy()

		end

		local remote = Instance.new("RemoteEvent")

		remote.Name = name

		remote.Parent = folder

		return remote

	end



	return {

		SelectHero = ensureRemote(Remotes.SelectHero),

		HeroConfirmed = ensureRemote(Remotes.HeroConfirmed),

		RequireReselect = ensureRemote(Remotes.RequireReselect),

		UseAbility = ensureRemote(Remotes.UseAbility),

		CooldownUpdate = ensureRemote(Remotes.CooldownUpdate),

		StatUpdate = ensureRemote(Remotes.StatUpdate),

		SetSprinting = ensureRemote(Remotes.SetSprinting),

		TelekinesisRequest = ensureRemote(Remotes.TelekinesisRequest),

		TelekinesisUpdate = ensureRemote(Remotes.TelekinesisUpdate),

		TelekinesisThrow = ensureRemote(Remotes.TelekinesisThrow),

		TelekinesisEnd = ensureRemote(Remotes.TelekinesisEnd),

		ShieldSetActive = ensureRemote(Remotes.ShieldSetActive),

		ChaosBeamSetActive = ensureRemote(Remotes.ChaosBeamSetActive),

		ChaosBeamLookUpdate = ensureRemote(Remotes.ChaosBeamLookUpdate),

		FlightToggle = ensureRemote(Remotes.FlightToggle),

		FlightInput = ensureRemote(Remotes.FlightInput),

		ProjectileSteerUpdate = ensureRemote(Remotes.ProjectileSteerUpdate),

	}

end



return RemoteSetup

]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ShieldService</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityConstants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AbilityConstants"))
local HeroRegistry = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HeroRegistry"))

local PlayerStateService = require(script.Parent.PlayerStateService)
local TelekinesisService = require(script.Parent.TelekinesisService)
local WandaHandParticlesService = require(script.Parent.WandaHandParticlesService)

local C = AbilityConstants
local SHIELD_PINK = Color3.fromRGB(255, 87, 224)

type ShieldState = {
	active: boolean,
	lastDrainTime: number?,
	originalWalkSpeed: number?,
	originalJumpPower: number?,
	shieldPart: BasePart?,
	healthConn: RBXScriptConnection?,
}

local ShieldService = {}
local stateByPlayer: { [Player]: ShieldState } = {}
local ignoreNextHealthChange: { [Model]: boolean } = {}
local lastHealth: { [Model]: number } = {}
local onStatUpdate: ((player: Player) -> ())? = nil
local onCooldown: ((player: Player, abilityId: string, duration: number) -> ())? = nil

local function getState(plr: Player): ShieldState
	if not stateByPlayer[plr] then
		stateByPlayer[plr] = {
			active = false,
			lastDrainTime = nil,
			originalWalkSpeed = nil,
			originalJumpPower = nil,
			shieldPart = nil,
			healthConn = nil,
		}
	end
	return stateByPlayer[plr]
end

local function canUseShield(plr: Player): boolean
	local state = PlayerStateService.get(plr)
	if not state.HeroId then
		return false
	end
	return HeroRegistry.heroOwnsAbility(state.HeroId, "ChaosShield")
end

local function destroyShieldVisual(st: ShieldState)
	if st.shieldPart and st.shieldPart.Parent then
		st.shieldPart:Destroy()
	end
	st.shieldPart = nil
end

local function createShieldVisual(char: Model, root: BasePart): BasePart
	local bubble = Instance.new("Part")
	bubble.Name = "ChaosShieldBubble"
	bubble.Shape = Enum.PartType.Ball
	bubble.Size = Vector3.new(7, 7, 7)
	bubble.Material = Enum.Material.ForceField
	bubble.Color = SHIELD_PINK
	bubble.Transparency = 0.55
	bubble.CanCollide = false
	bubble.CanQuery = false
	bubble.CanTouch = false
	bubble.Massless = true
	bubble.Anchored = false
	bubble.CFrame = root.CFrame
	bubble.Parent = char

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = bubble
	weld.Parent = bubble

	return bubble
end

local function bindHealthIntercept(char: Model, st: ShieldState)
	if st.healthConn then
		st.healthConn:Disconnect()
		st.healthConn = nil
	end

	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	lastHealth[char] = humanoid.Health

	st.healthConn = humanoid.HealthChanged:Connect(function(newHealth)
		if ignoreNextHealthChange[char] then
			ignoreNextHealthChange[char] = false
			lastHealth[char] = newHealth
			return
		end

		if char:GetAttribute("IsShieldActive") ~= true then
			lastHealth[char] = newHealth
			return
		end

		local shieldHp = char:GetAttribute("ShieldHP")
		if type(shieldHp) ~= "number" or shieldHp <= 0 then
			lastHealth[char] = newHealth
			return
		end

		local prevHealth = lastHealth[char] or humanoid.MaxHealth
		local damage = prevHealth - newHealth
		lastHealth[char] = newHealth
		if damage <= 0 then
			return
		end

		local absorbed = math.min(shieldHp, damage)
		local remaining = shieldHp - absorbed
		char:SetAttribute("ShieldHP", remaining)

		ignoreNextHealthChange[char] = true
		humanoid.Health = newHealth + absorbed
		lastHealth[char] = humanoid.Health

		if remaining <= 0 then
			local plr = game:GetService("Players"):GetPlayerFromCharacter(char)
			if plr then
				ShieldService.turnOff(plr)
			end
		end
	end)
end

function ShieldService.turnOff(plr: Player)
	local st = getState(plr)
	if not st.active then
		return
	end
	st.active = false
	st.lastDrainTime = nil

	local char = plr.Character
	if char then
		char:SetAttribute("IsShieldActive", nil)
		char:SetAttribute("ShieldHP", nil)

		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid then
			if st.originalWalkSpeed ~= nil then
				humanoid.WalkSpeed = st.originalWalkSpeed
			end
			if st.originalJumpPower ~= nil then
				humanoid.JumpPower = st.originalJumpPower
			end
		end

		WandaHandParticlesService.disable(char)
	end

	destroyShieldVisual(st)
	if st.healthConn then
		st.healthConn:Disconnect()
		st.healthConn = nil
	end
end

local function turnOn(plr: Player): boolean
	if not canUseShield(plr) then
		return false
	end
	if PlayerStateService.isOnCooldown(plr, "ChaosShield") then
		return false
	end

	local char = plr.Character
	if not char or not char.Parent then
		return false
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or humanoid.Health <= 0 then
		return false
	end

	local playerState = PlayerStateService.get(plr)
	if playerState.Energy < C.SHIELD_ENERGY_DRAIN then
		return false
	end

	TelekinesisService.cleanupPlayer(plr)

	local st = getState(plr)
	if st.active then
		return true
	end

	st.active = true
	st.lastDrainTime = os.clock()
	st.originalWalkSpeed = humanoid.WalkSpeed
	st.originalJumpPower = humanoid.JumpPower
	humanoid.WalkSpeed = C.SHIELD_WALK_SPEED
	humanoid.JumpPower = 0

	char:SetAttribute("IsShieldActive", true)
	char:SetAttribute("ShieldHP", C.CHAOS_SHIELD_HP)
	st.shieldPart = createShieldVisual(char, root)
	bindHealthIntercept(char, st)

	WandaHandParticlesService.enable(char)
	WandaHandParticlesService.emit(char)

	humanoid.Died:Once(function()
		ShieldService.turnOff(plr)
	end)

	return true
end

local function updateShieldDrain(now: number)
	for plr, st in stateByPlayer do
		if not st.active then
			continue
		end
		local char = plr.Character
		if not char or not char.Parent then
			ShieldService.turnOff(plr)
			continue
		end

		if typeof(st.lastDrainTime) ~= "number" then
			st.lastDrainTime = now
			continue
		end

		if now - st.lastDrainTime >= C.SHIELD_ENERGY_INTERVAL then
			st.lastDrainTime = now
			local state = PlayerStateService.get(plr)
			state.Energy = math.max(0, state.Energy - C.SHIELD_ENERGY_DRAIN)
			PlayerStateService.markResourceUsed(plr)
			if state.Energy <= 0 then
				ShieldService.turnOff(plr)
				PlayerStateService.setCooldown(plr, "ChaosShield", os.clock() + C.SHIELD_COOLDOWN)
				if onCooldown then
					onCooldown(plr, "ChaosShield", C.SHIELD_COOLDOWN)
				end
			end
			if onStatUpdate then
				onStatUpdate(plr)
			end
		end
	end
end

function ShieldService.setup(
	shieldSetActive: RemoteEvent,
	statUpdateCallback: (player: Player) -> (),
	cooldownCallback: (player: Player, abilityId: string, duration: number) -> ()
)
	onStatUpdate = statUpdateCallback
	onCooldown = cooldownCallback

	shieldSetActive.OnServerEvent:Connect(function(plr: Player, holding: boolean)
		if typeof(holding) ~= "boolean" then
			return
		end
		if holding then
			turnOn(plr)
		else
			if getState(plr).active then
				ShieldService.turnOff(plr)
				PlayerStateService.setCooldown(plr, "ChaosShield", os.clock() + C.SHIELD_COOLDOWN)
				if onCooldown then
					onCooldown(plr, "ChaosShield", C.SHIELD_COOLDOWN)
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			updateShieldDrain(os.clock())
		end
	end)
end

function ShieldService.cleanupPlayer(player: Player)
	ShieldService.turnOff(player)
	stateByPlayer[player] = nil
end

return ShieldService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">SpawnService</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))

local SpawnService = {}

local spawnPoints: { BasePart } = {}

local function collectSpawnPoints()
	table.clear(spawnPoints)
	local spawnFolder = workspace:FindFirstChild("SpawnPoints")
	if spawnFolder then
		for _, child in spawnFolder:GetChildren() do
			if child:IsA("BasePart") then
				table.insert(spawnPoints, child)
			elseif child:IsA("SpawnLocation") then
				table.insert(spawnPoints, child)
			end
		end
	end
	for _, child in workspace:GetChildren() do
		if child:IsA("SpawnLocation") then
			table.insert(spawnPoints, child)
		end
	end
end

function SpawnService.init()
	collectSpawnPoints()
	workspace.ChildAdded:Connect(function(child)
		if child:IsA("SpawnLocation") then
			table.insert(spawnPoints, child)
		end
	end)
end

function SpawnService.getSpawnCFrame(): CFrame
	if #spawnPoints == 0 then
		collectSpawnPoints()
	end
	if #spawnPoints > 0 then
		local part = spawnPoints[math.random(1, #spawnPoints)]
		return part.CFrame + Vector3.new(0, 3, 0)
	end
	return CFrame.new(Constants.SPAWN_FALLBACK)
end

function SpawnService.teleportCharacter(character: Model)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	root.CFrame = SpawnService.getSpawnCFrame()
end

return SpawnService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">SprintService</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))

local PlayerStateService = require(script.Parent.PlayerStateService)

local SprintService = {}

local sprinting: { [Player]: boolean } = {}
local onStatUpdate: ((player: Player) -> ())? = nil

function SprintService.setup(statCallback: (player: Player) -> ())
	onStatUpdate = statCallback
end

function SprintService.setSprinting(player: Player, wantsSprint: boolean)
	if not PlayerStateService.get(player).HeroId then
		sprinting[player] = false
		SprintService.applyWalkSpeed(player)
		return
	end
	sprinting[player] = wantsSprint
	SprintService.applyWalkSpeed(player)
end

function SprintService.forceStopSprint(player: Player)
	sprinting[player] = false
	SprintService.applyWalkSpeed(player)
end

function SprintService.applyWalkSpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	if character and (character:GetAttribute("IsLevitating") == true or character:GetAttribute("NewFlightActive") == true) then
		return
	end

	local state = PlayerStateService.get(player)
	if not state.HeroId then
		humanoid.WalkSpeed = Constants.WALK_SPEED
		return
	end

	local wantsSprint = sprinting[player] == true
	local canSprint = state.Stamina >= Constants.SPRINT_MIN_STAMINA
	if wantsSprint and canSprint then
		humanoid.WalkSpeed = Constants.SPRINT_SPEED
	else
		humanoid.WalkSpeed = Constants.WALK_SPEED
		if not canSprint then
			sprinting[player] = false
		end
	end
end

function SprintService.clearPlayer(player: Player)
	sprinting[player] = nil
end

function SprintService.startLoop()
	RunService.Heartbeat:Connect(function(dt)
		for player, isSprinting in sprinting do
			if not isSprinting or not player.Parent then
				continue
			end

			local state = PlayerStateService.get(player)
			if not state.HeroId then
				continue
			end

			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health <= 0 then
				continue
			end

			if character and (character:GetAttribute("IsLevitating") == true or character:GetAttribute("NewFlightActive") == true) then
				sprinting[player] = false
				continue
			end

			if humanoid.MoveDirection.Magnitude <= 0.05 then
				continue
			end

			state.Stamina = math.max(0, state.Stamina - Constants.SPRINT_STAMINA_DRAIN * dt)
			PlayerStateService.markResourceUsed(player)
			if state.Stamina <= 0 then
				sprinting[player] = false
				SprintService.applyWalkSpeed(player)
			end

			if onStatUpdate then
				onStatUpdate(player)
			end
		end
	end)
end

return SprintService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">TelekinesisService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AbilityConstants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AbilityConstants"))
local HeroRegistry = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HeroRegistry"))
local PropHelper = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PropHelper"))

local CombatService = require(script.Parent.CombatService)
local PlayerStateService = require(script.Parent.PlayerStateService)
local WandaHandParticlesService = require(script.Parent.WandaHandParticlesService)

local C = AbilityConstants
local MAX_RANGE_SQ = C.TELEKINESIS_MAX_RANGE * C.TELEKINESIS_MAX_RANGE

type TargetState = {
	root: BasePart,
	model: Model?,
	humanoid: Humanoid?,
	currentVel: Vector3,
	holdAlign: AlignPosition?,
	holdAttach: Attachment?,
}

type TelekinesisState = {
	caster: Player,
	targetRoot: BasePart,
	targetModel: Model?,
	targetHumanoid: Humanoid?,
	heldTargets: { TargetState },
	holdDistance: number,
	targetHoldDistance: number,
	holdDirection: Vector3,
	cursorWorldPos: Vector3?,
	lastDrainTime: number,
	originalWalkSpeed: number?,
	originalJumpPower: number?,
	rotateAtt: Attachment?,
	rotateAlign: AlignOrientation?,
	throwPhase: ("pull" | "launched")?,
	throwPhaseStartTime: number?,
}

local TelekinesisService = {}
local tkByPlayer: { [Player]: TelekinesisState } = {}
local updateConn: RBXScriptConnection? = nil
local onStatUpdate: ((player: Player) -> ())? = nil
local onCooldown: ((player: Player, abilityId: string, duration: number) -> ())? = nil

local function clampWorldPosToCasterRange(pos: Vector3, casterPos: Vector3, maxRange: number): Vector3
	local delta = pos - casterPos
	if delta.Magnitude > maxRange then
		return casterPos + delta.Unit * maxRange
	end
	return pos
end

local function resolveTarget(hitPart: Instance?, casterRoot: BasePart): (BasePart?, Model?, Humanoid?)
	if not hitPart or not hitPart:IsA("BasePart") then
		return nil, nil, nil
	end
	if hitPart:IsDescendantOf(casterRoot.Parent) then
		return nil, nil, nil
	end

	local parent = hitPart.Parent
	if parent and parent:IsA("Model") then
		local model = parent :: Model
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			if humanoid.Health <= 0 then
				return nil, nil, nil
			end
			local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				return root, model, humanoid
			end
		elseif PropHelper.isProp(hitPart) then
			return hitPart, nil, nil
		end
	end

	if PropHelper.isProp(hitPart) then
		return hitPart, nil, nil
	end
	return nil, nil, nil
end

local function createHoldAlign(root: BasePart): (AlignPosition, Attachment)
	local att = Instance.new("Attachment")
	att.Name = "TelekinesisHoldAttachment"
	att.Parent = root
	local align = Instance.new("AlignPosition")
	align.Name = "TelekinesisHoldAlign"
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.RigidityEnabled = false
	align.MaxForce = 250000
	align.MaxVelocity = math.huge
	align.Responsiveness = 18
	align.ApplyAtCenterOfMass = true
	align.Position = root.Position
	align.Parent = root
	return align, att
end

local function destroyHoldAlign(target: TargetState)
	if target.holdAlign then
		target.holdAlign:Destroy()
		target.holdAlign = nil
	end
	if target.holdAttach then
		target.holdAttach:Destroy()
		target.holdAttach = nil
	end
end

local function ensureRotateAlign(s: TelekinesisState, casterRoot: BasePart)
	if s.rotateAlign and s.rotateAlign.Parent and s.rotateAtt and s.rotateAtt.Parent then
		return
	end
	local att = Instance.new("Attachment")
	att.Name = "TelekinesisRotateAttachment"
	att.Parent = casterRoot
	local align = Instance.new("AlignOrientation")
	align.Name = "TelekinesisRotateAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.AlignType = Enum.AlignType.AllAxes
	align.MaxTorque = math.huge
	align.Responsiveness = C.ROTATE_ALIGN_RESPONSIVENESS
	align.CFrame = casterRoot.CFrame
	align.Parent = casterRoot
	s.rotateAtt = att
	s.rotateAlign = align
end

local function updateCasterFacing(s: TelekinesisState, casterRoot: BasePart)
	if not s.targetRoot or not s.targetRoot.Parent then
		return
	end
	ensureRotateAlign(s, casterRoot)
	local align = s.rotateAlign
	if not align or not align.Parent then
		return
	end
	local flatToTarget = Vector3.new(
		s.targetRoot.Position.X - casterRoot.Position.X,
		0,
		s.targetRoot.Position.Z - casterRoot.Position.Z
	)
	if flatToTarget.Magnitude > 0.5 then
		flatToTarget = flatToTarget.Unit
		align.CFrame = CFrame.lookAt(casterRoot.Position, casterRoot.Position + flatToTarget, Vector3.yAxis)
	end
end

local function computeThrowDir(s: TelekinesisState, targetRoot: BasePart, casterRoot: BasePart?): Vector3
	local throwDir: Vector3? = nil
	if typeof(s.cursorWorldPos) == "Vector3" and targetRoot.Parent then
		local toCursor = s.cursorWorldPos - targetRoot.Position
		if toCursor.Magnitude > 0.15 then
			throwDir = toCursor.Unit
		end
	end
	if not throwDir and s.holdDirection.Magnitude > 0.01 then
		throwDir = s.holdDirection.Unit
	end
	if not throwDir and casterRoot then
		throwDir = casterRoot.CFrame.LookVector
	end
	if not throwDir then
		throwDir = Vector3.new(0, 0, -1)
	end
	if casterRoot then
		local away = targetRoot.Position - casterRoot.Position
		if away.Magnitude > 0.5 then
			local awayUnit = away.Unit
			if throwDir:Dot(awayUnit) < 0.35 then
				throwDir = (throwDir + awayUnit * 2.5).Unit
				if throwDir:Dot(awayUnit) < 0 then
					throwDir = awayUnit
				end
			end
		end
	end
	return throwDir
end

local function clearTargetRagdoll(model: Model?, humanoid: Humanoid?)
	if model then
		model:SetAttribute("TelekinesisHeld", nil)
		model:SetAttribute("Ragdolled", nil)
	end
	if humanoid and humanoid.Parent then
		humanoid.PlatformStand = false
	end
end

local function endTelekinesisFor(plr: Player, applyCooldown: boolean, skipRagdollClear: boolean)
	local s = tkByPlayer[plr]
	if not s then
		return
	end
	tkByPlayer[plr] = nil

	local heldTargets = s.heldTargets
	local char = s.caster.Character

	if s.rotateAlign and s.rotateAlign.Parent then
		s.rotateAlign:Destroy()
	end
	if s.rotateAtt and s.rotateAtt.Parent then
		s.rotateAtt:Destroy()
	end

	if char and char.Parent then
		char:SetAttribute("IsTelekinesisActive", nil)
		char:SetAttribute("TelekinesisHoldDistance", nil)
		WandaHandParticlesService.disable(char)
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid then
			if s.originalWalkSpeed ~= nil then
				humanoid.WalkSpeed = s.originalWalkSpeed
			end
			if s.originalJumpPower ~= nil then
				humanoid.JumpPower = s.originalJumpPower
			end
		end
		if applyCooldown then
			PlayerStateService.setCooldown(plr, "Telekinesis", os.clock() + C.TELEKINESIS_COOLDOWN)
			if onCooldown then
				onCooldown(plr, "Telekinesis", C.TELEKINESIS_COOLDOWN)
			end
		end
	end

	if not skipRagdollClear then
		for _, target in heldTargets do
			clearTargetRagdoll(target.model, target.humanoid)
		end
	end

	for _, target in heldTargets do
		if target.root and target.root.Parent then
			destroyHoldAlign(target)
			if not target.humanoid then
				local wasAnchored = target.root:GetAttribute("TK_WasAnchored")
				if wasAnchored ~= nil then
					target.root.Anchored = wasAnchored
					target.root:SetAttribute("TK_WasAnchored", nil)
				end
				target.root:SetAttribute("TelekinesisHeld", nil)
				pcall(function()
					target.root:SetNetworkOwnershipAuto()
				end)
			end
		end
	end

	if onStatUpdate then
		onStatUpdate(plr)
	end
end

local function applyThrowAndLaunch(s: TelekinesisState)
	local char = s.caster.Character
	if not char or not char.Parent then
		endTelekinesisFor(s.caster, false, false)
		return
	end

	local casterRoot = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local heroId = PlayerStateService.get(s.caster).HeroId
	local heldTargets = s.heldTargets
	local thrownTargets: { { model: Model?, humanoid: Humanoid? } } = {}

	for _, target in heldTargets do
		if target.humanoid and target.humanoid.Health > 0 then
			local dmg = CombatService.computeDamage(s.caster, heroId, C.TELEKINESIS_THROW_DAMAGE)
			target.humanoid:TakeDamage(dmg)
		end

		if target.root and target.root.Parent then
			local throwDir = computeThrowDir(s, target.root, casterRoot)
			local isHumanoid = target.humanoid ~= nil
			local baseSpeed = if isHumanoid then C.TELEKINESIS_HUMANOID_THROW_SPEED else C.TELEKINESIS_OBJECT_THROW_SPEED
			local vertical = if isHumanoid then C.TELEKINESIS_HUMANOID_THROW_VERTICAL else C.TELEKINESIS_OBJECT_THROW_VERTICAL
			local vel = throwDir * baseSpeed + Vector3.new(0, vertical, 0)

			destroyHoldAlign(target)
			if isHumanoid and target.model then
				for _, part in target.model:GetDescendants() do
					if part:IsA("BasePart") then
						part.AssemblyLinearVelocity = vel
					end
				end
				target.humanoid.PlatformStand = false
			else
				target.root.AssemblyLinearVelocity = vel
				local throwMass = target.root.AssemblyMass
				pcall(function()
					target.root:ApplyImpulse(throwDir * (throwMass * baseSpeed))
				end)
			end

			if target.model and target.humanoid then
				local touchedConn: RBXScriptConnection? = nil
				local didHit = false
				touchedConn = target.root.Touched:Connect(function(hitPart)
					if didHit then
						return
					end
					local hitModel = hitPart:FindFirstAncestorOfClass("Model")
					if not hitModel or hitModel == target.model then
						return
					end
					local hitHum = hitModel:FindFirstChildOfClass("Humanoid")
					if not hitHum or hitHum.Health <= 0 then
						return
					end
					didHit = true
					if touchedConn then
						touchedConn:Disconnect()
					end
					local impactDmg = CombatService.computeDamage(s.caster, heroId, C.TELEKINESIS_THROW_IMPACT_DAMAGE)
					hitHum:TakeDamage(impactDmg)
					local hitRoot = hitModel:FindFirstChild("HumanoidRootPart") :: BasePart?
					if hitRoot then
						local pushDir = hitRoot.Position - target.root.Position
						if pushDir.Magnitude < 0.1 then
							pushDir = s.holdDirection
						end
						hitRoot:ApplyImpulse(pushDir.Unit * (hitRoot.AssemblyMass * C.TELEKINESIS_THROW_IMPACT_PUSH))
					end
					if hitModel:GetAttribute("IsShieldActive") ~= true then
						hitModel:SetAttribute("Ragdolled", true)
						task.delay(C.TELEKINESIS_THROW_IMPACT_RAGDOLL_SEC, function()
							if hitModel.Parent and hitModel:GetAttribute("Ragdolled") == true then
								hitModel:SetAttribute("Ragdolled", nil)
							end
						end)
					end
				end)
				task.delay(C.TELEKINESIS_THROW_HIT_WINDOW_SEC, function()
					if touchedConn then
						touchedConn:Disconnect()
					end
				end)
			end

			table.insert(thrownTargets, { model = target.model, humanoid = target.humanoid })
		end
	end

	s.throwPhase = "launched"
	local caster = s.caster
	task.defer(function()
		task.wait()
		if tkByPlayer[caster] then
			endTelekinesisFor(caster, true, true)
		end
		task.delay(C.TELEKINESIS_RAGDOLL_AFTER_THROW_SEC, function()
			for _, thrown in thrownTargets do
				clearTargetRagdoll(thrown.model, thrown.humanoid)
			end
		end)
	end)
end

local function canUseTelekinesis(plr: Player): boolean
	local state = PlayerStateService.get(plr)
	if not state.HeroId then
		return false
	end
	return HeroRegistry.heroOwnsAbility(state.HeroId, "Telekinesis")
end

local function tryStart(plr: Player, hitPart: Instance?, cursorAnchorPos: Vector3?): boolean
	if tkByPlayer[plr] then
		return false
	end
	if not canUseTelekinesis(plr) then
		return false
	end
	if PlayerStateService.isOnCooldown(plr, "Telekinesis") then
		return false
	end

	local char = plr.Character
	if not char or not char.Parent then
		return false
	end
	local casterRoot = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not casterRoot or not humanoid or humanoid.Health <= 0 then
		return false
	end

	local state = PlayerStateService.get(plr)
	if state.Energy < C.TELEKINESIS_ENERGY_DRAIN then
		return false
	end

	local root, targetModel, targetHumanoid = resolveTarget(hitPart, casterRoot)
	if not root or not root.Parent then
		return false
	end

	local hitPos = if hitPart and hitPart:IsA("BasePart") then hitPart.Position else root.Position
	if (hitPos - casterRoot.Position).Magnitude ^ 2 > MAX_RANGE_SQ then
		return false
	end

	local ShieldService = require(script.Parent.ShieldService)
	ShieldService.turnOff(plr)

	local initialHoldDist = C.TELEKINESIS_HOLD_DISTANCE
	local delta = root.Position - casterRoot.Position
	if delta.Magnitude > 0.05 then
		initialHoldDist = delta.Magnitude
	end
	initialHoldDist = math.clamp(initialHoldDist, C.TELEKINESIS_HOLD_DISTANCE_MIN, C.TELEKINESIS_HOLD_DISTANCE_MAX)

	local singularHoldWorld: Vector3? = nil
	if typeof(cursorAnchorPos) == "Vector3" then
		singularHoldWorld = clampWorldPosToCasterRange(cursorAnchorPos, casterRoot.Position, C.TELEKINESIS_MAX_RANGE)
	end

	local heldTargets: { TargetState } = {
		{
			root = root,
			model = targetModel,
			humanoid = targetHumanoid,
			currentVel = Vector3.zero,
		},
	}

	local s: TelekinesisState = {
		caster = plr,
		targetRoot = root,
		targetModel = targetModel,
		targetHumanoid = targetHumanoid,
		heldTargets = heldTargets,
		holdDistance = initialHoldDist,
		targetHoldDistance = initialHoldDist,
		holdDirection = delta.Magnitude > 0.05 and delta.Unit or casterRoot.CFrame.LookVector,
		cursorWorldPos = singularHoldWorld or cursorAnchorPos,
		lastDrainTime = os.clock(),
		originalWalkSpeed = humanoid.WalkSpeed,
		originalJumpPower = humanoid.JumpPower,
		rotateAtt = nil,
		rotateAlign = nil,
		throwPhase = nil,
		throwPhaseStartTime = nil,
	}
	tkByPlayer[plr] = s

	char:SetAttribute("IsTelekinesisActive", true)
	char:SetAttribute("TelekinesisHoldDistance", initialHoldDist)
	humanoid.WalkSpeed = C.TELEKINESIS_CASTER_WALK_SPEED
	humanoid.JumpPower = 0

	ensureRotateAlign(s, casterRoot)
	updateCasterFacing(s, casterRoot)

	WandaHandParticlesService.enable(char)
	WandaHandParticlesService.emit(char)

	for _, target in heldTargets do
		if target.model and target.humanoid then
			if target.model:GetAttribute("IsShieldActive") ~= true then
				target.model:SetAttribute("Ragdolled", true)
				target.model:SetAttribute("TelekinesisHeld", true)
				target.humanoid.PlatformStand = false
			end
		end
		if target.root and target.root.Parent then
			if target.humanoid then
				local align, att = createHoldAlign(target.root)
				target.holdAlign = align
				target.holdAttach = att
				target.root.AssemblyLinearVelocity = Vector3.zero
				target.root.AssemblyAngularVelocity = Vector3.zero
			else
				pcall(function()
					target.root:SetNetworkOwner(plr)
				end)
				target.root:SetAttribute("TK_WasAnchored", target.root.Anchored)
				target.root.Anchored = false
				target.root:SetAttribute("TelekinesisHeld", true)
			end
		end
	end

	humanoid.Died:Once(function()
		endTelekinesisFor(plr, false, false)
	end)
	for _, target in heldTargets do
		if target.humanoid then
			target.humanoid.Died:Once(function()
				endTelekinesisFor(plr, false, false)
			end)
		end
	end

	return true
end

local function updateDirection(
	plr: Player,
	lookX: number,
	lookY: number,
	lookZ: number,
	cursorAnchorPos: Vector3?,
	holdDistanceTarget: number?
)
	local s = tkByPlayer[plr]
	if not s then
		return
	end
	local dir = Vector3.new(lookX, lookY, lookZ)
	if dir.Magnitude < 0.01 then
		return
	end
	s.holdDirection = dir.Unit
	if typeof(cursorAnchorPos) == "Vector3" then
		s.cursorWorldPos = cursorAnchorPos
	end
	if typeof(holdDistanceTarget) == "number" then
		s.targetHoldDistance = math.clamp(holdDistanceTarget, C.TELEKINESIS_HOLD_DISTANCE_MIN, C.TELEKINESIS_HOLD_DISTANCE_MAX)
		local char = s.caster.Character
		if char then
			char:SetAttribute("TelekinesisHoldDistance", s.targetHoldDistance)
		end
	end
end

local function doThrow(plr: Player): boolean
	local s = tkByPlayer[plr]
	if not s then
		return false
	end
	if s.throwPhase == "pull" then
		return true
	end
	if not PlayerStateService.spendEnergy(plr, C.TELEKINESIS_THROW_COST) then
		return false
	end
	s.throwPhase = "pull"
	s.throwPhaseStartTime = os.clock()
	if onStatUpdate then
		onStatUpdate(plr)
	end
	return true
end

local function update(dt: number, now: number)
	for plr, s in tkByPlayer do
		local char = s.caster.Character
		if not char or not char.Parent then
			endTelekinesisFor(plr, false, false)
			continue
		end
		if char:GetAttribute("IsShieldActive") == true then
			endTelekinesisFor(plr, false, false)
			continue
		end

		local casterRoot = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not casterRoot or not s.targetRoot or not s.targetRoot.Parent then
			endTelekinesisFor(plr, false, false)
			continue
		end

		if humanoid and humanoid.Parent then
			humanoid.WalkSpeed = C.TELEKINESIS_CASTER_WALK_SPEED
			humanoid.JumpPower = 0
		end

		if s.throwPhase == "launched" then
			continue
		end

		if s.throwPhase == "pull" and typeof(s.throwPhaseStartTime) == "number" then
			if now - s.throwPhaseStartTime >= C.TELEKINESIS_THROW_PULL_DURATION then
				applyThrowAndLaunch(s)
				continue
			end
		else
			if now - s.lastDrainTime >= C.TELEKINESIS_ENERGY_INTERVAL then
				s.lastDrainTime = now
				local state = PlayerStateService.get(plr)
				state.Energy = math.max(0, state.Energy - C.TELEKINESIS_ENERGY_DRAIN)
				PlayerStateService.markResourceUsed(plr)
				if state.Energy <= 0 then
					endTelekinesisFor(plr, false, false)
					if onStatUpdate then
						onStatUpdate(plr)
					end
					continue
				end
				if onStatUpdate then
					onStatUpdate(plr)
				end
			end
		end

		updateCasterFacing(s, casterRoot)

		local holdDist = C.TELEKINESIS_HOLD_DISTANCE
		if s.throwPhase == "pull" then
			holdDist = C.TELEKINESIS_THROW_PULL_DISTANCE
		else
			local alpha = math.min(1, dt * C.TELEKINESIS_HOLD_DISTANCE_LERP_SPEED)
			s.holdDistance = s.holdDistance + (s.targetHoldDistance - s.holdDistance) * alpha
			holdDist = s.holdDistance
		end

		local holdAnchor = casterRoot.Position + s.holdDirection * holdDist
		holdAnchor = clampWorldPosToCasterRange(holdAnchor, casterRoot.Position, C.TELEKINESIS_MAX_RANGE)

		for _, target in s.heldTargets do
			if not (target.root and target.root.Parent) then
				continue
			end
			if not target.humanoid then
				target.root.Anchored = false
			end

			local desiredPos = holdAnchor
			if target.holdAlign then
				target.holdAlign.Position = desiredPos
				target.root.AssemblyAngularVelocity = Vector3.zero
			else
				local toDesired = desiredPos - target.root.Position
				local dist = toDesired.Magnitude
				local desiredVel = Vector3.zero
				if dist > 0.35 then
					local speed = math.min(C.TELEKINESIS_HOLD_SPEED, dist * 5)
					desiredVel = toDesired.Unit * speed
				end
				desiredVel += Vector3.new(0, workspace.Gravity * dt, 0)
				local diff = desiredVel - target.currentVel
				local maxStep = dt * C.TELEKINESIS_HOLD_ACCEL
				local step = if diff.Magnitude <= maxStep then diff else diff.Unit * maxStep
				target.currentVel = target.currentVel + step
				target.root.AssemblyLinearVelocity = target.currentVel
			end
		end
	end
end

function TelekinesisService.setup(
	telekinesisRequest: RemoteEvent,
	telekinesisUpdate: RemoteEvent,
	telekinesisThrow: RemoteEvent,
	telekinesisEnd: RemoteEvent,
	statUpdateCallback: (player: Player) -> (),
	cooldownCallback: (player: Player, abilityId: string, duration: number) -> ()
)
	onStatUpdate = statUpdateCallback
	onCooldown = cooldownCallback

	telekinesisRequest.OnServerEvent:Connect(function(plr: Player, hitPart: Instance?, cursorX: number?, cursorY: number?, cursorZ: number?)
		local cursorPos: Vector3? = nil
		if typeof(cursorX) == "number" and typeof(cursorY) == "number" and typeof(cursorZ) == "number" then
			cursorPos = Vector3.new(cursorX, cursorY, cursorZ)
		end
		tryStart(plr, hitPart, cursorPos)
	end)

	telekinesisUpdate.OnServerEvent:Connect(function(plr: Player, lookX: number, lookY: number, lookZ: number, cursorX: number?, cursorY: number?, cursorZ: number?, holdDist: number?)
		local cursorPos: Vector3? = nil
		if typeof(cursorX) == "number" and typeof(cursorY) == "number" and typeof(cursorZ) == "number" then
			cursorPos = Vector3.new(cursorX, cursorY, cursorZ)
		end
		updateDirection(plr, lookX, lookY, lookZ, cursorPos, holdDist)
	end)

	telekinesisThrow.OnServerEvent:Connect(function(plr: Player)
		doThrow(plr)
	end)

	telekinesisEnd.OnServerEvent:Connect(function(plr: Player)
		local s = tkByPlayer[plr]
		if not s then
			return
		end
		if s.throwPhase == "pull" then
			return
		end
		endTelekinesisFor(plr, true, false)
	end)
end

function TelekinesisService.startUpdateLoop()
	if updateConn then
		return
	end
	updateConn = RunService.Heartbeat:Connect(function(dt)
		update(dt, os.clock())
	end)
end

function TelekinesisService.cleanupPlayer(player: Player)
	endTelekinesisFor(player, false, false)
end

function TelekinesisService.isActive(player: Player): boolean
	return tkByPlayer[player] ~= nil
end

return TelekinesisService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">WandaHandParticlesService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Clone Assets.WandaMaximoff.HandParticles onto both hands and toggle while abilities are active.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AbilityConstants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AbilityConstants"))
local PlayerStateService = require(script.Parent.PlayerStateService)

local C = AbilityConstants

local ensuredChars: { [Model]: boolean } = {}
local refCountByChar: { [Model]: number } = {}
local savedRates: { [ParticleEmitter]: number } = {}

local WandaHandParticlesService = {}

local function isWandaPlayer(plr: Player): boolean
	return PlayerStateService.get(plr).HeroId == "Wanda"
end

local function isWandaCharacter(char: Model): boolean
	local plr = Players:GetPlayerFromCharacter(char)
	return plr ~= nil and isWandaPlayer(plr)
end

local function getTemplate(): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local wanda = assets and assets:FindFirstChild("WandaMaximoff")
	return wanda and wanda:FindFirstChild("HandParticles")
end

local function findBothHands(char: Model): { BasePart }
	local hands: { BasePart } = {}
	local right = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	local left = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
	if right and right:IsA("BasePart") then
		table.insert(hands, right)
	end
	if left and left:IsA("BasePart") and left ~= right then
		table.insert(hands, left)
	end
	return hands
end

local function getHandEffectEmitters(char: Model): { ParticleEmitter }
	local emitters: { ParticleEmitter } = {}
	local seen: { [ParticleEmitter]: boolean } = {}
	for _, hand in findBothHands(char) do
		for _, desc in hand:GetDescendants() do
			if desc:IsA("ParticleEmitter") and not seen[desc] then
				seen[desc] = true
				table.insert(emitters, desc)
			end
		end
	end
	return emitters
end

local function setHandParticlesEnabled(char: Model, enabled: boolean, smooth: boolean)
	local emitters = getHandEffectEmitters(char)
	if #emitters == 0 then
		return
	end

	for _, hand in findBothHands(char) do
		for _, desc in hand:GetDescendants() do
			if desc:IsA("Beam") then
				desc.Enabled = enabled
			end
		end
	end

	for _, em in emitters do
		if not savedRates[em] and em.Rate > 0 then
			savedRates[em] = em.Rate
		end
		local targetRate = savedRates[em] or 20
		if enabled then
			em.Enabled = true
			if smooth then
				em.Rate = 0
				local start = os.clock()
				local conn: RBXScriptConnection
				conn = RunService.Heartbeat:Connect(function()
					if not em.Parent then
						conn:Disconnect()
						return
					end
					local t = math.min(1, (os.clock() - start) / C.WANDA_HAND_EFFECT_FADE_TIME)
					em.Rate = t * targetRate
					if t >= 1 then
						conn:Disconnect()
					end
				end)
			else
				em.Rate = targetRate
			end
		elseif smooth then
			local startRate = em.Rate
			local start = os.clock()
			local conn: RBXScriptConnection
			conn = RunService.Heartbeat:Connect(function()
				if not em.Parent then
					conn:Disconnect()
					return
				end
				local t = math.min(1, (os.clock() - start) / C.WANDA_HAND_EFFECT_FADE_TIME)
				em.Rate = startRate * (1 - t)
				if t >= 1 then
					em.Enabled = false
					em.Rate = targetRate
					conn:Disconnect()
				end
			end)
		else
			em.Enabled = false
			em.Rate = targetRate
		end
	end
end

local function shouldKeepHandParticles(char: Model): boolean
	return char:GetAttribute("IsChaosBeamActive") == true
		or char:GetAttribute("IsTelekinesisActive") == true
		or char:GetAttribute("IsShieldActive") == true
		or char:GetAttribute("NewFlightActive") == true
end

function WandaHandParticlesService.ensure(char: Model)
	if not isWandaCharacter(char) then
		return
	end
	if ensuredChars[char] then
		return
	end

	local template = getTemplate()
	if not template then
		warn("[WandaHandParticlesService] Missing Assets.WandaMaximoff.HandParticles")
		return
	end

	for _, hand in findBothHands(char) do
		local keepOne = false
		for _, child in hand:GetChildren() do
			if child.Name == "HandParticles" then
				if keepOne then
					child:Destroy()
				else
					keepOne = true
				end
			end
		end
		if not hand:FindFirstChild("HandParticles") then
			local clone = template:Clone()
			clone.Name = "HandParticles"
			clone.Parent = hand
		end
	end

	ensuredChars[char] = true
	setHandParticlesEnabled(char, false, false)
end

function WandaHandParticlesService.getHandAttachment(handPart: BasePart): Attachment?
	local inst = handPart:FindFirstChild("HandParticles")
	if not inst then
		return nil
	end
	if inst:IsA("Attachment") then
		return inst
	end
	local att = inst:FindFirstChildWhichIsA("Attachment", true)
	if att then
		return att
	end
	return nil
end

function WandaHandParticlesService.enable(char: Model)
	if not isWandaCharacter(char) then
		return
	end
	WandaHandParticlesService.ensure(char)
	refCountByChar[char] = (refCountByChar[char] or 0) + 1
	if refCountByChar[char] == 1 then
		setHandParticlesEnabled(char, true, true)
	end
end

function WandaHandParticlesService.disable(char: Model)
	if not isWandaCharacter(char) then
		return
	end
	local count = refCountByChar[char]
	if not count or count <= 0 then
		return
	end
	refCountByChar[char] = count - 1
	if refCountByChar[char] == 0 then
		refCountByChar[char] = nil
		if shouldKeepHandParticles(char) then
			return
		end
		setHandParticlesEnabled(char, false, true)
	end
end

function WandaHandParticlesService.emit(char: Model, count: number?)
	if not isWandaCharacter(char) then
		return
	end
	WandaHandParticlesService.ensure(char)
	local n = count or C.WANDA_HAND_EMIT_ON_POWER_USE
	for _, em in getHandEffectEmitters(char) do
		pcall(function()
			em:Emit(n)
		end)
	end
end

function WandaHandParticlesService.onInstantAbility(char: Model)
	if not isWandaCharacter(char) then
		return
	end
	WandaHandParticlesService.enable(char)
	WandaHandParticlesService.emit(char)
	task.delay(C.WANDA_HAND_INSTANT_ABILITY_DURATION, function()
		if char.Parent then
			WandaHandParticlesService.disable(char)
		end
	end)
end

function WandaHandParticlesService.cleanupCharacter(char: Model)
	ensuredChars[char] = nil
	refCountByChar[char] = nil
	setHandParticlesEnabled(char, false, false)
end

function WandaHandParticlesService.cleanupPlayer(player: Player)
	local char = player.Character
	if char then
		WandaHandParticlesService.cleanupCharacter(char)
	end
end

return WandaHandParticlesService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="32">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">MjolnirFactory</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))

local MjolnirFactory = {}

local cachedTemplate: Instance? = nil

local function getTemplate(): Instance?
	if cachedTemplate then
		return cachedTemplate
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		return nil
	end
	local thor = assets:FindFirstChild("Thor")
	if not thor then
		return nil
	end
	local mjolnir = thor:FindFirstChild("Mjolnir")
	if not mjolnir then
		return nil
	end
	cachedTemplate = mjolnir
	return mjolnir
end

local function getRightHand(character: Model): BasePart?
	return character:FindFirstChild("RightHand") :: BasePart?
		or character:FindFirstChild("Right Arm") :: BasePart?
end

function MjolnirFactory.createWieldModel(character: Model): Model?
	local template = getTemplate()
	if not template then
		warn("[MjolnirFactory] ReplicatedStorage.Assets.Thor.Mjolnir not found")
		return nil
	end

	local hand = getRightHand(character)
	if not hand then
		return nil
	end

	local model = Instance.new("Model")
	model.Name = "MjolnirWield"

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.2, 0.2, 0.2)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.Massless = true
	handle.Anchored = false
	handle.CFrame = hand.CFrame * Constants.MJOLNIR_GRIP_OFFSET
	handle.Parent = model

	local meshClone = template:Clone()
	meshClone.Parent = model

	if meshClone:IsA("MeshPart") then
		meshClone.Anchored = false
		meshClone.CanCollide = false
		meshClone.Massless = true
		meshClone.CFrame = handle.CFrame * Constants.MJOLNIR_GRIP_OFFSET:Inverse()
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = meshClone
		weld.Parent = handle
		model.PrimaryPart = handle
	elseif meshClone:IsA("BasePart") then
		meshClone.Anchored = false
		meshClone.CanCollide = false
		meshClone.Massless = true
		meshClone.CFrame = handle.CFrame
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = meshClone
		weld.Parent = handle
		model.PrimaryPart = handle
	elseif meshClone:IsA("Model") then
		local part = meshClone:FindFirstChildWhichIsA("BasePart", true)
		if part then
			part.Anchored = false
			part.CanCollide = false
			for _, desc in meshClone:GetDescendants() do
				if desc:IsA("BasePart") then
					desc.Anchored = false
					desc.CanCollide = false
					desc.Massless = true
				end
			end
			handle.CFrame = hand.CFrame * Constants.MJOLNIR_GRIP_OFFSET
			part.CFrame = handle.CFrame
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = part
			weld.Parent = handle
			model.PrimaryPart = handle
		end
	end

	local handWeld = Instance.new("WeldConstraint")
	handWeld.Part0 = hand
	handWeld.Part1 = handle
	handWeld.Parent = handle

	model.Parent = character
	return model
end

function MjolnirFactory.throwAndReturn(character: Model, direction: Vector3, onComplete: (() -> ())?)
	local wield = MjolnirFactory.createWieldModel(character)
	if not wield then
		if onComplete then
			onComplete()
		end
		return
	end

	local handle = wield:FindFirstChild("Handle") :: BasePart?
	local hand = getRightHand(character)
	if not handle or not hand then
		wield:Destroy()
		if onComplete then
			onComplete()
		end
		return
	end

	for _, child in handle:GetChildren() do
		if child:IsA("WeldConstraint") and (child :: WeldConstraint).Part0 == hand then
			child:Destroy()
		end
	end

	local dir = if direction.Magnitude > 0 then direction.Unit else character:GetPivot().LookVector
	handle.AssemblyLinearVelocity = dir * 100

	task.delay(Constants.MJOLNIR_THROW_DURATION, function()
		if wield.Parent then
			wield:Destroy()
		end
		MjolnirFactory.createWieldModel(character)
		if onComplete then
			onComplete()
		end
	end)
end

function MjolnirFactory.cleanup(character: Model)
	local existing = character:FindFirstChild("MjolnirWield")
	if existing then
		existing:Destroy()
	end
end

return MjolnirFactory
]]></string>
