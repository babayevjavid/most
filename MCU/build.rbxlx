	local tooltipConn: RBXScriptConnection? = nil

	local function hideTooltip()
		tooltip.Visible = false
		if tooltipConn then
			tooltipConn:Disconnect()
			tooltipConn = nil
		end
	end

	local function showTooltip(abilityName: string, description: string)
		tooltipTitle.Text = abilityName
		tooltipBody.Text = description
		tooltip.Visible = true
		if tooltipConn then
			tooltipConn:Disconnect()
		end
		tooltipConn = RunService.RenderStepped:Connect(function()
			-- Keep status tooltips live while hovered
			if hoveredStatus == "absorb" then
				local title, body = buildAbsorbTooltip()
				tooltipTitle.Text = title
				tooltipBody.Text = body
			elseif hoveredStatus == "binary" then
				local title, body = buildBinaryTooltip()
				tooltipTitle.Text = title
				tooltipBody.Text = body
			elseif hoveredStatus == "ragdoll" then
				local title, body = buildRagdollTooltip()
				tooltipTitle.Text = title
				tooltipBody.Text = body
			end
			local mouse = player:GetMouse()
			local cam = workspace.CurrentCamera
			local vs = if cam then cam.ViewportSize else Vector2.new(1920, 1080)
			tooltip.Position = UDim2.fromScale(
				math.clamp((mouse.X + 18) / vs.X, 0, 0.8),
				math.clamp((mouse.Y + 18) / vs.Y, 0, 0.8)
			)
		end)
	end

	local function clearSlots(slots: { AbilitySlot })
		for _, slot in slots do
			if slot.holder.Parent then
				slot.holder:Destroy()
			elseif slot.btn.Parent then
				slot.btn:Destroy()
			end
		end
		table.clear(slots)
	end

	local function createAbilityButton(
		parent: Frame,
		name: string,
		displayName: string,
		description: string,
		key: string,
		layoutOrder: number,
		abilityId: string?,
		cooldownSeconds: number?,
		size: UDim2?,
		suppressActiveEllipsis: boolean?,
		_iconAsset: string?
	): AbilitySlot
		-- Name lives inside the button; keybind sits on the top-right corner
		local holder = Instance.new("Frame")
		holder.Name = name .. "Slot"
		holder.LayoutOrder = layoutOrder
		holder.Size = size or UDim2.fromScale(0.118, 0.92)
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.ClipsDescendants = false
		holder.Parent = parent

		local btn = Instance.new("TextButton")
		btn.Name = name
		btn.AnchorPoint = Vector2.new(0.5, 0.5)
		btn.Position = UDim2.fromScale(0.5, 0.5)
		btn.Size = UDim2.fromScale(1, 1)
		btn.BackgroundColor3 = THEME.btn
		btn.AutoButtonColor = false
		btn.Text = ""
		btn.ClipsDescendants = true
		btn.ZIndex = 2
		btn.Parent = holder
		addCorner(btn, 0.12)

		local aspect = Instance.new("UIAspectRatioConstraint")
		aspect.AspectRatio = 1
		aspect.Parent = btn

		local stroke = Instance.new("UIStroke")
		stroke.Color = THEME.stroke
		stroke.Thickness = 1
		stroke.Transparency = 0.35
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = btn

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "AbilityName"
		nameLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		nameLabel.Position = UDim2.fromScale(0.5, 0.5)
		nameLabel.Size = UDim2.fromScale(0.75, 0.75)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Font = Enum.Font.Bangers
		nameLabel.Text = displayName
		nameLabel.TextColor3 = Color3.fromRGB(238, 230, 232)
		nameLabel.TextScaled = true
		nameLabel.TextWrapped = true
		nameLabel.TextXAlignment = Enum.TextXAlignment.Center
		nameLabel.TextYAlignment = Enum.TextYAlignment.Center
		nameLabel.ZIndex = 3
		nameLabel.Parent = btn
		nameLabel:SetAttribute("AbilityNameLabel", true)

		local nameStroke = Instance.new("UIStroke")
		nameStroke.Thickness = 1.2
		nameStroke.Color = Color3.fromRGB(0, 0, 0)
		nameStroke.Transparency = 0.35
		nameStroke.Parent = nameLabel

		if type(key) == "string" and key ~= "" then
			createKeyBadge(btn, key)
		end

		local cooldownOverlay, cooldownLabel = createCooldownOverlay(btn)

		btn.MouseEnter:Connect(function()
			btn.BackgroundColor3 = THEME.btnHover
			showTooltip(displayName, description)
		end)
		btn.MouseLeave:Connect(function()
			btn.BackgroundColor3 = THEME.btn
			hideTooltip()
		end)

		return {
			holder = holder,
			btn = btn,
			nameLabel = nameLabel,
			iconImage = nil,
			cooldownOverlay = cooldownOverlay,
			cooldownLabel = cooldownLabel,
			abilityId = abilityId,
			cooldownSeconds = cooldownSeconds,
			suppressActiveEllipsis = suppressActiveEllipsis == true,
		}
	end

	if not useStarterGui then
		hairCosmetic = createHairCosmeticSlot(
			root,
			THEME.btn,
			THEME.btnHover,
			THEME.stroke,
			showTooltip,
			hideTooltip,
			function()
				AbilityInput.triggerFromHud("J")
			end
		)
	elseif hairCosmetic.btn then
		hairCosmetic.btn.MouseButton1Click:Connect(function()
			AbilityInput.triggerFromHud("J")
		end)
		hairCosmetic.btn.MouseEnter:Connect(function()
			hairCosmetic.btn.BackgroundColor3 = THEME.btnHover
			showTooltip("Hair", "Toggle Jean Grey hair style.")
		end)
		hairCosmetic.btn.MouseLeave:Connect(function()
			hairCosmetic.btn.BackgroundColor3 = THEME.btn
			hideTooltip()
		end)
	end

	local function refreshHairSlot()
		local char = boundCharacter
		local look = if char then char:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) else nil
		hairCosmetic.slot.Visible = currentHeroId == "jean_grey" and look ~= "marvel_girl"
	end

	local function updateSlotCooldowns(slots: { AbilitySlot })
		local character = boundCharacter
		if not character or not character.Parent then
			return
		end
		for _, slot in slots do
			if not slot.abilityId or not slot.cooldownSeconds then
				slot.cooldownOverlay.Visible = false
				slot.cooldownLabel.Visible = false
				continue
			end
			local remaining = AbilityCooldownHelper.getRemaining(character, slot.abilityId)
			local active = AbilityCooldownHelper.isActive(character, slot.abilityId)
			local hairLocked = currentHeroId == "jean_grey"
				and character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) ~= "marvel_girl"
				and character:GetAttribute(GameConstants.MG_HAIR_TIED_ATTRIBUTE) ~= true
				and (
					slot.abilityId == "mind_link"
					or slot.abilityId == "astral_projection"
				)
			local controlLocked = currentHeroId == "scarlet_witch"
				and character:GetAttribute(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE) == true
			local teleportAiming = character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true
				and (slot.abilityId == "teleportation" or slot.abilityId == "trickster_dash" or slot.abilityId == "hex_displacement")
			if remaining > 0 then
				slot.cooldownOverlay.BackgroundTransparency = 0.15
				slot.cooldownOverlay.Visible = true
				slot.cooldownOverlay.Size = UDim2.fromScale(1, math.clamp(remaining / slot.cooldownSeconds, 0, 1))
				slot.cooldownLabel.Visible = true
				slot.cooldownLabel.Text = string.format("%.1f", remaining)
				slot.nameLabel.TextTransparency = 0
			elseif controlLocked then
				local untilTime = character:GetAttribute(GameConstants.SW_CONTROL_LOCK_UNTIL_ATTRIBUTE)
				local lockLeft = 0
				if type(untilTime) == "number" then
					lockLeft = math.max(0, untilTime - AbilityCooldownHelper.getNow())
				end
				slot.cooldownOverlay.BackgroundTransparency = 0.18
				slot.cooldownOverlay.Visible = true
				slot.cooldownOverlay.Size = UDim2.fromScale(1, 1)
				slot.btn.BackgroundColor3 = Color3.fromRGB(42, 36, 40)
				slot.nameLabel.TextTransparency = 0.5
				if lockLeft > 0.05 then
					slot.cooldownLabel.Visible = true
					slot.cooldownLabel.Text = string.format("%.1f", lockLeft)
				else
					slot.cooldownLabel.Visible = false
				end
			elseif hairLocked then
				slot.cooldownOverlay.BackgroundTransparency = 0.22
				slot.cooldownOverlay.Visible = true
				slot.cooldownOverlay.Size = UDim2.fromScale(1, 1)
				slot.cooldownLabel.Visible = false
				slot.btn.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
				slot.nameLabel.TextTransparency = 0.45
			elseif teleportAiming then
				-- Aim-select: stronger dark fill (distinct from casting …)
				slot.cooldownOverlay.BackgroundTransparency = 0.28
				slot.cooldownOverlay.Visible = true
				slot.cooldownOverlay.Size = UDim2.fromScale(1, 1)
				slot.cooldownLabel.Visible = false
			elseif active then
				slot.cooldownOverlay.BackgroundTransparency = 0.18
				slot.cooldownOverlay.Visible = true
				slot.cooldownOverlay.Size = UDim2.fromScale(1, 1)
				slot.cooldownLabel.Visible = false
				slot.btn.BackgroundColor3 = Color3.fromRGB(42, 36, 40)
				slot.nameLabel.TextTransparency = 0.5
			else
				slot.cooldownOverlay.BackgroundTransparency = 0.15
				slot.cooldownOverlay.Visible = false
				slot.cooldownLabel.Visible = false
				slot.nameLabel.TextTransparency = 0
				slot.btn.BackgroundColor3 = THEME.btn
			end
		end
	end

	local function applyTheme(heroId: string)
		local src = THEME_SCARLET
		local character = boundCharacter
		if heroId == "captain_marvel" then
			src = THEME_MARVEL
		elseif heroId == "loki" then
			src = THEME_LOKI
		elseif heroId == "dagger" then
			src = THEME_DAGGER
		elseif heroId == "jean_grey" then
			local skinId = if character then character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) else nil
			src = if skinId == "phoenix"
				then THEME_PHOENIX
				else (if skinId == "marvel_girl" then THEME_MARVEL_GIRL else THEME_JEAN_97)
		elseif heroId == "iceman" then
			src = THEME_ICEMAN
		elseif heroId == "invisible_woman" then
			src = THEME_IW
		end
		for key, value in src do
			THEME[key] = value
		end

		local function paintBg(gui: Instance?, color: Color3)
			if gui and gui:IsA("GuiObject") then
				gui.BackgroundColor3 = color
			end
		end
		local function paintStroke(stroke: UIStroke?, color: Color3)
			if stroke then
				stroke.Color = color
			end
		end
		local function paintText(label: TextLabel?, color: Color3)
			if label then
				label.TextColor3 = color
			end
		end

		paintBg(viewportHolder, THEME.barBg)
		paintBg(viewport, THEME.viewportBg)
		paintStroke(vpStroke, THEME.stroke)
		paintBg(profilePanel, THEME.panel)
		paintStroke(profileStroke, THEME.stroke)
		paintBg(abilityBar, THEME.abilityBar)
		paintStroke(abilityStroke, THEME.stroke)
		local phoenix = heroId == "jean_grey"
			and character
			and character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "phoenix"
		if abilityBar then
			abilityBar.BackgroundTransparency = if phoenix then 1 else 0.12
		end
		if abilityStroke then
			abilityStroke.Transparency = if phoenix then 1 else 0.4
		end
		if hairCosmetic then
			hairCosmetic.btn.BackgroundColor3 = THEME.btn
			if hairCosmetic.stroke then
				hairCosmetic.stroke.Color = THEME.stroke
			end
		end
		paintBg(tooltip, THEME.panel)
		paintStroke(tooltipStroke, THEME.stroke)
		paintBg(tooltipRule, THEME.stroke)
		paintText(tooltipTitle, THEME.panelTitle)
		paintBg(energyFill, THEME.energy)
		paintBg(restraintBar, THEME.abilityBar)
		paintStroke(restraintStroke, THEME.stroke)
		paintBg(restraintFill, THEME.energy)
		paintText(restraintLabel, THEME.panelTitle)
		refreshSoftLockToggle()

		local abilityNameColor = if heroId == "dagger"
			then Color3.fromRGB(255, 255, 255)
			elseif heroId == "jean_grey" then
				(if character and character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "phoenix"
					then Color3.fromRGB(255, 140, 95)
					else (if character and character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) == "marvel_girl"
						then Color3.fromRGB(255, 170, 220)
						else Color3.fromRGB(170, 185, 255)))
			elseif heroId == "iceman" then Color3.fromRGB(200, 225, 255)
			elseif heroId == "invisible_woman" then Color3.fromRGB(77, 71, 255)
			else Color3.fromRGB(238, 230, 232)
		local keyTextColor = Color3.fromRGB(250, 250, 252)
		for _, slot in abilitySlots do
			if slot.nameLabel then
				slot.nameLabel.TextColor3 = abilityNameColor
			end
			local badge = slot.btn:FindFirstChild("KeyBadge")
			if badge then
				local keyLabel = badge:FindFirstChild("KeyLabel")
				if keyLabel and keyLabel:IsA("TextLabel") then
					keyLabel.TextColor3 = keyTextColor
				end
			end
		end
		for _, slot in extraSlots do
			if slot.nameLabel then
				slot.nameLabel.TextColor3 = abilityNameColor
			end
			local badge = slot.btn:FindFirstChild("KeyBadge")
			if badge then
				local keyLabel = badge:FindFirstChild("KeyLabel")
				if keyLabel and keyLabel:IsA("TextLabel") then
					keyLabel.TextColor3 = keyTextColor
				end
			end
		end
		if hairCosmetic then
			hairCosmetic.nameLabel.TextColor3 = abilityNameColor
			hairCosmetic.btn.BackgroundColor3 = THEME.btn
		end

		for _, panel in scarletModePanels do
			panel.BackgroundColor3 = THEME.panel
			local stroke = panel:FindFirstChild("ThemeStroke")
			if stroke and stroke:IsA("UIStroke") then
				stroke.Color = THEME.stroke
			end
			local title = panel:FindFirstChild("Title")
			if title and title:IsA("TextLabel") then
				title.TextColor3 = THEME.panelTitle
			end
		end
		for _, panel in marvelModePanels do
			panel.BackgroundColor3 = THEME.panel
			local stroke = panel:FindFirstChild("ThemeStroke")
			if stroke and stroke:IsA("UIStroke") then
				stroke.Color = THEME.stroke
			end
			local title = panel:FindFirstChild("Title")
			if title and title:IsA("TextLabel") then
				title.TextColor3 = THEME.panelTitle
			end
		end
		for _, panel in lokiModePanels do
			panel.BackgroundColor3 = THEME.panel
			local stroke = panel:FindFirstChild("ThemeStroke")
			if stroke and stroke:IsA("UIStroke") then
				stroke.Color = THEME.stroke
			end
			local title = panel:FindFirstChild("Title")
			if title and title:IsA("TextLabel") then
				title.TextColor3 = THEME.panelTitle
			end
		end
		if lokiClonePanel then
			lokiClonePanel.BackgroundColor3 = THEME.panel
			local stroke = lokiClonePanel:FindFirstChild("ThemeStroke")
			if stroke and stroke:IsA("UIStroke") then
				stroke.Color = THEME.stroke
			end
			local title = lokiClonePanel:FindFirstChild("Title")
			if title and title:IsA("TextLabel") then
				title.TextColor3 = THEME.panelTitle
			end
		end
		local lokiUltPanelInst = root:FindFirstChild("LokiUltPanel")
		if lokiUltPanelInst and lokiUltPanelInst:IsA("Frame") then
			lokiUltPanelInst.BackgroundColor3 = THEME.panel
			local stroke = lokiUltPanelInst:FindFirstChild("ThemeStroke")
			if stroke and stroke:IsA("UIStroke") then
				stroke.Color = THEME.stroke
			end
			local title = lokiUltPanelInst:FindFirstChild("Title")
			if title and title:IsA("TextLabel") then
				title.TextColor3 = THEME.panelTitle
			end
		end
		if daggerAlliesPanel then
			paintBg(daggerAlliesPanel, THEME.panel)
			local daggerStroke = daggerAlliesPanel:FindFirstChild("ThemeStroke")
			if daggerStroke and daggerStroke:IsA("UIStroke") then
				daggerStroke.Color = THEME.stroke
			end
			local daggerTitle = daggerAlliesPanel:FindFirstChild("Title")
			if daggerTitle and daggerTitle:IsA("TextLabel") then
				daggerTitle.TextColor3 = THEME.panelTitle
			end
			local daggerAdd = daggerAlliesPanel:FindFirstChild("AddAlly")
			if daggerAdd and daggerAdd:IsA("GuiObject") then
				daggerAdd.BackgroundColor3 = THEME.modeOn
			end
		end
		if settingsPanel then
			paintBg(settingsPanel, THEME.panel)
			paintStroke(settingsStroke, THEME.stroke)
			paintStroke(settingsBtnStroke, THEME.stroke)
			local settingsTitleLabel = settingsPanel:FindFirstChild("Title")
			if settingsTitleLabel and settingsTitleLabel:IsA("TextLabel") then
				settingsTitleLabel.TextColor3 = THEME.panelTitle
			end
			refreshShoulderSettingsUi()
		end
	end

	local function rebuildAbilityBar(heroId: string)
		clearSlots(abilitySlots)
		clearSlots(extraSlots)
		hideTooltip()
		applyTheme(heroId)

		local abilities = CharacterRegistry.getAbilities(heroId)
		local main: { any } = {}
		local extras: { any } = {}
		local inJeanAstral = heroId == "jean_grey"
			and boundCharacter
			and boundCharacter:GetAttribute(GameConstants.MG_ASTRAL_BODY_ATTRIBUTE) == true
		for _, ability in abilities do
			-- Show cooldown passives on the main bar (e.g. Chaos Impact)
			if ability.passive == true then
				if not inJeanAstral and ability.cooldown > 0 and type(ability.key) == "string" and ability.key ~= "" then
					table.insert(main, ability)
				end
				continue
			end
			if type(ability.key) ~= "string" or ability.key == "" then
				continue
			end
			if inJeanAstral then
				if ability.sideBar and ability.astralOnly == true then
					table.insert(extras, ability)
				end
				continue
			end
			if ability.sideBar then
				if ability.astralOnly == true then
					local inAstral = boundCharacter
						and boundCharacter:GetAttribute(GameConstants.MG_ASTRAL_BODY_ATTRIBUTE) == true
					if not inAstral then
						continue
					end
				end
				if ability.id == "forcefield_choke" or ability.id == "forcefield_protect" then
					local areaOn = boundCharacter
						and AbilityCooldownHelper.isActive(boundCharacter, "forcefield_area")
					if not areaOn then
						continue
					end
				end
				table.insert(extras, ability)
			else
				table.insert(main, ability)
			end
		end
		table.sort(main, function(a, b)
			local ka = KEY_ORDER[a.key] or (if a.passive then 90 else 99)
			local kb = KEY_ORDER[b.key] or (if b.passive then 90 else 99)
			return ka < kb
		end)

		local mainCount = #main
		local pad = 0.012
		local slotWidth = if mainCount > 0
			then math.min(0.118, (0.96 - pad * math.max(mainCount - 1, 0)) / mainCount)
			else 0.118

		local function wireAbilityButton(slot: AbilitySlot, ability: any)
			if ability.passive == true or type(ability.key) ~= "string" or ability.key == "" then
				return
			end
			local key = ability.key
			local isHold = ability.hold == true
			-- Activated works for mouse + touch (mobile)
			slot.btn.Activated:Connect(function()
				local character = player.Character
				if character and AbilityCooldownHelper.isActive(character, ability.id) and ability.id == "rune_entrapment" then
					return
				end
				if character and AbilityCooldownHelper.isOnCooldown(character, ability.id) then
					local allowCancel = (
						ability.id == "shapeshift"
						and character:GetAttribute(GameConstants.LOKI_SHAPESHIFT_ATTRIBUTE) == true
					)
						or (
							isHold
							and AbilityCooldownHelper.isActive(character, ability.id)
						)
						or (
							ability.id == "telekinesis"
							and character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true
						)
						or (
							(ability.id == "teleportation" or ability.id == "trickster_dash" or ability.id == "hex_displacement")
							and character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true
						)
						or (
							ability.id == "forcefield_area"
							and AbilityCooldownHelper.isActive(character, ability.id)
						)
					if not allowCancel then
						return
					end
				end
				AbilityInput.triggerFromHud(key, isHold)
			end)
		end

		for i, ability in main do
			local cd = ability.cooldown
			local mode: string? = nil
			if ability.id == "hex_blast" then
				mode = if boundCharacter then boundCharacter:GetAttribute(GameConstants.HEX_BLAST_MODE_ATTRIBUTE) else "Single"
				if mode ~= "Barrage" then
					mode = "Single"
				end
				cd = if mode == "Barrage"
					then GameConstants.HEX_BLAST_BARRAGE_COOLDOWN
					else GameConstants.HEX_BLAST_SINGLE_COOLDOWN
			elseif ability.id == "telekinesis" then
				mode = if boundCharacter then boundCharacter:GetAttribute(GameConstants.TK_MODE_ATTRIBUTE) else "Single"
				if mode ~= "Multiple" and mode ~= "Torture" then
					mode = "Single"
				end
			elseif ability.id == "trickster_dash" then
				mode = if boundCharacter then boundCharacter:GetAttribute(GameConstants.LOKI_DASH_MODE_ATTRIBUTE) else "Dash"
				if mode ~= "Teleport" then
					mode = "Dash"
				end
			end
			-- Hold / lasting abilities: no "…" while active
			local suppressEllipsis = ability.hold == true
				or ability.id == "shapeshift"
				or ability.id == "god_of_mischief"
				or ability.id == "binary_form"
				or ability.id == "illusion_decoy"
				or ability.id == "teleportation"
				or ability.id == "hex_displacement"
				or ability.id == "trickster_dash"
				or ability.id == "forcefield_area"
				or ability.id == "forcefield_choke"
				or ability.id == "forcefield_protect"
			local slot = createAbilityButton(
				abilityRow,
				ability.id,
				ability.name,
				ability.description,
				ability.key,
				i,
				ability.id,
				cd,
				UDim2.fromScale(slotWidth, 0.92),
				suppressEllipsis,
				CharacterRegistry.resolveAbilityIcon(ability, mode)
			)
			wireAbilityButton(slot, ability)
			table.insert(abilitySlots, slot)
		end

		for i, ability in extras do
			local suppressEllipsis = ability.hold == true
				or ability.id == "shapeshift"
				or ability.id == "god_of_mischief"
				or ability.id == "binary_form"
				or ability.id == "illusion_decoy"
				or ability.id == "teleportation"
				or ability.id == "hex_displacement"
				or ability.id == "trickster_dash"
				or ability.id == "forcefield_area"
				or ability.id == "forcefield_choke"
				or ability.id == "forcefield_protect"
			local displayName = ability.name
			if ability.id == "forcefield_smash" then
				local look = if boundCharacter then boundCharacter:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) else nil
				if look == "modern" then
					displayName = "Forcefield Bubble Smash"
				end
			end
			local extraBtnSize = if heroId == "invisible_woman"
				then UDim2.fromScale(0.96, 0.20)
				else UDim2.fromScale(0.96, 0.22)
			local slot = createAbilityButton(
				extraColumn,
				ability.id,
				displayName,
				ability.description,
				ability.key,
				i,
				ability.id,
				ability.cooldown,
				extraBtnSize,
				suppressEllipsis,
				CharacterRegistry.resolveAbilityIcon(ability, nil)
			)
			wireAbilityButton(slot, ability)
			table.insert(extraSlots, slot)
		end

		local showScarlet = heroId == "scarlet_witch"
		local showMarvel = heroId == "captain_marvel"
		local showLoki = heroId == "loki"
		local showDagger = heroId == "dagger"
		local showMarvelGirl = heroId == "jean_grey"
		local showIceman = heroId == "iceman"
		local showIw = heroId == "invisible_woman"
		modeColumn.Visible = showMarvel or showLoki
		for _, panel in scarletModePanels do
			panel.Visible = false
		end
		for _, panel in marvelModePanels do
			panel.Visible = showMarvel
		end
		for _, panel in lokiModePanels do
			panel.Visible = showLoki
		end
		extraColumn.Visible = (showScarlet or showLoki or showDagger or showMarvelGirl or showIceman or showIw) and #extras > 0
		if showIw then
			extraColumn.Size = UDim2.fromScale(0.068, 0.42)
		else
			extraColumn.Size = UDim2.fromScale(0.075, 0.4)
		end
		absorbColumn.Visible = showMarvel
		restraintBar.Visible = showMarvelGirl or showScarlet or showIw
		abilityBar.Visible = mainCount > 0
		refreshModeButtons()
		refreshLokiClonePanel()
		refreshLokiUltPanel()
	end

	local function setBar(fill: Frame, label: TextLabel, prefix: string, current: number, max: number)
		local ratio = if max > 0 then math.clamp(current / max, 0, 1) else 0
		fill.Size = UDim2.fromScale(ratio, 1)
		label.Text = string.format("%s: %d/%d", prefix, math.floor(current + 0.5), math.floor(max + 0.5))
	end

	local function refreshAbsorbCharge(character: Model)
		local charge = character:GetAttribute(GameConstants.ABSORB_CHARGE_ATTRIBUTE)
		if type(charge) ~= "number" then
			charge = 0
		end
		local ratio = math.clamp(charge / GameConstants.ABSORB_CHARGE_MAX, 0, 1)
		absorbFill.Size = UDim2.fromScale(1, ratio)
		absorbPct.Text = string.format("%d%%", math.floor(ratio * 100 + 0.5))

		local mult = 1 + ratio * (GameConstants.CM_ABSORB_OUTGOING_MULT_MAX - 1)
		local bonusPct = math.floor((mult - 1) * 100 + 0.5)
		local hasBonus = ratio > 0.01
		absorbStatus.Visible = hasBonus and currentHeroId == "captain_marvel"
		if hasBonus then
			absorbStatus.Text = string.format("+%d%%", bonusPct)
			local t = ratio
			absorbStatus.BackgroundColor3 = Color3.fromRGB(
				math.floor(220 + 35 * t),
				math.floor(160 + 50 * t),
				math.floor(40 + 20 * t)
			)
		end
		if hoveredStatus == "absorb" and tooltip.Visible then
			local title, body = buildAbsorbTooltip()
			tooltipTitle.Text = title
			tooltipBody.Text = body
		end
	end

	absorbStatus.MouseEnter:Connect(function()
		hoveredStatus = "absorb"
		local title, body = buildAbsorbTooltip()
		showTooltip(title, body)
	end)
	absorbStatus.MouseLeave:Connect(function()
		if hoveredStatus == "absorb" then
			hoveredStatus = nil
		end
		hideTooltip()
	end)

	local function refreshBinaryStatus(character: Model)
		local on = character:GetAttribute(GameConstants.BINARY_ACTIVE_ATTRIBUTE) == true
			and currentHeroId == "captain_marvel"
		binaryStatus.Visible = on
		if on then
			local untilTime = character:GetAttribute(GameConstants.BINARY_UNTIL_ATTRIBUTE)
			local left = 0
			if type(untilTime) == "number" then
				left = math.max(0, untilTime - AbilityCooldownHelper.getNow())
			end
			binaryStatus.Text = if left > 0 then string.format("%.0fs", left) else "BIN"
		end
		if hoveredStatus == "binary" and tooltip.Visible then
			local title, body = buildBinaryTooltip()
			tooltipTitle.Text = title
			tooltipBody.Text = body
		end
	end

	binaryStatus.MouseEnter:Connect(function()
		hoveredStatus = "binary"
		local title, body = buildBinaryTooltip()
		showTooltip(title, body)
	end)
	binaryStatus.MouseLeave:Connect(function()
		if hoveredStatus == "binary" then
			hoveredStatus = nil
		end
		hideTooltip()
	end)

	local function refreshAstralStatus(character: Model)
		local inAstral = currentHeroId == "jean_grey"
			and character:GetAttribute(GameConstants.MG_ASTRAL_BODY_ATTRIBUTE) == true
		astralStatus.Visible = inAstral
		if inAstral then
			local endAt = character:GetAttribute(GameConstants.MG_ASTRAL_END_AT_ATTRIBUTE)
			local left = GameConstants.MG_ASTRAL_DURATION
			if type(endAt) == "number" then
				left = math.max(0, endAt - AbilityCooldownHelper.getNow())
			end
			astralStatus.Text = string.format("%.0fs", left)
		end
		if hoveredStatus == "astral" and tooltip.Visible then
			tooltipTitle.Text = "Astral Form"
			tooltipBody.Text = "You have left your body. Return before the timer runs out."
		end
	end

	local function refreshRestraint(character: Model)
		local isJean = currentHeroId == "jean_grey"
		local isWanda = currentHeroId == "scarlet_witch"
		local isIw = currentHeroId == "invisible_woman"
		local show = isJean or isWanda or isIw
		restraintBar.Visible = show
		if not show then
			return
		end
		if isWanda then
			local current = character:GetAttribute(GameConstants.SW_CONTROL_ATTRIBUTE)
			local maxC = character:GetAttribute(GameConstants.SW_CONTROL_MAX_ATTRIBUTE)
			if type(current) ~= "number" then
				current = 0
			end
			if type(maxC) ~= "number" or maxC <= 0 then
				maxC = GameConstants.SW_CONTROL_MAX
			end
			restraintFill.Size = UDim2.fromScale(math.clamp(current / maxC, 0, 1), 1)
			restraintFill.BackgroundColor3 = THEME.energy
			restraintLabel.Text = "Control"
			restraintLabel.TextColor3 = Color3.fromRGB(255, 246, 248)
			restraintLabelStroke.Transparency = 0.05
			restraintLabelStroke.Color = Color3.fromRGB(22, 8, 10)
			return
		end
		restraintLabelStroke.Transparency = 1
		if isIw then
			local current = character:GetAttribute(GameConstants.IW_HYPERSPACE_ATTRIBUTE)
			local maxH = character:GetAttribute(GameConstants.IW_HYPERSPACE_MAX_ATTRIBUTE)
			if type(current) ~= "number" then
				current = 0
			end
			if type(maxH) ~= "number" or maxH <= 0 then
				maxH = GameConstants.IW_HYPERSPACE_MAX
			end
			restraintFill.Size = UDim2.fromScale(math.clamp(current / maxH, 0, 1), 1)
			restraintFill.BackgroundColor3 = GameConstants.IW_COLOR
			restraintLabel.Text = "Hyperspace Strain"
			return
		end
		local current = character:GetAttribute(GameConstants.MG_RESTRAINT_ATTRIBUTE)
		local maxR = character:GetAttribute(GameConstants.MG_RESTRAINT_MAX_ATTRIBUTE)
		if type(current) ~= "number" then
			current = 0
		end
		if type(maxR) ~= "number" or maxR <= 0 then
			maxR = GameConstants.MG_RESTRAINT_MAX
		end
		restraintFill.Size = UDim2.fromScale(math.clamp(current / maxR, 0, 1), 1)
		restraintFill.BackgroundColor3 = THEME.energy
		restraintLabel.Text = "Strain"
	end

	local function refreshStatus(character: Model)
		local ragdolled = character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true
		ragdollStatus.Visible = ragdolled
		if ragdolled and hoveredStatus == "ragdoll" and tooltip.Visible then
			local title, body = buildRagdollTooltip()
			tooltipTitle.Text = title
			tooltipBody.Text = body
		elseif not ragdolled and hoveredStatus == "ragdoll" then
			hoveredStatus = nil
			hideTooltip()
		end
		refreshBinaryStatus(character)
		refreshAstralStatus(character)
		refreshRestraint(character)
	end

	ragdollStatus.MouseEnter:Connect(function()
		hoveredStatus = "ragdoll"
		local title, body = buildRagdollTooltip()
		showTooltip(title, body)
	end)
	ragdollStatus.MouseLeave:Connect(function()
		if hoveredStatus == "ragdoll" then
			hoveredStatus = nil
		end
		hideTooltip()
	end)

	astralStatus.MouseEnter:Connect(function()
		hoveredStatus = "astral"
		showTooltip("Astral Form", "You have left your body. Return before the timer runs out.")
	end)
	astralStatus.MouseLeave:Connect(function()
		if hoveredStatus == "astral" then
			hoveredStatus = nil
		end
		hideTooltip()
	end)

	local function refreshStats(character: Model)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			setBar(healthFill, healthLabel, "Health", humanoid.Health, humanoid.MaxHealth)
		end
		local energy = character:GetAttribute(GameConstants.ENERGY_ATTRIBUTE)
		local maxEnergy = character:GetAttribute(GameConstants.MAX_ENERGY_ATTRIBUTE)
		if type(energy) == "number" and type(maxEnergy) == "number" then
			setBar(energyFill, energyLabel, "Energy", energy, maxEnergy)
		end
		local stamina = character:GetAttribute(GameConstants.STAMINA_ATTRIBUTE)
		local maxStamina = character:GetAttribute(GameConstants.MAX_STAMINA_ATTRIBUTE)
		if type(stamina) == "number" and type(maxStamina) == "number" then
			setBar(staminaFill, staminaLabel, "Stamina", stamina, maxStamina)
		end
		refreshAbsorbCharge(character)
		refreshModeButtons()
		refreshStatus(character)
		refreshLokiClonePanel()
		refreshLokiUltPanel()
	end

	local function startCooldownLoop()
		if cooldownConn then
			cooldownConn:Disconnect()
		end
		cooldownConn = RunService.RenderStepped:Connect(function()
			updateSlotCooldowns(abilitySlots)
			updateSlotCooldowns(extraSlots)
			if boundCharacter then
				local remaining = AbilityCooldownHelper.getRemaining(boundCharacter, "jean_hair")
				if remaining > 0 then
					hairCosmetic.cooldownOverlay.Visible = true
					hairCosmetic.cooldownOverlay.Size = UDim2.fromScale(1, math.clamp(remaining / GameConstants.MG_HAIR_COOLDOWN, 0, 1))
					hairCosmetic.cooldownLabel.Visible = true
					hairCosmetic.cooldownLabel.Text = string.format("%.1f", remaining)
				else
					hairCosmetic.cooldownOverlay.Visible = false
					hairCosmetic.cooldownLabel.Visible = false
				end
			end
			if boundCharacter and binaryStatus.Visible then
				refreshBinaryStatus(boundCharacter)
			end
			if boundCharacter and astralStatus.Visible then
				refreshAstralStatus(boundCharacter)
			end
			if boundCharacter and restraintBar.Visible then
				refreshRestraint(boundCharacter)
			end
		end)
	end

	local function stopCooldownLoop()
		if cooldownConn then
			cooldownConn:Disconnect()
			cooldownConn = nil
		end
	end

	return {
		show = function(heroId: string)
			currentHeroId = heroId
			applyTheme(heroId)
			screenGui.ResetOnSpawn = false
			screenGui.Enabled = true
			if root then
				root.Visible = true
			end
			if topCluster then
				topCluster.Visible = true
			end
			if bottomRow then
				bottomRow.Visible = true
			end
			if abilityBar then
				abilityBar.Visible = true
			end
			if abilityRow then
				abilityRow.Visible = true
			end
			rebuildAbilityBar(heroId)
			refreshHairSlot()
			-- Ability buttons are rebuilt after theme — paint names white for Dagger
			if heroId == "dagger" then
				for _, slot in abilitySlots do
					slot.nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
				end
				for _, slot in extraSlots do
					slot.nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
				end
			end
			refreshDaggerAlliesPanel()
			if heroId == "dagger" then
				getUseAbility():FireServer({ action = "AllyRefresh" })
			end
			startCooldownLoop()
		end,
		hide = function()
			screenGui.Enabled = false
			if modeColumn then
				modeColumn.Visible = false
			end
			if extraColumn then
				extraColumn.Visible = false
			end
			if absorbColumn then
				absorbColumn.Visible = false
			end
			if lokiClonePanel then
				lokiClonePanel.Visible = false
			end
			if root then
				local ultPanel = root:FindFirstChild("LokiUltPanel")
				if ultPanel and ultPanel:IsA("GuiObject") then
					ultPanel.Visible = false
				end
			end
			if daggerAlliesPanel then
				daggerAlliesPanel.Visible = false
			end
			setDaggerAllyArming(false)
			if settingsPanel then
				settingsPanel.Visible = false
			end
			if hairCosmetic then
				hairCosmetic.slot.Visible = false
			end
			if profilePanel then
				profilePanel.Visible = false
			end
			if ragdollStatus then
				ragdollStatus.Visible = false
			end
			if absorbStatus then
				absorbStatus.Visible = false
			end
			if binaryStatus then
				binaryStatus.Visible = false
			end
			if astralStatus then
				astralStatus.Visible = false
			end
			if restraintBar then
				restraintBar.Visible = false
			end
			stopCooldownLoop()
			hideTooltip()
		end,
		bindCharacter = function(character: Model)
			if not character or not character.Parent then
				return
			end
			boundCharacter = character
			if healthConn then
				healthConn:Disconnect()
			end
			if modeConnA then
				modeConnA:Disconnect()
			end
			if modeConnB then
				modeConnB:Disconnect()
			end
			if modeConnC then
				modeConnC:Disconnect()
			end
			if modeConnD then
				modeConnD:Disconnect()
			end
			if modeConnE then
				modeConnE:Disconnect()
			end
			if areaConn then
				areaConn:Disconnect()
			end
			if ragdollConn then
				ragdollConn:Disconnect()
			end
			local humanoid = character:WaitForChild("Humanoid", 8) :: Humanoid?
			if not humanoid then
				return
			end
			-- Morph / starter swap can lag HRP; wait so viewport isn't empty
			character:WaitForChild("HumanoidRootPart", 8)
			healthConn = humanoid.HealthChanged:Connect(function()
				refreshStats(character)
			end)
			humanoid.Died:Connect(function()
				refreshStats(character)
			end)
			character:GetAttributeChangedSignal(GameConstants.ENERGY_ATTRIBUTE):Connect(function()
				refreshStats(character)
			end)
			character:GetAttributeChangedSignal(GameConstants.STAMINA_ATTRIBUTE):Connect(function()
				refreshStats(character)
			end)
			character:GetAttributeChangedSignal(GameConstants.ABSORB_CHARGE_ATTRIBUTE):Connect(function()
				refreshAbsorbCharge(character)
			end)
			character:GetAttributeChangedSignal(GameConstants.BINARY_ACTIVE_ATTRIBUTE):Connect(function()
				refreshBinaryStatus(character)
				refreshAbsorbCharge(character)
			end)
			character:GetAttributeChangedSignal(GameConstants.BINARY_UNTIL_ATTRIBUTE):Connect(function()
				refreshBinaryStatus(character)
			end)
			character:GetAttributeChangedSignal(GameConstants.LOKI_CLONE_ACTIVE_ATTRIBUTE):Connect(function()
				refreshLokiClonePanel()
			end)
			character:GetAttributeChangedSignal(GameConstants.LOKI_CLONE_MODE_ATTRIBUTE):Connect(function()
				refreshLokiClonePanel()
			end)
			character:GetAttributeChangedSignal(GameConstants.LOKI_ULT_ACTIVE_ATTRIBUTE):Connect(function()
				refreshLokiUltPanel()
			end)
			character:GetAttributeChangedSignal(GameConstants.LOKI_ULT_ATTACK_ATTRIBUTE):Connect(function()
				refreshLokiUltPanel()
			end)
			modeConnA = character:GetAttributeChangedSignal(GameConstants.HEX_BLAST_MODE_ATTRIBUTE):Connect(refreshModeButtons)
			modeConnB = character:GetAttributeChangedSignal(GameConstants.TK_MODE_ATTRIBUTE):Connect(refreshModeButtons)
			modeConnC = character:GetAttributeChangedSignal(GameConstants.ULTIMATE_MODE_ATTRIBUTE):Connect(refreshModeButtons)
			modeConnD = character:GetAttributeChangedSignal(GameConstants.PHOTON_FLIGHT_MODE_ATTRIBUTE):Connect(refreshModeButtons)
			modeConnE = character:GetAttributeChangedSignal(GameConstants.LOKI_DASH_MODE_ATTRIBUTE):Connect(refreshModeButtons)
			areaConn = character:GetAttributeChangedSignal(AbilityCooldownHelper.getActiveAttributeName("forcefield_area")):Connect(function()
				if currentHeroId then
					rebuildAbilityBar(currentHeroId)
				end
			end)
			ragdollConn = 			character:GetAttributeChangedSignal(GameConstants.RAGDOLLED_ATTRIBUTE):Connect(function()
				refreshStatus(character)
			end)
			character:GetAttributeChangedSignal(GameConstants.MG_ASTRAL_BODY_ATTRIBUTE):Connect(function()
				refreshAstralStatus(character)
				if currentHeroId then
					rebuildAbilityBar(currentHeroId)
				end
			end)
			character:GetAttributeChangedSignal(GameConstants.MG_ASTRAL_END_AT_ATTRIBUTE):Connect(function()
				refreshAstralStatus(character)
			end)
			character:GetAttributeChangedSignal(GameConstants.MG_RESTRAINT_ATTRIBUTE):Connect(function()
				refreshRestraint(character)
			end)
			character:GetAttributeChangedSignal(GameConstants.SW_CONTROL_ATTRIBUTE):Connect(function()
				refreshRestraint(character)
			end)
			character:GetAttributeChangedSignal(GameConstants.IW_HYPERSPACE_ATTRIBUTE):Connect(function()
				refreshRestraint(character)
			end)
			character:GetAttributeChangedSignal(GameConstants.MG_HAIR_TIED_ATTRIBUTE):Connect(function()
				refreshHairSlot()
			end)
			character:GetAttributeChangedSignal(GameConstants.LOOK_MODE_ATTRIBUTE):Connect(function()
				refreshHairSlot()
				if currentHeroId then
					rebuildAbilityBar(currentHeroId)
				end
				local liveSkin = character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE)
				local liveHero = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
				if type(liveHero) == "string" then
					local morph = CharacterRegistry.getMorphTemplate(
						liveHero,
						if type(liveSkin) == "string" then liveSkin else "base"
					)
					ViewportHelper.bindMorphIdle(viewport, morph, 0)
				end
			end)
			local skinId = character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE)
			local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
			if type(heroId) == "string" then
				local morph = CharacterRegistry.getMorphTemplate(
					heroId,
					if type(skinId) == "string" then skinId else "base"
				)
				ViewportHelper.bindMorphIdle(viewport, morph, 0)
			end
			if currentHeroId then
				rebuildAbilityBar(currentHeroId)
			end
			refreshHairSlot()
			refreshStats(character)
		end,
		destroy = function()
			if healthConn then
				healthConn:Disconnect()
			end
			if modeConnA then
				modeConnA:Disconnect()
			end
			if modeConnB then
				modeConnB:Disconnect()
			end
			if modeConnC then
				modeConnC:Disconnect()
			end
			if modeConnD then
				modeConnD:Disconnect()
			end
			if modeConnE then
				modeConnE:Disconnect()
			end
			if areaConn then
				areaConn:Disconnect()
			end
			if ragdollConn then
				ragdollConn:Disconnect()
			end
			stopCooldownLoop()
			hideTooltip()
			screenGui:Destroy()
		end,
	}
end

return GameplayHUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">GameplayHUDSettings</string>
            <string name="Source"><![CDATA[--!strict

local SettingsUI = require(script.Parent.SettingsUI)

export type HudTheme = {
	panel: Color3,
	panelTitle: Color3,
	stroke: Color3,
	modeOn: Color3,
	modeOff: Color3,
}

export type HudSettingsBundle = {
	settingsBtn: TextButton,
	settingsPanel: Frame,
	settingsStroke: UIStroke,
	settingsBtnStroke: UIStroke,
	refreshShoulderSettingsUi: () -> (),
}

local GameplayHUDSettings = {}

local function addCorner(inst: GuiObject, radiusScale: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(radiusScale, 0)
	c.Parent = inst
end

function GameplayHUDSettings.build(root: Frame, theme: HudTheme): HudSettingsBundle
	local settingsBtn = Instance.new("TextButton")
	settingsBtn.Name = "SettingsButton"
	settingsBtn.AnchorPoint = Vector2.new(1, 0)
	settingsBtn.Position = UDim2.fromScale(0.99, 0.038)
	settingsBtn.Size = UDim2.fromScale(0.062, 0.032)
	if game:GetService("UserInputService").TouchEnabled then
		settingsBtn.Size = UDim2.fromScale(0.068, 0.035)
	end
	settingsBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
	settingsBtn.BackgroundTransparency = 0.15
	settingsBtn.BorderSizePixel = 0
	settingsBtn.AutoButtonColor = true
	settingsBtn.Font = Enum.Font.Bangers
	settingsBtn.Text = "Settings"
	settingsBtn.TextColor3 = Color3.fromRGB(235, 235, 240)
	settingsBtn.TextScaled = true
	settingsBtn.ZIndex = 30
	settingsBtn.Parent = root
	addCorner(settingsBtn, 0.2)

	local settingsBtnConstraint = Instance.new("UITextSizeConstraint")
	settingsBtnConstraint.MaxTextSize = 16
	settingsBtnConstraint.MinTextSize = 9
	settingsBtnConstraint.Parent = settingsBtn

	local settingsBtnStroke = Instance.new("UIStroke")
	settingsBtnStroke.Name = "ThemeStroke"
	settingsBtnStroke.Color = theme.stroke
	settingsBtnStroke.Thickness = 1
	settingsBtnStroke.Transparency = 0.35
	settingsBtnStroke.Parent = settingsBtn

	local settingsPanel = Instance.new("Frame")
	settingsPanel.Name = "SettingsPanel"
	settingsPanel.AnchorPoint = Vector2.new(1, 0)
	settingsPanel.Position = UDim2.fromScale(0.99, 0.078)
	settingsPanel.Size = UDim2.fromScale(0.14, 0.34)
	settingsPanel.BackgroundColor3 = theme.panel
	settingsPanel.BackgroundTransparency = 0.08
	settingsPanel.BorderSizePixel = 0
	settingsPanel.Visible = false
	settingsPanel.ZIndex = 31
	settingsPanel.Parent = root
	addCorner(settingsPanel, 0.08)

	local settingsStroke = Instance.new("UIStroke")
	settingsStroke.Name = "ThemeStroke"
	settingsStroke.Color = theme.stroke
	settingsStroke.Thickness = 1.2
	settingsStroke.Transparency = 0.3
	settingsStroke.Parent = settingsPanel

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Scroll"
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ZIndex = 32
	scroll.Parent = settingsPanel

	local refreshShoulderSettingsUi = SettingsUI.buildPanel(scroll, { compact = true, showShoulderCam = true })

	settingsBtn.MouseButton1Click:Connect(function()
		settingsPanel.Visible = not settingsPanel.Visible
		if settingsPanel.Visible then
			refreshShoulderSettingsUi()
		end
	end)

	return {
		settingsBtn = settingsBtn,
		settingsPanel = settingsPanel,
		settingsStroke = settingsStroke,
		settingsBtnStroke = settingsBtnStroke,
		refreshShoulderSettingsUi = refreshShoulderSettingsUi,
	}
end

return GameplayHUDSettings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">HexFlightClient</string>
            <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local CameraShakeClient = require(script.Parent.CameraShakeClient)

local HexFlightClient = {}

local DEFAULT_FOV = 70
local FLIGHT_FOV_FAST = 80 -- full-speed flight
local FLIGHT_FOV_LERP = 5.5 -- camera follows speed blend
local MAX_CAMERA_ROLL = math.rad(1.2)
local CHAR_ROLL_TO_CAMERA = 0.12

local function getFullCameraMove(controls: any?): (Vector3, Vector3, number)
	local camera = workspace.CurrentCamera
	if not camera then
		return Vector3.zero, Vector3.new(0, 0, -1), 0
	end
	local look = camera.CFrame.LookVector
	local right = camera.CFrame.RightVector

	local w = if UserInputService:IsKeyDown(Enum.KeyCode.W) then 1 else 0
	local s = if UserInputService:IsKeyDown(Enum.KeyCode.S) then 1 else 0
	local a = if UserInputService:IsKeyDown(Enum.KeyCode.A) then 1 else 0
	local d = if UserInputService:IsKeyDown(Enum.KeyCode.D) then 1 else 0

	local sideInput = d - a
	local keyboardMove = look * (w - s) + right * sideInput
	local moveDir = keyboardMove
	if controls and UserInputService.TouchEnabled and keyboardMove.Magnitude < 0.01 then
		local inputMove = controls:GetMoveVector()
		moveDir = right * inputMove.X + look * -inputMove.Z
		sideInput = math.clamp(inputMove.X, -1, 1)
	end
	if moveDir.Magnitude > 1 then
		moveDir = moveDir.Unit
	end
	return moveDir, look, sideInput
end

local function getCharacterRoll(character: Model): number
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return 0
	end
	local _, _, roll = root.CFrame:ToEulerAnglesYXZ()
	return roll
end

local function silenceWalkSounds(character: Model)
	for _, desc in character:GetDescendants() do
		if desc:IsA("Sound") then
			local name = string.lower(desc.Name)
			if name == "running" or name == "climbing" or name:find("run", 1, true) or name:find("walk", 1, true) then
				if desc.Playing or desc.IsPlaying then
					desc:Stop()
				end
				desc.Volume = 0
			end
		end
	end
end

local function findAnimate(character: Model): LocalScript?
	local direct = character:FindFirstChild("Animate")
	if direct and direct:IsA("LocalScript") then
		return direct
	end
	return nil
end

local function getAnimator(humanoid: Humanoid): Animator?
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		return animator
	end
	local created = Instance.new("Animator")
	created.Parent = humanoid
	return created
end

local function loadTrack(animator: Animator, assetId: string): AnimationTrack?
	local anim = Instance.new("Animation")
	anim.AnimationId = assetId
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	anim:Destroy()
	if ok and track then
		track.Looped = true
		return track
	end
	return nil
end

function HexFlightClient.init(player: Player)
	local flightInput = Remotes.getEvent("FlightInput")
	local controls: any = nil
	pcall(function()
		local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		controls = playerModule:GetControls()
	end)
	local cameraRoll = 0
	local flightFovBlend = 0
	local fovBase = DEFAULT_FOV
	local flightFeelOn = false

	local idleTrack: AnimationTrack? = nil
	local moveTrack: AnimationTrack? = nil
	local currentMode: "none" | "idle" | "move" = "none"
	local boundCharacter: Model? = nil
	local boundLook: any = nil
	local animateWasDisabled: boolean? = nil

	local function stopFlightAnims()
		if idleTrack then
			idleTrack:Stop(0.15)
		end
		if moveTrack then
			moveTrack:Stop(0.15)
		end
		currentMode = "none"
	end

	local function clearTracks()
		stopFlightAnims()
		if idleTrack then
			idleTrack:Destroy()
			idleTrack = nil
		end
		if moveTrack then
			moveTrack:Destroy()
			moveTrack = nil
		end
		boundCharacter = nil
		boundLook = nil
	end

	local function ensureTracks(character: Model)
		local look = character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE)
		if boundCharacter == character and boundLook == look then
			return
		end
		clearTracks()
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			boundCharacter = character
			boundLook = look
			return
		end
		local animator = getAnimator(humanoid)
		if not animator then
			boundCharacter = character
			boundLook = look
			return
		end
		local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
		local idleId = GameConstants.FLIGHT_IDLE_ANIM
		local moveId = GameConstants.FLIGHT_MOVE_ANIM
		if heroId == "captain_marvel" then
			idleId = GameConstants.PHOTON_FLIGHT_IDLE_ANIM
			moveId = GameConstants.PHOTON_FLIGHT_MOVE_ANIM
		elseif heroId == "jean_grey" then
			idleId = GameConstants.JEAN_FLIGHT_IDLE_ANIM
			moveId = GameConstants.JEAN_FLIGHT_MOVE_ANIM
		elseif heroId == "invisible_woman" then
			local look = character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE)
			if look == "modern" then
				idleId = GameConstants.MG_FLIGHT_IDLE_ANIM
				moveId = GameConstants.MG_FLIGHT_MOVE_ANIM
			else
				idleId = GameConstants.IW_BASE_FLIGHT_IDLE_ANIM
				moveId = GameConstants.IW_BASE_FLIGHT_MOVE_ANIM
			end
		end
		idleTrack = loadTrack(animator, idleId)
		moveTrack = loadTrack(animator, moveId)
		if idleTrack then
			idleTrack.Priority = Enum.AnimationPriority.Action
		end
		if moveTrack then
			moveTrack.Priority = Enum.AnimationPriority.Action
		end
		boundCharacter = character
		boundLook = look
	end

	local function setFlightAnim(mode: "idle" | "move")
		if currentMode == mode then
			return
		end
		if mode == "idle" then
			if moveTrack and moveTrack.IsPlaying then
				moveTrack:Stop(0.2)
			end
			if idleTrack and not idleTrack.IsPlaying then
				idleTrack:Play(0.2)
			end
		else
			if idleTrack and idleTrack.IsPlaying then
				idleTrack:Stop(0.2)
			end
			if moveTrack and not moveTrack.IsPlaying then
				moveTrack:Play(0.2)
			end
		end
		currentMode = mode
	end

	player.CharacterRemoving:Connect(function(character)
		if animateWasDisabled ~= nil then
			local animate = character:FindFirstChild("Animate")
			if animate and (animate:IsA("LocalScript") or animate:IsA("Script")) then
				animate.Disabled = animateWasDisabled
			end
		end
		clearTracks()
		animateWasDisabled = nil
		cameraRoll = 0
		fovBase = DEFAULT_FOV
		local cam = workspace.CurrentCamera
		if cam then
			cam.FieldOfView = DEFAULT_FOV
		end
	end)

	player.CharacterAdded:Connect(function()
		clearTracks()
		animateWasDisabled = nil
		cameraRoll = 0
		fovBase = DEFAULT_FOV
		local cam = workspace.CurrentCamera
		if cam then
			cam.FieldOfView = DEFAULT_FOV
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		local character = player.Character
		local camera = workspace.CurrentCamera
		if not character or not camera then
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end

		-- Marvel Girl astral owns camera/FOV while projected
		if character:GetAttribute(GameConstants.MG_ASTRAL_BODY_ATTRIBUTE) == true then
			return
		end

		local isFlying = character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
		local isIceSliding = character:GetAttribute(GameConstants.ICE_SLIDE_ATTRIBUTE) == true
		if isIceSliding and not isFlying then
			-- Same WASD→camera move stream as flight; IceSlide uses FlightInput on the server
			local moveDir, look, sideInput = getFullCameraMove(controls)
			flightInput:FireServer({
				moveVector = moveDir,
				lookVector = look,
				sideInput = sideInput,
			})
		end
		if isFlying then
			ensureTracks(character)
			silenceWalkSounds(character)

			local animate = findAnimate(character)
			if animate and animateWasDisabled == nil then
				animateWasDisabled = animate.Disabled
				animate.Disabled = true
			end

			local moveDir, look, sideInput = getFullCameraMove(controls)
			flightInput:FireServer({
				moveVector = moveDir,
				lookVector = look,
				sideInput = sideInput,
			})

			-- Switch idle/move as soon as WASD is pressed or released (ignore coasting speed)
			local moving = moveDir.Magnitude > GameConstants.FLIGHT_ANIM_MOVE_THRESHOLD
			setFlightAnim(if moving then "move" else "idle")

			-- FOV follows current flight speed, plus ability punch (barrage / absorb / disintegrate)
			local root = character:FindFirstChild("HumanoidRootPart")
			local heroId = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
			local alpha = character:GetAttribute(GameConstants.FLIGHT_ALPHA_ATTRIBUTE)
			local speedAlpha = if type(alpha) == "number" then alpha else 0
			local maxSpeed = if heroId == "captain_marvel"
				then GameConstants.PHOTON_FLIGHT_SPEED
				else GameConstants.FLIGHT_SPEED
			local spd = 0
			if root and root:IsA("BasePart") then
				spd = root.AssemblyLinearVelocity.Magnitude
			end
			local speedT = math.clamp(spd / math.max(maxSpeed, 1), 0, 1)
			-- FOV tracks speed only (not idle/move anim). Slow the blend on decel so it eases back to 70.
			local blendRate = if speedT < flightFovBlend then 3.1 else 4.6
			flightFovBlend += (speedT - flightFovBlend) * math.clamp(dt * blendRate, 0, 1)
			local targetFov = DEFAULT_FOV + (FLIGHT_FOV_FAST - DEFAULT_FOV) * flightFovBlend
			local abilityBoost = 0
			if character:GetAttribute("BarrageSpinActive") == true
				or character:GetAttribute("AbsorbActive") == true
				or character:GetAttribute(GameConstants.DISINTEGRATE_ACTIVE_ATTRIBUTE) == true
			then
				abilityBoost = GameConstants.ABILITY_FOV_BOOST
			end
			targetFov += abilityBoost
			if not CameraShakeClient.isAbilityZoomEnabled() then
				targetFov = DEFAULT_FOV
			end
			fovBase += (targetFov - fovBase) * math.clamp(dt * FLIGHT_FOV_LERP, 0, 1)
			camera.FieldOfView = fovBase + CameraShakeClient.getFovPunch()

			if heroId == "jean_grey" or heroId == "scarlet_witch" or heroId == "invisible_woman" then
				flightFeelOn = true
				CameraShakeClient.setHeldLayer("flight", true, {
					fade = 0.05,
					shake = 0.02 + flightFovBlend * 0.08,
					fov = flightFovBlend * 2.4,
					vignette = 0.92 - flightFovBlend * 0.38,
					shakeRange = 1.15,
					shakeSlow = 0.72,
				})
			end

			local charRoll = getCharacterRoll(character)
			local targetRoll = math.clamp(charRoll * CHAR_ROLL_TO_CAMERA, -MAX_CAMERA_ROLL, MAX_CAMERA_ROLL)
			cameraRoll += (targetRoll - cameraRoll) * math.clamp(dt * 4, 0, 1)

			local offsetTarget = Vector3.new(0, 0.04 + speedAlpha * 0.08, 0)
			humanoid.CameraOffset = humanoid.CameraOffset:Lerp(offsetTarget, math.clamp(dt * 5, 0, 1))
		else
			if currentMode ~= "none" then
				stopFlightAnims()
			end
			if flightFeelOn then
				flightFeelOn = false
				CameraShakeClient.setHeldLayer("flight", false, { fade = 0.35 })
			end
			flightFovBlend += (0 - flightFovBlend) * math.clamp(dt * 6, 0, 1)
			if animateWasDisabled ~= nil then
				local animate = findAnimate(character)
				if animate then
					animate.Disabled = animateWasDisabled
				end
				animateWasDisabled = nil
			end
			cameraRoll += (0 - cameraRoll) * math.clamp(dt * 8, 0, 1)
			local groundFov = DEFAULT_FOV
			if CameraShakeClient.isAbilityZoomEnabled() then
				if character:GetAttribute("BarrageSpinActive") == true
					or character:GetAttribute("AbsorbActive") == true
					or character:GetAttribute(GameConstants.DISINTEGRATE_ACTIVE_ATTRIBUTE) == true
				then
					groundFov += GameConstants.ABILITY_FOV_BOOST
				end
			end
			fovBase += (groundFov - fovBase) * math.clamp(dt * 6, 0, 1)
			camera.FieldOfView = fovBase + CameraShakeClient.getFovPunch()
			if humanoid.CameraOffset.Magnitude > 0.01 then
				humanoid.CameraOffset = humanoid.CameraOffset:Lerp(Vector3.zero, math.clamp(dt * 8, 0, 1))
			end
		end
	end)

	RunService:BindToRenderStep("MCU_HexFlightCameraRoll", Enum.RenderPriority.Camera.Value + 1, function()
		if math.abs(cameraRoll) < 0.0001 then
			return
		end
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		camera.CFrame = camera.CFrame * CFrame.Angles(0, 0, cameraRoll)
	end)
end

return HexFlightClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">InvisibleWomanClient</string>
            <string name="Source"><![CDATA[--!strict

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CameraShakeClient = require(script.Parent.CameraShakeClient)
local ScreenFxClient = require(script.Parent.ScreenFxClient)
local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local InvisibleWomanClient = {}

function InvisibleWomanClient.init(localPlayer: Player)
	local function setShieldFeel(on: boolean)
		CameraShakeClient.setHeldLayer("iw_shield", on, {
			fade = 0.28,
			shake = 0.07,
			fov = -1.4,
			vignette = 0.52,
			shakeRange = 1.05,
			shakeSlow = 0.42,
		})
	end

	local colorFx = Instance.new("ColorCorrectionEffect")
	colorFx.Name = "IwInvisGrade"
	colorFx.Brightness = 0
	colorFx.Contrast = 0
	colorFx.Saturation = 0
	colorFx.TintColor = Color3.fromRGB(255, 255, 255)
	colorFx.Enabled = true
	colorFx.Parent = Lighting

	local function parentGrade()
		local cam = Workspace.CurrentCamera
		if cam then
			colorFx.Parent = cam
		else
			colorFx.Parent = Lighting
		end
	end
	parentGrade()
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(parentGrade)

	local chokeBlur = Instance.new("BlurEffect")
	chokeBlur.Name = "IwChokeBlur"
	chokeBlur.Size = 0
	chokeBlur.Enabled = true
	chokeBlur.Parent = Lighting

	local chokeOn = false
	local chokeTween: Tween? = nil
	local function setChokeBlur(on: boolean)
		if chokeOn == on then
			return
		end
		chokeOn = on
		if chokeTween then
			chokeTween:Cancel()
		end
		chokeTween = TweenService:Create(
			chokeBlur,
			TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = if on then 22 else 0 }
		)
		chokeTween:Play()
	end

	local gradeOn = false
	local gradeTween: Tween? = nil
	local function setInvisGrade(on: boolean)
		if gradeOn == on then
			return
		end
		gradeOn = on
		if gradeTween then
			gradeTween:Cancel()
			gradeTween = nil
		end
		local info = TweenInfo.new(if on then 0.45 else 0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		gradeTween = TweenService:Create(colorFx, info, {
			Brightness = if on then 0.22 else 0,
			Contrast = if on then 0.04 else 0,
			Saturation = if on then 0.06 else 0,
			TintColor = if on then Color3.fromRGB(186, 214, 238) else Color3.fromRGB(255, 255, 255),
		})
		gradeTween:Play()
		CameraShakeClient.setHeldLayer("iw_invis", on, {
			fade = if on then 0.4 else 0.5,
			shake = if on then 0.03 else 0,
			fov = if on then -0.4 else 0,
			vignette = if on then 0.9 else 1,
			shakeRange = 0.9,
			shakeSlow = 0.5,
		})
	end

	local function hook(character: Model)
		local function refresh()
			local on = character:GetAttribute(GameConstants.IW_FORCEFIELD_ATTRIBUTE) == true
				or character:GetAttribute(GameConstants.IW_FLIGHT_SHIELD_ATTRIBUTE) == true
			setShieldFeel(on)
		end
		local function refreshInvis()
			setInvisGrade(
				character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "invisible_woman"
					and character:GetAttribute(GameConstants.IW_INVIS_ATTRIBUTE) == true
			)
		end
		character:GetAttributeChangedSignal(GameConstants.IW_FORCEFIELD_ATTRIBUTE):Connect(refresh)
		character:GetAttributeChangedSignal(GameConstants.IW_FLIGHT_SHIELD_ATTRIBUTE):Connect(refresh)
		character:GetAttributeChangedSignal(GameConstants.IW_INVIS_ATTRIBUTE):Connect(refreshInvis)
		character:GetAttributeChangedSignal(GameConstants.HERO_ATTRIBUTE):Connect(refreshInvis)
		local function refreshChoke()
			setChokeBlur(character:GetAttribute(GameConstants.IW_CHOKED_ATTRIBUTE) == true)
		end
		local lingerUntil = 0
		local function refreshScreen()
			local hero = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
			local pushOn = AbilityCooldownHelper.isActive(character, "forcefield_push")
			local projOn = AbilityCooldownHelper.isActive(character, "body_projection")
			if pushOn or projOn then
				lingerUntil = os.clock() + 0.9
			end
			local on = hero == "invisible_woman"
				and (
					character:GetAttribute(GameConstants.IW_FORCEFIELD_ATTRIBUTE) == true
					or character:GetAttribute(GameConstants.IW_FLIGHT_SHIELD_ATTRIBUTE) == true
					or character:GetAttribute(GameConstants.IW_INVIS_ATTRIBUTE) == true
					or character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
					or AbilityCooldownHelper.isAnyActive(character, {
						"iw_forcefield",
						"invisibility",
						"forcefield_area",
						"forcefield_choke",
						"forcefield_crush",
						"forcefield_flight",
						"forcefield_push",
						"disc_throw",
						"body_projection",
						"forcefield_smash",
					})
					or os.clock() < lingerUntil
				)
			ScreenFxClient.setEnabled("invisible_woman", on == true)
			if lingerUntil > os.clock() then
				task.delay(0.95, refreshScreen)
			end
		end
		character:GetAttributeChangedSignal(GameConstants.IW_CHOKED_ATTRIBUTE):Connect(refreshChoke)
		character.AttributeChanged:Connect(function(attr)
			if string.sub(attr, 1, 14) == "AbilityActive_"
				or attr == GameConstants.HERO_ATTRIBUTE
				or attr == GameConstants.IW_FORCEFIELD_ATTRIBUTE
				or attr == GameConstants.IW_FLIGHT_SHIELD_ATTRIBUTE
				or attr == GameConstants.IW_INVIS_ATTRIBUTE
				or attr == GameConstants.IS_FLYING_ATTRIBUTE
			then
				refreshScreen()
			end
		end)
		refresh()
		refreshInvis()
		refreshChoke()
		refreshScreen()
	end

	localPlayer.CharacterAdded:Connect(function(character)
		setInvisGrade(false)
		hook(character)
	end)
	localPlayer.CharacterRemoving:Connect(function()
		setInvisGrade(false)
		setShieldFeel(false)
		setChokeBlur(false)
		ScreenFxClient.setEnabled("invisible_woman", false)
	end)
	if localPlayer.Character then
		hook(localPlayer.Character)
	end
end

return InvisibleWomanClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">LokiDecoyMarkerClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Flat ground mark while holding E to place Illusion Decoy.
]]

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local MouseHelper = require(script.Parent.MouseHelper)

local LokiDecoyMarkerClient = {}

local MARK_SIZE = 4.2
local MARK_COLOR = Color3.fromRGB(90, 255, 130)

local function makeMarker(): BasePart
	local disk = Instance.new("Part")
	disk.Name = "LokiDecoyPlaceMark"
	disk.Shape = Enum.PartType.Cylinder
	disk.Size = Vector3.new(0.12, MARK_SIZE, MARK_SIZE)
	disk.Material = Enum.Material.Neon
	disk.Color = MARK_COLOR
	disk.Transparency = 0.35
	disk.Anchored = true
	disk.CanCollide = false
	disk.CanQuery = false
	disk.CanTouch = false
	disk.CastShadow = false
	disk.Parent = Workspace
	return disk
end

local function groundAt(player: Player): Vector3?
	local hit = MouseHelper.getHitPosition(player, 120)
	local char = player.Character
	local origin = hit + Vector3.new(0, 2, 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = if char then { char } else {}
	local result = Workspace:Raycast(origin, Vector3.new(0, -40, 0), params)
	if result then
		return result.Position
	end
	return Vector3.new(hit.X, hit.Y, hit.Z)
end

function LokiDecoyMarkerClient.init(player: Player)
	local marker: BasePart? = nil

	local function hide()
		if marker then
			marker:Destroy()
			marker = nil
		end
	end

	RunService.RenderStepped:Connect(function()
		local character = player.Character
		if
			not character
			or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "loki"
			or character:GetAttribute(GameConstants.LOKI_CLONE_ACTIVE_ATTRIBUTE) == true
			or not UserInputService:IsKeyDown(Enum.KeyCode.E)
			or AbilityCooldownHelper.isOnCooldown(character, "illusion_decoy")
		then
			hide()
			return
		end

		local pos = groundAt(player)
		if not pos then
			hide()
			return
		end

		if not marker or not marker.Parent then
			marker = makeMarker()
		end
		local mark = marker :: BasePart
		-- Cylinder default axis is +X; lay flat on ground
		mark.CFrame = CFrame.new(pos + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.rad(90))
	end)
end

return LokiDecoyMarkerClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">LokiInvisClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Loki invisibility (God of Mischief):
	- Server already sets real Transparency = 1 (invisible everywhere including Studio server).
	- Local Loki: ghost silhouette so the caster can still see themselves.
	- Everyone else: keep fully invisible / FX off.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local LokiInvisClient = {}

local LOCAL_GHOST = 0.55

local function applyToInstance(desc: Instance, isLocal: boolean, on: boolean)
	if desc:IsA("BasePart") then
		if on then
			desc.LocalTransparencyModifier = 0
			if isLocal then
				desc.Transparency = if desc.Name == "HumanoidRootPart" then 1 else LOCAL_GHOST
			else
				desc.Transparency = 1
			end
		else
			desc.LocalTransparencyModifier = 0
			-- Server restores real transparencies; don't fight replication here.
		end
	elseif desc:IsA("Decal") or desc:IsA("Texture") then
		if on then
			if isLocal then
				if desc:GetAttribute("LokiInvisLocalOrigT") == nil then
					desc:SetAttribute("LokiInvisLocalOrigT", desc.Transparency)
				end
				desc.Transparency = LOCAL_GHOST
			else
				desc.Transparency = 1
			end
		else
			local orig = desc:GetAttribute("LokiInvisLocalOrigT")
			if type(orig) == "number" then
				desc.Transparency = orig
				desc:SetAttribute("LokiInvisLocalOrigT", nil)
			end
		end
	elseif desc:IsA("ParticleEmitter") or desc:IsA("Beam") or desc:IsA("Trail") or desc:IsA("Fire") or desc:IsA("Smoke") then
		if on then
			if desc:GetAttribute("LokiInvisWasEnabled") == nil then
				desc:SetAttribute("LokiInvisWasEnabled", desc.Enabled)
			end
			desc.Enabled = false
		else
			local was = desc:GetAttribute("LokiInvisWasEnabled")
			if typeof(was) == "boolean" then
				desc.Enabled = was
				desc:SetAttribute("LokiInvisWasEnabled", nil)
			end
		end
	elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
		desc.Enabled = not on
	elseif desc:IsA("Highlight") then
		desc.Enabled = not on
	elseif desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") then
		if on then
			if desc:GetAttribute("LokiInvisWasEnabled") == nil then
				desc:SetAttribute("LokiInvisWasEnabled", desc.Enabled)
			end
			desc.Enabled = false
		else
			local was = desc:GetAttribute("LokiInvisWasEnabled")
			if typeof(was) == "boolean" then
				desc.Enabled = was
				desc:SetAttribute("LokiInvisWasEnabled", nil)
			end
		end
	end
end

local function applyInvis(character: Model, isLocal: boolean, on: boolean)
	for _, desc in character:GetDescendants() do
		applyToInstance(desc, isLocal, on)
	end
end

local function hookCharacter(player: Player, character: Model)
	local isLocal = player == Players.LocalPlayer

	local function refresh()
		local on = character:GetAttribute(GameConstants.LOKI_INVISIBLE_ATTRIBUTE) == true
		applyInvis(character, isLocal, on)
	end

	refresh()
	character:GetAttributeChangedSignal(GameConstants.LOKI_INVISIBLE_ATTRIBUTE):Connect(refresh)

	character.DescendantAdded:Connect(function(desc)
		local on = character:GetAttribute(GameConstants.LOKI_INVISIBLE_ATTRIBUTE) == true
		if on then
			-- Defer so server invis attrs apply first, then local ghost override
			task.defer(function()
				if character.Parent and character:GetAttribute(GameConstants.LOKI_INVISIBLE_ATTRIBUTE) == true then
					applyToInstance(desc, isLocal, true)
				end
			end)
		end
	end)
end

function LokiInvisClient.init(localPlayer: Player)
	local function hookPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			hookCharacter(player, character)
		end)
		if player.Character then
			hookCharacter(player, player.Character)
		end
	end

	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end
	Players.PlayerAdded:Connect(hookPlayer)
end

return LokiInvisClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">MarvelGirlClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Marvel Girl client:
	- Mind Link chat (top-right, simple)
	- Astral Projection camera + flight input
	- Live cursor aim while Psionic Bolt fires
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local MouseHelper = require(script.Parent.MouseHelper)
local CameraShakeClient = require(script.Parent.CameraShakeClient)
local ScreenFxClient = require(script.Parent.ScreenFxClient)

local MarvelGirlClient = {}

function MarvelGirlClient.init(localPlayer: Player)
	local mindRemote = Remotes.getEvent("MindLink")
	local useAbility = Remotes.getEvent("UseAbility")
	local flightInput = Remotes.getEvent("FlightInput")
	local controls: any = nil
	pcall(function()
		local playerModule = require(localPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		controls = playerModule:GetControls()
	end)

	local playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui

	local overloadGui = Instance.new("ScreenGui")
	overloadGui.Name = "MCU_JeanOverload"
	overloadGui.ResetOnSpawn = false
	overloadGui.IgnoreGuiInset = true
	overloadGui.DisplayOrder = 120
	overloadGui.Enabled = true
	overloadGui.Parent = playerGui

	local function makeLid(name: string, anchorY: number, posY: number): Frame
		local lid = Instance.new("Frame")
		lid.Name = name
		lid.AnchorPoint = Vector2.new(0.5, anchorY)
		lid.Position = UDim2.fromScale(0.5, posY)
		lid.Size = UDim2.fromScale(1, 0)
		lid.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		lid.BorderSizePixel = 0
		lid.ZIndex = 10
		lid.Parent = overloadGui
		return lid
	end

	local topLid = makeLid("TopLid", 0, 0)
	local botLid = makeLid("BottomLid", 1, 1)

	local restText = Instance.new("TextLabel")
	restText.Name = "RestText"
	restText.AnchorPoint = Vector2.new(0.5, 0.5)
	restText.Position = UDim2.fromScale(0.5, 0.5)
	restText.Size = UDim2.fromScale(0.72, 0.12)
	restText.BackgroundTransparency = 1
	restText.Font = Enum.Font.GothamMedium
	restText.Text = "You overused your powers. You need to rest now... zzz"
	restText.TextColor3 = Color3.fromRGB(210, 220, 255)
	restText.TextScaled = true
	restText.TextTransparency = 1
	restText.ZIndex = 12
	restText.Parent = overloadGui

	local restStroke = Instance.new("UIStroke")
	restStroke.Thickness = 1.2
	restStroke.Color = Color3.fromRGB(40, 50, 110)
	restStroke.Transparency = 1
	restStroke.Parent = restText

	local restConstraint = Instance.new("UITextSizeConstraint")
	restConstraint.MaxTextSize = 28
	restConstraint.MinTextSize = 14
	restConstraint.Parent = restText

	local overloadOpen = false
	local function setOverloadVisual(on: boolean)
		if overloadOpen == on then
			return
		end
		overloadOpen = on
		local info = TweenInfo.new(if on then 0.58 else 0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		local lidSize = if on then UDim2.fromScale(1, 0.5) else UDim2.fromScale(1, 0)
		TweenService:Create(topLid, info, { Size = lidSize }):Play()
		TweenService:Create(botLid, info, { Size = lidSize }):Play()
		TweenService:Create(restText, info, { TextTransparency = if on then 0 else 1 }):Play()
		TweenService:Create(restStroke, info, { Transparency = if on then 0.35 else 1 }):Play()
		CameraShakeClient.setHeldLayer("jeanOverload", on, {
			fade = if on then 0.5 else 0.75,
			shake = if on then 0.22 else 0,
			fov = if on then 3.4 else 0,
			vignette = if on then 0.2 else 1,
			shakeRange = 1.2,
			shakeSlow = 0.5,
		})
	end

	local function hookOverload(character: Model)
		local function sync()
			local hero = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
			local on = hero == "jean_grey" and character:GetAttribute(GameConstants.MG_OVERLOAD_ATTRIBUTE) == true
			setOverloadVisual(on)
		end
		character:GetAttributeChangedSignal(GameConstants.MG_OVERLOAD_ATTRIBUTE):Connect(sync)
		character:GetAttributeChangedSignal(GameConstants.HERO_ATTRIBUTE):Connect(sync)
		sync()
	end

	if localPlayer.Character then
		hookOverload(localPlayer.Character)
	end
	localPlayer.CharacterAdded:Connect(hookOverload)

	-- Mind Link chat — top right, below settings, simple
	local gui = Instance.new("ScreenGui")
	gui.Name = "MCU_MindLink"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 60
	gui.Enabled = false
	gui.Parent = playerGui

	local panel = Instance.new("Frame")
	panel.Name = "Chat"
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.Position = UDim2.new(1, -12, 0, 88)
	panel.Size = UDim2.fromOffset(260, 220)
	panel.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
	panel.BackgroundTransparency = 0.12
	panel.BorderSizePixel = 0
	panel.Parent = gui
	if UserInputService.TouchEnabled then
		panel.Position = UDim2.new(1, -12, 0, 190)
	end

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = panel

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(65, 81, 253)
	stroke.Thickness = 1
	stroke.Transparency = 0.45
	stroke.Parent = panel

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, -40, 0, 22)
	title.Position = UDim2.fromOffset(6, 4)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamMedium
	title.TextSize = 14
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.fromRGB(160, 175, 255)
	title.Text = "Mind Link"
	title.Parent = panel

	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "Close"
	closeBtn.AnchorPoint = Vector2.new(1, 0)
	closeBtn.Position = UDim2.new(1, -6, 0, 4)
	closeBtn.Size = UDim2.fromOffset(22, 22)
	closeBtn.BackgroundColor3 = Color3.fromRGB(40, 28, 36)
	closeBtn.BackgroundTransparency = 0.2
	closeBtn.BorderSizePixel = 0
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.TextSize = 16
	closeBtn.TextColor3 = Color3.fromRGB(255, 170, 200)
	closeBtn.Text = "X"
	closeBtn.AutoButtonColor = true
	closeBtn.Visible = false
	closeBtn.Parent = panel

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 4)
	closeCorner.Parent = closeBtn

	local isMindLinkHost = false
	closeBtn.MouseButton1Click:Connect(function()
		if not isMindLinkHost or not gui.Enabled then
			return
		end
		mindRemote:FireServer({ action = "close" })
	end)

	local membersLabel = Instance.new("TextLabel")
	membersLabel.Name = "Members"
	membersLabel.Size = UDim2.new(1, -12, 0, 16)
	membersLabel.Position = UDim2.fromOffset(6, 24)
	membersLabel.BackgroundTransparency = 1
	membersLabel.Font = Enum.Font.Gotham
	membersLabel.TextSize = 11
	membersLabel.TextXAlignment = Enum.TextXAlignment.Left
	membersLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
	membersLabel.TextTruncate = Enum.TextTruncate.AtEnd
	membersLabel.Text = ""
	membersLabel.Parent = panel

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Messages"
	scroll.Position = UDim2.fromOffset(6, 44)
	scroll.Size = UDim2.new(1, -12, 1, -78)
	scroll.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
	scroll.BackgroundTransparency = 0.2
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = panel

	local scrollCorner = Instance.new("UICorner")
	scrollCorner.CornerRadius = UDim.new(0, 4)
	scrollCorner.Parent = scroll

	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 3)
	list.Parent = scroll

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.PaddingRight = UDim.new(0, 4)
	pad.Parent = scroll

	local input = Instance.new("TextBox")
	input.Name = "Input"
	input.AnchorPoint = Vector2.new(0, 1)
	input.Position = UDim2.new(0, 6, 1, -6)
	input.Size = UDim2.new(1, -12, 0, 26)
	input.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
	input.BorderSizePixel = 0
	input.ClearTextOnFocus = false
	input.Font = Enum.Font.Gotham
	input.TextSize = 13
	input.TextColor3 = Color3.fromRGB(240, 240, 245)
	input.PlaceholderText = "Message…"
	input.PlaceholderColor3 = Color3.fromRGB(120, 120, 130)
	input.Text = ""
	input.Parent = panel

	local inputCorner = Instance.new("UICorner")
	inputCorner.CornerRadius = UDim.new(0, 4)
	inputCorner.Parent = input

	local msgOrder = 0
	local lastSend = 0
	local astralActive = false
	local astralReturning = false
	local astralModel: Model? = nil
	local savedCameraSubject: Instance? = nil
	local DEFAULT_FOV = 70
	local FLIGHT_FOV_FAST = 80
	local FLIGHT_FOV_LERP = 5.5
	local astralFovBlend = 0
	local astralFovBase = DEFAULT_FOV
	local idleTrack: AnimationTrack? = nil
	local moveTrack: AnimationTrack? = nil
	local currentAnimMode: "none" | "idle" | "move" = "none"
	local astralVel = Vector3.zero
	local wantedAstralName: string? = nil
	local boundAstral: Model? = nil
	local painTimer = Instance.new("TextLabel")
	painTimer.Name = "AstralPainTimer"
	painTimer.AnchorPoint = Vector2.new(0.5, 0)
	painTimer.Position = UDim2.fromScale(0.5, 0.12)
	painTimer.Size = UDim2.fromOffset(220, 34)
	painTimer.BackgroundTransparency = 1
	painTimer.Font = Enum.Font.GothamBold
	painTimer.TextColor3 = Color3.fromRGB(255, 180, 220)
	painTimer.TextSize = 18
	painTimer.Visible = false
	painTimer.Parent = overloadGui

	local function clearAstralAnims()
		if idleTrack then
			idleTrack:Stop(0.12)
			idleTrack:Destroy()
			idleTrack = nil
		end
		if moveTrack then
			moveTrack:Stop(0.12)
			moveTrack:Destroy()
			moveTrack = nil
		end
		currentAnimMode = "none"
		boundAstral = nil
	end

	local function loadAstralTrack(animator: Animator, assetId: string): AnimationTrack?
		local anim = Instance.new("Animation")
		anim.AnimationId = assetId
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		anim:Destroy()
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			track.Looped = true
			return track
		end
		return nil
	end

	local function ensureAstralAnims(model: Model)
		if boundAstral == model then
			return
		end
		clearAstralAnims()
		boundAstral = model
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not hum then
			return
		end
		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = hum
		end
		idleTrack = loadAstralTrack(animator, GameConstants.JEAN_FLIGHT_IDLE_ANIM)
		moveTrack = loadAstralTrack(animator, GameConstants.JEAN_FLIGHT_MOVE_ANIM)
		if idleTrack then
			idleTrack.Priority = Enum.AnimationPriority.Action
		end
		if moveTrack then
			moveTrack.Priority = Enum.AnimationPriority.Action
		end
	end

	local function setAstralAnim(mode: "idle" | "move")
		if currentAnimMode == mode then
			return
		end
		if mode == "idle" then
			if moveTrack and moveTrack.IsPlaying then
				moveTrack:Stop(0.18)
			end
			if idleTrack and not idleTrack.IsPlaying then
				idleTrack:Play(0.18)
			end
		else
			if idleTrack and idleTrack.IsPlaying then
				idleTrack:Stop(0.2)
			end
			if moveTrack and not moveTrack.IsPlaying then
				moveTrack:Play(0.2)
			end
		end
		currentAnimMode = mode
	end

	local function clearMessages()
		for _, child in scroll:GetChildren() do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		msgOrder = 0
	end

	local chatNameHex = "#a0afff"

	local function applyAstralNoclip(model: Model, lockHumanoid: boolean?)
		pcall(function()
			if not PhysicsService:IsCollisionGroupRegistered("MarvelGirlAstral") then
				PhysicsService:RegisterCollisionGroup("MarvelGirlAstral")
			end
			PhysicsService:CollisionGroupSetCollidable("MarvelGirlAstral", "Default", false)
		end)
		for _, desc in model:GetDescendants() do
			if desc:IsA("BasePart") then
				desc.CanCollide = false
				desc.CanQuery = false
				desc.CanTouch = false
				desc.Massless = true
				pcall(function()
					desc.CollisionGroup = "MarvelGirlAstral"
				end)
			end
		end
		if lockHumanoid then
			local hum = model:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.HipHeight = 0
				pcall(function()
					(hum :: any).EvaluateStateMachine = false
				end)
			end
		end
	end

	local function addMessage(fromName: string, text: string)
		msgOrder += 1
		local row = Instance.new("TextLabel")
		row.Name = "Msg" .. tostring(msgOrder)
		row.LayoutOrder = msgOrder
		row.Size = UDim2.new(1, -4, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		row.BackgroundTransparency = 1
		row.Font = Enum.Font.Gotham
		row.TextSize = 12
		row.TextColor3 = Color3.fromRGB(230, 230, 235)
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextYAlignment = Enum.TextYAlignment.Top
		row.TextWrapped = true
		row.RichText = true
		row.Text = string.format('<font color="%s">%s</font>: %s', chatNameHex, fromName, text)
		row.Parent = scroll
		task.defer(function()
			scroll.CanvasPosition = Vector2.new(0, scroll.AbsoluteCanvasSize.Y)
		end)
	end

	local function applyMindLinkTheme()
		local char = localPlayer.Character
		local skin = if char then char:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE) else nil
		local is97 = skin ~= "marvel_girl"
		local accent = if is97 then Color3.fromRGB(65, 81, 253) else Color3.fromRGB(255, 90, 185)
		local titleCol = if is97 then Color3.fromRGB(160, 175, 255) else Color3.fromRGB(255, 170, 220)
		stroke.Color = accent
		title.TextColor3 = titleCol
		chatNameHex = if is97 then "#a0afff" else "#ff9ad0"
	end

	local function showChat(on: boolean, smooth: boolean?)
		if on then
			applyMindLinkTheme()
			gui.Enabled = true
			panel.BackgroundTransparency = 0.12
			closeBtn.Visible = isMindLinkHost
			return
		end
		isMindLinkHost = false
		closeBtn.Visible = false
		if smooth then
			TweenService:Create(panel, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundTransparency = 1,
			}):Play()
			task.delay(0.5, function()
				gui.Enabled = false
				clearMessages()
				input.Text = ""
			end)
		else
			gui.Enabled = false
			clearMessages()
			input.Text = ""
		end
	end

	input.FocusLost:Connect(function(enter)
		if not enter or not gui.Enabled then
			return
		end
		local text = string.gsub(input.Text, "^%s+", "")
		text = string.gsub(text, "%s+$", "")
		if text == "" then
			return
		end
		local now = os.clock()
		if now - lastSend < GameConstants.MG_MIND_LINK_MSG_COOLDOWN then
			return
		end
		lastSend = now
		input.Text = ""
		mindRemote:FireServer({ action = "message", text = text })
	end)

	local function countNames(list: any): number
		if type(list) ~= "table" then
			return 0
		end
		return #list
	end

	local function setMindLinkFeel(on: boolean)
		CameraShakeClient.setHeldLayer("mindlink", on, {
			fade = 0.4,
			shake = 0.07,
			fov = 0,
			vignette = 0.78,
		})
	end

	local function setShieldFeel(on: boolean)
		CameraShakeClient.setHeldLayer("shield", on, {
			fade = 0.4,
			shake = 0.06,
			fov = -1.0,
			vignette = 0.5,
			shakeRange = 1.0,
			shakeSlow = 0.38,
		})
	end

	local function hookJeanFeel(character: Model)
		local function refreshShield()
			setShieldFeel(character:GetAttribute(GameConstants.MG_BARRIER_ATTRIBUTE) == true)
		end
		local debrisAttr = AbilityCooldownHelper.getActiveAttributeName("telekinetic_debris")
		local function refreshDebris()
			CameraShakeClient.setHeldLayer("debris", character:GetAttribute(debrisAttr) == true, {
				fade = 0.3,
				shake = 0.05,
				fov = 0,
				vignette = 0.5,
			})
		end
		local function refreshTk()
			CameraShakeClient.setHeldLayer("telekinesis", character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true, {
				fade = 0.45,
				shake = 0.035,
				fov = 0,
				vignette = 0.88,
				shakeRange = 0.42,
				shakeSlow = 0.18,
			})
		end
		character:GetAttributeChangedSignal(GameConstants.MG_BARRIER_ATTRIBUTE):Connect(refreshShield)
		character:GetAttributeChangedSignal(debrisAttr):Connect(refreshDebris)
		character:GetAttributeChangedSignal(GameConstants.TK_ACTIVE_ATTRIBUTE):Connect(refreshTk)
		local lingerUntil = 0
		local function anyAbilityActive(model: Model): boolean
			for name, value in model:GetAttributes() do
				if type(name) == "string" and string.sub(name, 1, 14) == "AbilityActive_" and value == true then
					if name == "AbilityActive_jean_hair" then
						continue
					end
					return true
				end
			end
			return false
		end
		local function refreshScreen()
			local hero = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
			local activeNow = hero == "jean_grey"
				and (
					anyAbilityActive(character)
					or character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true
					or character:GetAttribute(GameConstants.MG_BARRIER_ATTRIBUTE) == true
					or character:GetAttribute(GameConstants.MG_OVERLOAD_ATTRIBUTE) == true
					or character:GetAttribute(GameConstants.MG_WAKING_ATTRIBUTE) == true
					or character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
					or astralActive
				)
			if activeNow then
				lingerUntil = os.clock() + 1.35
				task.delay(1.4, refreshScreen)
			end
			local fxOn = activeNow or os.clock() < lingerUntil
			local look = character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE)
			if look == "phoenix" then
				ScreenFxClient.setEnabled("jean", false)
				ScreenFxClient.setEnabled("phoenix", fxOn)
			else
				ScreenFxClient.setEnabled("phoenix", false)
				if look == "marvel_girl" then
					ScreenFxClient.setTint("jean", GameConstants.MG_PSI_COLOR_MARVEL_GIRL)
				else
					ScreenFxClient.setTint("jean", GameConstants.MG_PSI_COLOR)
				end
				ScreenFxClient.setEnabled("jean", fxOn)
			end
		end
		character.AttributeChanged:Connect(function(attr)
			if string.sub(attr, 1, 14) == "AbilityActive_"
				or attr == GameConstants.HERO_ATTRIBUTE
				or attr == GameConstants.LOOK_MODE_ATTRIBUTE
				or attr == GameConstants.TK_ACTIVE_ATTRIBUTE
				or attr == GameConstants.MG_BARRIER_ATTRIBUTE
				or attr == GameConstants.IS_FLYING_ATTRIBUTE
				or attr == GameConstants.MG_OVERLOAD_ATTRIBUTE
				or attr == GameConstants.MG_WAKING_ATTRIBUTE
			then
				refreshScreen()
			end
		end)
		refreshShield()
		refreshDebris()
		refreshTk()
		refreshScreen()
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Died:Connect(function()
				showChat(false, false)
				setMindLinkFeel(false)
				isMindLinkHost = false
			end)
		end
	end

	localPlayer.CharacterAdded:Connect(hookJeanFeel)
	localPlayer.CharacterRemoving:Connect(function()
		ScreenFxClient.setEnabled("jean", false)
		ScreenFxClient.setEnabled("phoenix", false)
	end)
	if localPlayer.Character then
		hookJeanFeel(localPlayer.Character)
	end

	local function endAstralCamera()
		astralActive = false
		painTimer.Visible = false
		ScreenFxClient.setEnabled("jean", false)
		astralReturning = false
		astralModel = nil
		wantedAstralName = nil
		astralVel = Vector3.zero
		astralFovBlend = 0
		astralFovBase = DEFAULT_FOV
		clearAstralAnims()
		CameraShakeClient.setHeldVignette(false, 0.55)
		local cam = Workspace.CurrentCamera
		if cam then
			TweenService:Create(cam, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				FieldOfView = DEFAULT_FOV,
			}):Play()
		end
		if cam and localPlayer.Character then
			local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
			cam.CameraSubject = hum or savedCameraSubject
		elseif cam and savedCameraSubject then
			cam.CameraSubject = savedCameraSubject
		end
		savedCameraSubject = nil
	end

	local function beginAstralCamera(astralName: string?)
		astralActive = true
		local character = localPlayer.Character
		local look = character and character:GetAttribute(GameConstants.LOOK_MODE_ATTRIBUTE)
		ScreenFxClient.setTint(
			"jean",
			if look == "marvel_girl" then GameConstants.MG_PSI_COLOR_MARVEL_GIRL else GameConstants.MG_PSI_COLOR
		)
		ScreenFxClient.setEnabled("jean", true)
		astralReturning = false
		astralVel = Vector3.zero
		wantedAstralName = if type(astralName) == "string" and astralName ~= "" then astralName else "MarvelGirlAstral"
		CameraShakeClient.setHeldVignette(true, 0.5)
		local cam = Workspace.CurrentCamera
		if cam then
			savedCameraSubject = cam.CameraSubject
			TweenService:Create(cam, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				FieldOfView = DEFAULT_FOV,
			}):Play()
		end
		task.spawn(function()
			for _ = 1, 40 do
				if not astralActive then
					return
				end
				local found = Workspace:FindFirstChild(wantedAstralName :: string)
				if not found then
					found = Workspace:FindFirstChild("MarvelGirlAstral")
				end
				if found and found:IsA("Model") then
					astralModel = found
					applyAstralNoclip(found, true)
					ensureAstralAnims(found)
					local hum = found:FindFirstChildOfClass("Humanoid")
					local liveCam = Workspace.CurrentCamera
					if liveCam and hum then
						liveCam.CameraSubject = hum
					end
					return
				end
				task.wait(0.05)
			end
		end)
	end

	mindRemote.OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" then
			return
		end
		local phase = payload.phase
		if phase == "start" then
			isMindLinkHost = payload.isHost == true
			local names = payload.members
			if type(names) == "table" then
				membersLabel.Text = table.concat(names, ", ")
			else
				membersLabel.Text = ""
			end
			clearMessages()
			showChat(true)
			setMindLinkFeel(isMindLinkHost ~= true or countNames(names) > 1)
		elseif phase == "members" then
			if type(payload.members) == "table" then
				membersLabel.Text = table.concat(payload.members, ", ")
			end
			setMindLinkFeel(countNames(payload.members) > 1)
		elseif phase == "message" then
			if type(payload.from) == "string" and type(payload.text) == "string" then
				addMessage(payload.from, payload.text)
			end
		elseif phase == "end" then
			setMindLinkFeel(false)
			showChat(false, false)
		elseif phase == "end_smooth" then
			setMindLinkFeel(false)
			showChat(false, true)
		elseif phase == "astral_start" then
			beginAstralCamera(if type(payload.astralName) == "string" then payload.astralName else nil)
		elseif phase == "astral_returning" then
			astralReturning = true
			CameraShakeClient.setHeldVignette(false, if type(payload.duration) == "number" then payload.duration else GameConstants.MG_ASTRAL_RETURN_TIME)
			local cam = Workspace.CurrentCamera
			if cam then
				TweenService:Create(cam, TweenInfo.new(
					if type(payload.duration) == "number" then payload.duration else GameConstants.MG_ASTRAL_RETURN_TIME,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.InOut
				), {
					FieldOfView = DEFAULT_FOV + 2,
				}):Play()
			end
		elseif phase == "astral_end" then
			endAstralCamera()
		end
	end)

	-- Hide mind-link particles/beams unless this player is linked
	local function setMindLinkFxVisible(root: Instance, visible: boolean)
		for _, desc in root:GetDescendants() do
			if desc:IsA("ParticleEmitter") or desc:IsA("Beam") or desc:IsA("Trail") then
				desc.Enabled = visible
			elseif desc:IsA("BasePart") and desc:GetAttribute("MgMindLinkFx") == true then
				desc.LocalTransparencyModifier = if visible then 0 else 1
			end
		end
		if root:GetAttribute("MgMindLinkFx") == true then
			if root:IsA("BasePart") then
				root.LocalTransparencyModifier = if visible then 0 else 1
			end
			for _, desc in root:GetDescendants() do
				if desc:IsA("ParticleEmitter") or desc:IsA("Beam") or desc:IsA("Trail") then
					desc.Enabled = visible
				end
			end
		end
	end

	local function refreshMindLinkVisibility()
		local character = localPlayer.Character
		local linked = character ~= nil and character:GetAttribute(GameConstants.MG_MIND_LINK_ATTRIBUTE) == true
		for _, plr in Players:GetPlayers() do
			local model = plr.Character
			if not model then
				continue
			end
			for _, child in model:GetDescendants() do
				if child.Name == "MgMindLinkJean" or child.Name == "MgMindLinkTarget" or child:GetAttribute("MgMindLinkFx") == true then
					setMindLinkFxVisible(child, linked)
				end
			end
		end
		local linker = Workspace:FindFirstChild("MindLinker")
		if linker then
			for _, child in linker:GetDescendants() do
				if child.Name == "MgMindLinkTarget" or child:GetAttribute("MgMindLinkFx") == true then
					setMindLinkFxVisible(child, linked)
				end
			end
		end
	end

	RunService.Heartbeat:Connect(function()
		refreshMindLinkVisibility()
	end)

	-- Live aim while psionic bolt + astral flight
	local lastAim = 0
	RunService.RenderStepped:Connect(function(dt)
		if not astralActive then
			return
		end
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end

		-- Keep camera on astral (including during smooth return)
		if astralModel and astralModel.Parent then
			local hum = astralModel:FindFirstChildOfClass("Humanoid")
			if hum and cam.CameraSubject ~= hum then
				cam.CameraSubject = hum
			end
		end

		if astralReturning then
			return
		end

		local body = localPlayer.Character
		local outbursting = body ~= nil
			and AbilityCooldownHelper.isActive(body, "telepathic_outburst")
		local painActive = body ~= nil
			and AbilityCooldownHelper.isActive(body, "telepathic_pain")

		local look = cam.CFrame.LookVector
		local right = cam.CFrame.RightVector
		local w = if UserInputService:IsKeyDown(Enum.KeyCode.W) then 1 else 0
		local s = if UserInputService:IsKeyDown(Enum.KeyCode.S) then 1 else 0
		local a = if UserInputService:IsKeyDown(Enum.KeyCode.A) then 1 else 0
		local d = if UserInputService:IsKeyDown(Enum.KeyCode.D) then 1 else 0
		local sideInput = d - a
		local moveDir = look * (w - s) + right * sideInput
		if controls and UserInputService.TouchEnabled and moveDir.Magnitude < 0.01 then
			local inputMove = controls:GetMoveVector()
			moveDir = right * inputMove.X + look * -inputMove.Z
			sideInput = math.clamp(inputMove.X, -1, 1)
		end
		if outbursting or painActive then
			moveDir = Vector3.zero
			sideInput = 0
			astralVel = Vector3.zero
		elseif moveDir.Magnitude > 1 then
			moveDir = moveDir.Unit
		end

		if astralModel and astralModel.Parent and not astralReturning then
			applyAstralNoclip(astralModel)
			local root = astralModel:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				local lin = root:FindFirstChild("HeroLinearVelocity")
				local align = root:FindFirstChild("HeroAlignOrientation")
				local grav = root:FindFirstChild("HeroGravityCancel")
				if outbursting or painActive then
					if lin and lin:IsA("LinearVelocity") then
						lin.VectorVelocity = Vector3.zero
					else
						root.AssemblyLinearVelocity = Vector3.zero
					end
					root.AssemblyAngularVelocity = Vector3.zero
					if grav and grav:IsA("VectorForce") then
						grav.Force = Vector3.new(0, root.AssemblyMass * Workspace.Gravity, 0)
					end
					if painActive and align and align:IsA("AlignOrientation") then
						local lookAt = body and body:GetAttribute(GameConstants.MG_PAIN_LOOK_ATTRIBUTE)
						if typeof(lookAt) ~= "Vector3" then
							lookAt = astralModel:GetAttribute(GameConstants.MG_PAIN_LOOK_ATTRIBUTE)
						end
						if typeof(lookAt) == "Vector3" then
							local to = lookAt - root.Position
							if to.Magnitude > 0.08 then
								align.CFrame = CFrame.lookAt(root.Position, root.Position + to.Unit)
							end
						end
					end
				else
				local speed = GameConstants.FLIGHT_SPEED
				local moveMag = moveDir.Magnitude
				local direction = if moveMag > 0.01 then moveDir.Unit else (if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1))
				local targetVel = if moveMag > 0.01 then direction * speed else Vector3.zero
				local velLerpMove = 1 - (1 - GameConstants.FLIGHT_VEL_LERP_MOVE) ^ (dt * 60)
				local velLerpDecay = 1 - (1 - GameConstants.FLIGHT_VEL_LERP_DECAY) ^ (dt * 60)
				local lerpAlpha = if moveMag > 0.01 then velLerpMove else velLerpDecay
				astralVel = astralVel:Lerp(targetVel, lerpAlpha)
				if lin and lin:IsA("LinearVelocity") then
					lin.VectorVelocity = astralVel
				else
					root.AssemblyLinearVelocity = astralVel
				end
				if grav and grav:IsA("VectorForce") then
					grav.Force = Vector3.new(0, root.AssemblyMass * Workspace.Gravity, 0)
				end
				if align and align:IsA("AlignOrientation") then
					local velMag = astralVel.Magnitude
					local alphaSpeed = if speed > 0 then velMag / speed else 0
					local facingDir = if moveMag > 0.01 then direction else look
					if facingDir.Magnitude < 0.01 then
						facingDir = Vector3.new(0, 0, -1)
					else
						facingDir = facingDir.Unit
					end
					local pitchAlpha = if moveMag > 0.01 then math.min(1, alphaSpeed) * 1.15 else 0
					local sideYaw = math.clamp(sideInput, -1, 1) * GameConstants.FLIGHT_SIDE_YAW * math.clamp(alphaSpeed, 0, 1)
					local bank = math.clamp(sideInput, -1, 1) * GameConstants.FLIGHT_BANK_MAX * math.clamp(alphaSpeed, 0, 1)
					local baseCf = CFrame.lookAt(root.Position, root.Position + facingDir)
					local targetCf = baseCf * CFrame.Angles(
						math.rad(-pitchAlpha * GameConstants.MG_FLIGHT_PITCH_MAX),
						math.rad(sideYaw),
						math.rad(-bank)
					)
					local rotAlpha = 1 - (1 - GameConstants.FLIGHT_ROTATION_LERP) ^ (dt * 60)
					align.CFrame = align.CFrame:Lerp(targetCf, rotAlpha)
				end
				end
			end
		end

		flightInput:FireServer({
			moveVector = moveDir,
			lookVector = look,
			moveDir = moveDir,
			lookDir = look,
			sideInput = sideInput,
		})
		mindRemote:FireServer({
			action = "astral_input",
			moveDir = moveDir,
			lookDir = look,
			sideInput = sideInput,
		})

		if astralModel and astralModel.Parent then
			ensureAstralAnims(astralModel)
			local moving = moveDir.Magnitude > GameConstants.FLIGHT_ANIM_MOVE_THRESHOLD
			setAstralAnim(if moving then "move" else "idle")

			local spd = astralVel.Magnitude
			local speedT = math.clamp(spd / math.max(GameConstants.MG_ASTRAL_FLIGHT_SPEED, 1), 0, 1)
			local blendRate = if speedT < astralFovBlend then 3.1 else 4.6
			astralFovBlend += (speedT - astralFovBlend) * math.clamp(dt * blendRate, 0, 1)
			local targetFov = DEFAULT_FOV + (FLIGHT_FOV_FAST - DEFAULT_FOV) * astralFovBlend
			if not CameraShakeClient.isAbilityZoomEnabled() then
				targetFov = DEFAULT_FOV
			end
			astralFovBase += (targetFov - astralFovBase) * math.clamp(dt * FLIGHT_FOV_LERP, 0, 1)
			cam.FieldOfView = astralFovBase + CameraShakeClient.getFovPunch()
		end
	end)

	RunService.Heartbeat:Connect(function()
		local character = localPlayer.Character
		if not character then
			return
		end
		if AbilityCooldownHelper.isActive(character, "psionic_bolt") then
			local now = os.clock()
			if now - lastAim >= 0.03 then
				lastAim = now
				useAbility:FireServer({
					action = "E_aim",
					direction = MouseHelper.getWorldDirection(localPlayer),
					aimPoint = MouseHelper.getHitPosition(localPlayer, 200),
				})
			end
		end
	end)

	-- Press V again to end astral (also handled via UseAbility → server toggle)
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp or not astralActive or astralReturning then
			return
		end
		if input.KeyCode == Enum.KeyCode.H or input.KeyCode == Enum.KeyCode.V then
			mindRemote:FireServer({ action = "astral_end" })
		end
	end)

	localPlayer.CharacterRemoving:Connect(function()
		endAstralCamera()
		showChat(false, false)
		setOverloadVisual(false)
	end)
end

return MarvelGirlClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">MouseHelper</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local InteractableHelper = require(ReplicatedStorage.Shared.InteractableHelper)
local CombatHelper = require(ReplicatedStorage.Shared.CombatHelper)

local MouseHelper = {}

local function getSoftLock()
	return require(script.Parent.SoftLockClient)
end

local function getRay(player: Player): (Vector3, Vector3)
	local camera = workspace.CurrentCamera
	if not camera then
		return Vector3.zero, Vector3.new(0, 0, -1)
	end
	local mousePos = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
	return ray.Origin, ray.Direction
end

local function characterFromInstance(inst: Instance?, selfChar: Model?): Model?
	if not inst then
		return nil
	end
	local current: Instance? = inst
	while current do
		if current:IsA("Model") and current ~= selfChar then
			local hum = current:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				return current
			end
		end
		current = current.Parent
	end
	return nil
end

local function getCharacterRoot(model: Model): BasePart?
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	local torso = model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	return nil
end

local function distPointToRay(point: Vector3, origin: Vector3, dir: Vector3, range: number): number
	local to = point - origin
	local along = to:Dot(dir)
	if along < 0 or along > range then
		return math.huge
	end
	return (point - (origin + dir * along)).Magnitude
end

local function closestCharacterAlongRay(selfChar: Model?, origin: Vector3, dir: Vector3, range: number): Model?
	local best: Model? = nil
	local bestDist = 10
	local function consider(model: Model)
		if model == selfChar or not CombatHelper.isCombatEligible(model) then
			return
		end
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then
			return
		end
		local root = getCharacterRoot(model)
		if not root then
			return
		end
		local d = distPointToRay(root.Position, origin, dir, range)
		if d < bestDist then
			bestDist = d
			best = model
		end
	end
	for _, plr in Players:GetPlayers() do
		if plr.Character then
			consider(plr.Character)
		end
	end
	for _, child in workspace:GetChildren() do
		if child:IsA("Model") then
			consider(child)
		end
	end
	return best
end

function MouseHelper.getWorldDirection(player: Player): Vector3
	local SoftLock = getSoftLock()
	local lockPoint = SoftLock.getLockedAimPoint()
	if lockPoint then
		local origin = getRay(player)
		local to = lockPoint - origin
		if to.Magnitude > 0.05 then
			return to.Unit
		end
	end
	local _, dir = getRay(player)
	if dir.Magnitude < 0.01 then
		return Vector3.new(0, 0, -1)
	end
	return dir.Unit
end

function MouseHelper.getHitPosition(player: Player, maxDist: number?): Vector3
	local SoftLock = getSoftLock()
	local lockPoint = SoftLock.getLockedAimPoint()
	if lockPoint then
		return lockPoint
	end

	local origin, dir = getRay(player)
	local range = maxDist or 500
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = {}
	if player.Character then
		table.insert(exclude, player.Character)
	end
	params.FilterDescendantsInstances = exclude
	local result = workspace:Raycast(origin, dir.Unit * range, params)
	if result then
		return result.Position
	end
	return origin + dir.Unit * range
end

function MouseHelper.getHoveredPart(player: Player, maxDist: number?): BasePart?
	local SoftLock = getSoftLock()
	local locked = SoftLock.getLockedTarget()
	if locked then
		local root = getCharacterRoot(locked)
		if root then
			return root
		end
	end

	local selfChar = player.Character
	local range = maxDist or 70
	local mouse = player:GetMouse()
	if mouse.Target and mouse.Target:IsA("BasePart") then
		local part = mouse.Target
		if not selfChar or not part:IsDescendantOf(selfChar) then
			return part
		end
	end
	local origin, dir = getRay(player)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	if selfChar then
		params.FilterDescendantsInstances = { selfChar }
	end
	local result = workspace:Raycast(origin, dir.Unit * range, params)
	if result and result.Instance:IsA("BasePart") then
		return result.Instance
	end
	return nil
end

function MouseHelper.getHoveredCharacter(player: Player, maxDist: number?): Model?
	local SoftLock = getSoftLock()
	local locked = SoftLock.getLockedTarget()
	if locked and locked.Parent and CombatHelper.isCombatEligible(locked) then
		return locked
	end

	local selfChar = player.Character
	local range = maxDist or 200
	local casterRoot = if selfChar then getCharacterRoot(selfChar) else nil
	local origin, dir = getRay(player)
	if dir.Magnitude < 0.01 then
		dir = Vector3.new(0, 0, -1)
	else
		dir = dir.Unit
	end

	local mouse = player:GetMouse()
	local fromMouse = characterFromInstance(mouse.Target, selfChar)
	if fromMouse and CombatHelper.isCombatEligible(fromMouse) then
		local root = getCharacterRoot(fromMouse)
		if root then
			if not casterRoot or (root.Position - casterRoot.Position).Magnitude <= range then
				return fromMouse
			end
		end
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	if selfChar then
		params.FilterDescendantsInstances = { selfChar }
	end
	local sphere = workspace:Spherecast(origin, 8, dir * range, params)
	local fromSphere = characterFromInstance(if sphere then sphere.Instance else nil, selfChar)
	if fromSphere and CombatHelper.isCombatEligible(fromSphere) then
		return fromSphere
	end

	local along = closestCharacterAlongRay(selfChar, origin, dir, range)
	if along then
		return along
	end

	local result = workspace:Raycast(origin, dir * range, params)
	local fromRay = characterFromInstance(if result then result.Instance else nil, selfChar)
	if fromRay and CombatHelper.isCombatEligible(fromRay) then
		return fromRay
	end
	return nil
end

function MouseHelper.getDirectHoveredCharacter(player: Player, maxDist: number?): Model?
	local selfChar = player.Character
	local range = maxDist or 200
	local casterRoot = if selfChar then getCharacterRoot(selfChar) else nil
	local mouse = player:GetMouse()
	local fromMouse = characterFromInstance(mouse.Target, selfChar)
	if fromMouse and CombatHelper.isCombatEligible(fromMouse) then
		local root = getCharacterRoot(fromMouse)
		if root then
			if not casterRoot or (root.Position - casterRoot.Position).Magnitude <= range then
				return fromMouse
			end
		end
	end
	local origin, dir = getRay(player)
	if dir.Magnitude < 0.01 then
		return nil
	end
	dir = dir.Unit
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	if selfChar then
		params.FilterDescendantsInstances = { selfChar }
	end
	local result = workspace:Raycast(origin, dir * range, params)
	local fromRay = characterFromInstance(if result then result.Instance else nil, selfChar)
	if fromRay and CombatHelper.isCombatEligible(fromRay) then
		return fromRay
	end
	return nil
end

function MouseHelper.getHoveredInteractable(player: Player, maxDist: number?): Instance?
	local selfChar = player.Character
	local origin, dir = getRay(player)
	return InteractableHelper.raycast(origin, dir, maxDist or 70, selfChar)
end

return MouseHelper
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">PartialShieldClient</string>
            <string name="Source"><![CDATA[--!strict
-- Instant local PartialShield VFX: unreliable remote + client-side bolt proximity predict.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local VfxHelper = require(ReplicatedStorage.Shared.VfxHelper)

local PartialShieldClient = {}

local HIT_RADIUS = 9
local predicted: { [Instance]: boolean } = {}
local lastBurstAt: { [Model]: number } = {}

local function spawnLocalBurst(character: Model, hitFrom: Vector3?)
	-- Jean / Invisible Woman use persistent forcefields — never Wanda partial shells
	if
		character:GetAttribute(GameConstants.MG_BARRIER_ATTRIBUTE) == true
		or character:GetAttribute(GameConstants.IW_FORCEFIELD_ATTRIBUTE) == true
		or character:GetAttribute(GameConstants.IW_FLIGHT_SHIELD_ATTRIBUTE) == true
		or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "jean_grey"
		or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "invisible_woman"
	then
		return
	end

	local now = os.clock()
	local last = lastBurstAt[character]
	if last and (now - last) < 0.05 then
		return
	end
	lastBurstAt[character] = now

	local root = character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		return
	end

	local shell = VfxHelper.spawnPartialShieldShell(root, hitFrom, 10)
	if not shell then
		return
	end

	task.delay(GameConstants.SHIELD_PARTIAL_EMIT_TIME, function()
		if not shell.Parent then
			return
		end
		VfxHelper.setParticlesEnabled(shell, false)
		task.delay(GameConstants.SHIELD_PARTIAL_DELETE_DELAY, function()
			if shell.Parent then
				shell:Destroy()
			end
		end)
	end)
end

local function getBoltPosition(inst: Instance): Vector3?
	if inst:IsA("BasePart") then
		return inst.Position
	end
	if inst:IsA("Model") then
		local pp = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
		return if pp then pp.Position else nil
	end
	return nil
end

local function predictHits(character: Model)
	if character:GetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE) ~= true then
		return
	end
	if
		character:GetAttribute(GameConstants.MG_BARRIER_ATTRIBUTE) == true
		or character:GetAttribute(GameConstants.IW_FORCEFIELD_ATTRIBUTE) == true
		or character:GetAttribute(GameConstants.IW_FLIGHT_SHIELD_ATTRIBUTE) == true
		or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "jean_grey"
		or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "invisible_woman"
	then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	for _, child in Workspace:GetChildren() do
		if child.Name ~= "HexProjectile" then
			continue
		end
		if predicted[child] then
			continue
		end
		local pos = getBoltPosition(child)
		if not pos then
			continue
		end
		if (pos - root.Position).Magnitude > HIT_RADIUS then
			continue
		end
		predicted[child] = true
		spawnLocalBurst(character, pos)
		child.Destroying:Once(function()
			predicted[child] = nil
		end)
	end
end

function PartialShieldClient.init(player: Player)
	local hitEvent = Remotes.getUnreliableEvent("ShieldPartialHit")
	hitEvent.OnClientEvent:Connect(function(character: any, hitFrom: any)
		if typeof(character) ~= "Instance" or not character:IsA("Model") then
			return
		end
		spawnLocalBurst(character, if typeof(hitFrom) == "Vector3" then hitFrom else nil)
	end)

	RunService.Heartbeat:Connect(function()
		local character = player.Character
		if character then
			predictHits(character)
		end
	end)
end

return PartialShieldClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">PlayerDataClient</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ShopCatalog = require(ReplicatedStorage.Shared.ShopCatalog)

export type PlayerProfile = {
	coins: number,
	kills: number,
	ownedCharacters: { string },
	ownedSkins: { [string]: { string } },
	ownedBundles: { string },
	hasEliteGamepass: boolean,
	redeemedCodes: { string },
}

local PlayerDataClient = {}

local profile: PlayerProfile? = nil
local listeners: { () -> () } = {}

local function defaultProfile(): PlayerProfile
	local raw = ShopCatalog.getDefaultProfile()
	return {
		coins = raw.coins,
		kills = raw.kills,
		ownedCharacters = table.clone(raw.ownedCharacters),
		ownedSkins = {},
		ownedBundles = table.clone(raw.ownedBundles),
		hasEliteGamepass = raw.hasEliteGamepass,
		redeemedCodes = table.clone(raw.redeemedCodes),
	}
end

local function notify()
	for _, fn in listeners do
		task.spawn(fn)
	end
end

function PlayerDataClient.onChanged(fn: () -> ())
	table.insert(listeners, fn)
end

function PlayerDataClient.getProfile(): PlayerProfile?
	return profile
end

function PlayerDataClient.getCoins(): number
	if profile then
		return profile.coins
	end
	local player = Players.LocalPlayer
	local attr = player:GetAttribute(GameConstants.COINS_ATTRIBUTE)
	if type(attr) == "number" then
		return attr
	end
	return 0
end

function PlayerDataClient.getKills(): number
	if profile then
		return profile.kills
	end
	local player = Players.LocalPlayer
	local attr = player:GetAttribute(GameConstants.KILLS_ATTRIBUTE)
	if type(attr) == "number" then
		return attr
	end
	return 0
end

function PlayerDataClient.isReady(): boolean
	return profile ~= nil
end

function PlayerDataClient.ownsCharacter(heroId: string): boolean
	if ShopCatalog.UNLOCK_ALL then
		return true
	end
	if profile then
		return ShopCatalog.ownsCharacter(profile, heroId)
	end
	return ShopCatalog.isFreeCharacter(heroId)
end

function PlayerDataClient.ownsSkin(heroId: string, skinId: string): boolean
	if ShopCatalog.UNLOCK_ALL then
		return true
	end
	if profile then
		return ShopCatalog.ownsSkin(profile, heroId, skinId)
	end
	return skinId == "base" and ShopCatalog.isFreeCharacter(heroId)
end

function PlayerDataClient.ownsShopItem(itemId: string): boolean
	local item = ShopCatalog.getItem(itemId)
	local p = profile
	if not item or not p then
		return false
	end
	if item.kind == "gamepass" and p.hasEliteGamepass then
		return true
	end
	if item.grantCharacter and ShopCatalog.ownsCharacter(p, item.grantCharacter) then
		if item.kind == "character" or item.kind == "devproduct" then
			return true
		end
	end
	if item.grantBundle and ShopCatalog.ownsBundle(p, item.grantBundle) then
		return true
	end
	if item.grantSkins then
		for _, pair in item.grantSkins do
			if not ShopCatalog.ownsSkin(p, pair.heroId, pair.skinId) then
				return false
			end
		end
		return true
	end
	return false
end

local function applyPayload(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local nextProfile = defaultProfile()
	if type(payload.coins) == "number" then
		nextProfile.coins = math.max(0, math.floor(payload.coins))
	end
	if type(payload.kills) == "number" then
		nextProfile.kills = math.max(0, math.floor(payload.kills))
	end
	if type(payload.ownedCharacters) == "table" then
		nextProfile.ownedCharacters = {}
		for _, id in payload.ownedCharacters do
			if type(id) == "string" then
				table.insert(nextProfile.ownedCharacters, id)
			end
		end
	end
	if type(payload.ownedSkins) == "table" then
		nextProfile.ownedSkins = {}
		for heroId, skins in payload.ownedSkins do
			if type(heroId) == "string" and type(skins) == "table" then
				local list: { string } = {}
				for _, skinId in skins do
					if type(skinId) == "string" then
						table.insert(list, skinId)
					end
				end
				nextProfile.ownedSkins[heroId] = list
			end
		end
	end
	if type(payload.ownedBundles) == "table" then
		nextProfile.ownedBundles = {}
		for _, id in payload.ownedBundles do
			if type(id) == "string" then
				table.insert(nextProfile.ownedBundles, id)
			end
		end
	end
	if payload.hasEliteGamepass == true then
		nextProfile.hasEliteGamepass = true
	end
	profile = nextProfile
	notify()
end

function PlayerDataClient.init(player: Player)
	Remotes.getEvent("PlayerDataSync").OnClientEvent:Connect(applyPayload)
	player:GetAttributeChangedSignal(GameConstants.COINS_ATTRIBUTE):Connect(notify)
	player:GetAttributeChangedSignal(GameConstants.KILLS_ATTRIBUTE):Connect(notify)
end

return PlayerDataClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">RagdollController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Local visuals for living Ragdolled status (adapted from NewMarvelProject).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local RagdollController = {}

local MOTOR6D_PART_MAP: { [string]: string } = {
	-- R15
	["Neck"] = "Head",
	["LeftShoulder"] = "LeftUpperArm",
	["RightShoulder"] = "RightUpperArm",
	["Waist"] = "LowerTorso",
	["LeftHip"] = "LeftUpperLeg",
	["RightHip"] = "RightUpperLeg",
	["Root"] = "UpperTorso",
	["LeftElbow"] = "LeftLowerArm",
	["RightElbow"] = "RightLowerArm",
	["LeftKnee"] = "LeftLowerLeg",
	["RightKnee"] = "RightLowerLeg",
	["LeftWrist"] = "LeftHand",
	["RightWrist"] = "RightHand",
	["LeftAnkle"] = "LeftFoot",
	["RightAnkle"] = "RightFoot",
	-- R6 / blocky
	["RootJoint"] = "Torso",
	["Left Shoulder"] = "Left Arm",
	["Right Shoulder"] = "Right Arm",
	["Left Hip"] = "Left Leg",
	["Right Hip"] = "Right Leg",
}

local function findAnimateScript(character: Model): LocalScript?
	local direct = character:FindFirstChild("Animate")
	if direct and direct:IsA("LocalScript") then
		return direct
	end
	for _, desc in character:GetDescendants() do
		if desc:IsA("LocalScript") and desc.Name == "Animate" then
			return desc
		end
	end
	return nil
end

local function reconnectDisconnectedMotor6Ds(character: Model)
	for _, desc in character:GetDescendants() do
		if desc:IsA("Motor6D") and not desc.Part1 then
			local motor = desc :: Motor6D
			local targetPartName = MOTOR6D_PART_MAP[motor.Name]
			if targetPartName then
				local targetPart = character:FindFirstChild(targetPartName)
				if targetPart and targetPart:IsA("BasePart") then
					motor.Part1 = targetPart
				end
			end
		end
	end
end

local function disconnectRagdollMotorsLocal(character: Model)
	local folder = character:FindFirstChild("RagdollConstraints")
	local any = false
	if folder then
		for _, constraint in folder:GetChildren() do
			if constraint:IsA("Constraint") then
				local rigidPointer = constraint:FindFirstChild("RigidJoint")
				local rigidJoint = rigidPointer and rigidPointer:IsA("ObjectValue") and rigidPointer.Value
				if rigidJoint and rigidJoint:IsA("Motor6D") and rigidJoint.Part1 ~= nil then
					rigidJoint.Part1 = nil
					any = true
				end
			end
		end
	end
	-- Blocky R15: if constraints missing/empty, still limp the body locally
	if not any then
		for _, desc in character:GetDescendants() do
			if desc:IsA("Motor6D") and desc.Name ~= "Root" and desc.Name ~= "RootJoint" and desc.Part1 ~= nil then
				desc.Part1 = nil
			end
		end
	end
end

local function stopNonAbilityAnimations(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		track:Stop()
	end
end

local function getRagdollCameraPart(character: Model): BasePart?
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	return nil
end

function RagdollController.init(player: Player)
	local ragdollConn: RBXScriptConnection? = nil
	local getUpConn: RBXScriptConnection? = nil
	local humanoidStateConn: RBXScriptConnection? = nil
	local ragdollCameraConn: RBXScriptConnection? = nil
	local ragdollMaintainConn: RBXScriptConnection? = nil
	local ragdollCameraSubject: Instance? = nil

	local function stopRagdollMaintain()
		if ragdollMaintainConn then
			ragdollMaintainConn:Disconnect()
			ragdollMaintainConn = nil
		end
	end

	local function startRagdollMaintain(character: Model, humanoid: Humanoid)
		stopRagdollMaintain()
		ragdollMaintainConn = RunService.Heartbeat:Connect(function()
			if not character.Parent or character:GetAttribute("Ragdolled") ~= true then
				stopRagdollMaintain()
				return
			end
			disconnectRagdollMotorsLocal(character)
			local st = humanoid:GetState()
			if st ~= Enum.HumanoidStateType.Physics and st ~= Enum.HumanoidStateType.Dead then
				pcall(function()
					humanoid:ChangeState(Enum.HumanoidStateType.Physics)
				end)
			end
			local animate = findAnimateScript(character)
			if animate and not animate.Disabled then
				animate.Disabled = true
			end
		end)
	end

	local function stopRagdollCameraFollow()
		if ragdollCameraConn then
			ragdollCameraConn:Disconnect()
			ragdollCameraConn = nil
		end
	end

	local function applyRagdollCameraFollow(character: Model, humanoid: Humanoid, enabled: boolean)
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		if enabled then
			local followPart = getRagdollCameraPart(character)
			if not followPart then
				return
			end
			if ragdollCameraSubject == nil then
				ragdollCameraSubject = cam.CameraSubject
			end
			cam.CameraType = Enum.CameraType.Custom
			cam.CameraSubject = followPart
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
			stopRagdollCameraFollow()
			ragdollCameraConn = RunService.RenderStepped:Connect(function()
				if character:GetAttribute("Ragdolled") ~= true or not character.Parent then
					return
				end
				local part = getRagdollCameraPart(character)
				if part and cam.CameraSubject ~= part then
					cam.CameraSubject = part
				end
			end)
		else
			stopRagdollCameraFollow()
			if ragdollCameraSubject ~= nil then
				cam.CameraSubject = ragdollCameraSubject
				ragdollCameraSubject = nil
			elseif humanoid.Health > 0 then
				cam.CameraSubject = humanoid
			end
		end
	end

	local function clearLocalRagdollState(character: Model, humanoid: Humanoid)
		stopRagdollMaintain()
		stopRagdollCameraFollow()
		applyRagdollCameraFollow(character, humanoid, false)

		local animate = findAnimateScript(character)
		if animate then
			animate.Disabled = character:GetAttribute(GameConstants.GETTING_UP_ATTRIBUTE) == true
		end

		local state = humanoid:GetState()
		if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.FallingDown then
			if humanoid.Health > 0 then
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
				task.defer(function()
					if not humanoid.Parent or not character.Parent then
						return
					end
					if character:GetAttribute("Ragdolled") == true then
						return
					end
					if character:GetAttribute(GameConstants.GETTING_UP_ATTRIBUTE) == true then
						return
					end
					humanoid:ChangeState(Enum.HumanoidStateType.Running)
				end)
			end
		elseif humanoid.Health > 0 and character:GetAttribute(GameConstants.GETTING_UP_ATTRIBUTE) ~= true then
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end

		reconnectDisconnectedMotor6Ds(character)
		if character:GetAttribute(GameConstants.GETTING_UP_ATTRIBUTE) ~= true then
			stopNonAbilityAnimations(humanoid)
		end

		local cam = Workspace.CurrentCamera
		if cam and humanoid.Health > 0 then
			cam.CameraType = Enum.CameraType.Custom
			cam.CameraSubject = humanoid
			ragdollCameraSubject = nil
		end
	end

	local function applyLocalRagdollVisual(enabled: boolean)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not character or not humanoid then
			return
		end

		local animate = findAnimateScript(character)
		if enabled then
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
			stopNonAbilityAnimations(humanoid)
			if animate then
				animate.Disabled = true
			end
			disconnectRagdollMotorsLocal(character)
			applyRagdollCameraFollow(character, humanoid, true)
			startRagdollMaintain(character, humanoid)
		else
			clearLocalRagdollState(character, humanoid)
			if character:GetAttribute(GameConstants.GETTING_UP_ATTRIBUTE) == true then
				local animate = findAnimateScript(character)
				if animate then
					animate.Disabled = true
				end
			end
		end
	end

	local function bindHumanoidStateGuard(character: Model, humanoid: Humanoid)
		if humanoidStateConn then
			humanoidStateConn:Disconnect()
			humanoidStateConn = nil
		end
		humanoidStateConn = humanoid.StateChanged:Connect(function(_, newState)
			if newState == Enum.HumanoidStateType.FallingDown then
				if character:GetAttribute("Ragdolled") == true or humanoid.Health <= 0 then
					return
				end
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
			if character:GetAttribute("Ragdolled") ~= true then
				return
			end
			local animate = findAnimateScript(character)
			if not animate then
				return
			end
			if newState ~= Enum.HumanoidStateType.Physics and newState ~= Enum.HumanoidStateType.GettingUp and animate.Disabled then
				humanoid:ChangeState(Enum.HumanoidStateType.Physics)
			end
		end)
	end

	local function onCharacterAdded(character: Model)
		ragdollCameraSubject = nil
		stopRagdollCameraFollow()
		stopRagdollMaintain()
		if ragdollConn then
			ragdollConn:Disconnect()
			ragdollConn = nil
		end
		if getUpConn then
			getUpConn:Disconnect()
			getUpConn = nil
		end

		ragdollConn = character:GetAttributeChangedSignal("Ragdolled"):Connect(function()
			applyLocalRagdollVisual(character:GetAttribute("Ragdolled") == true)
		end)
		getUpConn = character:GetAttributeChangedSignal(GameConstants.GETTING_UP_ATTRIBUTE):Connect(function()
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local animate = findAnimateScript(character)
			if character:GetAttribute(GameConstants.GETTING_UP_ATTRIBUTE) == true then
				if animate then
					animate.Disabled = true
				end
			else
				if animate then
					animate.Disabled = false
				end
				if humanoid and humanoid.Health > 0 and character:GetAttribute("Ragdolled") ~= true then
					humanoid:ChangeState(Enum.HumanoidStateType.Running)
				end
			end
		end)

		local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
		if not humanoid then
			return
		end
		bindHumanoidStateGuard(character, humanoid)
		applyLocalRagdollVisual(character:GetAttribute("Ragdolled") == true)
	end

	if player.Character then
		onCharacterAdded(player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)
end

return RagdollController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">RunAnimClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Ground locomotion overlay:
	- walk (LOCOMOTION_ANIM) while moving without sprint
	- run (RUN_ANIM) while holding Shift sprint
	Idle / jump / flight / ragdoll stay on Animate.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local RunAnimClient = {}

local LOCO_STATES: { [Enum.HumanoidStateType]: boolean } = {
	[Enum.HumanoidStateType.Running] = true,
	[Enum.HumanoidStateType.RunningNoPhysics] = true,
	[Enum.HumanoidStateType.Landed] = true,
}

local function loadTrack(animator: Animator, assetId: string): AnimationTrack?
	local anim = Instance.new("Animation")
	anim.AnimationId = assetId
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	anim:Destroy()
	if ok and track then
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = true
		return track
	end
	return nil
end

function RunAnimClient.init(player: Player)
	local bound: Model? = nil
	local walkTrack: AnimationTrack? = nil
	local runTrack: AnimationTrack? = nil
	local mode: "none" | "walk" | "run" = "none"

	local function stopTracks(fade: number?)
		local fadeTime = fade or 0.12
		if walkTrack and walkTrack.IsPlaying then
			walkTrack:Stop(fadeTime)
		end
		if runTrack and runTrack.IsPlaying then
			runTrack:Stop(fadeTime)
		end
		mode = "none"
	end

	local function clear()
		stopTracks(0.08)
		if walkTrack then
			walkTrack:Destroy()
			walkTrack = nil
		end
		if runTrack then
			runTrack:Destroy()
			runTrack = nil
		end
		bound = nil
	end

	local function ensure(character: Model): boolean
		if bound == character and walkTrack and runTrack then
			return true
		end
		clear()
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return false
		end
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end
		walkTrack = loadTrack(animator, GameConstants.LOCOMOTION_ANIM)
		runTrack = loadTrack(animator, GameConstants.RUN_ANIM)
		bound = character
		return walkTrack ~= nil and runTrack ~= nil
	end

	local function canLoco(character: Model, humanoid: Humanoid): boolean
		if humanoid.Health <= 0 then
			return false
		end
		if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
			return false
		end
		if character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
			return false
		end
		if character:GetAttribute(GameConstants.ICE_SLIDE_ATTRIBUTE) == true then
			return false
		end
		if character:GetAttribute(GameConstants.MG_ASTRAL_BODY_ATTRIBUTE) == true then
			return false
		end
		if character:GetAttribute(GameConstants.HIGH_FALL_LANDING_ATTRIBUTE) == true then
			return false
		end
		if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
			return false
		end
		if humanoid.WalkSpeed < 1 then
			return false
		end
		local state = humanoid:GetState()
		if not LOCO_STATES[state] then
			return false
		end
		if humanoid.MoveDirection.Magnitude < 0.08 then
			return false
		end
		return true
	end

	local function setMode(nextMode: "walk" | "run")
		if mode == nextMode then
			return
		end
		if nextMode == "walk" then
			if runTrack and runTrack.IsPlaying then
				runTrack:Stop(0.12)
			end
			if walkTrack and not walkTrack.IsPlaying then
				walkTrack:Play(0.12)
			end
		else
			if walkTrack and walkTrack.IsPlaying then
				walkTrack:Stop(0.12)
			end
			if runTrack and not runTrack.IsPlaying then
				runTrack:Play(0.12)
			end
		end
		mode = nextMode
	end

	RunService.RenderStepped:Connect(function()
		local character = player.Character
		if not character then
			if mode ~= "none" then
				clear()
			end
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		if not ensure(character) then
			return
		end
		if not canLoco(character, humanoid) then
			if mode ~= "none" then
				stopTracks(0.12)
			end
			return
		end
		local sprinting = character:GetAttribute(GameConstants.SPRINTING_ATTRIBUTE) == true
		setMode(if sprinting then "run" else "walk")
		local active = if sprinting then runTrack else walkTrack
		if active and active.IsPlaying then
			local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local spd = 0
			if root then
				local vel = root.AssemblyLinearVelocity
				spd = Vector3.new(vel.X, 0, vel.Z).Magnitude
			end
			local base = if sprinting then GameConstants.SPRINT_WALK_SPEED else GameConstants.DEFAULT_WALK_SPEED
			active:AdjustSpeed(math.clamp(spd / math.max(base, 1), 0.85, 1.35))
		end
	end)

	player.CharacterRemoving:Connect(function()
		clear()
	end)
end

return RunAnimClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">ScarletWitchClient</string>
            <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CameraShakeClient = require(script.Parent.CameraShakeClient)
local ScreenFxClient = require(script.Parent.ScreenFxClient)
local AbilityCooldownHelper = require(ReplicatedStorage.Shared.AbilityCooldownHelper)
local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local ScarletWitchClient = {}

local TELEPORT_CAM_BIND = "MCU_HexDisplacementCam"

function ScarletWitchClient.init(localPlayer: Player)
	local gui = Instance.new("ScreenGui")
	gui.Name = "SwControlLock"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 80
	gui.Parent = localPlayer:WaitForChild("PlayerGui")

	local dim = Instance.new("Frame")
	dim.Name = "Dim"
	dim.Size = UDim2.fromScale(1, 1)
	dim.BackgroundColor3 = Color3.fromRGB(18, 6, 10)
	dim.BackgroundTransparency = 1
	dim.BorderSizePixel = 0
	dim.Parent = gui

	local message = Instance.new("TextLabel")
	message.Name = "Message"
	message.AnchorPoint = Vector2.new(0.5, 0.5)
	message.Position = UDim2.fromScale(0.5, 0.46)
	message.Size = UDim2.fromScale(0.72, 0.22)
	message.BackgroundTransparency = 1
	message.Font = Enum.Font.GothamMedium
	message.Text =
		"You lost control of your powers due to their complexity and your lack of knowledge over them."
	message.TextColor3 = Color3.fromRGB(255, 210, 220)
	message.TextTransparency = 1
	message.TextWrapped = true
	message.TextScaled = true
	message.Parent = gui

	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 28
	constraint.MinTextSize = 14
	constraint.Parent = message

	-- Sit above SW mode panels / ability bar so it does not overlap HUD frames.
	local resultPanel = Instance.new("Frame")
	resultPanel.Name = "ProbabilityHexResult"
	resultPanel.AnchorPoint = Vector2.new(0, 1)
	resultPanel.Position = UDim2.new(0, 14, 1, -210)
	resultPanel.Size = UDim2.fromOffset(210, 28)
	resultPanel.BackgroundColor3 = Color3.fromRGB(38, 12, 18)
	resultPanel.BackgroundTransparency = 1
	resultPanel.BorderSizePixel = 0
	resultPanel.ZIndex = 40
	resultPanel.Visible = false
	resultPanel.Parent = gui

	local resultCorner = Instance.new("UICorner")
	resultCorner.CornerRadius = UDim.new(0, 6)
	resultCorner.Parent = resultPanel

	local resultStroke = Instance.new("UIStroke")
	resultStroke.Color = Color3.fromRGB(215, 55, 75)
	resultStroke.Transparency = 1
	resultStroke.Thickness = 1
	resultStroke.Parent = resultPanel

	local resultLabel = Instance.new("TextLabel")
	resultLabel.Name = "Text"
	resultLabel.Position = UDim2.fromOffset(8, 0)
	resultLabel.Size = UDim2.new(1, -16, 1, 0)
	resultLabel.BackgroundTransparency = 1
	resultLabel.Font = Enum.Font.GothamMedium
	resultLabel.TextColor3 = Color3.fromRGB(255, 220, 225)
	resultLabel.TextSize = 12
	resultLabel.TextTransparency = 1
	resultLabel.TextTruncate = Enum.TextTruncate.AtEnd
	resultLabel.TextXAlignment = Enum.TextXAlignment.Left
	resultLabel.ZIndex = 41
	resultLabel.Parent = resultPanel

	local resultToken = 0
	Remotes.getEvent("ProbabilityHexResult").OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" or type(payload.outcome) ~= "string" then
			return
		end
		local targetName = if type(payload.targetName) == "string" then payload.targetName else "Target"
		local duration = if type(payload.duration) == "number" then payload.duration else 10
		if payload.outcome == "object" then
			resultLabel.Text = string.format("%s → object", targetName)
		elseif payload.outcome == "powers_stripped" then
			resultLabel.Text = string.format("%s → no powers (%ds)", targetName, duration)
		else
			return
		end
		resultToken += 1
		local token = resultToken
		resultPanel.Visible = true
		TweenService:Create(resultPanel, TweenInfo.new(0.15), { BackgroundTransparency = 0.18 }):Play()
		TweenService:Create(resultStroke, TweenInfo.new(0.15), { Transparency = 0.25 }):Play()
		TweenService:Create(resultLabel, TweenInfo.new(0.15), { TextTransparency = 0 }):Play()
		task.delay(2.4, function()
			if resultToken ~= token then
				return
			end
			TweenService:Create(resultPanel, TweenInfo.new(0.28), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(resultStroke, TweenInfo.new(0.28), { Transparency = 1 }):Play()
			local fade = TweenService:Create(resultLabel, TweenInfo.new(0.28), { TextTransparency = 1 })
			fade:Play()
			fade.Completed:Once(function()
				if resultToken == token then
					resultPanel.Visible = false
				end
			end)
		end)
	end)

	local shown = false
	local function setLockVisual(on: boolean)
		if shown == on then
			return
		end
		shown = on
		local info = TweenInfo.new(if on then 0.45 else 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(dim, info, { BackgroundTransparency = if on then 0.42 else 1 }):Play()
		TweenService:Create(message, info, { TextTransparency = if on then 0 else 1 }):Play()
		CameraShakeClient.setHeldLayer("swControlLock", on, {
			fade = if on then 0.45 else 0.6,
			shake = if on then 0.12 else 0,
			fov = if on then 2.2 else 0,
			vignette = if on then 0.35 else 1,
			shakeRange = 1.05,
			shakeSlow = 0.48,
		})
	end

	local function hook(character: Model)
		local lingerUntil = 0
		local function anyAbilityActive(model: Model): boolean
			for name, value in model:GetAttributes() do
				if type(name) == "string" and string.sub(name, 1, 14) == "AbilityActive_" and value == true then
					return true
				end
			end
			return false
		end
		local function refreshScreen()
			local hero = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
			local activeNow = hero == "scarlet_witch"
				and (
					anyAbilityActive(character)
					or character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true
					or character:GetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE) == true
					or character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true
					or character:GetAttribute(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE) == true
					or character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true
					or AbilityCooldownHelper.isAnyActive(character, {
						"telekinesis",
						"hex_beam",
						"hex_bolt",
						"hex_blast",
						"hex_shield",
						"hex_flight",
						"probability_hex",
						"hex_displacement",
						"rune_entrapment",
						"regeneration",
					})
				)
			if activeNow then
				lingerUntil = os.clock() + 1.35
			end
			local showFx = activeNow or os.clock() < lingerUntil
			ScreenFxClient.setEnabled("scarlet_witch", showFx)
			CameraShakeClient.setHeldLayer("swPowers", showFx, {
				fade = if showFx then 0.34 else 0.75,
				shake = if showFx then 0.08 else 0,
				fov = if showFx then -1.55 else 0,
				vignette = if showFx then 0.5 else 1,
				shakeRange = 0.88,
				shakeSlow = 0.42,
			})
			if lingerUntil > os.clock() and not activeNow then
				task.delay(1.4, refreshScreen)
			end
		end
		local function sync()
			local on = character:GetAttribute(GameConstants.HERO_ATTRIBUTE) == "scarlet_witch"
				and character:GetAttribute(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE) == true
			setLockVisual(on)
			refreshScreen()
		end
		character:GetAttributeChangedSignal(GameConstants.SW_CONTROL_LOCK_ATTRIBUTE):Connect(sync)
		character:GetAttributeChangedSignal(GameConstants.HERO_ATTRIBUTE):Connect(sync)
		character:GetAttributeChangedSignal(GameConstants.TK_ACTIVE_ATTRIBUTE):Connect(refreshScreen)
		character:GetAttributeChangedSignal(GameConstants.SHIELD_ACTIVE_ATTRIBUTE):Connect(refreshScreen)
		character:GetAttributeChangedSignal(GameConstants.IS_FLYING_ATTRIBUTE):Connect(refreshScreen)
		character:GetAttributeChangedSignal(GameConstants.BUSY_ATTRIBUTE):Connect(refreshScreen)
		character.AttributeChanged:Connect(function(attr)
			if string.sub(attr, 1, 14) == "AbilityActive_" then
				refreshScreen()
			end
		end)
		sync()
		refreshScreen()
	end

	localPlayer.CharacterAdded:Connect(function(character)
		setLockVisual(false)
		ScreenFxClient.setEnabled("scarlet_witch", false)
		CameraShakeClient.setHeldLayer("swPowers", false, { fade = 0.2 })
		hook(character)
	end)
	localPlayer.CharacterRemoving:Connect(function()
		setLockVisual(false)
		ScreenFxClient.setEnabled("scarlet_witch", false)
		CameraShakeClient.setHeldLayer("swPowers", false, { fade = 0.2 })
	end)
	if localPlayer.Character then
		hook(localPlayer.Character)
	end

	local savedSubject: Instance? = nil
	local savedType: Enum.CameraType? = nil
	local followPart: BasePart? = nil
	local following = false
	local followToken = 0

	local function stopFollowBind()
		pcall(function()
			RunService:UnbindFromRenderStep(TELEPORT_CAM_BIND)
		end)
	end

	local function restoreCam()
		followToken += 1
		local character = localPlayer.Character
		if character then
			character:SetAttribute("SwTeleportCam", nil)
		end
		stopFollowBind()
		if not following then
			followPart = nil
			return
		end
		following = false
		followPart = nil
		local cam = workspace.CurrentCamera
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if cam then
			cam.CameraType = savedType or Enum.CameraType.Custom
			cam.CameraSubject = hum or savedSubject
		end
		savedSubject = nil
		savedType = nil
	end

	local function beginFollow(part: BasePart)
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local character = localPlayer.Character
		if character then
			character:SetAttribute("SwTeleportCam", true)
		end
		if not following then
			savedSubject = cam.CameraSubject
			savedType = cam.CameraType
			following = true
		end
		followPart = part
		-- Keep normal camera behavior; only swap the subject to the travel part.
		cam.CameraType = Enum.CameraType.Custom
		cam.CameraSubject = part
		stopFollowBind()
		RunService:BindToRenderStep(TELEPORT_CAM_BIND, Enum.RenderPriority.Camera.Value + 8, function()
			local ride = followPart
			local liveCam = workspace.CurrentCamera
			if not following or not ride or not ride.Parent or not liveCam then
				restoreCam()
				return
			end
			liveCam.CameraType = Enum.CameraType.Custom
			if liveCam.CameraSubject ~= ride then
				liveCam.CameraSubject = ride
			end
		end)
	end

	Remotes.getEvent("HexDisplacementCam").OnClientEvent:Connect(function(subject: any, _dest: any)
		if subject == nil then
			restoreCam()
			return
		end
		if typeof(subject) ~= "Instance" or not subject:IsA("BasePart") then
			return
		end
		local part = subject :: BasePart
		followToken += 1
		local token = followToken
		task.spawn(function()
			local deadline = os.clock() + 2
			while part.Parent == nil and os.clock() < deadline and token == followToken do
				task.wait()
			end
			if token ~= followToken or not part.Parent then
				return
			end
			beginFollow(part)
		end)
	end)
	localPlayer.CharacterRemoving:Connect(restoreCam)
end

return ScarletWitchClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">ScreenFxClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Clone UIEffects folders (JeanUI, PhoenixForceUI, InvisWomanUI, ScarletWitchUI)
	and keep the root BasePart on the camera. Emitters stay parented as authored.
]]

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientSettings = require(script.Parent.ClientSettings)

local ScreenFxClient = {}

local FOLDER_BY_KIND: { [string]: string } = {
	jean = "JeanUI",
	phoenix = "PhoenixForceUI",
	invisible_woman = "InvisWomanUI",
	scarlet_witch = "ScarletWitchUI",
}

local CAM_OFFSET = CFrame.new(0, 0, -3.2)
local CAM_OFFSET_BY_KIND: { [string]: CFrame } = {
	scarlet_witch = CFrame.new(0, 0, -2.8),
}

type Layer = {
	root: Instance,
	host: BasePart,
	wanted: boolean,
	emitters: { ParticleEmitter },
}

local layers: { [string]: Layer } = {}
local bound = false

local function collectEmitters(root: Instance): { ParticleEmitter }
	local list: { ParticleEmitter } = {}
	if root:IsA("ParticleEmitter") then
		table.insert(list, root)
	end
	for _, desc in root:GetDescendants() do
		if desc:IsA("ParticleEmitter") then
			table.insert(list, desc)
		end
	end
	return list
end

local function getTemplate(folderName: string): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets") or ReplicatedStorage:WaitForChild("Assets", 12)
	if not assets then
		return nil
	end
	local ui = assets:FindFirstChild("UIEffects") or assets:WaitForChild("UIEffects", 8)
	if ui then
		return ui:FindFirstChild(folderName)
	end
	return nil
end

local function hardenPart(part: BasePart)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	if part.Transparency < 1 then
		part.Transparency = 1
	end
end

local function resolvePart(clone: Instance): BasePart?
	if clone:IsA("BasePart") then
		return clone
	end
	if clone:IsA("Model") then
		local primary = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
		return primary
	end
	return clone:FindFirstChildWhichIsA("BasePart", true)
end

local function parentToCamera(inst: Instance)
	local cam = Workspace.CurrentCamera
	inst.Parent = cam or Workspace
end

local function ensureLayer(kind: string): Layer?
	local existing = layers[kind]
	if existing and existing.host.Parent then
		return existing
	end
	local folderName = FOLDER_BY_KIND[kind]
	if not folderName then
		return nil
	end
	local template = getTemplate(folderName)
	if not template then
		warn("[ScreenFx] Missing ReplicatedStorage.Assets.UIEffects." .. folderName)
		return nil
	end

	local clone = template:Clone()
	clone.Name = "MCU_ScreenFx_" .. kind
	local host = resolvePart(clone)
	if not host then
		warn("[ScreenFx] " .. folderName .. " has no BasePart")
		clone:Destroy()
		return nil
	end

	for _, desc in clone:GetDescendants() do
		if desc:IsA("BasePart") then
			hardenPart(desc)
		end
	end
	hardenPart(host)
	parentToCamera(clone)

	for _, em in collectEmitters(clone) do
		em.Enabled = false
	end

	local layer: Layer = {
		root = clone,
		host = host,
		wanted = false,
		emitters = collectEmitters(clone),
	}
	layers[kind] = layer
	return layer
end

local function setEmittersEnabled(layer: Layer, enabled: boolean)
	local mul = ClientSettings.getParticleMul()
	for _, em in layer.emitters do
		if em.Parent then
			em.Enabled = enabled and ClientSettings.isScreenVfxEnabled()
			if em.Enabled and mul < 1 then
				em.Rate = math.max(1, em.Rate * mul)
			end
		end
	end
end

local function ensureLoop()
	if bound then
		return
	end
	bound = true
	RunService:BindToRenderStep("MCU_ScreenFx", Enum.RenderPriority.Camera.Value + 3, function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		for kind, layer in layers do
			local cf = cam.CFrame * (CAM_OFFSET_BY_KIND[kind] or CAM_OFFSET)
			if layer.root.Parent ~= cam then
				layer.root.Parent = cam
			end
			if layer.root:IsA("Model") then
				(layer.root :: Model):PivotTo(cf)
			else
				layer.host.CFrame = cf
			end
		end
	end)
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		for _, layer in layers do
			layer.root.Parent = cam
		end
	end)
end

function ScreenFxClient.setTint(kind: string, color: Color3)
	local layer = ensureLayer(kind)
	if not layer then
		return
	end
	local seq = ColorSequence.new(color)
	for _, em in layer.emitters do
		if em.Parent then
			em.Color = seq
		end
	end
end

function ScreenFxClient.setEnabled(kind: string, enabled: boolean)
	if enabled and not ClientSettings.isScreenVfxEnabled() then
		return
	end
	ensureLoop()
	local layer = ensureLayer(kind)
	if not layer then
		return
	end
	if layer.wanted == enabled then
		return
	end
	layer.wanted = enabled
	setEmittersEnabled(layer, enabled)
end

function ScreenFxClient.pulse(kind: string)
	ScreenFxClient.setEnabled(kind, true)
end

function ScreenFxClient.clear()
	for kind, layer in layers do
		layer.wanted = false
		setEmittersEnabled(layer, false)
		if layer.root.Parent then
			layer.root:Destroy()
		end
		layers[kind] = nil
	end
end

ClientSettings.onChanged(function()
	if not ClientSettings.isScreenVfxEnabled() then
		ScreenFxClient.clear()
	end
end)

return ScreenFxClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">SettingsUI</string>
            <string name="Source"><![CDATA[--!strict
--[[ Settings as a full menu page or embedded panel. ]]

local ClientSettings = require(script.Parent.ClientSettings)
local CameraShakeClient = require(script.Parent.CameraShakeClient)
local ShoulderCamClient = require(script.Parent.ShoulderCamClient)

export type SettingsPage = {
	page: Frame,
	refresh: () -> (),
}

export type SettingsController = {
	root: Frame,
	refresh: () -> (),
	show: () -> (),
	hide: () -> (),
	toggle: () -> (),
}

local SettingsUI = {}

local THEME_ON = Color3.fromRGB(55, 120, 70)
local THEME_OFF = Color3.fromRGB(38, 38, 44)
local PANEL = Color3.fromRGB(14, 44, 52)
local STROKE = Color3.fromRGB(48, 110, 118)

local function addCorner(parent: GuiObject, scale: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scale, 0)
	c.Parent = parent
end

local function makeOptionButton(parent: Frame, text: string, layoutOrder: number): TextButton
	local btn = Instance.new("TextButton")
	btn.Name = text
	btn.LayoutOrder = layoutOrder
	btn.Size = UDim2.new(0.48, 0, 0.85, 0)
	btn.BackgroundColor3 = THEME_OFF
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = true
	btn.Font = Enum.Font.GothamBold
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(240, 240, 245)
	btn.TextScaled = true
	btn.Parent = parent
	addCorner(btn, 0.2)
	return btn
end

local function makeSettingRow(parent: Frame, labelText: string, layoutOrder: number, rowHeight: number): (Frame, Frame)
	local row = Instance.new("Frame")
	row.Name = labelText
	row.LayoutOrder = layoutOrder
	row.Size = UDim2.new(1, 0, 0, rowHeight)
	row.BackgroundTransparency = 1
	row.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.42, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(210, 228, 232)
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = row

	local btnHold = Instance.new("Frame")
	btnHold.Name = "Buttons"
	btnHold.Size = UDim2.new(0.56, 0, 1, 0)
	btnHold.Position = UDim2.fromScale(0.44, 0)
	btnHold.BackgroundTransparency = 1
	btnHold.Parent = row

	local btnLayout = Instance.new("UIListLayout")
	btnLayout.FillDirection = Enum.FillDirection.Horizontal
	btnLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	btnLayout.Padding = UDim.new(0.04, 0)
	btnLayout.Parent = btnHold

	return row, btnHold
end

local function buildSettingsPanel(root: Frame, opts: { compact: boolean?, showShoulderCam: boolean? }?)
	local compact = opts and opts.compact == true
	local showShoulder = not (opts and opts.showShoulderCam == false)
	local rowHeight = if compact then 26 else 40
	local rowGap = if compact then 4 else 8
	local edgePad = if compact then 8 else 14

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, rowGap)
	layout.Parent = root

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, edgePad)
	pad.PaddingBottom = UDim.new(0, edgePad)
	pad.PaddingLeft = UDim.new(0, edgePad + 2)
	pad.PaddingRight = UDim.new(0, edgePad + 2)
	pad.Parent = root

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.LayoutOrder = 0
	title.Size = UDim2.new(1, 0, 0, if compact then 20 else 32)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.Text = "SETTINGS"
	title.TextColor3 = Color3.fromRGB(236, 248, 250)
	title.TextScaled = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = root

	local order = 1
	local sideRightBtn: TextButton? = nil
	local sideLeftBtn: TextButton? = nil
	local keyCtrlBtn: TextButton? = nil
	local statusLabel: TextLabel? = nil

	if showShoulder then
		local _, sideBtns = makeSettingRow(root, "Shoulder Side", order, rowHeight)
		order += 1
		sideRightBtn = makeOptionButton(sideBtns, "Right", 1)
		sideLeftBtn = makeOptionButton(sideBtns, "Left", 2)

		local _, keyBtns = makeSettingRow(root, "Shoulder Key", order, rowHeight)
		order += 1
		keyCtrlBtn = makeOptionButton(keyBtns, "Ctrl", 1)
		keyCtrlBtn.Size = UDim2.new(1, 0, 0.85, 0)

		statusLabel = Instance.new("TextLabel")
		statusLabel.LayoutOrder = order
		order += 1
		statusLabel.Size = UDim2.new(1, 0, 0, if compact then 20 else 24)
		statusLabel.BackgroundTransparency = 1
		statusLabel.Font = Enum.Font.Gotham
		statusLabel.Text = "Shoulder Cam: Off"
		statusLabel.TextColor3 = Color3.fromRGB(170, 190, 195)
		statusLabel.TextScaled = true
		statusLabel.TextXAlignment = Enum.TextXAlignment.Left
		statusLabel.Parent = root
	end

	local _, shakeBtns = makeSettingRow(root, "Screen Shake", order, rowHeight)
	order += 1
	local shakeOnBtn = makeOptionButton(shakeBtns, "On", 1)
	local shakeOffBtn = makeOptionButton(shakeBtns, "Off", 2)

	local _, vfxBtns = makeSettingRow(root, "Screen VFX", order, rowHeight)
	order += 1
	local vfxOnBtn = makeOptionButton(vfxBtns, "On", 1)
	local vfxOffBtn = makeOptionButton(vfxBtns, "Off", 2)

	local _, zoomBtns = makeSettingRow(root, "Ability Zoom", order, rowHeight)
	order += 1
	local zoomOnBtn = makeOptionButton(zoomBtns, "On", 1)
	local zoomOffBtn = makeOptionButton(zoomBtns, "Off", 2)

	local _, qualityBtns = makeSettingRow(root, "Graphics", order, rowHeight)
	order += 1
	local qualityHighBtn = makeOptionButton(qualityBtns, "High", 1)
	local qualityLowBtn = makeOptionButton(qualityBtns, "Low", 2)

	local function paint(onBtn: TextButton, offBtn: TextButton, on: boolean)
		onBtn.BackgroundColor3 = if on then THEME_ON else THEME_OFF
		offBtn.BackgroundColor3 = if on then THEME_OFF else THEME_ON
	end

	local function refresh()
		paint(shakeOnBtn, shakeOffBtn, ClientSettings.isScreenShakeEnabled())
		paint(vfxOnBtn, vfxOffBtn, ClientSettings.isScreenVfxEnabled())
		paint(zoomOnBtn, zoomOffBtn, ClientSettings.isAbilityZoomEnabled())
		paint(qualityHighBtn, qualityLowBtn, ClientSettings.getGraphicsQuality() == "High")
		if sideRightBtn and sideLeftBtn then
			local s = ShoulderCamClient.getSide()
			sideRightBtn.BackgroundColor3 = if s == "Right" then THEME_ON else THEME_OFF
			sideLeftBtn.BackgroundColor3 = if s == "Left" then THEME_ON else THEME_OFF
		end
		if keyCtrlBtn then
			ShoulderCamClient.setKeybind("Ctrl")
			keyCtrlBtn.BackgroundColor3 = THEME_ON
		end
		if statusLabel then
			statusLabel.Text = if ShoulderCamClient.isEnabled() then "Shoulder Cam: On" else "Shoulder Cam: Off"
		end
	end

	shakeOnBtn.MouseButton1Click:Connect(function()
		CameraShakeClient.setScreenShakeEnabled(true)
		refresh()
	end)
	shakeOffBtn.MouseButton1Click:Connect(function()
		CameraShakeClient.setScreenShakeEnabled(false)
		refresh()
	end)
	vfxOnBtn.MouseButton1Click:Connect(function()
		CameraShakeClient.setScreenVfxEnabled(true)
		refresh()
	end)
	vfxOffBtn.MouseButton1Click:Connect(function()
		CameraShakeClient.setScreenVfxEnabled(false)
		refresh()
	end)
	zoomOnBtn.MouseButton1Click:Connect(function()
		CameraShakeClient.setAbilityZoomEnabled(true)
		refresh()
	end)
	zoomOffBtn.MouseButton1Click:Connect(function()
		CameraShakeClient.setAbilityZoomEnabled(false)
		refresh()
	end)
	qualityHighBtn.MouseButton1Click:Connect(function()
		ClientSettings.setGraphicsQuality("High")
		refresh()
	end)
	qualityLowBtn.MouseButton1Click:Connect(function()
		ClientSettings.setGraphicsQuality("Low")
		refresh()
	end)
	if sideRightBtn and sideLeftBtn then
		sideRightBtn.MouseButton1Click:Connect(function()
			ShoulderCamClient.setSide("Right")
			refresh()
		end)
		sideLeftBtn.MouseButton1Click:Connect(function()
			ShoulderCamClient.setSide("Left")
			refresh()
		end)
	end

	ClientSettings.onChanged(refresh)
	refresh()

	return refresh
end

function SettingsUI.buildPanel(parent: Frame, opts: { compact: boolean?, showShoulderCam: boolean? }?): () -> ()
	return buildSettingsPanel(parent, opts)
end

function SettingsUI.createPage(parent: Instance, opts: { showShoulderCam: boolean? }?): SettingsPage
	local page = Instance.new("Frame")
	page.Name = "SettingsPage"
	page.Size = UDim2.fromScale(1, 1)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.ZIndex = 2
	page.Parent = parent

	local panel = Instance.new("Frame")
	panel.Name = "SettingsPanel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromScale(0.3, 0.44)
	panel.BackgroundColor3 = PANEL
	panel.BorderSizePixel = 0
	panel.ZIndex = 2
	panel.Parent = page
	addCorner(panel, 0.02)

	local stroke = Instance.new("UIStroke")
	stroke.Color = STROKE
	stroke.Thickness = 1
	stroke.Transparency = 0.3
	stroke.Parent = panel

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Scroll"
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = panel

	local refresh = buildSettingsPanel(scroll, { compact = true, showShoulderCam = if opts then opts.showShoulderCam else true })

	return {
		page = page,
		refresh = refresh,
	}
end

function SettingsUI.bindPage(page: Frame, opts: { showShoulderCam: boolean? }?): SettingsPage
	local panel = page:WaitForChild("SettingsPanel") :: Frame
	local scroll = panel:WaitForChild("Scroll") :: ScrollingFrame
	local refresh = buildSettingsPanel(scroll, { compact = true, showShoulderCam = if opts then opts.showShoulderCam else true })
	return {
		page = page,
		refresh = refresh,
	}
end

function SettingsUI.create(parent: Instance, opts: { compact: boolean?, showShoulderCam: boolean? }?): SettingsController
	local root = Instance.new("Frame")
	root.Name = "SettingsPanel"
	root.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
	root.BackgroundTransparency = 0.08
	root.BorderSizePixel = 0
	root.Visible = false
	root.Parent = parent
	addCorner(root, 0.06)

	local refresh = buildSettingsPanel(root, opts)

	return {
		root = root,
		refresh = refresh,
		show = function()
			root.Visible = true
			refresh()
		end,
		hide = function()
			root.Visible = false
		end,
		toggle = function()
			root.Visible = not root.Visible
			if root.Visible then
				refresh()
			end
		end,
	}
end

return SettingsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">ShopUI</string>
            <string name="Source"><![CDATA[--!strict

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local PlayerDataClient = require(script.Parent.PlayerDataClient)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ShopCatalog = require(ReplicatedStorage.Shared.ShopCatalog)
local ViewportHelper = require(script.Parent.ViewportHelper)

export type ShopPage = {
	page: Frame,
	refresh: () -> (),
}

local ShopUI = {}

local BG = Color3.fromRGB(8, 28, 34)
local PANEL = Color3.fromRGB(14, 44, 52)
local CARD = Color3.fromRGB(18, 58, 66)
local CARD_HOVER = Color3.fromRGB(24, 72, 82)
local STROKE = Color3.fromRGB(48, 110, 118)
local GOLD = Color3.fromRGB(228, 198, 120)
local OWNED = Color3.fromRGB(52, 128, 88)

local HOVER = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function addCorner(parent: GuiObject, scale: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scale, 0)
	c.Parent = parent
end

local function addStroke(parent: GuiObject, color: Color3, thickness: number, transparency: number)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency
	s.Parent = parent
	return s
end

local function wireShopPage(page: Frame, scroll: ScrollingFrame, coinLabel: TextLabel): () -> ()
	local player = Players.LocalPlayer
	local cards: { GuiObject } = {}

	local function refreshCoins()
		coinLabel.Text = string.format("%s Tokens", tostring(PlayerDataClient.getCoins()))
	end

	local function tryRobuxPurchase(item: any)
		if item.gamepassId and item.gamepassId > 0 then
			MarketplaceService:PromptGamePassPurchase(player, item.gamepassId)
			return
		end
		if item.productId and item.productId > 0 then
			MarketplaceService:PromptProductPurchase(player, item.productId)
		end
	end

	local function purchaseItem(item: any)
		if PlayerDataClient.ownsShopItem(item.id) then
			return
		end
		if item.currency == "coins" then
			Remotes.getEvent("PurchaseShopItem"):FireServer(item.id)
		else
			tryRobuxPurchase(item)
		end
	end

	local function ensureShopSections(): (Frame, Frame)
		local grid = scroll:FindFirstChildWhichIsA("UIGridLayout")
		if grid then
			grid:Destroy()
		end
		local list = scroll:FindFirstChild("SectionList")
		if not list or not list:IsA("UIListLayout") then
			if list then
				list:Destroy()
			end
			local layout = Instance.new("UIListLayout")
			layout.Name = "SectionList"
			layout.FillDirection = Enum.FillDirection.Vertical
			layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			layout.Padding = UDim.new(0, 8)
			layout.Parent = scroll
		end

		local function makeGridHost(name: string, order: number): Frame
			local existing = scroll:FindFirstChild(name)
			if existing and existing:IsA("Frame") then
				return existing
			end
			local host = Instance.new("Frame")
			host.Name = name
			host.LayoutOrder = order
			host.BackgroundTransparency = 1
			host.Size = UDim2.new(1, 0, 0, 0)
			host.AutomaticSize = Enum.AutomaticSize.Y
			host.ZIndex = 3
			host.Parent = scroll
			local gridLayout = Instance.new("UIGridLayout")
			gridLayout.CellSize = UDim2.fromOffset(158, 196)
			gridLayout.CellPadding = UDim2.fromOffset(10, 10)
			gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
			gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
			gridLayout.Parent = host
			return host
		end

		local function makeSectionHeader(name: string, text: string, order: number): Frame
			local existing = scroll:FindFirstChild(name)
			if existing and existing:IsA("Frame") then
				return existing
			end
			if existing then
				existing:Destroy()
			end
			local row = Instance.new("Frame")
			row.Name = name
			row.LayoutOrder = order
			row.Size = UDim2.new(1, -16, 0, 32)
			row.BackgroundTransparency = 1
			row.ZIndex = 4
			row.Parent = scroll

			local line = Instance.new("Frame")
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.Position = UDim2.fromScale(0.5, 0.5)
			line.Size = UDim2.new(0.92, 0, 0, 2)
			line.BackgroundColor3 = GOLD
			line.BackgroundTransparency = 0.35
			line.BorderSizePixel = 0
			line.ZIndex = 4
			line.Parent = row

			local label = Instance.new("TextLabel")
			label.AnchorPoint = Vector2.new(0.5, 0.5)
			label.Position = UDim2.fromScale(0.5, 0.5)
			label.Size = UDim2.fromOffset(110, 22)
			label.BackgroundColor3 = PANEL
			label.BorderSizePixel = 0
			label.Font = Enum.Font.GothamBold
			label.Text = text
			label.TextColor3 = GOLD
			label.TextScaled = true
			label.ZIndex = 5
			label.Parent = row
			addCorner(label, 0.2)
			return row
		end

		makeSectionHeader("TokensDivider", "TOKENS", 0)
		local coinHost = makeGridHost("CoinItems", 1)
		makeSectionHeader("CurrencyDivider", "ROBUX", 2)
		local robuxHost = makeGridHost("RobuxItems", 3)
		return coinHost, robuxHost
	end

	local function buildCards()
		for _, card in cards do
			card:Destroy()
		end
		table.clear(cards)

		local coinHost, robuxHost = ensureShopSections()
		for _, child in coinHost:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		for _, child in robuxHost:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end

		local coinOrder = 0
		local robuxOrder = 0
		for _, item in ShopCatalog.getItems() do
			local owned = PlayerDataClient.ownsShopItem(item.id)
			local isRobux = item.currency == "robux"
			if isRobux then
				robuxOrder += 1
			else
				coinOrder += 1
			end

			local card = Instance.new("TextButton")
			card.Name = item.id
			card.LayoutOrder = if isRobux then robuxOrder else coinOrder
			card.BackgroundColor3 = CARD
			card.AutoButtonColor = false
			card.Text = ""
			card.ZIndex = 4
			card.Parent = if isRobux then robuxHost else coinHost
			addCorner(card, 0.04)
			local cardStroke = addStroke(card, STROKE, 1, 0.35)
			table.insert(cards, card)

			local nameLabel = Instance.new("TextLabel")
			nameLabel.Size = UDim2.new(1, -12, 0, 22)
			nameLabel.Position = UDim2.fromOffset(6, 6)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Font = Enum.Font.GothamBold
			nameLabel.Text = string.upper(item.name)
			nameLabel.TextColor3 = Color3.fromRGB(236, 246, 248)
			nameLabel.TextScaled = true
			nameLabel.TextXAlignment = Enum.TextXAlignment.Left
			nameLabel.ZIndex = 5
			nameLabel.Parent = card

			local vpWrap = Instance.new("Frame")
			vpWrap.Name = "Preview"
			vpWrap.AnchorPoint = Vector2.new(0.5, 0.5)
			vpWrap.Position = UDim2.fromScale(0.5, 0.48)
			vpWrap.Size = UDim2.fromOffset(92, 92)
			vpWrap.BackgroundColor3 = Color3.fromRGB(10, 30, 36)
			vpWrap.BorderSizePixel = 0
			vpWrap.ZIndex = 5
			vpWrap.Parent = card
			addCorner(vpWrap, 1)
			addStroke(vpWrap, STROKE, 1, 0.4)

			local vp = Instance.new("ViewportFrame")
			vp.Size = UDim2.fromScale(0.9, 0.9)
			vp.Position = UDim2.fromScale(0.05, 0.05)
			vp.BackgroundTransparency = 1
			vp.BorderSizePixel = 0
			vp.ZIndex = 6
			vp.Parent = vpWrap
			addCorner(vp, 1)

			local heroId, skinId = ShopCatalog.getPreviewMorph(item.id)
			if heroId then
				local template = CharacterRegistry.getMorphTemplate(heroId, skinId or "base")
				if template then
					ViewportHelper.bindTemplate(vp, template, 0, "select")
				end
			end

			local priceLabel = Instance.new("TextLabel")
			priceLabel.AnchorPoint = Vector2.new(0.5, 1)
			priceLabel.Position = UDim2.new(0.5, 0, 1, -6)
			priceLabel.Size = UDim2.new(1, -12, 0, 20)
			priceLabel.BackgroundTransparency = 1
			priceLabel.Font = Enum.Font.GothamBold
			priceLabel.Text = if owned
				then "OWNED"
				else (if item.currency == "coins"
					then string.format("%d Tokens", item.price)
					else string.format("R$ %d", item.price))
			priceLabel.TextColor3 = if owned then OWNED else (if item.currency == "coins" then GOLD else Color3.fromRGB(130, 190, 255))
			priceLabel.TextScaled = true
			priceLabel.ZIndex = 5
			priceLabel.Parent = card

			if owned then
				card.BackgroundColor3 = Color3.fromRGB(16, 48, 42)
				cardStroke.Color = OWNED
				card.Active = false
			else
				card.MouseEnter:Connect(function()
					TweenService:Create(card, HOVER, { BackgroundColor3 = CARD_HOVER }):Play()
				end)
				card.MouseLeave:Connect(function()
					TweenService:Create(card, HOVER, { BackgroundColor3 = CARD }):Play()
				end)
				card.MouseButton1Click:Connect(function()
					purchaseItem(item)
				end)
			end
		end
		refreshCoins()
	end

	Remotes.getEvent("ShopPurchaseResult").OnClientEvent:Connect(function(result: any)
		if type(result) == "table" and result.success == true then
			buildCards()
		end
	end)

	PlayerDataClient.onChanged(function()
		if page.Visible then
			buildCards()
		end
	end)

	local passIds = {
		ShopCatalog.ELITE_GAMEPASS_ID,
		ShopCatalog.PHOENIX_GAMEPASS_ID,
		ShopCatalog.ROGUE_GAMEPASS_ID,
	}
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(_player, gamepassId, wasPurchased)
		if not wasPurchased then
			return
		end
		for _, id in passIds do
			if id > 0 and gamepassId == id then
				Remotes.getEvent("RefreshPlayerData"):FireServer()
				break
			end
		end
	end)

	return buildCards
end

function ShopUI.bindPage(page: Frame): ShopPage
	local panel = page:WaitForChild("ShopPanel") :: Frame
	local header = panel:WaitForChild("Header") :: Frame
	local coinLabel = header:FindFirstChild("Tokens") or header:FindFirstChild("Coins")
	if not coinLabel or not coinLabel:IsA("TextLabel") then
		error("[ShopUI] Shop header missing Tokens label")
	end
	coinLabel.Name = "Tokens"
	local scroll = panel:WaitForChild("Items") :: ScrollingFrame
	return {
		page = page,
		refresh = wireShopPage(page, scroll, coinLabel),
	}
end

function ShopUI.createPage(parent: Instance): ShopPage
	local _player = Players.LocalPlayer

	local page = Instance.new("Frame")
	page.Name = "ShopPage"
	page.Size = UDim2.fromScale(1, 1)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.ZIndex = 2
	page.Parent = parent

	local panel = Instance.new("Frame")
	panel.Name = "ShopPanel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromScale(0.82, 0.72)
	panel.BackgroundColor3 = PANEL
	panel.BorderSizePixel = 0
	panel.ZIndex = 2
	panel.Parent = page
	addCorner(panel, 0.02)
	addStroke(panel, STROKE, 1, 0.3)

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 44)
	header.BackgroundTransparency = 1
	header.ZIndex = 3
	header.Parent = panel

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(0.34, 0, 1, 0)
	title.Position = UDim2.fromOffset(18, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.Text = "SHOP"
	title.TextColor3 = Color3.fromRGB(236, 248, 250)
	title.TextScaled = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.ZIndex = 3
	title.Parent = header

	local coinLabel = Instance.new("TextLabel")
	coinLabel.Name = "Tokens"
	coinLabel.AnchorPoint = Vector2.new(1, 0.5)
	coinLabel.Position = UDim2.new(1, -18, 0.5, 0)
	coinLabel.Size = UDim2.fromOffset(200, 32)
	coinLabel.BackgroundTransparency = 1
	coinLabel.Font = Enum.Font.GothamBold
	coinLabel.Text = "0 Tokens"
	coinLabel.TextColor3 = GOLD
	coinLabel.TextScaled = true
	coinLabel.TextXAlignment = Enum.TextXAlignment.Right
	coinLabel.ZIndex = 3
	coinLabel.Parent = header

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Items"
	scroll.Position = UDim2.fromOffset(12, 52)
	scroll.Size = UDim2.new(1, -24, 1, -64)
	scroll.BackgroundColor3 = BG
	scroll.BackgroundTransparency = 0.15
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 5
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ZIndex = 3
	scroll.Parent = panel
	addCorner(scroll, 0.015)

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(158, 196)
	grid.CellPadding = UDim2.fromOffset(10, 10)
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = scroll

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 12)
	pad.PaddingBottom = UDim.new(0, 12)
	pad.PaddingLeft = UDim.new(0, 12)
	pad.PaddingRight = UDim.new(0, 12)
	pad.Parent = scroll

	return {
		page = page,
		refresh = wireShopPage(page, scroll, coinLabel),
	}
end

-- Legacy overlay API (unused by menu navigation)
function ShopUI.create(parent: Instance)
	local shopPage = ShopUI.createPage(parent)
	return {
		show = function()
			shopPage.refresh()
			shopPage.page.Visible = true
		end,
		hide = function()
			shopPage.page.Visible = false
		end,
		toggle = function()
			if shopPage.page.Visible then
				shopPage.page.Visible = false
			else
				shopPage.refresh()
				shopPage.page.Visible = true
			end
		end,
		destroy = function()
			shopPage.page:Destroy()
		end,
	}
end

return ShopUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">ShoulderCamClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Shoulder Cam — custom over-shoulder lock (not Roblox Shift Lock).
	Smooth camera offset up + left/right, center crosshair, Ctrl toggle.
	Does not rotate the body during flight or while abilities control orientation.
	(Alt is reserved for Scarlet Witch dash.)
]]

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local ShoulderCamClient = {}

local CROSSHAIR_IMAGE = "rbxassetid://9563788818"
local OFFSET_RIGHT = Vector3.new(1.75, 0.4, 0)
local OFFSET_LEFT = Vector3.new(-1.75, 0.4, 0)
local LERP_SPEED = 11
local ROTATE_SPEED = 14

local player: Player? = nil
local enabled = false
local side: string = "Right" -- "Right" | "Left"
local keybind: string = "Ctrl" -- locked to Ctrl (Alt = hex dash)
local currentOffset = Vector3.zero
local savedAutoRotate: boolean? = nil
local bodyControlActive = false -- true while we currently own AutoRotate / body facing

local crosshairGui: ScreenGui? = nil
local crosshairImage: ImageLabel? = nil

local function getTargetOffset(): Vector3
	return if side == "Left" then OFFSET_LEFT else OFFSET_RIGHT
end

local function isToggleKey(keyCode: Enum.KeyCode): boolean
	return keyCode == Enum.KeyCode.LeftControl or keyCode == Enum.KeyCode.RightControl
end

--[[ Abilities / states that own character orientation — shoulder cam must not fight them. ]]
local function shouldSuspendBodyControl(character: Model): boolean
	if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.ICE_SLIDE_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.BUSY_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.RAGDOLLED_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.TK_ACTIVE_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.SHIELD_ACTIVE_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute("BarrageSpinActive") == true then
		return true
	end
	if character:GetAttribute("AbsorbActive") == true then
		return true
	end
	if character:GetAttribute(GameConstants.DISINTEGRATE_ACTIVE_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute(GameConstants.LOKI_SHAPESHIFT_ATTRIBUTE) == true then
		return true
	end
	if character:GetAttribute("AbilityActive_hex_beam") == true then
		return true
	end
	if character:GetAttribute("AbilityActive_forcefield_crush") == true then
		return true
	end
	if character:GetAttribute("AbilityActive_forcefield_smash") == true then
		return true
	end
	return false
end

local function applyMouseLock(on: boolean)
	if on then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		-- Hide default cursor; only the center ImageLabel shows
		UserInputService.MouseIconEnabled = false
		UserInputService.MouseIcon = ""
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		UserInputService.MouseIcon = ""
	end
end

local function ensureCrosshair(playerGui: PlayerGui)
	if crosshairGui and crosshairGui.Parent then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "MCU_ShoulderCam"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 250
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = true
	gui.Parent = playerGui

	local img = Instance.new("ImageLabel")
	img.Name = "Crosshair"
	img.AnchorPoint = Vector2.new(0.5, 0.5)
	img.Position = UDim2.fromScale(0.5, 0.5)
	img.Size = UDim2.fromOffset(28, 28)
	img.BackgroundTransparency = 1
	img.BorderSizePixel = 0
	img.Image = CROSSHAIR_IMAGE
	img.ImageTransparency = 0
	img.ImageColor3 = Color3.new(1, 1, 1)
	img.ScaleType = Enum.ScaleType.Fit
	img.Visible = false
	img.ZIndex = 100
	img.Parent = gui

	crosshairGui = gui
	crosshairImage = img
end

local function setCrosshairVisible(on: boolean)
	if crosshairImage then
		crosshairImage.Visible = on
		if on then
			crosshairImage.Image = CROSSHAIR_IMAGE
			crosshairImage.ImageTransparency = 0
		end
	end
	if crosshairGui then
		crosshairGui.Enabled = true
	end
end

local function releaseBodyControl(humanoid: Humanoid?)
	if not bodyControlActive then
		return
	end
	bodyControlActive = false
	if humanoid then
		if savedAutoRotate ~= nil then
			humanoid.AutoRotate = savedAutoRotate
			savedAutoRotate = nil
		else
			humanoid.AutoRotate = true
		end
	else
		savedAutoRotate = nil
	end
end

local function takeBodyControl(humanoid: Humanoid)
	if bodyControlActive then
		if humanoid.AutoRotate then
			humanoid.AutoRotate = false
		end
		return
	end
	bodyControlActive = true
	if savedAutoRotate == nil then
		savedAutoRotate = humanoid.AutoRotate
	end
	humanoid.AutoRotate = false
end

function ShoulderCamClient.isEnabled(): boolean
	return enabled
end

function ShoulderCamClient.getSide(): string
	return side
end

function ShoulderCamClient.getKeybind(): string
	return keybind
end

function ShoulderCamClient.setSide(newSide: string)
	if newSide == "Left" or newSide == "Right" then
		side = newSide
	end
end

function ShoulderCamClient.setKeybind(newBind: string)
	-- Alt is reserved for Scarlet Witch dash — shoulder lock stays on Ctrl
	if newBind == "Ctrl" then
		keybind = "Ctrl"
	end
end

function ShoulderCamClient.setEnabled(on: boolean)
	local plr = player
	local character = plr and plr.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	enabled = on
	setCrosshairVisible(on)
	applyMouseLock(on)

	if not on then
		releaseBodyControl(humanoid)
		currentOffset = Vector3.zero
	end
end

function ShoulderCamClient.toggle(): boolean
	ShoulderCamClient.setEnabled(not enabled)
	return enabled
end

function ShoulderCamClient.init(localPlayer: Player)
	player = localPlayer
	local playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui
	ensureCrosshair(playerGui)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		if not isToggleKey(input.KeyCode) then
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		ShoulderCamClient.toggle()
	end)

	local function hookCharacter(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 5)
		if humanoid and humanoid:IsA("Humanoid") then
			humanoid.Died:Connect(function()
				ShoulderCamClient.setEnabled(false)
			end)
		end
	end

	if localPlayer.Character then
		task.spawn(hookCharacter, localPlayer.Character)
	end
	localPlayer.CharacterAdded:Connect(function(character)
		-- Never keep shoulder cam across death/respawn
		ShoulderCamClient.setEnabled(false)
		hookCharacter(character)
	end)

	localPlayer.CharacterRemoving:Connect(function()
		ShoulderCamClient.setEnabled(false)
	end)

	RunService:BindToRenderStep("MCU_ShoulderCam", Enum.RenderPriority.Camera.Value + 2, function(dt)
		local plr = player
		local character = plr and plr.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local cam = workspace.CurrentCamera

		-- Dead / missing character: force off
		if enabled and (not character or not humanoid or humanoid.Health <= 0) then
			ShoulderCamClient.setEnabled(false)
		end

		local teleportCam = character ~= nil and character:GetAttribute("SwTeleportCam") == true
		local suspendBody = character ~= nil and shouldSuspendBodyControl(character)
		-- Camera offset still applies while enabled (including flight); body facing does not
		local alpha = math.clamp(dt * LERP_SPEED, 0, 1)
		local want = if enabled and not teleportCam then getTargetOffset() else Vector3.zero
		currentOffset = currentOffset:Lerp(want, alpha)

		if cam and currentOffset.Magnitude > 0.001 and not teleportCam then
			cam.CFrame = cam.CFrame * CFrame.new(currentOffset)
		end

		if not enabled then
			if humanoid then
				releaseBodyControl(humanoid)
			end
			return
		end

		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
			applyMouseLock(true)
		else
			UserInputService.MouseIconEnabled = false
			UserInputService.MouseIcon = ""
		end
		setCrosshairVisible(true)

		if not character or not humanoid or not cam then
			return
		end

		if suspendBody then
			releaseBodyControl(humanoid)
			return
		end

		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end

		takeBodyControl(humanoid)

		local look = cam.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.05 then
			return
		end
		flat = flat.Unit
		local targetCf = CFrame.new(root.Position, root.Position + flat)
		root.CFrame = root.CFrame:Lerp(targetCf, math.clamp(dt * ROTATE_SPEED, 0, 1))
	end)
end

return ShoulderCamClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">SoftLockClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Soft lock-on: when enabled, only locks if a living humanoid is inside a
	small screen-space area around the cursor. Otherwise aim follows the mouse.
	OFF by default.
]]

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)

local SoftLockClient = {}

local ICON_SIZE = 72

local enabled = false
local lockedTarget: Model? = nil
local player: Player? = nil
local playerGui: PlayerGui? = nil
local screenGui: ScreenGui? = nil
local lockImage: ImageLabel? = nil
local started = false

local function getRoot(model: Model): BasePart?
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	return nil
end

local function getAimCenter(model: Model): Vector3?
	local root = getRoot(model)
	if root then
		return root.Position
	end
	return model:GetPivot().Position
end

local function isValidTarget(model: Model, selfChar: Model?): boolean
	if model == selfChar then
		return false
	end
	if model.Name == "FearClone" or model:GetAttribute("FearVisual") == true then
		return false
	end
	if model:GetAttribute("LokiDecoy") == true or model:GetAttribute("LokiUltClone") == true then
		return false
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return false
	end
	return getRoot(model) ~= nil
end

local function ensureIcon()
	if lockImage and lockImage.Parent and screenGui and screenGui.Parent then
		return
	end
	local parentGui = playerGui
	if not parentGui then
		return
	end

	if screenGui then
		screenGui:Destroy()
		screenGui = nil
		lockImage = nil
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "MCU_SoftLock"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 200
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = true
	gui.Parent = parentGui
	screenGui = gui

	local img = Instance.new("ImageLabel")
	img.Name = "LockIcon"
	img.AnchorPoint = Vector2.new(0.5, 0.5)
	img.Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE)
	img.BackgroundTransparency = 1
	img.BorderSizePixel = 0
	img.Image = GameConstants.SOFT_LOCK_ICON
	img.ImageTransparency = 0
	img.ScaleType = Enum.ScaleType.Fit
	img.Visible = false
	img.ZIndex = 10
	img.Parent = gui
	lockImage = img
end

local function hideIcon()
	if lockImage then
		lockImage.Visible = false
	end
end

local function showIconAt(screenX: number, screenY: number)
	ensureIcon()
	local img = lockImage
	if not img then
		return
	end
	-- IgnoreGuiInset ScreenGui uses full viewport coords (same as WorldToViewportPoint)
	img.Position = UDim2.fromOffset(math.floor(screenX + 0.5), math.floor(screenY + 0.5))
	img.Image = GameConstants.SOFT_LOCK_ICON
	img.Visible = true
end

local function clearLock()
	lockedTarget = nil
	hideIcon()
end

local function getCursorViewport(): Vector2
	local mouse = UserInputService:GetMouseLocation()
	local inset = GuiService:GetGuiInset()
	return Vector2.new(mouse.X - inset.X, mouse.Y - inset.Y)
end

local function screenDistToCursor(camera: Camera, worldPos: Vector3, cursor: Vector2): number?
	local screenPos, onScreen = camera:WorldToViewportPoint(worldPos)
	if screenPos.Z <= 0 then
		return nil
	end
	if not onScreen then
		-- Still allow if the projected point is just outside the viewport but near the cursor.
		local dx = screenPos.X - cursor.X
		local dy = screenPos.Y - cursor.Y
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist > GameConstants.SOFT_LOCK_HOLD_SCREEN_PX then
			return nil
		end
		return dist
	end
	local dx = screenPos.X - cursor.X
	local dy = screenPos.Y - cursor.Y
	return math.sqrt(dx * dx + dy * dy)
end

local function findStickyTarget(selfChar: Model, camera: Camera): Model?
	local selfRoot = getRoot(selfChar)
	local selfPos = if selfRoot then selfRoot.Position else selfChar:GetPivot().Position
	local maxRange = GameConstants.SOFT_LOCK_MAX_RANGE
	local cursor = getCursorViewport()
	local acquirePx = GameConstants.SOFT_LOCK_SCREEN_PX
	local holdPx = GameConstants.SOFT_LOCK_HOLD_SCREEN_PX

	if lockedTarget and lockedTarget.Parent and isValidTarget(lockedTarget, selfChar) then
		local root = getRoot(lockedTarget)
		if root and (root.Position - selfPos).Magnitude <= maxRange then
			local distPx = screenDistToCursor(camera, root.Position, cursor)
			if distPx ~= nil and distPx <= holdPx then
				return lockedTarget
			end
		end
	end

	local best: Model? = nil
	local bestPx = math.huge

	local function consider(model: Model)
		if not isValidTarget(model, selfChar) then
			return
		end
		local root = getRoot(model)
		if not root then
			return
		end
		local dist = (root.Position - selfPos).Magnitude
		if dist > maxRange or dist < 1 then
			return
		end
		local distPx = screenDistToCursor(camera, root.Position, cursor)
		if distPx == nil or distPx > acquirePx then
			return
		end
		if distPx < bestPx then
			bestPx = distPx
			best = model
		end
	end

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { selfChar }
	local parts = Workspace:GetPartBoundsInRadius(selfPos, maxRange, overlap)
	local seen: { [Model]: boolean } = {}
	for _, part in parts do
		local current: Instance? = part
		while current do
			if current:IsA("Model") and current ~= selfChar then
				local hum = current:FindFirstChildOfClass("Humanoid")
				if hum then
					if not seen[current] then
						seen[current] = true
						consider(current)
					end
					break
				end
			end
			current = current.Parent
		end
	end
	return best
end

function SoftLockClient.isEnabled(): boolean
	return enabled
end

function SoftLockClient.setEnabled(on: boolean)
	enabled = on == true
	if not enabled then
		clearLock()
	end
end

function SoftLockClient.toggle(): boolean
	SoftLockClient.setEnabled(not enabled)
	return enabled
end

function SoftLockClient.getLockedTarget(): Model?
	if not enabled then
		return nil
	end
	return lockedTarget
end

function SoftLockClient.getLockedAimPoint(): Vector3?
	if not enabled or not lockedTarget or not lockedTarget.Parent then
		return nil
	end
	return getAimCenter(lockedTarget)
end

function SoftLockClient.init(localPlayer: Player)
	if started then
		return
	end
	started = true
	player = localPlayer
	playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui
	ensureIcon()

	RunService.RenderStepped:Connect(function()
		if not enabled then
			if lockedTarget then
				clearLock()
			else
				hideIcon()
			end
			return
		end

		local plr = player
		if not plr then
			return
		end
		local character = plr.Character
		local camera = Workspace.CurrentCamera
		if not character or not camera then
			clearLock()
			return
		end

		lockedTarget = findStickyTarget(character, camera)

		if lockedTarget and lockedTarget.Parent then
			local center = getAimCenter(lockedTarget)
			if center then
				local screenPos, onScreen = camera:WorldToViewportPoint(center)
				if onScreen and screenPos.Z > 0 then
					showIconAt(screenPos.X, screenPos.Y)
				else
					hideIcon()
				end
			else
				hideIcon()
			end
		else
			hideIcon()
		end
	end)
end

return SoftLockClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">SprintClient</string>
            <string name="Source"><![CDATA[--!strict

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local SprintClient = {}

function SprintClient.init(player: Player)
	local sprintInput = Remotes.getEvent("SprintInput")
	local sprinting = false
	local dashToken = 0

	local function clearDashBoost(character: Model?)
		if not character then
			return
		end
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			return
		end
		local boost = root:FindFirstChild("HexDashBoost")
		if boost then
			boost:Destroy()
		end
		local att = root:FindFirstChild("HexDashBoostAtt")
		if att then
			att:Destroy()
		end
	end

	--[[
		Soft directional assist: low MaxForce so Humanoid WalkSpeed still wins for steering.
		Client-applied because the local player owns character physics.
	]]
	local function applyDashBoost(dirX: number, dirZ: number, speed: number, duration: number)
		local character = player.Character
		if not character then
			return
		end
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid or humanoid.Health <= 0 then
			return
		end

		local flat = Vector3.new(dirX, 0, dirZ)
		if flat.Magnitude < 0.05 then
			return
		end
		flat = flat.Unit

		clearDashBoost(character)

		-- Instant kick the client can feel immediately
		local vel = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(vel.X + flat.X * speed, vel.Y, vel.Z + flat.Z * speed)

		local att = Instance.new("Attachment")
		att.Name = "HexDashBoostAtt"
		att.Parent = root

		-- Gentle sustained assist (not a hard lock)
		local lv = Instance.new("LinearVelocity")
		lv.Name = "HexDashBoost"
		lv.Attachment0 = att
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Line
		lv.LineDirection = flat
		lv.LineVelocity = speed * 0.55
		lv.MaxForce = 3500
		lv.Parent = root

		dashToken += 1
		local token = dashToken
		task.delay(math.max(0.08, duration * 0.55), function()
			if token ~= dashToken then
				return
			end
			clearDashBoost(player.Character)
		end)
	end

	local function setSprint(on: boolean)
		if sprinting == on then
			return
		end
		sprinting = on
		sprintInput:FireServer({ sprinting = on })
	end

	local function tryWandaDash()
		local character = player.Character
		if not character or character:GetAttribute(GameConstants.HERO_ATTRIBUTE) ~= "scarlet_witch" then
			return
		end
		if character:GetAttribute(GameConstants.IS_FLYING_ATTRIBUTE) == true then
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		local move = humanoid.MoveDirection
		if move.Magnitude < 0.08 then
			return
		end
		sprintInput:FireServer({
			dash = true,
			moveX = move.X,
			moveZ = move.Z,
		})
	end

	sprintInput.OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" then
			return
		end
		if payload.clearDash == true then
			dashToken += 1
			clearDashBoost(player.Character)
			return
		end
		if payload.applyDash == true then
			applyDashBoost(
				if type(payload.dirX) == "number" then payload.dirX else 0,
				if type(payload.dirZ) == "number" then payload.dirZ else 0,
				if type(payload.speed) == "number" then payload.speed else GameConstants.HEX_DASH_SPEED,
				if type(payload.duration) == "number" then payload.duration else GameConstants.HEX_DASH_DURATION
			)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			setSprint(true)
		end
		-- Alt dash disabled for now
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			setSprint(false)
		end
	end)

	player.CharacterRemoving:Connect(function(character)
		dashToken += 1
		clearDashBoost(character)
	end)
end

return SprintClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">StarterGuiUtil</string>
            <string name="Source"><![CDATA[--!strict

local StarterGui = game:GetService("StarterGui")

local StarterGuiUtil = {}

local function asClass(inst: Instance?, className: string): Instance?
	if inst and inst:IsA(className) then
		return inst
	end
	return nil
end

function StarterGuiUtil.find(parent: Instance, name: string, className: string, recursive: boolean?): any?
	return asClass(parent:FindFirstChild(name, recursive == true), className)
end

function StarterGuiUtil.createFreshScreenGui(playerGui: PlayerGui, name: string, displayOrder: number?): ScreenGui
	local starter = StarterGui:FindFirstChild(name)
	if starter and starter:IsA("ScreenGui") then
		starter.Enabled = false
		starter.ResetOnSpawn = false
		pcall(function()
			starter:Destroy()
		end)
	end
	local existing = playerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = displayOrder or 0
	gui.Enabled = false
	gui.Parent = playerGui
	return gui
end

function StarterGuiUtil.child(parent: Instance, name: string, className: string): any
	local inst = StarterGuiUtil.find(parent, name, className)
	if inst then
		return inst
	end
	local waited = parent:WaitForChild(name, 2)
	inst = asClass(waited, className)
	if not inst then
		error(`[StarterGui] Expected {className} '{name}' under {parent:GetFullName()}`)
	end
	return inst
end

function StarterGuiUtil.ensureFrame(parent: Instance, name: string): Frame
	local existing = StarterGuiUtil.find(parent, name, "Frame")
	if existing then
		return existing
	end
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.Visible = false
	frame.Parent = parent
	return frame
end

function StarterGuiUtil.statBar(barsColumn: Frame, barName: string): (TextLabel?, Frame?)
	local row = StarterGuiUtil.find(barsColumn, barName .. "Row", "Frame")
		or StarterGuiUtil.find(barsColumn, barName, "Frame")
	if not row then
		return nil, nil
	end
	local track = StarterGuiUtil.find(row, "Track", "Frame") or row
	local fill = StarterGuiUtil.find(track, "Fill", "Frame") or StarterGuiUtil.find(row, "Fill", "Frame")
	local label = track:FindFirstChildWhichIsA("TextLabel") or row:FindFirstChildWhichIsA("TextLabel")
	if not fill or not fill:IsA("Frame") then
		return nil, nil
	end
	return label :: TextLabel?, fill
end

function StarterGuiUtil.ensureStatBar(barsColumn: Frame, barName: string): (TextLabel, Frame)
	local label, fill = StarterGuiUtil.statBar(barsColumn, barName)
	if label and fill then
		return label, fill
	end
	local row = StarterGuiUtil.ensureFrame(barsColumn, barName .. "Row")
	row.Visible = true
	row.Size = UDim2.new(1, 0, 0.28, 0)
	local track = StarterGuiUtil.ensureFrame(row, "Track")
	track.Visible = true
	track.Size = UDim2.fromScale(1, 1)
	track.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	track.BackgroundTransparency = 0.2
	fill = StarterGuiUtil.ensureFrame(track, "Fill")
	fill.Visible = true
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(200, 70, 80)
	local existingLabel = track:FindFirstChildWhichIsA("TextLabel")
	if existingLabel then
		label = existingLabel
	else
		label = Instance.new("TextLabel")
		label.Name = "Label"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.Text = barName
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextScaled = true
		label.Parent = track
	end
	return label, fill
end

return StarterGuiUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">TeleportMarkerClient</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Aim mark while teleport aiming:
	- Follows mouse cursor (clamped to scrollable max range)
	- Scarlet Witch: air allowed at cursor hit
	- Loki: ground-snapped disk
	Scroll = how far the pad is allowed to go from the caster.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConstants = require(ReplicatedStorage.Shared.GameConstants)
local MouseHelper = require(script.Parent.MouseHelper)

local TeleportMarkerClient = {}

local DEFAULT_MIN = 8
local DEFAULT_MAX = 85
local DEFAULT_SCROLL_STEP = 5

local player: Player? = nil
local marker: BasePart? = nil
local aimDistance = 40
local lastAimWorld: Vector3? = nil
local wasAiming = false

local function makeMarker(color: Color3, size: number): BasePart
	local disk = Instance.new("Part")
	disk.Name = "TeleportPlaceMark"
	disk.Shape = Enum.PartType.Cylinder
	disk.Size = Vector3.new(0.14, size, size)
	disk.Material = Enum.Material.Neon
	disk.Color = color
	disk.Transparency = 0.32
	disk.Anchored = true
	disk.CanCollide = false
	disk.CanQuery = false
	disk.CanTouch = false
	disk.CastShadow = false
	disk.Parent = Workspace
	return disk
end

local function hide()
	if marker then
		marker:Destroy()
		marker = nil
	end
	lastAimWorld = nil
end

local function maxRangeForHero(hero: string?): number
	if hero == "loki" then
		local v = GameConstants.LOKI_TELEPORT_RANGE
		return if type(v) == "number" then v else 50
	end
	local v = GameConstants.TELEPORT_RANGE
	return if type(v) == "number" then v else DEFAULT_MAX
end

local function minRange(): number
	local v = GameConstants.TELEPORT_AIM_DIST_MIN
	return if type(v) == "number" then v else DEFAULT_MIN
end

local function scrollStep(): number
	local v = GameConstants.TELEPORT_SCROLL_STEP
	return if type(v) == "number" then v else DEFAULT_SCROLL_STEP
end

local function clampRange(value: number, minV: number, maxV: number): number
	local lo = math.min(minV, maxV)
	local hi = math.max(minV, maxV)
	return math.clamp(value, lo, hi)
end

local function clampToRange(from: Vector3, to: Vector3, range: number): Vector3
	local offset = to - from
	if offset.Magnitude > range then
		return from + offset.Unit * range
	end
	return to
end

local function groundSnap(character: Model, dest: Vector3, rootY: number): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local result = Workspace:Raycast(dest + Vector3.new(0, 6, 0), Vector3.new(0, -80, 0), params)
	if result then
		return result.Position
	end
	return Vector3.new(dest.X, rootY - 3, dest.Z)
end

function TeleportMarkerClient.adjustRange(scrollDelta: number)
	local step = if scrollDelta > 0 then scrollStep() else -scrollStep()
	local plr = player
	local character = plr and plr.Character
	local hero = character and character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
	local maxR = maxRangeForHero(if type(hero) == "string" then hero else nil)
	aimDistance = clampRange(aimDistance + step, minRange(), maxR)
end

function TeleportMarkerClient.getAimWorldPosition(): Vector3?
	return lastAimWorld
end

function TeleportMarkerClient.init(localPlayer: Player)
	player = localPlayer

	RunService.RenderStepped:Connect(function()
		local character = localPlayer.Character
		local aiming = character ~= nil and character:GetAttribute(GameConstants.TELEPORT_AIMING_ATTRIBUTE) == true
		if not aiming then
			if wasAiming then
				hide()
				wasAiming = false
			end
			return
		end

		local hero = character:GetAttribute(GameConstants.HERO_ATTRIBUTE)
		local maxR = maxRangeForHero(if type(hero) == "string" then hero else nil)
		local minR = minRange()
		local color = Color3.fromRGB(210, 70, 90)
		local allowAir = false
		if hero == "loki" then
			color = Color3.fromRGB(90, 255, 130)
		elseif hero == "scarlet_witch" then
			allowAir = true
		else
			hide()
			wasAiming = false
			return
		end

		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			hide()
			return
		end

		if not wasAiming then
			-- Start range at current mouse distance (so pad appears under cursor immediately)
			local seedHit = MouseHelper.getHitPosition(localPlayer, maxR + 40)
			aimDistance = clampRange((seedHit - root.Position).Magnitude, minR, maxR)
			wasAiming = true
		end

		aimDistance = clampRange(aimDistance, minR, maxR)

		-- Wanda: aim wherever the cursor points (clamped to max range). Loki: scrollable range.
		local rangeCap = if allowAir then maxR else aimDistance
		local mouseHit = MouseHelper.getHitPosition(localPlayer, math.max(rangeCap + 40, 160))
		local pos: Vector3
		if allowAir then
			pos = clampToRange(root.Position, mouseHit, rangeCap)
		else
			local flat = clampToRange(
				root.Position,
				Vector3.new(mouseHit.X, root.Position.Y, mouseHit.Z),
				aimDistance
			)
			pos = groundSnap(character, flat, root.Position.Y)
		end
		lastAimWorld = pos

		if not marker or not marker.Parent then
			marker = makeMarker(color, if allowAir then 3.6 else 5.2)
		else
			marker.Color = color
		end
		local mark = marker :: BasePart
		mark.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	end)

	localPlayer.CharacterRemoving:Connect(function()
		hide()
		wasAiming = false
	end)
end

return TeleportMarkerClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">ViewportHelper</string>
            <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MorphVfxTint = require(ReplicatedStorage.Shared.MorphVfxTint)
local MorphAnimationHelper = require(ReplicatedStorage.Shared.MorphAnimationHelper)

local ViewportHelper = {}

type Binding = {
	character: Model,
	conn: RBXScriptConnection?,
	retryConn: RBXScriptConnection?,
	idleTrack: AnimationTrack?,
	frameStyle: string?,
}

local bindings: { [ViewportFrame]: Binding } = {}
local FACE_YAW = math.pi
local FIXED_FOV = 40

local function clearBinding(viewport: ViewportFrame)
	local state = bindings[viewport]
	if state then
		if state.conn then
			state.conn:Disconnect()
		end
		if state.retryConn then
			state.retryConn:Disconnect()
		end
		if state.idleTrack then
			state.idleTrack:Stop(0)
			state.idleTrack:Destroy()
		end
		bindings[viewport] = nil
	end
	for _, child in viewport:GetChildren() do
		if not child:IsA("UICorner") and not child:IsA("UIStroke") then
			child:Destroy()
		end
	end
end

local function findIdleAnimId(root: Instance?): string?
	if not root then
		return nil
	end
	local animate = root:FindFirstChild("Animate")
	if not animate then
		return nil
	end
	local folder = animate:FindFirstChild("idle") or animate:FindFirstChild("Idle")
	if not folder then
		return nil
	end
	local preferred = folder:FindFirstChild("Animation1")
	if preferred then
		if preferred:IsA("Animation") and preferred.AnimationId ~= "" then
			return preferred.AnimationId
		end
		if preferred:IsA("StringValue") and preferred.Value ~= "" then
			return preferred.Value
		end
		local nested = preferred:FindFirstChildOfClass("Animation")
		if nested and nested.AnimationId ~= "" then
			return nested.AnimationId
		end
	end
	for _, child in folder:GetChildren() do
		if child:IsA("Animation") and child.AnimationId ~= "" then
			return child.AnimationId
		end
		if child:IsA("StringValue") and child.Value ~= "" then
			return child.Value
		end
		local nested = child:FindFirstChildOfClass("Animation")
		if nested and nested.AnimationId ~= "" then
			return nested.AnimationId
		end
	end
	return nil
end

local function prepareStaticClone(clone: Model, forIdle: boolean)
	local idleId = findIdleAnimId(clone)
	for _, desc in clone:GetDescendants() do
		if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ModuleScript") then
			desc:Destroy()
		elseif desc:IsA("BasePart") then
			desc.CanCollide = false
			desc.CanQuery = false
			desc.CanTouch = false
			if desc.Name == "HumanoidRootPart" then
				desc.Transparency = 1
				desc.Anchored = true
			else
				desc.Anchored = not forIdle
			end
		elseif desc:IsA("Humanoid") then
			desc.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			desc.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			desc.PlatformStand = true
		elseif desc:IsA("Animator") and not forIdle then
			for _, track in desc:GetPlayingAnimationTracks() do
				track:Stop(0)
				track:Destroy()
			end
			desc:Destroy()
		end
	end
	return idleId
end

local function frameStaticModel(clone: Model, vpCamera: Camera, yaw: number?, style: string?)
	local hrp = clone:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp and not clone.PrimaryPart then
		clone.PrimaryPart = hrp
	end
	local rot = FACE_YAW + (yaw or 0)
	clone:PivotTo(CFrame.Angles(0, rot, 0))
	local _boxCf, size = clone:GetBoundingBox()
	local height = math.max(size.Y, 3)
	-- Same relative framing for HUD and roster circles
	local lookY = height * 0.58 - 1.25
	local camY = height * 0.54 - 1
	local dist = math.clamp(height * 1.08, 3.2, 7.8) - 2.05
	vpCamera.CFrame = CFrame.lookAt(Vector3.new(0, camY, dist), Vector3.new(0, lookY, 0))
	vpCamera.FieldOfView = FIXED_FOV
end

local function playIdle(clone: Model, idleId: string?): AnimationTrack?
	if not idleId then
		return nil
	end
	local hum = clone:FindFirstChildOfClass("Humanoid")
	if not hum then
		return nil
	end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = idleId
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	anim:Destroy()
	if not ok or not track then
		return nil
	end
	track.Looped = true
	track.Priority = Enum.AnimationPriority.Idle
	track:Play(0.15)
	return track
end

local function setupViewportShell(viewport: ViewportFrame)
	viewport.Ambient = Color3.fromRGB(160, 200, 208)
	viewport.LightColor = Color3.fromRGB(255, 255, 255)
	viewport.LightDirection = Vector3.new(0.2, -0.65, -1)
	viewport.BackgroundTransparency = 1

	local worldModel = Instance.new("WorldModel")
	worldModel.Name = "WorldModel"
	worldModel.Parent = viewport

	local camera = Instance.new("Camera")
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return worldModel, camera
end

function ViewportHelper.bindTemplate(viewport: ViewportFrame, template: Model?, yaw: number?, frameStyle: string?): Model?
	return ViewportHelper.bindMorphIdle(viewport, template, yaw, frameStyle)
end

function ViewportHelper.bindMorphIdle(viewport: ViewportFrame, template: Model?, yaw: number?, frameStyle: string?): Model?
	clearBinding(viewport)
	if not template then
		return nil
	end

	local wasArchivable = template.Archivable
	template.Archivable = true
	local ok, clone = pcall(function()
		return template:Clone()
	end)
	template.Archivable = wasArchivable
	if not ok or not clone or not clone:IsA("Model") then
		return nil
	end

	local idleId = prepareStaticClone(clone, true)
	clone.Name = "ViewportMorphIdle"

	-- Skin-specific VFX tint (e.g. X-Men '97 Jean)
	MorphVfxTint.applyToTemplateName(clone, template.Name)
	MorphAnimationHelper.applyToModel(clone, MorphAnimationHelper.idleIdForMorphName(template.Name))
	idleId = findIdleAnimId(clone)

	local _worldModel, camera = setupViewportShell(viewport)
	clone.Parent = _worldModel
	local style = frameStyle or nil
	frameStaticModel(clone, camera, yaw or 0, style)
	local idleTrack = playIdle(clone, idleId)

	bindings[viewport] = {
		character = clone,
		conn = nil,
		retryConn = nil,
		idleTrack = idleTrack,
		frameStyle = style,
	}
	return clone
end

function ViewportHelper.setTemplateYaw(viewport: ViewportFrame, yaw: number)
	local state = bindings[viewport]
	if not state or not state.character.Parent then
		return
	end
	local cam = viewport.CurrentCamera
	if not cam then
		return
	end
	frameStaticModel(state.character, cam, yaw, state.frameStyle)
end

function ViewportHelper.bindCharacter(viewport: ViewportFrame, character: Model?)
	clearBinding(viewport)
	if not character or not character.Parent then
		return
	end
	ViewportHelper.bindMorphIdle(viewport, character, 0)
end

return ViewportHelper
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="90">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>